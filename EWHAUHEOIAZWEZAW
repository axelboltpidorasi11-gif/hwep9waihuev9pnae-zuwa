	local function DeactivateRow(rowFrame, loadBtn)
		-- Shared selection look (Library._sel): flat row, the loaded one accent text + faint accent fill.
		rowFrame:SetAttribute("Sel", nil)
		Tween(rowFrame, {BackgroundTransparency = 1}, 0.15)
		local outline = rowFrame:FindFirstChild("ConfigRowStroke")
		if outline then Tween(outline, { Color = STROKE.Color, Transparency = 1 }, 0.15) end
		local rn = rowFrame:FindFirstChild("Rename")
		if rn then Library._setC(rn, "TextColor3", Library._sel.unselText) end
		loadBtn.Image = LOAD_ICON
		Tween(loadBtn, {ImageColor3 = Color3.fromRGB(172, 176, 192)}, 0.15)
		local tick = rowFrame:FindFirstChild("LoadedTick")
		if tick then tick.Visible = false end
	end

