	for _, cat in ipairs(G.cats or GU.cats(nil)) do
		order = order + 1
		local cap = New("TextLabel", {
			Name = "PickerCaption", Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = cat[1], TextColor3 = S.selText,
			TextSize = 13, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = order,
		}, pop.body)
		New("UIPadding", { PaddingLeft = UDim.new(0, 10) }, cap)
		H = H + 28 + S.gap
		for _, item in ipairs(cat[2]) do
			order = order + 1
			local has = table.find(g.items, item) ~= nil
			local row, label, ck = GU.weaponRow(pop.body, item, item, order, has)
			row.MouseButton1Click:Connect(function()
