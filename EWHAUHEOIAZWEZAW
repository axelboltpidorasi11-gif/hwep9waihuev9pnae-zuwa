	local guiOpen = true

	-- Fades every descendant of `root` (backgrounds, text, images, outlines)
	-- together. Closing remembers each value ("FadeBase_<prop>") and tweens it
	-- to clear; opening tweens back to the remembered values.
	-- Fades a whole tree. Hiding walks only what is on screen (hidden tabs and
	-- closed plates are skipped: the menu has thousands of elements and the
	-- full walk made every open/close hitch) and keeps the list it faded;
	-- showing restores exactly that list. Remembered values stay until the
	-- fade-in has finished, so a close in the middle of an open (fast
	-- toggling) never saves a half-faded value as the real one.
	WindowObj._fadeLists = WindowObj._fadeLists or setmetatable({}, { __mode = "k" })
	WindowObj._fadeTree = function(root, show, dur)
		if show == (root:GetAttribute("TreeFaded") ~= true) then return end
		root:SetAttribute("TreeFaded", not show)
		local token = (root:GetAttribute("FadeToken") or 0) + 1
		root:SetAttribute("FadeToken", token)
		-- Quint out when showing (fast start, long soft landing), quad in when hiding.
		-- Motion tokens: shows land on base/slow, hides are fast. dur == 0 (or
		-- reduce motion) is instant, so hide(0) + show(d) really fades in from clear.
		local instant = dur == 0 or (Library._animScale or 1) <= 0
		local live = WindowObj._fadeLive or setmetatable({}, { __mode = "k" })
		WindowObj._fadeLive = live
		dur = Library._motion.snap(math.max(dur or 0.2, 0.065))
		if show then dur = math.max(dur, Library._motion.base) end
		if Library._animScale and Library._animScale ~= 1 then dur = math.max(dur * Library._animScale, 0.01) end
		local info = TweenInfo.new(dur, show and Enum.EasingStyle.Quint or Enum.EasingStyle.Quad, show and Enum.EasingDirection.Out or Enum.EasingDirection.In)
		local prefix = "FB_" .. root.Name .. "_"
		local function play(d, goal)
			local running = live[d]
			if running then live[d] = nil; pcall(function() running:Cancel() end) end
			if instant then
				for k, v in pairs(goal) do d[k] = v end
				return
			end
			local tw = TweenService:Create(d, info, goal)
			live[d] = tw
			tw:Play()
		end
		local function propsOf(d)
			if d:IsA("GuiObject") then
				local props = { "BackgroundTransparency" }
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then table.insert(props, "TextTransparency") end
				if d:IsA("ImageLabel") or d:IsA("ImageButton") or d:IsA("ViewportFrame") then table.insert(props, "ImageTransparency") end
				return props
			elseif d:IsA("UIStroke") then
				return { "Transparency" }
			end
		end
		if show then
			local list = WindowObj._fadeLists[root]
			if not list then
				-- Never hidden through this path: restore whatever carries a key.
				list = root:GetDescendants()
			end
			for _, d in ipairs(list) do
				local props = d.Parent and propsOf(d)
				if props then
					local goal
					for _, prop in ipairs(props) do
						local base = d:GetAttribute(prefix .. prop)
						if base ~= nil then
							goal = goal or {}
							goal[prop] = base
						end
					end
					if goal then play(d, goal) end
				end
			end
			task.delay(dur + 0.05, function()
				if root:GetAttribute("FadeToken") ~= token then return end
				for _, d in ipairs(list) do
					local props = d.Parent and propsOf(d)
					for _, prop in ipairs(props or {}) do d:SetAttribute(prefix .. prop, nil) end
				end
				if WindowObj._fadeLists[root] == list then WindowObj._fadeLists[root] = nil end
			end)
			return
		end
		local list = {}
		local function walk(node)
			for _, d in ipairs(node:GetChildren()) do
				local visible = not d:IsA("GuiObject") or d.Visible
				if visible then
					local props = propsOf(d)
					if props then
						local goal
						for _, prop in ipairs(props) do
							local key = prefix .. prop
							local base = d:GetAttribute(key)
							if base == nil and d[prop] < 1 then
								d:SetAttribute(key, d[prop])
								base = d[prop]
							end
							if base ~= nil then
								goal = goal or {}
								goal[prop] = 1
							end
						end
						if goal then
							table.insert(list, d)
							play(d, goal)
						end
					end
					walk(d)
				end
			end
		end
		walk(root)
		WindowObj._fadeLists[root] = list
	end

	-- A column that just became visible fades in from clear (0.2s). Skipped
	-- while the window itself is fading, so the two fades never overlap.
	WindowObj._fadeColumn = function(column)
		if MainFrame:GetAttribute("TreeFaded") then return end
		WindowObj._fadeTree(column, true, 0)
		WindowObj._fadeTree(column, false, 0)
		WindowObj._fadeTree(column, true, 0.3)
	end

	-- Opening/closing: the window, everything in it (open plates, presets,
	-- profile, pickers) and the hotkey/spectator lists fade on one timeline.
	local function AnimateWindow(open)
		-- Motion: open 0.22 s (fade + scale 0.96 -> 1 + 6px rise, Quint Out),
		-- close 0.14 s (Quad In). The scale rides the window's UIScale (no
		-- relayout of the content, unlike a Size tween).
		local dur = open and 0.22 or 0.14
		local uis = MainFrameUIScale
		local restScale = WindowObj._scaleTarget or (uis and uis.Scale) or 1
		local part = AcrylicBlur and AcrylicBlur.Instances and AcrylicBlur.Instances.Part
		local dof = AcrylicBlur and AcrylicBlur.Instances and AcrylicBlur.Instances.DepthOfField
		WindowObj._menuOpen = open
		if WindowObj._applyMenuBlur then pcall(WindowObj._applyMenuBlur) end
		if WindowObj.KeybindList then pcall(WindowObj.KeybindList.refresh) end
		if WindowObj.SpectatorList then pcall(WindowObj.SpectatorList.refresh) end
		if open then
			-- Opening rises 6px into place while it grows and fades in.
			local rest = WindowObj._menuRestPos or MainFrame.Position
			WindowObj._menuRestPos = nil
			MainFrame.Position = UDim2.new(rest.X.Scale, rest.X.Offset, rest.Y.Scale, rest.Y.Offset + 6)
			Library._anim.tween(MainFrame, { Position = rest }, dur, "enter")
			MainFrame.Visible = true
			WindowObj._fadeTree(MainFrame, true, dur)
			-- Sidebar items cascade in (25 ms apart, max 5 steps): icon + label fade from clear and
			-- slide 8px from the left. Offsets / transparency only (a UIScale on a list item
			-- re-flows the list: the lower items drifted 2-5px while it settled).
			if Library._perfMode ~= "max" and (Library._animScale or 1) > 0 and not WindowObj._mobile then
				local items = {}
				for _, b in ipairs(Tab:GetChildren()) do
					if b:IsA("GuiObject") and b.Visible and b.Name == "TabButton" then items[#items + 1] = b end
				end
				table.sort(items, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
				local fadeLive = WindowObj._fadeLive or {}
				for i, b in ipairs(items) do
					local delay = 0.03 + math.min(i - 1, 5) * Library._motion.stagger
					for _, c in ipairs({ b:FindFirstChild("TabIcon"), b:FindFirstChild("TabText") }) do
						local base = c:GetAttribute("NLCascadePos") or c.Position
						c:SetAttribute("NLCascadePos", base)
						c.Position = base - UDim2.fromOffset(8, 0)
						local tw = Library._anim.move(c, { Position = base }, "slow", delay)
						if tw then tw.Completed:Connect(function() c:SetAttribute("NLCascadePos", nil) end) else c.Position = base; c:SetAttribute("NLCascadePos", nil) end
						local prop = c:IsA("TextLabel") and "TextTransparency" or "ImageTransparency"
						local fb = c:GetAttribute("FB_" .. MainFrame.Name .. "_" .. prop)
						if type(fb) == "number" then
							local running = fadeLive[c]
							if running then fadeLive[c] = nil; pcall(function() running:Cancel() end) end
							c[prop] = 1
							Library._anim.raw(c, { [prop] = fb }, "base", "enter", delay)
						end
					end
				end
			end
			MainFrame.BackgroundTransparency = 1
			MainFrame.Size = windowTargetSize
			Library._anim.tween(MainFrame, { BackgroundTransparency = Library._winAlpha() }, dur, "enter")
			if uis then
				uis.Scale = restScale * 0.96
				Library._anim.tween(uis, { Scale = restScale }, dur, "enter")
			end
		else
			-- Closing sinks 4px while it shrinks and fades; the place is kept.
			local rest = WindowObj._menuRestPos or MainFrame.Position
			WindowObj._menuRestPos = rest
			Library._anim.tween(MainFrame, { Position = UDim2.new(rest.X.Scale, rest.X.Offset, rest.Y.Scale, rest.Y.Offset + 4) }, dur, "exit")
			WindowObj._fadeTree(MainFrame, false, dur)
			Library._anim.tween(MainFrame, { BackgroundTransparency = 1 }, dur, "exit")
			if uis then Library._anim.tween(uis, { Scale = restScale * 0.97 }, dur, "exit") end
			task.delay(Library._motion.dur(dur) + 0.02, function()
				if guiOpen then return end
				-- Plates close only once everything has faded with the window.
				HideAllPopupsNow(true)
				if ConfigMainFrame then ConfigMainFrame.Visible = false end
				if WindowSettingsFrame then WindowSettingsFrame.Visible = false end
				if Save then Save.Visible = false end
				if RecentlyDeletedPanel then RecentlyDeletedPanel.Visible = false end
				MainFrame.Visible = false
				MainFrame.Size = windowTargetSize
				if uis then uis.Scale = WindowObj._scaleTarget or restScale end
				if WindowObj._menuRestPos then MainFrame.Position = WindowObj._menuRestPos end
				if part then part.Transparency = 1 end
				if dof and #WindowObj._blurs == 0 then dof.Enabled = false end
			end)
		end
		if part then
			local target = open and (part:GetAttribute("TargetTransparency") or 0.8) or 1
			if not (WindowObj._menuBlurOn and WindowObj._menuBlurOn()) then target = 1 end
			Tween(part, { Transparency = target }, dur)
		end
		if dof then dof.Enabled = (open and WindowObj._menuBlurOn() == true) or (#WindowObj._blurs > 0) end
	end

	AcrylicBlur.toggleGui = function()
    guiOpen = not guiOpen
    ToggleBtn.Text = guiOpen and "Close [RShift]" or "Open  [RShift]"
    Tween(ToggleBtn, {
        BackgroundColor3 = guiOpen and Color3.fromRGB(17, 19, 27) or Color3.fromRGB(33,37,53)
    }, 0.1)
    	if guiOpen then
        if Save then Save.Visible = true end
        if AcrylicBlur.Signal then
            pcall(function() AcrylicBlur.Signal:Disconnect() end)
            AcrylicBlur.Signal = nil
        end
        AcrylicBlur.Signal = game:GetService("RunService").RenderStepped:Connect(AcrylicBlur.Update)
    else
        if AcrylicBlur.Signal then
            AcrylicBlur.Signal:Disconnect()
            AcrylicBlur.Signal = nil
        end
    end
    AnimateWindow(guiOpen)
end

