local Library = {}
Library.__index = Library

-- Touch helpers (phones). A tap is a touch that ends close to where it began;
-- a swipe (scrolling a list) or a long press must not click what is under
-- the finger. A mouse click resets the state, so desktops never "swipe".
Library._touch = { moved = 0 }
Library._swiped = function()
	local t = Library._touch
	return t.isTouch == true and (t.moved > 8 or t.longPress == true)
end
UserInputService.InputBegan:Connect(function(input)
	local t = Library._touch
	if input.UserInputType == Enum.UserInputType.Touch then
		t.isTouch, t.start, t.moved, t.longPress = true, input.Position, 0, false
		-- Long press (0.45s, finger still within 8px) = right click (see Library._longPressAt).
		t.seq = (t.seq or 0) + 1
		local seq, input0 = t.seq, input
		task.delay(0.45, function()
			if t.seq ~= seq or t.longPress or t.moved > 8 or input0.UserInputState == Enum.UserInputState.End then return end
			if Library._longPressAt then
				t.longPress = true
				Library._longPressAt(Vector2.new(input0.Position.X, input0.Position.Y))
			end
		end)
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		t.isTouch, t.start, t.moved, t.longPress = false, nil, 0, false
	end
end)
UserInputService.InputChanged:Connect(function(input)
	local t = Library._touch
	if input.UserInputType == Enum.UserInputType.Touch and t.isTouch and t.start then
		local d = (input.Position - t.start).Magnitude
		if d > t.moved then t.moved = d end
	end
end)
-- Phones, narrow window: a tab's two section columns become one. The right
-- column (a ScrollingFrame) moves inside the left one, below its last
-- section, stops scrolling and grows with its content; back on widening.
Library._colApply = function(left, right, narrow)
	if not left or not right or not left.Parent or not right.Parent then return end
	if narrow then
		if right.Parent == left then return end
		left:SetAttribute("ColSize", left.Size)
		right:SetAttribute("ColSize", right.Size)
		right:SetAttribute("ColOrder", right.LayoutOrder)
		if left.Size.X.Scale < 1 then left.Size = UDim2.new(1, 0, left.Size.Y.Scale, left.Size.Y.Offset) end
		right.ScrollingEnabled = false
		right.Size = UDim2.new(1, 0, 0, 0)
		right.AutomaticSize = Enum.AutomaticSize.Y
		right.LayoutOrder = 1000000
		Library._colHome = Library._colHome or setmetatable({}, { __mode = "k" })
		Library._colHome[right] = right.Parent
		right.Parent = left
	else
		if right.Parent ~= left then return end
		local home = Library._colHome and Library._colHome[right]
		if not home or not home.Parent then return end
		right.Parent = home
		right.AutomaticSize = Enum.AutomaticSize.None
		right.ScrollingEnabled = true
		right.LayoutOrder = right:GetAttribute("ColOrder") or 1
		-- Only sizes still as set here (a full-width page may have resized them meanwhile).
		if left.Size.X.Scale == 1 and left.Size.X.Offset == 0 then left.Size = left:GetAttribute("ColSize") or UDim2.new(0.5, -7, 1, 0) end
		if right.Size == UDim2.new(1, 0, 0, 0) then right.Size = right:GetAttribute("ColSize") or UDim2.new(0.5, -7, 1, 0) end
	end
end
-- Phones: a touch that lands on a slider is not a drag yet. Moving sideways
-- (> 8px, mostly horizontal) starts the drag (onDrag); moving up/down first
-- leaves it to the list scroll; lifting without moving is a tap (onTap).
-- Returns false (caller drags at once) for mouse input or on desktops.
Library._touchAxis = function(input, onDrag, onTap)
	if not Library._phone or not input or input.UserInputType ~= Enum.UserInputType.Touch then return false end
	local start = input.Position
	local moveConn, endConn
	local function done()
		if moveConn then moveConn:Disconnect() end
		if endConn then endConn:Disconnect() end
	end
	moveConn = UserInputService.InputChanged:Connect(function(i)
		if i ~= input then return end
		local d = i.Position - start
		if math.abs(d.X) > 8 and math.abs(d.X) > math.abs(d.Y) then
			done()
			onDrag()
		elseif math.abs(d.Y) > 8 then
			done()
		end
	end)
	endConn = UserInputService.InputEnded:Connect(function(i)
		if i ~= input then return end
		done()
		local d = i.Position - start
		if math.abs(d.X) <= 8 and math.abs(d.Y) <= 8 and onTap then onTap() end
	end)
	return true
end
-- Click handler + (phones) an invisible 46px-tall hit pad around a small
-- control (dropdown fields), so a fingertip that lands near it still counts.
Library._onTap = function(btn, fn, padW, padH)
	btn.MouseButton1Click:Connect(fn)
	if not Library._phone then return end
