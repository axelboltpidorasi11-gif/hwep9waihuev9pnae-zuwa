	-- Tab content is one CanvasGroup: switching tabs fades the whole page
	-- with a single GroupTransparency tween (fading every element one by one
	-- stuttered on big tabs). 2px margin so card outlines are not clipped.
	local TabHose = New("CanvasGroup", {
		Name = "TabHose",
		Position = UDim2.new(0, 8, 0, 58),
		Size = UDim2.new(1, -16, 1, -66),
