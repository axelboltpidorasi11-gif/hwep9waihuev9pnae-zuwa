			local function begin(part, obj, input)
				if not IsPrimaryInput(input) then return end
				st.drag, st.focus = part, part
				Library._lockScroll(obj, input)
				picker._drag(input, true)
				if part ~= "sv" then Library._anim.scale(part == "hue" and ui.hueThumb or ui.alphaThumb, 1.15, "fast") end
			end
			sv.InputBegan:Connect(function(i) begin("sv", sv, i) end)
			ui.hueHit.InputBegan:Connect(function(i) begin("hue", ui.hueHit, i) end)
			ui.alphaHit.InputBegan:Connect(function(i) begin("alpha", ui.alphaHit, i) end)
