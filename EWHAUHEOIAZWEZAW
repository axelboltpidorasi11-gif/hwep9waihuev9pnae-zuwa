	-- Phones have no RShift: a round glass NL button on the left edge opens
	-- and closes the menu. Drag it to move it (it settles back on the left
	-- edge); a tap toggles. Phones have no hotkeys either: the hotkey menu
	-- puts round "on-screen buttons" for functions on the screen.
	if WindowObj._mobile then
		-- Floating button kit: dragged by the finger that pressed it (another
		-- one can stay on the move stick), kept inside the safe area.
		-- opts: down/up (press and release, or a drag starting), tap
		-- (released without moving), dropped (released after a drag).
		local floats = setmetatable({}, { __mode = "k" })
		local function float(btn, opts)
			local scale = New("UIScale", { Scale = 1 }, btn)
			local api = { conns = {} }
			local press
			function api.offsetOf(pos)
				local area = NLUI.AbsoluteSize
				return pos.X.Scale * area.X + pos.X.Offset, pos.Y.Scale * area.Y + pos.Y.Offset
			end
			function api.clamp(x, y)
				local area, size, anchor = NLUI.AbsoluteSize, btn.AbsoluteSize, btn.AnchorPoint
				if area.X > 0 and area.Y > 0 then
					local minX, minY = size.X * anchor.X + 4, size.Y * anchor.Y + 4
					x = math.clamp(x, minX, math.max(minX, area.X - size.X * (1 - anchor.X) - 4))
					y = math.clamp(y, minY, math.max(minY, area.Y - size.Y * (1 - anchor.Y) - 4))
				end
				return UDim2.fromOffset(x, y)
			end
			function api.reclamp()
				btn.Position = api.clamp(api.offsetOf(btn.Position))
			end
			table.insert(api.conns, btn.InputBegan:Connect(function(input)
				if press or not IsPrimaryInput(input) then return end
				local x, y = api.offsetOf(btn.Position)
				press = { input = input, point = input.Position, x = x, y = y, moved = false }
				Tween(scale, { Scale = 0.9 }, 0.12)
				if opts.down then opts.down() end
			end))
			table.insert(api.conns, UserInputService.InputChanged:Connect(function(input)
				if not press then return end
				if press.input.UserInputType == Enum.UserInputType.Touch then
					if input ~= press.input then return end
				elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
					return
				end
				local d = input.Position - press.point
				if not press.moved and d.Magnitude > 8 then
					press.moved = true
					-- A drag is not a hold.
					if opts.up then opts.up() end
				end
				if press.moved then btn.Position = api.clamp(press.x + d.X, press.y + d.Y) end
			end))
			table.insert(api.conns, UserInputService.InputEnded:Connect(function(input)
				if not press or not IsPrimaryInput(input) then return end
				if press.input.UserInputType == Enum.UserInputType.Touch and input ~= press.input then return end
				local p = press
				press = nil
				Tween(scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				if p.moved then
					btn:SetAttribute("Dragged", true)
					if opts.dropped then opts.dropped() end
				else
					if opts.up then opts.up() end
					if opts.tap then opts.tap() end
				end
			end))
			function api.destroy()
				for _, c in ipairs(api.conns) do pcall(function() c:Disconnect() end) end
				floats[btn] = nil
				btn:Destroy()
			end
			floats[btn] = api
			return api
		end
