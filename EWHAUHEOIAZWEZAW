	local function SanitizeConfigName(name)
		name = tostring(name or "Default"):gsub('[\\/:*?"<>|%c]', "")
		name = name:gsub("^%s+", ""):gsub("[%s%.]+$", "")
		if #name == 0 then name = "Default" end
		return (name:sub(1, 64):gsub("%s+$", ""))
	end

	local function GetConfigPath(name)
		return "NeverloseConfig_" .. windowConfigId .. "_" .. SanitizeConfigName(name) .. ".json"
	end

	-- Fields, not locals: AddWindow is near the register cap.
	WindowObj._cfgExists = function(name)
		if type(isfile) ~= "function" then return false end
		local ok, exists = pcall(isfile, GetConfigPath(name))
		return ok and exists == true
	end

	-- A preset name that does not clash with an existing file ("x (2)").
	WindowObj._uniqueConfigName = function(base)
		base = SanitizeConfigName(base)
		local finalName, n = base, 1
		while WindowObj._cfgExists(finalName) do
			n = n + 1
			finalName = SanitizeConfigName(base .. " (" .. n .. ")")
		end
		return finalName
	end

	WindowObj._writeLastConfig = function(name)
		if type(writefile) == "function" then
			pcall(writefile, "NeverloseConfig_" .. windowConfigId .. "__last.txt", SanitizeConfigName(name))
		end
	end

	-- Current values as a preset table (element keys + "__extra_<key>"); also used by the
	-- New config plate and "Export current".
	WindowObj._cfgCollect = function()
		local data = {}
		-- Grouped tabs showing a custom group: their element values are saved as
		-- Global (the group's own values go with __extra_groups_<tab>).
		local globalBase = WindowObj._gvSaveBase()
		for _, entry in ipairs(_registeredElements) do
			if globalBase[entry.key] ~= nil then
				data[entry.key] = globalBase[entry.key]
			elseif entry.obj and type(entry.obj.Get) == "function" then
				local ok, value = pcall(function() return entry.obj:Get() end)
				if ok then
					local serialized = SerializeValue(value)
					if serialized ~= nil then data[entry.key] = serialized end
				end
			end
		end
		for key, extra in pairs(WindowObj._configExtras) do
			local okGet, value = pcall(extra.get)
			if okGet and value ~= nil then data["__extra_" .. key] = value end
		end
		return data
	end

	local function SaveNamedConfig(name, skipSame)
		if type(writefile) ~= "function" then return false end
		local data = WindowObj._cfgCollect()
		local http = game:GetService("HttpService")
		local ok, encoded = pcall(http.JSONEncode, http, data)
		if not ok or type(encoded) ~= "string" then return false end
		-- perf: the 10 s autosave skips the disk write when nothing changed since its last write
		if skipSame and WindowObj._cfgLastPath == GetConfigPath(name) and WindowObj._cfgLastJson == encoded then return true end
		local writeOk, writeResult = pcall(writefile, GetConfigPath(name), encoded)
		if writeOk and writeResult ~= false then
			WindowObj._cfgLastPath, WindowObj._cfgLastJson = GetConfigPath(name), encoded
			-- Metadata ("modified 2m ago", bind count) lives in NLConfigMeta_<id>.json, not in the preset.
			if WindowObj._cfgTouch then WindowObj._cfgTouch(SanitizeConfigName(name), data) end
		end
		return writeOk and writeResult ~= false
	end

	local function LoadNamedConfig(name)
		if type(readfile) ~= "function" or type(isfile) ~= "function" then return false end
		local path = GetConfigPath(name)
		local existsOk, exists = pcall(isfile, path)
		if not existsOk or not exists then return false end
		local ok, content = pcall(readfile, path)
		if not ok or type(content) ~= "string" or #content > 2097152 then return false end
		local http = game:GetService("HttpService")
		local decodedOk, data = pcall(http.JSONDecode, http, content)
		if not decodedOk or type(data) ~= "table" then return false end
		-- The file's element values are Global: grouped tabs go back to it first.
		WindowObj._gvBeforeLoad()
		for _, entry in ipairs(_registeredElements) do
			local saved = data[entry.key]
			if saved == nil then saved = entry.baseline end
			if saved ~= nil and entry.obj and type(entry.obj.Set) == "function" then
				pcall(function() entry.obj:Set(DeserializeValue(saved)) end)
			end
		end
		-- Extras after the values, so hotkeys see the loaded functions.
		for key, extra in pairs(WindowObj._configExtras) do
			local saved = data["__extra_" .. key]
			if saved ~= nil and type(extra.set) == "function" then pcall(extra.set, saved) end
		end
		if WindowObj._kbFocus and WindowObj._kbFocus.flash then task.defer(WindowObj._kbFocus.flash) end
		return true
	end

