		-- Weapon Presets popup under "Global".
		local globalPlate = hoverPlate(GlobalPreset, UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1))
		local globalHit = New("TextButton", {
			Name = "GlobalPresetHit", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 16,
		}, GlobalPreset)
		bindHover(globalHit, globalPlate)

		-- Weapon Presets (NL "Global" pill): per-tab groups of weapons. Look + popups live in
		-- Library._groupsUI (restyle there); WindowObj._groupCtx below wires state and callbacks.
		-- Public API lives on the tab: Tab:SetGroupPresets / GetGroups / GetGroup /
		-- SelectGroup (see AddTab). State: WindowObj._tabGroups[tabName] = G.
		WindowObj._tabGroups = {}
		local function curG()
			local t = tabs[activeTabIndex or 0]
			return t and WindowObj._tabGroups[t.name] or nil
		end
		local groupPopup = New("Frame", {
			Name = "WeaponPresets", Position = UDim2.new(0, 0, 1, 4), Size = UDim2.fromOffset(Library._groupsUI.width, 120),
			BackgroundColor3 = Color3.fromRGB(11, 12, 18), BorderSizePixel = 0, Visible = false, ZIndex = 120, -- popup glass colour: solid white in light
		}, GlobalPreset)
		New("UICorner", { CornerRadius = UDim.new(0, 12) }, groupPopup)
		Stroke(groupPopup).Transparency = 0.9
		groupPopup:SetAttribute("NoGlass", true) -- solid like the pill: the page does not bleed through the cards
		local groupList = New("ScrollingFrame", {
			Name = "PresetList", Position = UDim2.fromOffset(0, Library._groupsUI.listY), Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1,
			BorderSizePixel = 0, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 121,
		}, groupPopup)
		Library._sel.scrollbar(groupList)
		New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, groupList)
		New("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 1) }, groupList)

		local presetsOpen = false
		local function closePresets()
			presetsOpen = false
			if Library._groupsUI.pop then Library._groupsUI.pop.close() end
			UnregisterPopup(groupPopup)
			SmoothClose(groupPopup, 0.12)
		end
		-- Header ("Weapon Presets" title, "+" button): Library._groupsUI.header.
		local addGroup = Library._groupsUI.header(groupPopup, 121)

		local function fitPill(G)
			local name = G and G.selected or "Global"
			GlobalPreset.GlobalPresetLabel.Text = name
			local w = math.clamp(math.ceil(MeasureText(name, 13, FONT)) + 46, 86, 160)
			Tween(GlobalPreset, { Size = UDim2.fromOffset(w, 30) }, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		end
		local function findCustom(G, name)
			for i, g in ipairs(G.custom) do if g.name == name then return g, i end end
		end
		local function itemsOf(G, name)
			local g = findCustom(G, name)
			return g and { table.unpack(g.items) } or {}
		end
		local rebuildRows
		local function selectGroup(G, name, silent)
			if name ~= "Global" and not findCustom(G, name) then name = "Global" end
			local changed = G.selected ~= name
			-- Element values follow the group (overrides / Global).
			if changed then WindowObj._gvSwitch(G, name) end
			-- Values crossfade: dropdown texts swap (Library._valueSwap), the rows flash once.
			if changed and not silent and WindowObj._kbFocus and WindowObj._kbFocus.flash then task.defer(WindowObj._kbFocus.flash) end
			G.selected = name
			fitPill(G)
			if rebuildRows and (changed or presetsOpen) then rebuildRows() end
			if changed and not silent then InvokeCallback(G.onChanged, name, itemsOf(G, name)) end
		end
		local function deleteGroup(G, name)
			local _, idx = findCustom(G, name)
			if not idx then return end
			table.remove(G.custom, idx)
			if G.selected == name then selectGroup(G, "Global") else rebuildRows() end
			WindowObj._gvDelete(G, name)
			InvokeCallback(G.onDeleted, name)
		end
		rebuildRows = function()
			if presetsOpen then Library._groupsUI.build(WindowObj._groupCtx) end
		end
		WindowObj._groupCtx = {
			popup = groupPopup, list = groupList, G = curG, select = selectGroup, delete = deleteGroup, find = findCustom,
			inv = { main = MainFrame, safe = PopupSafeArea, place = MovePopupToAbsolute },
			accent = function() return mainColor end,
			zfix = function() if presetsOpen then ApplyZIndexLadder(groupPopup, groupPopup.ZIndex) end end,
			-- Height left under the pill (plate units).
			room = function()
				local sp, ss = PopupSafeArea()
				return (sp.Y + ss.Y - GlobalPreset.AbsolutePosition.Y - GlobalPreset.AbsoluteSize.Y - 14) / GetMainFrameScale()
			end,
			-- Inline rename: unique, not "Global" (false = rejected).
			rename = function(G, old, name)
				local g = findCustom(G, old)
				if not g or name == "" or string.lower(name) == "global" or (name ~= old and findCustom(G, name)) then return false end
				if name == old then return true end
				WindowObj._gvRename(G, old, name)
				g.name = name
				local wasSel = G.selected == old
				if wasSel then G.selected = name; Library._groupsUI.lastSel = name end
				fitPill(G)
				Library._groupsUI.last[name] = nil
				rebuildRows()
				InvokeCallback(G.onEdited, name, { table.unpack(g.items) }, old)
				if wasSel then InvokeCallback(G.onChanged, name, { table.unpack(g.items) }) end
				return true
			end,
			-- New group (from a template / "Empty group"): unique name, becomes the active one.
			create = function(G, name, items)
				name = tostring(name or "Unnamed")
				local base, n = name, 1
				while findCustom(G, name) or string.lower(name) == "global" do n = n + 1; name = base .. " " .. n end
				local its = {}
				for _, it in ipairs(type(items) == "table" and items or {}) do table.insert(its, tostring(it)) end
				table.insert(G.custom, { name = name, items = its })
				InvokeCallback(G.onCreated, name, { table.unpack(its) })
				Library._groupsUI.fresh = name
				selectGroup(G, name)
			end,
			-- Weapons of a group changed (chip x / picker).
			setItems = function(G, g, items)
				g.items = items
				rebuildRows()
				InvokeCallback(G.onEdited, g.name, { table.unpack(items) }, g.name)
				if G.selected == g.name then InvokeCallback(G.onChanged, g.name, { table.unpack(items) }) end
			end,
		}
		addGroup.MouseButton1Click:Connect(function()
			local G = curG()
			if G then Library._groupsUI.templates(WindowObj._groupCtx, G, addGroup) end
		end)
		globalHit.MouseButton1Click:Connect(function()
			if presetsOpen then closePresets() return end
			if not curG() then return end
			CloseAllPopupsExcept(groupPopup)
			presetsOpen = true
			RememberPopupClipping(groupPopup)
			rebuildRows()
			ApplyZIndexLadder(groupPopup, NextPopupZ())
			-- Anchored to the pill: same left edge, 4px below; SmoothOpen = glass, 0.97 scale + 6px slide.
			local sc = GetMainFrameScale()
			local target
			if groupPopup.Parent == GlobalPreset then
				target = UDim2.new(0, 0, 1, 4)
			else
				-- Moved under the window by RememberPopupClipping: same spot, window coordinates.
				local host, pa, ps = MainFrame.AbsolutePosition, GlobalPreset.AbsolutePosition, GlobalPreset.AbsoluteSize
				target = UDim2.fromOffset((pa.X - host.X) / sc, (pa.Y + ps.Y - host.Y) / sc + 4)
			end
			groupPopup.Position = target
			SmoothOpen(groupPopup, 0.04, 0.18)
			RegisterPopup(groupPopup, closePresets, globalHit)
		end)
		-- Called by the tab switch: syncs the pill with the now-active tab.
		WindowObj._syncGroups = function()
			local G = curG()
			GlobalPreset.Visible = G ~= nil
			if G then fitPill(G) end
			if presetsOpen then closePresets() end
		end
		WindowObj._groupAPI = { select = selectGroup, fit = fitPill, rebuild = rebuildRows, find = findCustom }

		-- Window-level shortcuts kept for old scripts: apply to tabs named Rage / Legit.
		function WindowObj:SetWeaponPresets(names)
			for _, t in ipairs(tabs) do
				local n = string.lower(t.name)
				if t.obj and (string.find(n, "rage", 1, true) or string.find(n, "legit", 1, true)) then
					local custom = {}
					for i, nm in ipairs(type(names) == "table" and names or {}) do if i > 1 then table.insert(custom, nm) end end
					t.obj:SetGroupPresets({ Items = {}, Groups = custom })
				end
			end
			return self
		end
		function WindowObj:OnWeaponPreset(callback)
			WindowObj._onWeaponPreset = callback
			return self
		end
		function WindowObj:GetWeaponPreset() local G = curG() return G and G.selected or "Global" end
	end

	local function SetActiveConfigName(name)
		if type(name) == "string" and name ~= "" and name ~= "Save" then
			activeConfigName = name
		else
			activeConfigName = nil
		end
		WindowObj._activePresetName = activeConfigName
		SaveText.Text = activeConfigName or "Default"
		Library._valueSwap(SaveText) -- quick text swap (old name slides up, new one in)
		UpdateSavePillWidth(SaveText.Text, true)
		-- The active preset is remembered for the next run.
		WindowObj._writeLastConfig(activeConfigName or "Default")
	end

	WindowObj._setActiveConfig = SetActiveConfigName

	-- Loads the preset saved or loaded last (remembered in "__last.txt") once
	-- the interface is up, so a re-run starts with the same settings.
	WindowObj._autoLoad = function()
		if WindowObj._autoLoaded or type(readfile) ~= "function" or type(isfile) ~= "function" then return end
		WindowObj._autoLoaded = true
		local path = "NeverloseConfig_" .. windowConfigId .. "__last.txt"
		local okExists, exists = pcall(isfile, path)
		local ok, name = false, nil
		if okExists and exists then ok, name = pcall(readfile, path) end
		if not ok or type(name) ~= "string" then name = "Default" end
		name = SanitizeConfigName(name)
		if LoadNamedConfig(name) then
			SetActiveConfigName(name)
			-- If the list is already built, mark the matching row too.
			local mark = WindowObj._rowMarks and WindowObj._rowMarks[name]
			if mark then mark() end
		end
	end

	local function ClearActiveConfig()
		activeRow = nil
		activeLoadBtn = nil
		SetActiveConfigName(nil)
	end

