	dot.Size = UDim2.fromOffset(18, 12)
	dot.BorderSizePixel = 0
	dot.BackgroundColor3 = pal.swatch or pal.plate
	dot.ZIndex = item.ZIndex + 1
	local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(0, 4); cr.Parent = dot
	local st = Instance.new("UIStroke"); st.Color = pal.light and Color3.fromRGB(120, 124, 136) or Color3.fromRGB(255, 255, 255)
	st.Transparency = pal.light and 0.6 or 0.82; st.Thickness = 1; st.Parent = dot
	-- Accent half: rounded right corners, a square strip squares off its left edge (hard split).
	for i, spec in ipairs({ { 0.5, 0.5, true }, { 0.5, 0, false } }) do
		local h = Instance.new("Frame")
		h.Name = i == 1 and "AccentHalf" or "AccentEdge"
		h:SetAttribute("NoTheme", true)
		h.BorderSizePixel = 0
		h.BackgroundColor3 = pal.accent
		h.Position = UDim2.fromScale(spec[1], 0)
		h.Size = spec[3] and UDim2.fromScale(spec[2], 1) or UDim2.new(0, 4, 1, 0)
		h.ZIndex = dot.ZIndex
		if spec[3] then local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = h end
		h.Parent = dot
	end
	dot.Parent = item
end

-- Shared effects ticker: ONE Heartbeat subscriber at 20 fps for every decoration task (snow,
-- garland, mascot). Paused (tasks not run) while the window is hidden / closed / unloaded;
-- disconnected when no task is left.
Library._fxTasks = {}
Library._fxSet = function(key, fn)
	Library._fxTasks[key] = fn
	if next(Library._fxTasks) then
		if not Library._fxConn then
			Library._fxAcc = 0
			Library._fxConn = RunService.Heartbeat:Connect(function(dt)
				Library._fxAcc = Library._fxAcc + dt
				if Library._fxAcc < 0.05 then return end
				local step = math.min(Library._fxAcc, 0.2)
				Library._fxAcc = 0
				local m, w = Library._fxMain, Library._fxWinObj
				if not (m and m.Parent and m.Visible) or (w and (w._menuOpen == false or w._unloaded)) then return end
				Library._fxTime = (Library._fxTime or 0) + step
				for _, f in pairs(Library._fxTasks) do pcall(f, step, Library._fxTime) end
			end)
		end
	elseif Library._fxConn then
		Library._fxConn:Disconnect()
		Library._fxConn = nil
	end
end
-- Decorations move only with motion on: Performance Max or Animation Speed Off = static.
Library._fxStatic = function()
	return Library._perfMode == "max" or (Library._animScale or 1) <= 0
end
Library._fxPhone = function()
	if Library._phone then return true end
	local cam = workspace.CurrentCamera
	return cam ~= nil and cam.ViewportSize.X > 0 and cam.ViewportSize.X < 700
end
Library._fxFrame = function(name, parent, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BorderSizePixel = 0
	f:SetAttribute("NoTheme", true)
	for k, v in pairs(props) do f[k] = v end
	f.Parent = parent
	return f
end
Library._fxRound = function(f, r)
	local c = Instance.new("UICorner"); c.CornerRadius = r or UDim.new(1, 0); c.Parent = f
	return f
end

-- Back layer for decorations: drawn BEFORE the window content (Global ZIndex ties follow tree
-- order and every content frame is ZIndex 1), so snow / frost / garland / mascot legs never cover a
-- control. It lives in SidebarPlate (an early child of MainFrame) and is stretched to the window.
Library._fxBack = function(main)
	local host = main:FindFirstChild("SidebarPlate") or main
	local b = host:FindFirstChild("FXBack")
	if b then return b end
	b = Library._fxFrame("FXBack", host, { BackgroundTransparency = 1, ZIndex = 1, Size = UDim2.fromScale(1, 1) })
	local function fit()
		if host == main or not b.Parent then return end
		local hs = host.AbsoluteSize
		if hs.X > 0 and hs.Y > 0 then b.Size = UDim2.fromScale(main.AbsoluteSize.X / hs.X, main.AbsoluteSize.Y / hs.Y) end
	end
	fit()
	main:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	host:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	return b
end
-- New Year signature (Library._themePal.fx = "xmas"): "quiet winter night, warm window light".
-- One idea, four hand-placed pieces; everything is NoTheme, sits behind the content
-- (Library._fxBack) or on the logo tile, is kept in Library._xmas.parts and goes on every theme
-- switch (0.6 s fade-out, then destroyed: no leftovers).
--   sprig   a fir sprig lying on the window's top-right corner, mostly above the edge: one curved
--           stem, 14 needles at one angle (upper side lit, lower side deep green), a 4-needle side
--           twig, three frosted tips, three small berries.
--   lights  a thin cord tied to the sprig, one gentle sag along the top edge, 5 small warm bulbs
--           (cap + glass, a two-step warm glow) that switch on one after another once, then stay.
--   snow    11 soft flakes in the top half of the window, slow, low contrast, behind every control.
--   hat     a small Santa hat on the logo tile.
--   ui      accent marker on the selected nav pill (the Profile header stays as in Dark: its accent
--           "Renew" line is enough).
-- Fades in over 3 s (instant when static). Performance Max / Animation Speed Off: static, no ticker.
-- Phones: 6 flakes only (the accent does the rest). Motion runs in the shared 20 fps ticker.
Library._xmas = { parts = {}, items = {}, flakes = {}, bulbs = {}, undo = {}, k = 1 }
-- Drops a fading-out set at once (destroy + undo).
Library._xmasDrop = function(set)
	for _, p in ipairs(set.parts) do pcall(function() if typeof(p) == "RBXScriptConnection" then p:Disconnect() else p:Destroy() end end) end
	for _, f in ipairs(set.undo) do pcall(f) end
end
Library._xmasSet = function(main, on)
	local X = Library._xmas
	if X.dying then Library._fxSet("xmasOut", nil); Library._xmasDrop(X.dying); X.dying = nil end
	Library._fxSet("xmas", nil)
	if X.on and #X.parts > 0 then
		local set = { parts = X.parts, undo = X.undo, items = X.items, k = 1 }
		if (Library._animScale or 1) <= 0 then
			Library._xmasDrop(set)
		else
			for _, r in ipairs(set.items) do r.cur = r.o[r.prop] end
			X.dying = set
			Library._fxSet("xmasOut", function(dt)
				set.k = set.k - dt / (0.6 * math.max(0.5, Library._animScale or 1))
				if set.k <= 0 then
					Library._fxSet("xmasOut", nil)
					if X.dying == set then X.dying = nil end
					Library._xmasDrop(set)
					return
				end
				for _, r in ipairs(set.items) do if r.o.Parent then r.o[r.prop] = 1 - (1 - r.cur) * set.k end end
			end)
		end
	end
	X.parts, X.items, X.flakes, X.bulbs, X.undo, X.mark = {}, {}, {}, {}, {}, nil
	local pal = Library._themePal
	X.kind = on and main ~= nil and pal and pal.fx or nil
	X.on = X.kind == "xmas"
	if not X.on then return end
	local R = Library._fxRound
	local function keep(p) table.insert(X.parts, p) return p end
	-- Every visible piece is registered with its resting transparency (faded in from 1).
	local function reg(o, prop, dyn)
		local r = { o = o, prop = prop or "BackgroundTransparency", dyn = dyn }
		r.b = o[r.prop]
		o[r.prop] = 1
		table.insert(X.items, r)
		return r
	end
	local function F(name, parent, props)
		local f = Library._fxFrame(name, parent, props)
		if f.BackgroundTransparency < 1 then reg(f) end
		return f
	end
	-- A bar centred on (cx, cy), rotated rot degrees (Roblox does not rotate children: every
	-- piece is placed and rotated on its own).
	local function bar(host, name, cx, cy, w, h, rot, c, t, round, z)
		local f = F(name, host, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(w, h), Rotation = rot or 0,
			BackgroundColor3 = c, BackgroundTransparency = t or 0, ZIndex = z or 1 })
		if round then R(f, round) end
		return f
	end
	-- A 1px-ish line from (xa, ya) to (xb, yb).
	local function seg(host, name, xa, ya, xb, yb, w, c, t, z)
		local dx, dy = xb - xa, yb - ya
		return bar(host, name, (xa + xb) / 2, (ya + yb) / 2, math.sqrt(dx * dx + dy * dy) + 0.5, w, math.deg(math.atan2(dy, dx)), c, t, UDim.new(1, 0), z)
	end
	local back = Library._fxBack(main)
	local phone = Library._fxPhone()
	local rng = Random.new(1225)
	local gold = pal.accent or Color3.fromRGB(214, 160, 84)

	-- (1) Snow: few soft flakes, spread evenly across the width, the bigger ones a little faster.
	local snow = keep(F("XmasSnow", back, { Size = UDim2.fromScale(1, 0.5), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 1 }))
	local nf = phone and 6 or 11
	for i = 1, nf do
		local d = (i % 4 == 0) and 4 or ((i % 3 == 0) and 3 or 2)
		local f = R(F("Flake", snow, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(d, d), BackgroundColor3 = Color3.fromRGB(218, 226, 240),
			BackgroundTransparency = 0.45 + rng:NextNumber() * 0.15, ZIndex = 1 }))
		local r = X.items[#X.items]
		r.dyn = true
		local x0 = (i - 1 + 0.2 + rng:NextNumber() * 0.6) / nf
		table.insert(X.flakes, { o = f, r = r, x = x0, x0 = x0, y = rng:NextNumber(), v = 3 + d * 1.5 + rng:NextNumber() * 2, a = 2 + rng:NextNumber() * 3,
			w = 0.25 + rng:NextNumber() * 0.2, p = rng:NextNumber() * 6.28 })
	end

	if not phone then
		-- (2) Fir sprig. Host: 116 x 34 hanging over the top-right corner; the window's corner is at
		-- (108, 16) in host space. Stem = quadratic curve from just past the right edge to the tip.
		local S = keep(F("XmasSprig", main, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 8, 0, -16), Size = UDim2.fromOffset(116, 34), BackgroundTransparency = 1, ZIndex = 3 }))
		local p0, p1, p2 = Vector2.new(113, 19), Vector2.new(84, 5), Vector2.new(50, 9)
		local function at(t) local u = 1 - t return p0 * (u * u) + p1 * (2 * u * t) + p2 * (t * t) end
		local function tan(t) local d = (p1 - p0) * (2 * (1 - t)) + (p2 - p1) * (2 * t) return d.Unit end
		local stemC, lit, deep, frost = Color3.fromRGB(50, 58, 44), Color3.fromRGB(70, 122, 88), Color3.fromRGB(36, 84, 62), Color3.fromRGB(226, 234, 244)
		-- Needles first, then the stem over their roots.
		local function needles(pt, dir, len, side, c, tip)
			local a = math.atan2(dir.Y, dir.X) + side * math.rad(44)
			local e = pt + Vector2.new(math.cos(a), math.sin(a)) * len
			seg(S, "Needle", pt.X, pt.Y, e.X, e.Y, 1.8, c, 0, 3)
			if tip then local f = pt + Vector2.new(math.cos(a), math.sin(a)) * (len - 3) seg(S, "Frost", f.X, f.Y, e.X, e.Y, 1.8, frost, 0.3, 3) end
		end
		local N = 14
		for i = 1, N do
			local t = 0.1 + (i - 1) / (N - 1) * 0.86
			local up = i % 2 == 0 -- upper side (towards the sky) catches the light
			needles(at(t), tan(t), 11 - 5 * t, up and -1 or 1, up and lit or deep, up and (i == 4 or i == 8 or i == 12))
		end
		-- Side twig off the upper side, pointing up-left, 4 needles.
		local tb = at(0.46)
		local td = Vector2.new(-0.8, -0.6).Unit
		local te = tb + td * 13
		for j = 1, 4 do
			local q = tb + td * (3 + (j - 1) * 3)
			needles(q, td, 7 - j * 0.8, j % 2 == 0 and -1 or 1, j % 2 == 0 and lit or deep)
		end
		seg(S, "Twig", tb.X, tb.Y, te.X, te.Y, 1.2, stemC, 0, 3)
		local prev = at(0)
		for i = 1, 10 do
			local p = at(i / 10)
			seg(S, "Stem", prev.X, prev.Y, p.X, p.Y, 1.8 - i * 0.08, stemC, 0, 3)
			prev = p
		end
		-- Berries: a tight cluster below the stem near its base.
		local bp = at(0.16)
		for _, b in ipairs({ { 0, 4, 4, 182 }, { 4, 3, 4, 166 }, { 2, 7, 4, 150 } }) do
			bar(S, "Berry", math.floor(bp.X) + b[1], math.floor(bp.Y) + b[2], b[3], b[3], 0, Color3.fromRGB(b[4], 40, 50), 0, UDim.new(1, 0), 3)
		end

		-- (3) String lights: a cord tied into the sprig, one gentle sag, 5 bulbs evenly spaced.
		local LW = 250
		local G = keep(F("XmasLights", main, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -58, 0, -12), Size = UDim2.fromOffset(LW, 28), BackgroundTransparency = 1, ZIndex = 3 }))
		local function cy(u) return 5 + 6 * 4 * u * (1 - u) end
		-- Bulbs sit on the first 92 % of the cord; the rest runs into the sprig's tip.
		local BU = 0.92
		local cord = Color3.fromRGB(58, 62, 70)
		-- The cord runs straight from bulb to bulb (their weight pulls it into a gentle polyline);
		-- joints sit on whole pixels under the bulb caps, so no stepped segments.
		local pts = { Vector2.new(0, 5) }
		for i = 1, 5 do local u = (i - 0.5) / 5 * BU table.insert(pts, Vector2.new(math.floor(u * LW + 0.5), math.floor(cy(u) + 0.5))) end
		table.insert(pts, Vector2.new(LW, 5))
		for i = 1, #pts - 1 do seg(G, "Cord", pts[i].X, pts[i].Y, pts[i + 1].X, pts[i + 1].Y, 1, cord, 0.2, 3) end
		bar(G, "Hook", 0, cy(0), 3, 3, 0, cord, 0, UDim.new(1, 0), 3)
		for i = 1, 5 do
			local u = (i - 0.5) / 5 * BU
			local x, y = math.floor(u * LW + 0.5), math.floor(cy(u) + 0.5)
			local lamp = {}
			-- Unlit glass (fades in with the scene), then the lit layers (switched on in turn).
			bar(G, "Cap", x, y + 2, 3, 3, 0, Color3.fromRGB(78, 80, 86), 0, UDim.new(0, 1), 3)
			bar(G, "Glass", x, y + 7, 5, 7, 0, Color3.fromRGB(96, 84, 68), 0, UDim.new(0, 2), 3)
			for _, q in ipairs({ { 18, 0.94, Color3.fromRGB(255, 160, 64) }, { 10, 0.82, Color3.fromRGB(255, 176, 88) }, { 5, 0, Color3.fromRGB(255, 212, 150) } }) do
				local h = q[1] == 5 and 7 or q[1]
				bar(G, q[1] == 5 and "Bulb" or "Glow", x, y + 7, q[1], h, 0, q[3], q[2], q[1] == 5 and UDim.new(0, 2) or UDim.new(1, 0), 3)
				local r = X.items[#X.items]
				r.dyn = true
				table.insert(lamp, r)
			end
			table.insert(X.bulbs, lamp)
		end

		-- (4) Santa hat on the logo tile's top-left corner, tipped 18 degrees, pompom drooping left
		-- (away from the title).
		local logo = main:FindFirstChild("HubIcon")
		if logo then
			local z = (logo.ZIndex or 2) + 4
			local Ht = keep(F("XmasHat", logo, { AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(-8, -9), Size = UDim2.fromOffset(24, 20), BackgroundTransparency = 1, ZIndex = z }))
			local rot = math.rad(-18)
			local ca, sa = math.cos(rot), math.sin(rot)
			local red, redD, fur = Color3.fromRGB(196, 46, 56), Color3.fromRGB(160, 34, 44), Color3.fromRGB(238, 240, 246)
			-- Hat-local pieces (centre x, y, w, h, colour, corner), origin at the brim centre.
			for _, p in ipairs({
				{ 0, -4, 12, 8, red, 4 }, { 2.5, -8.5, 8, 6, red, 3 }, { 5.5, -10.5, 6, 4, redD, 2 },
				{ 0, 0, 16, 5, fur, 2.5 }, { 9, -9.5, 5, 5, fur, 2.5 },
			}) do
				local x, y = 13 - p[1] * ca - p[2] * sa, 15 - p[1] * sa + p[2] * ca
				bar(Ht, "Hat", x, y, p[3], p[4], -18, p[5], 0, UDim.new(0, p[6]), z)
			end
		end
	end

	-- (5) Selected nav pill: an accent marker on its left, shown with the pill.
	local pill = main:FindFirstChild("NavPill")
	if pill then
		local mark = keep(R(F("XmasMark", pill, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.fromOffset(2, 14), BackgroundColor3 = gold, BackgroundTransparency = 0, ZIndex = pill.ZIndex })))
		local r = X.items[#X.items]
		r.dyn = true
		local function sync()
			r.b = pill.BackgroundTransparency > 0.98 and 1 or 0
			mark.BackgroundTransparency = 1 - (1 - r.b) * X.k
		end
		table.insert(X.parts, pill:GetPropertyChangedSignal("BackgroundTransparency"):Connect(sync))
		X.mark = sync
	end

	-- Fade in (3 s, eased) unless static.
	X.k = 0
	X.fadeT = 0
	X.fadeDur = 3 * math.max(0.5, Library._animScale or 1)
	if Library._fxStatic() then X.k, X.fadeT = 1, nil end
	Library._xmasRefresh()
end
-- One frame of every moving piece (move = advance positions; else static values).
Library._xmasFrame = function(dt, t, move)
	local X = Library._xmas
	local k = X.k
	for _, s in ipairs(X.flakes) do
		local lay = s.o.Parent
		if move and lay then
			s.y = s.y + s.v * dt / math.max(1, lay.AbsoluteSize.Y)
			if s.y > 1.05 then s.y, s.x = -0.05, s.x0 + (math.random() - 0.5) * 0.04 end
		end
		-- Fade in at the top, out over the lower half of the layer.
		local e = math.clamp((s.y - 0.5) / 0.5, 0, 1)
		if s.y < 0.06 then e = math.max(e, 1 - math.max(0, s.y + 0.05) / 0.11) end
		s.r.o.BackgroundTransparency = 1 - (1 - s.r.b) * (1 - e) * k
		s.o.Position = UDim2.new(s.x, math.sin((move and t or 0) * s.w + s.p) * s.a, s.y, 0)
	end
	-- Bulbs switch on one after another during the fade-in, then stay lit.
	local ft = X.fadeT
	for i, lamp in ipairs(X.bulbs) do
		local kb = 1
		if ft then
			kb = math.clamp((ft - 0.5 - (i - 1) * 0.35) / 0.7, 0, 1)
			kb = kb * kb * (3 - 2 * kb)
		end
		for _, r in ipairs(lamp) do r.o[r.prop] = 1 - (1 - r.b) * kb end
	end
end
-- Motion state (Performance mode / Animation Speed changed) and the fade: the ticker runs only
-- while something moves or fades; a static scene is painted once.
Library._xmasRefresh = function()
	local X = Library._xmas
	if not X.on then return end
	local static = Library._fxStatic()
	if static and X.fadeT then X.k, X.fadeT = 1, nil end
	local function statics()
		for _, r in ipairs(X.items) do if not r.dyn and r.o.Parent then r.o[r.prop] = 1 - (1 - r.b) * X.k end end
		if X.mark then X.mark() end
	end
	if static then
		statics()
		Library._xmasFrame(0, 0, false)
		Library._fxSet("xmas", nil)
		return
	end
	statics()
	Library._xmasFrame(0, Library._fxTime or 0, true)
	Library._fxSet("xmas", function(dt, t)
		if X.fadeT then
			X.fadeT = X.fadeT + dt
			local p = math.clamp(X.fadeT / X.fadeDur, 0, 1)
			X.k = p * p * (3 - 2 * p)
			if p >= 1 then X.k, X.fadeT = 1, nil end
			statics()
		end
		Library._xmasFrame(dt, t, true)
	end)
end

-- Mascot: "Santa" (CC0 Santa by pzUH + own CC0 mittens) or "Femboy" (original CC0 laptop character:
-- soft-shaded fennec-eared boy in an oversized hoodie typing on a laptop), see tools/mascot/CREDITS.md.
-- Library.Mascot.Enable(name, pose): name "Santa" | "Femboy", pose "Sit" | "Peek" (old
-- Enable("Sit" | "Peek") = Santa in that pose); Library.Mascot.Disable().
-- Sprites come from Library._mascotPack (2x px, shown at half size; getcustomasset, cached in
-- NLUI_icons/mascot_<name>.png) placed with Library._mascotMeta; without them the mascot is skipped
-- silently. Hidden on phones (< 700 px), static with Performance Max / Animation Speed Off; the body
-- sits behind the window (ZIndex 0), legs / hands lie on the glass under every control.
-- Femboy: types (3 frames, ~4 fps) while the menu is open, blinks every 4-6 s, ear twitch ~7 s,
-- tail sway; hover = looks up + waves (typing pauses); click = surprised + bubble. New Year theme
-- adds a Santa hat.
Library._mascotAsset = function(name)
	Library._mascotIds = Library._mascotIds or {}
	local cached = Library._mascotIds[name]
	if cached ~= nil then return cached or nil end
	local data = Library._mascotPack and Library._mascotPack[name]
	local getAsset = getcustomasset or getsynasset
	local result = false
	if data and type(getAsset) == "function" and type(writefile) == "function" then
		local ok, id = pcall(function()
			if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder("NLUI_icons") then makefolder("NLUI_icons") end
			local file = "NLUI_icons/mascot_" .. name .. ".png"
			local bytes = Library._b64(data)
			local same = false
			if type(isfile) == "function" and type(readfile) == "function" and isfile(file) then
				local okR, cur = pcall(readfile, file)
				same = okR and cur == bytes
			end
			if not same then writefile(file, bytes) end
			return getAsset(file)
		end)
		if ok and type(id) == "string" and id ~= "" then result = id end
	end
	Library._mascotIds[name] = result
	return result or nil
end
Library._mascotLines = {
	Santa = { "Ho ho ho!", "Been good this year?", "Save your config, kiddo!", "Cookies after this round?", "Merry Christmas!", "Stay frosty out there!" },
	Femboy = { "...one more commit", "did you save your config?", "drink some water~", "nice flick", "brb compiling", "it works on my machine" },
}
Library.Mascot = {}
Library._mascot = { parts = {} }
function Library.Mascot.Disable()
	local M = Library._mascot
	for _, p in ipairs(M.parts) do pcall(function() if typeof(p) == "RBXScriptConnection" then p:Disconnect() else p:Destroy() end end) end
	M.parts, M.mode, M.char, M.hop, M.bubble, M.hover, M.surp = {}, nil, nil, nil, nil, nil, nil
	Library._fxSet("mascot", nil)
end
function Library.Mascot.Enable(name, pose)
	local M = Library._mascot
	Library.Mascot.Disable()
	name = tostring(name or "Santa")
	if name == "Sit" or name == "Peek" then name, pose = "Santa", name end
	pose = tostring(pose or "Sit")
	if (name ~= "Santa" and name ~= "Femboy") or (pose ~= "Sit" and pose ~= "Peek") then return false end
	local main = Library._fxMain
	if not main or Library._fxPhone() then return false end
	local key, meta = string.lower(name), Library._mascotMeta or {}
	local fem = key == "femboy"
	local need
	if pose == "Sit" then
		need = fem and { "sit_tail", "sit_body", "sit_ear", "sit_wave", "sit_blink", "sit_wide", "sit_hat", "sit_front", "sit_front_wave", "sit_type2", "sit_type3" }
			or { "sit_body", "sit_blink", "sit_legs" }
	else
		need = fem and { "peek_head", "peek_ear", "peek_blink", "peek_wide", "peek_hat", "peek_hand_l", "peek_hand_r", "peek_wave" }
			or { "peek_head", "peek_blink", "mitten_r", "mitten_l", "wave" }
	end
	local ids = {}
	for _, n in ipairs(need) do
		ids[n] = meta[key .. "_" .. n] and Library._mascotAsset(key .. "_" .. n)
		if not ids[n] then return false end
	end
	M.mode, M.char = pose, name
	local back = Library._fxBack(main)
	local function img(n, z, button, parent)
		local m = meta[key .. "_" .. n]
		local i = Instance.new(button and "ImageButton" or "ImageLabel")
		i.Name = "Mascot_" .. n
		i:SetAttribute("NoTheme", true)
		i.BackgroundTransparency = 1
		i.BorderSizePixel = 0
		i.Image = ids[n]
		i.ScaleType = Enum.ScaleType.Stretch
		i.Size = UDim2.fromOffset(m.w, m.h)
		i.ZIndex = z
		if button then
			i.AutoButtonColor = false
			i.MouseEnter:Connect(function() M.hover = true end)
			i.MouseLeave:Connect(function() M.hover = nil end)
		end
		i.Parent = parent or main
		table.insert(M.parts, i)
		return i, m
	end
	-- sprite i (meta m) at anchor + its offset + (dx, dy)
	local function at(i, m, ax, ay, dx, dy)
		i.Position = UDim2.new(ax.Scale, ax.Offset + m.x + (dx or 0), ay.Scale, ay.Offset + m.y + (dy or 0))
	end
	local function hopNow()
		if not M.hop then return 0 end
		M.hop = M.hop + 0.05
		local k = M.hop / 0.45
		if k >= 1 then M.hop = nil return 0 end
		return -(fem and 6 or 14) * math.sin(k * math.pi)
	end
	-- Blink every ~4-6 s (0.15 s); ear twitch every ~6-8 s (0.3 s).
	M.blinkIn, M.blinkFor, M.earIn, M.earFor = 2 + math.random() * 3, 0, 3 + math.random() * 3, 0
	local function blinking(dt)
		M.blinkIn = M.blinkIn - dt
		if M.blinkIn <= 0 then M.blinkIn, M.blinkFor = 4 + math.random() * 2, 0.15 end
		M.blinkFor = math.max(0, M.blinkFor - dt)
		return M.blinkFor > 0 or (not fem and M.hop ~= nil)
	end
	local function twitching(dt)
		M.earIn = M.earIn - dt
		if M.earIn <= 0 then M.earIn, M.earFor = 6 + math.random() * 2, 0.3 end
		M.earFor = math.max(0, M.earFor - dt)
		return M.earFor > 0
	end
	-- Speech bubble (2.2 s, pops in) with a small tail + a hop / surprised face on click.
	local function react(anchor, side)
		M.hop, M.surp = 0, 0.7
		if M.bubble then pcall(function() M.bubble:Destroy() end) end
		local fill = Color3.fromRGB(252, 252, 255)
		local b = Instance.new("Frame")
		b.Name = "MascotBubble"
		b:SetAttribute("NoTheme", true)
		b.BackgroundColor3 = fill
		b.BorderSizePixel = 0
		b.AutomaticSize = Enum.AutomaticSize.X
		b.Size = UDim2.fromOffset(0, 30)
		b.ZIndex = 5
		Library._fxRound(b, UDim.new(0, 12))
		local st = Instance.new("UIStroke"); st.Color = fem and Color3.fromRGB(176, 150, 232) or Color3.fromRGB(214, 70, 82); st.Thickness = 1.5; st.Transparency = 0.15; st.Parent = b
		local p = Instance.new("UIPadding"); p.PaddingLeft = UDim.new(0, 12); p.PaddingRight = UDim.new(0, 12); p.Parent = b
		local t = Instance.new("TextLabel")
		t.Name = "BubbleText"
		t.BackgroundTransparency = 1
		t.AutomaticSize = Enum.AutomaticSize.X
		t.Size = UDim2.fromScale(0, 1)
		t.Font = Enum.Font.GothamBold
		t.TextSize = 13
		t.TextColor3 = fem and Color3.fromRGB(96, 70, 168) or Color3.fromRGB(150, 28, 40)
		local lines = Library._mascotLines[name]
		local pick = math.random(1, #lines)
		if pick == M.lastLine then pick = pick % #lines + 1 end
