			BackgroundColor3 = Color3.fromRGB(13, 14, 21), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = Z_BASE + 12000,
		}, main)
		K.pop:SetAttribute("NoGlass", true)
		New("UICorner", { CornerRadius = UDim.new(0, 14) }, K.pop)
		New("UISizeConstraint", { MaxSize = Vector2.new(W_PANEL, H_PANEL) }, K.pop)
		Stroke(K.pop)
		K.title = New("TextLabel", { Name = "Title", Position = UDim2.fromOffset(18, 12), Size = UDim2.new(1, -120, 0, 22), BackgroundTransparency = 1, Text = "Keybinds",
			TextSize = 17, Font = FONT_BOLD, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left }, K.pop)
		K.sub = New("TextLabel", { Name = "Sub", Position = UDim2.fromOffset(18, 34), Size = UDim2.new(1, -120, 0, 14), BackgroundTransparency = 1, Text = "",
			TextSize = 11, Font = FONT, TextColor3 = DIM, TextXAlignment = Enum.TextXAlignment.Left }, K.pop)
		local x = New("TextButton", { Name = "Close", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, K.pop)
		New("UICorner", { CornerRadius = UDim.new(0, 7) }, x)
		Library._icon(x, "close", 14, MID)
		x.MouseEnter:Connect(function() Library._anim.color(x, { BackgroundTransparency = 0.92 }) end)
		x.MouseLeave:Connect(function() Library._anim.color(x, { BackgroundTransparency = 1 }) end)
		x.MouseButton1Click:Connect(function() K.close() end)
		local field = New("Frame", { Name = "SearchField", Position = UDim2.fromOffset(16, 58), Size = UDim2.new(1, -32, 0, 30), BackgroundColor3 = Color3.fromRGB(21, 22, 31), BorderSizePixel = 0 }, K.pop)
		New("UICorner", { CornerRadius = UDim.new(0, 8) }, field)
		Stroke(field)
		local ic = Library._icon(field, "search", 14, MID)
		ic.Position = UDim2.new(0, 18, 0.5, 0)
		K.box = New("TextBox", { Name = "KBSearch", Position = UDim2.fromOffset(36, 0), Size = UDim2.new(1, -46, 1, 0), BackgroundTransparency = 1, Text = "", PlaceholderText = "Search keybinds…",
			PlaceholderColor3 = Color3.fromRGB(130, 134, 152), TextColor3 = Color3.fromRGB(228, 230, 238), TextSize = 14, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false }, field)
		K.box.Focused:Connect(function() Library._focusRing(K.box, true) end)
		K.box.FocusLost:Connect(function() Library._focusRing(K.box, false) end)
		K.box:GetPropertyChangedSignal("Text"):Connect(function() K.query = K.box.Text; K.render() end)
		local head = New("Frame", { Name = "ColumnHead", Position = UDim2.fromOffset(16, 96), Size = UDim2.new(1, -32, 0, 18), BackgroundTransparency = 1 }, K.pop)
		for _, c in ipairs({ { "FEATURE", 12, 0, Enum.TextXAlignment.Left, 0.5 }, { "MODE", 0, 0, Enum.TextXAlignment.Left, 0 }, { "KEY", 0, 0, Enum.TextXAlignment.Left, 0 } }) do
			local l = New("TextLabel", { Name = c[1], Size = UDim2.fromOffset(120, 18), BackgroundTransparency = 1, Text = c[1], TextSize = 10, Font = FONT_BOLD, TextColor3 = DIM, TextXAlignment = c[4] }, head)
			if c[1] == "FEATURE" then l.Position = UDim2.fromOffset(12, 0) elseif c[1] == "MODE" then l.AnchorPoint = Vector2.new(1, 0); l.Position = UDim2.new(1, -150, 0, 0) else l.AnchorPoint = Vector2.new(1, 0); l.Position = UDim2.new(1, -56, 0, 0) end
			if c[1] ~= "FEATURE" then l.Size = UDim2.fromOffset(70, 18); l.TextXAlignment = Enum.TextXAlignment.Left end
		end
		K.scroll = New("ScrollingFrame", { Name = "List", Position = UDim2.fromOffset(10, 116), Size = UDim2.new(1, -20, 1, -158), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255), ScrollBarImageTransparency = 0.8, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y, ClipsDescendants = true, Active = true }, K.pop)
		New("Frame", { Name = "FooterLine", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -34), Size = UDim2.new(1, -20, 0, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.94, BorderSizePixel = 0 }, K.pop)
		K.hint = New("TextLabel", { Name = "Hint", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -8), Size = UDim2.new(1, -36, 0, 16), BackgroundTransparency = 1,
			Text = "Click a key, then press the new one  -  Backspace removes  -  Esc cancels", TextSize = 11, Font = FONT, TextColor3 = DIM, TextXAlignment = Enum.TextXAlignment.Left }, K.pop)
	end
	function K.stopCapture()
		K.capturing = nil
		W._bindCapture = false
	end
	function K.render()
		ui()
		for _, c in ipairs(K.scroll:GetChildren()) do c:Destroy() end
		local list = W._bindSnapshot and W._bindSnapshot(true) or {}
		local q = string.lower(K.query or "")
		local y, shown, conflicts = 0, 0, 0
		for _, e in ipairs(list) do if e.conflict then conflicts = conflicts + 1 end end
		for _, e in ipairs(list) do
			local hay = string.lower(e.label .. " " .. e.key .. " " .. e.mode .. " " .. e.path[1] .. " " .. e.path[2])
			if q == "" or string.find(hay, q, 1, true) then
				shown = shown + 1
				local row = New("Frame", { Name = "BindRow", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, ROW_H - 2), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.97, BorderSizePixel = 0 }, K.scroll)
				New("UICorner", { CornerRadius = UDim.new(0, 9) }, row)
				local dot = New("Frame", { Name = "StateDot", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(6, 6), BorderSizePixel = 0,
					BackgroundColor3 = e.active and ctx.accent() or Color3.fromRGB(80, 84, 96) }, row)
				New("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
				local label = e.label .. (e.value and ("  =  " .. e.value) or "")
				New("TextLabel", { Name = "Name", Position = UDim2.fromOffset(26, 5), Size = UDim2.new(1, -250, 0, 18), BackgroundTransparency = 1, Text = label, TextSize = 14, Font = FONT,
					TextColor3 = TEXT, TextTransparency = e.active and 0 or 0.35, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
				New("TextLabel", { Name = "Path", Position = UDim2.fromOffset(26, 23), Size = UDim2.new(1, -250, 0, 14), BackgroundTransparency = 1, Text = e.path[1] .. (e.path[2] ~= "" and ("  ›  " .. e.path[2]) or ""),
					TextSize = 11, Font = FONT, TextColor3 = DIM, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
				-- X (remove)
				local rm = New("TextButton", { Name = "Remove", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, row)
				New("UICorner", { CornerRadius = UDim.new(0, 7) }, rm)
				Library._icon(rm, "close", 12, MID)
				rm.MouseEnter:Connect(function() Library._anim.color(rm, { BackgroundTransparency = 0.9 }) end)
				rm.MouseLeave:Connect(function() Library._anim.color(rm, { BackgroundTransparency = 1 }) end)
				rm.MouseButton1Click:Connect(function()
					K.stopCapture()
					if e.owner.dropBind then e.owner.dropBind(e.bind) end
					if W.KeybindList then W.KeybindList.refresh() end
					K.render()
				end)
				-- key chip
				local kw = math.max(44, math.ceil(MeasureText(e.key, 12, FONT)) + 20)
				local key = New("TextButton", { Name = "KeyChip", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -40, 0.5, 0), Size = UDim2.fromOffset(kw, 24),
					BackgroundColor3 = e.conflict and AMBER or Color3.fromRGB(255, 255, 255), BackgroundTransparency = e.conflict and 0.84 or 0.93, Text = e.key, TextSize = 12, Font = FONT,
					TextColor3 = e.conflict and AMBER or TEXT, AutoButtonColor = false }, row)
				New("UICorner", { CornerRadius = UDim.new(0, 7) }, key)
				if e.conflict then
					local w = Library._icon(row, "warning", 14, AMBER)
					w.Position = UDim2.new(1, -40 - kw - 14, 0.5, 0)
					w.Name = "ConflictIcon"
				end
				key.MouseButton1Click:Connect(function()
					K.stopCapture()
					K.capturing = { e = e, chip = key }
					W._bindCapture = true
					key.Text = "..."
					Library._anim.listen(key, true)
				end)
				-- mode chip (click cycles)
				local mt = cap(e.mode)
				local mw = math.ceil(MeasureText(mt, 12, FONT)) + 20
				local mode = New("TextButton", { Name = "ModeChip", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -40 - kw - (e.conflict and 36 or 8), 0.5, 0), Size = UDim2.fromOffset(mw, 24),
					BackgroundColor3 = ctx.accent(), BackgroundTransparency = 0.86, Text = mt, TextSize = 12, Font = FONT, TextColor3 = ctx.accent(), AutoButtonColor = false }, row)
				New("UICorner", { CornerRadius = UDim.new(0, 7) }, mode)
				mode.MouseButton1Click:Connect(function()
					local idx = 1
					for i, m in ipairs(MODES) do if m == e.mode then idx = i end end
					e.bind.bindMode = MODES[idx % #MODES + 1]
					if W.KeybindList then W.KeybindList.refresh() end
					K.render()
				end)
				y = y + ROW_H
			end
		end
		if shown == 0 then
			New("TextLabel", { Name = "Empty", Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, TextSize = 14, Font = FONT, TextColor3 = DIM,
				Text = #list == 0 and "No keybinds yet. Middle-click a function to add one." or "No results" }, K.scroll)
		end
		K.scroll.CanvasSize = UDim2.fromOffset(0, y)
		K.sub.Text = #list .. " binds" .. (conflicts > 0 and ("  -  " .. conflicts .. " in conflict") or "")
		K.sub.TextColor3 = conflicts > 0 and AMBER or DIM
		ApplyZIndexLadder(K.pop, K.z or (Z_BASE + 12000))
		if Library._themeMap then Library._themePass(K.pop, true) end
	end
	function K.openUI()
		if W._unloaded or not main.Visible then return end
		ui()
		if K.open then return end
		K.open = true
		ctx.closeExcept(K.pop)
		K.z = NextPopupZ()
		K.box.Text, K.query = "", ""
		K.pop.Visible = false
		K.render()
		SmoothOpen(K.pop, 0.02, 0.2)
		ctx.register(K.pop, K.close, nil)
	end
	function K.close()
		if not K.open then return end
		K.open = false
		K.stopCapture()
		pcall(function() K.box:ReleaseFocus() end)
		ctx.unregister(K.pop)
		SmoothClose(K.pop, 0.14)
	end
	UserInputService.InputBegan:Connect(function(input)
		local c = K.capturing
		if not c then return end
		local isKey = input.UserInputType == Enum.UserInputType.Keyboard
		local name = tostring(input.UserInputType):match("([^%.]+)$")
		local extra = name == "MouseButton3" or name == "MouseButton4" or name == "MouseButton5"
		if not isKey and not extra then return end
		local key = isKey and input.KeyCode or input.UserInputType
		K.capturing = nil
		Library._anim.listen(c.chip, false)
		if key == Enum.KeyCode.Escape then
			-- cancelled
		elseif key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
			if c.e.owner.dropBind then c.e.owner.dropBind(c.e.bind) end
		elseif key ~= Enum.KeyCode.Unknown and c.e.owner.rebind then
			c.e.owner.rebind(c.e.bind, key)
		end
		task.delay(0.1, function() W._bindCapture = false end)
		if W.KeybindList then W.KeybindList.refresh() end
		K.render()
	end)
	-- Hotkeys list view settings are saved with the config.
	W._configExtras.hotkeys_view = {
		get = function() return { show = W._kbShow, sort = W._kbSort, dim = W._kbDim } end,
		set = function(v)
			if type(v) == "table" and W.SetHotkeysStyle then W:SetHotkeysStyle({ show = v.show, sort = v.sort, dimInactive = v.dim }) end
		end,
	}
	W.OpenKeybinds = function(self) K.openUI() return self end
	W.CloseKeybinds = function(self) K.close() return self end
end
