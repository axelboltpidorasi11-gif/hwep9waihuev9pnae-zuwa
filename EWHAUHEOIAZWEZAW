-- One group card. Returns the card and its height.
Library._groupsUI.card = function(ctx, G, g, order, z)
	local S, GU, D = Library._sel, Library._groupsUI, Library._groupsUI.dims()
	local name = g.name
	local active = G.selected == name
	local h, k = GU.cardH(#g.items)
	local card = New("TextButton", {
		Name = "PresetCard", Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = S.white, BackgroundTransparency = 0.975,
		AutoButtonColor = false, Text = "", LayoutOrder = order, ZIndex = z,
	}, ctx.list)
	card:SetAttribute("GroupName", name)
	New("UICorner", { CornerRadius = UDim.new(0, 10) }, card)
	GU.outline(card, active, ctx.accent(), active and GU.lastSel ~= name)
	local title = New("TextButton", {
		Name = "GroupTitle", Position = UDim2.fromOffset(D.pad + 2, 0), Size = UDim2.new(1, -(D.pad + 40), 0, D.head), BackgroundTransparency = 1,
		AutoButtonColor = false, Text = name, TextColor3 = active and S.selText or S.text, TextSize = 14, Font = FONT,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = z + 2,
	}, card)
	local del = GU.iconBtn(card, "close", 11, { Name = "DeleteGroup", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0, D.head / 2), Size = UDim2.fromOffset(D.head - 10, D.head - 10) }, z + 2)
	del.MouseButton1Click:Connect(function() ctx.delete(G, name) end)
	card.MouseEnter:Connect(function() if Library._hoverBlocked(card) then return end Tween(card, { BackgroundTransparency = 0.96 }, 0.1) end)
	card.MouseLeave:Connect(function() Tween(card, { BackgroundTransparency = 0.975 }, 0.14) end)
	card.MouseButton1Click:Connect(function()
		if Library._swiped and Library._swiped() then return end
		ctx.select(G, name)
	end)
	title.MouseButton1Click:Connect(function()
		if Library._swiped and Library._swiped() then return end
		local now = os.clock()
		if GU.last[name] and now - GU.last[name] < 0.4 then
			GU.last[name] = nil
			GU.rename(card, title, function(t) return ctx.rename(G, name, t) end)
			return
		end
		GU.last[name] = now
		if G.selected ~= name then ctx.select(G, name) end
	end)
	-- Chips (wrap by hand: k per row) + the "+" chip at the end.
	local box = New("Frame", {
		Name = "Chips", Position = UDim2.fromOffset(D.pad, D.head), Size = UDim2.new(1, -D.pad * 2, 0, h - D.head - D.pad),
		BackgroundTransparency = 1, ZIndex = z + 1,
	}, card)
	local function remove(item)
		local out = {}
		for _, it in ipairs(g.items) do if it ~= item then table.insert(out, it) end end
		ctx.setItems(G, g, out)
	end
	for i, item in ipairs(g.items) do
		local col, row = (i - 1) % k, math.floor((i - 1) / k)
		GU.chip(box, item, col * (D.chipW + D.gap), row * (D.chipH + D.gap), z + 2, remove, GU.freshItem == name .. "\0" .. item)
	end
	local n = #g.items
	local add = GU.iconBtn(box, "plus", 12, { Name = "AddWeapon", Position = UDim2.fromOffset((n % k) * (D.chipW + D.gap), math.floor(n / k) * (D.chipH + D.gap)), Size = UDim2.fromOffset(D.chipH, D.chipH) }, z + 2)
	add.BackgroundColor3 = S.chipOff
	add.BackgroundTransparency = 0
	add:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, S.chipR)
	-- (iconBtn hover fades the fill to 0.9: keep the chip look instead.)
	add.MouseEnter:Connect(function() Tween(add, { BackgroundTransparency = 0 }, 0.01); Library._setC(add, "BackgroundColor3", S.chipHoverBg) end)
	add.MouseLeave:Connect(function() Tween(add, { BackgroundTransparency = 0 }, 0.01); Library._setC(add, "BackgroundColor3", S.chipOff) end)
	add.MouseButton1Click:Connect(function()
		if Library._swiped and Library._swiped() then return end
		GU.picker(ctx, G, name, add)
	end)
	if GU.fresh == name and (Library._animScale or 1) > 0 then
		-- Just created: the card rises in.
		local sc = Library._anim.scaleOf(card)
		if sc then sc.Scale = 0.96; Library._anim.move(sc, { Scale = 1 }) end
	end
	return card, h
end
-- (Re)builds the plate: Global field + cards, sizes the plate to its content (scrolls when the
-- screen is too short). Keeps the scroll position.
Library._groupsUI.build = function(ctx)
	local S, GU, D = Library._sel, Library._groupsUI, Library._groupsUI.dims()
	local list = ctx.list
	local keep = list.CanvasPosition
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local G = ctx.G()
	if not G then return end
	local z = list.ZIndex + 1
	GU.field(list, { name = "Global", order = 1, z = z, active = G.selected == "Global", accent = ctx.accent(),
		fadeIn = G.selected == "Global" and GU.lastSel ~= nil and GU.lastSel ~= "Global",
		onClick = function() ctx.select(G, "Global") end })
	local H = D.row + 2
	for i, g in ipairs(G.custom) do
		local _, h = GU.card(ctx, G, g, i + 1, z)
		H = H + 6 + h
	end
	if #G.custom == 0 then
		New("TextLabel", {
			Name = "PresetEmpty", Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "No groups yet: press + to create one",
			TextColor3 = S.dim, TextSize = 12, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 99, ZIndex = z,
		}, list)
		H = H + 6 + 26
	end
	GU.lastSel, GU.fresh, GU.freshItem = G.selected, nil, nil
	local room = math.max(ctx.room and ctx.room() or 600, 140)
	local listH = math.min(H + 2, room - GU.listY - 10)
	ctx.popup.Size = UDim2.fromOffset(D.w, GU.listY + listH + 10)
	list.Size = UDim2.new(1, 0, 0, listH)
	list.CanvasSize = UDim2.fromOffset(0, H + 2)
	list.CanvasPosition = Vector2.new(0, math.min(keep.Y, math.max(H + 2 - listH, 0)))
	if ctx.zfix then ctx.zfix() end
end
