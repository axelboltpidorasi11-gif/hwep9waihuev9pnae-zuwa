	-- Sliding active-nav pill: one plate that glides between nav rows / sub-tab rows.
	do
		local pill = New("Frame", {
			Name = "NavPill",
			Size = UDim2.fromOffset(150, 38),
			BackgroundColor3 = Color3.fromRGB(30, 32, 45),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
		}, MainFrame)
		New("UICorner", { CornerRadius = UDim.new(0, 8) }, pill)
		Stroke(pill, "ActiveStroke").Transparency = 0.94
		-- Robust: the pill only remembers WHICH row it follows. Every frame it re-measures that row
		-- (layout settles late: sub-tab lists appear/collapse, scale changes, tab count changes) and
		-- glides to the new spot; once a glide has finished a >2px mismatch is snapped away; a row
		-- that is not (effectively) visible hides the pill instead of leaving a plate in a gap.
		local target, tkind, placed, gPos, gSize, gEnd = nil, "tab", false, nil, nil, 0
		local function stroke() return pill:FindFirstChild("ActiveStroke") end
		local function hidePill()
			if not placed then return end
			placed, gPos, gSize = false, nil, nil
			Tween(pill, { BackgroundTransparency = 1 }, 0.12)
			local st = stroke()
			if st then Tween(st, { Transparency = 1 }, 0.12) end
		end
		local function shown(row)
			local o = row
			while o and o ~= MainFrame do
				if o:IsA("GuiObject") and not o.Visible then return false end
				o = o.Parent
			end
			return o == MainFrame
		end
		local function sync()
			if not target then return end
			if not target.Parent or not pill.Parent then target = nil; hidePill() return end
			if not shown(target) then hidePill() return end
			local ap, as = target.AbsolutePosition, target.AbsoluteSize
			if as.X < 2 or as.Y < 2 then return end
			local sc = math.max(UIScale.Scale, 0.1)
			local bp = MainFrame.AbsolutePosition
			local px, py = math.floor((ap.X - bp.X) / sc + 0.5), math.floor((ap.Y - bp.Y) / sc + 0.5)
			local sx, sy = math.floor(as.X / sc + 0.5), math.floor(as.Y / sc + 0.5)
			local alpha = tkind == "sub" and 0.08 or 0
			local st = stroke()
			if not placed then
				placed, gPos, gSize = true, Vector2.new(px, py), Vector2.new(sx, sy)
				pill.Position, pill.Size = UDim2.fromOffset(px, py), UDim2.fromOffset(sx, sy)
				pill.BackgroundTransparency = 1
				pill.Visible = true
				Tween(pill, { BackgroundTransparency = alpha }, 0.18)
				if st then Tween(st, { Transparency = 0.94 }, 0.18) end
				gEnd = os.clock() + 0.2
				return
			end
			if math.abs(gPos.X - px) > 0.5 or math.abs(gPos.Y - py) > 0.5 or math.abs(gSize.X - sx) > 0.5 or math.abs(gSize.Y - sy) > 0.5 then
				gPos, gSize = Vector2.new(px, py), Vector2.new(sx, sy)
				-- (While a sub-tab list expands / collapses the row moves every frame: a per-frame
				-- exponential chase stays glued to it; a fresh 0.18 s tween each frame would trail.)
				if os.clock() < (WindowObj._subAnimUntil or 0) then
					local cp, cs = pill.Position, pill.Size
					-- (35% of the gap per frame, ~0.12 s to land: halving + a 24px snap read as a jump.)
					local function ch(a, b) return math.abs(b - a) < 1 and b or a + (b - a) * 0.35 end
					Tween(pill, { Position = UDim2.fromOffset(ch(cp.X.Offset, px), ch(cp.Y.Offset, py)), Size = UDim2.fromOffset(ch(cs.X.Offset, sx), ch(cs.Y.Offset, sy)) }, 0)
					pill.BackgroundTransparency = alpha
					gPos = Vector2.new(-1e4, -1e4) -- re-check next frame
					gEnd = os.clock() + 0.24
				else
					Tween(pill, { Position = UDim2.fromOffset(px, py), Size = UDim2.fromOffset(sx, sy), BackgroundTransparency = alpha }, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				end
				if st then Tween(st, { Transparency = 0.94 }, 0.18) end
				gEnd = os.clock() + 0.24
			elseif os.clock() > gEnd then
				local cp, cs = pill.Position, pill.Size
				if math.abs(cp.X.Offset - px) > 2 or math.abs(cp.Y.Offset - py) > 2 or math.abs(cs.X.Offset - sx) > 2 or math.abs(cs.Y.Offset - sy) > 2 then
					pill.Position, pill.Size = UDim2.fromOffset(px, py), UDim2.fromOffset(sx, sy)
				end
			end
		end
		-- perf: full rate while gliding (and 0.5 s after), else every 4th frame (Performance mode Off = every
		-- frame); paused while the window is hidden.
		WindowObj._pillFrame = 0
		WindowObj._pillLoop = RunService.RenderStepped:Connect(function()
			if not target or not MainFrame.Visible then return end
			WindowObj._pillFrame += 1
			if Library._perfMode ~= "off" and os.clock() > gEnd + 0.5 and WindowObj._pillFrame % 4 ~= 0 then return end
			sync()
		end)
		-- kind: "tab" (solid plate) | "sub" (lighter plate); row = target GuiObject, nil = hide.
		function WindowObj._pillTo(row, kind)
			target, tkind = row, kind or "tab"
			if not row then hidePill() return end
			sync()
		end
		WindowObj._pillSync = sync
		-- Sub-tab list expand / collapse (Visuals > Players / World): the clipping container's height
		-- glides while every row keeps its pixel size (rows are aspect-sized from the container, so an
		-- animated container would squish them); labels / icons fade with a 25 ms stagger. The NavPill
		-- re-measures its row every frame, so it follows the rows below as they move.
		function WindowObj._subListAnim(c, open)
			if not c then return end
			local rows = {}
			for _, r in ipairs(c:GetChildren()) do
				if r:IsA("Frame") and r:GetAttribute("SubTabIndex") then rows[#rows + 1] = r end
			end
			table.sort(rows, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
			local tok = (c:GetAttribute("NLAnimTok") or 0) + 1
			c:SetAttribute("NLAnimTok", tok)
			local function parts(r) return r:FindFirstChild("STLabel"), r:FindFirstChild("STIcon") end
			local function restore()
				c:SetAttribute("NLAnimating", nil)
				for _, r in ipairs(rows) do
					local ar = r:FindFirstChildOfClass("UIAspectRatioConstraint")
					if ar then ar.AspectType = Enum.AspectType.ScaleWithParentSize end
					r.Size = UDim2.new(1, -14, 1, 0)
				end
				c.ClipsDescendants = false
				c.AutomaticSize = Enum.AutomaticSize.Y
				c.Size = UDim2.new(1, 0, 0, 20)
			end
			local animating = c:GetAttribute("NLAnimating") == true
			if not open and not c.Visible then return end
			if open and c.Visible and not animating then return end
			local sc = math.max(UIScale.Scale, 0.1)
			if WindowObj._mobile or #rows == 0 or (Library._animScale or 1) <= 0 or Library._perfMode == "max" or c.AbsoluteSize.X < 30 then
				if animating then restore() end
				for _, r in ipairs(rows) do
					local lb, ic = parts(r)
					if lb then lb.TextTransparency = 0 end
					if ic then ic.ImageTransparency = 0 end
				end
				c.Visible = open
				return
			end
			-- Natural row size (pixels, unscaled): measured while shown, else from the width.
			local rw, rh = rows[1]:GetAttribute("NLRowW"), rows[1]:GetAttribute("NLRowH")
			if not animating and c.Visible and rows[1].AbsoluteSize.Y > 4 then
				rw, rh = math.floor(rows[1].AbsoluteSize.X / sc + 0.5), math.floor(rows[1].AbsoluteSize.Y / sc + 0.5)
			end
			if not rw then
				local ar0 = rows[1]:FindFirstChildOfClass("UIAspectRatioConstraint")
				rw = math.floor(c.AbsoluteSize.X / sc - 14 + 0.5)
				rh = math.floor(rw / (ar0 and ar0.AspectRatio or 4.6) + 0.5)
			end
			rows[1]:SetAttribute("NLRowW", rw); rows[1]:SetAttribute("NLRowH", rh)
			local layout = c:FindFirstChildOfClass("UIListLayout")
			local pad = layout and layout.Padding.Offset or 4
			local full = #rows * rh + (#rows - 1) * pad
			local cur = c.Visible and math.floor(c.AbsoluteSize.Y / sc + 0.5) or 0
			c:SetAttribute("NLAnimating", true)
			for _, r in ipairs(rows) do
				local ar = r:FindFirstChildOfClass("UIAspectRatioConstraint")
				if ar then ar.AspectType = Enum.AspectType.FitWithinMaxSize end
				r.Size = UDim2.fromOffset(rw, rh)
			end
			c.AutomaticSize = Enum.AutomaticSize.None
			c.ClipsDescendants = true
			c.Size = UDim2.new(1, 0, 0, math.min(cur, full))
			c.Visible = true
			for i, r in ipairs(rows) do
				local lb, ic = parts(r)
				local d = open and (i - 1) * Library._motion.stagger or 0
				if open and not animating then
					if lb then lb.TextTransparency = 1 end
					if ic then ic.ImageTransparency = 1 end
				end
				if lb then Library._anim.fade(lb, { TextTransparency = open and 0 or 1 }, open and "base" or "fast", not open, d) end
				if ic then Library._anim.fade(ic, { ImageTransparency = open and 0 or 1 }, open and "base" or "fast", not open, d) end
			end
			WindowObj._subAnimUntil = os.clock() + Library._motion.dur(open and "slow" or "base") + 0.05
			local tw = Library._anim.move(c, { Size = UDim2.new(1, 0, 0, open and full or 0) }, open and "slow" or "base")
			local function finish()
				if c:GetAttribute("NLAnimTok") ~= tok then return end
				restore()
				if not open then
					c.Visible = false
					for _, r in ipairs(rows) do
						local lb, ic = parts(r)
						if lb then lb.TextTransparency = 0 end
						if ic then ic.ImageTransparency = 0 end
					end
				end
			end
			if tw then tw.Completed:Connect(finish) else finish() end
		end
	end
