		if not frame or not frame.Visible then return end
		UnregisterPopup(frame)
		for _, row in ipairs(frame:GetChildren()) do
			if row:IsA("GuiObject") and string.sub(row.Name, 1, 3) == "Row" and row:GetAttribute("HomeX") then
				Tween(row, { Position = UDim2.new(row.Position.X.Scale, row:GetAttribute("HomeX") + 8, row.Position.Y.Scale, row.Position.Y.Offset) },
					0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
		end
		SmoothClose(frame, 0.14)
	end
	local function openFrame(frame, x, y, trigger, closeFn, free)
		ApplyZIndexLadder(frame, NextPopupZ())
		SmoothOpen(frame, 0, 0.2)
		-- Rows slide in from the right one after another.
		local i = 0
		for _, row in ipairs(frame:GetChildren()) do
			if row:IsA("GuiObject") and string.sub(row.Name, 1, 3) == "Row" then
				i = i + 1
				local home = row:GetAttribute("HomeX")
				if not home then home = row.Position.X.Offset; row:SetAttribute("HomeX", home) end
				row.Position = UDim2.new(row.Position.X.Scale, home + 10, row.Position.Y.Scale, row.Position.Y.Offset)
				local target = UDim2.new(row.Position.X.Scale, home, row.Position.Y.Scale, row.Position.Y.Offset)
				task.delay(0.03 * i, function()
					if row.Parent then Tween(row, { Position = target }, 0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) end
				end)
			end
		end
		MovePopupToAbsolute(frame, x, y)
		-- free: placed exactly (the settings plate hugs the strip); the
		-- screen clamp pushed it down by the top-bar inset.
		if not free then ConstrainPopupToMainFrame(frame, 8) end
		local settled = frame.Position
		frame.Position = UDim2.new(settled.X.Scale, settled.X.Offset, settled.Y.Scale, settled.Y.Offset - 8)
		TweenService:Create(frame, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = settled }):Play()
		RegisterPopup(frame, closeFn, trigger)
	end

