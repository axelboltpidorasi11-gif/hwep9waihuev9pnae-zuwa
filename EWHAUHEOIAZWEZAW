end
-- Cut-outs of solid drawn glyphs (P.cut: picture sun + mountains, slider bars, globe meridians) are
-- painted in the colour BEHIND the icon. Library._iconLayers(anchor) lists what can lie under it: its
-- ancestors and, per level, the earlier-or-equal-ZIndex sibling Frames that span its x (NavPill, hover
-- tint, SidebarPlate); Library._iconBehind composites the visible ones under the icon centre (UIGradient
-- tint sampled at that point; the bottom-most layer with transparency < 0.5 counts as opaque = the
-- glass window). Library._cutWatch(anchor, parts) registers Frames / UIStrokes; one RenderStepped
-- loop repaints them when that colour changes (hover tween, gliding active pill, theme fade); the
-- layer lists are re-collected every 0.5 s.
Library._cutReg = setmetatable({}, { __mode = "k" })
Library._iconLayers = function(anchor)
	local list = {}
	local ax = anchor.AbsolutePosition.X + anchor.AbsoluteSize.X / 2
	local child, o = anchor, anchor.Parent
	local shown = true
	while o and o:IsA("GuiObject") do
		if not o.Visible then shown = false end
		-- siblings drawn under `child`, top-most first (higher ZIndex, then later child); drop shadows skipped
		local sib, kids = {}, o:GetChildren()
		local ci = table.find(kids, child) or #kids + 1
		for i, s in ipairs(kids) do
			if s ~= child and (s:IsA("Frame") or s:IsA("ScrollingFrame") or s:IsA("CanvasGroup")) and (s.ZIndex < child.ZIndex or (s.ZIndex == child.ZIndex and i < ci))
				and not s:GetAttribute("IsShadowLayer") and string.sub(s.Name, 1, 6) ~= "Shadow" then
				local p, sz = s.AbsolutePosition, s.AbsoluteSize
				if ax >= p.X and ax <= p.X + sz.X then table.insert(sib, { s, s.ZIndex * 100000 + i }) end
			end
		end
		table.sort(sib, function(a, b) return a[2] > b[2] end)
		for _, e in ipairs(sib) do table.insert(list, e[1]) end
		table.insert(list, o)
		child, o = o, o.Parent
	end
	return list, shown
end
Library._iconBehind = function(anchor, list)
	list = list or Library._iconLayers(anchor)
	local c = anchor.AbsolutePosition + anchor.AbsoluteSize / 2
	local col = nil
	for i = #list, 1, -1 do
		local l = list[i]
		local t = l.BackgroundTransparency
		if l.Parent and l.Visible and t < 0.999 and (col or t < 0.5) then
			local p, s = l.AbsolutePosition, l.AbsoluteSize
			if c.X >= p.X and c.Y >= p.Y and c.X <= p.X + s.X and c.Y <= p.Y + s.Y then
				local lc = l.BackgroundColor3
				local g = l:FindFirstChildOfClass("UIGradient")
				if g and g.Enabled and s.X > 0 and s.Y > 0 then
					local r = math.rad(g.Rotation)
					local f = math.clamp(0.5 + ((c.X - p.X) / s.X - 0.5) * math.cos(r) + ((c.Y - p.Y) / s.Y - 0.5) * math.sin(r), 0, 1)
					local kp, gc = g.Color.Keypoints, nil
					for k = 1, #kp - 1 do
						if f <= kp[k + 1].Time then
							local span = kp[k + 1].Time - kp[k].Time
							gc = kp[k].Value:Lerp(kp[k + 1].Value, span > 0 and (f - kp[k].Time) / span or 0)
							break
						end
					end
					gc = gc or kp[#kp].Value
					lc = Color3.new(lc.R * gc.R, lc.G * gc.G, lc.B * gc.B)
				end
				col = col and col:Lerp(lc, 1 - t) or lc
			end
		end
	end
	return col or Color3.fromRGB(12, 13, 20)
end
Library._cutWatch = function(anchor, parts)
	if not anchor or not parts or #parts == 0 then return end
	local rec = { parts = parts, at = -1 }
	Library._cutReg[anchor] = rec
	local function paint(r, a, now)
		if not r.list or now - r.at > 0.5 then r.list, r.shown = Library._iconLayers(a); r.at = now end
		if not r.shown then return end
		local col = Library._iconBehind(a, r.list)
		if col == r.col then return end
		r.col = col
		for _, p in ipairs(r.parts) do
			if p:IsA("UIStroke") then p.Color = col else p.BackgroundColor3 = col end
		end
	end
	task.defer(function() if anchor.Parent then paint(rec, anchor, os.clock()) end end)
	if Library._cutLoop then return end
	local frame = 0
	Library._cutLoop = RunService.RenderStepped:Connect(function()
		frame += 1
		if Library._perfMode ~= "off" and frame % 2 == 1 then return end
		local now = os.clock()
		for a, r in pairs(Library._cutReg) do
			if not a.Parent then Library._cutReg[a] = nil else paint(r, a, now) end
		end
	end)
end
-- Sidebar / sub-tab icons (WindowObj._drawTabGlyph). Chain: the old rbxassetid image only for Rage
-- (crosshair) and Inventory (layers) -> the embedded pack image (when getcustomasset works; a pack that
-- does not load is switched by _iconVerify -> _iconDowngrade) -> the drawn solid glyph s_<name>.
-- The Material sheet tile is never used here (IconNoSheet): its art does not match the original.
Library._navGlyph = {
	crosshair = "crosshair", rage = "crosshair", combat = "crosshair", aimbot = "crosshair",
	mouse = "mouse", legit = "mouse", image = "image", visuals = "image", camera = "image",
	misc = "sliders", miscellaneous = "sliders", extensions = "sliders", settings = "sliders", sliders = "sliders",
	user = "user", player = "user", players = "user", earth = "globe", world = "globe", globe = "globe",
	layers = "layers", inventory = "layers",
