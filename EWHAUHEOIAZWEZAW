	function S.closeFs(instant)
		local V = S.fs
		if not V then return end
		S.fs = nil
		task.defer(UnregisterPopup, V.frame)
		if V.esc then V.esc:Disconnect() end
		if V.vis then V.vis:Disconnect() end
		for _, c in ipairs(V.conns) do c:Disconnect() end
		for _, c in ipairs(V.optConns) do c:Disconnect() end
		if Library._frost and V.frame:GetAttribute("Frosting") then Library._frost(V.frame, false) end
		S.page.Visible = not (S.P and S.P.open)
		if S.P and S.P.open then S.P.frame.Visible = true end
		local function gone() V.frame:Destroy(); V.dim:Destroy() end
		if instant or (Library._animScale or 1) <= 0 then gone() else
			Library._anim.raw(V.dim, { BackgroundTransparency = 1 }, "fast", "exit")
			Library._anim.fade(V.frame, { GroupTransparency = 1 }, "fast", true)
			Library._anim.tween(V.scale, { Scale = 0.96 }, "fast", "exit")
			task.delay(Library._motion.dur("fast") + 0.03, gone)
		end
