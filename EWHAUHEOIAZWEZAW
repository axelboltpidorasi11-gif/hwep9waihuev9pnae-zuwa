		-- Keyboard: Enter = create, Esc = cancel (also closes the copy list), Tab / Shift+Tab walk
		-- field -> Start from -> Include -> Cancel -> Create; Left / Right inside a group; Space / Enter
		-- activates the focused control.
		local function stops()
			local list = { P.box }
			if P.kind == "new" then
				for _, k in ipairs(P.segOrder) do table.insert(list, P.seg[k]) end
				if P.mode == "copy" then table.insert(list, P.srcBtn) end
				for _, c in ipairs(CATS) do table.insert(list, P.incChips[c]) end
			end
			if P.cancel.Visible then table.insert(list, P.cancel) end
			table.insert(list, P.create)
			return list
		end
		local function focusTo(target)
			P.focus = target
			if target == P.box then P.ring.Visible = false; P.box:CaptureFocus() return end
			pcall(function() P.box:ReleaseFocus() end)
			local sc = P.f.AbsoluteSize.X / math.max(P.W or 1, 1)
			local rel = (target.AbsolutePosition - P.f.AbsolutePosition) / sc
			P.ring.Position = UDim2.fromOffset(rel.X - 2, rel.Y - 2)
			P.ring.Size = UDim2.fromOffset(target.AbsoluteSize.X / sc + 4, target.AbsoluteSize.Y / sc + 4)
			P.ring.Visible = true
		end
		local function activate(target)
			if target == P.create then submit()
			elseif target == P.cancel then closePlate()
			elseif target == P.srcBtn then if P.srcList.Visible then hideSrc() else showSrc() end
			else
				for key, chip in pairs(P.seg) do if chip == target then setMode(key); focusTo(target) return end end
				for _, c in ipairs(CATS) do
					if P.incChips[c] == target then
						P.inc[c] = not P.inc[c] or nil
						chipPaint(target, P.inc[c] == true, P.incLabels[c])
						refresh()
						return
					end
				end
			end
		end
		Library._uis("InputBegan", function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape then WindowObj._cfgEscAt = os.clock() end
			if not P.open or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			local kc = input.KeyCode
			if kc == Enum.KeyCode.Escape then
				if P.srcList.Visible then hideSrc() else closePlate() end
			elseif kc == Enum.KeyCode.Tab then
				local list = stops()
				local back = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
				local cur = table.find(list, P.focus or (UserInputService:GetFocusedTextBox() == P.box and P.box) or P.box) or 1
				local nxt = cur + (back and -1 or 1)
				if nxt < 1 then nxt = #list elseif nxt > #list then nxt = 1 end
				focusTo(list[nxt])
			elseif (kc == Enum.KeyCode.Return or kc == Enum.KeyCode.KeypadEnter) and UserInputService:GetFocusedTextBox() ~= P.box then
				if P.focus and P.focus ~= P.box then activate(P.focus) else submit() end
			elseif kc == Enum.KeyCode.Space and P.focus and P.focus ~= P.box then
				activate(P.focus)
			elseif (kc == Enum.KeyCode.Left or kc == Enum.KeyCode.Right) and P.focus and P.focus ~= P.box then
				local list = stops()
				local i = table.find(list, P.focus)
				local j = i and i + (kc == Enum.KeyCode.Left and -1 or 1)
				if j and list[j] and list[j] ~= P.box and list[j].Parent == P.focus.Parent then focusTo(list[j]) end
			end
		end)

