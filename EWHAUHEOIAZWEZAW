		-- Positions every part for the current kind / mode / device (phones: 40px field, 34-36px chips).
		layout = function()
			local f = P.f
			local phone = Library._phone
			local safePos, safeSize = PopupSafeArea()
			local sc = GetMainFrameScale()
			local maxW = safeSize.X > 0 and (safeSize.X / sc - 16) or 480
			local W = math.floor(math.min(phone and 470 or 288, maxW))
			local FH, SH, CH, BH = phone and 40 or 32, phone and 36 or 28, phone and 34 or 26, phone and 40 or 32
			local inner = W - 24
			f.Size = UDim2.fromOffset(W, f.Size.Y.Offset)
			P.field.Size = UDim2.new(1, -24, 0, FH)
			P.count.Visible = P.kind == "new"
			P.box.Size = UDim2.new(1, P.kind == "new" and -58 or -20, 1, 0)
			P.hint.Position = UDim2.fromOffset(16, 42 + FH + 4)
			local y = 42 + FH + 26
			local isNew = P.kind == "new"
			P.startGroup.Visible = isNew
			P.incGroup.Visible = isNew
			if isNew then
				-- Start from: three equal segments + a description / copy source line.
				local segW = math.floor((inner - 8) / 3)
				for i, key in ipairs(P.segOrder) do
					local chip = P.seg[key]
					chip.Position = UDim2.fromOffset((i - 1) * (segW + 4), 18)
					chip.Size = UDim2.fromOffset(i == 3 and inner - 2 * (segW + 4) or segW, SH)
				end
				local dy = 18 + SH + 6
				local DH = phone and 32 or 26
				P.desc.Position = UDim2.fromOffset(4, dy)
				P.srcBtn.Position = UDim2.fromOffset(0, dy)
				P.srcBtn.Size = UDim2.new(1, 0, 0, DH)
				P.desc.Visible = P.mode ~= "copy"
				P.srcBtn.Visible = P.mode == "copy"
				P.desc.Text = P.mode == "default" and "Every value starts at its default" or "Saves what you have set right now"
				srcText()
				local sgH = dy + (P.mode == "copy" and DH or 16)
				P.startGroup.Position = UDim2.fromOffset(12, y)
				P.startGroup.Size = UDim2.new(1, -24, 0, sgH)
				y = y + sgH + 12
				-- Include chips, wrapped into rows.
				local x, cy = 0, 18
				for _, c in ipairs(CATS) do
					local chip = P.incChips[c]
					local w = math.ceil(MeasureText(CAT_LABEL[c], 13, FONT)) + 36
					if x > 0 and x + w > inner then x = 0; cy = cy + CH + 6 end
					chip.Position = UDim2.fromOffset(x, cy)
					chip.Size = UDim2.fromOffset(w, CH)
					x = x + w + 6
				end
				P.incGroup.Position = UDim2.fromOffset(12, y)
				P.incGroup.Size = UDim2.new(1, -24, 0, cy + CH)
				y = y + cy + CH + 14
			else
				y = y + 2
			end
			local cw, bw = phone and 92 or 80, phone and 104 or 92
			P.create.Size = UDim2.fromOffset(bw, BH)
			P.cancel.Size = UDim2.fromOffset(cw, BH)
			P.create.Position = UDim2.fromOffset(W - 12 - bw, y)
			P.cancel.Position = UDim2.fromOffset(W - 12 - bw - 6 - cw, y)
			P.cancel.Visible = P.kind ~= "export"
			f.Size = UDim2.fromOffset(W, y + BH + 12)
			P.W = W
		end

		local function setCreate(enabled)
			local b = P.create
			b:SetAttribute("Disabled", not enabled or nil)
			local st = b:FindFirstChild("ButtonStroke")
			-- Before the plate opens: instant (the open fade restores the values it finds).
			if not P.open then
				b.BackgroundTransparency, b.TextTransparency = enabled and 0.86 or 0.95, enabled and 0 or 0.55
				if st then st.Transparency = enabled and 0.86 or 0.94 end
				return
			end
			Tween(b, { BackgroundTransparency = enabled and 0.86 or 0.95, TextTransparency = enabled and 0 or 0.55 }, 0.12)
			if st then Tween(st, { Transparency = enabled and 0.86 or 0.94 }, 0.12) end
		end
		local function showBad(msg)
			P.badShown = msg ~= nil and msg ~= ""
			P.hint.Text = msg or ""
			Library._setC(P.hint, "TextColor3", RED)
			P.fieldStroke.Color = P.badShown and RED or STROKE.Color
			Tween(P.fieldStroke, { Transparency = P.badShown and 0.35 or 0.9 }, 0.12)
		end
		refresh = function()
			if not P.f then return end
			if P.kind == "export" then setCreate(true) return end
			if P.kind == "import" then
				local has = P.box.Text:find("%S") ~= nil
				showBad(P.importErr)
				setCreate(has)
				return
			end
			local text = P.box.Text
			local len = utf8.len(text) or #text
			P.count.Text = len .. "/" .. MAXLEN
			Library._setC(P.count, "TextColor3", len > MAXLEN and RED or S.dim)
			local err = WindowObj._cfgValidate(text, nil, P.names)
			if not err and P.mode == "copy" and not P.src then err = "Pick a config to copy" end
			if not err and not next(P.inc) then err = "Include at least one part" end
			showBad((P.touched or text ~= "") and err or nil)
			setCreate(err == nil)
		end
		local function shake()
			local fld = P.field
			local base = UDim2.fromOffset(12, 42)
			task.spawn(function()
				for _, dx in ipairs({ -5, 5, -4, 4, -2, 0 }) do
					if not fld.Parent then return end
					Tween(fld, { Position = base + UDim2.fromOffset(dx, 0) }, 0.04)
					task.wait(0.045)
				end
				fld.Position = base
			end)
		end
		submit = function()
			if not P.open then return end
			if P.kind == "export" then closePlate() return end
			if P.kind == "import" then
				local n, err = WindowObj._cfgImport(P.box.Text)
				if not n then P.importErr = err or "Not a valid config code"; refresh(); shake() return end
				closePlate()
				return
			end
			local err, name = WindowObj._cfgValidate(P.box.Text, nil, P.names)
			if not err and P.mode == "copy" and not P.src then err = "Pick a config to copy" end
			if not err and not next(P.inc) then err = "Include at least one part" end
			if err then P.touched = true; showBad(err); shake() return end
			local ok, werr = WindowObj._cfgCreate(name, P.mode, P.src, P.inc)
			if not ok then showBad(werr); shake() return end
			closePlate()
			WindowObj._cfgAfterCreate(name, { activate = true, verb = "created" })
		end

		closePlate = function()
			if not P.open then return end
			P.open = false
			Library._kbTrap = nil
			hideSrc()
			P.ring.Visible = false
