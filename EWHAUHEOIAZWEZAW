-- Items of a picker: { { "Pistols", { names } }, ... }. items = flat list (sorted into the CS2
-- categories by name; unknown -> "Other"), a { Category = { names } } map, or nil (every weapon).
Library._groupsUI.cats = function(items)
	local order, by = {}, {}
	local function put(cat, name)
		if not by[cat] then by[cat] = {}; table.insert(order, cat) end
		table.insert(by[cat], tostring(name))
	end
	if type(items) ~= "table" or next(items) == nil then
		for _, w in ipairs(Library._weapons) do put(w[4], w[1]) end
	elseif items[1] ~= nil then
		for _, it in ipairs(items) do
			local w = Library._weaponInfo(it)
			put(w and w[4] or "Other", it)
		end
	else
		for cat, list in pairs(items) do
			if type(list) == "table" then for _, it in ipairs(list) do put(tostring(cat), it) end end
		end
	end
	local rank = {}
	for i, c in ipairs(Library._weaponCats) do rank[c] = i end
	table.sort(order, function(a, b)
		local ra, rb = rank[a] or (a == "Other" and 1000 or 100), rank[b] or (b == "Other" and 1000 or 100)
		if ra ~= rb then return ra < rb end
		return a < b
	end)
	local out = {}
	for _, c in ipairs(order) do table.insert(out, { c, by[c] }) end
	return out
end
-- Inline rename over a card title: a TextBox; Enter commits (commit(text) -> false = rejected,
-- the box shakes red and stays), Esc / blur cancels.
Library._groupsUI.rename = function(card, label, commit)
	local S = Library._sel
	if not label or card:FindFirstChild("PresetRename") then return end
	local box = New("TextBox", {
		Name = "PresetRename", Position = label.Position + UDim2.fromOffset(-4, 6), Size = label.Size - UDim2.fromOffset(-4, 12), BackgroundColor3 = S.white, BackgroundTransparency = 0.92,
		Text = label.Text, TextColor3 = S.selText, TextSize = label.TextSize, Font = FONT, ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = label.ZIndex + 3,
	}, card)
	New("UICorner", { CornerRadius = UDim.new(0, 6) }, box)
	New("UIPadding", { PaddingLeft = UDim.new(0, 4) }, box)
	if Library._focusRing then Library._focusRing(box, true) end
	label.Visible = false
	box.FocusLost:Connect(function(enter)
		local text = (box.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if enter and text ~= label.Text and commit(text) == false then
			Library._setC(box, "TextColor3", Color3.fromRGB(240, 96, 104))
			task.defer(function() if box.Parent then box:CaptureFocus() end end)
			return
		end
		if box.Parent then box:Destroy() end
		if label.Parent then label.Visible = true end
	end)
	task.defer(function()
		if not box.Parent then return end
		box:CaptureFocus()
		pcall(function() box.CursorPosition = #box.Text + 1; box.SelectionStart = 1 end) -- whole name selected: typing replaces it
	end)
	return box
end
