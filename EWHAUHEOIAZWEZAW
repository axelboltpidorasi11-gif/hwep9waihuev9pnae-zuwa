			GroupTransparency = 1, Visible = false, Active = true, ZIndex = 300,
		}, ctx.host)
		New("UICorner", { CornerRadius = UDim.new(0, 12) }, pk)
		P.frame = pk
		-- Glass like the plates: only the background is see-through (acrylic blur of the
		-- world behind the window); the content layers stay opaque. The inventory page
		-- under it is hidden while the picker is open, so nothing ghosts through.
		if Library._popupGlass then Library._popupGlass(pk) end
		P.glassAlpha = Library._plateAlphaNow and Library._plateAlphaNow() or 0.12
		pk.BackgroundTransparency = P.glassAlpha
		P.scale = Instance.new("UIScale"); P.scale.Parent = pk
		P.title = New("TextLabel", {
			Name = "PickerTitle", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.new(1, -150, 0, 24),
			BackgroundTransparency = 1, Text = "", TextColor3 = Color3.fromRGB(236, 238, 244), TextSize = 18, Font = FONT, TextTruncate = Enum.TextTruncate.AtEnd,
		}, pk)
