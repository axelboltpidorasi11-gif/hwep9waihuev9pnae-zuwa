	}, TabHose)

	local SubTabHose = New("CanvasGroup", {
		Name = "SubTabHose",
		Position = UDim2.new(0, 8, 0, 58),
		Size = UDim2.new(1, -16, 1, -66),
		BackgroundColor3 = Color3.fromRGB(162, 162, 161),
		BackgroundTransparency = 1,
		GroupTransparency = 0,
	}, Frame2)
	New("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }, SubTabHose)
	-- Page fade for tab / sub-tab switches (both hoses at once).
	WindowObj._pageFade = function(show, dur)
		for _, hose in ipairs({ TabHose, SubTabHose }) do
			if show then hose.GroupTransparency = math.max(hose.GroupTransparency, 0) end
			-- Out: 0.1 s Quad In (the next page starts at 0.08 s, so there is no
			-- blank gap); in: 0.22 s Quint Out.
			if show then
				Library._anim.fade(hose, { GroupTransparency = 0 }, 0.22)
			else
				Library._anim.fade(hose, { GroupTransparency = 1 }, 0.1, true)
			end
			-- Shared Y axis: the leaving page lifts 8px while it fades (top padding 2 -> -6),
			-- the new one comes up from 8px below (its columns' padding 8 -> 0).
			local pad = hose:FindFirstChildOfClass("UIPadding")
			if pad then
				if show then
					Tween(pad, { PaddingTop = UDim.new(0, 2) }, 0)
				else
					Library._anim.tween(pad, { PaddingTop = UDim.new(0, -6) }, 0.1, "exit")
				end
			end
		end
	end
	New("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, SubTabHose)
	-- Scroll edge fades: the page hose is a CanvasGroup, so one UIGradient fades its top / bottom
	-- 12px while a visible column has content scrolled past that edge (event driven: scroll,
	-- canvas size, visibility; at most one refresh per frame). Max performance = none.
	function WindowObj._edgeFade(hose)
		if Library._perfMode == "max" or not hose:IsA("CanvasGroup") then return end
		local g = Instance.new("UIGradient")
		g.Name = "EdgeFade"; g.Rotation = 90; g.Parent = hose
		local pending, lastKey = false, nil
		local function refresh()
			pending = false
			if not g.Parent then return end
			local top, bottom = false, false
			for _, col in ipairs(hose:GetChildren()) do
				if col:IsA("ScrollingFrame") and col.Visible then
					local y, max = col.CanvasPosition.Y, col.AbsoluteCanvasSize.Y - col.AbsoluteWindowSize.Y
					if y > 1 then top = true end
					if max > 1 and y < max - 1 then bottom = true end
				end
			end
			local h = hose.AbsoluteSize.Y / math.max(UIScale.Scale, 0.1)
			if h < 60 then return end
			local f = 12 / h
			local key = (top and "t" or "") .. (bottom and "b" or "") .. math.floor(h)
			if key == lastKey then return end
			lastKey = key
			g.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, top and 1 or 0), NumberSequenceKeypoint.new(f, 0),
				NumberSequenceKeypoint.new(1 - f, 0), NumberSequenceKeypoint.new(1, bottom and 1 or 0),
			})
		end
		local function soon()
			if pending then return end
			pending = true
			task.defer(refresh)
		end
		local function hook(col)
			if not col:IsA("ScrollingFrame") then return end
			col:GetPropertyChangedSignal("CanvasPosition"):Connect(soon)
			col:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(soon)
			col:GetPropertyChangedSignal("Visible"):Connect(soon)
			soon()
		end
		for _, col in ipairs(hose:GetChildren()) do hook(col) end
		hose.ChildAdded:Connect(hook)
		hose:GetPropertyChangedSignal("AbsoluteSize"):Connect(soon)
	end
	WindowObj._edgeFade(TabHose)
	WindowObj._edgeFade(SubTabHose)

