		-- so the side pills are set again once it has finished
		task.delay(0.3, function() if not S.fs then S.layoutSides(true) end end)
		S.refreshMain(false)
		if S.P and S.P.open then S.render(true) end
		fire("OnFullscreen", V.item, false)
