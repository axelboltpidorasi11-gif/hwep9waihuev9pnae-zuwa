		local tl = Library._fxFrame("BubbleTail", b, { BackgroundColor3 = fill, Size = UDim2.fromOffset(9, 9), Rotation = 45, ZIndex = 5, AnchorPoint = Vector2.new(0.5, 0.5) })
		local k = anchor.AbsoluteSize.X / math.max(1, anchor.Size.X.Offset)
		local x = (anchor.AbsolutePosition.X - main.AbsolutePosition.X) / k
		local y = (anchor.AbsolutePosition.Y - main.AbsolutePosition.Y) / k
