					ZIndex = 2,
				}, Line)
				New("UICorner", { CornerRadius = UDim.new(1, 0) }, InLine)

				local Trigger = New("TextButton", {
					Name = "Trigger",
					Position = UDim2.new(0.10000000149011612, 0, -1.8000000715255737, 0),
					Size = UDim2.new(1.1999999284744263, 0, 4.200000286102295, 0),
					AnchorPoint = Vector2.new(0.800000011920929, 0),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BackgroundTransparency = 1,
					Active = false,
					Text = "",
					ZIndex = 3,
				}, Line)
				New("UICorner", { CornerRadius = UDim.new(1, 0) }, Trigger)
				New("UIAspectRatioConstraint", {}, Trigger)
				local Thumb = New("Frame", {
					Name = "Thumb",
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(initRatio, 0, 0.5, 0),
					Size = UDim2.fromOffset(Library._phone and 16 or 10, Library._phone and 16 or 10),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 0,
					ZIndex = Line.ZIndex + 3,
				}, Line)
				New("UICorner", { CornerRadius = UDim.new(1, 0) }, Thumb)
				Stroke(Thumb)
				Line.MouseEnter:Connect(function() if Library._hoverBlocked(Line) or Library._phone then return end
					Tween(Thumb, { Size = UDim2.fromOffset(12, 12) }, 0.11, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
					Library._anim.glow(Thumb:FindFirstChildOfClass("UIStroke"), true, mainColor, 3)
				end)
				Line.MouseLeave:Connect(function()
					if Library._phone or dragging then return end
					Tween(Thumb, { Size = UDim2.fromOffset(10, 10) }, 0.13, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
					Library._anim.glow(Thumb:FindFirstChildOfClass("UIStroke"), false)
				end)
				local initialValue = value
				task.defer(function()
					if value ~= initialValue then return end
					InLine.Size = UDim2.fromScale(initRatio, 1)
					Thumb.Position = UDim2.new(initRatio, 0, 0.5, 0)
					Trigger.Position = UDim2.new(initRatio, 0, -1.8000000715255737, 0)
				end)

					-- Motion: drag tracking is direct (Tween 0 cancels any running
					-- glide); only a click-jump / Set glides (fast) and counts the value.
					local function update(input, jump)
						local pointer = GetInputPosition(input)
						local lineSize = Line.AbsoluteSize.X
						if lineSize <= 0 then return end
						local sizeScale = ClampRatio(pointer.X - Line.AbsolutePosition.X, lineSize)
						local nextValue = Quantize(((max - min) * sizeScale) + min, min, max, GetSliderStep(min, max))
						local changed = nextValue ~= value
						local fromValue = value
						value = nextValue
						local span = max - min
						local snappedRatio = span ~= 0 and math.clamp((value - min) / span, 0, 1) or 0
						Library._anim.move(InLine, { Size = UDim2.fromScale(snappedRatio, 1) }, jump and "fast" or 0)
						Trigger.Position = UDim2.new(snappedRatio, 0, -1.8000000715255737, 0)
						Library._anim.move(Thumb, { Position = UDim2.new(snappedRatio, 0, 0.5, 0) }, jump and "fast" or 0)
						if jump then
							Library._anim.number(SliderValue, fromValue, value, function(v) return WindowObj._sliderText(SliderValue, Quantize(v, min, max, GetSliderStep(min, max)), suffix) end)
						else
							Library._anim.number(SliderValue)
							SliderValue.Text = WindowObj._sliderText(SliderValue, value, suffix)
						end
						if changed then InvokeCallback(callback, value) end
					end

				local Hitbox = New("TextButton", {
					Name = "SliderHitbox",
					Position = UDim2.new(0.03999999910553033, 0, 0, -10),
					Size = UDim2.new(0.6000000238418579, 0, 1, 20),
					BackgroundTransparency = 1,
					Text = "",
					AutoButtonColor = false,
					ZIndex = 4,
				}, Effect)
				-- Phones: 16px thumb (18 while dragged); a touch drags only once it moves sideways.
				local function beginDrag(input)
					dragging = true
					Tween(Thumb, { Size = UDim2.fromOffset(Library._phone and 18 or 14, Library._phone and 18 or 14) }, 0.1, Enum.EasingStyle.Quad) Tween(SliderValue, { TextTransparency = 0 }, 0.1)
					Library._anim.glow(Thumb:FindFirstChildOfClass("UIStroke"), true, mainColor, 3)
					Library._lockScroll(Line, input)
					update(input, true)
				end
				local function pressSlider(input)
					if not IsPrimaryInput(input) or dragging then return end
					if Library._touchAxis(input, function() beginDrag(input) end, function() update(input, true) end) then return end
					beginDrag(input)
				end
				Hitbox.InputBegan:Connect(pressSlider)
				Line.InputBegan:Connect(pressSlider)
				-- (The hit strip covers the bar: hover the thumb from it too.)
				Hitbox.MouseEnter:Connect(function() if Library._hoverBlocked(Line) or Library._phone then return end
					Tween(Thumb, { Size = UDim2.fromOffset(12, 12) }, 0.11, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
					Library._anim.glow(Thumb:FindFirstChildOfClass("UIStroke"), true, mainColor, 3)
				end)
				Hitbox.MouseLeave:Connect(function()
					if Library._phone or dragging then return end
					Tween(Thumb, { Size = UDim2.fromOffset(10, 10) }, 0.13, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
					Library._anim.glow(Thumb:FindFirstChildOfClass("UIStroke"), false)
				end)

				Library._uis("InputEnded", function(input)
					if IsPrimaryInput(input) then
						if dragging then Tween(Thumb, { Size = UDim2.fromOffset(Library._phone and 16 or 10, Library._phone and 16 or 10) }, 0.14, Enum.EasingStyle.Quad); Tween(SliderValue, { TextTransparency = 0.2 }, 0.3); Library._anim.glow(Thumb:FindFirstChildOfClass("UIStroke"), false) end
						dragging = false
					end
				end)

				Library._uis("InputChanged", function(input)
					if dragging then
						if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
							update(input)
						end
					end
				end)

				local obj = {}
				function obj:Set(val)
					local before = value
					local numeric = type(val) == "number" and val == val and val or min
						value = math.clamp(numeric, min, max)
					value = Quantize(value, min, max, GetSliderStep(min, max))
					local span = max - min
					local ratio = span ~= 0 and math.clamp((value - min) / span, 0, 1) or 0
					Library._anim.move(InLine, { Size = UDim2.fromScale(ratio, 1) }, "fast")
					Trigger.Position = UDim2.new(ratio, 0, -1.8000000715255737, 0)
					Library._anim.move(Thumb, { Position = UDim2.new(ratio, 0, 0.5, 0) }, "fast")
					-- Shown: the readout counts to the new value (config loads, Set); hidden: instant.
					if before ~= nil and SliderValue.AbsoluteSize.X > 0 and IsAncestorVisible(SliderValue) then
						Library._anim.number(SliderValue, before, value, function(v) return WindowObj._sliderText(SliderValue, Quantize(v, min, max, GetSliderStep(min, max)), suffix) end)
					else
						Library._anim.number(SliderValue)
						SliderValue.Text = WindowObj._sliderText(SliderValue, value, suffix)
					end
					InvokeCallback(callback, value)
				end
				function obj:Get() return value end
				function obj:AddSettings() return MakeSettings(Slider, "slider", text) end
				RegisterConfigElement("slider_", text, obj)
				CenterElement(Slider)
				BindElementContext(Slider, "slider", text, obj, value, nil, min, max)
				return obj
			end

