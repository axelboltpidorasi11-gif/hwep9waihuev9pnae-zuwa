				local oldName = name
				local text = (tostring(Rename.Text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
				-- Esc (or an unchanged name) cancels; Enter / clicking away applies.
				local escaped = os.clock() - (WindowObj._cfgEscAt or 0) < 0.25
				if escaped or text == oldName then Rename.Text = oldName return end
				local err = WindowObj._cfgValidate and WindowObj._cfgValidate(text, oldName)
				if err then
					Rename.Text = oldName
					rowNote(err, true)
					return
				end
				local newName = text
				local okMove = false
				if type(readfile) == "function" and type(writefile) == "function" and WindowObj._cfgExists(oldName) then
					local readOk, content = pcall(readfile, GetConfigPath(oldName))
					if readOk and type(content) == "string" then
						-- Case-only rename on a case-insensitive disk: remove first, then write.
						local caseOnly = string.lower(newName) == string.lower(oldName)
						if caseOnly and type(delfile) == "function" then pcall(delfile, GetConfigPath(oldName)) end
						local writeOk, writeResult = pcall(writefile, GetConfigPath(newName), content)
						okMove = writeOk and writeResult ~= false
						if not okMove and caseOnly then pcall(writefile, GetConfigPath(oldName), content) end
						if okMove and not caseOnly and type(delfile) == "function" then pcall(delfile, GetConfigPath(oldName)) end
					end
				end
				if not okMove then
					Rename.Text = oldName
					rowNote("Rename failed", true)
					return
				end
				name = newName
				row.Name = "ConfigRow_" .. newName
				Rename.Text = newName
				if WindowObj._cfgMetaRename then WindowObj._cfgMetaRename(oldName, newName) end
				if WindowObj._cfgFlash then WindowObj._cfgFlash(row, false) end
				if WindowObj._knownConfigs then WindowObj._knownConfigs[oldName] = nil; WindowObj._knownConfigs[newName] = true end
				local marks = WindowObj._rowMarks
