-- Preserve each widget's authored alpha and reveal real content rows with a
-- short, staggered fade. State is cached per instance so tab switches do not
-- overwrite intentionally muted labels, selected states, or control styling.
local _contentAlphaState = setmetatable({}, { __mode = "k" })
local _contentRevealTokens = setmetatable({}, { __mode = "k" })

local function ContentAlphaTargets(object)
    local state = _contentAlphaState[object]
    if state then return state end
    state = {}
    -- Only text and strokes are animated on rows. Background/image alpha can
    -- encode live states (checkboxes, toggles, previews), so they stay untouched.
    if (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) and object.Text ~= "" then
        state.TextTransparency = object.TextTransparency
    end
    if object:IsA("UIStroke") and object.Name ~= "GroupOutline" then
        state.Transparency = object.Transparency
    end
    _contentAlphaState[object] = state
    return state
end

local function HasVisiblePath(object, root)
    local current = object
    while current and current ~= root do
        if current:IsA("GuiObject") and not current.Visible then return false end
        current = current.Parent
    end
    return current == root
end

local function RevealContentRows(elements)
    if not elements or not elements.Parent or not elements:IsA("GuiObject") or not elements.Visible then return end
    local token = (_contentRevealTokens[elements] or 0) + 1
    _contentRevealTokens[elements] = token
    local rows = {}
    for _, child in ipairs(elements:GetChildren()) do
        if child:IsA("GuiObject") then table.insert(rows, child) end
    end
    table.sort(rows, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    for index, row in ipairs(rows) do
        if row.Visible then
            local delaySeconds = math.min((index - 1) * 0.012, 0.10)
            task.delay(delaySeconds, function()
                if not elements.Parent or not row.Parent or _contentRevealTokens[elements] ~= token then return end
                local objects = { row }
                for _, descendant in ipairs(row:GetDescendants()) do
                    table.insert(objects, descendant)
                end
                for _, object in ipairs(objects) do
                    if object.Parent and HasVisiblePath(object, elements) then
                        local targets = ContentAlphaTargets(object)
                        local props = {}
                        for property, target in pairs(targets) do
                            if type(target) == "number" and target < 0.995 then
                                if Library._lightOn and property == "Transparency" and target > 0.8 and object:IsA("UIStroke") then target = 0.9 end
                                props[property] = target
                                pcall(function() object[property] = 1 end)
                            end
                        end
                        if next(props) then
                            Tween(object, props, 0.16, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                        end
                    end
                end
            end)
        end
    end
end

local function AnimateSectionColumn(column)
    if not column or not column.Parent or not column.Visible then return end
    local token = (column:GetAttribute("NLSectionMotionToken") or 0) + 1
    column:SetAttribute("NLSectionMotionToken", token)
    -- Tab switch: the column rises into place. Columns sit in a UIListLayout,
    -- so Position is ignored; the top padding carries the motion instead.
    local columnPadding = column:FindFirstChildOfClass("UIPadding")
    if columnPadding then
        local delaySeconds = column.Name == "Right" and Library._motion.stagger or 0
        columnPadding.PaddingTop = UDim.new(0, 8)
        Library._anim.move(columnPadding, { PaddingTop = UDim.new(0, 0) }, "slow", delaySeconds)
    end
    local sections = {}
    for _, section in ipairs(column:GetChildren()) do
        if section:IsA("GuiObject") and section.Visible then
            table.insert(sections, section)
        end
    end
    table.sort(sections, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    for index, section in ipairs(sections) do
        local delaySeconds = math.min((index - 1) * Library._motion.stagger, 0.1)
        task.delay(Library._motion.dur(delaySeconds), function()
            if not column.Parent or not column.Visible or column:GetAttribute("NLSectionMotionToken") ~= token then return end
            if not section.Parent or not section.Visible then return end
            -- Keep text at its authored opacity. The former fade-to-transparent pass
            -- was responsible for one-frame label flashes on tab changes.
            -- Keep typography at native scale: fractional UIScale transitions can soften glyphs.
            local motionScale = section:FindFirstChild("SectionMotionScale")
            if not motionScale and not section:FindFirstChildOfClass("UIScale") and Library._perfMode ~= "max" then
                motionScale = Instance.new("UIScale"); motionScale.Name = "SectionMotionScale"; motionScale.Parent = section
            end
            -- The plate settles from 98.5% (slow, Quint Out): small enough that the glyph
            -- softening of a fractional scale only lasts the motion (the page is a CanvasGroup).
            -- (No scale: a UIScale on a section re-flows the column, so the plates below drifted
            -- 2-5px while it settled. The column's padding carries the rise; this pass staggers
            -- the outline / heading settle.)
            if motionScale and motionScale:IsA("UIScale") then motionScale.Scale = 1 end

            local list = section:FindFirstChild("Elements") or section:FindFirstChild("Container")
            if list and list:IsA("GuiObject") then
                local outline = list:FindFirstChild("GroupOutline")
                if outline and outline:IsA("UIStroke") then
                    local target = outline:GetAttribute("NLBaseTransparency")
                    if type(target) ~= "number" then
                        target = outline.Transparency
                        outline:SetAttribute("NLBaseTransparency", target)
                    end
                    outline.Transparency = math.min(0.84, target + 0.16)
                    Tween(outline, { Transparency = target }, 0.13, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                end
            end
            local heading = section:FindFirstChild("SectionLabel", true)
            if heading and heading:IsA("TextLabel") then
                local baseColor = heading:GetAttribute("NLBaseTextColor")
                if typeof(baseColor) ~= "Color3" then
                    baseColor = heading.TextColor3
                    heading:SetAttribute("NLBaseTextColor", baseColor)
                end
                heading.TextColor3 = Color3.fromRGB(190, 199, 224)
                Tween(heading, { TextColor3 = baseColor }, 0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            end
        end)
    end
end

local function GetSliderStep(min, max)
	local span = max - min
	if span <= 0 then return 1 end
	if span >= 20 then return 1 end
	return 0.1
end

local function Quantize(value, min, max, step)
	local clamped = math.clamp(value, min, max)
	local snapped = min + math.round((clamped - min) / step) * step
	if math.abs(snapped - max) < step * 0.001 then snapped = max end
	if math.abs(snapped - math.round(snapped)) < 0.0001 then snapped = math.round(snapped) end
	return snapped
end

local function FormatSliderValue(value, suffix)
	suffix = tostring(suffix or ""):gsub("^%s+", ""):gsub("%s+$", "")
	local text
	if string.find(suffix, "°", 1, true) then
		text = string.format("%.1f", value)
	elseif math.abs(value - math.round(value)) < 0.0001 then
		text = tostring(math.round(value))
	else
		text = string.format("%.1f", value)
	end
	return text .. (suffix or "")
end

local RepositionOpenPopups
local function MakeDraggable(frame, handle)
	handle = handle or frame
	frame.Draggable = false
	local dragging = false
	local dragInput, pointerPos, framePos

	local function update(input)
		if not input or not input.Position then return end
		local delta = input.Position - pointerPos
		local position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
		local camera = workspace.CurrentCamera
		-- Phones: kept inside the ScreenGui's (safe) area, not the camera's.
		local gui = frame:GetAttribute("ClampToGui") and frame:FindFirstAncestorWhichIsA("LayerCollector")
		if gui and gui.AbsoluteSize.X > 0 then
			local area, size, anchor = gui.AbsoluteSize, frame.AbsoluteSize, frame.AnchorPoint
			local x = position.X.Scale * area.X + position.X.Offset
			local y = position.Y.Scale * area.Y + position.Y.Offset
			x = area.X > size.X and math.clamp(x, size.X * anchor.X, area.X - size.X * (1 - anchor.X)) or area.X / 2 + (anchor.X - 0.5) * size.X
			y = area.Y > size.Y and math.clamp(y, size.Y * anchor.Y, area.Y - size.Y * (1 - anchor.Y)) or area.Y / 2 + (anchor.Y - 0.5) * size.Y
			position = UDim2.fromOffset(x, y)
		elseif camera and camera.ViewportSize.X > frame.AbsoluteSize.X and camera.ViewportSize.Y > frame.AbsoluteSize.Y then
			local anchor = frame.AnchorPoint
			local x = position.X.Scale * camera.ViewportSize.X + position.X.Offset
			local y = position.Y.Scale * camera.ViewportSize.Y + position.Y.Offset
			x = math.clamp(x, frame.AbsoluteSize.X * anchor.X, camera.ViewportSize.X - frame.AbsoluteSize.X * (1 - anchor.X))
			y = math.clamp(y, frame.AbsoluteSize.Y * anchor.Y, camera.ViewportSize.Y - frame.AbsoluteSize.Y * (1 - anchor.Y))
			position = UDim2.fromOffset(x, y)
		end
		frame.Position = position
		if RepositionOpenPopups then RepositionOpenPopups() end
	end

	handle.InputBegan:Connect(function(input)
		if IsPrimaryInput(input) then
			dragging = true
			dragInput = input
			pointerPos = input.Position
			framePos = frame.Position
			local shield = GetDragShield(frame)
			if shield then shield.Visible = true end
		end
	end)

	handle.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then update(input) end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if IsPrimaryInput(input) then
			dragging = false
			dragInput = nil
			local shield = frame:FindFirstChild("DragShield")
			if shield then shield.Visible = false end
		end
	end)
end


	local _openPopups = {}
	local _popupClipRestore = {}
	local _popupClipCounts = {}
	local UnregisterPopup
	local RestorePopupClipping

	local function IsPopupAncestor(ancestor, descendant)
		if not ancestor or not descendant or ancestor == descendant then return false end
		local ok, result = pcall(function() return descendant:IsDescendantOf(ancestor) end)
		return ok and result
	end

	local function RegisterPopup(frame, closeFn, trigger)
		if not frame or type(closeFn) ~= "function" then return end
		AddInputSink(frame)
		for i = #_openPopups, 1, -1 do
			local entry = _openPopups[i]
			if not entry.frame or not entry.frame.Parent then
				if entry.connection then pcall(function() entry.connection:Disconnect() end) end
				RestorePopupClipping(entry.frame)
				table.remove(_openPopups, i)
			elseif entry.frame == frame then
				entry.closeFn = closeFn
				entry.trigger = trigger
				return
			end
		end
		-- Logical parent: the open popup that holds the trigger. A color picker or
		-- list opened from a plate lives under MainFrame, not inside the plate, so
		-- the instance tree alone cannot tell they belong together.
		local parentFrame
		if trigger then
			for _, entry in ipairs(_openPopups) do
				if entry.frame ~= frame and IsPopupAncestor(entry.frame, trigger) then
					parentFrame = entry.frame
				end
			end
		end
		local connection
		if frame.Destroying and frame.Destroying.Connect then
			local ok, result = pcall(function()
				return frame.Destroying:Connect(function()
					UnregisterPopup(frame)
					if connection then pcall(function() connection:Disconnect() end) end
				end)
			end)
			if ok then connection = result end
		end
		table.insert(_openPopups, {frame = frame, closeFn = closeFn, trigger = trigger, parent = parentFrame, connection = connection})
	end

	-- True when `frame` was opened (directly or further down) from `root`.
	local function IsLogicalChild(frame, root)
		return Library._isLogicalChild(frame, root)
	end
	Library._isLogicalChild = function(frame, root)
		local guard = 0
		while frame and guard < 16 do
			guard = guard + 1
			local parentFrame
			for _, entry in ipairs(_openPopups) do
				if entry.frame == frame then parentFrame = entry.parent end
			end
			if parentFrame == root then return true end
			frame = parentFrame
		end
		return false
	end
	-- Hover effects: an element under an open popup (lower on screen than it)
	-- does not light up through it.
	Library._hoverBlocked = function(obj)
		-- Phones: touch fires MouseEnter but rarely MouseLeave, so hover
		-- highlights (and hover tooltips) would stick; none are shown.
		if Library._noHover then return true end
		if not obj or not obj:IsA("GuiObject") then return false end
		local overlay = Library._openOverlay
		if overlay and overlay.Parent and not obj:IsDescendantOf(overlay) and obj:IsDescendantOf(overlay.Parent) and #_openPopups == 0 then
			local p = GetPointerPosition()
			local inset = Library._guiInset or 0
			if IsPointInside(overlay, Vector2.new(p.X, p.Y - inset)) then return true end
		end
		if #_openPopups == 0 then return false end
		local inset = Library._guiInset
		if not inset then
			local ok, value = pcall(function() return game:GetService("GuiService"):GetGuiInset() end)
			inset = ok and value and value.Y or 0
			Library._guiInset = inset
		end
		local p = GetPointerPosition()
		local point = Vector2.new(p.X, p.Y - inset)
		for _, entry in ipairs(_openPopups) do
			local f = entry.frame
			if f and f.Parent and f.Visible and f ~= obj and f.ZIndex > obj.ZIndex
				and not obj:IsDescendantOf(f) and IsPointInsideTree(f, point) then
				return true
			end
		end
		return false
	end
	if not Library._raiseConn then
		Library._raiseConn = UserInputService.InputBegan:Connect(function(input)
			if not IsPrimaryInput(input) then return end
			local point = GetInputPosition(input)
			local hit, top = nil, -math.huge
			for _, entry in ipairs(_openPopups) do
				local f = entry.frame
				if f and f.Parent and f.Visible then
					top = math.max(top, f.ZIndex)
					if IsPointInsideTree(f, point) and (not hit or f.ZIndex > hit.ZIndex) then hit = f end
				end
			end
			if not hit or hit.ZIndex >= top then return end
			local family = { hit }
			for _, entry in ipairs(_openPopups) do
				local f = entry.frame
				if f and f ~= hit and f.Parent and f.Visible and Library._isLogicalChild(f, hit) then table.insert(family, f) end
			end
			table.sort(family, function(a, b) return a.ZIndex < b.ZIndex end)
			for _, f in ipairs(family) do ApplyZIndexLadder(f, NextPopupZ()) end
		end)
	end

	UnregisterPopup = function(frame)
		-- Close what was opened from this popup first (a list or picker opened
		-- from a plate must not outlive the plate).
		local copy = {}
		for i, entry in ipairs(_openPopups) do copy[i] = entry end
		for _, entry in ipairs(copy) do
			if entry.frame ~= frame and IsLogicalChild(entry.frame, frame) and type(entry.closeFn) == "function" then
				pcall(entry.closeFn)
			end
		end
		for i = #_openPopups, 1, -1 do
			if _openPopups[i].frame == frame then
				if _openPopups[i].connection then pcall(function() _openPopups[i].connection:Disconnect() end) end
				table.remove(_openPopups, i)
			end
		end
		-- Re-enable the column clipping only after the close animation; doing it
		-- at once cut the fading plate off behind the column edge.
		task.delay(0.22, function()
			for _, entry in ipairs(_openPopups) do
				if entry.frame == frame then return end
			end
			RestorePopupClipping(frame)
		end)
	end

	-- Marks every open popup that must stay because a kept popup was opened from it.
	local function KeepPopupChain(keep, frame)
		local guard = 0
		while frame and not keep[frame] and guard < 16 do
			keep[frame] = true
			guard = guard + 1
			local parentFrame
			for _, entry in ipairs(_openPopups) do
				if entry.frame == frame then parentFrame = entry.parent end
			end
			frame = parentFrame
		end
	end

	local function CloseAllPopupsExcept(exceptFrame)
		local copy = {}
		for i, entry in ipairs(_openPopups) do copy[i] = entry end
		-- The click that opens a popup comes from inside the popup holding its
		-- trigger; that popup (and its own parents) stays open.
		local keep = {}
		local pointer = GetPointerPosition()
		for _, entry in ipairs(copy) do
			if entry.frame and entry.frame.Parent and entry.frame.Visible and pointer and IsPointInsideTree(entry.frame, pointer) then
				KeepPopupChain(keep, entry.frame)
			end
		end
		for _, entry in ipairs(copy) do
			if entry.frame and entry.frame.Parent and entry.frame ~= exceptFrame and not keep[entry.frame]
				and not IsPopupAncestor(entry.frame, exceptFrame) and type(entry.closeFn) == "function" then
				pcall(entry.closeFn)
			end
		end
	end

	local function HideAllPopupsNow(instant)
		local copy = {}
		for i, entry in ipairs(_openPopups) do copy[i] = entry end
		for _, entry in ipairs(copy) do
			local frame = entry.frame
			if frame and frame.Parent then
				if entry.connection then pcall(function() entry.connection:Disconnect() end) end
				RestorePopupClipping(frame)
				if instant then
					frame.Visible = false
				else
					local token = (frame:GetAttribute("PopupToken") or 0) + 1
					frame:SetAttribute("PopupToken", token)
					Tween(frame, { BackgroundTransparency = 1 }, 0.18)
					TweenShadowLayers(frame, false, 0.18, Enum.EasingDirection.In)
					task.delay(0.19, function()
						if not frame.Parent or frame:GetAttribute("PopupToken") ~= token then return end
						frame.Visible = false
						local home = frame.Parent
						if home and home:IsA("GuiObject") then ApplyZIndexLadder(frame, home.ZIndex) end
					end)
				end
			end
		end
		table.clear(_openPopups)
	end

	local function ClosePopupsUnder(root)
		if not root then return end
		local copy = {}
		for i, entry in ipairs(_openPopups) do copy[i] = entry end
		for _, entry in ipairs(copy) do
			if entry.frame and entry.frame ~= root and (IsPopupAncestor(root, entry.frame) or IsLogicalChild(entry.frame, root))
				and type(entry.closeFn) == "function" then
				pcall(entry.closeFn)
			end
		end
	end

	UserInputService.InputBegan:Connect(function(input)
		if not IsPrimaryInput(input) then return end
		local point = GetInputPosition(input)
		local toClose = {}
		-- A click inside a child popup (color picker, list) counts as inside every
		-- popup it was opened from, so the parent plate stays open.
		local keep = {}
		for _, entry in ipairs(_openPopups) do
			local frame = entry.frame
			if frame and frame.Parent and frame.Visible then
				local inside = IsPointInsideTree(frame, point)
				if entry.trigger and entry.trigger.Parent then
					inside = inside or IsPointInsideTree(entry.trigger, point)
				end
				if inside then KeepPopupChain(keep, frame) end
			end
		end
		for _, entry in ipairs(_openPopups) do
			local frame = entry.frame
			if frame and frame.Parent and frame.Visible and not keep[frame] and type(entry.closeFn) == "function" then
				table.insert(toClose, entry.closeFn)
			end
		end
		for _, fn in ipairs(toClose) do pcall(fn) end
	end)

-- Tween instances cannot be stored as Roblox attributes; keep live popup tweens
-- in a weak-key table so destroyed frames do not remain referenced.
local _activePopupTweens = setmetatable({}, { __mode = "k" })

local function CancelPopupTween(frame)
	if not frame then return end
	local running = _activePopupTweens[frame]
	_activePopupTweens[frame] = nil
	if running then
		pcall(function() running:Cancel() end)
	end
end

local function PlayPopupTween(frame, info, props)
	if not frame or not frame.Parent then return end
	-- (Durations come from the motion tokens: SmoothOpen base, SmoothClose fast.)
	if Library._animScale and Library._animScale ~= 1 then
		info = TweenInfo.new(info.Time * math.max(Library._animScale, 0), info.EasingStyle, info.EasingDirection)
	end
	local ok, tween = pcall(function() return TweenService:Create(frame, info, props) end)
	if not ok or not tween then return end
	_activePopupTweens[frame] = tween
	tween.Completed:Connect(function()
		if _activePopupTweens[frame] == tween then
			_activePopupTweens[frame] = nil
		end
	end)
	tween:Play()
end

local function GetPopupScale(frame)
	if not frame or not frame.Parent then return nil end
	-- Reuse the animation scale on every opening. Checking for any UIScale first
	-- made _PopScale work once, then silently disabled future open/close motion.
	local pop = frame:FindFirstChild("_PopScale")
	if pop and pop:IsA("UIScale") then return pop end
	local existing = frame:FindFirstChildOfClass("UIScale")
	if existing then return nil end
	return New("UIScale", { Name = "_PopScale", Scale = 1 }, frame)
end

-- Fades a popup's text and icons with its background, so closing reads as one
-- fade instead of the text vanishing at the end. Each element's own
-- transparency is remembered while hidden and restored on the next open.
local function FadePopupContent(frame, show, dur)
	for _, d in ipairs(frame:GetDescendants()) do
		if not d:GetAttribute("IsShadowLayer") then
			local prop, key
			if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
				prop, key = "TextTransparency", "NLFadeText"
			elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
				prop, key = "ImageTransparency", "NLFadeImage"
			end
			if prop then
				local tokenKey = key .. "T"
				local token = (d:GetAttribute(tokenKey) or 0) + 1
				d:SetAttribute(tokenKey, token)
				if show then
					local base = d:GetAttribute(key)
					if type(base) ~= "number" then base = d[prop] end
					-- Kept until the fade-in has finished: a close in between
					-- must still know the real value, not the half-faded one.
					d:SetAttribute(key, base)
					d[prop] = 1
					Tween(d, { [prop] = base }, dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
					task.delay((dur or 0.17) + 0.03, function()
						if d:GetAttribute(tokenKey) == token then d:SetAttribute(key, nil) end
					end)
				else
					if d:GetAttribute(key) == nil then d:SetAttribute(key, d[prop]) end
					Tween(d, { [prop] = 1 }, dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				end
			end
		end
	end
end

-- True for 0.15 s after SmoothOpen(frame): a trigger's second click of a double-click is ignored
-- instead of closing the popup it has just opened (open + close flicker).
Library._popupFresh = function(frame)
	local at = frame and frame.Visible and frame:GetAttribute("NLOpenedAt")
	return type(at) == "number" and os.clock() - at < 0.15
end
local function SmoothOpen(frame, targetAlpha, dur, style, dir)
	if not frame or not frame.Parent then return end
	-- Popups that open (near) solid get the window's glass: see-through over
	-- the acrylic blur (set up by AddWindow).
	if Library._popupGlass and not frame:GetAttribute("NoGlass") and type(targetAlpha) == "number" and (targetAlpha < 0.1 or frame:GetAttribute("Glass")) then
		targetAlpha = Library._popupGlass(frame) or targetAlpha
	end
	if Library._frostEnabled and Library._frost and frame:GetAttribute("Glass") then
		-- After the pop-in scale and placement have settled.
		task.delay(0.2, function() if frame.Visible and frame:GetAttribute("PopupToken") then Library._frost(frame, true) end end)
	end
	if Library._themeMap then Library._themePass(frame, true) end
	local token = (frame:GetAttribute("PopupToken") or 0) + 1
	frame:SetAttribute("PopupToken", token)
	frame:SetAttribute("NLOpenedAt", os.clock())
	CancelPopupTween(frame)
	-- Motion tokens: every popup opens on the same clock (base, Quint Out);
	-- only deliberately slow callers (>= 0.25 s) keep the slow token.
	local M = Library._motion
	dur = math.max(M.snap(dur or M.base), M.base)
	frame.BackgroundTransparency = 1
	frame.Visible = true
	TweenShadowLayers(frame, true, dur)
	FadePopupContent(frame, true, dur)
	local scale = GetPopupScale(frame)
	if scale then
		scale.Scale = 0.97
		Library._anim.move(scale, { Scale = 1 }, dur)
	end
	-- 6px slide out of the anchor: a popup under the pointer (its anchor) comes down from
	-- above, one that opens upward rises from below. Driven by a NumberValue so a caller
	-- that re-places the popup meanwhile simply wins (the slide stops, nothing is left offset).
	Library._popupSlideStop(frame)
	if not frame:GetAttribute("NoSlide") and (Library._animScale or 1) > 0 then
		local nv = Instance.new("NumberValue")
		nv.Name = "_SlideValue"; nv.Value = -6
		local base = frame.Position
		local function apply()
			if not nv.Parent then return end
			local written = frame:GetAttribute("NLSlideAt")
			if not frame.Parent then
				frame:SetAttribute("NLSlideAt", nil); frame:SetAttribute("NLSlideOff", nil)
				nv:Destroy()
				return
			end
			-- Re-placed by its owner meanwhile (settle passes): that is the new
			-- resting place; the remaining offset rides on it.
			if written and frame.Position ~= written then base = frame.Position end
			local off = math.floor(nv.Value + 0.5)
			do
				local okM, m = pcall(function() return UserInputService:GetMouseLocation() end)
				local inset = Library._guiInset or 0
				local cy = frame.AbsolutePosition.Y + frame.AbsoluteSize.Y * 0.5
				-- (Rest place = the current one minus the offset written last frame.)
				if okM and m and frame.AbsoluteSize.Y > 4 and m.Y - inset > cy - (frame:GetAttribute("NLSlideOff") or 0) then off = -off end
			end
			local pos = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset + off)
			frame:SetAttribute("NLSlideOff", off); frame:SetAttribute("NLSlideAt", pos)
			frame.Position = pos
		end
		nv.Parent = frame
		apply()
		nv.Changed:Connect(apply)
		local tw = Library._anim.move(nv, { Value = 0 }, dur)
		if tw then
			tw.Completed:Connect(function() apply(); Library._popupSlideStop(frame) end)
		else
			Library._popupSlideStop(frame)
		end
	end
	PlayPopupTween(frame, TweenInfo.new(dur, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), {BackgroundTransparency = targetAlpha})
end

local function SmoothClose(frame, dur, cb)
	if Library._frost and frame and frame:GetAttribute("Frosting") then Library._frost(frame, false) end
	if not frame or not frame.Parent then return end
	local token = (frame:GetAttribute("PopupToken") or 0) + 1
	frame:SetAttribute("PopupToken", token)
	CancelPopupTween(frame)
	Library._popupSlideStop(frame)
	frame:SetAttribute("NLOpenedAt", nil)
	-- Motion tokens: closing is always faster than opening (fast, Quad In).
	-- Tween / PlayPopupTween apply Library._animScale themselves; only the
	-- hide timer below needs the scaled value.
	dur = Library._motion.fast
	TweenShadowLayers(frame, false, dur, Enum.EasingDirection.In)
	FadePopupContent(frame, false, dur)
	-- Picked-row fills / the hover slab fade with the popup (they lingered as floating slabs
	-- after the glass had gone); their own value comes back once the popup is hidden.
	local fills = {}
	for _, d in ipairs(frame:GetDescendants()) do
		if d:IsA("GuiObject") and (d:GetAttribute("Sel") or d.Name == "HoverSlab") and d.BackgroundTransparency < 1 then
			fills[#fills + 1] = { d, d.BackgroundTransparency }
			Library._anim.raw(d, { BackgroundTransparency = 1 }, dur, "exit")
		end
	end
	local scale = GetPopupScale(frame)
	if scale then
		Library._anim.tween(scale, { Scale = 0.98 }, dur, "exit")
	end
	PlayPopupTween(frame, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1})
	task.delay(Library._motion.dur(dur) + 0.01, function()
		local closed = frame.Parent and frame:GetAttribute("PopupToken") == token
		if closed then frame.Visible = false end
		-- (Re-opened meanwhile: the fills come back with a short fade instead.)
		for _, f in ipairs(fills) do
			if f[1].Parent and f[1]:GetAttribute("Sel") then Library._anim.raw(f[1], { BackgroundTransparency = f[2] }, closed and 0 or "fast") end
		end
		if closed then
			if scale then scale.Scale = 1 end
			local home = frame.Parent
			if home and home:IsA("GuiObject") then ApplyZIndexLadder(frame, home.ZIndex) end
			if cb then cb() end
		end
	end)
end

-- Per-group element values (weapon groups, NL-style): every element on a tab
-- that called Tab:SetGroupPresets keeps a "Global" value; a custom group holds
-- overrides only (an element without one inherits Global). The live controls
-- always show the selected group's effective values:
--   G.base   = Global values (serialized, by config key) while a custom group
--              is selected (nil while Global is selected: the controls are it);
--   G.values = { [group] = { [key] = serialized } } overrides.
-- Edits made while a custom group is selected become its overrides (a value
-- equal to Global is no override). Switching sets only the controls whose
-- effective value differs (each callback fires once). Tabs without groups
-- pay nothing: no state, no loop. Installed once per window by AddWindow.
Library._gvInstall = function(W, registered, accent)
	local rows = setmetatable({}, { __mode = "k" }) -- element obj -> row frame
	W._gvRow = rows
	local function same(a, b)
		if type(a) == "number" and type(b) == "number" then return math.abs(a - b) < 1e-6 end
		if type(a) ~= "table" or type(b) ~= "table" then return a == b end
		if a.__type ~= b.__type then return false end
		if a.__type == "Color3" then
			for _, c in ipairs({ "r", "g", "b" }) do
				if math.abs((tonumber(a[c]) or 0) - (tonumber(b[c]) or 0)) > 0.002 then return false end
			end
			return true
		end
		local la = type(a.v) == "table" and a.v or {}
		local lb = type(b.v) == "table" and b.v or {}
		if #la ~= #lb then return false end
		local seen = {}
		for _, x in ipairs(la) do seen[tostring(x)] = (seen[tostring(x)] or 0) + 1 end
		for _, x in ipairs(lb) do
			local k = tostring(x)
			if not seen[k] or seen[k] < 1 then return false end
			seen[k] = seen[k] - 1
		end
		return true
	end
	local function elems(tab)
		local out = {}
		if tab == nil then return out end
		for _, e in ipairs(registered) do
			if e.tab == tab and type(e.obj) == "table" and type(e.obj.Get) == "function" and type(e.obj.Set) == "function" then
				table.insert(out, e)
			end
		end
		return out
	end
	local function live(e)
		local ok, v = pcall(function() return e.obj:Get() end)
		if ok then return SerializeValue(v) end
		return nil
	end
	local function setLive(e, v)
		pcall(function() e.obj:Set(DeserializeValue(v)) end)
	end
	local function overrides(G, group, create)
		if group == nil or group == "Global" then return nil end
		G.values = G.values or {}
		if create and not G.values[group] then G.values[group] = {} end
		return G.values[group]
	end
	-- Folds the live values of the selected custom group into its overrides.
	local function capture(G)
		if G.selected == "Global" then return end
		G.base = G.base or {}
		local ov = overrides(G, G.selected, true)
		for _, e in ipairs(elems(G.tab)) do
			local v = live(e)
			if v ~= nil then
				if G.base[e.key] == nil then G.base[e.key] = v end
				if same(v, G.base[e.key]) then ov[e.key] = nil else ov[e.key] = v end
			end
		end
	end
	-- Row of an entry: its own, else the row of the entry registered just before
	-- with the same label (the colour half of toggle/dropdown colour pickers).
	local function rowOf(list, i)
		local e = list[i]
		local row = rows[e.obj]
		if row then return row end
		local prev = list[i - 1]
		if prev and prev.label == e.label then return rows[prev.obj] end
		return nil
	end
	local function mark(row, on)
		if not row or not row.Parent then return end
		local dot = row:FindFirstChild("GroupMark")
		if on and not dot then
			dot = Instance.new("Frame")
			dot.Name = "GroupMark"
			dot.AnchorPoint = Vector2.new(0, 0.5)
			dot.Size = UDim2.fromOffset(4, 4)
			dot.BorderSizePixel = 0
			dot.BackgroundTransparency = 1
			dot.ZIndex = (row.ZIndex or 1) + 3
			dot:SetAttribute("NoTheme", true)
			-- Level with the label (first text in the row), at the left edge.
			local label
			for _, c in ipairs(row:GetChildren()) do
				if c:IsA("TextLabel") then label = c break end
			end
			if label then
				dot.Position = UDim2.new(0, 4, label.Position.Y.Scale + label.Size.Y.Scale / 2, label.Position.Y.Offset + label.Size.Y.Offset / 2)
			else
				dot.Position = UDim2.new(0, 4, 0.5, 0)
			end
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = dot
			dot.Parent = row
		end
		if not dot then return end
		dot.BackgroundColor3 = accent()
		local want = on and 0 or 1
		if dot:GetAttribute("On") ~= on then
			dot:SetAttribute("On", on)
			Tween(dot, { BackgroundTransparency = want }, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end
	local function paint(G)
		local ov = G.selected ~= "Global" and overrides(G, G.selected) or nil
		local list = elems(G.tab)
		local state = {}
		for i, e in ipairs(list) do
			local row = rowOf(list, i)
			if row then state[row] = state[row] or (ov ~= nil and ov[e.key] ~= nil) end
		end
		for row, on in pairs(state) do mark(row, on) end
	end
	-- While some tab has a custom group selected: pick up edits (clicks,
	-- hotkeys, script :Set) as overrides and keep the markers current.
	local polling = false
	local function ensurePoll()
		if polling then return end
		polling = true
		task.spawn(function()
			while not W._unloaded do
				task.wait(0.15)
				local any = false
				for _, G in pairs(W._tabGroups or {}) do
					if G.selected ~= "Global" then
						any = true
						capture(G)
						paint(G)
					end
				end
				if not any then break end
			end
			polling = false
		end)
	end
	-- Switch the controls of G's tab from the selected group to `target`.
	W._gvSwitch = function(G, target)
		if G.selected == target then return end
		local list = elems(G.tab)
		if G.selected == "Global" then
			G.base = {}
			for _, e in ipairs(list) do G.base[e.key] = live(e) end
		else
			capture(G)
		end
		local ov = overrides(G, target) or {}
		local changes = {}
		for _, e in ipairs(list) do
			local want = ov[e.key]
			if want == nil then want = G.base[e.key] end
			if want ~= nil and not same(want, live(e)) then table.insert(changes, { e, want }) end
		end
		G.selected = target
		if target == "Global" then G.base = nil else ensurePoll() end
		for _, c in ipairs(changes) do setLive(c[1], c[2]) end
		paint(G)
	end
	W._gvRename = function(G, old, new)
		if G.selected == old then capture(G) end
		if G.values and G.values[old] then
			G.values[new] = G.values[old]
			G.values[old] = nil
		end
	end
	W._gvDelete = function(G, name)
		if G.values then G.values[name] = nil end
	end
	-- Config save: the element values written for grouped tabs are Global's.
	W._gvSaveBase = function()
		local out = {}
		for _, G in pairs(W._tabGroups or {}) do
			if G.selected ~= "Global" then
				capture(G)
				for k, v in pairs(G.base or {}) do out[k] = v end
			end
		end
		return out
	end
	-- Config load: the file's element values are Global, so every tab drops
	-- back to Global (without touching the controls) before they are set.
	W._gvBeforeLoad = function()
		for _, G in pairs(W._tabGroups or {}) do
			if G.selected ~= "Global" then
				G.selected = "Global"
				G.base = nil
				paint(G)
			end
		end
		if W._syncGroups then W._syncGroups() end
	end
	W._gvExport = function(G, group)
		if G.selected == group then capture(G) end
		local out = {}
		for k, v in pairs(overrides(G, group) or {}) do out[k] = v end
		return out
	end
	W._gvImport = function(G, group, saved)
		if type(saved) ~= "table" or group == "Global" then return end
		local ov = overrides(G, group, true)
		for k, v in pairs(saved) do
			if type(k) == "string" and v ~= nil then ov[k] = v end
		end
	end
	-- Context menu: does the row of `obj` differ from Global in the selected group?
	local function groupOfObj(obj)
		for _, G in pairs(W._tabGroups or {}) do
			if G.selected ~= "Global" then
				local list = elems(G.tab)
				for i, e in ipairs(list) do
					local row = rowOf(list, i)
					if e.obj == obj or (row and row == rows[obj]) then return G end
				end
			end
		end
		return nil
	end
	W._gvHasOverride = function(obj)
		local G = groupOfObj(obj)
		if not G then return false end
		capture(G)
		local ov = overrides(G, G.selected) or {}
		local row = rows[obj]
		local list = elems(G.tab)
		for i, e in ipairs(list) do
			if (e.obj == obj or (row and rowOf(list, i) == row)) and ov[e.key] ~= nil then return true end
		end
		return false
	end
	W._gvResetObj = function(obj)
		local G = groupOfObj(obj)
		if not G then return end
		capture(G)
		local ov = overrides(G, G.selected) or {}
		local row = rows[obj]
		local list = elems(G.tab)
		for i, e in ipairs(list) do
			if (e.obj == obj or (row and rowOf(list, i) == row)) and ov[e.key] ~= nil then
				ov[e.key] = nil
				if G.base[e.key] ~= nil then setLive(e, G.base[e.key]) end
			end
		end
		paint(G)
	end
	-- Tab API helpers (Tab:GetGroupValue / SetGroupValue / ResetGroupValue /
	-- GetEffectiveValues). An element is named by its label (first match) or
	-- its config key ("slider_Min Damage#1").
	local function find(G, elementName)
		elementName = tostring(elementName)
		for _, e in ipairs(elems(G.tab)) do
			if e.label == elementName or e.key == elementName then return e end
		end
		return nil
	end
	local function globalOf(G, e)
		if G.selected == "Global" then return live(e) end
		G.base = G.base or {}
		if G.base[e.key] == nil then G.base[e.key] = live(e) end
		return G.base[e.key]
	end
	local function effective(G, group, e)
		if group == G.selected then return live(e) end
		if group ~= "Global" then
			local ov = overrides(G, group)
			if ov and ov[e.key] ~= nil then return ov[e.key] end
		end
		return globalOf(G, e)
	end
	local function known(G, group)
		if group == "Global" then return true end
		for _, g in ipairs(G.custom or {}) do if g.name == group then return true end end
		return false
	end
	W._gvAPI = {
		get = function(G, group, elementName)
			group = tostring(group or G.selected)
			local e = find(G, elementName)
			if not e or not known(G, group) then return nil end
			return DeserializeValue(effective(G, group, e))
		end,
		set = function(G, group, elementName, value)
			group = tostring(group or G.selected)
			local e = find(G, elementName)
			local v = SerializeValue(value)
			if not e or v == nil or not known(G, group) then return false end
			if group == G.selected then
				setLive(e, v)
			elseif group == "Global" then
				-- A selected custom group without its own value follows Global.
				capture(G)
				local ov = overrides(G, G.selected) or {}
				G.base[e.key] = v
				if ov[e.key] == nil then setLive(e, v) else
					if same(ov[e.key], v) then ov[e.key] = nil end
				end
			else
				local ov = overrides(G, group, true)
				if same(v, globalOf(G, e)) then ov[e.key] = nil else ov[e.key] = v end
			end
			paint(G)
			return true
		end,
		reset = function(G, group, elementName)
			group = tostring(group or G.selected)
			local e = find(G, elementName)
			if not e or group == "Global" then return false end
			if group == G.selected then
				capture(G)
				local ov = overrides(G, group) or {}
				ov[e.key] = nil
				if G.base and G.base[e.key] ~= nil then setLive(e, G.base[e.key]) end
			else
				local ov = overrides(G, group)
				if ov then ov[e.key] = nil end
			end
			paint(G)
			return true
		end,
		all = function(G, group)
			group = tostring(group or G.selected)
			local out = {}
			if not known(G, group) then return out end
			for _, e in ipairs(elems(G.tab)) do
				local name = out[e.label] == nil and e.label or e.key
				out[name] = DeserializeValue(effective(G, group, e))
			end
			return out
		end,
		overridden = function(G, group)
			group = tostring(group or G.selected)
			if group == G.selected then capture(G) end
			local out = {}
			for _, e in ipairs(elems(G.tab)) do
				local ov = overrides(G, group)
				if ov and ov[e.key] ~= nil then table.insert(out, e.label) end
			end
			return out
		end,
	}
end

