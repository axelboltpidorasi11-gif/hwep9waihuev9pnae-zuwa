				ui.hexFocused = true
				ui.focusText = box.Text
				Library._focusRing(box, true)
				box.SelectionStart = 1
				box.CursorPosition = #box.Text + 1
			end)
			box:GetPropertyChangedSignal("Text"):Connect(function()
				if not ui.hexFocused then return end
				local t = box.Text
				-- Typed / pasted after the old value (no select-all): the new part counts.
				local ft = ui.focusText or ""
				if #ft > 0 and #t > #ft and string.sub(t, 1, #ft) == ft and not Library._cpParse(t) then t = string.sub(t, #ft + 1) end
				local raw = string.gsub(t, "[%s#]", "")
				local complete = (#raw == 6 or #raw == 8) and string.match(raw, "^%x+$") or string.find(t, "%)%s*$") or select(2, string.gsub(t, "[%d%.]+", "")) >= 3 and string.find(t, ",")
				if not complete then return end
				local c, a = Library._cpParse(t)
				if c then setColor(c, a, true, false) end
			end)
			box.FocusLost:Connect(function()
				ui.hexFocused = false
				Library._focusRing(box, false)
				local t = box.Text
				local ft = ui.focusText or ""
				if #ft > 0 and #t > #ft and string.sub(t, 1, #ft) == ft and not Library._cpParse(t) then t = string.sub(t, #ft + 1) end
				local c, a = Library._cpParse(t)
				if c then setColor(c, a, true, true) else paint(false) end
			end)
		end

		-- Recent / saved colours (shared by every picker, saved with the config).
		local function syncSwatches()
			if not ui then return end
			for i, p in ipairs(ui.presets) do
				local c = Library._recentColors[i]
				p.BackgroundColor3 = c or Color3.fromRGB(255, 255, 255)
				p.BackgroundTransparency = c and 0 or 1
				p.PresetSwatchStroke.Transparency = c and 0.75 or 0.7
			end
		end
		function picker._pushRecent(c)
			local list = Library._recentColors
			local hex = ColorToHex(c)
			for i = #list, 1, -1 do if ColorToHex(list[i]) == hex then table.remove(list, i) end end
			table.insert(list, 1, c)
			while #list > 8 do table.remove(list) end
			syncSwatches()
		end

		-- Checker cells for the alpha bar (rebuilt only when the width changes).
		local function buildChecker(width)
			if not ui or ui.checkerW == width then return end
			ui.checkerW = width
			for _, c in ipairs(ui.checker:GetChildren()) do c:Destroy() end
			local n = math.floor(width / 5)
			for col = 1, n - 2 do
				for rowI = 0, 1 do
					if (col + rowI) % 2 == 0 then
						mk("Frame", { Name = "AlphaSwatchCell", Position = UDim2.fromOffset(col * 5, rowI * 5), Size = UDim2.fromOffset(5, 5),
							BackgroundColor3 = Color3.fromRGB(190, 190, 196), BorderSizePixel = 0 }, ui.checker, 4)
					end
				end
			end
		end

		-- Window rect in screen pixels, and the window scale.
		local function winRect()
			local p, s = MainFrame.AbsolutePosition, MainFrame.AbsoluteSize
			if s.X <= 0 or s.Y <= 0 then p, s = PopupSafeArea() end
			local sc = GetVisualScale(MainFrame)
			return p, s, (type(sc) == "number" and sc > 0) and sc or 1
		end

		-- Next to the anchor inside the window: under it (right edges aligned), else above,
		-- else beside it; clamped to the window (the screen when the window is too small).
		local function place(animate)
			if not ui or not anchorButton or not anchorButton.Parent then return end
			local wp, ws, sc = winRect()
			local pw, ph = st.w * sc, st.hgt * sc
			local m = 6 * sc
			if pw > ws.X - 2 * m or ph > ws.Y - 2 * m then wp, ws = PopupSafeArea() end
			local ap, as = anchorButton.AbsolutePosition, anchorButton.AbsoluteSize
			local x = ap.X + as.X - pw
			local y = ap.Y + as.Y + m
			local top, bottom, left, right = wp.Y + m, wp.Y + ws.Y - m, wp.X + m, wp.X + ws.X - m
			st.up = false
			if y + ph > bottom then
				if ap.Y - m - ph >= top then
					y = ap.Y - m - ph
					st.up = true
				else
					y = ap.Y + as.Y / 2 - ph / 2
					x = ap.X - m - pw
					if x < left then x = ap.X + as.X + m end
				end
			end
			x = math.clamp(x, left, math.max(left, right - pw))
			y = math.clamp(y, top, math.max(top, bottom - ph))
			local parent = ui.frame.Parent
			local pp = parent and parent.AbsolutePosition or wp
			local target = UDim2.fromOffset(math.floor((x - pp.X) / sc + 0.5), math.floor((y - pp.Y) / sc + 0.5))
			if animate then Library._anim.move(ui.frame, { Position = target }) else ui.frame.Position = target end
		end

		-- Geometry for the device: desktop / phone portrait = one column, phone landscape = two.
		layout = function(animate)
			if not ui then return end
			local S = sel()
			local phone = Library._phone
			local _, ws, sc = winRect()
			local land = phone and ws.X > ws.Y * 1.25
			local winH = ws.Y / sc
			local PAD = 10
			local W, colX, cw, y
			if land then
				local svS = math.clamp(winH - 2 * PAD - 16, 120, 176)
				W = PAD + svS + 12 + 212 + PAD
				ui.sv.Position, ui.sv.Size = UDim2.fromOffset(PAD, PAD), UDim2.fromOffset(svS, svS)
				colX, cw, y = PAD + svS + 12, 212, PAD
				st.svBottom = PAD + svS
			else
				W = phone and 256 or 232
				colX, cw, y = PAD, W - 2 * PAD, PAD
				local svH = phone and 150 or 148
				ui.sv.Position, ui.sv.Size = UDim2.fromOffset(PAD, y), UDim2.fromOffset(cw, svH)
				y = y + svH + 10
				st.svBottom = 0
			end
			local pvS = phone and 40 or 32
			ui.pv.Position, ui.pv.Size = UDim2.fromOffset(colX, y), UDim2.fromOffset(pvS, pvS)
			local sx, sw = colX + pvS + 10, cw - pvS - 10
			local hitH = pvS / 2
			ui.hueHit.Position, ui.hueHit.Size = UDim2.fromOffset(sx, y), UDim2.fromOffset(sw, hitH)
			ui.alphaHit.Position, ui.alphaHit.Size = UDim2.fromOffset(sx, y + hitH), UDim2.fromOffset(sw, hitH)
			buildChecker(sw)
			y = y + pvS + 10
			local fh = phone and 36 or 28
			ui.field.Position, ui.field.Size = UDim2.fromOffset(colX, y), UDim2.fromOffset(cw - fh - 6, fh)
			ui.copy.Position, ui.copy.Size = UDim2.fromOffset(colX + cw - fh, y), UDim2.fromOffset(fh, fh)
			y = y + fh + 10
			local ps = phone and 20 or 18
			local pitch = (cw - ps) / 8
			for i, p in ipairs(ui.presets) do
				p.Position, p.Size = UDim2.fromOffset(colX + math.floor((i - 1) * pitch + 0.5), y), UDim2.fromOffset(ps, ps)
			end
			ui.add.Position, ui.add.Size = UDim2.fromOffset(colX + cw - ps, y), UDim2.fromOffset(ps, ps)
			ui.add.TextSize = phone and 18 or 15
			y = y + ps
			-- Settings rows (visible ones; open dropdown choices included).
			local has = #st.opts > 0
			ui.div.Visible, ui.cap.Visible, ui.list.Visible = has, has, has
			local listH = 0
			if has then
				y = y + 10
				ui.div.Position, ui.div.Size = UDim2.fromOffset(colX, y), UDim2.fromOffset(cw, 1)
				y = y + 7
				ui.cap.Position, ui.cap.Size = UDim2.fromOffset(colX + 2, y), UDim2.fromOffset(cw, 14)
				y = y + 16
				local content, n = 0, 0
				for _, ch in ipairs(ui.list:GetChildren()) do
					if ch:IsA("GuiObject") and ch.Visible then content = content + ch.Size.Y.Offset; n = n + 1 end
				end
				content = content + math.max(n - 1, 0) * 2
				local room = winH - 12 - y - PAD
				local cap = land and room or math.min(phone and 196 or 168, room)
				listH = math.max(math.min(content, cap), math.min(content, S.h()))
				ui.list.CanvasSize = UDim2.fromOffset(0, content)
				ui.list.Position = UDim2.fromOffset(colX, y)
				local size = UDim2.fromOffset(cw, listH)
				if animate then Library._anim.move(ui.list, { Size = size }) else ui.list.Size = size end
				y = y + listH
			end
			y = y + PAD
			local H = math.max(y, st.svBottom + PAD)
			local grew = st.hgt and st.hgt ~= H
			st.w, st.hgt = W, H
			local size = UDim2.fromOffset(W, H)
			if animate and ui.frame.Visible then Library._anim.move(ui.frame, { Size = size }) else ui.frame.Size = size end
			if ui.frame.Visible and (grew or not animate) then place(animate) end
		end

		-- ===== drag / keyboard ========================================================
		function picker._drag(input, glide)
			if not ui then return end
			local p = GetInputPosition(input)
			if st.drag == "sv" then
				local a, s = ui.sv.AbsolutePosition, ui.sv.AbsoluteSize
				if s.X <= 0 or s.Y <= 0 then return end
				st.s = math.clamp((p.X - a.X) / s.X, 0, 1)
				st.v = 1 - math.clamp((p.Y - a.Y) / s.Y, 0, 1)
			elseif st.drag == "hue" or st.drag == "alpha" then
				local hit = st.drag == "hue" and ui.hueHit or ui.alphaHit
				local a, s = hit.AbsolutePosition.X, hit.AbsoluteSize.X
				local k = s / math.max(hit.Size.X.Offset, 1)
				if s <= 14 * k then return end
				local f = math.clamp((p.X - a - 7 * k) / (s - 14 * k), 0, 1)
				if st.drag == "hue" then st.h = math.min(f, 0.9999) else st.alpha = math.floor(f * 100 + 0.5) / 100 end
			elseif st.drag == "opt" and st.dragOpt then
				st.dragOpt.fromInput(input)
				return
			else
				return
			end
			paint(true, glide)
		end
		local function nudge(key, big)
			local d = big and 0.1 or 0.01
			local K = Enum.KeyCode
			local dx = (key == K.Right and d) or (key == K.Left and -d) or 0
			local dy = (key == K.Up and d) or (key == K.Down and -d) or 0
			if dx == 0 and dy == 0 then return false end
			if st.focus == "hue" then st.h = (st.h + dx + dy) % 1
			elseif st.focus == "alpha" then st.alpha = math.clamp(math.floor((st.alpha + dx + dy) * 100 + 0.5) / 100, 0, 1)
			else st.s = math.clamp(st.s + dx, 0, 1); st.v = math.clamp(st.v + dy, 0, 1) end
			paint(true, false)
			return true
		end
		local function listen()
			conns[#conns + 1] = Library._uis("InputChanged", function(input)
				if st.drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then picker._drag(input, false) end
			end)
			conns[#conns + 1] = Library._uis("InputEnded", function(input)
				if st.drag and IsPrimaryInput(input) then
					if st.drag == "opt" and st.dragOpt then st.dragOpt.release() end
					if ui then
						Library._anim.scale(ui.hueThumb, 1, "fast")
						Library._anim.scale(ui.alphaThumb, 1, "fast")
					end
					st.drag, st.dragOpt = nil, nil
				end
			end)
			conns[#conns + 1] = Library._uis("InputBegan", function(input, gpe)
				if gpe or not st.open or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
				if ctrl and input.KeyCode == Enum.KeyCode.C then
					if setclipboard then pcall(setclipboard, hexOf(true)) end
				elseif ctrl and input.KeyCode == Enum.KeyCode.V then
					local okc, clip = pcall(function() return getclipboard and getclipboard() end)
					local c, a = Library._cpParse(okc and clip or nil)
					if c then setColor(c, a, true, true) elseif ui then ui.hexBox:CaptureFocus() end
				else
					nudge(input.KeyCode, UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift))
				end
			end)
		end
		local function unlisten()
			for _, c in ipairs(conns) do c.Disconnect() end
			conns = {}
			st.drag, st.dragOpt = nil, nil
		end

		-- ===== open / close ===========================================================
		local function closePicker()
			if not st.open then return end
			st.open = false
			unlisten()
			if Library._cpSwatchSync == syncSwatches then Library._cpSwatchSync = nil end
			if ui then
				if ui.hexFocused then ui.hexBox:ReleaseFocus() end
				UnregisterPopup(ui.frame)
				SmoothClose(ui.frame, 0.12)
			end
			if st.openColor and ColorToHex(st.openColor) ~= ColorToHex(st.color) then picker._pushRecent(st.color) end
		end
		local function openPicker()
			if st.open then return end
			if not ui then
				build()
				buildOptions()
			end
			CloseAllPopupsExcept(ui.frame)
			st.open = true
			st.openColor, st.openAlpha = st.color, st.alpha
			st.focus = "sv"
			ui.pv.BackgroundColor3 = st.color
			Library._cpSwatchSync = syncSwatches
			syncSwatches()
			paintOptions(false)
			layout(false)
			paint(false)
			ui.frame.Visible = true
			st.zbase = NextPopupZ()
			ladder(st.zbase)
			place(false)
			SmoothOpen(ui.frame, 0.02, 0.16)
			task.defer(function() if st.open and ui then place(false) end end)
			RegisterPopup(ui.frame, closePicker, anchorButton)
			listen()
		end

		function picker.Set(color) setColor(color, nil, false, st.open) end
		function picker.Get() return st.color end
		function picker.GetAlpha() return st.alpha end
		function picker.SetAlpha(a) st.alpha = math.clamp(tonumber(a) or 1, 0, 1); paint(false) end
		function picker.Close() closePicker() end
		function picker.Open() openPicker() end
		function picker.IsOpen() return st.open end
		function picker.Toggle()
			if st.open then
				if ui and Library._popupFresh(ui.frame) then return end
				closePicker()
			else
				openPicker()
			end
		end
		-- Embedded settings.
		function picker.SetOptions(list) applyOpts(list, false) end
		function picker.AddOptions(list) applyOpts(list, true) end
		function picker.GetOption(name) return st.vals[tostring(name)] end
		function picker.SetOption(name, v, silent) setOpt(tostring(name), v, silent, st.open) end
		function picker.GetOptions()
			local t = {}
			for k, v in pairs(st.vals) do t[k] = v end
			return t
		end
		function picker.HasOptions() return #st.opts > 0 end
		-- Animated colour while Rainbow is on, else the chosen one.
		function picker.Live() return st.live or st.color end
		-- Config: alpha + option values as one JSON string.
		function picker.Save()
			local o = {}
			for _, x in ipairs(st.opts) do
				local v = st.vals[x.Name]
				if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then o[x.Name] = v end
			end
			local ok, s = pcall(function() return game:GetService("HttpService"):JSONEncode({ a = math.floor(st.alpha * 100 + 0.5) / 100, o = o }) end)
			return ok and s or ""
		end
		function picker.Load(s)
			if type(s) ~= "string" or s == "" then return end
			local ok, data = pcall(function() return game:GetService("HttpService"):JSONDecode(s) end)
			if not ok or type(data) ~= "table" then return end
			if type(data.a) == "number" and math.abs(data.a - st.alpha) > 0.001 then
				st.alpha = math.clamp(data.a, 0, 1)
				paint(true)
			end
			if type(data.o) == "table" then
				for _, x in ipairs(st.opts) do
					if data.o[x.Name] ~= nil then setOpt(x.Name, data.o[x.Name], false, false) end
				end
			end
		end

		anchorButton.MouseButton1Click:Connect(function() picker.Toggle() end)
		paint(false)
		return picker
	end
	-- For parts outside AddWindow (the inventory options plate): Library._colorPicker(anchor, color, fn(color, alpha)).
	Library._colorPicker = function(anchor, color, onChange) return AcrylicBlur.CreateColorPicker(anchor, color, onChange) end
	-- Element glue: obj:AddPickerOptions / SetPickerOptions / GetPickerOption / SetPickerOption /
	-- GetPickerOptions / GetAlpha, obj:GetColor() = live colour (rainbow). Alpha + options are
	-- saved as "cpx_<label>#n" (JSON) next to the element's own keys. `opts` = the creation-time
	-- list (or { PickerOptions = list }); Library._pickerOptions (list or fn(label)) = defaults.
	WindowObj._cpBind = function(obj, picker, opts, label)
		if type(obj) ~= "table" or type(picker) ~= "table" or obj._cp then return obj end
		obj._cp = picker
		local baseColor = obj.GetColor or obj.Get
		function obj:AddPickerOptions(list) picker.AddOptions(list); return self end
		function obj:SetPickerOptions(list) picker.SetOptions(list); return self end
		function obj:GetPickerOption(name) return picker.GetOption(name) end
		function obj:SetPickerOption(name, v, silent) picker.SetOption(name, v, silent); return self end
		function obj:GetPickerOptions() return picker.GetOptions() end
		function obj:GetAlpha() return picker.GetAlpha() end
		function obj:OpenPicker() picker.Open(); return self end
		function obj:GetColor()
			if picker.Live and picker.Live() ~= picker.Get() then return picker.Live() end
			if baseColor then return baseColor(self) end
			return picker.Get()
		end
		if type(opts) == "table" and type(opts.PickerOptions) == "table" then opts = opts.PickerOptions end
		if (type(opts) ~= "table" or #opts == 0) and not picker._registered then
			local d = Library._pickerOptions
			if type(d) == "function" then
				local ok, r = pcall(d, label)
				d = ok and r or nil
			end
			opts = type(d) == "table" and d or nil
		end
		if opts then picker.SetOptions(opts) end
		if not picker._registered then
			picker._registered = true
			RegisterConfigElement("cpx_", label or "color", { Get = function() return picker.Save() end, Set = function(_, v) picker.Load(v) end })
		end
		return obj
	end
	-- COLORPICKER END



