	-- CONFIG CREATION BEGIN: "+" New config plate, folder menu (Import / Export / Recently deleted),
	-- Recent / Name sort, empty states, undo bar, per-config metadata. One field function (its own
	-- locals: AddWindow is at the register cap). Files stay compatible: presets are still
	-- NeverloseConfig_<id>_<name>.json with the same keys, "__last.txt" is still the autoload
	-- pointer; the new metadata (times, bind counts, sort) lives in NLConfigMeta_<id>.json only.
	-- API: WindowObj._cfgPlateOpen(kind "new"|"import"|"export", text, anchor), _cfgValidate(text,
	-- except, names) -> err | nil, name; _cfgCreate(name, mode "current"|"default"|"copy", src,
	-- include{Settings,Binds,Colors,Layout,Groups}) -> ok, err; _cfgAfterCreate(name, opts);
	-- _cfgUndo(name, meta, wasActive); _cfgFolderMenu(); _cfgSort(); _cfgImport(text).
	WindowObj._cfgUI = function()
		local S = Library._sel
		local http = game:GetService("HttpService")
		local META_FILE = "NLConfigMeta_" .. windowConfigId .. ".json"
		local RED = Color3.fromRGB(233, 90, 110)
		local FIELD = Color3.fromRGB(26, 26, 38)
		local MAXLEN = 24
		local CATS = { "Settings", "Binds", "Colors", "Layout", "Groups" }
		local CAT_LABEL = { Settings = "Settings", Binds = "Binds", Colors = "Colors", Layout = "Window layout", Groups = "Groups" }
		local COLOR_PREFIX = { "colorpicker_", "togglecolorpicker_color_", "dropdown_color_", "dropdowncolorpicker_color_",
			"settings_colorpicker_", "settings_swatch_", "usage_colorpicker_", "accordion_colorpicker_", "window_mainColor" }

		-- Metadata store ({ configs = { [name] = { created, saved, binds } }, sort = "recent"|"name" }).
		local meta = { configs = {}, sort = "recent" }
		if type(readfile) == "function" and type(isfile) == "function" then
			local okE, ex = pcall(isfile, META_FILE)
			if okE and ex then
				local okR, content = pcall(readfile, META_FILE)
				if okR and type(content) == "string" then
					local okD, d = pcall(http.JSONDecode, http, content)
					if okD and type(d) == "table" then
						if type(d.configs) == "table" then meta.configs = d.configs end
						if d.sort == "name" then meta.sort = "name" end
					end
				end
			end
		end
		WindowObj._cfgMeta = meta
		local function saveMeta()
			if type(writefile) ~= "function" then return end
			local ok, enc = pcall(http.JSONEncode, http, meta)
			if ok then pcall(writefile, META_FILE, enc) end
		end
		WindowObj._cfgSaveMeta = saveMeta
		local function countBinds(data)
			local n = 0
			local hk = type(data) == "table" and data.__extra_hotkeys
			if type(hk) == "table" then
				for _, list in pairs(hk) do if type(list) == "table" then n = n + #list end end
			end
			return n
		end
		WindowObj._cfgMetaText = function(name)
			local m = meta.configs[name]
			if type(m) ~= "table" then return "" end
			local parts = {}
			local t = tonumber(m.saved)
			if t then
				local d = math.max(0, os.time() - t)
				if d < 60 then table.insert(parts, "modified just now")
				elseif d < 3600 then table.insert(parts, "modified " .. math.floor(d / 60) .. "m ago")
				elseif d < 86400 then table.insert(parts, "modified " .. math.floor(d / 3600) .. "h ago")
				else table.insert(parts, "modified " .. math.floor(d / 86400) .. "d ago") end
			end
			local b = tonumber(m.binds) or 0
			if b > 0 then table.insert(parts, b .. (b == 1 and " bind" or " binds")) end
			return table.concat(parts, "  \194\183  ")
		end
		WindowObj._cfgRowMeta = function(row, name)
			local label, rn = row:FindFirstChild("ConfigMeta"), row:FindFirstChild("Rename")
			if not label or not rn or row:GetAttribute("MetaMsg") then return end
			local t = WindowObj._cfgMetaText(name)
			label.Text = t
			label.Visible = t ~= ""
			rn.Position = UDim2.new(0, S.padL, 0.5, t ~= "" and -8 or 0)
		end
		-- After a real write (SaveNamedConfig, create, duplicate, import).
		WindowObj._cfgTouch = function(name, data, created, binds)
			local m = meta.configs[name]
			if type(m) ~= "table" then m = {}; meta.configs[name] = m end
			local now = os.time()
			m.saved = now
			if created or not m.created then m.created = now end
			if data then m.binds = countBinds(data) elseif binds then m.binds = binds end
			saveMeta()
			local row = ListContainer:FindFirstChild("ConfigRow_" .. name)
			if row then WindowObj._cfgRowMeta(row, name) end
		end
		WindowObj._cfgMetaRename = function(old, new)
			meta.configs[new] = meta.configs[old]
			meta.configs[old] = nil
			saveMeta()
		end
		WindowObj._cfgMetaDrop = function(name)
			local m = meta.configs[name]
			meta.configs[name] = nil
			saveMeta()
			return m
		end
		-- Relative times age: the visible meta lines refresh every 30 s while the list is open.
		task.spawn(function()
			while not WindowObj._unloaded do
				task.wait(30)
				if ConfigMainFrame.Visible then
					for _, row in ipairs(ListContainer:GetChildren()) do
						if row:IsA("Frame") and string.sub(row.Name, 1, 10) == "ConfigRow_" then WindowObj._cfgRowMeta(row, string.sub(row.Name, 11)) end
					end
				end
			end
		end)

		-- Name rules (create + inline rename): 1-24 characters, no \ / : * ? " < > |, not ending in
		-- a dot, unique ignoring case. Returns an error text, or nil and the trimmed name.
		WindowObj._cfgValidate = function(text, except, names)
			local trimmed = (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
			if trimmed == "" then return "Enter a name" end
			if (utf8.len(trimmed) or #trimmed) > MAXLEN then return "Too long (max " .. MAXLEN .. " characters)" end
			if trimmed:find('[\\/:%*%?"<>|]') then return 'Not allowed: \\ / : * ? " < > |' end
			if trimmed:find("%c") then return "Not allowed: control characters" end
			if trimmed:sub(-1) == "." then return "Can't end with a dot" end
			local low = string.lower(trimmed)
			local exceptLow = except and string.lower(except) or nil
			for _, n in ipairs(names or ListConfigs()) do
				if string.lower(n) == low and low ~= exceptLow then return "A config with this name exists" end
			end
			if low ~= exceptLow and WindowObj._cfgExists(trimmed) then return "A config with this name exists" end
			return nil, trimmed
		end

		-- What a key belongs to ("Include" in the plate).
		local function catOf(k)
			if string.sub(k, 1, 8) == "__extra_" then
				local e = string.sub(k, 9)
				if e == "hotkeys" or e == "hotkeys_view" then return "Binds" end
				if string.sub(e, 1, 7) == "groups_" then return "Groups" end
				if string.sub(e, 1, 4) == "pos_" or e == "screen_buttons" then return "Layout" end
				return "Settings"
			end
			for _, p in ipairs(COLOR_PREFIX) do
				if string.sub(k, 1, #p) == p then return "Colors" end
			end
			if string.sub(k, 1, 7) == "window_" then return "Layout" end
			return "Settings"
		end
		WindowObj._cfgCatOf = catOf
		local function readConfig(name)
			if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil end
			local okE, ex = pcall(isfile, GetConfigPath(name))
			if not okE or not ex then return nil end
			local okR, content = pcall(readfile, GetConfigPath(name))
			if not okR or type(content) ~= "string" or #content > 2097152 then return nil end
			local okD, d = pcall(http.JSONDecode, http, content)
			return okD and type(d) == "table" and d or nil
		end
		local function writeData(name, data)
			if type(writefile) ~= "function" then return false end
			local ok, enc = pcall(http.JSONEncode, http, data)
			if not ok or type(enc) ~= "string" then return false end
			local okW, res = pcall(writefile, GetConfigPath(name), enc)
			return okW and res ~= false
		end
		local function allIncluded(inc)
			for _, c in ipairs(CATS) do if not inc[c] then return false end end
			return true
		end
		-- Writes a new preset. Start from: current values / the defaults (built values) / a copy of
		-- another preset; keys of excluded categories are left out (elements then load as their
		-- default, binds / layout / groups stay as they are).
		WindowObj._cfgCreate = function(name, mode, src, inc)
			inc = type(inc) == "table" and inc or { Settings = true, Binds = true, Colors = true, Layout = true, Groups = true }
			local data = {}
			if mode == "copy" then
				local d = src and readConfig(src)
				if not d then return false, "Can't read that config" end
				for k, v in pairs(d) do if inc[catOf(k)] then data[k] = v end end
			elseif mode == "default" then
				for _, entry in ipairs(_registeredElements) do
					if entry.baseline ~= nil and inc[catOf(entry.key)] then data[entry.key] = entry.baseline end
				end
				if inc.Binds then data.__extra_hotkeys = {} end
			else
				for k, v in pairs(WindowObj._cfgCollect()) do if inc[catOf(k)] then data[k] = v end end
			end
			if not writeData(name, data) then return false, "Couldn't write the file" end
			WindowObj._cfgTouch(name, data, true)
			-- The new preset becomes the loaded one (current + everything: already what is on screen).
			if not (mode ~= "copy" and mode ~= "default" and allIncluded(inc)) then LoadNamedConfig(name) end
			return true
		end

		local function toast(text)
			if WindowObj.Log then pcall(function() WindowObj:Log(text, { icon = "vote", duration = 3 }) end) end
		end
		WindowObj._cfgToClipboard = function(text)
			local fn = (type(setclipboard) == "function" and setclipboard) or (type(toclipboard) == "function" and toclipboard) or nil
			if not fn then return false end
			return (pcall(fn, text))
		end
		local function fromClipboard()
			local fn = (type(getclipboard) == "function" and getclipboard) or (type(fromclipboard) == "function" and fromclipboard) or nil
			if not fn then return nil end
			local ok, text = pcall(fn)
			return ok and type(text) == "string" and text or nil
		end

		-- New / restored row: brief white flash (+ the content slides in from the left).
		WindowObj._cfgFlash = function(row, slide)
			if not row or not row.Parent then return end
			local fl = New("Frame", {
				Name = "CreateFlash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = S.white, BackgroundTransparency = 0.8,
				BorderSizePixel = 0, ZIndex = row.ZIndex,
			}, row)
			New("UICorner", { CornerRadius = UDim.new(0, S.radius) }, fl)
			Library._anim.raw(fl, { BackgroundTransparency = 1 }, 0.7, "color", 0.15)
			task.delay(1.1, function() if fl.Parent then fl:Destroy() end end)
			if slide and (Library._animScale or 1) > 0 and Library._perfMode ~= "max" then
				for _, c in ipairs(row:GetChildren()) do
					if c:IsA("GuiObject") and c ~= fl and c.Name ~= "SettingsFrame" and c.Visible then
						local p = c.Position
						c.Position = p + UDim2.fromOffset(-18, 0)
						Library._anim.move(c, { Position = p }, "slow")
					end
				end
			end
		end
		-- Scrolls the list so `row` is in view (after the sort has placed it).
		local function reveal(row)
			task.delay(0.05, function()
				if not row.Parent or not ConfigMainFrame.Visible then return end
				local sc = GetMainFrameScale()
				local top = (row.AbsolutePosition.Y - ListContainer.AbsolutePosition.Y) / sc
				local h = ListContainer.AbsoluteSize.Y / sc
				local cur = ListContainer.CanvasPosition.Y
				if top >= 0 and top + row.AbsoluteSize.Y / sc <= h then return end
				local target = math.max(0, cur + top - 6)
				Tween(ListContainer, { CanvasPosition = Vector2.new(0, target) }, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			end)
		end
		WindowObj._cfgAfterCreate = function(n, opts)
			opts = type(opts) == "table" and opts or {}
			if opts.activate then SetActiveConfigName(n) end
			if ConfigSearchBox.Text ~= "" then ConfigSearchBox.Text = "" end
			local row = ListContainer:FindFirstChild("ConfigRow_" .. n) or MakeConfigButton(n)
			if WindowObj._knownConfigs then WindowObj._knownConfigs[n] = true end
			if opts.activate and WindowObj._rowMarks and WindowObj._rowMarks[n] then WindowObj._rowMarks[n]() end
			WindowObj._cfgSort()
			task.defer(function() WindowObj._cfgFlash(row, true) end)
			reveal(row)
			if opts.toast ~= false then toast('Config "{' .. n .. '}" ' .. tostring(opts.verb or "created")) end
			return row
		end

		-- Sort: Recent (last saved first) / Name.
		WindowObj._cfgSort = function()
			local rows = {}
			for _, c in ipairs(ListContainer:GetChildren()) do
				if c:IsA("Frame") and string.sub(c.Name, 1, 10) == "ConfigRow_" then table.insert(rows, c) end
			end
			local function key(r) return string.sub(r.Name, 11) end
			local function t(r) local m = meta.configs[key(r)]; return type(m) == "table" and tonumber(m.saved) or 0 end
			table.sort(rows, function(a, b)
				if meta.sort == "recent" then
					local ta, tb = t(a), t(b)
					if ta ~= tb then return ta > tb end
				end
				return string.lower(key(a)) < string.lower(key(b))
			end)
			for index, row in ipairs(rows) do row.LayoutOrder = index end
		end
		do
			local seg = ConfigMainFrame:FindFirstChild("SortToggle")
			if seg and seg:FindFirstChild("SortPill") then
				local btns = { seg:FindFirstChild("SortRecent"), seg:FindFirstChild("SortName") }
				local function paint(instant)
					local byName = meta.sort == "name"
					local pos = UDim2.fromOffset(byName and 32 or 2, 2)
					if instant then seg.SortPill.Position = pos else Library._anim.move(seg.SortPill, { Position = pos }, "fast") end
					for i, b in ipairs(btns) do
						local ic = b:FindFirstChildWhichIsA("ImageLabel")
						local on = (i == 2) == byName
						if ic then Library._anim.color(ic, { ImageColor3 = on and Library._sel.selText or Color3.fromRGB(130, 134, 152) }, instant and 0 or nil) end
					end
				end
				paint(true)
				for i, b in ipairs(btns) do
					b.MouseButton1Click:Connect(function()
						local want = i == 2 and "name" or "recent"
						if meta.sort == want then return end
						meta.sort = want
						paint(false)
						saveMeta()
						WindowObj._cfgSort()
					end)
				end
			end
		end

		-- Empty states (no presets at all / nothing matches the search).
		WindowObj._cfgEmpty = function(visibleRows)
			local lbl = ListContainer:FindFirstChild("EmptyState")
			if visibleRows > 0 then if lbl then lbl.Visible = false end return end
			if not lbl then
				lbl = New("TextLabel", {
					Name = "EmptyState", Size = UDim2.new(1, 0, 0, Library._phone and 46 or 40), BackgroundTransparency = 1,
					TextColor3 = S.dim, TextSize = 13, Font = FONT, LayoutOrder = 99999, ZIndex = ListContainer.ZIndex + 2,
				}, ListContainer)
			end
			local any = false
			for _, c in ipairs(ListContainer:GetChildren()) do
				if c:IsA("Frame") and string.sub(c.Name, 1, 10) == "ConfigRow_" then any = true break end
			end
			lbl.Text = any and "No results" or "No configs yet \226\128\148 press +"
			lbl.Visible = true
		end

		-- Undo bar (6 s) at the bottom of the presets panel after a delete.
		WindowObj._cfgUndo = function(name, metaCopy, wasActive)
			local old = ConfigMainFrame:FindFirstChild("UndoBar")
			if old then old:Destroy() end
			local tok = {}
			WindowObj._cfgSnackTok = tok
			WindowObj._cfgSnack = true
			UpdateConfigPanelHeight()
			local bar = New("Frame", {
				Name = "UndoBar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -20, 0, 36),
				BackgroundColor3 = FIELD, BorderSizePixel = 0, ZIndex = 1,
			}, ConfigMainFrame)
			New("UICorner", { CornerRadius = UDim.new(0, 8) }, bar)
			Stroke(bar, "UndoStroke").Transparency = 0.9
			New("TextLabel", {
				Name = "UndoText", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -84, 1, 0), BackgroundTransparency = 1,
				Text = "Deleted \"" .. name .. "\"", TextColor3 = S.text, TextSize = 13, Font = FONT,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2,
			}, bar)
			local undo = New("TextButton", {
