	function S.render(q)
		S.ui()
		for _, c in ipairs(S.scroll:GetChildren()) do c:Destroy() end
		-- (First child: under the rows that follow at the same ZIndex.)
		S.slab = New("Frame", { Name = "SelSlab", Size = UDim2.new(1, 0, 0, ROW_H), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 1, BorderSizePixel = 0 }, S.scroll)
		New("UICorner", { CornerRadius = UDim.new(0, Library._sel.radius) }, S.slab)
		S.flat, S.groupAt = {}, {}
		local y = 0
		local toks = S.toks or {}
		if q == "" then
			if #S.recent > 0 then
				groupHeader(string.upper(tr("Recent")), y); y = y + GROUP_H
				for _, text in ipairs(S.recent) do
					local row = New("TextButton", { Name = "Recent", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, REC_H), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
						BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, S.scroll)
					New("UICorner", { CornerRadius = UDim.new(0, 9) }, row)
					local bar = New("Frame", { Name = "SelBar", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(3, 0), BackgroundColor3 = accent(), BorderSizePixel = 0 }, row)
					New("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
					local ic = Library._icon(row, "search", 14, DIM)
					ic.Position = UDim2.new(0, 24, 0.5, 0)
					New("TextLabel", { Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -60, 1, 0), BackgroundTransparency = 1, Text = text, TextSize = 14, Font = FONT, TextColor3 = TEXT,
						TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
					local it = { row = row, bar = bar, recent = text, y = y, h = REC_H, first = false, index = #S.flat + 1 }
					S.flat[it.index] = it
					row.MouseEnter:Connect(function() S.select(it.index, true) end)
					row.MouseButton1Click:Connect(function() S.activate(it.index) end)
					y = y + REC_H
				end
			else
				y = y + emptyBlock(y, tr("Search every setting"), tr("Type a name, a section or a key. Ctrl+F or / opens search."))
			end
		else
			local groups = S.groups or {}
			if #groups == 0 then
				y = y + emptyBlock(y, tr("No results"), tr("Try a shorter word, or the other language (RU / EN)."))
			else
				for _, g in ipairs(groups) do
					S.groupAt[#S.groupAt + 1] = #S.flat + 1
					groupHeader(groupTitle(g), y)
					y = y + GROUP_H
					for k, h in ipairs(g.items) do
						resultRow(h, y, k == 1, toks)
						y = y + ROW_H
					end
				end
			end
		end
		S.contentH = y
		S.layout()
		S.scroll.CanvasPosition = Vector2.zero
		S.sel = 0
		if #S.flat > 0 then S.select(1, true) end
		ApplyZIndexLadder(S.pop, S.z)
		if Library._themeMap then Library._themePass(S.pop, true) end
		-- Entrance: result rows rise 4px and fade in 12 ms apart (first 14); the empty state fades up.
		if S.pop.Visible then
			for i = 1, math.min(#S.flat, 14) do Library._anim.riseIn(S.flat[i].row, (i - 1) * 0.012, 4) end
			local es = S.scroll:FindFirstChild("EmptyState")
			if es then Library._anim.riseIn(es, 0, 6) end
		end
	end
	function S.run(text)
		S.query = text
		local q = trim(text)
		S.groups, S.toks = nil, {}
		if q ~= "" then S.groups, S.toks = S.search(q) end
		S.render(q)
		if S.filter then S.applyFilter(q) end
	end

	function S.openUI(q)
		if W._unloaded or not main.Visible then return end
		S.ui()
		if S.open then
			pcall(function() S.box:CaptureFocus() end)
			if q then S.box.Text = q end
			return
		end
		S.open = true
		S.build()
		ctx.closeExcept(S.pop)
		S.z = NextPopupZ()
		S.box.PlaceholderText = tr("Search settings…")
		S.box.Text = ""
		S.clear.Visible, S.esc.Visible = false, true
		S.paintChip()
		for _, c in ipairs(S.foot.Hints:GetChildren()) do
			local w = c:GetAttribute("Word")
			if w then c.Text = tr(w); c.Size = UDim2.fromOffset(math.ceil(MeasureText(c.Text, 11, FONT)) + 6, 16) end
		end
		btn.Visible = false
		S.field.Visible = true
		S.field.Size = UDim2.fromOffset(32, 30)
		Library._anim.move(S.field, { Size = UDim2.new(1, -20, 0, 30) }, "base")
		S.pop.Visible = false
		S.run("")
		ApplyZIndexLadder(S.pop, S.z)
		SmoothOpen(S.pop, 0.02, 0.18)
		ctx.register(S.pop, S.close, S.field)
		task.delay(Library._motion.dur(0.14), function()
			if not S.open then return end
			pcall(function() S.box:CaptureFocus() end)
			if q then S.box.Text = q elseif S.box.Text == "/" then S.box.Text = "" end
		end)
	end
	function S.close()
		if not S.open then return end
		S.open = false
		S.token = S.token + 1
		pcall(function() S.box:ReleaseFocus() end)
		ctx.unregister(S.pop)
		SmoothClose(S.pop, 0.14)
		Library._anim.move(S.field, { Size = UDim2.fromOffset(32, 30) }, "fast")
		task.delay(Library._motion.dur(0.15), function()
			if S.open then return end
			S.field.Visible = false
			btn.Visible = true
		end)
		if S.filter then
			S.filter = false
			S.applyFilter("")
		end
		S.query = ""
	end
	btn.MouseButton1Click:Connect(function()
		if S.open then S.close() else S.openUI() end
	end)

	local function ctrlDown() return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) end
	UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local kc = input.KeyCode
		if S.open then
			if kc == Enum.KeyCode.Down then
				if #S.flat > 0 then S.select(S.sel % #S.flat + 1) end
			elseif kc == Enum.KeyCode.Up then
				if #S.flat > 0 then S.select(S.sel <= 1 and #S.flat or S.sel - 1) end
			elseif kc == Enum.KeyCode.Return or kc == Enum.KeyCode.KeypadEnter then
				if trim(S.box.Text) ~= trim(S.query) then S.run(S.box.Text) end
				if S.sel > 0 then S.activate(S.sel) end
			elseif kc == Enum.KeyCode.Escape then
				if S.box.Text ~= "" then S.box.Text = "" else S.close() end
			elseif kc == Enum.KeyCode.Tab and #S.groupAt > 0 then
				local back = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
				local target
				if back then
					for i = #S.groupAt, 1, -1 do if S.groupAt[i] < S.sel then target = S.groupAt[i] break end end
					target = target or S.groupAt[#S.groupAt]
				else
					for _, at in ipairs(S.groupAt) do if at > S.sel then target = at break end end
					target = target or S.groupAt[1]
				end
				S.select(target)
			end
			return
		end
		if not main.Visible or W._unloaded then return end
		if UserInputService:GetFocusedTextBox() then return end
		if kc == Enum.KeyCode.Slash or (kc == Enum.KeyCode.F and ctrlDown()) then S.openUI() end
	end)

	W.OpenSearch = function(self, q) S.openUI(q) return self end
	W.CloseSearch = function(self) S.close() return self end
	W.SearchResults = function(self, q)
		local _, _, hits = S.search(tostring(q or ""))
		local out = {}
		for _, h in ipairs(hits) do
			out[#out + 1] = { name = h.e.label, tab = tabName(h.e.tab), sub = subName(h.e.tab, h.e.sub), path = table.concat(h.e.path, " > "), type = h.e.ctype, score = h.score }
		end
		return out
	end
	W.GetRecentSearches = function(self) return table.clone(S.recent) end
	W.ClearRecentSearches = function(self) S.recent = {} return self end
end
