	-- layout per mode: "agent" = tall preview left, filters + 3-column grid right
	function S.layoutPicker(agent)
		local P = S.P
		local list = P.filters:FindFirstChildOfClass("UIListLayout")
		if agent then
			P.preview.Position, P.preview.Size = UDim2.fromOffset(12, 68), UDim2.new(0.36, -12, 1, -78)
			P.divider.Visible = false
			P.filters.Position, P.filters.Size = UDim2.new(0.36, 8, 0, 72), UDim2.new(0.64, -20, 0, 26)
			P.grid.frame.Position, P.grid.frame.Size = UDim2.new(0.36, 8, 0, 106), UDim2.new(0.64, -14, 1, -112)
			P.tools.Size = UDim2.new(1, 0, 0, 26)
			-- narrow preview: the patches row sits left-aligned above the tools row
			P.stick.AnchorPoint, P.stick.Position = Vector2.new(0, 1), UDim2.new(0, 0, 1, -34)
			P.grid.fixedColumns, P.grid.cardHeight = 3, 104
		else
			P.preview.Position, P.preview.Size = UDim2.fromOffset(12, 68), UDim2.new(1, -24, 0.5, -68)
			P.divider.Visible = true
			P.filters.Position, P.filters.Size = UDim2.new(0, 12, 0.5, 10), UDim2.new(1, -24, 0, 26)
			P.grid.frame.Position, P.grid.frame.Size = UDim2.new(0, 12, 0.5, 44), UDim2.new(1, -18, 0.5, -48)
			P.tools.Size = UDim2.new(1, -(P.stick.Size.X.Offset + 12), 0, 26)
			P.stick.AnchorPoint, P.stick.Position = Vector2.new(1, 1), UDim2.new(1, 0, 1, 0)
			P.grid.fixedColumns, P.grid.cardHeight = 5, 92
		end
		if list then list.Padding = UDim.new(0, 6) end
		P.grid:Relayout()
	end
	-- cur = { key, slot, cat, item, mode = "skins" | "items" | "stickers", sticker = slot index, rarity }
	function S.openPicker(key)
		local sl = S.slotByKey[key]
		if not sl then return end
		local P = S.P or S.buildPicker()
		local side = state.side
		local catId = sl.gear or sl.cats[1]
		local it = S.item(state.slots[side][key])
		local cat = (it and S.cats[it.category]) or S.cats[catId] or { id = catId, name = catId, icon = "box" }
		S.cur = { key = key, slot = sl, cat = cat, item = it, mode = cat.kind == "items" and "items" or "skins", rarity = "All" }
		P.search.Text = ""
		local wasOpen = P.open
		P.open = true
		S.render(true)
		if not wasOpen then
			P.frame.Visible = true
			P.frame.GroupTransparency = 1
			P.scale.Scale = 0.985
			Library._anim.fade(P.frame, { GroupTransparency = 0 }, "base")
			Library._anim.move(P.scale, { Scale = 1 }, "slow")
			P.title.Position = UDim2.new(0.5, 0, 0, 6)
			Library._anim.move(P.title, { Position = UDim2.new(0.5, 0, 0, 12) }, "slow")
			P.line.Size = UDim2.new(0, 0, 0, 3)
			Library._anim.move(P.line, { Size = UDim2.new(0.55, 0, 0, 3) }, 0.4)
			task.delay(Library._motion.dur("base") + 0.03, function() if P.open then S.page.Visible = false end end)
			if Library._frost then Library._frost(P.frame, true) end
		end
		fire("OnOpen", side, key, it and it.id)
	end
	function S.closePicker(instant)
		local P = S.P
		if not P or not P.open then return end
		P.open = false
		if Library._invOpenPopup then Library._invOpenPopup.close() end
		S.page.Visible = S.fs == nil -- (under the item viewer the page stays hidden)
		if Library._frost and P.frame:GetAttribute("Frosting") then Library._frost(P.frame, false) end
		if instant or (Library._animScale or 1) <= 0 then
			P.frame.Visible = false
		else
			Library._anim.fade(P.frame, { GroupTransparency = 1 }, "fast", true)
			Library._anim.tween(P.scale, { Scale = 0.985 }, "fast", "exit")
			task.delay(Library._motion.dur("fast") + 0.02, function() if not P.open then P.frame.Visible = false end end)
		end
		S.refreshMain(not instant)
	end
	-- title / line / preview / tools / filters / grid for S.cur
	function S.render(full)
		local P, cur, side = S.P, S.cur, state.side
		if not P or not cur then return end
		local cat, it = cur.cat, cur.item
		local e = it and S.entry(side, it.id) or {}
		local agent = cat.id == "agent"
		S.layoutPicker(agent)
		local skin = it and S.skinOf(it, e.skin)
		-- title
		if cur.mode == "items" then
			P.title.Text = it and it.name or cat.name
			P.sub.Text = it and (it.collection or "") or ""
		else
			P.title.Text = it and (S.display(it) .. (skin and (" | " .. skin.name) or "")) or cat.name
			P.sub.Text = cur.mode == "stickers" and ("Sticker slot " .. tostring(cur.sticker or 1)) or (it and it.collection or "")
		end
		P.sub.Visible = P.sub.Text ~= ""
		local rarity = (cur.mode == "items" and it and it.rarity) or (skin and skin.rarity) or (it and cur.mode ~= "items" and "Stock") or "Stock"
		Library._anim.setColor(P.line, "BackgroundColor3", Library._rarityColor(rarity), "base")
		-- preview image / placeholder
		local image = (skin and skin.image) or (it and it.image)
		P.img.Visible = image ~= nil
		if image then P.img.Image = image end
		-- no artwork: empty panel (soft line); weapons also show their name large and faint
		P.pvName.Visible = image == nil and not agent and cur.mode ~= "items"
		P.pvName.Text = it and it.name or cat.name
		if full and P.pvName.Visible and (Library._animScale or 1) > 0 then
			P.pvName.TextTransparency = 1
			Library._anim.fade(P.pvName, { TextTransparency = 0.88 }, "slow")
		end
		-- tools
		local typed = cat.typed and true or false
		P.optBtn.Visible = it ~= nil and not cat.noOptions and cur.mode ~= "stickers"
		P.customBtn.Visible = agent and it ~= nil
		P.bothBtn.Visible = typed and #S.sides > 1
		P.typeBtn.Visible = typed
		if typed then
			P.typeText.Text = it and S.display(it) or ("★ " .. cat.name)
			for _, ch in ipairs(P.typeIconBox:GetChildren()) do ch:Destroy() end
			P.typeIconBox.Visible = it ~= nil and it.image ~= nil
			if it and it.image then
				New("ImageLabel", { Name = "TypeImage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = it.image, ScaleType = Enum.ScaleType.Fit, NoTheme = true }, P.typeIconBox)
			end
		end
		P.trash.Visible = (cat.removable and it ~= nil) or (cur.mode == "skins" and skin ~= nil and not agent)
		P.close.Position = UDim2.new(1, -12, 0, 12)
		-- stickers row
		local nSlots = agent and 3 or ((cat.kind == "items" or cat.noStickers) and 0 or 5)
		if o.StickerSlots ~= nil and not agent and nSlots > 0 then nSlots = o.StickerSlots end
		P.stick.Visible = nSlots > 0 and it ~= nil
		P.stick.Size = UDim2.fromOffset(96 + math.max(nSlots, 1) * 32 - 6, 42)
		if not agent then P.tools.Size = UDim2.new(1, -(P.stick.Size.X.Offset + 12), 0, 26) end
		local stickers = type(e.stickers) == "table" and e.stickers or {}
		for i, s in ipairs(P.slots) do
			s.Visible = i <= nSlots
			s.Position = UDim2.fromOffset(96 + (i - 1) * 32, 16)
			local name = stickers[tostring(i)]
			local st
			for _, x in ipairs(S.stickers) do if x.name == name then st = x end end
			Library._setC(s, "BackgroundColor3", st and Library._rarityColor(st.rarity) or Color3.fromRGB(44, 47, 60))
			s.BackgroundTransparency = st and 0.15 or 0.25
			s.StickerMark.Text = st and string.upper(string.sub(st.name, 1, 1)) or ""
			local active = cur.mode == "stickers" and cur.sticker == i
			s.SlotRing.Transparency = active and 0 or 1
		end
		P.chipText.Text = agent and "Patches" or "Stickers"
		Library._setC(P.chip, "BackgroundColor3", cur.mode == "stickers" and Library._invAccent() or Color3.fromRGB(28, 31, 42))
		P.chip.BackgroundTransparency = cur.mode == "stickers" and 0.8 or 0.2
		-- filters
		local showItemDrop = (cur.mode == "skins" and not typed and #S.candidates(cur.slot, side) > 1) or cur.mode == "stickers"
		P.itemDrop.Visible = showItemDrop
		if cur.mode == "stickers" then
			P.itemDropText.Text = cur.collection or "All"
		else
			P.itemDropText.Text = it and it.name or cat.name
		end
		P.rarityDropText.Text = (cur.rarity and cur.rarity ~= "All") and cur.rarity or "Rarity"
		local wDrops = (showItemDrop and 132 or 0) + 96
		P.search.Size = UDim2.new(1, -wDrops, 0, 26)
		-- grid
		local list, sel = {}, nil
		if cur.mode == "skins" then
			if it then
				local stock = Library._invNorm({ name = S.stockName(it), rarity = "Stock", image = it.image, icon = it.icon, id = "__stock" })
				table.insert(list, stock)
				for _, s in ipairs(it.skins) do table.insert(list, s) end
				sel = skin and skin.id or "__stock"
			end
		elseif cur.mode == "items" then
			list = S.candidates(cur.slot, side)
			sel = it and it.id
		else
			for _, s in ipairs(S.stickers) do
				if not cur.collection or cur.collection == "All" or s.collection == cur.collection then table.insert(list, s) end
			end
			sel = stickers[tostring(cur.sticker or 1)]
		end
		-- full: new cards; otherwise only the selection moves
		if full then P.grid:SetItems(list, sel) else P.grid:SetSelected(sel) end
		S.applyFilter()
		ApplyZIndexLadder(P.frame, P.frame.ZIndex)
	end
	function S.applyFilter()
		local P, cur = S.P, S.cur
		if not P or not cur then return end
		local q = string.lower(P.search.Text or "")
		local r = cur.rarity
		P.grid:SetFilter(function(it)
			if it.id == "__stock" then return q == "" and (r == nil or r == "All") end
			if q ~= "" and not string.find(string.lower(it.name), q, 1, true) then return false end
			if r and r ~= "All" and Library._rarityName(it.rarity) ~= r then return false end
			return true
		end)
	end
	function S.setMode(mode, stickerSlot)
		local cur = S.cur
		if not cur or not cur.item then return end
		cur.mode = mode
		cur.sticker = stickerSlot or cur.sticker or 1
		cur.rarity = "All"
		S.P.search.Text = ""
		S.render(true)
	end
	function S.gridClick(pick)
		local cur, side = S.cur, state.side
		if not cur then return end
		if cur.mode == "items" then
			state.slots[side][cur.key] = pick.id
			cur.item = pick
			fire("OnEquip", side, cur.key, pick.id, pick)
			S.render(false)
			S.P.grid:SetSelected(pick.id)
		elseif cur.mode == "skins" then
			local e = S.entry(side, cur.item.id)
			e.skin = pick.id ~= "__stock" and pick.name or nil
			fire("OnSkinChanged", side, cur.item.id, e.skin, pick)
			S.render(false)
			S.P.grid:SetSelected(pick.id)
		else
			local e = S.entry(side, cur.item.id)
			e.stickers = type(e.stickers) == "table" and e.stickers or {}
			local k = tostring(cur.sticker or 1)
			e.stickers[k] = e.stickers[k] ~= pick.name and pick.name or nil
			fire("OnSticker", side, cur.item.id, cur.sticker or 1, e.stickers[k])
			fire("OnOptionsChanged", side, cur.item.id, e)
			S.render(false)
			S.P.grid:SetSelected(e.stickers[k])
		end
	end
	-- dirty = false: render keeps the cards (only the selection moves)
	function S.unequip()
		local cur, side = S.cur, state.side
		if not cur then return end
		if cur.cat.removable and cur.mode == "items" then
			state.slots[side][cur.key] = nil
			cur.item = nil
			fire("OnEquip", side, cur.key, nil)
		elseif cur.item then
			state.items[side][cur.item.id] = nil
			fire("OnSkinChanged", side, cur.item.id, nil)
		end
		S.render(true)
	end
	function S.bothSides()
		local cur, side = S.cur, state.side
		if not cur or not cur.item then return end
		for _, other in ipairs(S.sides) do
			if other ~= side then
				state.slots[other][cur.key] = cur.item.id
				local src, dst = S.entry(side, cur.item.id), {}
				for k, v in pairs(src) do
					if type(v) == "table" then
						local c = {}
						for k2, v2 in pairs(v) do c[k2] = v2 end
						dst[k] = c
					else
						dst[k] = v
					end
				end
				state.items[other][cur.item.id] = dst
				fire("OnEquip", other, cur.key, cur.item.id, cur.item)
			end
		end
		local b = S.P.bothBtn
		b:SetAttribute("On", true)
		task.delay(0.9, function() if b.Parent then b:SetAttribute("On", false) end end)
	end
	function S.openItemList()
		local cur, side = S.cur, state.side
		if not cur then return end
		if cur.mode == "stickers" then
			local cols, seen = { "All" }, {}
			for _, s in ipairs(S.stickers) do
				if s.collection and not seen[s.collection] then seen[s.collection] = true; table.insert(cols, s.collection) end
			end
			Library._invList(ctx, S.P.itemDrop, { Title = "Collection", Values = cols, Current = cur.collection or "All", OnPick = function(v)
				cur.collection = v
				S.render(true)
			end })
			return
		end
		local values = {}
		for _, it in ipairs(S.candidates(cur.slot, side)) do table.insert(values, { name = it.name, id = it.id, icon = it.icon, image = it.image }) end
		local colName = cur.slot.col and S.columns[cur.slot.col].name or cur.cat.name
		Library._invList(ctx, S.P.itemDrop, { Title = colName, Values = values, Current = cur.item and cur.item.id, OnPick = function(v)
			state.slots[side][cur.key] = v.id
			cur.item = S.item(v.id)
			cur.cat = S.cats[cur.item.category] or cur.cat
			fire("OnEquip", side, cur.key, v.id, cur.item)
			S.render(true)
		end })
	end
	function S.openTypeList()
		local cur, side = S.cur, state.side
		if not cur then return end
		local values = {}
		for _, it in ipairs(S.candidates(cur.slot, side)) do table.insert(values, { name = S.display(it), id = it.id, icon = it.icon, image = it.image }) end
		Library._invList(ctx, S.P.typeBtn, { Title = cur.cat.list or cur.cat.name, Values = values, Current = cur.item and cur.item.id, Align = "center", OnPick = function(v)
			state.slots[side][cur.key] = v.id
			cur.item = S.item(v.id)
			fire("OnEquip", side, cur.key, v.id, cur.item)
			S.render(true)
		end })
	end
	function S.openRarityList()
		local cur = S.cur
		if not cur then return end
		local have = {}
		for _, c in ipairs(S.P.grid.items) do
			if c.id ~= "__stock" and c.rarity then have[Library._rarityName(c.rarity)] = true end
		end
		local values = { "All" }
		for _, r in ipairs(Library._rarities) do
			if have[r[1]] then table.insert(values, { name = r[1], rarity = r[1] }) end
		end
		Library._invList(ctx, S.P.rarityDrop, { Title = "Rarity", Values = values, Current = cur.rarity or "All", OnPick = function(v)
			cur.rarity = type(v) == "table" and v.name or v
			S.P.rarityDropText.Text = cur.rarity ~= "All" and cur.rarity or "Rarity"
			S.applyFilter()
		end })
	end

	-- -------------------------------------------------------------- options plate
	-- which = "options" (name tag, seed, wear, StatTrak, stickers, glow, Apply/Reset) or
	-- "custom" (agent customization: radio commands, cloth physics, sleeves).
	function S.openOptions(anchor, which)
		local cur, side = S.cur, state.side
		if not cur or not cur.item then return end
		if Library._invOpenPopup and Library._invOpenPopup.frame.Name == "InvOptions" and Library._invOpenPopup.which == which then
			Library._invOpenPopup.close()
			return
		end
		local id = cur.item.id
		local e = S.entry(side, id)
		local pop = Library._invPopup(ctx, anchor, { Name = "InvOptions", Width = 262, Side = "right", Pad = 12, PadX = 12, Gap = 8, MaxHeight = 560 })
		pop.which = which
		local body = pop.body
		local H, order = 0, 0
		local conns = {}
		pop.frame.Destroying:Connect(function() for _, c in ipairs(conns) do c:Disconnect() end end)
		local function changed(field, value)
			e[field] = value
			fire("OnOptionsChanged", side, id, e)
		end
		local function add(obj, h)
			order = order + 1
			obj.LayoutOrder = order
			H = H + h + (order > 1 and 8 or 0)
		end
		add(New("TextLabel", {
			Name = "OptTitle", Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = which == "custom" and "Customization" or "Options",
			TextColor3 = Color3.fromRGB(226, 228, 236), TextSize = 15, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left,
		}, body), 22)
		local function card(rows)
			local h = 8
			for _, r in ipairs(rows) do h = h + r[1] end
			local c = New("Frame", { Name = "OptCard", Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = Color3.fromRGB(24, 26, 36), BackgroundTransparency = 0.45, BorderSizePixel = 0 }, body)
			New("UICorner", { CornerRadius = UDim.new(0, 10) }, c)
			local st = Stroke(c, "CardStroke"); st.Transparency = 0.95
			New("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 10) }, c)
			New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, c)
			for i, r in ipairs(rows) do
				local row = New("Frame", { Name = "OptRow", Size = UDim2.new(1, 0, 0, r[1]), BackgroundTransparency = 1, LayoutOrder = i }, c)
				r[2](row)
			end
			add(c, h)
			return c
		end
		local function label(row, text, dim)
			return New("TextLabel", {
				Name = "OptLabel", Size = UDim2.new(0.55, 0, 1, 0), BackgroundTransparency = 1, Text = text,
				TextColor3 = dim and Color3.fromRGB(112, 116, 128) or Color3.fromRGB(205, 208, 218), TextSize = 13, Font = FONT,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, row)
		end
		local function field(row, key, numeric, placeholder)
			local t = Library._invBox(row, placeholder or "", {
				Name = "OptBox", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(96, 22),
				Text = e[key] ~= nil and tostring(e[key]) or "",
			})
			t.FocusLost:Connect(function()
				if numeric then
					local v = tonumber(t.Text)
					if v then v = math.max(0, math.floor(v)) end
					t.Text = v and tostring(v) or ""
					changed(key, v)
				else
					changed(key, t.Text ~= "" and t.Text or nil)
				end
			end)
			return t
		end
		local function valueBtn(row, text)
			local b = New("TextButton", {
				Name = "OptValue", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(130, 22), BackgroundTransparency = 1,
				AutoButtonColor = false, Text = text .. "  ›", TextColor3 = Color3.fromRGB(205, 208, 218), TextSize = 13, Font = FONT, TextXAlignment = Enum.TextXAlignment.Right,
			}, row)
			return b
		end
		local function switch(row, key)
			return Library._invSwitch(row, e[key] == true, function(on) changed(key, on) end)
		end
		-- colour swatch (+ alpha): the picker is built on the first click; values are stored as
		-- "#RRGGBB" + alpha so the options table stays JSON-safe (saved with the config).
		-- value list (Wear / StatTrak / materials / radio): a small glass list parented to the
		-- plate, so opening it does not close the plate; a click outside closes only the list.
		local mini, miniFor
		local function closeMini()
			if not mini then return end
			local m = mini
			mini, miniFor = nil, nil
			SmoothClose(m, 0.1, function() if m.Parent then m:Destroy() end end)
		end
		local function openMini(anchor, values, current, onPick)
			local same = miniFor == anchor
			closeMini()
			if same then return end
			local f = pop.frame
			local g = f.AbsoluteSize.X / 262
			if g <= 0 then g = 1 end
			local w, h = 136, #values * 28 + 8
			local ap = (anchor.AbsolutePosition - f.AbsolutePosition) / g
			local x = math.clamp(ap.X + anchor.AbsoluteSize.X / g - w, 6, 262 - w - 6)
			local y = ap.Y + anchor.AbsoluteSize.Y / g + 4
			if y + h > f.AbsoluteSize.Y / g - 6 and ap.Y - h - 4 > 6 then y = ap.Y - h - 4 end
			local m = New("Frame", {
				Name = "InvValueList", Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = Color3.fromRGB(16, 17, 25),
				BackgroundTransparency = 0.02, BorderSizePixel = 0,
			}, f)
			New("UICorner", { CornerRadius = UDim.new(0, 9) }, m)
			Stroke(m, "ListStroke")
			New("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, m)
			New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, m)
			local accent = Library._invAccent()
			for i, v in ipairs(values) do
				local sel = v == current
				local row = New("TextButton", {
					Name = "ValueOption", LayoutOrder = i, Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = sel and accent or Color3.fromRGB(255, 255, 255),
					BackgroundTransparency = sel and 0.88 or 1, AutoButtonColor = false, Text = "",
				}, m)
				New("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
				New("TextLabel", {
					Name = "ValueText", Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -14, 1, 0), BackgroundTransparency = 1, Text = tostring(v),
					TextColor3 = sel and accent or Color3.fromRGB(214, 217, 226), TextSize = 13, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left,
				}, row)
				if Library._listRowHover then Library._listRowHover(row, row) end
				row.MouseButton1Click:Connect(function()
					closeMini()
					onPick(v)
				end)
			end
			ApplyZIndexLadder(m, f.ZIndex + 60)
			mini, miniFor = m, anchor
			SmoothOpen(m, 0.02, 0.14)
		end
		table.insert(conns, UserInputService.InputBegan:Connect(function(input)
			if mini and IsPrimaryInput(input) then
				local p = GetInputPosition(input)
				if not IsPointInside(mini, p) and not (miniFor and IsPointInside(miniFor, p)) then closeMini() end
			end
		end))
		local pickers = {}
		pop.frame.Destroying:Connect(function()
			for _, pk in ipairs(pickers) do
				pcall(pk.Close)
				if pk.frame then pk.frame:Destroy() end
			end
		end)
		local function swatch(row, prefix, rightX)
			local hex = e[prefix .. "Color"]
			local r, g, b = string.match(type(hex) == "string" and hex or "", "^#?(%x%x)(%x%x)(%x%x)$")
			local sw = New("ImageButton", {
				Name = "OptSwatch", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -rightX, 0.5, 0), Size = UDim2.fromOffset(16, 16),
				BackgroundColor3 = r and Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)) or Color3.fromRGB(255, 255, 255),
				BorderSizePixel = 0, Image = "", AutoButtonColor = false,
			}, row)
			New("UICorner", { CornerRadius = UDim.new(0, 4) }, sw)
			Stroke(sw, "OptSwatchStroke")
			local picker
			sw.MouseButton1Click:Connect(function()
				if picker or not Library._colorPicker or (Library._swiped and Library._swiped()) then return end
				picker = Library._colorPicker(sw, sw.BackgroundColor3, function(c, a)
					sw.BackgroundColor3 = c
					e[prefix .. "Color"] = ColorToHex(c)
					if type(a) == "number" then e[prefix .. "Alpha"] = math.floor(a * 100 + 0.5) / 100 end
					fire("OnOptionsChanged", side, id, e)
				end)
				if type(e[prefix .. "Alpha"]) == "number" then picker.SetAlpha(e[prefix .. "Alpha"]) end
				table.insert(pickers, picker)
				picker.Toggle()
			end)
			return sw
		end
		if which == "custom" then
			local radios = o.RadioCommands or { "Default", "Classic", "Silent", "Custom" }
			card({
				{ 30, function(row)
					label(row, "Radio Commands")
					local b = valueBtn(row, e.radio or radios[1])
					b.MouseButton1Click:Connect(function()
						openMini(b, radios, e.radio or radios[1], function(nextV)
							b.Text = nextV .. "  ›"
							changed("radio", nextV)
						end)
					end)
				end },
				{ 30, function(row) label(row, "Cloth Physics"); switch(row, "cloth") end },
				{ 30, function(row) label(row, "Remove Sleeves"); switch(row, "sleeves") end },
			})
			pop.open(H)
			return
		end
		card({
			{ 30, function(row) label(row, "Name Tag"); field(row, "name", false, "") end },
			{ 30, function(row) label(row, "Seed"); field(row, "seed", true, "0") end },
		})
		-- wear: preset name (click = preset list) + float bar with a marker (drag)
		local wearBtn, marker, floatText
		local function wearName(f)
			for _, w in ipairs(D.wear) do if f <= w[1] then return w[2] end end
			return D.wear[#D.wear][2]
		end
		local wearFill
		local function setFloat(f, commit)
			f = math.clamp(math.floor(f * 1000 + 0.5) / 1000, 0, 1)
			e.float = f
			marker.Position = UDim2.new(f, 0, 0, 1)
			wearFill.Size = UDim2.new(f, 0, 1, 0)
			floatText.AnchorPoint = Vector2.new(f, 0)
			floatText.Position = UDim2.new(f, 0, 0, 0)
			wearBtn.Text = wearName(f) .. "  ›"
			floatText.Text = string.format("%.3f", f)
			if commit then fire("OnOptionsChanged", side, id, e) end
		end
		card({
			{ 30, function(row)
				label(row, "Wear")
				wearBtn = valueBtn(row, "Factory New")
				wearBtn.Size = UDim2.fromOffset(120, 22)
				wearBtn.MouseButton1Click:Connect(function()
					local names = {}
					for _, w in ipairs(D.wear) do table.insert(names, w[2]) end
					openMini(wearBtn, names, wearName(e.float or 0), function(v)
						for _, w in ipairs(D.wear) do if w[2] == v then setFloat(w[3], true) end end
					end)
				end)
			end },
			{ 34, function(row)
				-- library slider colours: neutral track + accent fill, caret marker on top
				local track = New("Frame", {
					Name = "WearBar", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -7), Size = UDim2.new(1, 0, 0, 5),
					BackgroundColor3 = Color3.fromRGB(40, 42, 54), BorderSizePixel = 0,
				}, row)
				New("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
				wearFill = New("Frame", { Name = "WearFill", Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Library._invAccent(), BorderSizePixel = 0 }, track)
				New("UICorner", { CornerRadius = UDim.new(1, 0) }, wearFill)
				floatText = New("TextLabel", {
					Name = "FloatValue", Size = UDim2.fromOffset(44, 13), BackgroundTransparency = 1, Text = "", ZIndex = 2,
					TextColor3 = Color3.fromRGB(150, 154, 166), TextSize = 11, Font = FONT,
				}, row)
				-- caret: a small down-pointing triangle (5 rows, 9..1 px wide) sitting on the bar
				marker = New("Frame", {
					Name = "WearMarker", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0, 0, 0, 1), Size = UDim2.fromOffset(9, 5),
					BackgroundTransparency = 1,
				}, track)
				for i = 1, 5 do
					New("Frame", {
						Name = "CaretRow" .. i, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, i - 1), Size = UDim2.fromOffset(11 - i * 2, 1),
						BackgroundColor3 = Color3.fromRGB(236, 238, 244), BorderSizePixel = 0,
					}, marker)
				end
				local hit = New("TextButton", { Name = "WearHit", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, row)
				local dragging = false
				local function at(x)
					local a, w = track.AbsolutePosition.X, track.AbsoluteSize.X
					if w > 0 then setFloat((x - a) / w, false) end
				end
				hit.InputBegan:Connect(function(input)
					if IsPrimaryInput(input) then dragging = true; at(input.Position.X) end
				end)
				table.insert(conns, UserInputService.InputChanged:Connect(function(input)
					if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then at(input.Position.X) end
				end))
				table.insert(conns, UserInputService.InputEnded:Connect(function(input)
					if dragging and IsPrimaryInput(input) then dragging = false; fire("OnOptionsChanged", side, id, e) end
				end))
			end },
		})
		setFloat(e.float or 0, false)
		local stBox
		card({
			{ 30, function(row)
				label(row, "StatTrak™")
				local stBtn = valueBtn(row, e.stattrak and "Enabled" or "None")
				stBtn.MouseButton1Click:Connect(function()
					openMini(stBtn, { "None", "Enabled" }, e.stattrak and "Enabled" or "None", function(v)
						local on = v == "Enabled"
						stBtn.Text = v .. "  ›"
						changed("stattrak", on)
						if stBox then stBox.TextTransparency = on and 0 or 0.55 end
					end)
				end)
			end },
			{ 30, function(row)
				label(row, "Value", true)
				stBox = field(row, "stcount", true, "0")
				stBox.TextTransparency = e.stattrak and 0 or 0.55
			end },
		})
		if not S.cats[cur.item.category] or not S.cats[cur.item.category].noStickers then
			-- same round 24px slots as the picker row (5, agents: 3 patches), evenly spaced, centred
			local nS = cur.cat.id == "agent" and 3 or (o.StickerSlots or 5)
			card({
				{ 38, function(row)
					label(row, cur.cat.id == "agent" and "Patches" or "Stickers")
					local holder = New("Frame", {
						Name = "StickerSlots", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(nS * 30 - 6, 24), BackgroundTransparency = 1,
					}, row)
					local stickers = type(e.stickers) == "table" and e.stickers or {}
					for i = 1, nS do
						local name = stickers[tostring(i)]
						local b = New("TextButton", {
							Name = "AddSticker" .. i, Position = UDim2.fromOffset((i - 1) * 30, 0), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = Color3.fromRGB(44, 47, 60),
							BackgroundTransparency = 0.25, AutoButtonColor = false, Text = name and string.upper(string.sub(name, 1, 1)) or "+",
							TextColor3 = name and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 154, 166), TextSize = name and 11 or 14, Font = FONT_BOLD,
						}, holder)
						New("UICorner", { CornerRadius = UDim.new(1, 0) }, b)
						if name then
							for _, x in ipairs(S.stickers) do if x.name == name then b.BackgroundColor3 = Library._rarityColor(x.rarity); b.BackgroundTransparency = 0.15 end end
						end
						b.MouseButton1Click:Connect(function()
							pop.close()
							S.setMode("stickers", i)
						end)
					end
				end },
			})
		end
		-- model materials (Model / Overlay / Arms / Overlay): click the value = material list
		local MATS = type(o.Materials) == "table" and #o.Materials > 0 and o.Materials or { "Disabled", "Default", "Glass", "Flat", "Wireframe", "Metallic", "Neon" }
		local function matRow(text, prefix)
			return { 30, function(row)
				label(row, text)
				local key = prefix .. "Material"
				local b = valueBtn(row, e[key] or MATS[1])
				b.Size = UDim2.fromOffset(86, 22)
				local sw = swatch(row, prefix, 94)
				local function dim() sw.BackgroundTransparency = (e[key] and e[key] ~= MATS[1]) and 0 or 0.65 end
				dim()
				b.MouseButton1Click:Connect(function()
					openMini(b, MATS, e[key] or MATS[1], function(nv)
						b.Text = nv .. "  ›"
						changed(key, nv ~= MATS[1] and nv or nil)
						dim()
					end)
				end)
			end }
		end
		card({ matRow("Model", "model"), matRow("Overlay", "overlay"), matRow("Arms", "arms"), matRow("Overlay", "overlay2") })
		card({
			{ 30, function(row) label(row, "Colorize StatTrak™"); switch(row, "colorize"); swatch(row, "colorize", 42) end },
			{ 30, function(row) label(row, "Glow"); switch(row, "glow"); swatch(row, "glow", 42) end },
			{ 30, function(row) label(row, "Cloth Physics"); switch(row, "cloth") end },
			{ 30, function(row) label(row, "Remove Sleeves"); switch(row, "sleeves") end },
		})
		-- Apply / Reset
		local foot = New("Frame", { Name = "OptFooter", Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, body)
		add(foot, 30)
		local function footBtn(text, x, accent, onClick)
			local b = New("TextButton", {
				Name = "Opt" .. text, Position = UDim2.new(x, x > 0 and 4 or 0, 0, 0), Size = UDim2.new(0.5, -4, 1, 0),
				BackgroundColor3 = accent and Library._invAccent() or Color3.fromRGB(32, 35, 47), BackgroundTransparency = accent and 0 or 0.2,
				AutoButtonColor = false, Text = text, TextColor3 = accent and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(214, 217, 226), TextSize = 13, Font = FONT,
			}, foot)
			New("UICorner", { CornerRadius = UDim.new(0, 7) }, b)
			b.MouseButton1Down:Connect(function() Library._anim.press(b, true) end)
			b.MouseButton1Up:Connect(function() Library._anim.press(b, false) end)
			b.MouseLeave:Connect(function() Library._anim.press(b, false) end)
			b.MouseButton1Click:Connect(onClick)
			return b
		end
		footBtn("Reset", 0, false, function()
			local keep = e.skin
			for k in pairs(e) do e[k] = nil end
			e.skin = keep
			fire("OnOptionsChanged", side, id, e)
			pop.close()
			task.delay(0.15, function() S.openOptions(anchor, which) end)
		end)
		footBtn("Apply", 0.5, true, function()
			fire("OnApply", side, id, e)
			pop.close()
			S.render(false)
		end)
		pop.open(H)
	end

	-- -------------------------------------------------------------- item viewer (full screen)
	-- The expand button of the skin picker opens ONE item large for inspection (NL "full screen"):
	-- glass overlay (92% of the screen, fade + scale), name / skin / rarity line on top, CT/T
	-- switch top-left, a big stage in the middle, the skin strip under it, Options on the right.
	-- Stage: the item / skin image (rbxassetid) shown large, else a clean stage (the name large and
	-- faint); no 3D model. One rarity indicator: the thin line under the title. Strip: skins (agents / medals /
	-- music: the other items of the category; Stickers tab: stickers for the active slot),
	-- search, < > (also Left / Right keys). ESC / x / Close / a click outside close it.
	function S.vwColor(c)
		if typeof(c) == "Color3" then return c end
		if type(c) == "string" then
			local r, g, b = string.match(c, "^#?(%x%x)(%x%x)(%x%x)$")
			if r then return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)) end
		end
		return nil
	end
