		hit.Size = UDim2.fromOffset(66, 128)
		hit.ZIndex = 0
		hit.MouseEnter:Connect(function() M.hover = true end)
		hit.MouseLeave:Connect(function() M.hover = nil end)
		hit.Parent = main
		table.insert(M.parts, hit)
		M.typeT = 0
		local function place(t, dt)
			local still = Library._fxStatic()
			local dy = hopNow()
			local waving = M.hover == true and not still
			if M.surp then M.surp = M.surp - dt; if M.surp <= 0 then M.surp = nil end end
			local tw = not still and not waving and twitching(dt)
			for _, i in ipairs({ body, ear, wave }) do at(i, mb, AX, AY, 0, dy) end
			body.Visible, ear.Visible, wave.Visible = not waving and not tw, tw and not waving, waving
			at(blink, mk, AX, AY, 0, dy)
			at(wide, mw, AX, AY, 0, dy)
			at(hat, mh, AX, AY, 0, dy)
			hat.Visible = hatOn()
			wide.Visible = M.surp ~= nil and not still
			blink.Visible = not still and not wide.Visible and blinking(dt)
			at(tail, mt, AX, AY, 0, dy * 0.5)
			tail.Rotation = still and 0 or math.sin(t * math.pi * 2 / 2.5) * 6
			at(hit, { x = -36, y = -146 }, AX, AY, 0, dy)
			at(front, mf, AX, AY)
			at(frontW, mf, AX, AY)
			at(t2, m2, AX, AY)
			at(t3, m3, AX, AY)
			front.Visible, frontW.Visible = not waving, waving
			-- typing: frames 1-2-1-3 at ~4 fps; paused while waving / static
			local f = 0
			if not still and not waving then
				M.typeT = M.typeT + dt
				f = ({ 0, 1, 0, 2 })[math.floor(M.typeT * 4) % 4 + 1]
			end
			t2.Visible, t3.Visible = f == 1, f == 2
		end
		place(0, 0)
		hit.MouseButton1Click:Connect(function() react(hit, "left") end)
		Library._fxSet("mascot", function(dt, t) place(t, dt) end)
	elseif pose == "Sit" then
		-- anchor = seat centre on the window's top edge (2 px down so the hem covers the border)
		local AX, AY = UDim.new(0.72, 0), UDim.new(0, 2)
		local body, mb = img("sit_body", 0, true)
		local blink, mk = img("sit_blink", 0)
		local legs, ml = img("sit_legs", 1, false, back)
		M.jig = 0
		local function place(t, dt)
			local still = Library._fxStatic()
			-- breathing (body stretches up from the seat ~1 %) + belly jiggle on hover / click
			if M.hover or M.hop then M.jig = math.min(1, M.jig + dt * 4) else M.jig = math.max(0, M.jig - dt * 2) end
			local s = still and 1 or 1 + 0.012 * math.sin(t * math.pi * 2 / 3) + 0.02 * M.jig * math.sin(t * 16)
			local dy = still and 0 or hopNow()
			local grow = mb.h * (s - 1)
			body.Size = UDim2.fromOffset(mb.w * (1 + (s - 1) * 0.5), mb.h * s)
			at(body, mb, AX, AY, -mb.w * (s - 1) * 0.25, dy - grow)
			at(blink, mk, AX, AY, 0, dy + (mk.y - (mb.y + mb.h)) * (s - 1))
			at(legs, ml, AX, AY, 0, dy * 0.5)
			blink.Visible = not still and blinking(dt)
		end
		place(0, 0)
		blink.Visible = false
		body.MouseButton1Click:Connect(function() react(body, "left") end)
		Library._fxSet("mascot", function(dt, t) place(t, dt) end)
	elseif fem then
		-- Peeks over the window's top edge (two spots), hands on the edge; hover near it to call.
		local mh = meta.femboy_peek_head
		local CW, CH = mh.w + 8, -mh.y + 18
		local clip = Library._fxFrame("MascotPeekClip", main, { BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 0, AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(CW, CH) })
		table.insert(M.parts, clip)
		local head = img("peek_head", 0, true, clip)
		local ear = img("peek_ear", 0, false, clip)
		local blink, mk = img("peek_blink", 0, false, clip)
		local wide, mw = img("peek_wide", 0, false, clip)
		local hat, mht = img("peek_hat", 0, false, clip)
		local ml, mml = img("peek_hand_l", 1, false, back)
		local mr, mmr = img("peek_hand_r", 1, false, back)
		local wave, mwv = img("peek_wave", 1, false, back)
		M.side, M.p, M.goal, M.next = "right", static and 1 or 0, static and 1 or 0, 2
		local AY0 = UDim.new(0, 0)
		local function place(t, dt)
			local still = Library._fxStatic()
			local ease = M.p * M.p * (3 - 2 * M.p)
			local AX = UDim.new(M.side == "right" and 0.74 or 0.3, 0)
			local hop = hopNow()
			local sink = (1 - ease) * (CH + 4)
			if M.surp then M.surp = M.surp - dt; if M.surp <= 0 then M.surp = nil end end
			clip.Position = UDim2.new(AX.Scale, 0, 0, 0)
			local cx, cy = UDim.new(0, CW / 2), UDim.new(0, CH)
			local tw = ease > 0.9 and not still and twitching(dt)
			at(head, mh, cx, cy, 0, sink + hop)
			at(ear, mh, cx, cy, 0, sink + hop)
			head.ImageTransparency = tw and 1 or 0
			ear.Visible = tw
			at(blink, mk, cx, cy, 0, sink + hop)
			at(wide, mw, cx, cy, 0, sink + hop)
			at(hat, mht, cx, cy, 0, sink + hop)
			hat.Visible = hatOn()
			wide.Visible = M.surp ~= nil and not still
			blink.Visible = ease > 0.5 and not still and not wide.Visible and blinking(dt)
			local handY = (1 - ease) * 8 + hop * 0.3
			at(ml, mml, AX, AY0, 0, handY)
			at(mr, mmr, AX, AY0, 0, handY)
			at(wave, mwv, AX, AY0, 0, handY)
			local waving = M.hover == true and ease > 0.95 and not still
			ml.ImageTransparency, mr.ImageTransparency = 1 - ease, 1 - ease
			mr.Visible, wave.Visible = not waving, waving
			wave.Rotation = waving and math.sin(t * 10) * 14 or 0
		end
		place(0, 0)
		head.MouseButton1Click:Connect(function() react(head, M.side == "right" and "left" or "right") end)
		table.insert(M.parts, UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement or not main.Visible then return end
			local x, y = input.Position.X, input.Position.Y
			local ap, as = main.AbsolutePosition, main.AbsoluteSize
			if math.abs(y - ap.Y) < 30 and x > ap.X and x < ap.X + as.X then
				local side = (x - ap.X) / math.max(1, as.X) > 0.52 and "right" or "left"
				if M.side ~= side and M.p > 0.05 then M.goal = 0 else M.side = side; M.goal = 1; M.hold = 2.5 end
			end
		end))
		Library._fxSet("mascot", function(dt, t)
			if Library._fxStatic() then M.p = 1; place(t, dt) return end
			if M.goal == 0 and M.p <= 0 then
				M.next = M.next - dt
				if M.next <= 0 then M.next = 12; M.side = (M.side == "right") and "left" or "right"; M.goal = 1; M.hold = 3 end
			elseif M.goal == 1 and M.p >= 1 then
				M.hold = (M.hold or 3) - dt
				if M.hover then M.hold = math.max(M.hold, 1) end
				if M.hold <= 0 then M.goal = 0 end
			end
			local speed = dt / math.max(0.2, 0.55 * (Library._animScale or 1))
			if M.p < M.goal then M.p = math.min(M.goal, M.p + speed) elseif M.p > M.goal then M.p = math.max(M.goal, M.p - speed) end
			place(t, dt)
		end)
	else
		-- Santa peeks around a side edge (head tilted), round mittens gripping that edge.
		local head, mh = img("peek_head", 0, true)
		head.AnchorPoint = Vector2.new(0.5, 0.5)
		local blink, mk = img("peek_blink", 0, false, head)
		blink.Position = UDim2.fromOffset(mk.x - mh.x, mk.y - mh.y)
		local r1, mr = img("mitten_r", 1, false, back)
		local r2 = img("mitten_r", 1, false, back)
		local l1, mlm = img("mitten_l", 1, false, back)
		local l2 = img("mitten_l", 1, false, back)
		local wave = img("wave", 1, false, back)
		wave.AnchorPoint = Vector2.new(0.5, 0.5)
		M.side, M.p, M.goal, M.next = "right", static and 1 or 0, static and 1 or 0, 2
		local function place(t, dt)
			local ease = M.p * M.p * (3 - 2 * M.p)
			local right = M.side == "right"
			local s = right and 1 or -1
			local hop = hopNow()
			head.Position = UDim2.new(right and 1 or 0, s * (-58 + 70 * ease), 0.34, hop)
			head.Rotation = right and 0 or 28
			blink.Visible = ease > 0.5 and not Library._fxStatic() and blinking(dt)
			local EX = UDim.new(right and 1 or 0, s * -14 * (1 - ease))
			local m1, m2, mm = r1, r2, mr
			if not right then m1, m2, mm = l1, l2, mlm end
			at(m1, mm, EX, UDim.new(0.34, 0), 0, -18 + hop * 0.3)
			at(m2, mm, EX, UDim.new(0.34, 0), 0, 32 + hop * 0.3)
			r1.Visible, r2.Visible, l1.Visible, l2.Visible = right, right, not right, not right
			m1.ImageTransparency, m2.ImageTransparency = 1 - ease, 1 - ease
			local waving = M.hover == true and ease > 0.95 and not Library._fxStatic()
			if waving then m1.Visible = false end
			wave.Visible = waving
			wave.Position = UDim2.new(right and 1 or 0, s * 20, 0.34, -44 + hop * 0.3)
			wave.Rotation = s * 20 + (waving and math.sin(t * 10) * 14 or 0)
		end
		place(0, 0)
		head.MouseButton1Click:Connect(function() react(head, "above") end)
		-- Hover near either side edge: peek out there.
		table.insert(M.parts, UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement or not main.Visible then return end
			local x, y = input.Position.X, input.Position.Y
			local ap, as = main.AbsolutePosition, main.AbsoluteSize
			local inY = y > ap.Y + as.Y * 0.15 and y < ap.Y + as.Y * 0.6
			if inY and math.abs(x - (ap.X + as.X)) < 36 then
				if M.side ~= "right" and M.p > 0.05 then M.goal = 0 else M.side = "right"; M.goal = 1; M.hold = 2.5 end
			elseif inY and math.abs(x - ap.X) < 36 then
				if M.side ~= "left" and M.p > 0.05 then M.goal = 0 else M.side = "left"; M.goal = 1; M.hold = 2.5 end
			end
		end))
		Library._fxSet("mascot", function(dt, t)
			if Library._fxStatic() then M.p = 1; place(t, dt) return end
			-- Every ~12 s: slide out (alternating sides), stay ~3 s, slide back in.
			if M.goal == 0 and M.p <= 0 then
				M.next = M.next - dt
				if M.next <= 0 then M.next = 12; M.side = (M.side == "right") and "left" or "right"; M.goal = 1; M.hold = 3 end
			elseif M.goal == 1 and M.p >= 1 then
				M.hold = (M.hold or 3) - dt
				if M.hover then M.hold = math.max(M.hold, 1) end
				if M.hold <= 0 then M.goal = 0 end
			end
			local speed = dt / math.max(0.2, 0.55 * (Library._animScale or 1))
			if M.p < M.goal then M.p = math.min(M.goal, M.p + speed) elseif M.p > M.goal then M.p = math.max(M.goal, M.p - speed) end
			place(t, dt)
		end)
	end
	return true
end
