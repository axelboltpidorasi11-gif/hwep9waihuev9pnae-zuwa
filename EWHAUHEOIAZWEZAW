function Library:AddWindow(hubTitle, hubImage, gameTitle)
	hubTitle = tostring(hubTitle or "Interface")
	hubImage = tostring(hubImage or "")
	gameTitle = tostring(gameTitle or "My Game")
	local daysLeft = tonumber(Library.DaysLeft) or "Lifetime"

	_windowConfigCounter = _windowConfigCounter + 1
	local windowConfigId = tostring(_windowConfigCounter)
	local _registeredElements = {}
	local configKeyCounts = {}
	-- tabName: the owning tab (passed by AddTab's wrapper), used by the
	-- per-group element values (Library._gvInstall).
	local function RegisterConfigElement(prefix, label, object, tabName)
		local base = tostring(prefix) .. tostring(label or "item")
		local count = (configKeyCounts[base] or 0) + 1
		configKeyCounts[base] = count
		local entry = {key = base .. "#" .. count, obj = object, tab = tabName, label = tostring(label or "item")}
		table.insert(_registeredElements, entry)
		-- Remember the built value so loading a preset that lacks this key
		-- resets it instead of leaving the previous preset's value behind.
		task.defer(function()
			if type(object) == "table" and type(object.Get) == "function" then
				local okGet, value = pcall(function() return object:Get() end)
				if okGet then entry.baseline = SerializeValue(value) end
			end
		end)
	end

	local mainColor = Library._themes.Dark.accent
	Library._accent = mainColor
	local tabs = {}
	local activeTabIndex = nil
	local tabOrder = 0
	local WindowObj = {}
	-- Config extras: state that is not an element value (hotkeys, overlay
	-- positions). key -> { get = fn() -> json value, set = fn(value) }, saved
	-- as "__extra_<key>" next to the element values. A field, not a local:
	-- AddWindow is close to the register limit.
	WindowObj._configExtras = {}
	Library._gvInstall(WindowObj, _registeredElements, function() return mainColor end)

	-- Slider readouts: obj:SetDisplay(fn) lets a slider show text instead of
	-- its number (fn(value) -> string, or nil for the normal number), e.g.
	-- "auto" at 0. Keyed by the readout label.
	WindowObj._sliderDisplay = setmetatable({}, { __mode = "k" })
	WindowObj._sliderText = function(label, value, suffix)
