		local function doDelete()
			local configData = {}
			for _, entry in ipairs(_registeredElements) do
				local ok, val = pcall(function() return entry.obj:Get() end)
				if ok then
					local s = SerializeValue(val)
					if s ~= nil then configData[entry.key] = s end
				end
			end
