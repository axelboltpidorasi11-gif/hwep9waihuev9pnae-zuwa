	-- Frost: Roblox blurs only the 3D world, never the interface, so the menu
	-- under a glass popup would stay sharp and readable. While a popup is open,
	-- the text and icons of the menu under it fade into the glass instead,
	-- which reads like the blur NL has there.
	Library._frostLists = setmetatable({}, { __mode = "k" })
	Library._frost = function(frame, on)
		if on then
			if frame:GetAttribute("Frosting") or not MainFrame.Visible then return end
			frame:SetAttribute("Frosting", true)
			local pos, size = frame.AbsolutePosition, frame.AbsoluteSize
			local x0, y0, x1, y1 = pos.X, pos.Y, pos.X + size.X, pos.Y + size.Y
			local list = {}
			for _, d in ipairs(MainFrame:GetDescendants()) do
				local prop
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then prop = "TextTransparency"
				elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then prop = "ImageTransparency" end
				if prop and d.Visible and d.ZIndex < frame.ZIndex and not d:IsDescendantOf(frame) then
					local p, s2 = d.AbsolutePosition, d.AbsoluteSize
					if s2.X > 0 and p.X < x1 and p.X + s2.X > x0 and p.Y < y1 and p.Y + s2.Y > y0 then
						local n = d:GetAttribute("FrostN") or 0
						if n == 0 then d:SetAttribute("FrostBase", d[prop]) end
						d:SetAttribute("FrostN", n + 1)
						Tween(d, { [prop] = math.max(d:GetAttribute("FrostBase") or 0, 0.88) }, 0.16)
						table.insert(list, { d, prop })
					end
				end
			end
			Library._frostLists[frame] = list
			-- Closed some other way (instant close): clear the frost too.
			local conn
			conn = frame:GetPropertyChangedSignal("Visible"):Connect(function()
				if not frame.Visible then
					conn:Disconnect()
					if frame:GetAttribute("Frosting") then Library._frost(frame, false) end
				end
			end)
		else
			frame:SetAttribute("Frosting", nil)
			local list = Library._frostLists[frame]
			Library._frostLists[frame] = nil
			for _, item in ipairs(list or {}) do
				local d, prop = item[1], item[2]
				if d.Parent then
					local n = (d:GetAttribute("FrostN") or 1) - 1
					if n <= 0 then
						local base = d:GetAttribute("FrostBase")
						d:SetAttribute("FrostN", nil)
						d:SetAttribute("FrostBase", nil)
						if type(base) == "number" then Tween(d, { [prop] = base }, 0.16) end
					else
						d:SetAttribute("FrostN", n)
					end
				end
			end
		end
	end
	Library._popupGlass = function(frame)
		WindowObj._glassPlate(frame)
		if not frame:GetAttribute("PopupStyled") then
			frame:SetAttribute("PopupStyled", true)
			-- One look for every popup (plates, lists, pickers, menus): the
			-- NL plate colour, 10px corners, a hairline and a soft shadow.
			-- Same base as the window, so plates read as the same glass.
			-- NL option-list colour: a step darker than the cards, so it
			-- reads as on top without a heavy edge.
			frame.BackgroundColor3 = Color3.fromRGB(11, 12, 18)
			local corner = frame:FindFirstChildOfClass("UICorner") or New("UICorner", {}, frame)
			corner.CornerRadius = UDim.new(0, 12)
			-- Glass edge: the outline is brightest along the top and fades down
			-- the sides, like light catching the plate.
			local outline = frame:FindFirstChildOfClass("UIStroke") or Stroke(frame)
			outline.Transparency = 0.93
			if not outline:FindFirstChild("GlassEdge") then
				local edge = Instance.new("UIGradient")
				edge.Name = "GlassEdge"
				edge.Rotation = 90
				edge.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0),
				})
				edge.Parent = outline
			end
			-- No drop shadow: filled shadow layers under a see-through popup
			-- made some popups darker than others.
			for _, node in ipairs(frame:GetChildren()) do
				if node:GetAttribute("IsShadowLayer") then
					node:SetAttribute("ShadowAlpha", 1)
					if node:IsA("GuiObject") then node.BackgroundTransparency = 1 end
				end
			end
			-- (No shadow: a dark halo made popups stand out from the menu.)
		end
		-- Popups sit over live rows (toggle knobs, text): keep them nearly solid so
		-- nothing ghosts through (there is no real blur behind UI).
		return math.min(WindowObj._plateAlpha, 0.04)
	end
	-- Shared option-list rows (dropdowns, multi lists, menus): Library._sel metrics
	-- (34px / phone 46, r8, 13px, left pad 12); the single pick shows accent text + a check
	-- on the right, a multi pick a bare tick on the right (unticked entries dimmed).
	Library._listRowStyle = function(row, label, check, multi)
		local S = Library._sel
		row.Size = UDim2.new(1, 0, 0, S.h())
		local c = row:FindFirstChildOfClass("UICorner")
		if c then c.CornerRadius = UDim.new(0, S.radius) end
		row:SetAttribute("Multi", multi and true or nil)
		if label then
			label.Position = UDim2.new(0, S.padL, 0, 0)
			label.Size = UDim2.new(1, -38, 1, 0)
			label.TextSize = S.textSize
			Library._setC(label, "TextColor3", S.unselText)
		end
		if check then
			if multi then
				local box = row:FindFirstChild("CheckBox") or Instance.new("Frame")
				box.Name = "CheckBox"
				box.AnchorPoint = Vector2.new(1, 0.5)
				box.Position = UDim2.new(1, -10, 0.5, 0)
				box.Size = UDim2.fromOffset(14, 14)
				box.BackgroundColor3 = S.white
				box.BackgroundTransparency = 1 -- NL multi lists: a bare tick, no box
				box.BorderSizePixel = 0
				box.ZIndex = math.max(check.ZIndex - 1, 1)
				box.Parent = row
				check.Parent = box
				check.AnchorPoint = Vector2.new(0.5, 0.5)
				check.Position = UDim2.fromScale(0.5, 0.5)
				check.Size = UDim2.fromOffset(12, 12)
			else
				check.AnchorPoint = Vector2.new(1, 0.5)
				check.Position = UDim2.new(1, -10, 0.5, 0)
				check.Size = UDim2.fromOffset(14, 14)
			end
		end
	end
	Library._listRowState = function(row, label, check, isSelected, _accent)
		-- ONE neutral look for single and multi lists: picked = bright text + white tick on the
		-- right + faint white fill; unpicked = soft text, no fill (no accent anywhere).
		local S = Library._sel
		row:SetAttribute("Sel", isSelected or nil)
		Library._setC(row, "BackgroundColor3", S.white)
		row.BackgroundTransparency = isSelected and S.selBgAlpha or 1
		if check then
			local was = check.Visible
			check.Visible = isSelected and true or false
			if check:IsA("ImageLabel") or check:IsA("ImageButton") then Library._setC(check, "ImageColor3", S.tick) end
			if isSelected and not was then Library._anim.tick(check) end
		end
		if label then Library._setC(label, "TextColor3", isSelected and S.selText or S.unselText) end
	end
	-- Same look for option rows that are one TextButton (text + padding + check).
	Library._optBtnStyle = function(btn, multi)
		local S = Library._sel
		btn.Size = UDim2.new(1, 0, 0, S.h())
		btn.TextSize = S.textSize
		local c = btn:FindFirstChildOfClass("UICorner")
		if c then c.CornerRadius = UDim.new(0, S.radius) end
		local pad = btn:FindFirstChildOfClass("UIPadding")
		if pad then
			pad.PaddingLeft = UDim.new(0, S.padL)
			pad.PaddingRight = UDim.new(0, 34)
		end
		btn:SetAttribute("Multi", multi and true or nil)
		local check = btn:FindFirstChild("SelectedCheck") or (btn:FindFirstChild("CheckBox") and btn.CheckBox:FindFirstChild("SelectedCheck"))
		if not check then return end
		if multi then
			local box = btn:FindFirstChild("CheckBox")
			if not box then
				box = Instance.new("Frame")
				box.Name = "CheckBox"
				box.BackgroundColor3 = S.white
				box.BackgroundTransparency = 1
				box.BorderSizePixel = 0
				box.ZIndex = math.max(check.ZIndex - 1, 1)
				box.Parent = btn
			end
			box.AnchorPoint = Vector2.new(1, 0.5)
			box.Position = UDim2.new(1, 24, 0.5, 0) -- right pad 34 -> 10px from the edge
			box.Size = UDim2.fromOffset(14, 14)
			check.Parent = box
			check.AnchorPoint = Vector2.new(0.5, 0.5)
			check.Position = UDim2.fromScale(0.5, 0.5)
			check.Size = UDim2.fromOffset(12, 12)
		else
			check.AnchorPoint = Vector2.new(1, 0.5)
			check.Position = UDim2.new(1, 24, 0.5, 0) -- right pad 34 -> 10px from the edge
			check.Size = UDim2.fromOffset(14, 14)
		end
	end
	Library._optBtnState = function(btn, on, _accent)
		local S = Library._sel
		btn:SetAttribute("Sel", on or nil)
		local box = btn:FindFirstChild("CheckBox")
		local check = box and box:FindFirstChild("SelectedCheck") or btn:FindFirstChild("SelectedCheck")
		if check then
			local was = check.Visible
			check.Visible = on and true or false
			if check:IsA("ImageLabel") or check:IsA("ImageButton") then Library._setC(check, "ImageColor3", S.tick) end
			if on and not was then Library._anim.tick(check) end
		end
		Library._setC(btn, "BackgroundColor3", S.white)
		btn.BackgroundTransparency = on and S.selBgAlpha or 1
		Library._setC(btn, "TextColor3", on and S.selText or S.unselText)
	end
	-- List hover: one "HoverSlab" per list glides between the rows under the pointer (fast, Quint
	-- Out) instead of each row fading its own fill; it fades in / out at the list's edges and
	-- hides on scroll. Placed in the list's parent in scale units (UIScale / popup scale safe),
	-- clamped to the visible part of the list. Rows outside a laid-out list keep the old tint.
	Library._slabs = setmetatable({}, { __mode = "k" })
	Library._slabRow = setmetatable({}, { __mode = "k" })
	Library._slabFor = function(row)
		local list = row.Parent
		local host = list and list.Parent
		if not (list and host and host:IsA("GuiObject") and list:IsA("GuiObject") and list:FindFirstChildWhichIsA("UIGridStyleLayout"))
			or host:FindFirstChildWhichIsA("UIGridStyleLayout") or Library._perfMode == "max" then return nil end
		local s = Library._slabs[list]
		if s and s.Parent == host then return s, list end
		s = Instance.new("Frame")
		s.Name = "HoverSlab"; s.BorderSizePixel = 0; s.Active = false
		s.BackgroundColor3 = Color3.fromRGB(255, 255, 255); s.BackgroundTransparency = 1
		s.ZIndex = math.max(list.ZIndex - 1, 1); s.Visible = false
		do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = s end
		s.Parent = host
		Library._slabs[list] = s
		-- Popup closed: drop the slab (and any fade snapshot of it, so a reopen starts clear).
		local function reset()
			if host.Visible and list.Visible then return end
			s.Visible = false; s.BackgroundTransparency = 1; Library._slabRow[s] = nil
			for k in pairs(s:GetAttributes()) do if k:sub(1, 3) == "FB_" then s:SetAttribute(k, nil) end end
		end
		host:GetPropertyChangedSignal("Visible"):Connect(reset)
		list:GetPropertyChangedSignal("Visible"):Connect(reset)
		if list:IsA("ScrollingFrame") then
			list:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
				if s.Visible then Library._slabRow[s] = nil; Tween(s, { BackgroundTransparency = 1 }, 0.08) end
			end)
		end
		return s, list
	end
	Library._slabPlace = function(s, list, row, glide)
		local hp, hs = s.Parent.AbsolutePosition, s.Parent.AbsoluteSize
		if hs.X < 1 or hs.Y < 1 then return false end
		local lp, ls = list.AbsolutePosition, list.AbsoluteSize
		local rp, rs = row.AbsolutePosition, row.AbsoluteSize
		local y0, y1 = math.max(rp.Y, lp.Y), math.min(rp.Y + rs.Y, lp.Y + ls.Y)
		if y1 - y0 < 4 then return false end
		local pos = UDim2.fromScale((rp.X - hp.X) / hs.X, (y0 - hp.Y) / hs.Y)
		local size = UDim2.fromScale(rs.X / hs.X, (y1 - y0) / hs.Y)
		if glide then Library._anim.move(s, { Position = pos, Size = size }, "fast") else Tween(s, { Position = pos, Size = size }, 0) end
		return true
	end
	Library._listRowHover = function(row, btn)
		btn.MouseEnter:Connect(function() if Library._hoverBlocked(btn) then return end
			local s, list = Library._slabFor(row)
			if s and Library._slabPlace(s, list, row, s.Visible and s.BackgroundTransparency < 0.99) then
				Library._slabRow[s] = row
				s.Visible = true
				Tween(s, { BackgroundTransparency = 0.95 }, 0.08)
				if row:GetAttribute("Sel") then Tween(row, { BackgroundTransparency = 0.9 }, 0.08) end
				return
			end
			Tween(row, { BackgroundTransparency = row:GetAttribute("Sel") and 0.9 or 0.95 }, 0.08)
		end)
		btn.MouseLeave:Connect(function()
			local s = Library._slabs[row.Parent]
			if s and s.Parent then
				local me = row
				-- Next row entered in the same frame: the slab glides on instead of fading.
				task.defer(function()
					if Library._slabRow[s] == me then Library._slabRow[s] = nil; Tween(s, { BackgroundTransparency = 1 }, 0.12) end
				end)
			end
			Tween(row, { BackgroundTransparency = row:GetAttribute("Sel") and Library._sel.selBgAlpha or 1 }, 0.12)
		end)
	end
	WindowObj._attachBlur = function(frame, inset, insetY)
		local area = frame
		insetY = insetY or ((inset and inset > 0) and 3 or 0)
		if inset and inset > 0 and not frame:FindFirstChildWhichIsA("UIGridStyleLayout") then
			area = Instance.new("Frame")
			area.Name = "BlurArea"
			area.BackgroundTransparency = 1
			area.Position = UDim2.fromOffset(inset, insetY)
			area.Size = UDim2.new(1, -inset * 2, 1, -insetY * 2)
			area.Parent = frame
		end
		local ok, blur = pcall(AcrylicLib.new, area)
		if not ok or not blur then return end
		-- Frames inside a CanvasGroup fade with the group, not their own alpha.
		table.insert(WindowObj._blurs, { frame = frame, blur = blur, group = frame:FindFirstAncestorWhichIsA("CanvasGroup"),
			-- Phones: a pill scrolled out of its list (hotkeys, 6 rows) drops its blur.
			clip = Library._phone and frame:FindFirstAncestorWhichIsA("ScrollingFrame") or nil })
		if WindowObj._blurLoop then return end
		WindowObj._blurFrame = 0
		WindowObj._blurLoop = RunService.RenderStepped:Connect(function()
			WindowObj._blurFrame += 1
			if Library._perfMode == "max" and WindowObj._blurFrame % 3 ~= 0 then return end
			local list = WindowObj._blurs
			local anyActive = false
			for i = #list, 1, -1 do
				local e = list[i]
				local part = e.blur.Instances.Part
				if not e.frame.Parent or not part.Parent then
					pcall(e.blur.Destroy)
					table.remove(list, i)
				elseif e.frame.Visible and not e.frame:GetAttribute("NoBlur") and (e.frame.BackgroundTransparency < 0.98
					or (WindowObj._softImgs[e.frame] and (WindowObj._softImgs[e.frame]:IsA("ImageLabel")
						and WindowObj._softImgs[e.frame].ImageTransparency or WindowObj._softImgs[e.frame].BackgroundTransparency) < 0.98)) and IsAncestorVisible(e.frame)
					and not (e.group and e.group.GroupTransparency > 0.6)
					and not (e.clip and (e.frame.AbsolutePosition.Y + e.frame.AbsoluteSize.Y * 0.5 < e.clip.AbsolutePosition.Y
						or e.frame.AbsolutePosition.Y + e.frame.AbsoluteSize.Y * 0.5 > e.clip.AbsolutePosition.Y + e.clip.AbsoluteSize.Y)) then
					pcall(e.blur.Update)
					local target = part:GetAttribute("TargetTransparency") or 0.8
					if part.Transparency ~= target then part.Transparency = target end
					anyActive = true
				elseif part.Transparency ~= 1 then
					part.Transparency = 1
				end
			end
			local dof = AcrylicBlur.Instances and AcrylicBlur.Instances.DepthOfField
			if dof then
				local want = anyActive or (WindowObj._menuOpen == true and WindowObj._menuBlurOn and WindowObj._menuBlurOn() == true)
				if dof.Enabled ~= want then dof.Enabled = want end
			end
		end)
	end

	local function GetMainFrameScale()
		local scale = MainFrameUIScale and MainFrameUIScale.Scale or 1
		if type(scale) ~= "number" or scale ~= scale or scale <= 0 then return 1 end
		return scale
	end

	local function GetVisualScale(object)
		local scale = 1
		local current = object
		while current do
			local ok, uiScale = pcall(function()
				return current:FindFirstChildOfClass("UIScale")
			end)
			if (not ok or not uiScale) and current == MainFrame then uiScale = MainFrameUIScale end
			if (ok or current == MainFrame) and uiScale and type(uiScale.Scale) == "number" and uiScale.Scale > 0 then
				scale = scale * uiScale.Scale
			end
			if current == MainFrame then break end
			current = current.Parent
		end
		if type(scale) ~= "number" or scale ~= scale or scale <= 0 then return 1, 1 end
		scale = math.clamp(scale, 0.01, 100)
		return scale, scale
	end

	local function GetPopupParentOrigin(popup)
		local parent = popup and popup.Parent
		if parent and parent:IsA("GuiObject") then
			return parent.AbsolutePosition.X, parent.AbsolutePosition.Y,
				parent.AbsoluteSize.X, parent.AbsoluteSize.Y
		end
		return 0, 0, 0, 0
	end

	local function AbsoluteFromPosition(popup)
		local baseX, baseY, sizeX, sizeY = GetPopupParentOrigin(popup)
		local scaleX, scaleY = GetVisualScale(popup)
		local position = popup.Position
		return baseX + (position.X.Scale * sizeX + position.X.Offset) * scaleX,
			baseY + (position.Y.Scale * sizeY + position.Y.Offset) * scaleY
	end

	local function MovePopupToAbsolute(popup, x, y)
		if not popup or not popup.Parent then return end
		if popup.AbsoluteSize.X <= 0 or popup.AbsoluteSize.Y <= 0 then return end
		local scaleX, scaleY = GetVisualScale(popup)
		local position = popup.Position
		local dx = (x - popup.AbsolutePosition.X) / scaleX
		local dy = (y - popup.AbsolutePosition.Y) / scaleY
		if math.abs(dx) < 0.5 and math.abs(dy) < 0.5 then return end
		popup.Position = UDim2.new(position.X.Scale, position.X.Offset + dx, position.Y.Scale, position.Y.Offset + dy)
	end

	-- Tooltips (NL): hovering a function for 0.45s shows its description
	-- in a dark plate beside the cursor (fade 0.12s, wraps at 260px, kept inside the
	-- window); leaving or clicking hides it. One shared plate, inside the window so it
	-- fades with the menu. Set with obj:SetTooltip(text) (any element) or by label in
	-- Library.Tooltips = { ["Silent Aim"] = "text" } before the element is created.
	WindowObj._tooltip = function(target, text)
		if not target or type(text) ~= "string" or text == "" then return end
		target:SetAttribute("Tooltip", text)
		if target:GetAttribute("TooltipHooked") then return end
		target:SetAttribute("TooltipHooked", true)
		local tip = WindowObj._tooltipFrame
		if not tip then
			tip = New("TextLabel", {
				Name = "Tooltip", Size = UDim2.fromOffset(40, 28), TextWrapped = true,
				BackgroundColor3 = Color3.fromRGB(18, 18, 25), BackgroundTransparency = 1, Text = "", TextColor3 = Color3.fromRGB(235, 236, 241),
				TextTransparency = 1, TextSize = 13, Font = FONT, Visible = false, ZIndex = 9500,
			}, MainFrame)
			New("UICorner", { CornerRadius = UDim.new(0, 8) }, tip)
			local outline = Stroke(tip)
			outline.Transparency = 0.82
			outline:SetAttribute("Base", outline.Transparency)
			New("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, tip)
			WindowObj._tooltipFrame = tip
			WindowObj._tooltipToken = 0
			-- Placement: right / below the cursor, flipped to the left / above when it would leave the
			-- window; `glide` = follow the pointer with 0.05 s smoothing (shared input hub, idle when hidden).
			WindowObj._tipPlace = function(point, glide, rise)
				local sz, mp, ms = tip.AbsoluteSize, MainFrame.AbsolutePosition, MainFrame.AbsoluteSize
				local x, y = point.X + 14, point.Y + 16
				if x + sz.X > mp.X + ms.X - 6 then x = point.X - 10 - sz.X end
				if y + sz.Y > mp.Y + ms.Y - 6 then y = point.Y - 8 - sz.Y end
				local old = tip.Position
				MovePopupToAbsolute(tip, x, y + (rise or 0))
				if WindowObj._constrainPopup then WindowObj._constrainPopup(tip, 6) end
				if glide and tip.Position ~= old then
					local new = tip.Position
					tip.Position = old
					Library._anim.raw(tip, { Position = new }, 0.05, "enter")
				end
			end
			Library._uis("InputChanged", function(input)
				if input.UserInputType ~= Enum.UserInputType.MouseMovement or not tip.Visible or tip.TextTransparency > 0.6 or WindowObj._mobile then return end
				local p = GetPointerPosition()
				WindowObj._tipPlace(Vector2.new(p.X, p.Y - (WindowObj._topInset or 0)), true, -5)
			end)
		end
		local function hide()
			WindowObj._tooltipToken = WindowObj._tooltipToken + 1
			local token = WindowObj._tooltipToken
			Tween(tip, { BackgroundTransparency = 1, TextTransparency = 1 }, 0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
			task.delay(0.16 * math.max(Library._animScale or 1, 0.1), function() if token == WindowObj._tooltipToken then tip.Visible = false end end)
		end
		-- `point` is in GUI space (below the top inset).
		local function showAt(point)
			tip.Text = target:GetAttribute("Tooltip") or ""
			-- Width from the text (max 260, then it wraps), height from the line count.
			local textW = MeasureText(tip.Text, 13, FONT)
			local w = math.clamp(math.ceil(textW) + 22, 40, 260)
			local lines = math.max(1, math.ceil(textW / (w - 22) * 1.06))
			tip.Size = UDim2.fromOffset(w, 12 + lines * 17)
			tip.Visible = true
			ApplyZIndexLadder(tip, NextPopupZ())
			WindowObj._tipPlace(point, false, 0)
			-- Phones: kept on screen, the finger stays below it.
			if WindowObj._mobile then
				local origin, area, size = NLUI.AbsolutePosition, NLUI.AbsoluteSize, tip.AbsoluteSize
				MovePopupToAbsolute(tip,
					math.clamp(point.X - 20, origin.X + 8, math.max(origin.X + 8, origin.X + area.X - size.X - 8)),
					math.clamp(point.Y - 64, origin.Y + 8, math.max(origin.Y + 8, origin.Y + area.Y - size.Y - 8)))
			end
			Tween(tip, { BackgroundTransparency = 0.04, TextTransparency = 0 }, 0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
			Tween(tip, { Position = tip.Position - UDim2.fromOffset(0, 5) }, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		end
		-- Phones: a long press on the row shows it for a few seconds.
		WindowObj._tipShow = WindowObj._tipShow or setmetatable({}, { __mode = "k" })
		WindowObj._tipShow[target] = function(point)
			WindowObj._tooltipToken = WindowObj._tooltipToken + 1
			local token = WindowObj._tooltipToken
			showAt(point)
			task.delay(3, function() if token == WindowObj._tooltipToken then hide() end end)
		end
		-- The row and its buttons (a button on top of the row takes the hover from it) share
		-- one "inside" counter, so moving between them neither restarts nor hides the tip.
		local inside = 0
		local function enter()
			inside = inside + 1
			if inside > 1 or Library._hoverBlocked(target) then return end
			WindowObj._tooltipToken = WindowObj._tooltipToken + 1
			local token = WindowObj._tooltipToken
			task.delay(0.45, function()
				if token ~= WindowObj._tooltipToken or not target.Parent or not MainFrame.Visible or inside == 0 then return end
				local point = GetPointerPosition()
				showAt(Vector2.new(point.X, point.Y - (WindowObj._topInset or 0)))
			end)
		end
		local function leave()
			inside = math.max(0, inside - 1)
			if inside == 0 then hide() end
		end
		local function hook(o)
			o.MouseEnter:Connect(enter)
			o.MouseLeave:Connect(leave)
			o.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then hide() end
			end)
		end
		hook(target)
		for _, d in ipairs(target:GetDescendants()) do
			if d:IsA("GuiButton") then hook(d) end
		end
	end

	local function PopupSafeArea()
		local gui = MainFrame and MainFrame.Parent
		if gui and gui:IsA("ScreenGui") and gui.AbsoluteSize.X > 0 and gui.AbsoluteSize.Y > 0 then
			return gui.AbsolutePosition, gui.AbsoluteSize
		end
		if MainFrame and MainFrame.AbsoluteSize.X > 0 and MainFrame.AbsoluteSize.Y > 0 then
			return MainFrame.AbsolutePosition, MainFrame.AbsoluteSize
		end
		return Vector2.new(0, 0), Vector2.new(0, 0)
	end

	local function ConstrainPopupToMainFrame(popup, margin, knownSize)
		margin = type(margin) == "number" and math.max(0, margin) or 6
		if not popup or not popup.Parent or not popup:IsA("GuiObject") then return end
		local size = knownSize or popup.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then return end
		local mainPosition, mainSize = PopupSafeArea()
		if mainSize.X <= 0 or mainSize.Y <= 0 then return end
		local minX = mainPosition.X + margin
		local minY = mainPosition.Y + margin
		local maxX = mainPosition.X + mainSize.X - size.X - margin
		local maxY = mainPosition.Y + mainSize.Y - size.Y - margin
		if maxX < minX then minX, maxX = mainPosition.X, mainPosition.X end
		local currentX, currentY = AbsoluteFromPosition(popup)
		local x = maxX < minX and minX or math.clamp(currentX, minX, maxX)
		local y = maxY < minY and minY or math.clamp(currentY, minY, maxY)
		MovePopupToAbsolute(popup, x, y)
	end
	WindowObj._constrainPopup = ConstrainPopupToMainFrame
		local function FindClippingAncestors(popup)
			local ancestors = {}
			local current = popup and popup.Parent
			while current and current ~= MainFrame do
				local ok, clips = pcall(function() return current.ClipsDescendants end)
				-- A plate's own scrolling list clips like Roblox does (nested plates move out of it).
				local plateList = current:IsA("ScrollingFrame") and current.Parent and current.Parent.Name == "SettingsFrame"
				if (ok and clips == true) or plateList or _popupClipCounts[current] then table.insert(ancestors, current) end
				current = current.Parent
			end
			return ancestors
		end

		local function RememberPopupClipping(popup)
			if not popup or not popup.Parent or _popupClipRestore[popup] then return end
			-- A popup inside a clipping column moves under the window itself.
			-- Unclipping the columns instead showed their hidden overflow
			-- (cards below the window) while a plate was open.
			if popup.Parent ~= MainFrame and popup:IsDescendantOf(MainFrame) then
				local clipped = FindClippingAncestors(popup)
				if #clipped > 0 then
					-- Same spot on screen after the move (a Position relative to its
					-- button, e.g. "Global"'s list, would otherwise land in a corner).
					local abs, size = popup.AbsolutePosition, popup.AbsoluteSize
					popup.Parent = MainFrame
					local host, scale = MainFrame.AbsolutePosition, GetMainFrameScale()
					popup.Position = UDim2.fromOffset(
						(abs.X + popup.AnchorPoint.X * size.X - host.X) / scale,
						(abs.Y + popup.AnchorPoint.Y * size.Y - host.Y) / scale)
					_popupClipRestore[popup] = {}
					return
				end
			end
			local ancestors = FindClippingAncestors(popup)
			if #ancestors == 0 then return end
			local restored = {}
			for _, ancestor in ipairs(ancestors) do
				if not _popupClipCounts[ancestor] then
					local okClip, wasClipping = pcall(function() return ancestor.ClipsDescendants end)
					ancestor:SetAttribute("NLClipOriginal", okClip and wasClipping == true)
				end
				table.insert(restored, { frame = ancestor })
				_popupClipCounts[ancestor] = (_popupClipCounts[ancestor] or 0) + 1
				ancestor.ClipsDescendants = false
			end
			_popupClipRestore[popup] = restored
		end

		local function ForceLiftClipping(popup)
			-- Tracked through RememberPopupClipping, so closing restores it (an
			-- untracked lift left section columns unclipped for good).
			RememberPopupClipping(popup)
			for _, entry in ipairs(_popupClipRestore[popup] or {}) do
				pcall(function() entry.frame.ClipsDescendants = false end)
			end
		end

		RestorePopupClipping = function(popup)
			local ancestors = popup and _popupClipRestore[popup]
			if not ancestors then return end
			_popupClipRestore[popup] = nil
			for _, entry in ipairs(ancestors) do
				local ancestor = entry.frame
				local count = (_popupClipCounts[ancestor] or 1) - 1
				if count > 0 then
					_popupClipCounts[ancestor] = count
				else
					_popupClipCounts[ancestor] = nil
					if ancestor.Parent then ancestor.ClipsDescendants = ancestor:GetAttribute("NLClipOriginal") == true end
					ancestor:SetAttribute("NLClipOriginal", nil)
				end
			end
		end


	local function positionPopupNow(popup, preferBelow, margin, anchorOverride, knownSize)
		if not popup or not popup.Parent then return end
		local parent = popup.Parent
		local anchor = anchorOverride or (parent and (parent:FindFirstChild("TopBar") or parent:FindFirstChild("OpenBtn") or parent:FindFirstChild("ScaleOpenBtn") or parent:FindFirstChild("LangOpenBtn")))
		local parentPosition = (anchor or parent).AbsolutePosition
		local parentSize = (anchor or parent).AbsoluteSize
		local mainPosition, mainSize = PopupSafeArea()
		if mainSize.X <= 0 or mainSize.Y <= 0 or parentSize.X <= 0 or parentSize.Y <= 0 then return end
		local popupSize = knownSize or popup.AbsoluteSize
		if popupSize.X <= 0 or popupSize.Y <= 0 then return end
		local edge = type(margin) == "number" and math.max(0, margin) or 6
		local minX = mainPosition.X + edge
		local minY = mainPosition.Y + edge
		local maxX = mainPosition.X + mainSize.X - popupSize.X - edge
		local maxY = mainPosition.Y + mainSize.Y - popupSize.Y - edge
		if maxX < minX then minX, maxX = mainPosition.X, mainPosition.X end
		local y = preferBelow and parentPosition.Y + parentSize.Y + edge or parentPosition.Y - popupSize.Y - edge
		if preferBelow and y > maxY then
			local flipped = parentPosition.Y - popupSize.Y - edge
			if flipped >= minY then y = flipped end
		elseif not preferBelow and y < minY then
			local flipped = parentPosition.Y + parentSize.Y + edge
			if flipped <= maxY then y = flipped end
		end
		local currentX = select(1, AbsoluteFromPosition(popup))
		local x = maxX < minX and minX or math.clamp(anchor and anchor.AbsolutePosition.X or currentX, minX, maxX)
		if maxY < minY then y = minY end
		MovePopupToAbsolute(popup, x, math.clamp(y, minY, math.max(minY, maxY)))
	end

	RepositionOpenPopups = function()
		local copy = {}
		for i, entry in ipairs(_openPopups) do copy[i] = entry end
		for _, entry in ipairs(copy) do
			local frame = entry.frame
			if frame and frame.Parent and frame.Visible then
				ConstrainPopupToMainFrame(frame, 6)
			end
		end
	end

	local function PositionPopupWithinMain(popup, preferBelow, margin, anchorOverride, knownSize)
		if not popup or not popup.Parent then return end
		RememberPopupClipping(popup)
		local wasVisible = popup.Visible
		local savedTransparency = popup.BackgroundTransparency
		if not wasVisible then
			popup.Visible = true
			popup.BackgroundTransparency = 1
		end
		positionPopupNow(popup, preferBelow, margin, anchorOverride, knownSize)
		ConstrainPopupToMainFrame(popup, margin, knownSize)
		if not wasVisible then
			popup.BackgroundTransparency = savedTransparency
			popup.Visible = false
			task.defer(function()
				if popup.Parent and popup.Visible then
					PositionPopupWithinMain(popup, preferBelow, margin, anchorOverride)
				end
			end)
		end
	end

