	-- Win:SetTheme("Light" / "Dark"): recolours everything on screen (and what
	-- is created or tweened later while Light).
	-- Win:SetTheme(name): any Library._themes entry (Library._themeOrder); unknown names = Dark.
	Library._fxMain = MainFrame
	Library._fxWinObj = WindowObj
	function WindowObj:SetTheme(name, force)
		local th = Library._themes
		name = Library._themeAlias[name] or name
		if name == "Auto" or not th[name] then name = "Dark" end
		local prev = WindowObj._theme or "Dark"
		if name == prev and not force then return self end
		local pal = th[name]
		local light = pal.light == true
		local mapped = name ~= "Dark"
		-- Between two mapped themes: first back to the Dark originals (fade entries kept), so the new
		-- pass maps from the real bases; both fades merge into one (old colour -> new colour).
		local back
		if mapped and prev ~= "Dark" and prev ~= name then
			Library._themeFadeFinish()
			Library._themeMap = nil
			Library._themePal = nil
			Library._lightOn = false
			back = {}
			Library._themeFade = back
			Library._themePass(NLUI, true)
			Library._themeFade = nil
		end
		WindowObj._theme = name
		Library._themeName = name
		Library._lightOn = light
		Library._themePal = mapped and pal or nil
		if mapped then
			Library._themeMap = function(props, obj)
				local out = {}
				if obj and Library._skipTheme(obj) then return props end
				for k, v in pairs(props) do
					if Library._themeProps[k] and typeof(v) == "Color3" then
						out[k] = obj and Library._themeFor(obj, k, v) or Library._mapColor(v)
						-- A tween's dark-space target is the colour to restore in Dark (no stale base).
						if obj then pcall(obj.SetAttribute, obj, "ThemeBase_" .. k, v) end
					else out[k] = v end
				end
				return out
			end
		else
			Library._themeMap = nil
		end
		WindowObj._plateAlpha = light and 0.1 or 0.12
		-- Every object (hidden tabs, popups, overlays included) is recoloured in this one pass and
		-- all colours then move together in one short fade; nothing is re-themed later per tab.
		Library._themeFadeFinish()
		Library._themeFade = {}
		Library._themePass(NLUI, true)
		if back then Library._themeFade = Library._themeFadeMerge(back, Library._themeFade) end
		Library._themeFadeRun(Library._themeFade)
		Library._themeFade = nil
		if mapped and not WindowObj._themeConn then
			-- New objects are themed in the same frame, in one batch: a whole new subtree (a lazily
			-- built tab, a popup) is one deep pass instead of one deep pass per descendant.
			WindowObj._themeConn = NLUI.DescendantAdded:Connect(function(inst)
				local q = WindowObj._themeQueue
				if q then table.insert(q, inst) return end
				q = { inst }
				WindowObj._themeQueue = q
				task.defer(function()
					WindowObj._themeQueue = nil
					if not Library._themeMap then return end
					local set = {}
					for _, i in ipairs(q) do set[i] = true end
					for _, i in ipairs(q) do
						local p, covered = i.Parent, false
						while p and p ~= NLUI do
							if set[p] then covered = true break end
							p = p.Parent
						end
						if i.Parent and not covered then Library._themePass(i, true) end
					end
				end)
			end)
		elseif not mapped and WindowObj._themeConn then
			WindowObj._themeConn:Disconnect()
			WindowObj._themeConn = nil
		end
		if MainFrame.Visible and MainFrame.BackgroundTransparency < 0.9 then
			Tween(MainFrame, { BackgroundTransparency = Library._winAlpha() }, 0.18)
		end
		-- The theme's accent replaces the previous theme's accent (a custom accent is kept).
		local pa = (th[prev] or th.Dark).accent or th.Dark.accent
		if prev ~= name and applyMainColorProxy and pal.accent and pal.accent ~= pa
			and math.abs(mainColor.R - pa.R) + math.abs(mainColor.G - pa.G) + math.abs(mainColor.B - pa.B) < 0.03 then
			applyMainColorProxy(pal.accent)
		end
		Library._xmasSet(MainFrame, pal.fx ~= nil)
		-- New Year suggests the mascot (Profile > Mascot shows "Try Santa" while it is Off).
		local mrow = SettingsContainer:FindFirstChild("Profile_Mascot")
		local mval = mrow and mrow:FindFirstChild("ProfileValue")
		if mval and settings.Mascot == "Off" then mval.Text = pal.xmas and "Try Santa" or "Off" end
		return self
	end
	-- Win:SetLanguage("English" / "Русский"): the library's own texts.
	function WindowObj:SetLanguage(name)
		local ru = name == "Русский" or name == "Russian"
		Library._translate = function(obj)
			local base = obj:GetAttribute("LangBase")
			if Library._lang == "ru" then
				local src = base or obj.Text
				local tr = Library._ru[src]
				if tr then
					if not base then obj:SetAttribute("LangBase", src) end
					obj.Text = tr
				end
			elseif base then
				obj.Text = base
				obj:SetAttribute("LangBase", nil)
			end
		end
		Library._lang = ru and "ru" or "en"
		for _, d in ipairs(NLUI:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then Library._translate(d) end
		end
		return self
	end
	-- Win:Unload(): removes the menu and everything it put in the game.
	function WindowObj:Unload()
		if WindowObj._unloaded then return end
		WindowObj._unloaded = true
		if WindowObj._applyMenuBlur then pcall(WindowObj._applyMenuBlur) end
		-- Phone buttons go at once (the GUI itself is destroyed after the fade).
		if WindowObj._mobileToggle then WindowObj._mobileToggle.Visible = false end
		for _, entry in pairs(WindowObj._screenButtons or {}) do
			if entry.release then pcall(entry.release) end
			if entry.btn then entry.btn.Visible = false end
		end
		pcall(function() if WindowObj._blurLoop then WindowObj._blurLoop:Disconnect() end end)
		pcall(function() if WindowObj._pillLoop then WindowObj._pillLoop:Disconnect() end end)
		pcall(function() if AcrylicBlur.Signal then AcrylicBlur.Signal:Disconnect() end end)
		pcall(function() RunService:UnbindFromRenderStep("NLWatermarkFollow") end)
		for _, e in ipairs(WindowObj._blurs or {}) do pcall(e.blur.Destroy) end
		pcall(function() if AcrylicBlur.Destroy then AcrylicBlur.Destroy() end end)
		pcall(function()
			local dof = AcrylicBlur.Instances and AcrylicBlur.Instances.DepthOfField
			if dof then dof:Destroy() end
		end)
		local gui = NLUI
		if gui then
			Tween(MainFrame, { BackgroundTransparency = 1 }, 0.2)
			task.delay(0.22, function() pcall(function() gui:Destroy() end) end)
		end
		if type(WindowObj._onUnload) == "function" then pcall(WindowObj._onUnload) end
	end
	function WindowObj:OnUnload(fn) WindowObj._onUnload = fn return self end

