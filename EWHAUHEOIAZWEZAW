Library._b64 = function(s)
	local map = Library._b64map
	if not map then
		local A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
		map = {}
		for i = 1, 64 do map[string.byte(A, i)] = i - 1 end
		Library._b64map = map
	end
	local out = {}
	for i = 1, #s - 3, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local n = map[a] * 262144 + map[b] * 4096 + (map[c] or 0) * 64 + (map[d] or 0)
		local b1, b2, b3 = math.floor(n / 65536), math.floor(n / 256) % 256, n % 256
		if c == 61 then out[#out + 1] = string.char(b1)
		elseif d == 61 then out[#out + 1] = string.char(b1, b2)
		else out[#out + 1] = string.char(b1, b2, b3) end
	end
	return table.concat(out)
end
Library._iconName = function(kind)
	local name = string.lower(tostring(kind or ""))
	if Library._iconPack and Library._iconPack[name] then return name end
	local k = Library._iconKinds and Library._iconKinds[name] or name
	return Library._iconAlias[name] or Library._iconAlias[k] or k
end
-- True when NLUI_icons/*.png were all written by this exact pack (NLUI_icons/pack.ver). If not,
-- the first call decodes + writes every pack PNG once and stamps the folder, so later launches
-- never base64-decode or re-read the pack (only getcustomasset per icon, on first use).
Library._iconFilesCurrent = function()
	if Library._iconFilesOk ~= nil then return Library._iconFilesOk end
	Library._iconFilesOk = false
	if type(isfile) ~= "function" or type(readfile) ~= "function" or type(writefile) ~= "function" or not Library._iconPack then return false end
	local n, len = 0, 0
	for name, data in pairs(Library._iconPack) do n = n + 1; len = len + #data + #name end
	local ver = "v1 " .. n .. " " .. len
	local okC, cur = pcall(function() return isfile("NLUI_icons/pack.ver") and readfile("NLUI_icons/pack.ver") end)
	if okC and cur == ver then Library._iconFilesOk = true; return true end
	local okW = pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder("NLUI_icons") then makefolder("NLUI_icons") end
		for name, data in pairs(Library._iconPack) do writefile("NLUI_icons/" .. name .. ".png", Library._b64(data)) end
		writefile("NLUI_icons/pack.ver", ver)
	end)
	Library._iconFilesOk = okW
	return okW
end
Library._iconAsset = function(kind)
	local name = Library._iconName(kind)
	local cached = Library._iconCache[name]
	if cached ~= nil then return cached or nil end
	local data = Library._iconPack and Library._iconPack[name]
	local getAsset = getcustomasset or getsynasset
	local result = false
	if data and Library._iconProbe().custom and type(getAsset) == "function" then
		local ok, id = pcall(function()
			local dir = "NLUI_icons"
			if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(dir) then makefolder(dir) end
			local file = dir .. "/" .. name .. ".png"
			if Library._iconFilesCurrent() and isfile(file) then return getAsset(file) end
			local bytes = Library._b64(data)
			local same = false
			if type(isfile) == "function" and type(readfile) == "function" and isfile(file) then
				local okR, cur = pcall(readfile, file)
				same = okR and cur == bytes
			end
			if not same then writefile(file, bytes) end
			return getAsset(file)
		end)
		if ok and type(id) == "string" and id ~= "" then result = id end
	end
	Library._iconCache[name] = result
	return result or nil
end
-- Puts icon `kind` into an ImageLabel/ImageButton (tint = its ImageColor3): the pack image when the
-- executor can load it, else the Material sheet tile. Returns true when applied (false = neither:
-- callers then draw the glyph). Pack images that do not load are switched by Library._iconVerify.
Library._applyIcon = function(icon, kind, keepSize)
	if not icon or icon:FindFirstChild("GlyphGrid") then return false end
	local id = Library._iconAsset(kind)
	if not id then return Library._applySheet(icon, kind, keepSize) end
	local box0 = icon:GetAttribute("IconPackBox")
	if box0 and icon:GetAttribute("IconSheet") then icon.Size = UDim2.fromOffset(box0, box0); icon:SetAttribute("IconPackBox", nil) end
	icon:SetAttribute("IconSheet", nil)
	icon.Image = id
	icon.ImageRectOffset = Vector2.zero
	icon.ImageRectSize = Vector2.zero
	icon.ScaleType = Enum.ScaleType.Fit
	icon:SetAttribute("IconPack", Library._iconName(kind))
	-- Pack art fills 72 of 96 px: a centred fixed-size box grows (even px) so the art is 90% of it.
	if not keepSize and icon.AnchorPoint == Vector2.new(0.5, 0.5) and icon.Size.X.Scale == 0 and icon.Size.Y.Scale == 0 and not icon:GetAttribute("IconPackBox") then
		local box = icon.Size.X.Offset
		local n = math.floor(box * Library._iconGrow / 2 + 0.5) * 2
		icon:SetAttribute("IconPackBox", box)
		icon.Size = UDim2.fromOffset(n, n)
	end
	Library._iconMark(icon, "pack")
	return true
end
