		local img = Library._icon(parent, kind, px, color, z)
		img.Name = "Glyph_" .. kind
		return img, function(c, t)
			if t and t > 0 then Tween(img, { ImageColor3 = c }, t, Enum.EasingStyle.Sine) else img.ImageColor3 = c end
		end
	end
	local host = Instance.new("Frame")
	host.Name = "Glyph_" .. kind
	host.AnchorPoint = Vector2.new(0.5, 0.5)
	host.Position = UDim2.fromScale(0.5, 0.5)
	host.Size = UDim2.fromOffset(px, px)
	host.BackgroundTransparency = 1
	host.ZIndex = z or 1
	host.Parent = parent
	local grid = Instance.new("Frame")
	grid.Name = "GlyphGrid"
	grid.AnchorPoint = Vector2.new(0.5, 0.5)
	grid.Position = UDim2.fromScale(0.5, 0.5)
	grid.Size = UDim2.fromOffset(18, 18)
	grid.BackgroundTransparency = 1
	grid.ZIndex = host.ZIndex
	grid.Parent = host
	local fit = Instance.new("UIScale"); fit.Scale = px / 18; fit.Parent = grid
	local parts = {}
	local cuts = {}
	Library._iconDraw(kind, Library._iconBuilder(grid, host.ZIndex + 1, color, function(o, t)
		if t == "cut" then table.insert(cuts, o) else table.insert(parts, { o, t == "ring" and "Color" or "BackgroundColor3" }) end
	end))
