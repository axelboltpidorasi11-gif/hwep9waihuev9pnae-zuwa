	local function tabIconFor(e, parent, px, x)
		local t = tabs[e.tab]
		local st = t and t.subTabs and e.sub and t.subTabs[e.sub]
		local src = (st and st.icon) or (t and t.icon)
		if src and src.Parent then
			local c = src:Clone()
			c.Name = "TabGlyph"
			c.AnchorPoint = Vector2.new(0.5, 0.5)
			c.Position = UDim2.new(0, x, 0.5, 0)
			c.Size = UDim2.fromOffset(px, px)
			c.ImageTransparency = 0
			c.Parent = parent
			Library._setC(c, "ImageColor3", Color3.fromRGB(150, 155, 172))
			return c
		end
		local g = Library._icon(parent, "search", px - 4, MID)
		g.Position = UDim2.new(0, x, 0.5, 0)
		return g
	end
	local function groupTitle(g)
		local s = tr(tabName(g.tab))
		local sn = subName(g.tab, g.sub)
		if sn then s = s .. "  ›  " .. tr(sn) end
		if Library._lang ~= "ru" then s = string.upper(s) end
		return s
	end
	function S.layout()
		local listH = math.min(S.contentH, MAX_ROWS * ROW_H)
		listH = math.max(listH, 40)
		-- Phones: the palette stays inside the content panel (a short landscape screen).
		if Library._phone and S.pop.Parent and S.pop.Parent:IsA("GuiObject") then
			local g = ctx.scale and ctx.scale() or 1
			local room = S.pop.Parent.AbsoluteSize.Y / (g > 0 and g or 1) - 46 - PAD * 2 - FOOT_H - 8
			if room > 60 then listH = math.min(listH, room) end
		end
		local H = PAD + listH + PAD + FOOT_H
		S.listH = listH
		S.scroll.CanvasSize = UDim2.fromOffset(0, S.contentH)
		if S.pop.Visible and (Library._animScale or 1) > 0 then
			Library._anim.move(S.pop, { Size = UDim2.new(S.pop.Size.X.Scale, S.pop.Size.X.Offset, 0, H) }, "base")
			Library._anim.move(S.scroll, { Size = UDim2.new(1, -PAD * 2, 0, listH) }, "base")
		else
			S.pop.Size = UDim2.new(S.pop.Size.X.Scale, S.pop.Size.X.Offset, 0, H)
			S.scroll.Size = UDim2.new(1, -PAD * 2, 0, listH)
		end
	end
	function S.select(i, noScroll)
		local old = S.flat[S.sel]
		local it = S.flat[i]
		S.sel = i or 0
		-- One selection slab glides between rows (fast, Quint Out); rows keep a clear fill.
		local slab = S.slab and S.slab.Parent == S.scroll and S.slab or nil
		if slab then
			if it and it.row and it.row.Parent then
				local pos, size = UDim2.fromOffset(0, it.y), UDim2.new(1, 0, 0, it.h)
				if slab.BackgroundTransparency >= 0.99 then Tween(slab, { Position = pos, Size = size }, 0) else Library._anim.move(slab, { Position = pos, Size = size }, "fast") end
				Library._anim.color(slab, { BackgroundTransparency = Library._sel.hoverAlpha - 0.02 }, "instant")
			else
				Library._anim.color(slab, { BackgroundTransparency = 1 }, "fast")
			end
		end
		if old and old.row and old.row.Parent and old ~= it then
			Library._anim.color(old.row, { BackgroundTransparency = 1 }, "instant")
			if old.bar then Library._anim.move(old.bar, { Size = UDim2.fromOffset(3, 0) }, "fast") end
		end
		if it and it.row and it.row.Parent then
			if not slab then Library._anim.color(it.row, { BackgroundTransparency = Library._sel.hoverAlpha - 0.02 }, "instant") end
			if it.bar then Library._anim.move(it.bar, { Size = UDim2.fromOffset(3, 20) }, "fast") end
			if not noScroll then
				local top, bot = it.y, it.y + it.h
				if it.first then top = top - GROUP_H end
				local cp = S.scroll.CanvasPosition.Y
				local scale = ctx.scale()
				local vh = S.listH or S.scroll.AbsoluteSize.Y / scale
				local want
				if top < cp then want = top elseif bot > cp + vh then want = bot - vh end
				if want then Library._anim.move(S.scroll, { CanvasPosition = Vector2.new(0, math.max(0, want)) }, "fast") end
			end
		end
	end
	function S.activate(i)
		local it = S.flat[i]
		if not it then return end
		if it.recent then
			S.box.Text = it.recent
			S.box.CursorPosition = #it.recent + 1
			pcall(function() S.box:CaptureFocus() end)
			return
		end
		S.jump(it.e)
	end
	local function resultRow(h, y, first, toks)
		local e = h.e
		local row = New("TextButton", { Name = "Result", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, ROW_H), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
