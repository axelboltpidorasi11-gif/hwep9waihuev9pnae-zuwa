-- Motion tokens: one timing/easing vocabulary for the whole library (NL feel:
-- fast, soft ease-out, never janky). Every duration is multiplied by
-- Library._animScale (Profile > Animation Speed; 0 = reduce motion = jump to end).
Library._motion = {
	instant = 0.08, fast = 0.12, base = 0.18, slow = 0.28, colorT = 0.14,
	stagger = 0.025, rowStagger = 0.012,
	enter = { Enum.EasingStyle.Quint, Enum.EasingDirection.Out },  -- enter / move
	color = { Enum.EasingStyle.Sine, Enum.EasingDirection.InOut }, -- colour cross-fades
	exit = { Enum.EasingStyle.Quad, Enum.EasingDirection.In },     -- leaving
	spring = { Enum.EasingStyle.Back, Enum.EasingDirection.Out },  -- press release (soft overshoot)
}
-- Odd hand-written durations (0.11, 0.14, 0.3 ...) snap to the nearest token;
-- long ones (> 0.36 s) keep their length (capped by Tween at 0.45 s).
Library._motion.snap = function(t)
	local M = Library._motion
	if not t or t <= 0 then return 0 end
	if t > 0.36 then return t end
	if t < 0.065 then return M.instant elseif t < 0.15 then return M.fast elseif t < 0.235 then return M.base end
	return M.slow
end
-- Scaled by Profile > Animation Speed (used for task.delay timings next to tweens).
Library._motion.dur = function(t)
	local s = Library._animScale
	if s == nil then s = 1 end
	return math.max((type(t) == "string" and Library._motion[t] or t or 0) * s, 0)
end

-- Track running tweens by object/property so repeated hover and popup inputs do
-- not fight each other. Tweens for unrelated properties can still run in parallel.
local _liveTweensByObject = setmetatable({}, { __mode = "k" })
-- Profile > Performance mode: "off" (every loop per frame, as before) | "balanced" (default: same
-- visuals, idle loops throttled) | "max" (lower overlay rates, no hover tweens / stagger, short motion).
Library._perfMode = "balanced"
Library._perfCount = { tweens = 0, tweenSkips = 0 }
Library._skipProps = { BackgroundTransparency = true, TextTransparency = true, ImageTransparency = true, Transparency = true,
	BackgroundColor3 = true, TextColor3 = true, ImageColor3 = true, Color = true, TextStrokeTransparency = true, ScrollBarImageTransparency = true }
local function Tween(obj, props, t, style, dir, delay)
	-- Destroyed parents and incomplete tables are ignored.
	if not obj or not obj.Parent or type(props) ~= "table" then return nil end
	-- Motion tokens: odd durations snap to instant/fast/base/slow (Library._anim
	-- passes exact values); t == 0 stays instant (drag-tracking callers).
	if type(t) == "string" then t = Library._motion[t] end
	t = t or Library._motion.base
	if t > 0 then t = math.min(Library._motionExact and t or Library._motion.snap(t), 0.45) end
	-- Colour cross-fades (Sine) of hover length run on the colour clock: 0.14 s Sine InOut.
	if style == Enum.EasingStyle.Sine and not Library._motionExact and t > 0 and t <= Library._motion.fast + 0.001 then
		t = Library._motion.colorT; dir = Enum.EasingDirection.InOut
	end
	-- Profile > Animation Speed: Library._animScale multiplies every duration (0 = reduce motion).
	local animScale = Library._animScale
	if animScale and animScale ~= 1 then
		if animScale <= 0 then t = 0; delay = 0 else t = t * animScale; delay = delay and delay * animScale end
	end
	-- Profile > Performance mode Max: hover-length tweens snap, the rest are capped at "base".
	if Library._perfMode == "max" and t > 0 then
		if t <= Library._motion.colorT * (animScale or 1) + 0.001 then t = 0; delay = 0 else t = math.min(t, Library._motion.fast) end
	end
	-- Light theme: colours a tween moves to are mapped like everything else.
	if Library._themeMap then
		props = Library._themeMap(props, obj)
		-- Hover highlights are white at ~0.97 transparency: invisible on a light surface, so they become black.
		local bt = props.BackgroundTransparency
		if Library._lightOn and bt and bt >= 0.9 and bt < 0.995 and props.BackgroundColor3 == nil and obj:IsA("GuiObject") and not Library._skipTheme(obj) then
			local _, hs, hv = obj.BackgroundColor3:ToHSV()
			if hs <= 0.3 and hv > 0.8 then
				local copy = {}
				for k, v in pairs(props) do copy[k] = v end
				copy.BackgroundColor3 = Color3.new(0, 0, 0)
				copy.BackgroundTransparency = math.min(bt, 0.95)
				props = copy
				obj:SetAttribute("HoverInk", true)
			end
		end
	end
	-- Quint by default: every motion eases out softly.
	style = style or Enum.EasingStyle.Quint
	-- Harsh curves (bounce, elastic, linear, any Back) become a soft Quint Out; the only
	-- overshoot left is the motion token "spring" (toggle knob, button press release).
	if style == Enum.EasingStyle.Bounce or style == Enum.EasingStyle.Elastic or style == Enum.EasingStyle.Linear
		or (style == Enum.EasingStyle.Back and not Library._springOK) then
		style = Enum.EasingStyle.Quint
		dir = Enum.EasingDirection.Out
	end
	dir = dir or Enum.EasingDirection.Out
	local bucket = _liveTweensByObject[obj]
	-- perf: nothing running on these properties and every target already reached -> no tween at all
	-- (hover/theme/refresh passes re-sent the same values; callers already handle a nil tween).
	-- Colour / transparency only: position, size and scale may also be driven by slides and raw
	-- TweenService tweens that a new tween is meant to take over.
	if (delay or 0) <= 0 and Library._perfMode ~= "off" then
		local okSame, same = pcall(function()
			for property, value in pairs(props) do
				if not Library._skipProps[property] or (bucket and bucket[property]) or obj[property] ~= value then return false end
			end
			return true
		end)
		if okSame and same then
			Library._perfCount.tweenSkips += 1
			-- debug: Library._perfSkipLog = {} collects the skipped targets
			if Library._perfSkipLog then table.insert(Library._perfSkipLog, obj:GetFullName() .. " " .. tostring((next(props)))) end
			return nil
		end
	end
	Library._perfCount.tweens += 1
	if not bucket then bucket = {}; _liveTweensByObject[obj] = bucket end
	local cancel = {}
	for property in pairs(props) do
		local running = bucket[property]
		if running then cancel[running] = true end
	end
	for running in pairs(cancel) do pcall(function() running:Cancel() end) end
	-- Cancelling a tween fires Completed(Cancelled), whose callback may remove the bucket.
	bucket = _liveTweensByObject[obj]
	if not bucket then bucket = {}; _liveTweensByObject[obj] = bucket end
	-- Reduce motion / drag tracking: jump straight to the end (no tween object).
	if t <= 0 and (delay or 0) <= 0 then
		for property, value in pairs(props) do
			bucket[property] = nil
			pcall(function() obj[property] = value end)
		end
		if next(bucket) == nil then _liveTweensByObject[obj] = nil end
		return nil
	end
	local ok, tween = pcall(function()
		return TweenService:Create(obj, TweenInfo.new(t or 0.2, style, dir, 0, false, delay or 0), props)
	end)
	if not ok or not tween then return nil end
	for property in pairs(props) do bucket[property] = tween end
	tween.Completed:Connect(function()
		local current = _liveTweensByObject[obj]
		if not current then return end
		for property in pairs(props) do
			if current[property] == tween then current[property] = nil end
		end
		if next(current) == nil then _liveTweensByObject[obj] = nil end
	end)
	tween:Play()
	return tween
end

-- Perf counters (Library._perfStats) + shared input hub. Per-widget drag handlers (sliders,
-- value bubbles, colour picker) subscribe to ONE UserInputService connection per event instead of
-- opening ~200 connections that all run on every mouse move. Copy-on-write list: a handler may
-- disconnect itself while the event is being dispatched.
Library._uisSubs = {}
Library._uis = function(event, fn)
	if not Library._uisSubs[event] then
		Library._uisSubs[event] = {}
		UserInputService[event]:Connect(function(...)
			local list = Library._uisSubs[event]
			for i = 1, #list do
				local ok, err = pcall(list[i], ...)
				if not ok then task.spawn(error, err, 0) end
			end
		end)
	end
	local list = Library._uisSubs[event]
	list[#list + 1] = fn
	local conn = { Connected = true }
	function conn.Disconnect()
		if not conn.Connected then return end
		conn.Connected = false
		local cur, copy = Library._uisSubs[event], {}
		for _, f in ipairs(cur) do if f ~= fn then copy[#copy + 1] = f end end
		Library._uisSubs[event] = copy
	end
	return conn
end

-- Library._perfStats() -> { instances, activeTweens, tweensCreated, tweensSkipped, bindings (per-frame
-- loops of the menu running now), inputSubs (hub subscribers), connections (RenderStepped + Heartbeat +
-- input connections in the whole game when the executor has getconnections, else nil), mode }.
Library._perfStats = function()
	local st = { mode = Library._perfMode, tweensCreated = Library._perfCount.tweens, tweensSkipped = Library._perfCount.tweenSkips }
	local active, seen = 0, {}
	for _, bucket in pairs(_liveTweensByObject) do
		for _, tw in pairs(bucket) do
			if not seen[tw] then
				seen[tw] = true
				local okS, state = pcall(function() return tw.PlaybackState end)
				if okS and (state == Enum.PlaybackState.Playing or state == Enum.PlaybackState.Delayed) then active = active + 1 end
			end
		end
	end
	st.activeTweens = active
	local gui = Library._iconGui
	st.instances = (gui and gui.Parent) and #gui:GetDescendants() or 0
	local subs = 0
	for _, list in pairs(Library._uisSubs) do subs = subs + #list end
	st.inputSubs = subs
	local W = Library._perfWin
	local b = 0
	if W then
		if W._pillLoop and W._pillLoop.Connected then b = b + 1 end
		if W._blurLoop and W._blurLoop.Connected then b = b + 1 end
		if W._acrylic and W._acrylic.Signal then b = b + 1 end
		if W._wmFollowOn then b = b + 1 end
		b = b + 1 -- watermark stats (FPS / ping / time)
	end
	st.bindings = b
	if type(getconnections) == "function" then
		pcall(function()
			local RS = game:GetService("RunService")
			st.connections = #getconnections(RS.RenderStepped) + #getconnections(RS.Heartbeat)
				+ #getconnections(UserInputService.InputChanged) + #getconnections(UserInputService.InputBegan) + #getconnections(UserInputService.InputEnded)
		end)
	end
	return st
end
-- Profile > About row: "Perf: 12254 inst | 0 tweens | 4 loops"; long = every field (copied on click).
Library._perfSummary = function(long)
	local st = Library._perfStats()
	if long then
		local keys = {}
		for k in pairs(st) do keys[#keys + 1] = k end
		table.sort(keys)
		local parts = {}
		for _, k in ipairs(keys) do parts[#parts + 1] = k .. "=" .. tostring(st[k]) end
		return "NLUI perf: " .. table.concat(parts, " ")
	end
	return string.format("Perf: %d inst | %d tweens | %d loops", st.instances, st.activeTweens, st.bindings)
end

-- Library._anim: token-based motion helpers on top of Tween (same per object +
-- property cancel, so repeated calls never pile up or flicker). dur may be a
-- token name ("instant"/"fast"/"base"/"slow") or seconds (kept exact).
Library._anim = {}
Library._anim.tween = function(obj, props, dur, ease, delay)
	local M = Library._motion
	local e = M[ease or "enter"] or M.enter
	Library._motionExact = true
	Library._springOK = ease == "spring"
	local ok, tw = pcall(Tween, obj, props, type(dur) == "string" and M[dur] or dur or M.base, e[1], e[2], delay)
	Library._motionExact = nil
	Library._springOK = nil
	return ok and tw or nil
end
-- Same, but the values are final (no light-theme mapping / hover ink).
Library._anim.raw = function(obj, props, dur, ease, delay)
	local map = Library._themeMap
	Library._themeMap = nil
	local ok, tw = pcall(Library._anim.tween, obj, props, dur, ease, delay)
	Library._themeMap = map
	return ok and tw or nil
end
-- Position / size / layout moves: Quint Out, base.
Library._anim.move = function(obj, props, dur, delay) return Library._anim.tween(obj, props, dur or "base", "enter", delay) end
-- Transparency in (Quint Out, base) or out (Quad In, fast).
Library._anim.fade = function(obj, props, dur, out, delay)
	return Library._anim.tween(obj, props, dur or (out and "fast" or "base"), out and "exit" or "enter", delay)
end
-- Colour cross-fades: Sine InOut, fast.
Library._anim.color = function(obj, props, dur, delay) return Library._anim.tween(obj, props, dur or "colorT", "color", delay) end
-- UIScale on obj (created once as "_AnimScale" unless obj is a UIScale or has one).
Library._anim.scaleOf = function(obj)
	if not obj then return nil end
	if obj:IsA("UIScale") then return obj end
	local s = obj:FindFirstChild("_AnimScale") or obj:FindFirstChildOfClass("UIScale")
	if not s and obj:IsA("GuiObject") then
		s = Instance.new("UIScale"); s.Name = "_AnimScale"; s.Scale = 1; s.Parent = obj -- (New is declared below)
	end
	return s
end
Library._anim.scale = function(obj, s, dur, ease)
	local sc = Library._anim.scaleOf(obj)
	if sc then return Library._anim.tween(sc, { Scale = s }, dur or "base", ease or "enter") end
end
-- Press dim: a black veil (created on the first press, NoTheme) darkens a filled
-- button by ~14% while held and fades out on release.
Library._anim.dim = function(obj, down)
	if not obj or not obj:IsA("GuiObject") or obj.BackgroundTransparency >= 0.95 then return end
	local d = obj:FindFirstChild("_PressDim")
	if not d then
		if not down or obj:FindFirstChildWhichIsA("UIGridStyleLayout") then return end
		d = Instance.new("Frame")
		d.Name = "_PressDim"; d.BorderSizePixel = 0; d.BackgroundColor3 = Color3.new(0, 0, 0); d.BackgroundTransparency = 1
		d.Size = UDim2.fromScale(1, 1); d.ZIndex = obj.ZIndex + 1; d.Active = false
		d:SetAttribute("NoTheme", true)
		local c = obj:FindFirstChildOfClass("UICorner")
		if c then local cc = Instance.new("UICorner"); cc.CornerRadius = c.CornerRadius; cc.Parent = d end
		d.Parent = obj
	end
	Library._anim.raw(d, { BackgroundTransparency = down and 0.86 or 1 }, down and "instant" or "slow", down and "enter" or "color")
end
-- Accent glow on a UIStroke (slider thumb hover / drag, switch track when on): the ring takes the
-- accent, thickens and goes soft; off restores the stroke's own colour / weight (kept as attributes).
Library._anim.glow = function(stroke, on, accent, thick, instant)
	if not stroke or not stroke.Parent then return end
	if stroke:GetAttribute("GlowBaseT") == nil then
		stroke:SetAttribute("GlowBaseT", stroke.Transparency)
		stroke:SetAttribute("GlowBaseC", stroke.Color)
		stroke:SetAttribute("GlowBaseW", stroke.Thickness)
	end
	on = false -- no accent ring on slider thumbs / tracks (user feedback): only restore the base stroke
	if on == (stroke:GetAttribute("GlowOn") == true) and not instant then return end
	stroke:SetAttribute("GlowOn", on or nil)
	local goal = on and { Color = accent or Library._accentNow(), Transparency = 0.62, Thickness = thick or 2 }
		or { Color = stroke:GetAttribute("GlowBaseC"), Transparency = stroke:GetAttribute("GlowBaseT"), Thickness = stroke:GetAttribute("GlowBaseW") }
	if Library._perfMode == "max" and on then goal.Thickness = stroke:GetAttribute("GlowBaseW") end
	Library._anim.raw(stroke, goal, instant and 0 or (on and "base" or "fast"), "color")
end
-- List entrance for one row: its texts / images / fills fade in from clear (to the values they
-- have now) and it rises dy px into place; `delay` staggers rows. Reduce motion / Max: nothing.
Library._anim.riseIn = function(obj, delay, dy)
	if not obj or not obj.Parent or (Library._animScale or 1) <= 0 or Library._perfMode == "max" then return end
	if dy and dy ~= 0 then
		local p = obj.Position
		obj.Position = p + UDim2.fromOffset(0, dy)
		Library._anim.move(obj, { Position = p }, "base", delay)
	end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("GuiObject") and d.Name ~= "_PressDim" then
			if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and d.TextTransparency < 1 then
				local b = d.TextTransparency; d.TextTransparency = 1
				Library._anim.raw(d, { TextTransparency = b }, "base", "enter", delay)
			end
			if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.ImageTransparency < 1 then
				local b = d.ImageTransparency; d.ImageTransparency = 1
				Library._anim.raw(d, { ImageTransparency = b }, "base", "enter", delay)
			end
			if d.BackgroundTransparency < 1 then
				local b = d.BackgroundTransparency; d.BackgroundTransparency = 1
				Library._anim.raw(d, { BackgroundTransparency = b }, "base", "enter", delay)
			end
		end
	end
end
-- Commit flash: prop jumps `amount` of the way to `color` (accent by default) and fades back
-- to its current value (slow, colour ease). Rename / save confirmations.
Library._anim.flash = function(obj, prop, color, amount)
	if not obj or not obj.Parent or (Library._animScale or 1) <= 0 then return end
	prop = prop or "BackgroundColor3"
	local live = _liveTweensByObject[obj]
	local base = (live and live[prop]) and obj:GetAttribute("NLFlashBase") or obj[prop]
	obj:SetAttribute("NLFlashBase", base)
	obj[prop] = base:Lerp(color or Library._accentNow(), amount or 0.35)
	Library._anim.raw(obj, { [prop] = base }, "slow", "color")
end
-- Selection tick (lists, multi-select): draws in when it gets picked (scale 0.6 -> 1 + fade, fast
-- Quint Out). Only on a change while shown; reduce motion / Max: nothing.
Library._anim.tick = function(check)
	if not check or not check.Parent or (Library._animScale or 1) <= 0 or Library._perfMode == "max" then return end
	if check.AbsoluteSize.X < 2 then return end
	local sc = Library._anim.scaleOf(check)
	if sc then sc.Scale = 0.6; Library._anim.tween(sc, { Scale = 1 }, "fast", "enter") end
	if (check:IsA("ImageLabel") or check:IsA("ImageButton")) and check.ImageTransparency < 0.5 then
		local b = check.ImageTransparency
		check.ImageTransparency = 1
		Library._anim.raw(check, { ImageTransparency = b }, "fast", "enter")
	end
end
-- Buttons: press scales to 0.97 (instant) + dims, release springs back.
Library._anim.press = function(obj, down)
	if obj and not obj:IsA("UIScale") then Library._anim.dim(obj, down) end
	if down then return Library._anim.scale(obj, 0.97, "instant", "enter") end
	-- (Release / hover-out on a never-pressed button: nothing to undo, no UIScale made.)
	local s = obj and (obj:IsA("UIScale") and obj or obj:FindFirstChild("_AnimScale") or obj:FindFirstChildOfClass("UIScale"))
	if not s or (s.Scale == 1 and not (_liveTweensByObject[s] and _liveTweensByObject[s].Scale)) then return end
	return Library._anim.scale(obj, 1, "slow", "spring")
end
-- New(): every small filled TextButton / ImageButton (chips, field buttons, footer
-- buttons; <= 240x48 px offset size, not marked NoPress) gets press feedback once.
Library._autoPress = function(obj)
	if not obj.Parent or obj:GetAttribute("NLPressAnim") or obj:GetAttribute("NoPress") or obj.BackgroundTransparency >= 0.95 then return end
	local s = obj.Size
	if s.X.Scale ~= 0 or s.Y.Scale ~= 0 or s.X.Offset > 240 or s.Y.Offset > 48 or s.Y.Offset < 12 then return end
	if not obj:FindFirstAncestor("NLUI") and not obj:FindFirstAncestorWhichIsA("LayerCollector") then return end
	Library._anim.button(obj)
end
-- Counts a number label from `from` to `to` (fmt(v) -> text). fmt == nil only
-- stops a running count (drag tracking sets the text itself).
Library._anim.number = function(label, from, to, fmt, dur)
	local old = label:FindFirstChild("_NumTween")
	if old then old:Destroy() end
	if not fmt then return end
	if from == to or type(from) ~= "number" or type(to) ~= "number" or (Library._animScale or 1) <= 0 then
		label.Text = fmt(to)
		return
	end
	local nv = Instance.new("NumberValue")
	nv.Name = "_NumTween"; nv.Value = from; nv.Parent = label
	nv.Changed:Connect(function() if nv.Parent then label.Text = fmt(nv.Value) end end)
	local tw = Library._anim.move(nv, { Value = to }, dur or "fast")
	local function finish() if nv.Parent then label.Text = fmt(to); nv:Destroy() end end
	if tw then tw.Completed:Connect(finish) else finish() end
end
-- Dropdown / list popup opening (after SmoothOpen): the height grows into place
-- (the frame clips) and the first 6 rows fade in 15 ms apart.
Library._anim.dropIn = function(frame, list)
	if not frame or (Library._animScale or 1) <= 0 then return end
	local full = frame.Size
	-- Opening upward (the anchor, i.e. the pointer, is below the popup): rows come in from the
	-- bottom (anchor) row first and the height is not revealed top-down (that unrolled away
	-- from the anchor); the SmoothOpen slide already rises out of the anchor.
	local up = false
	do
		local okM, m = pcall(function() return UserInputService:GetMouseLocation() end)
		if okM and m and frame.AbsoluteSize.Y > 4 then
			up = m.Y - (Library._guiInset or 0) > frame.AbsolutePosition.Y + frame.AbsoluteSize.Y * 0.5
		end
	end
	-- (Glass popups do not clip themselves; their scrolling list, sized with the frame, does.)
	local clips = frame.ClipsDescendants or (list and list:IsA("ScrollingFrame") and list.ClipsDescendants and list.Size.Y.Scale == 1)
	if full.Y.Scale == 0 and full.Y.Offset > 24 and clips and not up then
		frame.Size = UDim2.new(full.X.Scale, full.X.Offset, 0, math.floor(full.Y.Offset * 0.6))
		Library._anim.move(frame, { Size = full }, "base")
	end
	if not list then return end
	local rows = {}
	for _, r in ipairs(list:GetChildren()) do
		if r:IsA("GuiObject") and r.Visible then table.insert(rows, r) end
	end
	-- Stable: equal LayoutOrders keep the child order (the layout's order).
	local idx = {}
	for i, r in ipairs(rows) do idx[r] = i end
	table.sort(rows, function(a, b)
		if a.LayoutOrder ~= b.LayoutOrder then return a.LayoutOrder < b.LayoutOrder end
		return idx[a] < idx[b]
	end)
	for i = 1, math.min(#rows, 24) do
		local r = rows[i]
		-- (Stagger over the 6 rows nearest the anchor; the rest come with the 6th.)
		local k = up and math.min(#rows, 24) - i + 1 or i
		local d = math.min(k - 1, 5) * Library._motion.rowStagger
		for _, o in ipairs({ r, table.unpack(r:GetDescendants()) }) do
			if o:IsA("TextLabel") or o:IsA("TextButton") then
				local base = o:GetAttribute("NLFadeText")
				if type(base) == "number" and base < 1 then
					o.TextTransparency = 1
					Library._anim.fade(o, { TextTransparency = base }, "base", false, d)
				end
			end
			-- Row fills / checkboxes fade with their row (SmoothOpen only fades
			-- text and images), unless a state tween is already moving them.
			if o:IsA("GuiObject") and o.BackgroundTransparency < 1 then
				local live = _liveTweensByObject[o]
				if not (live and live.BackgroundTransparency) then
					local base = o.BackgroundTransparency
					o.BackgroundTransparency = 1
					Library._anim.raw(o, { BackgroundTransparency = base }, "base", "enter", d)
				end
			end
		end
	end
end
-- Scroll bars (any ScrollingFrame made by New with a visible bar): hidden at
-- rest, fade in on hover / scroll, out after 1 s idle. One pending check at
-- most (no per-scroll-event threads).
Library._anim.autoScrollbar = function(sf)
	task.defer(function()
		if not sf.Parent or sf.ScrollBarThickness <= 0 or sf:GetAttribute("NLScrollFade") then return end
		sf:SetAttribute("NLScrollFade", true)
		local base = sf.ScrollBarImageTransparency
		local shown, hovered, pending, seq = false, false, false, 0
		sf.ScrollBarImageTransparency = 1
		local function check()
			pending = false
			if hovered or not sf.Parent then return end
			shown = false
			Library._anim.fade(sf, { ScrollBarImageTransparency = 1 }, "slow", true)
		end
		local function wake()
			seq = seq + 1
			if not shown then
				shown = true
				Library._anim.fade(sf, { ScrollBarImageTransparency = base }, "fast")
			end
			if not pending then
				pending = true
				local function later(mySeq)
					task.delay(1, function()
						if seq ~= mySeq then later(seq) else check() end
					end)
				end
				later(seq)
			end
		end
		sf.MouseEnter:Connect(function() hovered = true; wake() end)
		sf.MouseLeave:Connect(function() hovered = false; wake() end)
		sf:GetPropertyChangedSignal("CanvasPosition"):Connect(wake)
	end)
end
-- Size change that glides while shown (fast), instant while hidden.
Library._anim.size = function(obj, size)
	if obj.Size == size then return end
	if obj.Visible and obj.AbsoluteSize.X > 0 then Library._anim.move(obj, { Size = size }, "fast") else Tween(obj, { Size = size }, 0) end
end
-- Key chip "listening": the text breathes (0.5 s Sine, looping) until a key is
-- taken; the commit flashes the chip (accent tint fading back, slow).
Library._anim._pulses = setmetatable({}, { __mode = "k" })
Library._anim.listen = function(chip, on)
	local was = chip:GetAttribute("NLListening") == true
	if on == was then return end
	chip:SetAttribute("NLListening", on)
	local p = Library._anim._pulses[chip]
	if p then p:Cancel(); Library._anim._pulses[chip] = nil end
	if on then
		chip.TextTransparency = 0
		if (Library._animScale or 1) > 0 then
			local ok, tw = pcall(function()
				return TweenService:Create(chip, TweenInfo.new(0.5 * Library._animScale, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { TextTransparency = 0.65 })
			end)
			if ok and tw then Library._anim._pulses[chip] = tw; tw:Play() end
		end
	else
		chip.TextTransparency = 0
		local base = chip.BackgroundColor3
		local accent = Library._accentNow()
		chip.BackgroundColor3 = base:Lerp(accent, 0.55)
		Library._motionExact = true
		local map = Library._themeMap; Library._themeMap = nil
		pcall(Tween, chip, { BackgroundColor3 = base }, Library._motion.slow, Library._motion.color[1], Library._motion.color[2])
		Library._themeMap = map; Library._motionExact = nil
	end
end
-- Library._setC with a colour cross-fade (keeps the theme base like _setC).
Library._anim.setColor = function(obj, prop, c, dur)
	if not obj or not obj.Parent then return end
	local from = obj[prop]
	Library._setC(obj, prop, c)
	if (Library._animScale or 1) <= 0 or obj[prop] == from then return end
	local to = obj[prop]
	obj[prop] = from
	Library._motionExact = true
	-- (Already theme-mapped: skip Tween's map by tweening the final value directly.)
	local map = Library._themeMap
	Library._themeMap = nil
	pcall(Tween, obj, { [prop] = to }, type(dur) == "string" and Library._motion[dur] or dur or Library._motion.colorT,
		Library._motion.color[1], Library._motion.color[2])
	Library._themeMap = map
	Library._motionExact = nil
end
-- Ends a popup's open slide (SmoothOpen): back on its resting place, unless its
-- owner has re-placed it meanwhile.
Library._popupSlideStop = function(frame)
	local nv = frame:FindFirstChild("_SlideValue")
	local off, at = frame:GetAttribute("NLSlideOff"), frame:GetAttribute("NLSlideAt")
	frame:SetAttribute("NLSlideOff", nil); frame:SetAttribute("NLSlideAt", nil)
	if nv then nv:Destroy() end
	if type(off) == "number" and off ~= 0 and typeof(at) == "UDim2" and frame.Position == at then
		frame.Position = UDim2.new(at.X.Scale, at.X.Offset, at.Y.Scale, at.Y.Offset - off)
	end
end
-- Wires hover lighten + press scale onto a clickable once.
Library._anim.button = function(btn, hoverProps, restProps)
	if not btn or btn:GetAttribute("NLPressAnim") then return end
	btn:SetAttribute("NLPressAnim", true)
	if hoverProps and restProps then
		btn.MouseEnter:Connect(function() if not Library._noHover then Library._anim.color(btn, hoverProps) end end)
		btn.MouseLeave:Connect(function() Library._anim.color(btn, restProps) end)
	end
	btn.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Library._anim.press(btn, true) end
	end)
	btn.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Library._anim.press(btn, false) end
	end)
	btn.MouseLeave:Connect(function() Library._anim.press(btn, false) end)
end

-- Live accent (focus rings, outlines, flashes): the window's current accent (Library._accent,
-- kept by the accent picker, which Win:SetTheme also drives), else the palette's, else Dark's.
Library._accentNow = function()
	local pal = Library._themePal
	return Library._accent or (pal and pal.accent) or Library._themes.Dark.accent
end
-- Text input focus outline: a 1px accent stroke fades in on the field's plate
-- (the TextBox itself when it has a background, else its parent) and out on blur.
-- The accent is read on every focus; blur returns the stroke to its themed base.
Library._focusRing = function(box, on)
	if not box or not box.Parent or not box:FindFirstAncestor("NLUI") then return end
	local host = box
	if box.BackgroundTransparency >= 1 and box.Parent:IsA("GuiObject") then host = box.Parent end
	local ring = host:FindFirstChild("_FocusRing")
	local own = not ring and host:FindFirstChildOfClass("UIStroke")
	if own then
		if on and not own:GetAttribute("Focused") then
			-- Plate already has a stroke: tint that one; remember its dark-space base (re-themed on blur).
			own:SetAttribute("Focused", true)
			own:SetAttribute("FocusBase", own.Transparency)
			own:SetAttribute("FocusColor", own:GetAttribute("ThemeBase_Color") or own.Color)
		end
		if on then
			Library._anim.raw(own, { Color = Library._accentNow(), Transparency = 0.2 }, 0.15)
		elseif own:GetAttribute("Focused") then
			own:SetAttribute("Focused", nil)
			Library._anim.setColor(own, "Color", own:GetAttribute("FocusColor") or own.Color, 0.2)
			Library._anim.raw(own, { Transparency = own:GetAttribute("FocusBase") or own.Transparency }, 0.2)
		end
		return
	end
	if not ring then
		if not on then return end
		ring = Instance.new("UIStroke")
		ring.Name = "_FocusRing"
		ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		ring.Thickness = 1
		ring.Transparency = 1
		ring.Parent = host
	end
	if on then ring.Color = Library._accentNow() end
	Library._anim.raw(ring, { Transparency = on and 0.25 or 1 }, on and 0.15 or 0.2)
end

