-- Active outline: accent 0.55 when active, faint white hairline otherwise (fades in on a switch).
Library._groupsUI.outline = function(obj, active, accent, fadeIn)
	local st = New("UIStroke", { Name = "PresetOutline", ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 1 }, obj)
	st.Color = active and (accent or Library._accentNow()) or Library._sel.white
	st.Transparency = active and 0.55 or 0.92
	if active then obj:SetAttribute("ActivePreset", true) end
	if active and fadeIn then
		st.Transparency = 0.92
