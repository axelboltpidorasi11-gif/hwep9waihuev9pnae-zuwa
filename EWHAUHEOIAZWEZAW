-- Glass popup under MainFrame (one open at a time). ctx = { main, safe(), place(f, x, y) }.
-- o = { Name, Width, Side ("right" = beside the anchor), Align ("center"), Pad, Gap, MaxHeight, OnClose }.
-- pop.body gets the rows; pop.open(contentHeight).
Library._invPopup = function(ctx, anchor, o)
	o = o or {}
	if Library._invOpenPopup then Library._invOpenPopup.close() end
	local pad = o.Pad or 6
	local f = New("Frame", {
		Name = o.Name or "InvPopup", Size = UDim2.fromOffset(o.Width or 240, 40), BackgroundColor3 = Color3.fromRGB(11, 12, 18),
		BorderSizePixel = 0, Visible = false,
	}, ctx.main)
	New("UICorner", { CornerRadius = UDim.new(0, 12) }, f)
	Stroke(f)
	local body = New("ScrollingFrame", {
		Name = "PopupBody", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y,
	}, f)
	Library._sel.scrollbar(body)
	New("UIPadding", { PaddingTop = UDim.new(0, pad), PaddingBottom = UDim.new(0, pad), PaddingLeft = UDim.new(0, o.PadX or pad), PaddingRight = UDim.new(0, o.PadX or pad) }, body)
	New("UIListLayout", { Padding = UDim.new(0, o.Gap or 0), SortOrder = Enum.SortOrder.LayoutOrder }, body)
	local pop = { frame = f, body = body }
	local closed = false
	function pop.close()
		if closed then return end
		closed = true
		if Library._invOpenPopup == pop then Library._invOpenPopup = nil end
		UnregisterPopup(f)
		if o.OnClose then pcall(o.OnClose) end
		SmoothClose(f, 0.12, function() if f.Parent then f:Destroy() end end)
	end
	function pop.place()
		if closed or not f.Parent or not anchor or not anchor.Parent then return end
		local sp, ss = ctx.safe()
		local fs = f.AbsoluteSize
		local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
		local x, y
		if o.Side == "right" then
			x = ap.X + as.X + 8
			y = ap.Y + as.Y / 2 - fs.Y * 0.4
		else
			x = o.Align == "center" and (ap.X + as.X / 2 - fs.X / 2) or ap.X
			y = ap.Y + as.Y + 6
			if y + fs.Y > sp.Y + ss.Y - 6 then y = ap.Y - fs.Y - 6 end
		end
		x = math.clamp(x, sp.X + 6, math.max(sp.X + 6, sp.X + ss.X - fs.X - 6))
		y = math.clamp(y, sp.Y + 6, math.max(sp.Y + 6, sp.Y + ss.Y - fs.Y - 6))
		ctx.place(f, x, y)
	end
	function pop.open(h)
		f.Size = UDim2.fromOffset(o.Width or 240, math.max(36, math.min(h + pad * 2, o.MaxHeight or 440)))
		ApplyZIndexLadder(f, NextPopupZ())
		f.Visible = true
		pop.place()
		SmoothOpen(f, 0.04, 0.16)
		RegisterPopup(f, pop.close, anchor)
		task.defer(pop.place)
	end
	Library._invOpenPopup = pop
	return pop
end
-- Glass list: o = { Title, Values = { "x" | { name, id, icon, image, rarity } }, Current (name or id),
-- OnPick(v, i), Width, Align, Side }.
Library._invList = function(ctx, anchor, o)
	local values = o.Values or {}
	local hasIcon = false
	local w = o.Width or 150
	for _, v in ipairs(values) do
		local name = type(v) == "table" and tostring(v.name or v[1]) or tostring(v)
		local ic = type(v) == "table" and (v.icon or v.image)
		if ic then hasIcon = true end
		w = math.max(w, math.ceil(MeasureText(name, 13, FONT)) + (ic and 76 or 44))
	end
	if o.Title then w = math.max(w, math.ceil(MeasureText(o.Title, 14, FONT)) + 40) end
	-- Shared selection look (Library._sel): rows, gap, caption title, accent pick + check.
	local SL = Library._sel
	local pop = Library._invPopup(ctx, anchor, { Name = "InvList", Width = math.min(w, 300), Align = o.Align, Side = o.Side, MaxHeight = o.MaxHeight or 360, Gap = SL.gap })
	local H, order = -SL.gap, 0
	if o.Title then
		local title = New("TextLabel", {
			Name = "ListTitle", Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = o.Title, TextColor3 = SL.captionColor,
			TextSize = 14, Font = FONT, LayoutOrder = 0, TextXAlignment = Enum.TextXAlignment.Left,
		}, pop.body)
		New("UIPadding", { PaddingLeft = UDim.new(0, SL.padL) }, title)
		Library._sel.caption(title)
		H = H + 24 + SL.gap
	end
	for i, v in ipairs(values) do
		order = order + 1
		local isT = type(v) == "table"
		local name = isT and tostring(v.name or v[1]) or tostring(v)
		local sel = o.Current ~= nil and (name == o.Current or (isT and v.id ~= nil and v.id == o.Current))
		local row = New("TextButton", {
			Name = "ListOption", Size = UDim2.new(1, 0, 0, SL.h()), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = sel and SL.selBgAlpha or 1, AutoButtonColor = false, Text = "", LayoutOrder = order,
		}, pop.body)
		row:SetAttribute("Sel", sel or nil)
		New("UICorner", { CornerRadius = UDim.new(0, SL.radius) }, row)
		if sel then
			New("ImageLabel", {
				Name = "SelectedCheck", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1, Image = "rbxassetid://138494545053627", ImageColor3 = SL.tick,
			}, row)
		end
		local x = SL.padL
		if hasIcon then
			local holder = New("Frame", { Name = "ListIconBox", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.fromOffset(30, 23), BackgroundTransparency = 1 }, row)
			if isT and v.image then
				New("ImageLabel", { Name = "ListImage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = v.image, ScaleType = Enum.ScaleType.Fit, NoTheme = true }, holder)
			elseif isT and v.icon then
				Library._icon(holder, v.icon, 16, sel and SL.selText or Color3.fromRGB(214, 217, 226))
			end
			x = 46
		end
		if isT and v.rarity and not hasIcon then
			local rb = New("Frame", { Name = "ListRarity", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(3, 14), BackgroundColor3 = Library._rarityColor(v.rarity), BorderSizePixel = 0 }, row)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, rb)
			x = 22
		end
		New("TextLabel", {
			Name = "ListOptionText", Position = UDim2.fromOffset(x, 0), Size = UDim2.new(1, -x - 32, 1, 0), BackgroundTransparency = 1,
			Text = name, TextColor3 = sel and SL.selText or SL.unselText, TextSize = SL.textSize, Font = FONT,
			TextXAlignment = o.Center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, row)
		if Library._listRowHover then Library._listRowHover(row, row) end
		row.MouseButton1Click:Connect(function()
			if Library._swiped and Library._swiped() then return end
			pop.close()
			if o.OnPick then o.OnPick(v, i) end
		end)
		H = H + SL.h() + SL.gap
	end
	pop.open(H)
	if Library._anim.dropIn then Library._anim.dropIn(pop.frame, pop.body) end
	return pop
end

