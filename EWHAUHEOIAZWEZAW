-- Chips per card row and the card height for n weapons (+ the "+" chip).
Library._groupsUI.cardH = function(n)
	local D = Library._groupsUI.dims()
	local inner = D.w - 20 - D.pad * 2
	local k = math.max(math.floor((inner + D.gap) / (D.chipW + D.gap)), 1)
	local rows = math.ceil((n + 1) / k)
	return D.head + rows * D.chipH + (rows - 1) * D.gap + D.pad, k
end
-- One weapon chip (dark pill + silhouette); hover shows an x, click removes (phones: first tap
-- arms the x, a second tap removes).
Library._groupsUI.chip = function(box, item, x, y, z, onRemove, pop)
	local S, D = Library._sel, Library._groupsUI.dims()
	local c = New("TextButton", {
		Name = "WeaponChip", Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(D.chipW, D.chipH), BackgroundColor3 = S.chipOff,
		BackgroundTransparency = 0, AutoButtonColor = false, Text = "", ZIndex = z,
	}, box)
	c:SetAttribute("Weapon", item)
	New("UICorner", { CornerRadius = UDim.new(0, S.chipR) }, c)
	local icon = Library._weaponIcon(item, c, D.chipW - 14, D.chipH - 12, S.text, z + 1)
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	local xb = New("Frame", {
		Name = "ChipRemove", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 3, 0, -3), Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.fromRGB(58, 62, 80), BorderSizePixel = 0, Visible = false, ZIndex = z + 3,
	}, c)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, xb)
	Library._glyph("close", xb, 8, S.selText, z + 4)
	local armed = false
	local function show(on)
		armed = on
		xb.Visible = on
		Library._setC(c, "BackgroundColor3", on and S.chipHoverBg or S.chipOff)
		for _, d in ipairs(icon:GetDescendants()) do
			if d:IsA("ImageLabel") then Tween(d, { ImageTransparency = on and 0.35 or 0 }, 0.1) end
		end
	end
	c.MouseEnter:Connect(function() if Library._hoverBlocked(c) then return end show(true) end)
	c.MouseLeave:Connect(function() show(false) end)
	c.MouseButton1Click:Connect(function()
		if Library._swiped and Library._swiped() then return end
		if Library._noHover and not armed then
			show(true)
			task.delay(2.5, function() if c.Parent then show(false) end end)
			return
		end
		onRemove(item)
	end)
	if pop and (Library._animScale or 1) > 0 then
		-- Added just now: pops in (0.6 -> 1, soft overshoot).
		local sc = Library._anim.scaleOf(c)
		if sc then sc.Scale = 0.6; Library._anim.tween(sc, { Scale = 1 }, "base", "spring") end
	end
	return c
