	["138,141,152"] = Color3.fromRGB(110, 114, 126), ["112,116,138"] = Color3.fromRGB(110, 114, 126),
	["190,192,200"] = Color3.fromRGB(110, 114, 126),
	-- Neutral selection (Library._sel): picked text / tick, unpicked text.
	["245,246,250"] = Color3.fromRGB(16, 18, 26), ["190,193,205"] = Color3.fromRGB(84, 88, 100),
	-- Plate row icons, arrow-row values, dimmed (unticked) list entries.
	["206,209,220"] = Color3.fromRGB(60, 64, 76), ["150,154,168"] = Color3.fromRGB(104, 108, 122), ["138,142,156"] = Color3.fromRGB(112, 116, 130),
