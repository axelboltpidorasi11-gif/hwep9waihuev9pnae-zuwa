	-- side switched (S.setSide): the item worn in the same slot on the new side
	function S.vwSide()
		local V = S.fs
		if not V or not V.item then return end
		local side = state.side
		local it = V.key and S.item(state.slots[side][V.key]) or nil
		if not it and not S.onSide(V.item, side) then
			for _, x in ipairs(S.catItems(V.item.category, side)) do it = x break end
		end
		S.vwShow(it or V.item, V.key)
	end
	function S.vwShow(it, key, first)
		local V = S.fs
		if not V or not it then return end
		local newItem = V.item ~= it
		V.item, V.key = it, key or V.key
		local cat = S.cats[it.category] or {}
		V.baseMode = (cat.kind == "items" or cat.kind == "stickers") and "items" or "skins"
		if newItem or first then
			V.mode, V.sticker = V.baseMode, nil
			V.search.Text = ""
		end
		S.vwHeader()
		S.vwPreview(not first)
		S.vwStrip(true)
		S.vwOptions()
		for side, e in pairs(V.sideBtns) do
			local on = side == state.side
			Library._anim.fade(e.button, { BackgroundTransparency = on and 0 or 1 }, "base", not on)
			Library._anim.fade(e.text, { TextTransparency = on and 0 or 0.45 }, "base")
		end
		V.sides.Visible = #S.sides > 1
		if first or newItem then
			V.line.Size = UDim2.new(0, 0, 0, 3)
			Library._anim.move(V.line, { Size = UDim2.new(0.34, 0, 0, 3) }, 0.4)
		end
	end
	function S.vwSkin()
		local V = S.fs
		local e = state.items[state.side][V.item.id] or {}
		return V.baseMode == "skins" and S.skinOf(V.item, e.skin) or nil, e
	end
	function S.vwHeader()
		local V = S.fs
		local it = V.item
		local skin = S.vwSkin()
		local rar = (skin and skin.rarity) or it.rarity or "Stock"
		local rc = Library._rarityColor(rar)
		V.title.Text = S.display(it)
		local first = V.baseMode == "skins" and (skin and skin.name or S.stockName(it)) or (it.collection or "")
		local hex = string.format("#%02x%02x%02x", math.floor(rc.R * 255), math.floor(rc.G * 255), math.floor(rc.B * 255))
		V.sub.Text = (first ~= "" and (first .. "   ·   ") or "") .. '<font color="' .. hex .. '">' .. Library._rarityName(rar) .. "</font>"
		Library._anim.setColor(V.line, "BackgroundColor3", rc, "base")
	end
	function S.vwPreview(animate)
		local V = S.fs
		local it = V.item
		local skin = S.vwSkin()
		local tint = S.vwColor(skin and skin.color) or S.vwColor(it.color)
		animate = animate and (Library._animScale or 1) > 0
		-- image: cross-fade between two layers
		local image = (skin and skin.image) or it.image or nil
		if image and V.imgCur ~= image then
			local new, old = V.VwImageB, V.VwImageA
			V.VwImageA, V.VwImageB = new, old
			new.Image = image
			new.ImageColor3 = (tint and not (skin and skin.image)) and Color3.new(1, 1, 1):Lerp(tint, 0.5) or Color3.new(1, 1, 1)
			if animate then
				new.ImageTransparency = 1
				Library._anim.fade(new, { ImageTransparency = 0 }, "slow")
				Library._anim.fade(old, { ImageTransparency = 1 }, "fast", true)
			else
				new.ImageTransparency, old.ImageTransparency = 0, 1
			end
		elseif not image then
			V.VwImageA.ImageTransparency, V.VwImageB.ImageTransparency = 1, 1
		end
		V.imgCur = image
		-- clean stage: the name large and faint
		local clean = not image
		V.nameBig.Visible = clean
		-- (agents: the name before " | "; long names a size smaller)
		V.nameBig.Text = string.match(it.name, "^(.-) | ") or it.name
		V.nameBig.TextSize = #V.nameBig.Text > 16 and 46 or 64
		if clean and animate then
			V.nameBig.TextTransparency = 1
			Library._anim.fade(V.nameBig, { TextTransparency = 0.9 }, "slow")
		end
		if animate then
			V.stageScale.Scale = 0.975
			Library._anim.move(V.stageScale, { Scale = 1 }, "slow")
		end
	end
	-- strip modes: "skins" (the item's skins), "items" (other items of the category, agents etc.),
	-- "stickers" (stickers for slot V.sticker)
	function S.vwSetMode(mode, slot)
		local V = S.fs
		if not V then return end
		V.mode = mode
		V.sticker = mode == "stickers" and (slot or V.sticker or 1) or V.sticker
		V.search.Text = ""
		S.vwStrip(true)
		S.vwOptions()
	end
	function S.vwStrip(full)
		local V = S.fs
		local it, side = V.item, state.side
		local cat = S.cats[it.category] or {}
		local skin, e = S.vwSkin()
		local list, sel = {}, nil
		if V.mode == "skins" then
			table.insert(list, Library._invNorm({ name = S.stockName(it), rarity = "Stock", image = it.image, id = "__stock" }))
			for _, s in ipairs(it.skins) do table.insert(list, s) end
			sel = skin and skin.id or "__stock"
		elseif V.mode == "items" then
			list = cat.kind == "stickers" and S.stickers or S.catItems(it.category, side)
			sel = it.id
		else
			for _, s in ipairs(S.stickers) do table.insert(list, s) end
			local st = type(e.stickers) == "table" and e.stickers or {}
			sel = st[tostring(V.sticker or 1)]
		end
		-- tabs: Skins / <category> + Stickers (Patches for agents)
		local nS = S.vwSlots()
		V.tabBtns.base.Text = V.baseMode == "skins" and "Skins" or (cat.name or "Items")
		V.tabBtns.stickers.Text = cat.id == "agent" and "Patches" or "Stickers"
		V.tabBtns.stickers.Visible = nS > 0
		for mode, b in pairs(V.tabBtns) do
			local on = (mode == "stickers") == (V.mode == "stickers")
			b.BackgroundTransparency = on and 0.2 or 1
			Library._setC(b, "TextColor3", on and Color3.fromRGB(236, 238, 244) or Color3.fromRGB(150, 154, 166))
		end
		if full then
			-- cards are pooled: the ones of the previous list are re-filled, the surplus is hidden
			V.pool = V.pool or {}
			table.clear(V.cards)
			local animate = (Library._animScale or 1) > 0
			for i, x in ipairs(list) do
				local card = V.pool[i]
				if not card then
					card = Library._itemCard(V.strip, {
						size = UDim2.fromOffset(132, 104), order = i, onClick = function(c) S.vwPick(c.entry) end,
					})
					card.frame.Name = "VwCard"
					ApplyZIndexLadder(card.frame, V.strip.ZIndex + 1)
					V.pool[i] = card
				end
				card.entry = x
				card.frame.LayoutOrder = i
				card.Set({ name = x.name or "", rarity = x.rarity == nil and false or x.rarity, image = x.image or "", caption = "", sub = "", empty = false })
				card.frame.Visible = true
				card.SetSelected(sel ~= nil and (x.id == sel or (V.mode == "stickers" and x.name == sel)), true)
				table.insert(V.cards, card)
				if animate and i <= 12 then
					local d = (i - 1) * Library._motion.stagger
					card.box.Position = UDim2.fromOffset(0, 8)
					card.box.BackgroundTransparency = 1
					Library._anim.move(card.box, { Position = UDim2.fromOffset(0, 0) }, "slow", d)
					Library._anim.fade(card.box, { BackgroundTransparency = 0.1 }, "slow", false, d)
				end
			end
			for i = #list + 1, #V.pool do V.pool[i].frame.Visible = false; V.pool[i].entry = nil end
			V.strip.CanvasPosition = Vector2.zero
			S.vwFilter()
			task.defer(function() S.vwScrollTo(S.vwSelIndex(), true) end)
		else
			for _, c in ipairs(V.cards) do
				c.SetSelected(sel ~= nil and (c.entry.id == sel or (V.mode == "stickers" and c.entry.name == sel)))
			end
			S.vwCount()
		end
	end
	function S.vwSlots()
		local V = S.fs
		local cat = S.cats[V.item.category] or {}
		if cat.id == "agent" then return 3 end
		if cat.kind == "items" or cat.kind == "stickers" or cat.noStickers then return 0 end
		return o.StickerSlots or 5
	end
	function S.vwSelIndex()
		local V = S.fs
		if not V then return nil end
		for i, c in ipairs(V.cards) do
			local d = c.box:FindFirstChild("SelDot")
			if d and d.Visible then return i end
		end
		return nil
	end
	function S.vwCount()
		local V = S.fs
		local n, at, idx = 0, 0, S.vwSelIndex()
		for i, c in ipairs(V.cards) do
			if c.frame.Visible then
				n = n + 1
				if i == idx then at = n end
			end
		end
		V.count.Text = (at > 0 and (at .. " / ") or "") .. n
		V.empty.Visible = n == 0
	end
	function S.vwFilter()
		local V = S.fs
		if not V then return end
		local q = string.lower(V.search.Text or "")
		for _, c in ipairs(V.cards) do
			c.frame.Visible = q == "" or string.find(string.lower(c.entry.name), q, 1, true) ~= nil
		end
		S.vwCount()
	end
	function S.vwScrollTo(i, instant)
		local V = S.fs
		local c = V and i and V.cards[i]
		if not c or not c.frame.Visible then return end
		local sf = V.strip
		local x = c.frame.AbsolutePosition.X - sf.AbsolutePosition.X + sf.CanvasPosition.X
		local want = x - (sf.AbsoluteSize.X - c.frame.AbsoluteSize.X) / 2
		local maxX = math.max(0, sf.AbsoluteCanvasSize.X - sf.AbsoluteSize.X)
		local goal = Vector2.new(math.clamp(want, 0, maxX), 0)
		if instant then sf.CanvasPosition = goal else Library._anim.tween(sf, { CanvasPosition = goal }, "slow") end
	end
	-- < > : previous / next visible card (skins / items: picks it; stickers: scrolls)
	function S.vwStep(dir)
		local V = S.fs
		if not V or #V.cards == 0 then return end
		local vis = {}
		for i, c in ipairs(V.cards) do if c.frame.Visible then table.insert(vis, i) end end
		if #vis == 0 then return end
		if V.mode == "stickers" then
			local sf = V.strip
			local maxX = math.max(0, sf.AbsoluteCanvasSize.X - sf.AbsoluteSize.X)
			Library._anim.tween(sf, { CanvasPosition = Vector2.new(math.clamp(sf.CanvasPosition.X + dir * sf.AbsoluteSize.X * 0.8, 0, maxX), 0) }, "slow")
			return
		end
		local cur, at = S.vwSelIndex(), 0
		for k, i in ipairs(vis) do if i == cur then at = k end end
		local k = at == 0 and (dir > 0 and 1 or #vis) or ((at - 1 + dir) % #vis + 1)
		S.vwPick(V.cards[vis[k]].entry)
	end
	function S.vwPick(x)
		local V = S.fs
		if not V or not x then return end
		local side, it = state.side, V.item
		if V.mode == "skins" then
			local e = S.entry(side, it.id)
			local nv = x.id ~= "__stock" and x.name or nil
			if e.skin == nv then return end
			e.skin = nv
			fire("OnSkinChanged", side, it.id, e.skin, x)
			S.vwHeader()
			S.vwPreview(true)
			S.vwStrip(false)
		elseif V.mode == "items" then
			local nx = S.item(x.id) or x
			if nx == it then return end
			V.item = nx
			S.vwHeader()
			S.vwPreview(true)
			S.vwStrip(false)
			S.vwOptions()
		else
			local e = S.entry(side, it.id)
			e.stickers = type(e.stickers) == "table" and e.stickers or {}
			local k = tostring(V.sticker or 1)
			e.stickers[k] = e.stickers[k] ~= x.name and x.name or nil
			fire("OnSticker", side, it.id, V.sticker or 1, e.stickers[k])
			fire("OnOptionsChanged", side, it.id, e)
			S.vwStrip(false)
			S.vwOptions()
		end
		S.vwScrollTo(S.vwSelIndex())
		S.refreshMain(false)
		if S.P and S.P.open and S.cur and S.cur.item == it then S.render(false) end
	end
	function S.vwEquip()
		local V = S.fs
		if not V or not V.key or not V.item then return end
		local side, key, it = state.side, V.key, V.item
		if state.slots[side][key] == it.id then return end
		state.slots[side][key] = it.id
		fire("OnEquip", side, key, it.id, it)
		if S.P and S.P.open and S.cur and S.cur.key == key then
			S.cur.item = it
			S.cur.cat = S.cats[it.category] or S.cur.cat
		end
		S.refreshMain(false)
		S.vwOptions()
	end
	-- right panel: name tag / seed, wear (+ caret slider), StatTrak, sticker slots; footer state
	function S.vwOptions()
		local V = S.fs
		local it, side = V.item, state.side
		local cat = S.cats[it.category] or {}
		for _, c in ipairs(V.optConns) do c:Disconnect() end
		table.clear(V.optConns)
		for _, c in ipairs(V.optBody:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		local e = S.entry(side, it.id)
		local order = 0
		local function changed(k, v) e[k] = v; fire("OnOptionsChanged", side, it.id, e) end
		local function card(h)
			order = order + 1
			local c = New("Frame", { Name = "OptCard", Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = Color3.fromRGB(24, 26, 36), BackgroundTransparency = 0.45, BorderSizePixel = 0, LayoutOrder = order }, V.optBody)
			New("UICorner", { CornerRadius = UDim.new(0, 10) }, c)
			local st = Stroke(c, "CardStroke"); st.Transparency = 0.95
			New("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 10) }, c)
			return c
		end
		local function row(c, y, text, dim)
			local r = New("Frame", { Name = "OptRow", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, c)
			New("TextLabel", {
				Name = "OptLabel", Size = UDim2.new(0.55, 0, 1, 0), BackgroundTransparency = 1, Text = text,
				TextColor3 = dim and Color3.fromRGB(112, 116, 128) or Color3.fromRGB(205, 208, 218), TextSize = 13, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left,
			}, r)
			return r
		end
		local function field(r, k, numeric, ph)
			local t = Library._invBox(r, ph or "", { Name = "OptBox", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(110, 22), Text = e[k] ~= nil and tostring(e[k]) or "" })
			t.FocusLost:Connect(function()
				if numeric then
					local v = tonumber(t.Text)
					if v then v = math.max(0, math.floor(v)) end
					t.Text = v and tostring(v) or ""
					changed(k, v)
				else
					changed(k, t.Text ~= "" and t.Text or nil)
				end
			end)
			return t
		end
		local skinnable = V.baseMode == "skins" and not cat.noOptions
		V.optTitle.Text = "Options"
		if skinnable then
			local c1 = card(64)
			field(row(c1, 2, "Name Tag"), "name", false, "")
			field(row(c1, 32, "Seed"), "seed", true, "0")
			-- wear: preset name (click = next preset) + float bar with a caret (drag / click)
			local c2 = card(72)
			local r = row(c2, 2, "Wear")
			local wearBtn = New("TextButton", {
				Name = "OptValue", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(130, 22), BackgroundTransparency = 1,
				AutoButtonColor = false, Text = "", TextColor3 = Color3.fromRGB(205, 208, 218), TextSize = 13, Font = FONT, TextXAlignment = Enum.TextXAlignment.Right,
			}, r)
			local sr = New("Frame", { Name = "OptRow", Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 }, c2)
			local track = New("Frame", { Name = "WearBar", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -9), Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = Color3.fromRGB(40, 42, 54), BorderSizePixel = 0 }, sr)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
			local fill = New("Frame", { Name = "WearFill", Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Library._invAccent(), BorderSizePixel = 0 }, track)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
			local ft = New("TextLabel", { Name = "FloatValue", Size = UDim2.fromOffset(44, 13), BackgroundTransparency = 1, Text = "", TextColor3 = Color3.fromRGB(150, 154, 166), TextSize = 11, Font = FONT }, sr)
			local caret = New("Frame", { Name = "WearMarker", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0, 0, 0, 1), Size = UDim2.fromOffset(9, 5), BackgroundTransparency = 1 }, track)
			for i = 1, 5 do
				New("Frame", {
					Name = "CaretRow" .. i, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, i - 1), Size = UDim2.fromOffset(11 - i * 2, 1),
					BackgroundColor3 = Color3.fromRGB(236, 238, 244), BorderSizePixel = 0,
				}, caret)
			end
			local function wearName(f)
				for _, w in ipairs(D.wear) do if f <= w[1] then return w[2] end end
				return D.wear[#D.wear][2]
			end
			local function setFloat(f, commit)
				f = math.clamp(math.floor(f * 1000 + 0.5) / 1000, 0, 1)
				e.float = f
				caret.Position = UDim2.new(f, 0, 0, 1)
				fill.Size = UDim2.new(f, 0, 1, 0)
				ft.AnchorPoint, ft.Position = Vector2.new(f, 0), UDim2.new(f, 0, 0, 0)
				ft.Text = string.format("%.3f", f)
				wearBtn.Text = wearName(f) .. "  ›"
				if commit then fire("OnOptionsChanged", side, it.id, e) end
			end
			wearBtn.MouseButton1Click:Connect(function()
				local cur = wearName(e.float or 0)
				for i, w in ipairs(D.wear) do
					if w[2] == cur then setFloat(D.wear[i % #D.wear + 1][3], true) break end
				end
			end)
			local hit = New("TextButton", { Name = "WearHit", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, sr)
			local dragging = false
			local function at(x)
				local a, w = track.AbsolutePosition.X, track.AbsoluteSize.X
				if w > 0 then setFloat((x - a) / w, false) end
			end
			hit.InputBegan:Connect(function(input) if IsPrimaryInput(input) then dragging = true; at(input.Position.X) end end)
			table.insert(V.optConns, UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then at(input.Position.X) end
			end))
			table.insert(V.optConns, UserInputService.InputEnded:Connect(function(input)
				if dragging and IsPrimaryInput(input) then dragging = false; fire("OnOptionsChanged", side, it.id, e) end
			end))
			setFloat(e.float or 0, false)
			-- StatTrak
			local c3 = card(64)
			local stBox
			Library._invSwitch(row(c3, 2, "StatTrak™"), e.stattrak == true, function(on)
				changed("stattrak", on)
				if stBox then stBox.TextTransparency = on and 0 or 0.55 end
			end)
			stBox = field(row(c3, 32, "Value", true), "stcount", true, "0")
			stBox.TextTransparency = e.stattrak and 0 or 0.55
		end
		-- sticker / patch slots: click = pick for that slot in the strip; Remove clears it
		local nS = S.vwSlots()
		if nS > 0 then
			local c4 = card(76)
			local r = row(c4, 2, cat.id == "agent" and "Patches" or "Stickers")
			local stickers = type(e.stickers) == "table" and e.stickers or {}
			local active = V.mode == "stickers" and (V.sticker or 1) or nil
			if active and stickers[tostring(active)] then
				local rm = New("TextButton", {
					Name = "OptRemove", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(70, 22), BackgroundTransparency = 1,
					AutoButtonColor = false, Text = "Remove", TextColor3 = Color3.fromRGB(226, 84, 84), TextSize = 13, Font = FONT, TextXAlignment = Enum.TextXAlignment.Right,
				}, r)
				rm.MouseButton1Click:Connect(function()
					stickers[tostring(active)] = nil
					e.stickers = stickers
					fire("OnSticker", side, it.id, active, nil)
					fire("OnOptionsChanged", side, it.id, e)
					S.vwStrip(false)
					S.vwOptions()
				end)
			end
			local holder = New("Frame", { Name = "StickerSlots", Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1 }, c4)
			New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, holder)
			for i = 1, nS do
				local name = stickers[tostring(i)]
				local st
				for _, x in ipairs(S.stickers) do if x.name == name then st = x end end
				local b = New("TextButton", {
					Name = "VwStickerSlot" .. i, LayoutOrder = i, Size = UDim2.fromOffset(30, 30),
					BackgroundColor3 = st and Library._rarityColor(st.rarity) or Color3.fromRGB(44, 47, 60), BackgroundTransparency = st and 0.15 or 0.25,
					AutoButtonColor = false, Text = (st and not st.image) and string.upper(string.sub(st.name, 1, 1)) or (st and "" or "+"),
					TextColor3 = st and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 154, 166), TextSize = st and 12 or 15, Font = FONT_BOLD,
				}, holder)
				New("UICorner", { CornerRadius = UDim.new(1, 0) }, b)
				if st and st.image then
					New("ImageLabel", { Name = "StickerImage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = st.image, ScaleType = Enum.ScaleType.Fit, NoTheme = true }, b)
				end
				local ring = Instance.new("UIStroke"); ring.Name = "SlotRing"; ring.Thickness = 1.5; ring.Color = Library._invAccent(); ring.Transparency = active == i and 0 or 1; ring.Parent = b
				b.MouseButton1Click:Connect(function()
					if Library._swiped and Library._swiped() then return end
					if V.mode == "stickers" and V.sticker == i then S.vwSetMode(V.baseMode) else S.vwSetMode("stickers", i) end
				end)
			end
		end
		if not skinnable and nS == 0 then
			order = order + 1
			New("TextLabel", {
				Name = "OptEmpty", Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = order, Text = "No options for this item.",
				TextColor3 = Color3.fromRGB(112, 116, 128), TextSize = 13, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left,
			}, V.optBody)
		end
		-- footer: Equip (or Equipped) for the slot it is viewed for
		local worn = V.key and state.slots[side][V.key] == it.id
		V.equip.Visible = V.key ~= nil
		V.equip.Text = worn and "Equipped" or "Equip"
		V.equip.TextTransparency = worn and 0.4 or 0
		V.apply.Visible = not cat.noOptions
		ApplyZIndexLadder(V.optBody, V.optBody.ZIndex)
	end

	-- -------------------------------------------------------------- config + API
	W._configExtras["inventory_" .. tostring(o.ConfigKey or ctx.name or "inventory")] = {
		get = function() return { side = state.side, slots = state.slots, items = state.items } end,
		set = function(v)
			if type(v) ~= "table" then return end
			for _, s in ipairs(S.sides) do
				state.slots[s] = type(v.slots) == "table" and type(v.slots[s]) == "table" and v.slots[s] or {}
				state.items[s] = type(v.items) == "table" and type(v.items[s]) == "table" and v.items[s] or {}
				S.defaults(s)
			end
			local side = state.side
			for _, s in ipairs(S.sides) do if s == v.side then side = s end end
			state.side = side
			S.layoutSides(true)
			if S.P and S.P.open then S.closePicker(true) end
			S.refreshMain(true)
			if S.fs then S.vwShow(S.fs.item, S.fs.key) end
		end,
	}
	local api = { frame = page, _s = S }
	function api:GetSide() return state.side end
	function api:SetSide(side) for _, s in ipairs(S.sides) do if s == side and s ~= state.side then S.setSide(s) end end return self end
	function api:GetState() return state end
	function api:SetState(v) W._configExtras["inventory_" .. tostring(o.ConfigKey or ctx.name or "inventory")].set(v) return self end
	function api:Open(keyOrItem)
		if S.slotByKey[keyOrItem] then S.openPicker(keyOrItem) return self end
		for key, id in pairs(state.slots[state.side]) do if id == keyOrItem then S.openPicker(key) return self end end
		return self
	end
	function api:Close() S.closePicker() return self end
	-- item viewer: itemId or an item entry ({ id = ... }); no argument = the picker's item
	function api:OpenFullscreen(target) S.openFs(target) return self end
	function api:CloseFullscreen() S.closeFs() return self end
	function api:IsFullscreen() return S.fs ~= nil end
	function api:Equip(side, slotKey, itemId)
		side = side or state.side
		if state.slots[side] and S.slotByKey[slotKey] then
			state.slots[side][slotKey] = itemId
			fire("OnEquip", side, slotKey, itemId, S.item(itemId))
			S.refreshMain(false)
		end
		return self
	end
	function api:SetSkin(side, itemId, skinName)
		side = side or state.side
		if state.items[side] then
			S.entry(side, itemId).skin = skinName
			fire("OnSkinChanged", side, itemId, skinName)
			S.refreshMain(false)
		end
		return self
	end
	function api:GetEntry(side, itemId) return state.items[side or state.side][itemId] end
	function api:GetEquipped(side)
		side = side or state.side
		local out = {}
		for key, id in pairs(state.slots[side]) do
			local e = state.items[side][id] or {}
			out[key] = { item = id, skin = e.skin, options = e }
		end
		return out
	end
	function api:Refresh()
		S.loadItems()
		for _, s in ipairs(S.sides) do S.defaults(s) end
		S.refreshMain(true)
		if S.P and S.P.open then S.render(true) end
		return self
	end
	-- timings in ms of the heavy steps (Library._invPerf: build, picker, options, viewer; *_again = later opens)
	local perf = { build = (os.clock() - tBuild) * 1000 }
	Library._invPerf = perf
	local function timed(name, fn)
		return function(...)
			local t0 = os.clock()
			local r = fn(...)
			perf[perf[name] and (name .. "_again") or name] = (os.clock() - t0) * 1000
			return r
		end
	end
	S.openPicker, S.openOptions, S.openFs = timed("picker", S.openPicker), timed("options", S.openOptions), timed("viewer", S.openFs)
	return api
end
