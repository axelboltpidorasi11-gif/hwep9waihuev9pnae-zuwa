			local okR, prev = pcall(function() return isfile("NLUI_icons/caps.txt") and readfile("NLUI_icons/caps.txt") end)
			local badExec, badAt = nil, nil
			if okR and type(prev) == "string" then badExec, badAt = string.match(prev, "^bad (.*)|(%d+)%s*$") end
			if badExec == exec and tonumber(badAt) and os.time() - tonumber(badAt) < 86400 then
				caps.custom, caps.reason, caps.remembered = false, "pack images did not load (checked < 24 h ago)", true
			end
		else
			caps.reason = "getcustomasset failed"
		end
	end
	if not caps.custom then warn("[NLUI] icons: " .. caps.reason .. " -> using Roblox icon sheet / drawn icons") end
	if caps.custom then task.delay(1, Library._iconVerify) end
	-- Remembered failure: still re-checked in the background every launch; a success clears the
	-- verdict so the next launch uses the pack (no live swap, so a false positive cannot flicker).
	if caps.remembered then
		task.spawn(function()
			pcall(function()
				game:GetService("ContentProvider"):PreloadAsync({ caps.probeId }, function(_, status)
					if status == Enum.AssetFetchStatus.Success then pcall(writefile, "NLUI_icons/caps.txt", "retry") end
				end)
			end)
		end)
	end
	return caps
end
-- IsLoaded stays false for an image that was never rendered (hidden tab, closed popup, collapsed
-- sub-tab list), even though the asset is fine, so a "not loaded after 4 s" check must only judge
-- icons that are really visible. true = load failed, false = fine, nil = cannot tell yet (hidden).
Library._imgFailed = function(icon)
	local ok, loaded = pcall(function() return icon.IsLoaded end)
	if not ok then return false end
	if loaded ~= false then return false end
	local o = icon
	while o and o:IsA("GuiObject") do
		if not o.Visible then return nil end
		o = o.Parent
	end
	if o and o:IsA("ScreenGui") and not o.Enabled then return nil end
	if icon.AbsoluteSize.X <= 0 or icon.AbsoluteSize.Y <= 0 then return nil end
	return true
end
-- Runs onFail() when the icon is judged failed: first look after `wait` seconds; while the icon is
-- hidden it looks again every 4 s (max 20 times). stillMine() tells whether the icon still shows the
-- image this check was started for.
Library._imgWatch = function(icon, wait, onFail, stillMine)
	local tries = 0
	local function look()
		if not icon.Parent or (stillMine and not stillMine()) then return end
		local r = Library._imgFailed(icon)
		if r == true then onFail()
		elseif r == nil and tries < 20 then tries = tries + 1; task.delay(4, look) end
	end
	task.delay(wait, look)
end
-- Pack images that never load (some executors return ids that do not render): checked once a few
-- seconds after start; if no pack icon in a gui has loaded, all of them switch to sheet/drawn.
-- Adaptive window: success as soon as any pack image reports IsLoaded or ContentProvider:PreloadAsync
-- fetched the probe image; an explicit fetch failure decides after 3 s, silence after 10 s (a slow
-- first load no longer reads as "broken"). A failure is remembered for 24 h (see _iconProbe).
Library._iconVerify = function()
	local caps = Library._iconCaps
	if not caps or Library._iconVerifying then return end
	Library._iconVerifying = true
	local t0 = os.clock()
	local fetched = nil -- nil = pending, true / false = PreloadAsync result
	if caps.probeId then
		task.spawn(function()
			pcall(function()
				game:GetService("ContentProvider"):PreloadAsync({ caps.probeId }, function(_, status)
					if status == Enum.AssetFetchStatus.Success then fetched = true
					elseif status == Enum.AssetFetchStatus.Failure then fetched = false end
				end)
			end)
		end)
	end
	local good = false
	while os.clock() - t0 < 10 do
		local loaded = 0
		for icon, how in pairs(Library._iconPaths) do
			if how == "pack" then
				local ok, isIn, isL = pcall(function() return icon:IsDescendantOf(game), icon.IsLoaded end)
				if ok and isIn and isL then loaded = loaded + 1; break end
			end
		end
		if loaded > 0 or fetched == true then good = true; break end
		if fetched == false and os.clock() - t0 >= 3 then break end
		task.wait(0.25)
	end
	Library._iconVerifying = false
	if good then pcall(writefile, "NLUI_icons/caps.txt", "ok " .. tostring(caps.executor)); return end
	local any = false
	for _, how in pairs(Library._iconPaths) do if how == "pack" then any = true; break end end
	if not any then return end
	caps.custom, caps.reason = false, "pack images do not load"
	pcall(writefile, "NLUI_icons/caps.txt", "bad " .. tostring(caps.executor) .. "|" .. tostring(os.time()))
	warn("[NLUI] icons: " .. caps.reason .. " -> switched to Roblox icon sheet / drawn icons")
	for k in pairs(Library._iconCache) do Library._iconCache[k] = false end
	for icon, how in pairs(Library._iconPaths) do
		if how == "pack" then pcall(Library._iconDowngrade, icon) end
	end
end
-- Clears the remembered verdict, puts the pack back on every icon that fell back to the sheet
-- and verifies again. Returns false + reason when the executor cannot load custom images at all.
Library._iconRetry = function()
	local caps = Library._iconProbe()
	pcall(writefile, "NLUI_icons/caps.txt", "retry")
	if not caps.probeId then return false, caps.reason end
	caps.custom, caps.reason, caps.remembered = true, "pack ok", nil
	for k in pairs(Library._iconCache) do Library._iconCache[k] = nil end
	for icon, how in pairs(Library._iconPaths) do
		local kind = icon:GetAttribute("IconKind")
		if kind and how == "sheet" then
			pcall(function()
				if icon.Parent then Library._applyIcon(icon, kind, icon:GetAttribute("IconKeepSize") == true) end
			end)
		end
	end
	task.spawn(Library._iconVerify)
	return true
end
-- A pack icon whose image does not load -> same box, sheet tile or drawn glyph.
Library._iconDowngrade = function(icon)
	local kind = icon:GetAttribute("IconPack")
	if not kind or not icon.Parent then return end
	local box = icon:GetAttribute("IconPackBox")
	if box then icon.Size = UDim2.fromOffset(box, box); icon:SetAttribute("IconPackBox", nil) end
	icon:SetAttribute("IconPack", nil)
	-- Nav icons (Library._navIcon) skip the sheet: their drawn solid glyph matches the original.
	if icon:GetAttribute("IconNoSheet") then icon.Image = ""; Library._drawIcon("s_" .. kind, icon, "draw") return end
	if not Library._applySheet(icon, kind) then Library._drawIcon(kind, icon, "glyph") end
end
-- Puts the Material sheet tile of `kind` into an image (tint = ImageColor3). True when mapped.
Library._applySheet = function(icon, kind, keepSize)
	if not icon or icon:FindFirstChild("GlyphGrid") then return false end
	local t = Library._sheet[Library._iconName(kind)] or Library._sheet[string.lower(tostring(kind or ""))]
	if not t then return false end
	icon.Image = t[1]
	icon.ImageRectOffset = t[2]
	icon.ImageRectSize = t[3]
	icon.ScaleType = Enum.ScaleType.Fit
	icon:SetAttribute("IconSheet", t[4])
	icon:SetAttribute("IconKind", Library._iconName(kind))
	if keepSize then icon:SetAttribute("IconKeepSize", true) end
	if not keepSize and icon.AnchorPoint == Vector2.new(0.5, 0.5) and icon.Size.X.Scale == 0 and icon.Size.Y.Scale == 0 and not icon:GetAttribute("IconPackBox") then
		local box = icon.Size.X.Offset
		icon:SetAttribute("IconPackBox", box)
		local n = math.floor(box * Library._sheetGrow / 2 + 0.5) * 2
		icon.Size = UDim2.fromOffset(n, n)
	end
	Library._iconMark(icon, "sheet")
	-- Sheets load everywhere in game; if one still has not (asset fetch blocked), draw instead.
	Library._imgWatch(icon, 4, function()
		local box = icon:GetAttribute("IconPackBox")
		if box then icon.Size = UDim2.fromOffset(box, box); icon:SetAttribute("IconPackBox", nil) end
		icon.ImageRectOffset = Vector2.zero
		icon.ImageRectSize = Vector2.zero
		Library._drawIcon(kind, icon, "glyph")
	end, function() return icon.Image == t[1] and icon.ImageRectOffset == t[2] end)
	return true
end
