Library._packWatch = function(root)
	if not root then return end
	Library._iconGui = Library._iconGui or root
	task.defer(Library._iconProbe)
	local function hook(d)
		if not (d:IsA("ImageLabel") or d:IsA("ImageButton")) or d:GetAttribute("PackWatch") then return end
		d:SetAttribute("PackWatch", true)
		-- Old asset stays; the pack image / sheet tile replaces it only if it has not loaded after 4 s.
		local function try()
			local img = d.Image
			local id = string.match(img, "^rbxassetid://(%d+)$")
			local name = id and Library._iconByAsset[id]
			if not name then return end
			Library._iconMark(d, "asset")
			task.delay(4, function()
				if not d.Parent or d.Image ~= img or d:FindFirstChild("GlyphGrid") or d:GetAttribute("IconNoSheet") then return end
				local ok, loaded = pcall(function() return d.IsLoaded end)
				if ok and loaded == false and not Library._applyIcon(d, name, true) then Library._drawIcon(name, d, "glyph") end
			end)
		end
		try()
		d:GetPropertyChangedSignal("Image"):Connect(try)
	end
	for _, d in ipairs(root:GetDescendants()) do hook(d) end
	root.DescendantAdded:Connect(hook)
end
