-- Every bind of the window, from the shared context targets (a section keeps only its own key map, so the
-- old per-section snapshot listed just the last section's binds). all = true: also binds hidden from the list.
-- Entry: label, key (formatted), mode, value, on (switch state), active, conflict, hidden, bind, owner, path.
Library._bindSnapshotImpl = function(W, targets, all)
	local out, counts = {}, {}
	local generic = { enabled = true, enable = true, active = true, on = true, toggle = true }
	local plain = { [""] = true, main = true, general = true, other = true, settings = true, misc = true }
	for _, target in pairs(targets) do
		if type(target) == "table" and target.binds and target.label then
			for _, b in ipairs(target.binds) do
				local key = rawget(b, "key")
				if key ~= nil and (all or rawget(b, "hideInList") ~= true) then
					local mode = rawget(b, "bindMode") or "toggle"
					local node, sec, tabn = target.row, nil, nil
					while node and not node:GetAttribute("NLTabName") do node = node.Parent end
					if node then
						sec = tostring(node:GetAttribute("NLSectionName") or "")
						tabn = tostring(node:GetAttribute("NLTabName"))
					end
					local label = target.label
					if generic[string.lower(label)] then
						label = (sec and not plain[string.lower(sec)]) and sec or (tabn or label)
					end
					local value, state, active
					local bv = rawget(b, "bindValue")
					if bv ~= nil then
						value = (bv % 1 == 0) and tostring(bv) or string.format("%.1f", bv)
						local readout = target.row and target.row:FindFirstChild("SliderValue", true)
						local unit = readout and readout:IsA("TextLabel") and string.gsub(readout.Text, "[%d%.%-%s]", "") or ""
						value = value .. unit
						active = rawget(b, "active") == true
					elseif target.obj and type(target.obj.Get) == "function" then
						local ok, v = pcall(target.obj.Get, target.obj)
						if ok and type(v) == "boolean" then
							state = v
							if not v then rawset(b, "bindOn", false) end
							active = v and (rawget(b, "bindOn") == true or mode == "always")
						else
							active = true
							if b.showValue and ok then
								if type(v) == "number" then value = (v % 1 == 0) and tostring(v) or string.format("%.1f", v)
								elseif type(v) == "string" and v ~= "" then value = #v > 12 and (v:sub(1, 11) .. "…") or v end
							end
						end
					else
						active = true
					end
					local kn = BindKeyName(key)
					counts[kn] = (counts[kn] or 0) + 1
					out[#out + 1] = { label = label, key = kn, mode = mode, value = value, on = state, active = active == true, hidden = rawget(b, "hideInList") == true,
						bind = b, owner = target, path = { tabn or "", sec or "" } }
				end
			end
		end
	end
	for _, e in ipairs(out) do e.conflict = counts[e.key] > 1 end
	local sort = W._kbSort or "Name"
	table.sort(out, function(a, b)
		if sort == "Key" and a.key ~= b.key then return a.key:lower() < b.key:lower() end
		if sort == "Active first" and a.active ~= b.active then return a.active end
		local la, lb = a.label:lower(), b.label:lower()
		if la ~= lb then return la < lb end
		return a.key < b.key
	end)
	return out
end

-- Keybinds overview (Win:OpenKeybinds()): every bind in a searchable table; click a key to rebind it (Esc
-- cancels, Backspace / Delete removes the bind), click the mode to cycle it, conflicts (one key, two
-- functions) carry a warning icon. Rebinding goes through the owning section (target.rebind / dropBind).
Library._keybindsInstall = function(ctx)
	local W, main = ctx.win, ctx.main
	local K = { open = false, query = "", rows = {} }
	W._keybinds = K
	local TEXT, DIM, MID, AMBER = Color3.fromRGB(226, 228, 236), Color3.fromRGB(112, 116, 128), Color3.fromRGB(150, 155, 172), Color3.fromRGB(255, 190, 90)
	local ROW_H, W_PANEL, H_PANEL = 44, 560, 440
	local MODES = { "toggle", "hold", "always", "release" }
