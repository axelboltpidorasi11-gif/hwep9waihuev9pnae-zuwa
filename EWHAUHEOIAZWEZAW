-- Draws `kind` into an ImageLabel/ImageButton (hides its image); the strokes follow its
-- ImageColor3 / ImageTransparency, so every tint tween drives the glyph. force = also for names
-- whose normal look is an asset image. Returns true when drawn.
Library._drawIcon = function(kind, icon, force)
	local name = string.lower(tostring(kind or ""))
	local k = Library._iconKinds[name] or Library._iconKinds[Library._iconName(name)]
	if not k and not force then return false end
	if icon:FindFirstChild("GlyphGrid") then return true end
	-- Pack image / sheet tile first. force == "glyph": the image failed -> the sheet tile (unless that
	-- is what failed), then drawn; force == "draw": drawn only.
	if force ~= "glyph" and force ~= "draw" and Library._applyIcon(icon, name) then return true end
	if force == "glyph" and not icon:GetAttribute("IconSheet") and not icon:GetAttribute("IconNoSheet") and Library._applySheet(icon, name) then return true end
	icon:SetAttribute("IconSheet", nil)
	icon.ImageRectOffset = Vector2.zero
	icon.ImageRectSize = Vector2.zero
	local grid = Instance.new("Frame")
	grid.Name = "GlyphGrid"
	grid.AnchorPoint = Vector2.new(0.5, 0.5)
	grid.Position = UDim2.fromScale(0.5, 0.5)
	grid.Size = UDim2.fromOffset(18, 18)
	grid.BackgroundTransparency = 1
	grid.ZIndex = icon.ZIndex + 1
	grid:SetAttribute("NoTheme", true)
	grid.Parent = icon
	local fit = Instance.new("UIScale")
	fit.Parent = grid
	-- Ratio of on-screen sizes, so the window's own UIScale is not applied twice.
	local function refit()
		local gw, iw = grid.AbsoluteSize.X, icon.AbsoluteSize.X
		if gw > 0 and iw > 0 then fit.Scale = fit.Scale * iw / gw end
	end
	icon:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	task.defer(refit)
	local fills, rings, cuts = {}, {}, {}
