-- builder(grid, z, color, track) -> { fill, line, ring, clip }; track(part, "fill"|"ring") records parts to tint.
Library._iconBuilder = function(grid, z, color, track)
	local T = Library._iconStroke
	local P = {}
	P.fill = function(parent, x, y, w, h, radius)
		local f = Instance.new("Frame")
		f.Position = UDim2.fromOffset(x, y)
		f.Size = UDim2.fromOffset(w, h)
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.ZIndex = z
		f.Parent = parent or grid
		local c = Instance.new("UICorner"); c.CornerRadius = radius or UDim.new(0.5, 0); c.Parent = f
		track(f, "fill")
		return f
	end
	-- Stroked bar from (x1,y1) to (x2,y2) with round caps.
	P.line = function(parent, x1, y1, x2, y2, th)
		local T = th or T
		local dx, dy = x2 - x1, y2 - y1
		local len = math.sqrt(dx * dx + dy * dy) + T
		local f = P.fill(parent, (x1 + x2) / 2 - len / 2, (y1 + y2) / 2 - T / 2, len, T)
		f.Rotation = math.deg(math.atan2(dy, dx))
		return f
	end
	-- Outline whose OUTER box is x,y,w,h (UIStroke grows outwards, so the frame is inset by T).
	P.ring = function(parent, x, y, w, h, radius, th)
		local T = th or T
		local f = Instance.new("Frame")
		f.Position = UDim2.fromOffset(x + T, y + T)
		f.Size = UDim2.fromOffset(w - 2 * T, h - 2 * T)
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.ZIndex = z
		f.Parent = parent or grid
		local c = Instance.new("UICorner"); c.CornerRadius = radius or UDim.new(0, 3); c.Parent = f
		local s = Instance.new("UIStroke")
		s.Thickness = T
		s.Color = color
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.Parent = f
		track(s, "ring")
		return f
	end
	P.clip = function(x, y, w, h, zOff)
		local f = Instance.new("Frame")
		f.Position = UDim2.fromOffset(x, y)
		f.Size = UDim2.fromOffset(w, h)
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.ClipsDescendants = true
		f.ZIndex = z + (zOff or 0)
		f.Parent = grid
		return f
	end
	-- Cut-out ("negative space") part above the solid ones (z + 1): painted in the colour that is
	-- behind the icon (Library._cutWatch keeps it in step with hover tint, active pill and theme).
	P.cut = function(parent, x, y, w, h, radius)
		local f = Instance.new("Frame")
		f.Position = UDim2.fromOffset(x, y)
		f.Size = UDim2.fromOffset(w, h)
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.ZIndex = z + 1
		f.Parent = parent or grid
		local c = Instance.new("UICorner"); c.CornerRadius = radius or UDim.new(0.5, 0); c.Parent = f
		track(f, "cut")
		return f
	end
	-- Cut-out outline (outer box x,y,w,h), e.g. the globe's meridian ellipse.
	P.cutRing = function(parent, x, y, w, h, radius, th)
		local t = th or T
		local f = Instance.new("Frame")
		f.Position = UDim2.fromOffset(x + t, y + t)
		f.Size = UDim2.fromOffset(w - 2 * t, h - 2 * t)
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.ZIndex = z + 1
		f.Parent = parent or grid
		local c = Instance.new("UICorner"); c.CornerRadius = radius or UDim.new(0.5, 0); c.Parent = f
		local s = Instance.new("UIStroke")
		s.Thickness = t
		s.Color = Color3.new(0, 0, 0)
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.Parent = f
		track(s, "cut")
		return f
	end
	-- Solid part drawn over the cut-outs (z + 2): slider knobs.
	P.top = function(parent, x, y, w, h, radius)
		local f = P.fill(parent, x, y, w, h, radius)
		f.ZIndex = z + 2
		return f
	end
	return P
end
