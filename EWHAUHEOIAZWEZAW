-- SEARCH BEGIN ----------------------------------------------------------------------------------
-- Global search ("command palette"). Win:OpenSearch(query) / Win:CloseSearch() / Win:SearchResults(query)
-- / Win:GetRecentSearches() / Win:ClearRecentSearches(). Ctrl+F or "/" (menu open, no text box focused)
-- opens it; Up/Down move, Enter jumps, Tab cycles the groups, Esc clears / closes.
-- Index: one entry per registered element (WindowObj's context targets), tab, sub-tab, section and page,
-- built lazily when the field opens (and when an element is added meanwhile); a keystroke only scores
-- the entries (subsequence + word-prefix, case / diacritics-insensitive, EN + RU labels), never the GUI.
-- Everything lives in this function (AddWindow is at the Luau register limit); ctx comes from AddWindow.
Library._searchInstall = function(ctx)
	local W, main, header, btn, tabs = ctx.win, ctx.main, ctx.header, ctx.btn, ctx.tabs
	local S = { entries = {}, dirty = true, recent = {}, flat = {}, groupAt = {}, open = false, filter = false, sel = 0, query = "", token = 0, z = Z_BASE + 12000 }
	W._search = S
