			grid.AnchorPoint = Vector2.new(0.5, 0.5)
			grid.Position = UDim2.fromScale(0.5, 0.5)
			Library._iconDraw(kind, Library._iconBuilder(grid, host.ZIndex + 2, color, function() end))
		elseif kind == "trash" then
			image("rbxassetid://116396312853810")
		elseif kind == "restore" then
			image("rbxassetid://106497040962250")
		end
	end

	-- Profile lists: just below and right of the cursor, kept on screen.
	WindowObj._popupAtCursor = function(popup)
		local pointer = GetPointerPosition()
		MovePopupToAbsolute(popup, pointer.X - 16, pointer.Y - (WindowObj._topInset or 0) + 10)
		ConstrainPopupToMainFrame(popup, 6)
	end
	WindowObj._centerPopupOnField = function(popup, field)
		if not popup or not popup.Parent or not field or not field.Parent then return end
		if WindowObj._styleListPopup then WindowObj._styleListPopup(popup) end
		RememberPopupClipping(popup)
		ForceLiftClipping(popup)
		local size = popup.AbsoluteSize
		local fieldPos, fieldSize = field.AbsolutePosition, field.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 or fieldSize.X <= 0 then return end
		local x = fieldPos.X + (fieldSize.X - size.X) / 2
		local y = fieldPos.Y + (fieldSize.Y - size.Y) / 2
		MovePopupToAbsolute(popup, x, y)
		ConstrainPopupToMainFrame(popup, 6)
	end
	-- Multi-selects: under the field, left edges aligned, 4px gap; flips above
	-- the field when the window has no room below.
	WindowObj._popupUnderField = function(popup, field)
		if not popup or not popup.Parent or not field or not field.Parent then return end
		if WindowObj._styleListPopup then WindowObj._styleListPopup(popup) end
		RememberPopupClipping(popup)
		ForceLiftClipping(popup)
		local size = popup.AbsoluteSize
		local fieldPos, fieldSize = field.AbsolutePosition, field.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 or fieldSize.X <= 0 then return end
		local y = fieldPos.Y + fieldSize.Y + 4
		if y + size.Y > MainFrame.AbsolutePosition.Y + MainFrame.AbsoluteSize.Y - 6 and fieldPos.Y - 4 - size.Y >= MainFrame.AbsolutePosition.Y + 6 then
			y = fieldPos.Y - 4 - size.Y
		end
		MovePopupToAbsolute(popup, math.min(fieldPos.X, MainFrame.AbsolutePosition.X + MainFrame.AbsoluteSize.X - 6 - size.X), y)
		ConstrainPopupToMainFrame(popup, 6)
	end

	-- COLORPICKER BEGIN
	-- NL colour picker in the glass language: SV square (white + black gradients over the hue),
	-- old/new preview beside the hue and alpha sliders, hex field (# + 6, also pastes #rgb,
	-- #rrggbbaa, rgb(r,g,b), r,g,b), copy, 8 saved colours ("+" saves, right-click removes) and
	-- optional embedded settings (obj:AddPickerOptions{...}). The UI is built on the first open;
	-- phones get 46px rows and, in landscape, two columns (SV left, controls right).
	-- API: picker.Set/Get/GetAlpha/SetAlpha/Close/Toggle/Open/IsOpen/SetOptions/AddOptions/
	-- GetOption/SetOption/GetOptions/Live/Save/Load; elements: WindowObj._cpBind(obj, picker, opts, text).
	Library._recentColors = Library._recentColors or {}
	Library._cpRain = Library._cpRain or setmetatable({}, { __mode = "k" })
	Library._cpParse = Library._cpParse or function(text)
		if typeof(text) == "Color3" then return text, nil end
		if type(text) ~= "string" then return nil end
		local s = string.lower((string.gsub(text, "%s", "")))
		s = (string.gsub(s, "^0x", ""))
		local hex = string.match(s, "^#?(%x+)$")
		if hex and (#hex == 3 or #hex == 4) then
			hex = (string.gsub(hex, ".", function(ch) return ch .. ch end))
		end
		if hex and (#hex == 6 or #hex == 8) then
			local r, g, b = tonumber(string.sub(hex, 1, 2), 16), tonumber(string.sub(hex, 3, 4), 16), tonumber(string.sub(hex, 5, 6), 16)
			local a = #hex == 8 and tonumber(string.sub(hex, 7, 8), 16) / 255 or nil
			return Color3.fromRGB(r, g, b), a
		end
		if string.find(s, "^rgba?%(") or string.match(s, "^[%d%.,;/]+$") then
			local n = {}
			for num in string.gmatch(s, "[%d%.]+") do n[#n + 1] = tonumber(num) end
			if #n >= 3 and n[1] and n[2] and n[3] then
				local a = n[4]
				if a then a = math.clamp(a > 1 and a / (a > 100 and 255 or 100) or a, 0, 1) end
				return Color3.fromRGB(math.clamp(math.floor(n[1] + 0.5), 0, 255), math.clamp(math.floor(n[2] + 0.5), 0, 255), math.clamp(math.floor(n[3] + 0.5), 0, 255)), a
			end
		end
		return nil
	end
	-- One shared 20 fps clock for every picker with Rainbow on; stops when none is.
	Library._cpClock = Library._cpClock or function()
		if Library._cpClockConn then return end
		local acc = 0
		Library._cpClockConn = RunService.Heartbeat:Connect(function(dt)
			acc = acc + dt
			if acc < 0.05 then return end
			local step = acc
			acc = 0
			local any = false
			for p in pairs(Library._cpRain) do
				any = true
				pcall(p._rainStep, step)
			end
			if not any and Library._cpClockConn then
				Library._cpClockConn:Disconnect()
				Library._cpClockConn = nil
			end
		end)
	end
	-- Saved colours go with the config (hex list).
	WindowObj._configExtras.cprecent = {
		get = function()
			local t = {}
			for _, c in ipairs(Library._recentColors) do t[#t + 1] = ColorToHex(c) end
			return t
		end,
		set = function(v)
			if type(v) ~= "table" then return end
			local list = {}
			for _, h in ipairs(v) do
				local c = Library._cpParse(h)
				if c and #list < 8 then list[#list + 1] = c end
			end
			Library._recentColors = list
			if Library._cpSwatchSync then pcall(Library._cpSwatchSync) end
		end,
	}

	AcrylicBlur.CreateColorPicker = function(anchorButton, initialColor, onChange)
		local picker = {}
		local st = { color = NormalizeColor(initialColor), alpha = 1, open = false, opts = {}, vals = {}, rainHue = 0 }
		st.h, st.s, st.v = Color3.toHSV(st.color)
		local ui = nil
		local conns = {}
		local function sel() return Library._sel end
		-- Instances: z = order inside the popup (own ladder on open), NoPress for drag surfaces.
		local function mk(class, props, parent, z, noPress)
			local o = New(class, props, parent)
			o:SetAttribute("CpZ", z or 0)
			if noPress then o:SetAttribute("NoPress", true) end
			return o
		end
		local function corner(o, r) New("UICorner", { CornerRadius = r and UDim.new(0, r) or UDim.new(1, 0) }, o) end
		local function ladder(base)
			if not ui then return end
			for _, d in ipairs(ui.frame:GetDescendants()) do
				if d:IsA("GuiObject") then d.ZIndex = base + (d:GetAttribute("CpZ") or 1) end
			end
			ui.frame.ZIndex = base
		end
		local function hexOf(withAlpha)
			local h = ColorToHex(st.color)
			if withAlpha and st.alpha < 1 then h = h .. string.format("%02X", math.floor(st.alpha * 255 + 0.5)) end
			return h
		end

		-- Anchor square: the chosen colour, or the live rainbow colour.
		local function paintAnchor()
			if anchorButton and anchorButton.Parent then anchorButton.BackgroundColor3 = st.live or st.color end
		end

		local function paint(notify, glide)
			st.color = Color3.fromHSV(st.h, st.s, st.v)
			paintAnchor()
			if ui then
				local function put(o, pos)
					if glide then Library._anim.move(o, { Position = pos }, "fast") else o.Position = pos end
				end
				ui.sv.BackgroundColor3 = Color3.fromHSV(st.h, 1, 1)
				put(ui.svCur, UDim2.fromScale(st.s, 1 - st.v))
				ui.svFill.BackgroundColor3 = st.color
				put(ui.hueThumb, UDim2.new(st.h, 7 - st.h * 14, 0.5, 0))
				ui.hueFill.BackgroundColor3 = Color3.fromHSV(st.h, 1, 1)
				ui.alphaGrad.BackgroundColor3 = st.color
				put(ui.alphaThumb, UDim2.new(st.alpha, 7 - st.alpha * 14, 0.5, 0))
				ui.alphaFill.BackgroundColor3 = st.color
				ui.alphaFill.BackgroundTransparency = 1 - st.alpha
				ui.pvNew.BackgroundColor3 = st.color
				ui.pvNewFill.BackgroundColor3 = st.color
				if not ui.hexFocused then ui.hexBox.Text = string.sub(ColorToHex(st.color), 2) end
				ui.pct.Text = string.format("%d%%", math.floor(st.alpha * 100 + 0.5))
			end
			if notify then InvokeCallback(onChange, st.color, st.alpha) end
		end

		local function setColor(color, alpha, notify, glide)
			local c = NormalizeColor(color)
			local h, s, v = Color3.toHSV(c)
			-- Greys have no hue: keep the slider where it was.
			if s > 0.001 and v > 0.001 then st.h = h end
			st.s, st.v = s, v
			if type(alpha) == "number" then st.alpha = math.clamp(alpha, 0, 1) end
			paint(notify, glide)
		end

		-- ===== embedded settings ===================================================
		local function optOn(name)
			local v = st.vals[name]
			return v ~= nil and v ~= false and v ~= 0 and v ~= ""
		end
		local function optVisible(o)
			if type(o.Visible) == "function" then
				local ok, r = pcall(o.Visible, st.vals)
				return not ok or r ~= false and r ~= nil
			end
			return o.Visible ~= false
		end
		local function optEnabled(o)
			if type(o.DependsOn) == "function" then
				local ok, r = pcall(o.DependsOn, st.vals)
				return not ok or (r and true or false)
			elseif type(o.DependsOn) == "string" then
				return optOn(o.DependsOn)
			end
			return true
		end
		local function coerce(o, v)
			if o.kind == "toggle" then return v == true end
			if o.kind == "slider" then
				local n = tonumber(v) or o.Default or o.Min
				n = math.clamp(n, o.Min, o.Max)
				return math.floor((n - o.Min) / o.Step + 0.5) * o.Step + o.Min
			end
			if o.kind == "dropdown" then
				for _, opt in ipairs(o.Options) do if tostring(opt) == tostring(v) then return opt end end
				return o.Options[1]
			end
			return v
		end
		local function rainbowSync()
			if optOn("Rainbow") then
				if not Library._cpRain[picker] then
					Library._cpRain[picker] = true
					local h0 = st.h
					st.rainHue = h0
				end
				Library._cpClock()
			else
				Library._cpRain[picker] = nil
				if st.live then st.live = nil; paintAnchor() end
			end
		end
		function picker._rainStep(dt)
			local speed = tonumber(st.vals.Speed) or 3
			st.rainHue = (st.rainHue + dt * (0.04 + 0.06 * math.max(speed, 0))) % 1
			local s = st.s > 0.15 and st.s or 0.8
			local v = st.v > 0.25 and st.v or 1
			st.live = Color3.fromHSV(st.rainHue, s, v)
			paintAnchor()
		end

		local layout -- (declared below; option rows call it)
		local function paintOptions(animate)
			if not ui or not ui.optRows then return end
			for _, o in ipairs(st.opts) do
				local r = ui.optRows[o.Name]
				if r then
					r.row.Visible = optVisible(o)
					local en = optEnabled(o)
					r.enabled = en
					r.paint(animate)
					local a = en and 0 or 0.55
					r.label.TextTransparency = a
					if r.value then r.value.TextTransparency = a end
					if r.dim then for _, d in ipairs(r.dim) do d.BackgroundTransparency = en and (d:GetAttribute("CpBaseA") or 0) or 0.6 end end
					if r.choices then
						for _, ch in ipairs(r.choices) do ch.row.Visible = r.row.Visible and st.expanded == o.Name end
					end
				end
			end
		end
		local function fireOpt(o, v)
			InvokeCallback(o.Callback, v, st.vals)
		end
		local function setOpt(name, v, silent, animate)
			local o
			for _, x in ipairs(st.opts) do if x.Name == name then o = x end end
			if not o then st.vals[name] = v; return end
			v = coerce(o, v)
			local changed = st.vals[name] ~= v
			st.vals[name] = v
			paintOptions(animate)
			rainbowSync()
			if layout and ui then layout(animate) end
			if changed and not silent then fireOpt(o, v) end
		end

		local function buildOptions()
			if not ui then return end
			if ui.optRows then for _, r in pairs(ui.optRows) do r.row:Destroy(); if r.choices then for _, ch in ipairs(r.choices) do ch.row:Destroy() end end end end
			ui.optRows = {}
			local S = sel()
			local rowH = S.h()
			local order = 0
			for _, o in ipairs(st.opts) do
				order = order + 1
				local row = mk("TextButton", { Name = "OptRow", Size = UDim2.new(1, 0, 0, rowH), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 1,
					Text = "", AutoButtonColor = false, LayoutOrder = order * 100 }, ui.list, 2, true)
				corner(row, S.radius)
				local label = mk("TextLabel", { Name = "OptLabel", Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -120, 1, 0), BackgroundTransparency = 1,
					Text = o.Name, TextColor3 = S.text, TextSize = S.textSize, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row, 3)
				local r = { row = row, label = label, enabled = true }
				row.MouseEnter:Connect(function() if not Library._noHover and r.enabled then Library._anim.raw(row, { BackgroundTransparency = S.hoverAlpha }, "fast") end end)
				row.MouseLeave:Connect(function() Library._anim.raw(row, { BackgroundTransparency = 1 }, "fast") end)
				if o.kind == "toggle" then
					local track = mk("Frame", { Name = "OptSwitch", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(34, 20),
						BackgroundColor3 = Color3.fromRGB(34, 36, 48), BorderSizePixel = 0 }, row, 3)
					corner(track)
					local knob = mk("Frame", { Name = "OptKnob", Position = UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.fromRGB(142, 144, 152), BorderSizePixel = 0 }, track, 4)
					corner(knob)
					r.dim = { track }
					r.paint = function(animate)
						local on = st.vals[o.Name] == true
						local bg = on and mainColor or Color3.fromRGB(34, 36, 48)
						local kc = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(142, 144, 152)
						local kp = on and UDim2.fromOffset(16, 2) or UDim2.fromOffset(2, 2)
						if animate then
							Library._anim.color(track, { BackgroundColor3 = bg })
							Library._anim.color(knob, { BackgroundColor3 = kc })
							Library._anim.move(knob, { Position = kp }, "fast")
						else
							Library._setC(track, "BackgroundColor3", bg)
							Library._setC(knob, "BackgroundColor3", kc)
							knob.Position = kp
						end
					end
					row.MouseButton1Click:Connect(function()
						if not r.enabled or Library._swiped() then return end
						setOpt(o.Name, not (st.vals[o.Name] == true), false, true)
