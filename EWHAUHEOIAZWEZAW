	if not g then return end
	local pop = Library._invPopup(ctx.inv, anchor, { Name = "WeaponPicker", Width = Library._phone and 250 or 220, Gap = S.gap, MaxHeight = Library._phone and 300 or 380 })
	pop.kind = "picker"
	GU.pop = pop
	GU.besidePlate(ctx, pop, function() return anchor.Parent and anchor.AbsolutePosition.Y - 40 or nil end)
