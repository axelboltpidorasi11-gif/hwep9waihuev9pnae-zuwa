	}
-- Alpha that differs per theme (instance name -> { dark, light }).
Library._themeAlpha = { SidebarPlate = { 0.975, 0 }, Elements = { 0.3, 0.1 } }
Library._themeFor = function(d, prop, base)
	local pal = Library._themePal
	if pal and not pal.light then return Library._palFor(pal, d, prop, base) end
	local h0, s0, v0 = base:ToHSV()
	do
		local key = math.floor(base.R * 255 + 0.5) .. "," .. math.floor(base.G * 255 + 0.5) .. "," .. math.floor(base.B * 255 + 0.5)
		if prop == "BackgroundColor3" then
			if d.Name == "SidebarPlate" then return Color3.fromRGB(235, 237, 242) end
			if d.Name == "Icon" and key == "142,144,152" then return Color3.fromRGB(255, 255, 255) end
			if d.Name == "TabButton" and key == "255,255,255" then return Color3.fromRGB(214, 218, 228) end
			local o = Library._lightBg[key]
			if o then return o end
		elseif prop == "TextColor3" or prop == "ImageColor3" then
			local o = Library._lightText[key]
			if o then return o end
		end
	end
	if prop == "BackgroundColor3" and v0 < 0.2 and s0 <= 0.6 then
		-- Overlay glass (watermark, hotkey/spectator lists, logs, mobile and on-screen buttons): near-white pills.
		local n = d.Name
		if n == "GameInfo" or n == "IconPill" or n == "NamePill" or n == "LogPill" or n == "MobileToggle" or n == "ScreenButton"
			or (n == "Header" and d.Parent and d.Parent:IsA("CanvasGroup")) then
			return Color3.fromRGB(247, 248, 251)
		end
		-- Selected tab / sub-tab plate (35,38,50): a clearly visible light grey; hover (same plate, more transparent) is lighter.
		if math.abs(base.R * 255 - 35) < 1 and math.abs(base.G * 255 - 38) < 1 and math.abs(base.B * 255 - 50) < 1 then
			return Color3.fromRGB(222, 224, 230)
		end
	end
	if prop == "BackgroundColor3" and d:IsA("Frame") then
		local s = d.Size
		if (s.Y.Scale == 0 and s.Y.Offset <= 2 and s.Y.Offset > 0) or (s.X.Scale == 0 and s.X.Offset <= 2 and s.X.Offset > 0) then
			if s0 <= 0.3 then
				if v0 < 0.6 then return Color3.fromHSV(h0, s0 * 0.3, 0.8) end
				return Color3.fromHSV(h0, s0 * 0.3, 0.3)
			end
		end
		local n = d.Name
		if (n == "Track" or n == "Switch" or n == "SwitchTrack" or n == "Effect") and v0 < 0.2 and s0 <= 0.6 then return Color3.fromRGB(214, 217, 224) end
		-- White knob (small rounded square) over an accent track.
		if s0 <= 0.1 and v0 > 0.95 and s.X.Scale == 0 and s.Y.Scale == 0 and s.X.Offset >= 10 and s.X.Offset <= 24 and s.Y.Offset >= 10 and s.Y.Offset <= 24
			and d:FindFirstChildOfClass("UICorner") and d.Parent and d.Parent:IsA("Frame") then
			local _, ps, pv = d.Parent.BackgroundColor3:ToHSV()
			if ps > 0.3 and pv > 0.35 then return base end
		end
	end
	if (prop == "TextColor3" or prop == "ImageColor3") and s0 <= 0.3 and v0 > 0.55 and Library._onAccent(d) then return base end
	if prop == "ImageColor3" and Library._isPicture(d) then return base end
	-- Pastel text/icons (overlay accents 150,164,255, warm/ok status tints) fade out on white:
	-- same hue, deeper and more saturated.
	if (prop == "TextColor3" or prop == "ImageColor3") and s0 >= 0.2 and s0 < 0.62 and v0 > 0.8 then
		return Color3.fromHSV(h0, math.min(1, s0 * 1.5 + 0.15), v0 * 0.8)
	end
	-- Accent text/icons on light surfaces: ~25% darker so they keep contrast.
	if (prop == "TextColor3" or prop == "ImageColor3") and s0 > 0.3 and v0 > 0.35 and not Library._onAccent(d) then
		return Color3.fromHSV(h0, s0, v0 * 0.75)
	end
	local out = Library._themeColor(base)
	if prop == "TextColor3" or prop == "PlaceholderColor3" then
		local h, s, v = out:ToHSV()
		if s <= 0.3 and v > 0.5 and v0 > 0.35 then return Color3.fromHSV(h, s, 0.5) end
	end
	return out
end
-- Maps one instance (and, with deep, everything under it) to the current theme.
Library._themePass = function(root, deep)
	local light = Library._themeMap ~= nil -- any mapped theme (Light or a dark-based palette)
	local trueLight = Library._lightOn == true
	local list = deep and root:GetDescendants() or {}
	table.insert(list, root)
	-- Library._themeFade (set by Win:SetTheme) collects every colour change so they all move
	-- together in one synchronized fade (Library._themeFadeRun); otherwise they apply at once.
	local fade = Library._themeFade
	local function put(d, prop, c)
		if fade then
			local ok, cur = pcall(function() return d[prop] end)
			if ok and typeof(cur) == "Color3" and cur ~= c then table.insert(fade, { d, prop, cur, c }) end
		end
		d[prop] = c
	end
	-- Theme alphas move with the colour fade (same duration), or at once.
	local function alpha(d, v)
		if fade then Tween(d, { BackgroundTransparency = v }, 0.16, Enum.EasingStyle.Sine) else d.BackgroundTransparency = v end
	end
	for _, d in ipairs(list) do
		local skip = light and Library._skipTheme(d)
		if d.Name == "colorpickerButton" and d:IsA("GuiObject") then
			-- Colour dots keep their own colour; a hairline keeps white ones visible on light cards.
			local ring = d:FindFirstChild("LightRing")
			if trueLight and not ring then
				ring = Instance.new("UIStroke")
				ring.Name = "LightRing"
				ring.Color = Color3.fromRGB(130, 134, 146)
				ring.Transparency = 0.55
				ring.Thickness = 1
				ring.Parent = d
			end
			if ring then ring.Enabled = trueLight end
		end
		if d.Name == "InLine" and d:IsA("Frame") then Library._themeInLine(d) end
		if skip then
			-- Left as made (a New() that ran before the mark restores its colours).
			for prop in pairs(Library._themeProps) do
				local base = d:GetAttribute("ThemeBase_" .. prop)
				if typeof(base) == "Color3" then pcall(put, d, prop, base); d:SetAttribute("ThemeBase_" .. prop, nil) end
			end
		end
		if skip then
		elseif d:IsA("UIGradient") then
			local base = d:GetAttribute("ThemeBase_Color")
			if light then
				if base == nil then d:SetAttribute("ThemeBase_Color", d.Color); base = d.Color end
				if d.Name == "WindowGlass" then
					-- A multiply tint over the dark window; over the light one it stays a faint neutral shade.
					d.Color = trueLight and ColorSequence.new(Color3.fromRGB(250, 250, 252), Color3.fromRGB(255, 255, 255))
						or ColorSequence.new((Library._themePal and Library._themePal.glass) or Color3.fromRGB(175, 170, 176), Color3.fromRGB(255, 255, 255))
				else
					local points = {}
					for _, k in ipairs(base.Keypoints) do table.insert(points, ColorSequenceKeypoint.new(k.Time, Library._mapColor(k.Value))) end
					d.Color = ColorSequence.new(points)
				end
			elseif typeof(base) == "ColorSequence" then
				d.Color = base
				d:SetAttribute("ThemeBase_Color", nil)
			end
		end
		local ta = Library._themeAlpha[d.Name]
		if ta and not skip and d:IsA("GuiObject") and (d.Name ~= "Elements" or d:GetAttribute("NLGroupOutlineInset")) then
			alpha(d, trueLight and ta[2] or ta[1])
		end
		-- Overlay glass (watermark, Hotkeys/Spectators/log pills): see-through dark glass in Dark, a
		-- nearly solid light glass in Light (a clear white over the dark game world reads as grey).
		if not skip and d:IsA("GuiObject") and d.Name ~= "HeaderDivider" and (d.Name == "GameInfo" or d:GetAttribute("PillBase")) then
			local saved = d:GetAttribute("ThemeDarkAlpha")
			if trueLight and saved == nil then
				local a = d:GetAttribute("PillAlpha") or d.BackgroundTransparency
				local la = math.min(a, a * 0.3 + 0.02)
				d:SetAttribute("ThemeDarkAlpha", a)
				if d:GetAttribute("PillAlpha") then d:SetAttribute("PillAlpha", la) end
				if d.BackgroundTransparency < 1 then alpha(d, la) end
			elseif not trueLight and saved ~= nil then
				if d:GetAttribute("PillAlpha") then d:SetAttribute("PillAlpha", saved) end
				if d.BackgroundTransparency < 1 then alpha(d, saved) end
				d:SetAttribute("ThemeDarkAlpha", nil)
			end
		end
		if d:IsA("UIStroke") and not skip then
			-- Hairlines: faint white strokes turn into dark ones, so lift their alpha to stay visible.
			local tb = d:GetAttribute("ThemeBase_Transparency")
			if trueLight then
				if tb == nil and d.Transparency > 0.8 and d.Transparency < 0.995 then
					local _, ss, sv = d.Color:ToHSV()
					if ss <= 0.3 and sv > 0.55 then d:SetAttribute("ThemeBase_Transparency", d.Transparency); d.Transparency = 0.9 end
				end
			elseif tb ~= nil then
				d.Transparency = tb
				d:SetAttribute("ThemeBase_Transparency", nil)
			end
		end
		for prop in pairs(skip and {} or Library._themeProps) do
			local ok, value = pcall(function() return d[prop] end)
			if ok and typeof(value) == "Color3" then
				local key = "ThemeBase_" .. prop
				if light then
					local base = d:GetAttribute(key)
					-- Set by something else since (e.g. a loaded config): new base.
					local same = false
					if base and d:GetAttribute("HoverInk") and value == Color3.new(0, 0, 0) then same = true end
					if base and not same then
						for _, mapped in ipairs({ Library._themeFor(d, prop, base), Library._mapColor(base) }) do
							if math.abs(mapped.R - value.R) + math.abs(mapped.G - value.G) + math.abs(mapped.B - value.B) < 0.02 then same = true end
						end
					end
					if base == nil or not same then base = value; d:SetAttribute(key, value) end
					put(d, prop, Library._themeFor(d, prop, base))
				else
					local base = d:GetAttribute(key)
					if typeof(base) == "Color3" then put(d, prop, base) end
					d:SetAttribute(key, nil)
				end
			end
		end
	end
end
-- One synchronized theme fade: every collected { obj, prop, from, to } moves on the same clock
-- (0.18 s x Library._animScale, eased); instant when motion is off or the list is huge. A value
-- changed by something else meanwhile (hover, state) is left to it. A new switch finishes the
-- previous fade first (Library._themeFadeFinish), so no colour is read half-way.
Library._themeFadeFinish = function()
	local cur = Library._themeFadeCur
	Library._themeFadeCur = nil
	if cur then
		if cur.conn then cur.conn:Disconnect() end
		for _, e in ipairs(cur.list) do
			if e[5] ~= nil and e[1].Parent and e[5] == e[1][e[2]] then pcall(function() e[1][e[2]] = e[4] end) end
		end
	end
end
Library._themeFadeRun = function(list)
	Library._themeFadeFinish()
	local dur = 0.18 * (Library._animScale or 1)
	if dur <= 0 or #list == 0 or #list > 15000 then return end
	local cur = { list = list }
	Library._themeFadeCur = cur
	-- Back to the start colour (the pass already set the final one), then all move together.
	for _, e in ipairs(list) do pcall(function() e[1][e[2]] = e[3]; e[5] = e[1][e[2]] end) end
	local t0 = os.clock()
	local function step()
		if Library._themeFadeCur ~= cur then return end
		local a = math.clamp((os.clock() - t0) / dur, 0, 1)
		local k = 1 - (1 - a) * (1 - a) * (1 - a)
		for _, e in ipairs(list) do
			local o = e[1]
			if e[5] ~= nil and o.Parent then
				if o[e[2]] ~= e[5] then
					e[5] = nil -- taken over by something else
				else
					o[e[2]] = a >= 1 and e[4] or e[3]:Lerp(e[4], k)
					e[5] = o[e[2]]
				end
			end
		end
		if a >= 1 then
			if cur.conn then cur.conn:Disconnect() end
			Library._themeFadeCur = nil
		end
	end
	cur.conn = RunService.RenderStepped:Connect(step)
end
-- Assign a colour the way New() would (keeps the dark original for switching back).
Library._setC = function(obj, prop, c)
	if Library._themeMap and Library._themeProps[prop] and typeof(c) == "Color3" and not Library._skipTheme(obj) then
		obj:SetAttribute("ThemeBase_" .. prop, c)
		obj[prop] = Library._themeFor(obj, prop, c)
	else
		obj[prop] = c
	end
end
