		local badgeLogo = New("ImageLabel", {
			Name = "BadgeLogo", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Image = hubImage, ScaleType = Enum.ScaleType.Stretch, ZIndex = Z_BASE + 992,
		}, badge)
		New("UICorner", { CornerRadius = UDim.new(0, 10) }, badgeLogo)
	else
		WindowObj._logoWithFallback(badge, 17, Z_BASE + 992, 11)
	end
	New("TextLabel", {
		Name = "LoaderTitle", Position = UDim2.fromOffset(60, 11), Size = UDim2.new(1, -140, 0, 20), BackgroundTransparency = 1,
		Text = tostring(hubTitle), TextColor3 = Color3.fromRGB(240, 241, 246), TextSize = 16, Font = FONT_BOLD,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = Z_BASE + 991,
	}, toast)
	local status = New("TextLabel", {
		Name = "LoaderStatus", Position = UDim2.fromOffset(60, 31), Size = UDim2.new(1, -84, 0, 16), BackgroundTransparency = 1,
		Text = "Initialization in progress", TextColor3 = Color3.fromRGB(160, 162, 172), TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = Z_BASE + 991,
	}, toast)
	local counter = New("TextLabel", {
		Name = "LoaderCounter", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 11), Size = UDim2.fromOffset(70, 20),
		BackgroundTransparency = 1, Text = "0 of 10", TextColor3 = Color3.fromRGB(225, 227, 234), TextSize = 14, Font = FONT_BOLD,
		TextXAlignment = Enum.TextXAlignment.Right, ZIndex = Z_BASE + 991,
	}, toast)
	counter.Font = FONT_BOLD -- New() resets fonts by name; bold as on NL
	-- (No progress line: the card shows only the title, the status and the "k of 10" count.)
	-- Status crossfade: the old line drifts up and out while the new one rises in.
	local statusOut = New("TextLabel", {
		Name = "LoaderStatusOut", Position = UDim2.fromOffset(60, 31), Size = UDim2.new(1, -84, 0, 16), BackgroundTransparency = 1,
		Text = "", TextColor3 = Color3.fromRGB(160, 162, 172), TextSize = 13, TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = Z_BASE + 991,
	}, toast)
	local function setStatus(text)
		if status.Text == text then return end
		statusOut.Text = status.Text
		statusOut.TextTransparency = status.TextTransparency
		statusOut.Position = UDim2.fromOffset(60, 31)
		Library._anim.tween(statusOut, { TextTransparency = 1, Position = UDim2.fromOffset(60, 27) }, "fast", "exit")
		status.TextTransparency = 1
		status.Text = text
		status.Position = UDim2.fromOffset(60, 35)
		Library._anim.tween(status, { TextTransparency = 0, Position = UDim2.fromOffset(60, 31) }, "base", "enter", 0.04)
	end

	-- The watermark waits for the loader, like NL's.
	-- (Later SetWatermark calls stay hidden too: ApplyWatermarkLayout checks the flag.)
	WindowObj._loaderActive = true
	local watermarkFrame = WindowObj.Watermark and WindowObj.Watermark.frame
	if watermarkFrame then watermarkFrame.Visible = false end
	if WindowObj._toggleBtn then WindowObj._toggleBtn.Visible = false end

	-- Wait for the logo texture first (max ~1.5 s) so the toast never slides in
	-- with an empty badge.
	do
		local done = false
		task.spawn(function()
			pcall(function() game:GetService("ContentProvider"):PreloadAsync(badge:GetDescendants()) end)
			done = true
		end)
		local waited = 0
		while not done and waited < 1.5 do waited = waited + task.wait() end
	end
	-- Slides in from the right while everything on it fades in.
	WindowObj._fadeTree(toast, false, 0)
	local toastAlpha = toast.BackgroundTransparency
	toast.BackgroundTransparency = 1
	Tween(toast, { Position = UDim2.new(1, -8, 0, 8 - (WindowObj._topInset or 0)), BackgroundTransparency = toastAlpha }, 0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	WindowObj._fadeTree(toast, true, 0.4)
	-- Real work behind the counter: every image the interface uses is
	-- preloaded in batches (one step each), then fonts and configs.
	do
		local seen, assets = {}, {}
		for _, d in ipairs(NLUI:GetDescendants()) do
			if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" and not seen[d.Image] then
				seen[d.Image] = true
				table.insert(assets, d)
			end
		end
		local stepNames = { "Loading interface", "Loading icons", "Loading icons", "Loading icons", "Loading images",
			"Loading images", "Loading avatar", "Loading fonts", "Loading configs", "Finishing" }
		local per = math.max(1, math.ceil(#assets / 8))
		local ContentProvider = game:GetService("ContentProvider")
		for step = 1, 10 do
			setStatus(stepNames[step] .. "...")
			local started = os.clock()
			if step <= 8 then
				local batch = {}
				for i = (step - 1) * per + 1, math.min(step * per, #assets) do table.insert(batch, assets[i]) end
				-- perf: a slow asset fetch no longer holds the loader (max 0.6 s per step); the
				-- rest of the batch keeps loading in the background.
				if #batch > 0 then
					WindowObj._ldStep, WindowObj._ldDone = step, false
					task.spawn(function()
						pcall(function() ContentProvider:PreloadAsync(batch) end)
						if WindowObj._ldStep == step then WindowObj._ldDone = true end
					end)
					while not WindowObj._ldDone and os.clock() - started < 0.6 do task.wait() end
				end
			elseif step == 9 and type(listfiles) == "function" then
				pcall(listfiles, "")
			end
			-- keep each step readable even when it finished instantly
			local left = 0.12 - (os.clock() - started)
			if left > 0 then task.wait(left) end
			-- The count ticks up with a small rise.
			counter.Text = tostring(step) .. " of 10"
			counter.Position = UDim2.new(1, -24, 0, 15)
			counter.TextTransparency = 0.6
			Tween(counter, { Position = UDim2.new(1, -24, 0, 11), TextTransparency = 0 }, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		end
	end
	setStatus("Initialization complete")
	task.wait(0.6)
	-- The toast leaves first; only then do the menu and the overlays appear
	-- (nothing shows while it is on screen). Its square glass goes at once: it lags the slide.
	toast:SetAttribute("NoBlur", true)
	Tween(toast, { Position = UDim2.new(1, 380, 0, 8 - (WindowObj._topInset or 0)), BackgroundTransparency = 1 }, 0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	WindowObj._fadeTree(toast, false, 0.3)
	task.wait(0.42)
	toast:Destroy()
	WindowObj._loaderActive = false
	if WindowObj._mobileToggle then WindowObj._mobileToggle.Visible = not MainFrame.Visible end
	for _, entry in pairs(WindowObj._screenButtons or {}) do entry.btn.Visible = true end
	if AcrylicBlur.toggleGui then AcrylicBlur.toggleGui() end
	if WindowObj._autoLoad then task.defer(WindowObj._autoLoad) end
	if watermarkFrame and WindowObj.Watermark.applyLayout then WindowObj.Watermark.applyLayout(nil, nil) end
	if WindowObj.KeybindList then WindowObj.KeybindList.refresh() end
	if WindowObj.SpectatorList then WindowObj.SpectatorList.refresh() end
end) end


	-- Event logs (NL): glass capsules at the top-left of the screen,
	-- "[icon] Hit {name} in the {head} for {132} damage", words in braces
	-- highlighted. Each slides in, stays a few seconds and folds away.
	WindowObj._buildEventLogs = function()
		local cfg = { enabled = true, hideIcons = false, reduceMotion = false, lineOpacity = 1, backgroundOpacity = 0.6, duration = 4, positionPreset = "Top Left" }
		local holder = New("Frame", {
			Name = "EventLogs", Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(700, 0),
			AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = Z_BASE + 870,
		}, NLUI)
		-- (No layout padding: each row carries its 6px gap, so a leaving row collapses it smoothly too.)
		local holderLayout = New("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
		if WindowObj._mobile then New("UIScale", { Scale = 0.75 }, holder) end
		-- "Top Left" or "Crosshair" (centred, a little under the crosshair).
		local function placeHolder()
			if cfg.positionPreset == "Crosshair" then
				holder.AnchorPoint = Vector2.new(0.5, 0)
				holder.Position = UDim2.new(0.5, 0, 0.5, 34 - (WindowObj._topInset or 0))
				holderLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
			else
				holder.AnchorPoint = Vector2.new(0, 0)
				holder.Position = UDim2.fromOffset(10, 10)
				holderLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
			end
		end
		-- NL hit log: monospace text in a rounded glass pill with a light
		-- hairline, crosshair icon in front, highlighted words in pale blue.
		local LOG_FONT = FONT -- New() draws labels in FONT; measure in the same one
		local LOG_H, LOG_TEXT = 32, 14 -- the list headers' height
		local ICONS = {
			crosshair = "rbxassetid://107944169329467", info = "rbxassetid://10723415903", list = "rbxassetid://10723433811",
			-- By event (options.type or options.icon): Lucide icons.
			hit = "rbxassetid://107944169329467", miss = "rbxassetid://10747383819", hurt = "rbxassetid://10723406299",
			kill = "rbxassetid://10734962068", purchase = "rbxassetid://10734952479", money = "rbxassetid://10723343958",
			vote = "rbxassetid://10709790644", lua = "rbxassetid://10734982144", warning = "rbxassetid://10709752996",
		}
		local count = 0
		local function escape(t) return (t:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
		local function dismiss(row, capsule)
			if not row.Parent or row:GetAttribute("Leaving") then return end
			row:SetAttribute("Leaving", true)
			-- Out: fade + slide (base, Quad In), then the stack closes the gap (base, Quint Out).
			WindowObj._fadeTree(capsule, false, 0.18)
			if not cfg.reduceMotion then
				Library._anim.tween(capsule, { Position = UDim2.fromOffset(-12, 0) }, "base", "exit")
			end
			task.delay(Library._motion.dur("base"), function()
				if not row.Parent then return end
				Library._anim.move(row, { Size = UDim2.fromOffset(row.Size.X.Offset, 0) }, "base")
				task.delay(Library._motion.dur("base") + 0.02, function() row:Destroy() end)
			end)
		end
		local function log(text, options)
			options = type(options) == "table" and options or {}
			text = tostring(text or "")
			if not cfg.enabled or text == "" then return end
			-- Nothing shows while the loader runs: the log waits for it.
			if WindowObj._loaderActive then
				task.spawn(function()
					while WindowObj._loaderActive do task.wait(0.1) end
					log(text, options)
				end)
				return
			end
			count = count + 1
			-- Plain text for measuring, rich text with highlighted {words} for display.
			local plain = text:gsub("[{}]", "")
			-- Highlights in the watermark's icon colour.
			local hl = options.highlight or (WindowObj._wm and WindowObj._wm.color()) or Color3.fromRGB(158, 176, 236)
			if Library._lightOn then
				-- Light glass: the pastel highlight gets deeper (same hue), like the other overlay accents.
				local hh, hs, hv = hl:ToHSV()
				if hs >= 0.2 and hv > 0.8 then hl = Color3.fromHSV(hh, math.min(1, hs * 1.5 + 0.15), hv * 0.8) end
			end
			local hex = string.format("#%02X%02X%02X", math.floor(hl.R * 255), math.floor(hl.G * 255), math.floor(hl.B * 255))
			local rich = escape(text):gsub("{(.-)}", '<font color="' .. hex .. '">%1</font>')
			local icon = options.icon
			if icon == nil then icon = options.type or "hit" end
			icon = ICONS[icon] or icon
			local showIcon = not cfg.hideIcons and type(icon) == "string" and icon ~= "" and icon ~= "none"
			-- Same pills as the hotkey / spectator lists: an icon pill and a text
			-- pill side by side, glass with the soft edge shadow, and a thin
			-- accent line in the text pill (Line Opacity).
			local OV = WindowObj._OV
			local textWidth = math.ceil(MeasureText(plain, LOG_TEXT, LOG_FONT))
			local textX = showIcon and 36 or 14
			local width = textX + textWidth + 12
			local row = New("Frame", {
				Name = "LogRow", LayoutOrder = count, Size = UDim2.fromOffset(width, LOG_H + 6), BackgroundTransparency = 1, ClipsDescendants = false,
			}, holder)
			local capsule = New("Frame", {
				Name = "LogCapsule", Size = UDim2.fromOffset(width, LOG_H), BackgroundTransparency = 1, ZIndex = Z_BASE + 871,
			}, row)
			local alpha = math.clamp(1 - cfg.backgroundOpacity, 0, 1)
			-- Default: exactly the watermark's glass (its colour and see-through).
			local wmFrame = WindowObj.Watermark and WindowObj.Watermark.frame
			if cfg.backgroundOpacity == 0.6 and wmFrame then alpha = wmFrame.BackgroundTransparency end
			-- One pill: icon and text; Line Opacity sets the hairline around it.
			local textPill = OV.pill("LogPill", capsule, alpha, 14, LOG_H)
			textPill.Size = UDim2.fromOffset(width, LOG_H)
			if wmFrame then textPill.BackgroundColor3 = wmFrame.BackgroundColor3 end
			-- Watermark / header glass (OV.glass), no outline: same capsule look.
			if showIcon then
				New("ImageLabel", {
					Name = "LogIcon", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0), Size = UDim2.fromOffset(21, 21),
					BackgroundTransparency = 1, Image = icon, ImageColor3 = (WindowObj._wm and WindowObj._wm.color()) or Color3.fromRGB(150, 164, 255),
					ZIndex = Z_BASE + 892,
				}, textPill)
			end
			New("TextLabel", {
				Name = "LogText", Position = UDim2.fromOffset(textX, 0), Size = UDim2.new(0, textWidth + 4, 1, 0),
				BackgroundTransparency = 1, RichText = true, Text = rich, TextColor3 = Color3.fromRGB(226, 228, 236), TextSize = LOG_TEXT,
				Font = LOG_FONT, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = Z_BASE + 892,
			}, textPill)
			-- Lifetime: a 2px accent line under the text drains (linear) until the toast leaves.
			local life = tonumber(options.duration) or cfg.duration
			if not cfg.reduceMotion and (Library._animScale or 1) > 0 and Library._perfMode ~= "max" and life > 0 then
				local bar = New("Frame", {
					Name = "LogLife", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -2), Size = UDim2.new(1, -24, 0, 2),
					BackgroundColor3 = (WindowObj._wm and WindowObj._wm.color()) or mainColor, BackgroundTransparency = 0.35,
					BorderSizePixel = 0, ZIndex = Z_BASE + 893,
				}, textPill)
				bar:SetAttribute("NoTheme", true)
				New("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
				TweenService:Create(bar, TweenInfo.new(life, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()
			end
			-- In: fade, and (unless Reduce Motion) slide from the left.
			WindowObj._fadeTree(capsule, false, 0)
			WindowObj._fadeTree(capsule, true, 0.22)
			if not cfg.reduceMotion then
				-- Top left: slides in from the left. Under the crosshair: rises.
				capsule.Position = cfg.positionPreset == "Crosshair" and UDim2.fromOffset(0, 8) or UDim2.fromOffset(-16, 0)
				Tween(capsule, { Position = UDim2.fromOffset(0, 0) }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			end
			-- At most 8 lines: the oldest goes first.
			local rows = {}
			for _, c in ipairs(holder:GetChildren()) do
				if c:IsA("Frame") and not c:GetAttribute("Leaving") then table.insert(rows, c) end
			end
			table.sort(rows, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
			for i = 1, #rows - 8 do dismiss(rows[i], rows[i]:FindFirstChild("LogCapsule")) end
			task.delay(tonumber(options.duration) or cfg.duration, function() dismiss(row, capsule) end)
			return row
		end
		WindowObj.EventLogs = {
			frame = holder,
			log = log,
			setEnabled = function(on)
				cfg.enabled = on == true
				holder.Visible = cfg.enabled
			end,
			set = function(options)
				if type(options) ~= "table" then return end
				for k, v in pairs(options) do
					if cfg[k] ~= nil and type(v) == type(cfg[k]) then cfg[k] = v end
				end
				if options.positionPreset then placeHolder() end
				if options.position then holder.Position = options.position end
				holder.Visible = cfg.enabled and not (WindowObj._mobile and MainFrame.Visible)
			end,
		}
	end
	WindowObj._buildEventLogs()
	-- Win:Log("Hit {Player} in the {head} for {132} damage", { icon = "crosshair", duration = 4 })
	function WindowObj:Log(text, options) return WindowObj.EventLogs.log(text, options) end
