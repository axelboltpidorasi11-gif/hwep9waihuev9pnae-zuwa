-- Theme switch between two mapped themes: the "back to Dark" fade entries and the "Dark to new"
-- entries merge into one list (old colour -> new colour per object/property).
Library._themeFadeMerge = function(back, fwd)
	local idx = {}
	for _, e in ipairs(back) do idx[e[1]] = idx[e[1]] or {}; idx[e[1]][e[2]] = e end
	local out = {}
	for _, e in ipairs(fwd) do
		local b = idx[e[1]] and idx[e[1]][e[2]]
		if b then e[3] = b[3]; idx[e[1]][e[2]] = nil end
		table.insert(out, e)
	end
	for _, e in ipairs(back) do if idx[e[1]] and idx[e[1]][e[2]] == e then table.insert(out, e) end end
	return out
end
-- An accent change (Win accent picker / theme accent) also moves the remembered dark-space base,
-- so a later theme switch restores the new accent, not the one the object was made with.
Library._accentSync = function(o, c)
	for _, prop in ipairs({ "BackgroundColor3", "ImageColor3", "TextColor3", "Color" }) do
		local b = o:GetAttribute("ThemeBase_" .. prop)
		if typeof(b) == "Color3" then
			local ok, v = pcall(function() return o[prop] end)
			if ok and v == c then o:SetAttribute("ThemeBase_" .. prop, c) end
		end
	end
end
-- THEMES END-- ONE selection design system: every place where the user picks something (option lists,
-- multi lists, menus, chips, segmented switches, filters) reads its metrics and colours
-- from here. Rows: 34 (phone 46), r8, 13px (226,228,236), left pad 12; hover = white 0.95
-- (gliding HoverSlab in laid-out lists); single AND multi pick = bright text (selText) + white
-- tick on the right + faint white 0.94 fill, unpicked = unselText; disabled 0.45; no dividers.
-- Popups: glass r12, stroke 0.93, pad 6, gap 2, 3px scrollbar, 10px uppercase captions.
-- Chips: r8, picked = white 0.88 fill + bright text (no accent), else field bg + hover. Light theme
-- comes from Library._setC (the dark colours below all have light twins).
Library._sel = {
	rowH = 34, rowHPhone = 46, radius = 8, textSize = 13, padL = 12, gap = 2,
	text = Color3.fromRGB(226, 228, 236), dim = Color3.fromRGB(138, 142, 156), white = Color3.fromRGB(255, 255, 255),
	hoverAlpha = 0.95, selAlpha = 0.9, selHoverAlpha = 0.84, disabledAlpha = 0.45,
	popRadius = 12, popStroke = 0.93, popPad = 6, scroll = 3, maxRows = 8,
	captionSize = 10, caption = Color3.fromRGB(112, 116, 128), captionColor = Color3.fromRGB(112, 116, 128),
	chipH = 26, chipR = 8, chipOnAlpha = 0.85, chipOff = Color3.fromRGB(30, 33, 47), chipHoverBg = Color3.fromRGB(40, 44, 62),
	chipText = Color3.fromRGB(176, 181, 196),
	-- ONE neutral pick look (no accent): picked = bright text + white tick on the right + faint white
	-- fill; unpicked = soft text. Chips picked = white 0.88 fill + bright text.
	selText = Color3.fromRGB(245, 246, 250), unselText = Color3.fromRGB(190, 193, 205), tick = Color3.fromRGB(245, 246, 250),
	selBgAlpha = 0.94, chipOnBgAlpha = 0.88,
}
-- Row height for the current device (phones get 46px touch rows).
Library._sel.h = function() return Library._phone and Library._sel.rowHPhone or Library._sel.rowH end
-- Height of an option popup holding n rows (pad 6 top/bottom, gap 2, at most maxRows visible).
Library._sel.listH = function(n, maxRows)
	local S = Library._sel
	local k = math.max(math.min(n or 0, maxRows or S.maxRows), 1)
	return k * (S.h() + S.gap) - S.gap + S.popPad * 2
end
-- Scrollbar for every selection list.
Library._sel.scrollbar = function(sf)
	if not (sf and sf:IsA("ScrollingFrame")) then return end
	sf.ScrollBarThickness = Library._sel.scroll
	sf.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
	sf.ScrollBarImageTransparency = 0.8
end
-- Section caption inside a popup / panel (10px uppercase, dim).
Library._sel.caption = function(label)
	if not label then return end
	label.Text = string.upper(label.Text)
	label.TextSize = Library._sel.captionSize
	-- (Library._sel.caption is this function, so the colour lives in captionColor.)
	Library._setC(label, "TextColor3", Library._sel.captionColor)
end
-- Disabled option / chip: 0.45 opacity of its content.
Library._sel.disabled = function(obj, off)
	local a = off and Library._sel.disabledAlpha or 0
	for _, d in ipairs({ obj, unpack(obj:GetDescendants()) }) do
		if d:IsA("TextLabel") or d:IsA("TextButton") then d.TextTransparency = a end
		if d:IsA("ImageLabel") or d:IsA("ImageButton") then d.ImageTransparency = a end
	end
	obj:SetAttribute("SelDisabled", off or nil)
end
-- Chip (TextButton): r8, neutral field fill, 13px text, faint hairline.
Library._sel.chip = function(chip)
	local S = Library._sel
	local c = chip:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, S.chipR); c.Parent = chip
	chip.AutoButtonColor = false
	chip.TextSize = S.textSize
	if chip.Size.Y.Scale == 0 and chip.Size.Y.Offset > 0 and chip.Size.Y.Offset < S.chipH then
		chip.Size = UDim2.new(chip.Size.X.Scale, chip.Size.X.Offset, 0, chip.Size.Y.Offset)
	end
end
-- Chip state: picked = accent 0.85 fill + accent text + accent hairline; else field bg.
Library._sel.chipState = function(chip, on, accent, instant, label)
	local S = Library._sel
	accent = accent or Library._accentNow()
	chip:SetAttribute("Sel", on or nil)
	local props = {
		BackgroundColor3 = on and S.white or S.chipOff, BackgroundTransparency = on and S.chipOnBgAlpha or 0,
	}
	local txt = label or (chip:IsA("TextButton") and chip) or nil
	local st = chip:FindFirstChild("ChipStroke") or chip:FindFirstChildOfClass("UIStroke")
	local sg = { Color = S.white, Transparency = on and 0.86 or 0.93 }
	if instant then
		for k, v in pairs(props) do Library._setC(chip, k, v) end
		if txt then Library._setC(txt, "TextColor3", on and S.selText or S.chipText) end
		if st then st.Color, st.Transparency = sg.Color, sg.Transparency end
	else
		-- Colour via _setC (theme-safe: a mid-tween theme pass would take a tweened light colour
		-- as a new dark base); only the fill alpha animates.
		if Library._themeMap then
			Library._setC(chip, "BackgroundColor3", props.BackgroundColor3)
			chip.BackgroundTransparency = props.BackgroundTransparency
		else
			Tween(chip, props, 0.14, Enum.EasingStyle.Quint)
		end
		if txt then
			local tc = on and S.selText or S.chipText
			if Library._themeMap then Library._setC(txt, "TextColor3", tc) else Tween(txt, { TextColor3 = tc }, 0.14, Enum.EasingStyle.Quint) end
		end
		if st then Tween(st, sg, 0.14) end
		-- Picked: the chip pops 0.96 -> 1 (base, Quint Out). Not inside a UIListLayout (a UIScale
		-- on a list item re-flows its neighbours); grid cells / free chips only.
		if on and chip:GetAttribute("NLChipOn") ~= true and (Library._animScale or 1) > 0 and Library._perfMode ~= "max"
			and chip.Parent and not chip.Parent:FindFirstChildOfClass("UIListLayout") then
			local sc = Library._anim.scaleOf(chip)
			if sc then sc.Scale = 0.96; Library._anim.tween(sc, { Scale = 1 }, "base", "enter") end
		end
	end
	chip:SetAttribute("NLChipOn", on and true or nil)
end
-- Chip hover: unpicked chips lift to the hover field colour.
Library._sel.chipHover = function(chip, inside)
	if chip:GetAttribute("Sel") or chip:GetAttribute("SelDisabled") then return end
	local S = Library._sel
	local c = inside and S.chipHoverBg or S.chipOff
	if Library._themeMap then Library._setC(chip, "BackgroundColor3", c) return end -- theme-safe instant swap
	Tween(chip, { BackgroundColor3 = c }, inside and 0.12 or 0.14, Enum.EasingStyle.Sine)
end
-- Weapon Presets plate (the "Global" pill): ONE module for its look so it is easy to restyle.
-- Plate (r12 glass): "Weapon Presets" (bold 15) + "+" icon button top-right (-> "Create Group"
-- popup: template rows = weapon silhouette + name). Under the title the "Global" field (the base
-- preset), then one bordered card per group: title (double-click = inline rename, Enter commits)
-- + x (delete), its weapons as chips (silhouette; hover x / click removes) and a "+" chip at the
-- end (-> weapon picker: category captions, silhouette + name rows, white tick = in the group).
-- The ACTIVE preset (Global field or a card; click selects) has the 1px accent outline (0.55).
-- Wiring (state, callbacks, popups registry) = WindowObj._groupCtx in AddWindow (ctx below).
Library._groupsUI = { width = 264, widthPhone = 300, listY = 44, tok = 0, last = {} }
-- Sizes for the current device (phones: 46px rows, bigger chips).
Library._groupsUI.dims = function()
	local ph = Library._phone
	return { row = Library._sel.h(), chipW = ph and 58 or 46, chipH = ph and 34 or 26, gap = 6, pad = 10,
		head = ph and 42 or 34, w = ph and Library._groupsUI.widthPhone or Library._groupsUI.width }
end
-- Small square icon button (hover: faint fill + bright tint). Returns the button.
Library._groupsUI.iconBtn = function(parent, kind, px, props, z)
	local S = Library._sel
	local b = New("TextButton", {
		Name = props.Name or "IconBtn", AnchorPoint = props.AnchorPoint or Vector2.zero, Position = props.Position, Size = props.Size or UDim2.fromOffset(24, 24),
		BackgroundColor3 = S.white, BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false, Text = "", ZIndex = z,
	}, parent)
	New("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	local glyph, tint = Library._glyph(kind, b, px, S.unselText, z + 1)
	local function paint(c, t)
		if glyph and glyph:IsA("ImageLabel") and Library._themeMap then Library._setC(glyph, "ImageColor3", c) else tint(c, t) end
	end
	b.MouseEnter:Connect(function() if Library._hoverBlocked(b) then return end Tween(b, { BackgroundTransparency = 0.9 }, 0.1); paint(S.selText, 0.1) end)
	b.MouseLeave:Connect(function() Tween(b, { BackgroundTransparency = 1 }, 0.14); paint(S.unselText, 0.14) end)
	return b
end
