local function BuildBindRow(entry, order)
	-- Two separate glass pills side by side: [switch pill 38x24] 4px [name pill]. The mini switch (22x12) shows
	-- the bind's active state (knob slides 0.15s when it changes); a conflict (same key twice) turns the track
	-- amber. The mode is a tiny glyph in the knob (Toggle none, Hold dot, Always bar, Release vertical bar).
	-- Inactive rows dim both pills' contents. OV.animateRow moves the pair (IconPill + NamePill) together.
	local row, swPill = OV.row(KBRows, order, entry.label .. (entry.value and ("  =  " .. entry.value) or ""), nil, false)
	row.Name = "BindRow"
	local namePill = row:FindFirstChild("NamePill")
	local mode = tostring(entry.mode or "toggle")
	local nameLabel = namePill:FindFirstChild("EntryName")
	local dim = (not entry.active) and WindowObj._kbDim ~= false
	local on = entry.active == true
	nameLabel.TextColor3 = on and Color3.fromRGB(235, 236, 241) or Color3.fromRGB(160, 163, 172)
	local textW = math.ceil(MeasureText(nameLabel.Text, 12, FONT))
	local swW, gap = 38, 4
	local pillW = 12 + textW + 12
	swPill.Name = "IconPill"
	swPill.Position = UDim2.fromOffset(0, 0)
	swPill.Size = UDim2.fromOffset(swW, OV.h)
	namePill.Position = UDim2.fromOffset(swW + gap, 0)
	namePill.Size = UDim2.fromOffset(pillW, OV.h)
	nameLabel.Position = UDim2.fromOffset(12, 0)
	nameLabel.Size = UDim2.new(1, -24, 1, 0)
	local trackOff = entry.conflict and Color3.fromRGB(112, 86, 42) or Color3.fromRGB(36, 38, 50)
	local trackOn = entry.conflict and Color3.fromRGB(255, 190, 90) or mainColor
	local track = New("Frame", {
		Name = "SwitchTrack", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(22, 12), BackgroundColor3 = on and trackOn or trackOff,
		BackgroundTransparency = 0, BorderSizePixel = 0, ZIndex = Z_BASE + 892,
	}, swPill)
	track:SetAttribute("NLOverlayAccentPart", true)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
	local knob = New("Frame", {
		Name = "SwitchKnob", Position = UDim2.fromOffset(on and 12 or 2, 2), Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(142, 144, 152),
		BackgroundTransparency = 0, BorderSizePixel = 0, ZIndex = Z_BASE + 893,
	}, track)
	knob:SetAttribute("NLOverlayAccentPart", true)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	if mode ~= "toggle" then
		local gw, gh = 2, 2
		if mode == "always" then gw, gh = 4, 2 elseif mode == "release" then gw, gh = 2, 4 end
		local glyph = New("Frame", {
			Name = "ModeGlyph", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(gw, gh), BackgroundColor3 = Color3.fromRGB(36, 38, 50),
			BorderSizePixel = 0, ZIndex = Z_BASE + 894,
		}, knob)
		glyph:SetAttribute("NLOverlayAccentPart", true)
		New("UICorner", { CornerRadius = UDim.new(1, 0) }, glyph)
	end
	-- State change on a rebuilt row: the knob starts at the old side and slides over.
	local prev = OV.prevState[entry.bind]
	OV.prevState[entry.bind] = on
	if prev ~= nil and prev ~= on and (Library._animScale or 1) > 0 then
		knob.Position = UDim2.fromOffset(prev and 12 or 2, 2)
		track.BackgroundColor3 = prev and trackOn or trackOff
		knob.BackgroundColor3 = prev and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(142, 144, 152)
		local info = TweenInfo.new(0.15 * (Library._animScale or 1), Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		TweenService:Create(knob, info, { Position = UDim2.fromOffset(on and 12 or 2, 2),
			BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(142, 144, 152) }):Play()
		TweenService:Create(track, info, { BackgroundColor3 = on and trackOn or trackOff }):Play()
	end
	row.Size = UDim2.fromOffset(swW + gap + pillW, OV.h)
	row:SetAttribute("NameX", swW + gap)
	row:SetAttribute("IconX", 0)
	if dim then
		-- Light theme: the mapped colours are already the dim step (a 0.5 fade fell to ~2:1).
		local t = WindowObj._theme == "Light" and 0 or 0.5
		nameLabel.TextTransparency = t; nameLabel:SetAttribute("DimText", t)
		-- The switch pill dims with the name (its parts fade back to DimAlpha, not 0).
		for _, d in ipairs(swPill:GetDescendants()) do
			if d:IsA("Frame") and d:GetAttribute("NLOverlayAccentPart") then d.BackgroundTransparency = 0.45; d:SetAttribute("DimAlpha", 0.45) end
		end
	end
	-- Light theme: an off track reads as a clear grey capsule on the near-white pill.
	if not on and WindowObj._theme == "Light" then
		track:SetAttribute("NoTheme", true)
		track.BackgroundColor3 = entry.conflict and Color3.fromRGB(196, 140, 60) or Color3.fromRGB(120, 124, 138)
		track.BackgroundTransparency = 0.35; track:SetAttribute("DimAlpha", 0.35)
		knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		knob.BackgroundTransparency = 0; knob:SetAttribute("DimAlpha", nil)
	end
	return row
end

RefreshKeybindOverlay = function()
	if not KBPanel.Parent then return end
	local snapshot = {}
	if WindowObj._bindSnapshot then
		local ok, result = pcall(WindowObj._bindSnapshot)
		if ok and type(result) == "table" then snapshot = result end
	end
	-- Shown while the menu is open, and without it while any bind is active.
	local menuShown = WindowObj._menuOpen
	if menuShown == nil then menuShown = MainFrame.Visible end
	local activeN, list = 0, {}
	for _, entry in ipairs(snapshot) do
		if entry.active then activeN = activeN + 1 end
		if WindowObj._kbShow ~= "Active only" or entry.active then list[#list + 1] = entry end
	end
	local target = kbEnabled and not WindowObj._loaderActive and (menuShown or activeN > 0)
	local entries = {}
	for i, entry in ipairs(list) do
		entries[i] = {
			id = entry.label .. "|" .. entry.key .. "|" .. tostring(entry.bind),
			sig = table.concat({ tostring(entry.mode), tostring(entry.value), tostring(entry.active), tostring(entry.conflict), tostring(WindowObj._kbDim), tostring(WindowObj._kbRight), tostring(WindowObj._theme) }, ":"),
			data = entry,
		}
	end
	OV.sync(KBPanel, KBRows, kbRowCache, entries, BuildBindRow)
	-- Dynamic Header: the title carries the number of active hotkeys.
	if WindowObj._kbDynamic ~= nil then
		local title = KBPanel:FindFirstChild("HeaderTitle", true)
		local text = (WindowObj._kbDynamic and activeN > 0) and ("Hotkeys · " .. activeN) or "Hotkeys"
		if title and title.Text ~= text then
			title.Text = text
			if WindowObj._kbFitHeader then WindowObj._kbFitHeader() end
		end
	end
	SetOverlayPanelShown(KBPanel, target)
end

-- Windows > Hotkeys "...": Style (Default / Minimal: no icon and divider in
-- the header), Right-Aligned rows, Dynamic Header (count in the title).
WindowObj._kbFitHeader = function()
	local header = KBPanel:FindFirstChild("Header")
	local title = KBPanel:FindFirstChild("HeaderTitle", true)
	local icon = KBPanel:FindFirstChild("HeaderIcon", true)
	if not header or not title then return end
	local w = 14 + MeasureText(title.Text, 14, FONT_BOLD) + 14
	if icon and icon.Visible then w = w + 15 + 8 + 1 + 8 end
	w = math.ceil(w)
	KBPanel:SetAttribute("HeaderWidth", w)
	Tween(header, { Size = UDim2.fromOffset(w, OV.head) }, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	KBPanel:SetAttribute("TargetW", nil)
	OV.layout(KBPanel, KBRows)
end
function WindowObj:SetHotkeysStyle(o)
	o = type(o) == "table" and o or {}
	if o.style ~= nil then
		local minimal = o.style == "Minimal"
		local icon = KBPanel:FindFirstChild("HeaderIcon", true)
		local divider = KBPanel:FindFirstChild("HeaderDivider", true)
		if icon then icon.Visible = not minimal end
		if divider then divider.Visible = not minimal end
	end
	if o.rightAligned ~= nil then
		WindowObj._kbRight = o.rightAligned == true
		local layout = KBRows:FindFirstChildOfClass("UIListLayout")
		if layout then layout.HorizontalAlignment = WindowObj._kbRight and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left end
		-- Rebuild the rows in the new order.
		for key in pairs(kbRowCache) do kbRowCache[key] = nil end
		for _, c in ipairs(KBRows:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	end
	if o.dynamicHeader ~= nil then WindowObj._kbDynamic = o.dynamicHeader == true end
	-- show = "All binds" | "Active only"; sort = "Name" | "Key" | "Active first"; dimInactive = bool
	if o.show ~= nil then WindowObj._kbShow = o.show end
	if o.sort ~= nil then WindowObj._kbSort = o.sort end
	if o.dimInactive ~= nil then WindowObj._kbDim = o.dimInactive == true end
	WindowObj._kbFitHeader()
	RefreshKeybindOverlay()
	return self
end

