		local function normalizeOpts(list)
			local out = {}
			for _, raw in ipairs(type(list) == "table" and list or {}) do
				if type(raw) == "table" and raw.Name ~= nil then
					local o = {}
					for k, v in pairs(raw) do o[k] = v end
					o.Name = tostring(raw.Name)
					local t = string.lower(tostring(raw.Type or "toggle"))
					o.kind = (t == "slider" or t == "number") and "slider" or ((t == "dropdown" or t == "list" or t == "select") and "dropdown" or "toggle")
					if o.kind == "slider" then
						o.Min = tonumber(raw.Min) or 0
						o.Max = math.max(tonumber(raw.Max) or 100, o.Min)
						o.Step = tonumber(raw.Step) or ((o.Max - o.Min) >= 10 and 1 or 0.1)
						if tonumber(raw.Decimals) then o.Step = 10 ^ -math.floor(tonumber(raw.Decimals)) end
					elseif o.kind == "dropdown" then
						o.Options = type(raw.Options) == "table" and #raw.Options > 0 and raw.Options or { "Off" }
					end
					out[#out + 1] = o
				end
			end
			return out
		end
		local function applyOpts(list, append)
			local fresh = normalizeOpts(list)
			if not append then st.opts = {} end
			for _, o in ipairs(fresh) do
				for i = #st.opts, 1, -1 do if st.opts[i].Name == o.Name then table.remove(st.opts, i) end end
				table.insert(st.opts, o)
				local v = st.vals[o.Name]
				if v == nil then v = o.Default end
				st.vals[o.Name] = coerce(o, v)
			end
			if ui then
				buildOptions()
				if st.open then ladder(st.zbase) end
				layout(st.open)
			end
			rainbowSync()
		end

