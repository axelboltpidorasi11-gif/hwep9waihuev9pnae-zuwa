			img.Image = asset
			img.ImageColor3 = color
			img.ScaleType = Enum.ScaleType.Fit
			img.ZIndex = host.ZIndex + 1
			img.Parent = host
			return img
		end
		if kind == "share" or kind == "copy" then
			-- Stroked glyph from the shared engine (18 grid fitted to the 14px host).
			local grid = Instance.new("Frame")
			grid.Name = "GlyphGrid"
			grid.Size = UDim2.fromOffset(18, 18)
			grid.BackgroundTransparency = 1
			grid.ZIndex = host.ZIndex + 1
			grid:SetAttribute("NoTheme", true)
