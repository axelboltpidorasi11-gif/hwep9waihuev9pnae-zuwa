		New("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
		tabIconFor(e, row, 18, 24)
		-- right cluster: [key] [tag] [mini switch]
		local right = 12
		local it = { row = row, bar = bar, e = e, y = y, h = ROW_H, first = first }
		local on
		if e.ctype == "toggle" and e.obj and type(e.obj.Get) == "function" then
			local ok, v = pcall(e.obj.Get, e.obj)
			if ok and type(v) == "boolean" then on = v end
		end
		if on ~= nil then
			local sw = New("TextButton", { Name = "SwitchTrack", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(30, 18),
				BackgroundColor3 = on and accent() or Color3.fromRGB(44, 46, 58), Text = "", AutoButtonColor = false, BorderSizePixel = 0 }, row)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, sw)
			local knob = New("Frame", { Name = "Knob", Position = on and UDim2.fromOffset(14, 2) or UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(14, 14),
				BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(142, 144, 152), BorderSizePixel = 0 }, sw)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
			it.sw, it.knob = sw, knob
			sw.MouseButton1Click:Connect(function()
				local ok, cur = pcall(e.obj.Get, e.obj)
				if not ok or type(cur) ~= "boolean" then return end
				pcall(e.obj.Set, e.obj, not cur)
				local ok2, now = pcall(e.obj.Get, e.obj)
				paintSwitch(it, ok2 and now == true or false)
				pcall(function() S.box:CaptureFocus() end)
			end)
			right = right + 30 + 8
		end
		local tag = tr(e.ctype)
		local tw = math.ceil(MeasureText(tag, 10, FONT)) + 14
		local chip = New("Frame", { Name = "TypeTag", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -right, 0.5, 0), Size = UDim2.fromOffset(tw, 18),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.94, BorderSizePixel = 0 }, row)
		New("UICorner", { CornerRadius = UDim.new(0, 5) }, chip)
		New("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = tag, TextSize = 10, Font = FONT, TextColor3 = MID }, chip)
		right = right + tw + 6
		local t = e.target
		if t and t.binds then
			for _, b in ipairs(t.binds) do
				local k = rawget(b, "key")
				if k then
					local kt = BindKeyName(k)
					local kw = math.ceil(MeasureText(kt, 10, FONT)) + 12
					local kc = New("Frame", { Name = "KeyTag", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -right, 0.5, 0), Size = UDim2.fromOffset(kw, 18),
						BackgroundColor3 = accent(), BackgroundTransparency = 0.86, BorderSizePixel = 0 }, row)
					New("UICorner", { CornerRadius = UDim.new(0, 5) }, kc)
					New("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = kt, TextSize = 10, Font = FONT, TextColor3 = accent() }, kc)
					right = right + kw + 6
					break
				end
			end
		end
		local textW = UDim2.new(1, -(44 + right + 8), 0, 18)
		New("TextLabel", { Name = "Title", Position = UDim2.fromOffset(44, 7), Size = textW, BackgroundTransparency = 1, RichText = true, Text = rich(disp(e), toks),
			TextSize = 14, Font = FONT, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
		local crumbs = {}
		for i, p in ipairs(e.path) do crumbs[i] = tr(p) end
		New("TextLabel", { Name = "Crumb", Position = UDim2.fromOffset(44, 26), Size = UDim2.new(1, -(44 + right + 8), 0, 14), BackgroundTransparency = 1,
			Text = table.concat(crumbs, "  ›  "), TextSize = 11, Font = FONT, TextColor3 = DIM, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
		it.index = #S.flat + 1
		S.flat[it.index] = it
		row.MouseEnter:Connect(function() S.select(it.index, true) end)
		row.MouseButton1Click:Connect(function() S.activate(it.index) end)
		return it
	end
