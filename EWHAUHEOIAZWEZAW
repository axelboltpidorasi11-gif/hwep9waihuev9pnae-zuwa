	local function hex(c)
		return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
	end
	local function trim(s) return (string.gsub(string.gsub(tostring(s or ""), "^%s+", ""), "%s+$", "")) end

	-- Case / diacritics folding by code point (Latin, Cyrillic: yo = e), one code point stays one.
	local fold = {}
	for base, chars in pairs({ a = "àáâãäåÀÁÂÃÄÅ", c = "çÇ", e = "èéêëÈÉÊË", i = "ìíîïÌÍÎÏ", n = "ñÑ", o = "òóôõöÒÓÔÕÖ",
		u = "ùúûüÙÚÛÜ", y = "ýÿÝ", s = "šŠ", z = "žŽ" }) do
		local b = string.byte(base)
		for _, cp in utf8.codes(chars) do fold[cp] = b end
	end
	local function foldcp(cp)
		if cp >= 65 and cp <= 90 then return cp + 32 end
		if cp < 128 then return cp end
		if cp >= 0x410 and cp <= 0x42F then return cp + 32 end
		if cp == 0x401 or cp == 0x451 then return 0x435 end
		return fold[cp] or cp
	end
	local function cps(s)
		local o, f = {}, {}
		pcall(function()
			for _, cp in utf8.codes(tostring(s or "")) do
				o[#o + 1] = cp
				f[#f + 1] = foldcp(cp)
			end
		end)
		return o, f
	end
	local function isSep(cp) return cp == 32 or cp == 45 or cp == 95 or cp == 47 or cp == 40 or cp == 41 or cp == 46 or cp == 58 or cp == 62 or cp == 8250 end
	-- score, positions (indices into text) or nil. Whole substring first (word starts win), then a subsequence.
	local function matchToken(tok, text)
		local n, m = #tok, #text
		if n == 0 or n > m then return nil end
		local best, bestPos
		for p = 1, m - n + 1 do
			local ok = true
			for k = 1, n do
				if text[p + k - 1] ~= tok[k] then ok = false break end
			end
			if ok then
				local sc = 100
				if p == 1 then sc = sc + 80 elseif isSep(text[p - 1]) then sc = sc + 60 end
				if n == m then sc = sc + 40 end
				if not best or sc > best then best, bestPos = sc, p end
			end
		end
		if best then
			local pos = {}
			for k = 1, n do pos[k] = bestPos + k - 1 end
			return best - m * 0.3, pos
		end
		if n < 3 then return nil end
		local pos, ti, last, gaps, ws = {}, 1, 0, 0, 0
		for k = 1, n do
			local found
			while ti <= m do
				if text[ti] == tok[k] then found = ti break end
				ti = ti + 1
			end
			if not found then return nil end
			pos[k] = found
			if last > 0 and found > last + 1 then gaps = gaps + (found - last - 1) end
			if found == 1 or isSep(text[found - 1]) then ws = ws + 1 end
			last = found
			ti = found + 1
		end
		if gaps > n * 2 + 2 then return nil end
		return 40 + ws * 12 - gaps * 2 - m * 0.2, pos
	end
	local function tokens(q)
		local out, cur = {}, {}
		local _, f = cps(q)
		for _, cp in ipairs(f) do
			if cp == 32 or cp == 9 then
				if #cur > 0 then out[#out + 1] = cur; cur = {} end
			else
				cur[#cur + 1] = cp
			end
		end
		if #cur > 0 then out[#out + 1] = cur end
		return out
	end
	local FIELD_W = { 1, 1, 0.45, 0.3 }
	local function scoreEntry(e, toks)
		local extra
		local t = e.target
		if t and t.binds and #t.binds > 0 then
			local parts = {}
			for _, b in ipairs(t.binds) do
				local k = rawget(b, "key")
				if k then parts[#parts + 1] = BindKeyName(k) end
			end
			if #parts > 0 then local _, f = cps(table.concat(parts, " ") .. " keybind hotkey bind"); extra = f end
		end
		local total = 0
		for _, tok in ipairs(toks) do
			local best
			local fields = { e.fLabel, e.fLoc, e.fCtx, extra }
			for fi = 1, 4 do
				local field = fields[fi]
				if field then
					local s = matchToken(tok, field)
					if s then
						s = s * FIELD_W[fi]
						if not best or s > best then best = s end
					end
				end
			end
			if not best then return nil end
			total = total + best
		end
		return total
	end
	local function disp(e)
		if Library._lang == "ru" and Library._ru and Library._ru[e.label] then return Library._ru[e.label] end
		return e.label
	end
	-- Display text with the matched letters in the accent (RichText, escaped).
	local function rich(text, toks)
		local o, f = cps(text)
		local mark = {}
		for _, tok in ipairs(toks or {}) do
			local s, pos = matchToken(tok, f)
			if s then for _, p in ipairs(pos) do mark[p] = true end end
		end
		local out, open = {}, false
		local col = hex(accent())
		for i, cp in ipairs(o) do
			local ch = utf8.char(cp)
			if ch == "&" then ch = "&amp;" elseif ch == "<" then ch = "&lt;" elseif ch == ">" then ch = "&gt;" elseif ch == '"' then ch = "&quot;" end
			if mark[i] and not open then out[#out + 1] = '<font color="' .. col .. '"><b>'; open = true end
			if not mark[i] and open then out[#out + 1] = "</b></font>"; open = false end
			out[#out + 1] = ch
		end
		if open then out[#out + 1] = "</b></font>" end
		return table.concat(out)
	end

	-- ---------------------------------------------------------------------------- index
	local KIND = {
		toggle = "toggle", settings_toggle = "toggle", accordion_toggle = "toggle", togglecolorpicker = "toggle",
		checkbox = "toggle", settings_checkbox = "toggle", accordion_checkbox = "toggle",
		slider = "slider", settings_slider = "slider", accordion_slider = "slider",
		dropdown = "dropdown", settings_dropdown = "dropdown", accordion_dropdown = "dropdown", dropdowncolorpicker = "dropdown", chips = "dropdown",
		colorpicker = "color", settings_colorpicker = "color", accordion_colorpicker = "color",
	}
	local function locate(row)
		local cur, guard, chain = row, 0, {}
		local section, secAt, plate
		while cur and cur ~= ctx.gui and guard < 80 do
			guard = guard + 1
			chain[#chain + 1] = cur
			if not plate and cur.Name == "SettingsFrame" then plate = cur end
			if not section and cur:GetAttribute("NLSectionName") ~= nil then section, secAt = cur, #chain end
			if cur:IsA("ScrollingFrame") and cur:GetAttribute("TabIndex") ~= nil then
				if not section then return nil end
				return cur, section, chain[secAt - 2] or row, plate
			end
			cur = cur.Parent
		end
		return nil
	end
	local function tabName(i) return tabs[i] and tabs[i].name or "" end
	local function subName(i, s)
		local t = tabs[i]
		local st = t and t.subTabs and s and t.subTabs[s]
		return st and st.name or nil
	end
	-- Page tabs (Section:AddPage) live under the row that opens them: returns the real tab / sub-tab and the pages.
	local function hostOf(tabIdx, subIdx)
		local guard, pages = 0, {}
		while tabs[tabIdx] and tabs[tabIdx].isPage and tabs[tabIdx].pageRow and guard < 4 do
			guard = guard + 1
			local col = locate(tabs[tabIdx].pageRow)
			if not col then break end
			table.insert(pages, 1, tabs[tabIdx])
			tabIdx, subIdx = col:GetAttribute("TabIndex"), col:GetAttribute("SubTabIndex")
		end
		return tabIdx, subIdx, pages
	end
	local function finish(e)
		local _, f = cps(e.label)
		e.fLabel = f
		local ru = Library._ru and Library._ru[e.label]
		if ru then local _, g = cps(ru); e.fLoc = g end
		local pieces = {}
		for _, p in ipairs(e.path) do
			pieces[#pieces + 1] = p
			if Library._ru and Library._ru[p] then pieces[#pieces + 1] = Library._ru[p] end
		end
		local _, c = cps(table.concat(pieces, " "))
		e.fCtx = c
		return e
	end
	function S.build()
		S.dirty = false
		local list, seen = {}, {}
		for ti, tab in ipairs(tabs) do
			if not tab.isPage then
				list[#list + 1] = finish({ kind = "tab", label = tab.name, tab = ti, path = {}, ctype = "tab", order = ti * 1e7 - 2, icon = tab.icon })
				for si, st in ipairs(tab.subTabs or {}) do
					list[#list + 1] = finish({ kind = "sub", label = st.name, tab = ti, sub = si, path = { tab.name }, ctype = "tab", order = ti * 1e7 + si * 1e5 - 2 })
				end
			elseif tab.pageRow then
				local col = locate(tab.pageRow)
				if col then
					local host, hsub = hostOf(ti, nil)
					local path = { tabName(host) }
					if subName(host, hsub) then path[#path + 1] = subName(host, hsub) end
					list[#list + 1] = finish({ kind = "page", label = tab.name, tab = host, sub = hsub, path = path, ctype = "page", page = tab, row = tab.pageRow, gate = tab.pageRow, order = host * 1e7 + (hsub or 0) * 1e5 + 9e4 })
				end
			end
		end
		for row, target in pairs(ctx.targets) do
			if typeof(row) == "Instance" and row.Parent and type(target) == "table" and target.label and target.label ~= "" then
				local column, section, gate, plate = locate(row)
				if column then
					local host, hsub, pages = hostOf(column:GetAttribute("TabIndex"), column:GetAttribute("SubTabIndex"))
					local path = { tabName(host) }
					if subName(host, hsub) then path[#path + 1] = subName(host, hsub) end
					local sectionTitle = tostring(section:GetAttribute("NLSectionName") or "")
					if #pages == 0 and sectionTitle ~= "" then path[#path + 1] = sectionTitle end
					for _, p in ipairs(pages) do path[#path + 1] = p.name end
					if #pages > 0 and sectionTitle ~= "" then path[#path + 1] = sectionTitle end
					if plate then
						local pt = plate:FindFirstChild("PlateTitle")
						local pn = pt and (pt:GetAttribute("LangBase") or pt.Text) or nil
						if pn and pn ~= "" then path[#path + 1] = pn end
					end
					local right = string.find(column.Name, "Right", 1, true) ~= nil
					local order = host * 1e7 + (hsub or 0) * 1e5 + (right and 5e4 or 0) + section.LayoutOrder * 300 + gate.LayoutOrder + (plate and row.LayoutOrder / 1000 or 0)
					local e = finish({
						kind = "element", label = target.label, tab = host, sub = hsub, path = path, row = row, gate = gate, column = column,
						ctype = KIND[target.kind] or "setting", obj = target.obj, target = target, plate = plate, pages = pages, order = order, section = section,
					})
					list[#list + 1] = e
					if not seen[section] and sectionTitle ~= "" and not plate then
						seen[section] = true
						local sp = {}
						for i = 1, #path - 1 do sp[i] = path[i] end
						list[#list + 1] = finish({ kind = "section", label = sectionTitle, tab = host, sub = hsub, path = sp, row = section, gate = section, column = column,
							ctype = "section", pages = pages, order = order - 1 - gate.LayoutOrder })
					end
				end
			end
		end
		table.sort(list, function(a, b) if a.order ~= b.order then return a.order < b.order end return a.label < b.label end)
		S.entries = list
	end
	local function shown(e)
		local rows = { e.gate }
		if e.kind == "element" and e.section then rows[2] = e.section end
		for _, g in ipairs(rows) do
			if not g.Parent then return false end
			local v = g:GetAttribute("NLSearchBaseVisible")
			if v == nil then v = g.Visible end
			if v == false then return false end
		end
		return true
	end
	function S.search(q)
		if S.dirty then S.build() end
		local toks = tokens(q)
		local hits = {}
		if #toks == 0 then return {}, toks, hits end
		for _, e in ipairs(S.entries) do
			if shown(e) then
				local sc = scoreEntry(e, toks)
				if sc then
					if e.kind ~= "element" then sc = sc - 25 end
					hits[#hits + 1] = { e = e, score = sc }
				end
			end
		end
		table.sort(hits, function(a, b) if a.score ~= b.score then return a.score > b.score end return a.e.order < b.e.order end)
		local groups, byKey = {}, {}
		for i = 1, math.min(#hits, 60) do
			local h = hits[i]
			local key = tostring(h.e.tab) .. ":" .. tostring(h.e.sub or 0)
			local g = byKey[key]
			if not g then
				g = { key = key, tab = h.e.tab, sub = h.e.sub, items = {} }
				byKey[key] = g
				groups[#groups + 1] = g
			end
			g.items[#g.items + 1] = h
		end
		return groups, toks, hits
	end

	-- ---------------------------------------------------------------------------- filter current tab
	local function activeColumns()
		local out = {}
		for _, holder in ipairs({ ctx.tabHose, ctx.subHose }) do
			for _, column in ipairs(holder:GetChildren()) do
				if column:IsA("ScrollingFrame") and column:GetAttribute("TabIndex") ~= nil then
					local ti = column:GetAttribute("TabIndex")
					local tab = tabs[ti]
					if ti == ctx.active() and tab then
						local si = column:GetAttribute("SubTabIndex")
						if (tab.activeSubTabIndex ~= nil and si == tab.activeSubTabIndex) or (tab.activeSubTabIndex == nil and si == nil) then
							out[#out + 1] = column
						end
					end
				end
			end
		end
		return out
	end
	local function setBase(inst, vis)
		if inst:GetAttribute("NLSearchBaseVisible") == nil then inst:SetAttribute("NLSearchBaseVisible", inst.Visible) end
		inst.Visible = vis
	end
	-- Rows of the open page that do not match are hidden (the old behaviour of the box); "" restores everything.
	function S.applyFilter(q)
		local toks = tokens(q)
		local on = S.filter and #toks > 0
		local hit = false
		if on and S.dirty then S.build() end
		local matched = {}
		if on then
			for _, e in ipairs(S.entries) do
				if e.kind == "element" and scoreEntry(e, toks) then matched[e.gate] = true end
			end
		end
		local cols = {}
		if on then
			cols = activeColumns()
		else
			for _, holder in ipairs({ ctx.tabHose, ctx.subHose }) do
				for _, column in ipairs(holder:GetChildren()) do
					if column:IsA("ScrollingFrame") then cols[#cols + 1] = column end
				end
			end
		end
		for _, column in ipairs(cols) do
			for _, section in ipairs(column:GetChildren()) do
				if section:IsA("Frame") and section.Name == "Section" then
					local elements = section:FindFirstChild("Elements")
					local title = section:FindFirstChild("SectionLabel", true)
					local titleHit = false
					if on and title then
						local _, f = cps(title.Text)
						titleHit = true
						for _, tok in ipairs(toks) do
							if not matchToken(tok, f) then titleHit = false break end
						end
					end
					local any = false
					if elements then
						for _, child in ipairs(elements:GetChildren()) do
							if child:IsA("GuiObject") then
								local base = child:GetAttribute("NLSearchBaseVisible")
								if base == nil and not on then
									-- never filtered: nothing to restore
								else
									if base == nil then base = child.Visible end
									local vis = base and (not on or titleHit or matched[child] == true)
									setBase(child, vis)
									if vis then any = true end
								end
							end
						end
						if on or elements:GetAttribute("NLSearchBaseVisible") ~= nil then
							local ebase = elements:GetAttribute("NLSearchBaseVisible")
							if ebase == nil then ebase = elements.Visible end
							setBase(elements, ebase and (not on or any))
						end
					end
					if on or section:GetAttribute("NLSearchBaseVisible") ~= nil then
						local sbase = section:GetAttribute("NLSearchBaseVisible")
						if sbase == nil then sbase = section.Visible end
						setBase(section, sbase and (not on or any))
					end
					if any then hit = true end
				end
			end
		end
		local emptyState = ctx.frame2:FindFirstChild("SearchEmptyState")
		if emptyState and emptyState:IsA("TextLabel") then
			emptyState.Visible = on and not hit
			if on and not hit then emptyState.Text = string.upper(tr("No matching settings")) end
		end
	end
	W._searchRefilter = function(delay)
		if not S.open or not S.filter then return end
		task.delay(delay or 0.05, function()
			if S.open and S.filter then S.applyFilter(trim(S.query)) end
		end)
	end

	-- ---------------------------------------------------------------------------- recent searches
	function S.pushRecent(text)
		text = trim(text)
		if text == "" then return end
		for i = #S.recent, 1, -1 do
			if string.lower(S.recent[i]) == string.lower(text) then table.remove(S.recent, i) end
		end
		table.insert(S.recent, 1, text)
		while #S.recent > 5 do table.remove(S.recent) end
	end
	W._configExtras.search_recent = {
		get = function()
			if #S.recent == 0 then return nil end
			local out = {}
			for i, s in ipairs(S.recent) do out[i] = s end
			return out
		end,
		set = function(v)
			S.recent = {}
			if type(v) == "table" then
				for _, s in ipairs(v) do
					if type(s) == "string" and #S.recent < 5 then S.recent[#S.recent + 1] = s end
				end
			end
		end,
	}

	-- ---------------------------------------------------------------------------- jump
	local function flash(row)
		if not row or not row.Parent then return end
		local old = row:FindFirstChild("_SearchFlash")
		if old then old:Destroy() end
		local f = New("Frame", {
			Name = "_SearchFlash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = accent(), BackgroundTransparency = 0.66,
			BorderSizePixel = 0, Active = false, ZIndex = 1500,
		}, row)
		New("UICorner", { CornerRadius = UDim.new(0, 9) }, f)
		local st = Stroke(f, "_SearchFlashRing")
		st.Color = accent(); st.Thickness = 1.5; st.Transparency = 0.1
		local dur = 0.6 * (Library._animScale == nil and 1 or Library._animScale)
		if dur <= 0 then f:Destroy() return end
		local info = TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		TweenService:Create(f, info, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(st, info, { Transparency = 1 }):Play()
		task.delay(dur + 0.05, function() if f.Parent then f:Destroy() end end)
	end
	local function reveal(e)
		local row = e.row
		local sf = row and row.Parent and row:FindFirstAncestorWhichIsA("ScrollingFrame")
		-- (plate rows sit in a non-scrolling container: scroll the page column that holds the owner row)
		while sf and not sf:GetAttribute("TabIndex") do sf = sf.Parent and sf.Parent:FindFirstAncestorWhichIsA("ScrollingFrame") or nil end
		local anchor = (e.plate and e.gate) or row
		if sf and anchor and anchor.Parent then
			local scale = ctx.scale()
			local relY = (anchor.AbsolutePosition.Y - sf.AbsolutePosition.Y) / scale + sf.CanvasPosition.Y
			local target = math.max(0, relY - (sf.AbsoluteSize.Y - anchor.AbsoluteSize.Y) / scale / 2)
			Library._anim.move(sf, { CanvasPosition = Vector2.new(0, target) }, "slow")
		end
		flash(row)
	end
	function S.jump(e)
		S.pushRecent(S.query)
		S.close()
		task.spawn(function()
			local host = tabs[e.tab]
			if not host then return end
			local wait = 0.04
			if ctx.active() ~= e.tab then
				host.activate()
				wait = 0.3
				task.wait(Library._motion.dur(wait))
				if e.sub and host.activeSubTabIndex ~= e.sub and host.subTabs and host.subTabs[e.sub] then
					host.subTabs[e.sub].activate()
					task.wait(Library._motion.dur(0.45))
				else
					task.wait(Library._motion.dur(0.2))
				end
			elseif e.sub and host.activeSubTabIndex ~= e.sub and host.subTabs and host.subTabs[e.sub] then
				host.subTabs[e.sub].activate()
				task.wait(Library._motion.dur(0.5))
			else
				task.wait(Library._motion.dur(wait))
			end
			if e.kind == "tab" or e.kind == "sub" then return end
			local pages = e.pages or (e.page and { e.page }) or {}
			if e.kind == "page" then pages = { e.page } end
			for _, p in ipairs(pages) do
				if p.openPage then p.openPage(); task.wait(Library._motion.dur(0.5)) end
			end
			if e.plate and W._plateOpen and W._plateOpen[e.plate] then
				pcall(function() W._plateOpen[e.plate]:Open() end)
				task.wait(Library._motion.dur(0.3))
			end
			if e.kind == "page" then
				flash(e.row)
			else
				reveal(e)
			end
		end)
	end

	-- ---------------------------------------------------------------------------- UI
	local function keycap(parent, text, order)
		local w = math.ceil(MeasureText(text, 10, FONT) + 12)
		local c = New("Frame", { Name = "Keycap", Size = UDim2.fromOffset(w, 16), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.92, BorderSizePixel = 0, LayoutOrder = order }, parent)
		New("UICorner", { CornerRadius = UDim.new(0, 4) }, c)
		New("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text, TextSize = 10, Font = FONT, TextColor3 = MID }, c)
		return c
