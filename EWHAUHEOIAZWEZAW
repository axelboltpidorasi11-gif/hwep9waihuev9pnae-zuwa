-- Option lists: at least the field's width (and 150), wide enough for the
-- longest option plus its tick and padding.
Library._listWidth = function(options, base)
	local width = math.max(base or 0, 150)
	if type(options) == "table" then
		for _, opt in ipairs(options) do
			width = math.max(width, math.ceil(MeasureText(tostring(opt), 14, FONT)) + 64)
		end
	end
	return width
end

-- Row fitting: labels run up to the first control on their right instead of
-- a fixed share of the row (long names cut early), and a row's "..." button
-- sits just left of its controls (switch, colour square, value).
-- Long text: no "...". The label clips, fades over the last ~18px, and while
-- `hover` (default: its parent) is hovered a ghost copy scrolls to show the
-- rest (Sine, max(0.6, overflow/60) s) and scrolls back on leave. Only acts
-- when TextBounds.X exceeds the label width; Text is never cut.
Library._fitState = setmetatable({}, { __mode = "k" })
Library._fitText = function(label, hover)
	if not label or not label.Parent then return end
	local S = Library._fitState[label]
	if S then S.refresh() return end
	hover = hover or label.Parent
	local over, active, pending, token = false, false, false, 0
	local ghost, tw, savedTT, origAlign
	local function restore()
		if ghost then ghost.Visible = false end
		if savedTT ~= nil then label.TextTransparency = savedTT; savedTT = nil end
	end
	local function refresh()
		if not label.Parent then return end
		if active and ghost and ghost.Text ~= label.Text then
			active = false; token += 1
			if tw then tw:Cancel(); tw = nil end
			restore()
		end
		local w = label.AbsoluteSize.X
		over = w > 0 and label.TextBounds.X > w - 1
		label.TextTruncate = Enum.TextTruncate.None
		label.ClipsDescendants = true
		local fade = label:FindFirstChild("FadeEnd")
		if over then
			if origAlign == nil then origAlign = label.TextXAlignment end
			label.TextXAlignment = Enum.TextXAlignment.Left
			if not fade then
				fade = Instance.new("UIGradient")
				fade.Name = "FadeEnd"
				fade.Parent = label
			end
			local k = math.clamp(18 / w, 0.05, 0.5)
			fade.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1 - k, 0), NumberSequenceKeypoint.new(1, 1),
			})
			fade.Enabled = not active
		else
			if origAlign ~= nil and not active then label.TextXAlignment = origAlign; origAlign = nil end
			if fade then fade.Enabled = false end
		end
	end
	local function request()
		if pending then return end
		pending = true
		task.defer(function() pending = false; pcall(refresh) end)
	end
	local function enter()
		if not over or active or label.TextScaled or not label.Parent then return end
		if label:IsA("TextBox") and label:IsFocused() then return end
		local W, c = math.ceil(label.TextBounds.X) + 2, label.AbsoluteSize.X
		local dx = W - c
		if dx <= 2 then return end
		active = true; token += 1
		if tw then tw:Cancel(); tw = nil end
		if not ghost then
			ghost = Instance.new("TextLabel")
			ghost.Name = "Marquee"
			ghost.BackgroundTransparency = 1
			ghost.BorderSizePixel = 0
			ghost.TextXAlignment = Enum.TextXAlignment.Left
			ghost.TextWrapped = false
			ghost.Active = false
			ghost.Parent = label
		end
		ghost.Font = label.Font
		ghost.TextSize = label.TextSize
		ghost.TextColor3 = label.TextColor3
		ghost.RichText = label.RichText
		ghost.Text = label.Text
		ghost.TextYAlignment = label.TextYAlignment
		ghost.ZIndex = label.ZIndex + 1
		ghost.Size = UDim2.new(0, W, 1, 0)
		if not ghost.Visible then ghost.Position = UDim2.fromOffset(0, 0) end
		if savedTT == nil then savedTT = label.TextTransparency end
		ghost.TextTransparency = savedTT
		ghost.Visible = true
		label.TextTransparency = 1
		local fade = label:FindFirstChild("FadeEnd")
		if fade then fade.Enabled = false end
		tw = TweenService:Create(ghost, TweenInfo.new(math.max(0.6, dx / 60), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, false, 0.12),
			{ Position = UDim2.fromOffset(-dx, 0) })
		tw:Play()
	end
	local function leave()
		if not active then return end
		active = false; token += 1
		local my = token
		if tw then tw:Cancel(); tw = nil end
		if not ghost then restore() return end
		local cur = math.abs(ghost.Position.X.Offset)
		local back = TweenService:Create(ghost, TweenInfo.new(math.max(0.25, cur / 150), Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ Position = UDim2.fromOffset(0, 0) })
		tw = back
		back.Completed:Connect(function()
			if token == my then tw = nil; restore(); request() end
		end)
		back:Play()
	end
	S = { refresh = refresh }
	Library._fitState[label] = S
	label:GetPropertyChangedSignal("TextBounds"):Connect(request)
	label:GetPropertyChangedSignal("AbsoluteSize"):Connect(request)
	label:GetPropertyChangedSignal("Text"):Connect(request)
	if label:IsA("TextBox") then label.Focused:Connect(leave) end
	if hover and hover:IsA("GuiObject") then
		hover.MouseEnter:Connect(function()
			if Library._hoverBlocked and Library._hoverBlocked(hover) then return end
			enter()
		end)
		hover.MouseLeave:Connect(leave)
	end
	refresh()
end
Library._fitSkip = { Lines = true, SettingsGear = true, Dropdown = true, DownBar = true, SettingsFrame = true, AccordionFrame = true, InputSink = true }
Library._fitRow = function(row, label)
	if not row.Parent or not label.Parent or row.AbsoluteSize.X <= 0 then return end
	local rowX, rowW = row.AbsolutePosition.X, row.AbsoluteSize.X
	local labelX = label.AbsolutePosition.X
	local leftmost = rowX + rowW
	for _, c in ipairs(row:GetChildren()) do
		if c ~= label and c:IsA("GuiObject") and c.Visible and not Library._fitSkip[c.Name] and c.ZIndex < row.ZIndex + 20
			and c.AbsoluteSize.X > 0 and c.AbsoluteSize.X < rowW * 0.9 then
			local x = c.AbsolutePosition.X
			if c:IsA("TextLabel") and c.TextXAlignment == Enum.TextXAlignment.Right then
				if c.Text == "" then x = rowX + rowW else x = x + c.AbsoluteSize.X - c.TextBounds.X end
			end
			if x > labelX + 24 and x < leftmost then leftmost = x end
		end
	end
	local gear = row:FindFirstChild("SettingsGear")
	local limit = leftmost
	if gear and gear:IsA("GuiObject") and not gear:GetAttribute("RowHit") then
		if gear:GetAttribute("AutoPlace") then
			gear.Position = UDim2.new((leftmost - 14 - rowX) / rowW, 0, 0.5, 0)
			limit = math.min(limit, leftmost - 14 - gear.AbsoluteSize.X / 2)
		else
			limit = math.min(limit, gear.AbsolutePosition.X)
		end
	end
	local width = math.max(20, limit - 8 - labelX)
	label.Size = UDim2.new(width / rowW, 0, label.Size.Y.Scale, label.Size.Y.Offset)
	-- Slightly too long: one or two points smaller before it gets clipped.
	if label:IsA("TextLabel") and label.TextSize >= 12 and label.Text ~= "" and label.TextBounds.X > 0 then
		local base = label:GetAttribute("BaseTextSize")
		if not base then base = label.TextSize label:SetAttribute("BaseTextSize", base) end
		local w0 = label.TextBounds.X * base / label.TextSize
		local size = base
		if w0 > width then
			for s = base - 1, math.max(base - 2, 12), -1 do
				size = s
				if w0 * s / base <= width then break end
			end
			if w0 * size / base > width then size = base end
		end
		if label.TextSize ~= size then label.TextSize = size end
	end
	-- Too long: clipped with a soft fade, scrolls on hover (no "...").
	Library._fitText(label, row)
end
Library._hookRow = function(label)
	local row = label.Parent
	if not row or not row:IsA("GuiObject") or row:GetAttribute("FitHooked") then return end
	row:SetAttribute("FitHooked", true)
	local pending = false
	local function request()
		if pending then return end
		pending = true
		task.defer(function()
			pending = false
			pcall(Library._fitRow, row, label)
		end)
	end
	row:GetPropertyChangedSignal("AbsoluteSize"):Connect(request)
	label:GetPropertyChangedSignal("Text"):Connect(request)
	row.ChildAdded:Connect(function(c)
		if c:IsA("TextLabel") then c:GetPropertyChangedSignal("TextBounds"):Connect(request) end
		request()
	end)
	for _, c in ipairs(row:GetChildren()) do
		if c:IsA("TextLabel") and c ~= label then c:GetPropertyChangedSignal("TextBounds"):Connect(request) end
	end
	request()
end

Library._valueSwap = function(obj)
	local prev = obj:GetAttribute("NLPrevText")
	obj:SetAttribute("NLPrevText", obj.Text)
	local k = Library._animScale or 1
	if prev == nil or prev == obj.Text or k <= 0 or Library._perfMode == "max" then return end
	if not obj.Parent or not obj.Visible or obj.AbsoluteSize.X <= 0 or not obj.Parent:IsA("GuiObject") or not obj.Parent.Visible then return end
	local base = obj:GetAttribute("NLSwapPos")
	if typeof(base) ~= "UDim2" then base = obj.Position obj:SetAttribute("NLSwapPos", base) obj:SetAttribute("NLSwapT", obj.TextTransparency) end
	local t0 = obj:GetAttribute("NLSwapT") or 0
	local old = obj.Parent:FindFirstChild("NLSwapGhost")
	if old then old:Destroy() end
	local ghost = Instance.new("TextLabel")
	ghost.Name = "NLSwapGhost"
	ghost:SetAttribute("NoTheme", true)
	ghost.BackgroundTransparency = 1
	ghost.Font, ghost.TextSize, ghost.TextColor3 = obj.Font, obj.TextSize, obj.TextColor3
	ghost.TextXAlignment, ghost.TextYAlignment, ghost.RichText = obj.TextXAlignment, obj.TextYAlignment, obj.RichText
	ghost.TextTruncate = Enum.TextTruncate.AtEnd
	ghost.AnchorPoint, ghost.Size, ghost.ZIndex = obj.AnchorPoint, obj.Size, obj.ZIndex
	ghost.Position, ghost.Text, ghost.TextTransparency = base, prev, t0
	ghost.Parent = obj.Parent
	local info = TweenInfo.new(0.12 * k, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(ghost, info, { Position = base + UDim2.fromOffset(0, -6), TextTransparency = 1 }):Play()
	task.delay(0.12 * k + 0.03, function() if ghost.Parent then ghost:Destroy() end end)
	obj.Position = base + UDim2.fromOffset(0, 6)
	obj.TextTransparency = 1
	TweenService:Create(obj, info, { Position = base, TextTransparency = t0 }):Play()
end

-- Keyboard focus ring: Tab / Shift+Tab move ONE shared accent ring (1px line +
-- soft 3px glow) through the visible controls of the open page; it glides
-- (base, Quint) between rows and hides on any mouse click / wheel. Only Tab shows it.
Library._kbFocusRows = { Toggle = true, Slider = true, Dropdown = true, MenuRow = true, Button = true, Keybind = true,
	Colorpicker = true, Selection = true, Textbox = true, TabButton = true }
Library._kbFocusInstall = function(ctx)
	local gui, main = ctx.gui, ctx.main
	if not gui or not main then return end
	local F = { idx = 0 }
	local function hide()
		if F.ring then F.ring.Visible = false end
		F.idx, F.target = 0, nil
	end
	local function ring()
		if F.ring and F.ring.Parent then return F.ring end
		local r = Instance.new("Frame")
		r.Name = "NLFocusRing"
		r:SetAttribute("NoTheme", true)
		r.BackgroundTransparency = 1
		r.ZIndex = 9990
		r.Visible = false
		r.Parent = gui
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = r
		local s = Instance.new("UIStroke"); s.Name = "Line"; s.Thickness = 1; s.Transparency = 0.1; s.Parent = r
		local g = Instance.new("Frame")
		g.Name = "Glow"; g.BackgroundTransparency = 1; g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.fromScale(0.5, 0.5); g.Size = UDim2.new(1, 2, 1, 2); g.ZIndex = 9989; g.Parent = r
		local gc = Instance.new("UICorner"); gc.CornerRadius = UDim.new(0, 9); gc.Parent = g
		local gs = Instance.new("UIStroke"); gs.Name = "Line"; gs.Thickness = 3; gs.Transparency = 0.75; gs.Parent = g
		F.ring = r
		return r
	end
	local function shown(o)
		local p = o
		while p and p ~= gui do
			if p:IsA("GuiObject") and not p.Visible then return false end
			if p:IsA("ScreenGui") and not p.Enabled then return false end
			p = p.Parent
		end
		local ap, as = o.AbsolutePosition, o.AbsoluteSize
		local mp, ms = main.AbsolutePosition, main.AbsoluteSize
		local cy = ap.Y + as.Y / 2
		if ap.X < mp.X or ap.X + as.X > mp.X + ms.X + 1 or cy < mp.Y or cy > mp.Y + ms.Y then return false end
		local sc = o:FindFirstAncestorWhichIsA("ScrollingFrame")
		if sc and (cy < sc.AbsolutePosition.Y + 4 or cy > sc.AbsolutePosition.Y + sc.AbsoluteSize.Y - 4) then return false end
		return true
	end
	local function collect()
		local list = {}
		for _, d in ipairs(main:GetDescendants()) do
			if Library._kbFocusRows[d.Name] and d:IsA("GuiObject") and d.AbsoluteSize.Y >= 20 and d.AbsoluteSize.Y <= 64
				and d.AbsoluteSize.X >= 60 and not d:FindFirstAncestor("SettingsFrame") and shown(d) then
				list[#list + 1] = d
			end
		end
		-- Reading order: sidebar, then each column top to bottom.
		table.sort(list, function(a, b)
			local ax, bx = math.floor(a.AbsolutePosition.X / 40), math.floor(b.AbsolutePosition.X / 40)
			if ax ~= bx then return ax < bx end
			return a.AbsolutePosition.Y < b.AbsolutePosition.Y
		end)
		return list
	end
	Library._uis("InputBegan", function(input, gp)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.Touch then hide() return end
		if input.KeyCode ~= Enum.KeyCode.Tab or gp or Library._kbTrap or UserInputService:GetFocusedTextBox() then return end
		if not main.Visible or main.AbsoluteSize.X <= 0 then hide() return end
		local list = collect()
		if #list == 0 then hide() return end
		local back = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		local cur = F.target and table.find(list, F.target) or nil
		if cur then F.idx = cur + (back and -1 or 1) else F.idx = back and #list or 1 end
		if F.idx < 1 then F.idx = #list elseif F.idx > #list then F.idx = 1 end
		local target = list[F.idx]
		F.target = target
		local r = ring()
		local accent = (ctx.accent and ctx.accent()) or Library._accentNow()
		for _, s in ipairs(r:GetDescendants()) do if s:IsA("UIStroke") then s.Color = accent end end
		local pos = UDim2.fromOffset(target.AbsolutePosition.X - 2, target.AbsolutePosition.Y - 1)
		local size = UDim2.fromOffset(target.AbsoluteSize.X + 4, target.AbsoluteSize.Y + 2)
		if not r.Visible then
			r.Position, r.Size, r.Visible = pos, size, true
			for _, s in ipairs(r:GetDescendants()) do
				if s:IsA("UIStroke") then
					local to = s.Thickness > 1 and 0.75 or 0.1
					s.Transparency = 1
					Library._anim.raw(s, { Transparency = to }, "fast")
				end
			end
		else
			Library._anim.raw(r, { Position = pos, Size = size }, "base")
		end
	end)
	Library._uis("InputChanged", function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then hide() end
	end)
	-- Config load / group switch: the visible rows flash the accent once
	-- (10ms stagger, at most 12 rows) so the changed page reads as "updated".
	F.flash = function()
		local k = Library._animScale or 1
		if k <= 0 or Library._perfMode == "max" or not main.Visible then return end
		local accent = (ctx.accent and ctx.accent()) or Library._accentNow()
		local n = 0
		for _, row in ipairs(collect()) do
			if row.Name ~= "TabButton" and n < 12 then
				n = n + 1
				task.delay((n - 1) * 0.01 * k, function()
					if not row.Parent then return end
					local old = row:FindFirstChild("NLFlash")
					if old then old:Destroy() end
					local f = Instance.new("Frame")
					f.Name = "NLFlash"
					f:SetAttribute("NoTheme", true)
					f.BackgroundColor3 = accent
					f.BackgroundTransparency = 0.82
					f.BorderSizePixel = 0
					f.Size = UDim2.fromScale(1, 1)
					f.ZIndex = row.ZIndex
					local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = f
					f.Parent = row
					TweenService:Create(f, TweenInfo.new(0.4 * k, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
					task.delay(0.4 * k + 0.05, function() if f.Parent then f:Destroy() end end)
				end)
			end
		end
	end
	return F
end

SizeSliderChip = function(effect, line, value)
	if not effect or not line or not value or not effect.Parent then return end
	local textWidth = MeasureText(tostring(value.Text or ""), 14, FONT)
	local chipWidth = math.clamp(math.ceil(textWidth) + 14, 34, 46)
	if textWidth + 14 > 46 then chipWidth = math.max(46, math.ceil(textWidth) + 10) end
	value.AnchorPoint = Vector2.new(1, 0.5)
	value.Position = UDim2.new(1, 0, 0.5, 0)
	value.Size = UDim2.fromOffset(chipWidth, 24)
	-- Quiet readout, as in NL (matches the New() SliderValue role).
	value.BackgroundColor3 = Color3.fromRGB(21, 22, 31)
	value.TextScaled = false
	value.TextSize = 12
	value.Font = FONT
	value.TextColor3 = Color3.fromRGB(176, 178, 188)
	value.TextTransparency = 0
	value.TextXAlignment = Enum.TextXAlignment.Center
	effect.AnchorPoint = Vector2.new(0, 0.5)
	-- Plates are narrow: start the slider earlier there so the track stays long.
	local inPlate = effect:FindFirstAncestor("SettingsFrame") or effect:FindFirstAncestor("AccordionFrame")
	-- NL: the track fills the free room between the label (and its "..." button)
	-- and the value box; anchored right, a UISizeConstraint keeps the track >= 96
	-- (the label is then clipped by Library._fitRow instead).
	local row = effect.Parent
	local label = row and (row:FindFirstChild("TextToggle") or row:FindFirstChild("TextDefault"))
	local labelEnd = 118
	if label and label:IsA("TextLabel") then
		local ts = label:GetAttribute("BaseTextSize") or label.TextSize
		labelEnd = label.Position.X.Offset + math.ceil(label.Position.X.Scale * (inPlate and 318 or 260)) + math.ceil(MeasureText(tostring(label.Text or ""), ts, label.Font)) + 18
		if row:FindFirstChild("SettingsGear") then labelEnd = labelEnd + 26 end
		if Library._fitRow and row:GetAttribute("NLSlEnd") ~= labelEnd then row:SetAttribute("NLSlEnd", labelEnd) task.defer(function() if row.Parent and label.Parent then pcall(Library._fitRow, row, label) end end) end
	end
	local isBar = line:GetAttribute("PlateBar")
	local minW = isBar and 72 or (((row and row:FindFirstChild("SettingsGear")) and 48 or 64) + chipWidth + 14)
	local flex = effect:FindFirstChild("NLFlexMin") or Instance.new("UISizeConstraint")
	flex.Name = "NLFlexMin"
	flex.MinSize = Vector2.new(minW, 0)
	flex.Parent = effect
	effect.AnchorPoint = Vector2.new(1, 0.5)
	effect.Position = UDim2.new(1, -12, 0.5, 0)
	if isBar then
		effect.Size = UDim2.new(1, -(labelEnd + 12), 0, (inPlate and 22) or 24)
	else
		-- ONE fixed track for every row slider (84, phone 96; 72 on a "..." row only when the label
		-- would be cut), right-anchored; the value box sits in a fixed slot (>= 46) at the right
		-- edge so all tracks share the same left edge and length.
		local trackW, slot = Library._phone and 96 or 84, 46
		local rowW = row and row.AbsoluteSize.X or 0
		if not Library._phone and row and row:FindFirstChild("SettingsGear") and rowW > 0 and labelEnd + 12 + trackW + 10 + math.max(chipWidth, slot) > rowW then trackW = 72 end
		-- A wider value ("180.0°") takes its extra room from the track, keeping the left edge.
		if chipWidth > slot then trackW = math.max(trackW - (chipWidth - slot), 56) slot = chipWidth end
		-- Still cutting the label ("Reaction Time" + "..." + 200ms): the track gives way, down to 56.
		if row and row:FindFirstChild("SettingsGear") and rowW > 0 and labelEnd + 12 + trackW + 10 + slot > rowW then
			trackW = math.max(56, rowW - labelEnd - 12 - 10 - slot)
		end
		flex.MinSize = Vector2.new(0, 0)
		effect.Size = UDim2.fromOffset(trackW + 10 + slot, (inPlate and 22) or 24)
		effect:SetAttribute("NLTrackW", trackW)
	end
	line.AnchorPoint = Vector2.new(0, 0.5)
	line.Position = UDim2.new(0, 0, 0.5, 0)
	if line:GetAttribute("PlateBar") then
		-- Plate slider: the same boxed readout as section sliders, but one fixed
		-- width for every plate slider so all bars are equally long and never
		-- jump while dragging. Grows only for a value that does not fit.
		-- The value is a small bubble over the end of the fill, shown while the
		-- bar is hovered or dragged (NL); the bar takes the full width.
		value.Size = UDim2.fromOffset(math.ceil(MeasureText(tostring(value.Text or ""), 13, FONT)) + 12, 18)
		value.TextSize = 13
		value.AnchorPoint = Vector2.new(0.5, 1)
		value.TextXAlignment = Enum.TextXAlignment.Center
		value.TextYAlignment = Enum.TextYAlignment.Center
		value.TextTruncate = Enum.TextTruncate.None
		line.Size = UDim2.new(1, 0, 0, 22)
		line.BackgroundTransparency = 1
		local fill = line:FindFirstChild("InLine", true)
		value.Position = UDim2.new(fill and fill.Size.X.Scale or 0, 0, 0, 0)
		if not line:GetAttribute("BubbleHooked") then
			line:SetAttribute("BubbleHooked", true)
			local hovered, dragging = false, false
			local function show(on)
				line:SetAttribute("BubbleShown", on)
				value.Visible = true
				Tween(value, { BackgroundTransparency = on and 0 or 1, TextTransparency = on and 0 or 1 }, 0.12)
				local outline = value:FindFirstChildOfClass("UIStroke")
				if outline then Tween(outline, { Transparency = on and 0.9 or 1 }, 0.12) end
			end
			value.BackgroundTransparency, value.TextTransparency = 1, 1
			local outline = value:FindFirstChildOfClass("UIStroke")
			if outline then outline.Transparency = 1 end
			line.MouseEnter:Connect(function() if Library._hoverBlocked(line) then return end hovered = true; show(true) end)
			line.MouseLeave:Connect(function() hovered = false; if not dragging then show(false) end end)
			line.InputBegan:Connect(function(input)
				if IsPrimaryInput(input) then dragging = true; show(true) end
			end)
			Library._uis("InputEnded", function(input)
				if dragging and IsPrimaryInput(input) then
					dragging = false
					if not hovered then show(false) end
				end
			end)
			if fill then
				fill:GetPropertyChangedSignal("Size"):Connect(function()
					value.Position = UDim2.new(fill.Size.X.Scale, 0, 0, 0)
				end)
			end
		end
		-- Every refresh (the value text changed) restyles the readout above:
		-- keep it hidden unless the bubble is up.
		if not line:GetAttribute("BubbleShown") then
			value.BackgroundTransparency, value.TextTransparency = 1, 1
			local outline = value:FindFirstChildOfClass("UIStroke")
			if outline then outline.Transparency = 1 end
		end
	else
		line.Size = UDim2.fromOffset(effect:GetAttribute("NLTrackW") or 84, 4)
		line.BackgroundColor3 = Color3.fromRGB(40, 42, 54)
	end
	line.BorderSizePixel = 0
	if not value:GetAttribute("NLSliderChipWatch") then
		value:SetAttribute("NLSliderChipWatch", true)
		value:GetPropertyChangedSignal("Text"):Connect(function()
			if value.Parent and effect.Parent then task.defer(function()
				if value.Parent and effect.Parent then SizeSliderChip(effect, line, value) end
			end) end
		end)
	end
end

local function BindKeyName(key)
	if not key then return "—" end
	local n
	if type(key) == "string" then
		n = key
	else
		local ok, keyName = pcall(function() return key.Name end)
		if ok then n = keyName end
	end
	if type(n) ~= "string" then return tostring(key) end
	local mb = string.match(n, "^MouseButton(%d)$")
	if mb then return "MB" .. mb end
	if n == "MouseWheelUp" then return "Wheel Up" end
	if n == "MouseWheelDown" then return "Wheel Down" end
	return (string.gsub(n, "(%l)(%u)", "%1 %2"))
end

local function EllipsizeTo(label, maxWidth)
	if not label or not label:IsA("TextLabel") and not label:IsA("TextButton") then return end
	if type(maxWidth) ~= "number" or maxWidth <= 0 then return end
	local full = label:GetAttribute("FullText")
	if type(full) ~= "string" or full == "" then
		full = label.Text
		label:SetAttribute("FullText", full)
	end
	if full == "" then return end
	local fontSize = label.TextSize or 14
	local font = label.Font or FONT
	local unscaled = MeasureText(full, fontSize, font)
	if unscaled <= 0 then return end
	local scale = 1
	if label.TextScaled and label.TextBounds.X > 0 then
		scale = label.TextBounds.X / unscaled
		if scale <= 0 or scale ~= scale then scale = 1 end
	end
	local function rendered(text)
		return MeasureText(text, fontSize, font) * scale
	end
	if rendered(full) <= maxWidth then
		if label.Text ~= full then label.Text = full end
		return
	end
	local low, high, best = 1, #full, ""
	while low <= high do
		local mid = math.floor((low + high) / 2)
		local candidate = full:sub(1, mid) .. ELLIPSIS
		if rendered(candidate) <= maxWidth then
			best = candidate
			low = mid + 1
		else
			high = mid - 1
		end
	end
	label.Text = best ~= "" and best or ELLIPSIS
end



