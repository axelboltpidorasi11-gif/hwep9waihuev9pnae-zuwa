		function TabObj:SetGroupPresets(opts)
			opts = type(opts) == "table" and opts or {}
			local tabName = name
			local G = {
				items = {}, custom = {}, selected = "Global", cats = Library._groupsUI.cats(opts.Items),
				onChanged = opts.OnChanged, onCreated = opts.OnCreated, onEdited = opts.OnEdited, onDeleted = opts.OnDeleted,
			}
			-- items = every offered weapon (flat); cats = the picker's { { category, names } }.
			for _, c in ipairs(G.cats) do for _, it in ipairs(c[2]) do table.insert(G.items, it) end end
			if type(opts.Templates) == "table" then
				G.templates = {}
				for _, t in ipairs(opts.Templates) do
					if type(t) == "table" and (t.name or t.Name) then
						local its = {}
						for _, it in ipairs(type(t.items or t.Items) == "table" and (t.items or t.Items) or {}) do table.insert(its, tostring(it)) end
						table.insert(G.templates, { name = tostring(t.name or t.Name), items = its, icon = t.icon or t.Icon })
					end
				end
			end
			for _, gn in ipairs(type(opts.Groups) == "table" and opts.Groups or {}) do
				local gt = type(gn) == "table"
				local nm = tostring(gt and (gn.Name or gn.name) or gn)
				if nm ~= "Global" and nm ~= "nil" then
					local its = {}
					for _, it in ipairs(gt and type(gn.Items or gn.items) == "table" and (gn.Items or gn.items) or {}) do table.insert(its, tostring(it)) end
					table.insert(G.custom, { name = nm, items = its })
				end
			end
			-- Per-group element values (Library._gvInstall): this tab's elements.
			G.tab = tabName
			do
				-- Called again: the old groups' controls go back to Global first.
				local prev = WindowObj._tabGroups[tabName]
				if prev and prev.selected ~= "Global" then WindowObj._gvSwitch(prev, "Global") end
			end
			WindowObj._tabGroups[tabName] = G
			local api = WindowObj._groupAPI
			if opts.Default and opts.Default ~= "Global" then api.select(G, tostring(opts.Default), true) end
			WindowObj._configExtras["groups_" .. tabName] = {
				get = function()
					local out = {}
					for _, g in ipairs(G.custom) do
						-- values: the group's overrides { [config key] = value }; Global = the element values.
						table.insert(out, { name = g.name, items = { table.unpack(g.items) }, values = WindowObj._gvExport(G, g.name) })
					end
					return { selected = G.selected, groups = out }
				end,
				set = function(v)
					if type(v) ~= "table" then return end
					local known = {}
					for _, g in ipairs(G.custom) do known[g.name] = true end
					G.custom = {}
					G.values = {}
					-- Older saves: groups as plain names, or the list itself at the top level.
					for _, g in ipairs(type(v.groups) == "table" and v.groups or (v[1] ~= nil and v) or {}) do
						if type(g) == "string" then g = { name = g, items = {} } end
						if type(g) == "table" and type(g.name) == "string" and g.name ~= "" and g.name ~= "Global" then
							local its = {}
							for _, it in ipairs(type(g.items) == "table" and g.items or {}) do table.insert(its, tostring(it)) end
							table.insert(G.custom, { name = g.name, items = its })
							WindowObj._gvImport(G, g.name, g.values)
							if not known[g.name] then InvokeCallback(G.onCreated, g.name, { table.unpack(its) }) end
						end
					end
					api.select(G, tostring(v.selected or "Global"))
					api.rebuild()
				end,
			}
			if WindowObj._syncGroups then WindowObj._syncGroups() end
			return self
		end
