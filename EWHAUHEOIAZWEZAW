-- Tab:AddInventory(o) body. ctx = { Left, Right, W, main, host, scale(), place(), safe(), accent(), name }.
Library._invBuild = function(o, ctx)
	local tBuild = os.clock()
	o = type(o) == "table" and o or {}
	local D = Library._invDefaults
	local S = { cb = type(o.Callbacks) == "table" and o.Callbacks or {} }
	-- typing in a search box: filter 0.15s after the last keystroke (one pass, not one per letter)
	function S.debounce(fn, delay)
		local token = 0
		return function()
			token = token + 1
			local mine = token
			task.delay(delay or 0.15, function() if mine == token then fn() end end)
		end
	end
	Library._invAccentFn = ctx.accent
	local W = ctx.W
	S.sides = type(o.Sides) == "table" and #o.Sides > 0 and o.Sides or { "CT", "T" }
	-- categories: defaults merged with the caller's (strings or tables), keyed by id
	S.cats, S.catList = {}, {}
	for _, c in ipairs(D.categories) do
		local t = {}
		for k, v in pairs(c) do t[k] = v end
		S.cats[t.id] = t
	end
	if type(o.Categories) == "table" then
		for _, c in ipairs(o.Categories) do
			local id = type(c) == "table" and tostring(c.id or c.Id or c.name) or tostring(c)
			local t = S.cats[id] or { id = id, name = id, icon = "box" }
			if type(c) == "table" then for k, v in pairs(c) do t[k] = v end end
			t.id = id
			S.cats[id] = t
			table.insert(S.catList, t)
		end
	else
		for _, c in ipairs(D.categories) do table.insert(S.catList, S.cats[c.id]) end
	end
	S.columns = type(o.Columns) == "table" and o.Columns or D.columns
	S.gear = type(o.Gear) == "table" and o.Gear or D.gear
	S.slotCount = o.Slots or 5
	local function fire(name, ...)
		local f = S.cb[name] or o[name]
		if type(f) == "function" then
			local ok, err = pcall(f, ...)
			if not ok then warn("[inventory] " .. name .. ": " .. tostring(err)) end
		end
	end
	-- items
	function S.loadItems()
		local list = o.Items
		if type(list) == "function" then
			local ok, res = pcall(list)
			list = ok and res or {}
		end
		S.items, S.byId = {}, {}
		for i, raw in ipairs(type(list) == "table" and list or {}) do
			local it = Library._invNorm(raw, i)
			if it then
				it.category = tostring(it.category or "pistol")
				local cat = S.cats[it.category]
				it.icon = it.icon or (cat and cat.icon) or "box"
				local skins = {}
				for j, sk in ipairs(type(it.skins) == "table" and it.skins or {}) do
					local s = Library._invNorm(sk, j)
					if s then s.icon = s.icon or it.icon; table.insert(skins, s) end
				end
				it.skins = skins
				table.insert(S.items, it)
				S.byId[it.id] = it
			end
		end
		S.stickers = {}
		for i, raw in ipairs(type(o.Stickers) == "table" and o.Stickers or {}) do
			local s = Library._invNorm(raw, i)
			if s then s.icon = s.icon or "sticker"; s.category = "sticker"; table.insert(S.stickers, s) end
		end
		for _, it in ipairs(S.items) do if it.category == "sticker" then table.insert(S.stickers, it) end end
	end
	S.loadItems()
	function S.onSide(it, side)
		if it.side == nil or it.side == "Both" or it.side == side then return true end
		if type(it.side) == "table" then for _, s in ipairs(it.side) do if s == side then return true end end end
		return false
	end
	function S.catItems(catId, side)
		local out = {}
		for _, it in ipairs(catId == "sticker" and S.stickers or S.items) do
			if (catId == "sticker" or it.category == catId) and (side == nil or S.onSide(it, side)) then table.insert(out, it) end
		end
		return out
	end
	-- slots: "w<col>_<i>" weapon slots, "g_<category>" gear slots
	S.slots = {}
	for c, col in ipairs(S.columns) do
		for i = 1, S.slotCount do table.insert(S.slots, { key = "w" .. c .. "_" .. i, col = c, index = i, cats = col.categories or { col.category } }) end
	end
	for _, g in ipairs(S.gear) do table.insert(S.slots, { key = "g_" .. g, gear = g, cats = { g } }) end
	S.slotByKey = {}
	for _, sl in ipairs(S.slots) do S.slotByKey[sl.key] = sl end
	function S.candidates(slot, side)
		local out, seen = {}, {}
		for _, cid in ipairs(slot.cats) do
			for _, it in ipairs(S.catItems(cid, side)) do
				if not seen[it.id] then seen[it.id] = true; table.insert(out, it) end
			end
		end
		return out
	end
	-- state (saved with the config)
	local state = { side = S.sides[1], slots = {}, items = {} }
	S.state = state
	if o.Side then for _, s in ipairs(S.sides) do if s == o.Side then state.side = s end end end
	function S.defaults(side)
		state.slots[side] = state.slots[side] or {}
		state.items[side] = state.items[side] or {}
		local given = type(o.Loadout) == "table" and type(o.Loadout[side]) == "table" and o.Loadout[side] or {}
		for _, sl in ipairs(S.slots) do
			if state.slots[side][sl.key] == nil then
				local want = given[sl.key]
				if want == nil and sl.col then
					local list = given[S.columns[sl.col].name]
					want = type(list) == "table" and list[sl.index] or nil
				elseif want == nil and sl.gear then
					want = given[sl.gear]
				end
				if want ~= nil and want ~= false then
					state.slots[side][sl.key] = tostring(want)
				elseif want == nil then
					local cands = S.candidates(sl, side)
					local cat = S.cats[sl.gear or ""]
					if sl.col then
						-- the n-th candidate not used by an earlier slot of this column
						local used = {}
						for i = 1, sl.index - 1 do
							local id = state.slots[side]["w" .. sl.col .. "_" .. i]
							if id then used[id] = true end
						end
						for _, it in ipairs(cands) do if not used[it.id] then state.slots[side][sl.key] = it.id break end end
					elseif cat and cat.kind ~= "items" and cands[1] then
						state.slots[side][sl.key] = cands[1].id
					elseif sl.gear == "agent" and cands[1] then
						state.slots[side][sl.key] = cands[1].id
					end
				end
			end
		end
	end
	for _, s in ipairs(S.sides) do S.defaults(s) end
	function S.item(id) return id and S.byId[id] or nil end
	function S.entry(side, id)
		local t = state.items[side][id]
		if not t then t = {}; state.items[side][id] = t end
		return t
	end
	function S.skinOf(it, name)
		if not it or not name then return nil end
		for _, s in ipairs(it.skins) do if s.name == name then return s end end
		return nil
	end
	function S.stockName(it)
		local cat = it and S.cats[it.category]
		return (cat and cat.stockName) or "No Skin"
	end
	function S.display(it)
		local cat = it and S.cats[it.category]
		return (cat and cat.star and "★ " or "") .. (it and it.name or "")
	end
	-- What a slot shows: { image, rarity, icon, caption, sub, empty }.
	function S.slotLook(side, key)
		local sl = S.slotByKey[key]
		local id = state.slots[side][key]
		local it = S.item(id)
		if not it then
			local cat = S.cats[sl.gear or (sl.cats and sl.cats[1]) or ""]
			return { image = false, rarity = false, icon = cat and cat.icon or "box", caption = cat and cat.name or "", sub = "", empty = true }
		end
		local e = state.items[side][it.id] or {}
		local skin = S.skinOf(it, e.skin)
		return {
			image = skin and skin.image or it.image or false, rarity = skin and skin.rarity or it.rarity or "Stock", icon = it.icon,
			caption = it.name, sub = skin and skin.name or "", empty = false,
		}
	end

	-- -------------------------------------------------------------- main page
	ctx.Left.Size = UDim2.new(1, -12, 1, 0)
	ctx.Right.Size = UDim2.new(0, 0, 1, 0)
	local page = New("Frame", { Name = "Inventory", Size = UDim2.new(1, 0, 0, 440), BackgroundTransparency = 1, LayoutOrder = 1 }, ctx.Left)
	S.page = page
	local function fitHeight()
		local g = ctx.scale and ctx.scale() or 1
		local h = ctx.Left.AbsoluteSize.Y / (g > 0 and g or 1) - 14
		if h > 100 then page.Size = UDim2.new(1, 0, 0, h) end
	end
	ctx.Left:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitHeight)
	task.defer(fitHeight)
	-- Team emblem (round): o.Emblems[side] > Library._sideIcon(side) (asset id or icon-pack name)
	-- > the old menu's team thumbnails (rbxthumb, 10px white margin cropped).
	S.teamIcon = { CT = "rbxthumb://type=Asset&id=259949118&w=150&h=150", T = "rbxthumb://type=Asset&id=9159346967&w=150&h=150" }
	function S.emblem(parent, side, px, x)
		local col = (type(o.SideColors) == "table" and o.SideColors[side]) or D.sideColor[side] or Color3.fromRGB(200, 204, 218)
		local em = New("Frame", {
			Name = "Emblem", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, x or 3, 0.5, 0), Size = UDim2.fromOffset(px, px),
			BackgroundColor3 = col, BackgroundTransparency = 0.55, BorderSizePixel = 0,
		}, parent)
		New("UICorner", { CornerRadius = UDim.new(1, 0) }, em)
		local src = type(o.Emblems) == "table" and o.Emblems[side] or nil
		local fb = side == "T" and "t" or (side == "CT" and "ct" or nil)
		if not src and Library._sideIcon then
			local ok, v, f = pcall(Library._sideIcon, side) -- (id, fallbackName, isThumb); any part may be nil
			if ok and type(v) == "string" and v ~= "" then src = v end
			if ok and type(f) == "string" and f ~= "" then fb = f end
		end
		src = src or S.teamIcon[side]
		local function packIcon()
			em.BackgroundTransparency = 1
			local name = fb
			-- the pack names ct / t may not exist yet: the old shield / bomb then
			if Library._iconPack and (name == "ct" or name == "t") and not Library._iconPack[name] then name = name == "t" and "bomb" or "shield" end
			if Library._icon and name then Library._icon(em, name, px, col:Lerp(Color3.new(1, 1, 1), 0.2)) end
		end
		if src and string.find(src, "://", 1, true) then
			em.BackgroundTransparency = 0.8
			local img = New("ImageLabel", {
				Name = "TeamLogoIcon", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = src, ScaleType = Enum.ScaleType.Stretch, NoTheme = true,
			}, em)
			if string.find(src, "rbxthumb", 1, true) then img.ImageRectOffset = Vector2.new(10, 10); img.ImageRectSize = Vector2.new(130, 130) end
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, img)
			-- the thumbnail did not load (blocked / sim): the tintable pack art instead
			if fb then
				Library._imgWatch(img, 4, function() img:Destroy(); packIcon() end)
			end
		elseif src then
			fb = src
			packIcon()
		else
			New("TextLabel", { Name = "EmblemText", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = side, TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 8, Font = FONT_BOLD }, em)
		end
		return em, col
	end
	-- Soft rarity line (2px, faded ends) under previews: the only decoration of an empty preview.
	function S.softLine(parent, name, pos, width)
		local l = New("Frame", {
			Name = name, AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.new(width, 0, 0, 2),
			BackgroundColor3 = Color3.fromRGB(222, 214, 200), BackgroundTransparency = 0, BorderSizePixel = 0,
		}, parent)
		local g = Instance.new("UIGradient")
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = l
		return l
	end
	-- Loadout board: side switch, agent, 3x2 gear slots, weapon columns. Built for the main page
	-- and again (larger) for the full-screen inventory; refreshMain paints every board.
	-- onSlot(key) = slot click. Returns B { cards, heads, sideBtns, agentImg, agentLine, ref }.
	S.boards = {}
	function S.buildBoard(parent, onSlot, big)
		local B = { cards = {}, heads = {}, sideBtns = {}, big = big }
		local gapX = big and 18 or 12
		local sideP = New("Frame", { Name = "SidePanel", Size = UDim2.new(0.31, 0, 1, 0), BackgroundTransparency = 1 }, parent)
		local gridP = New("Frame", { Name = "Loadout", Position = UDim2.new(0.31, gapX, 0, 0), Size = UDim2.new(0.69, -gapX, 1, 0), BackgroundTransparency = 1 }, parent)
		B.sideP = sideP
		-- Phones, portrait-shaped page: side panel on top, weapon columns under it.
		if Library._phone and not big then
			local function stack()
				local s = parent.AbsoluteSize
				local tall = s.X > 0 and s.Y > s.X * 1.2
				sideP.Size = tall and UDim2.new(1, 0, 0, 300) or UDim2.new(0.31, 0, 1, 0)
				gridP.Position = tall and UDim2.new(0, 0, 0, 312) or UDim2.new(0.31, gapX, 0, 0)
				gridP.Size = tall and UDim2.new(1, 0, 1, -312) or UDim2.new(0.69, -gapX, 1, 0)
			end
			parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(stack)
			task.defer(stack)
		end
		B.ref = New("Frame", { Name = "ScaleRef", Size = UDim2.fromOffset(100, 0), BackgroundTransparency = 1 }, sideP)
		-- side switch: the open side is a pill "<emblem> CT Loadout", the other a round emblem
		for i, side in ipairs(S.sides) do
			local b = New("TextButton", {
				Name = "Side_" .. side, Position = UDim2.fromOffset(0, 2), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = Color3.fromRGB(32, 36, 50),
				BackgroundTransparency = 1, AutoButtonColor = false, Text = "", ClipsDescendants = true,
			}, sideP)
			New("UICorner", { CornerRadius = UDim.new(0, 7) }, b)
			local _, col = S.emblem(b, side, 18)
			local title = New("TextLabel", {
				Name = "SideTitle", Position = UDim2.fromOffset(27, 0), Size = UDim2.new(0, 100, 1, 0), BackgroundTransparency = 1,
				Text = side .. " Loadout", TextColor3 = col:Lerp(Color3.new(1, 1, 1), 0.25), TextSize = 14, Font = FONT,
				TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1,
			}, b)
			b.MouseEnter:Connect(function()
				if Library._hoverBlocked and Library._hoverBlocked(b) then return end
				if state.side ~= side then Library._anim.fade(b, { BackgroundTransparency = 0.6 }, "fast") end
			end)
			b.MouseLeave:Connect(function() if state.side ~= side then Library._anim.fade(b, { BackgroundTransparency = 1 }, "fast", true) end end)
			b.MouseButton1Click:Connect(function() if state.side ~= side then S.setSide(side) end end)
			B.sideBtns[side] = { button = b, title = title, index = i }
		end
		sideP:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() S.layoutSides(true) end)
		-- agent (artwork only; empty when there is none; click = agent picker)
		local agentBox = New("TextButton", { Name = "AgentView", Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 1, -200), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, sideP)
		B.agentBox = agentBox
		B.agentLine = S.softLine(agentBox, "AgentLine", UDim2.new(0.5, 0, 1, -4), 0.62)
		B.agentImg = New("ImageLabel", { Name = "AgentImage", Size = UDim2.new(1, 0, 1, -10), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, Image = "", Visible = false, NoTheme = true }, agentBox)
		agentBox.MouseButton1Click:Connect(function()
			if Library._swiped and Library._swiped() then return end
			if S.slotByKey.g_agent then onSlot("g_agent") end
		end)
		-- gear slots (3 x 2)
		local gear = New("Frame", { Name = "Gear", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, sideP)
		New("UIAspectRatioConstraint", { AspectRatio = 1.5, DominantAxis = Enum.DominantAxis.Width }, gear)
		New("UIGridLayout", { CellSize = UDim2.new(1 / 3, -6, 0.5, -4), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, gear)
		for i, g in ipairs(S.gear) do
			local key = "g_" .. g
			local card = Library._itemCard(gear, { label = false, order = i, center = true, onClick = function() onSlot(key) end })
			card.frame.Name = "Gear_" .. g
			B.cards[key] = card
		end
		local function fitAgent()
			local g = B.ref.AbsoluteSize.X / 100
			local gh = gear.AbsoluteSize.Y / (g > 0 and g or 1)
			if gh > 0 then agentBox.Size = UDim2.new(1, 0, 1, -(36 + gh + 10)) end
		end
		gear:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitAgent)
		task.defer(fitAgent)
		-- weapon columns
		local head = New("Frame", { Name = "ColumnHeads", Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1 }, gridP)
		local cols = New("Frame", { Name = "Columns", Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), BackgroundTransparency = 1 }, gridP)
		local gap = big and 10 or 8
		New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder }, cols)
		local n = #S.columns
		for c, col in ipairs(S.columns) do
			B.heads[c] = New("TextLabel", {
				Name = "ColumnTitle", Position = UDim2.new((c - 1) / n, gap * (c - 1) / n, 0, 0), Size = UDim2.new(1 / n, -gap * (n - 1) / n, 1, 0), BackgroundTransparency = 1,
				Text = tostring(col.name), TextColor3 = Color3.fromRGB(226, 228, 236), TextSize = big and 15 or 14, Font = FONT, RichText = true,
			}, head)
			local colF = New("Frame", { Name = "Column" .. c, Size = UDim2.new(1 / n, -(gap * (n - 1)) / n, 1, 0), BackgroundTransparency = 1, LayoutOrder = c }, cols)
			local vg = big and 9 or 7
			New("UIListLayout", { Padding = UDim.new(0, vg), SortOrder = Enum.SortOrder.LayoutOrder }, colF)
			for i = 1, S.slotCount do
				local key = "w" .. c .. "_" .. i
				B.cards[key] = Library._itemCard(colF, {
					label = false, order = i, size = UDim2.new(1, 0, 1 / S.slotCount, -vg * (S.slotCount - 1) / S.slotCount),
					onClick = function() onSlot(key) end,
				})
			end
		end
		table.insert(S.boards, B)
		task.defer(S.layoutSides, true)
		return B
	end
	function S.layoutSides(instant)
		for _, B in ipairs(S.boards) do
			local widths, total = {}, 0
			for _, side in ipairs(S.sides) do
				local w = side == state.side and math.ceil(27 + MeasureText(side .. " Loadout", 14, FONT) + 10) or 24
				widths[side] = w
				total = total + w + 8
			end
			local g = B.ref.AbsoluteSize.X / 100
			local x = math.max(0, math.floor((B.sideP.AbsoluteSize.X / (g > 0 and g or 1) - (total - 8)) / 2))
			for _, side in ipairs(S.sides) do
				local e = B.sideBtns[side]
				local open = side == state.side
				local goal = { Size = UDim2.fromOffset(widths[side], 24), Position = UDim2.fromOffset(x, 2), BackgroundTransparency = open and 0 or 1 }
				if instant then
					for k, v in pairs(goal) do e.button[k] = v end
					e.title.TextTransparency = open and 0 or 1
				else
					Library._anim.move(e.button, goal, "slow")
					Library._anim.fade(e.title, { TextTransparency = open and 0 or 1 }, "base", not open)
				end
				x = x + widths[side] + 8
			end
		end
	end
	S.main = S.buildBoard(page, function(key) S.openPicker(key) end, false)
	S.cards, S.heads, S.agentBox, S.expandBtn = S.main.cards, S.main.heads, S.main.agentBox, S.main.expandBtn
	function S.refreshMain(animate)
		local side = state.side
		for _, B in ipairs(S.boards) do
			for i, sl in ipairs(S.slots) do
				local card = B.cards[sl.key]
				if card then
					local look = S.slotLook(side, sl.key)
					-- weapon cards: name top-left + skin bottom-left; gear tiles: the name only
					-- while there is no artwork (no schematic icons anywhere)
					local named = o.ShowNames ~= false and (not sl.gear or not look.image)
					look.caption = named and look.caption or ""
					look.sub = (named and not sl.gear) and look.sub or ""
					card.Set(look)
					if animate and (Library._animScale or 1) > 0 then
						local d = (sl.col and ((sl.col - 1) * 0.03 + (sl.index - 1) * Library._motion.stagger) or (i % 6) * Library._motion.stagger)
						card.box.Position = UDim2.fromOffset(0, 8)
						card.box.BackgroundTransparency = 1
						Library._anim.move(card.box, { Position = UDim2.fromOffset(0, 0) }, "slow", d)
						Library._anim.fade(card.box, { BackgroundTransparency = 0.1 }, "slow", false, d)
					end
				end
			end
			for c, col in ipairs(S.columns) do
				local k = 0
				for i = 1, S.slotCount do
					local look = S.slotLook(side, "w" .. c .. "_" .. i)
					if look.sub ~= "" then k = k + 1 end
				end
				B.heads[c].Text = tostring(col.name) .. (o.ShowCounts == false and "" or ('  <font size="11" color="#6c7080">' .. k .. "/" .. S.slotCount .. "</font>"))
			end
			-- agent figure: artwork or nothing (no caption under it, as on NL)
			local ag = S.item(state.slots[side].g_agent)
			local agE = ag and state.items[side][ag.id] or {}
			local agSkin = ag and S.skinOf(ag, agE.skin)
			local agImg = (agSkin and agSkin.image) or (ag and ag.image)
			B.agentImg.Visible = agImg ~= nil
			if agImg then B.agentImg.Image = agImg end
			B.agentLine.Visible = ag ~= nil
			Library._setC(B.agentLine, "BackgroundColor3", Library._rarityColor((agSkin and agSkin.rarity) or (ag and ag.rarity) or "Stock"))
		end
	end
	function S.setSide(side, silent)
		state.side = side
		S.layoutSides(false)
		S.refreshMain(true)
		if S.P and S.P.open then S.closePicker(true) end
		if S.fs then S.vwSide() end
		if not silent then fire("OnSideChanged", side) end
	end
	S.refreshMain(false)

	-- -------------------------------------------------------------- picker page
	-- Opens over the whole content pane (header included), as on NL: title + rarity line,
	-- preview (tools bottom-left, stickers bottom-right), filters, grid of skins / items.
	function S.buildPicker()
		local P = {}
		S.P = P
		local pk = New("CanvasGroup", {
