-- Profile rows are live: arrow rows open a choice list on their value,
-- switches toggle, About/Chat fire an action. Values are readable through
-- Win:GetProfileSetting(key); Win:OnProfileSetting(fn) and
-- Win:OnProfileAction(fn) report changes. Windows Scale really scales the
-- on-screen overlays (hotkeys, spectators, watermark).
do
	local settings = { ESPScale = "100%", WindowsScale = "Auto", Units = "Auto", SafeMode = "Automatic", Theme = "Dark", MenuBlur = "20", AnimSpeed = "Normal", PerfMode = "Balanced", Mascot = "Off", MascotPose = "Sit" }
	local choices = {
		MenuBlur = { "Off", "10", "20", "30", "40" },
		AnimSpeed = { "Off", "Fast", "Normal", "Slow" },
		PerfMode = { "Off", "Balanced", "Max" },
		Theme = Library._themeOrder,
		Mascot = { "Off", "Santa", "Femboy" },
		MascotPose = { "Sit", "Peek" },
		ESPScale = { "50%", "75%", "100%", "125%", "150%", "200%" },
		WindowsScale = { "Auto", "75%", "100%", "125%", "150%" },
		Units = { "Auto", "Metric", "Imperial" },
		SafeMode = { "Automatic", "Enabled", "Disabled" },
	}
	local function notify(key, value)
		if type(WindowObj._onProfileSetting) == "function" then InvokeCallback(WindowObj._onProfileSetting, key, value) end
	end
	local function setLabel(label, text)
		label:SetAttribute("LangBase", nil)
		label.Text = text
		if Library._translate then Library._translate(label) end
	end
	WindowObj._profileNotify = notify
	-- Profile > Animation Speed: Library._animScale multiplies every tween (Off = instant).
	WindowObj._applyAnimSpeed = function()
		local v = settings.AnimSpeed
		Library._animScale = (v == "Off" and 0) or (v == "Fast" and 0.5) or (v == "Slow" and 1.6) or 1
		Library._fxRefresh()
	end
	-- Profile > Performance mode: Off = every loop per frame (old behaviour), Balanced = same look with
	-- idle loops throttled, Max = also no hover tweens / stagger, short motion, slower overlay stats.
	WindowObj._applyPerfMode = function()
		local v = settings.PerfMode
		Library._perfMode = (v == "Off" and "off") or (v == "Max" and "max") or "balanced"
		local M = Library._motion
		M.stagger0 = M.stagger0 or M.stagger
		M.rowStagger0 = M.rowStagger0 or M.rowStagger
		M.stagger = Library._perfMode == "max" and 0 or M.stagger0
		M.rowStagger = Library._perfMode == "max" and 0 or M.rowStagger0
		if WindowObj._wmFollow then WindowObj._wmFollow() end
		Library._fxRefresh()
	end
	-- Menu-only blur (Profile > Menu Blur). NO full-screen effect is used.
	-- How it works: the acrylic glass Part (AcrylicBlur.Instances.Part) is
	-- stretched in camera space to exactly the window's AbsolutePosition /
	-- AbsoluteSize (updated every frame while the menu is open, so drag, scale
	-- and resize follow). The shared DepthOfFieldEffect has FarIntensity = 0 and
	-- a focus range of 1.6 .. 101.6 studs (FocusDistance 51.6, InFocusRadius 50),
	-- so only geometry nearer than 1.6 studs is blurred: that is just the glass
	-- Part (0.05 studs from the camera). The rest of the screen is in focus and
	-- stays sharp. A fully transparent Part writes no depth, so Off = Part
	-- transparency 1 + effect disabled. Strength: 10..40 scales the effect's
	-- NearIntensity (0.4..1) and the tint transparency (0.89..0.80).
	-- Hidden while the menu is closed, unloaded or Safe Mode is Enabled.
	WindowObj._menuBlurOn = function()
		return not WindowObj._unloaded and settings.SafeMode ~= "Enabled" and (tonumber(settings.MenuBlur) or 0) > 0
	end
	WindowObj._applyMenuBlur = function()
		local inst = AcrylicBlur and AcrylicBlur.Instances
		if not inst then return end
		local part, dof = inst.Part, inst.DepthOfField
		local on = WindowObj._menuBlurOn()
		local k = math.clamp((tonumber(settings.MenuBlur) or 0) / 40, 0, 1)
		AcrylicBlur.TintTransparency = on and (0.92 - 0.12 * k) or 1
		if dof and on then dof.NearIntensity = 0.2 + 0.8 * k end
		if part and part.Parent then
			local t = (on and not AcrylicBlur.LowQuality) and AcrylicBlur.TintTransparency or 1
			part:SetAttribute("TargetTransparency", t)
			if WindowObj._menuOpen == true then
				Tween(part, { Transparency = t }, 0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
			end
		end
		if dof and part and part.Parent then
			dof.Enabled = (WindowObj._menuOpen == true and on) or #(WindowObj._blurs or {}) > 0
		end
	end
	local function applyOverlayScale(value)
		local factor = tonumber(tostring(value):match("^(%d+)%%$"))
		factor = factor and factor / 100 or 1
		WindowObj._espScale = factor
		for _, d in ipairs(NLUI:GetDescendants()) do
			if d.Name == "PlayerPreview" and d:IsA("Frame") then
				-- The preview refits its column on every Scale change (see
				-- _buildPlayerPreview), so it glides and never overflows.
				local scale = d:FindFirstChild("ProfileOverlayScale") or New("UIScale", { Name = "ProfileOverlayScale" }, d)
				if math.abs(scale.Scale - factor) > 0.001 then
					Tween(scale, { Scale = factor }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				end
			end
		end
	end
	local function applyWindowsScale(value)
		local factor = tonumber(tostring(value):match("^(%d+)%%$"))
		factor = factor and factor / 100 or 1
		if value == "Auto" or factor == nil then factor = 1 end
		WindowObj._windowsScale = factor
		-- Every overlay (watermark, hotkey / spectator lists, event logs, the
		-- mobile button) scales around its own anchor corner, so each keeps
		-- its place. The watermark's shadow + blur host mirrors the watermark's
		-- scale every frame (WMShadowSync), so they never drift apart.
		local scales = {}
		for _, name in ipairs({ "OverlayStack", "GameInfo", "Keybinds", "Spectators", "EventLogs", "MobileToggle" }) do
			local target = NLUI:FindFirstChild(name)
			if target then
				local scale = target:FindFirstChild("ProfileWindowsScale") or New("UIScale", { Name = "ProfileWindowsScale" }, target)
				if math.abs(scale.Scale - factor) > 0.001 then
					if target.Visible then
						Tween(scale, { Scale = factor }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
					else
						scale.Scale = factor
					end
					table.insert(scales, scale)
				end
			end
		end
		if #scales == 0 then return end
		-- Lists stacked under each other re-place every frame of the glide.
		WindowObj._winScaleToken = (WindowObj._winScaleToken or 0) + 1
		local token = WindowObj._winScaleToken
		task.spawn(function()
			local started = os.clock()
			while WindowObj._winScaleToken == token and os.clock() - started < 0.45 do
				if WindowObj._OV and WindowObj._OV.place then WindowObj._OV.place(false) end
				RunService.Heartbeat:Wait()
			end
			if WindowObj._winScaleToken == token then
				for _, scale in ipairs(scales) do if scale.Parent then scale.Scale = factor end end
				if WindowObj._OV and WindowObj._OV.place then WindowObj._OV.place(false) end
			end
		end)
	end

