Library._navIcon = function(icon, kind)
	local g = Library._navGlyph[string.lower(tostring(kind or ""))]
	if not g or not icon then return false end
	icon:SetAttribute("IconNoSheet", true)
	icon:SetAttribute("IconKind", g)
	icon.ScaleType = Enum.ScaleType.Fit
	local function packOrDraw()
		if Library._iconAsset(g) and Library._applyIcon(icon, g) then return end
		icon.Image = ""
		icon.ImageRectOffset = Vector2.zero
		icon.ImageRectSize = Vector2.zero
		Library._drawIcon("s_" .. g, icon, "draw")
	end
	if g == "globe" then
		-- World: the exact tile of the original menu (classic sheet 3926305904, "public" at 604,324,
		-- 35x35, stretched into the icon box, tinted by ImageColor3). Drawn ring+land if it fails.
		icon.Image = Library._sheetIds[1]
		icon.ImageRectOffset = Vector2.new(604, 324)
		icon.ImageRectSize = Vector2.new(35, 35)
		icon.ScaleType = Enum.ScaleType.Stretch
		Library._iconMark(icon, "asset")
		Library._imgWatch(icon, 4, function()
			icon.ScaleType = Enum.ScaleType.Fit
			icon.Image = ""
			icon.ImageRectOffset = Vector2.zero
			icon.ImageRectSize = Vector2.zero
			Library._drawIcon("s_globe", icon, "draw")
		end, function() return icon.Image == Library._sheetIds[1] and not icon:FindFirstChild("GlyphGrid") end)
		return true
	end
	local img = icon.Image
	if (g == "crosshair" or g == "layers") and string.match(img, "^rbxassetid://%d+$") then
		Library._iconMark(icon, "asset")
		Library._imgWatch(icon, 4, packOrDraw, function() return icon.Image == img and not icon:FindFirstChild("GlyphGrid") end)
		return true
	end
	packOrDraw()
	return true
end
-- Asset icons: when the image has not loaded after `wait` seconds (or there is none), the drawn
-- glyph of the same name takes over. kind = icon name ("visuals", "save", ...).
-- The old rbxassetid image stays primary; only an empty or failed image gets the pack icon
-- (and if that fails too, _applyIcon's own check draws the glyph).
Library._iconFallback = function(icon, kind, wait)
	if not icon then return end
	local function apply()
		if not icon.Parent or icon:FindFirstChild("GlyphGrid") or icon:GetAttribute("IconPack") or icon:GetAttribute("IconSheet") then return end
		if not Library._applyIcon(icon, kind) then Library._drawIcon(kind, icon, "glyph") end
	end
	if icon.Image ~= "" and not Library._iconPaths[icon] then Library._iconMark(icon, "asset") end
	if icon.Image == "" then apply() else Library._imgWatch(icon, wait or 4, apply, function() return icon.Image ~= "" end) end
end
-- Hover micro-feedback for a clickable icon: the tint brightens (theme-aware) and the icon grows
-- 8% with a soft tween; leaving restores the colour it had before. host = what is hovered.
Library._iconFx = function(host, icon, getIdle, skip)
	if not host or not icon or icon:GetAttribute("IconFx") then return end
	icon:SetAttribute("IconFx", true)
	local scale = Instance.new("UIScale")
	scale.Name = "FxScale"
	scale.Parent = icon
	local idle
	host.MouseEnter:Connect(function()
		if Library._hoverBlocked and Library._hoverBlocked(host) then return end
		if skip and skip() then return end
		-- Colours are tweened in dark-theme space; Tween maps them for the light theme.
		local base = icon:GetAttribute("ThemeBase_ImageColor3")
		idle = getIdle and getIdle() or (typeof(base) == "Color3" and base or icon.ImageColor3)
		local target = idle:Lerp(Color3.new(1, 1, 1), 0.4)
		Tween(icon, { ImageColor3 = target, ImageTransparency = 0 }, 0.12, Enum.EasingStyle.Sine)
		Tween(scale, { Scale = 1.08 }, 0.14, Enum.EasingStyle.Quint)
	end)
	host.MouseLeave:Connect(function()
		local back = getIdle and getIdle() or idle
		if skip and skip() then back = nil end
		if back then Tween(icon, { ImageColor3 = back }, 0.16, Enum.EasingStyle.Sine) end
		Tween(scale, { Scale = 1 }, 0.16, Enum.EasingStyle.Quint)
	end)
end
-- Text or icon on an accent-coloured plate (Add button, selected pill) stays as it is.
Library._onAccent = function(d)
	for _, g in ipairs({ d, d.Parent }) do
		if g and g:IsA("GuiObject") and g.BackgroundTransparency < 0.6 then
			local _, sat, v = g.BackgroundColor3:ToHSV()
			if sat > 0.3 and v > 0.35 then return true end
		end
	end
	return false
end
-- Thin separator frames: a dark line would turn white (invisible on white
-- cards), so lines become a visible soft grey. Switch/slider tracks a light
-- grey, switch knobs on an accent track stay white.
-- Exact light-theme colours for the main dark surfaces and texts (keyed "r,g,b" of the dark colour).
Library._lightBg = {
