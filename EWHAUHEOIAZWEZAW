			AcrylicBlur.Signal = game:GetService("RunService").RenderStepped:Connect(AcrylicBlur.Update)
		end
		MainFrame.BackgroundTransparency = 1
		Tween(MainFrame, { BackgroundTransparency = Library._winAlpha() }, 0.18)
	end
