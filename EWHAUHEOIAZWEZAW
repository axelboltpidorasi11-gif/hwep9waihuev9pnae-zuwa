			-- NL navigation row (Pitch ›, Yaw ›): label and a chevron; the
			-- whole row opens a plate. Returns that plate (same API as
			-- AddSettings: AddToggle, AddSlider, AddDropdown, AddGroup...).
			-- Page row (NL "Ambience"): a chevron row that opens a whole
			-- page over the tab, with its own sections (left / right) and a close
			-- cross at the top right. Returns the page: page:AddSection(title, side).
			function SectionObj:AddPage(text)
				elemCount = elemCount + 1
				local Row = New("TextButton", {
					Name = "MenuRow", Size = UDim2.new(1, 0, 0, Library._rowH or 42), BackgroundTransparency = 1, LayoutOrder = elemCount,
					Text = "", AutoButtonColor = false,
				}, Elements)
				New("Frame", {
					Name = "Lines", Position = UDim2.new(0.06, 0, 1, -1), Size = UDim2.new(0.88, 0, 0, 1),
					BackgroundColor3 = Color3.fromRGB(162, 162, 162), BackgroundTransparency = 0.9, BorderSizePixel = 0, ZIndex = 100,
				}, Row)
				New("TextLabel", {
					Name = "TextToggle", Position = UDim2.new(0, 12, 0.3, 0), Size = UDim2.new(0.8, 0, 0.5, 0),
					BackgroundTransparency = 1, Text = text, TextColor3 = Color3.fromRGB(217, 219, 226), Font = FONT,
					TextTransparency = 0.1, TextXAlignment = Enum.TextXAlignment.Left,
				}, Row)
				New("ImageLabel", {
					Name = "MenuChevron", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
					Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Image = "rbxassetid://10709791437",
					ImageColor3 = Color3.fromRGB(205, 208, 218), ScaleType = Enum.ScaleType.Fit,
				}, Row)
				-- The page is built as a tab without a sidebar button, then its two
				-- columns move into an overlay that opens over the current tab
				-- (that tab stays selected underneath, as on NL).
				local page = WindowObj:AddTab(text, "")
				local entry = tabs[#tabs]
				if entry and entry.btn then entry.btn.Visible = false entry.btn:SetAttribute("NLPageTab", true) end
				if entry then entry.isPage = true end
				if entry then entry.pageRow = Row end
				local overlay = New("CanvasGroup", {
					Name = "PageOverlay", Position = TabHose.Position, Size = TabHose.Size, BackgroundColor3 = Color3.fromRGB(12, 13, 19),
					-- Global ZIndex: the page content sits at 1, so the overlay's own
					-- background must share that layer instead of drawing above it.
					BackgroundTransparency = 0.03, GroupTransparency = 1, Visible = false, ZIndex = 1,
					Active = true, -- clicks on empty spots stop here, not on the tab under it
				}, Frame2)
				New("UICorner", { CornerRadius = UDim.new(0, 12) }, overlay)
				New("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }, overlay)
				New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, overlay)
				local columns = {}
				for _, c in ipairs(TabHose:GetChildren()) do
					if c:IsA("ScrollingFrame") and entry and c:GetAttribute("TabIndex") == entry.tabIndex then table.insert(columns, c) end
				end
				for _, c in ipairs(columns) do
					c:SetAttribute("SearchName", nil)
					c.Parent = overlay
					c.Visible = true
				end
				local closeBtn = New("TextButton", {
					Name = "PageClose", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -46, 0, 14), Size = UDim2.fromOffset(26, 26),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 1, Text = "",
					TextColor3 = Color3.fromRGB(205, 208, 218), TextSize = 22, Font = FONT, AutoButtonColor = false, Visible = false, ZIndex = 200,
				}, Frame2)
				Library._icon(closeBtn, "close", 14, Color3.fromRGB(205, 208, 218), 201)
				New("UICorner", { CornerRadius = UDim.new(0, 6) }, closeBtn)
				closeBtn.MouseEnter:Connect(function() if Library._noHover then return end Tween(closeBtn, { BackgroundTransparency = 0.93 }, 0.12) end)
				closeBtn.MouseLeave:Connect(function() Tween(closeBtn, { BackgroundTransparency = 1 }, 0.15) end)
				local open = false
				local function setOpen(on, instant)
					if on == open then return end
					open = on
					if on then
						CloseAllPopupsExcept(nil)
						Library._openOverlay = overlay
						overlay.Visible = true
						-- The page's columns live outside TabHose, so switching tabs
						-- (or a search refresh) may have hidden them behind our back.
						for _, c in ipairs(columns) do c.Visible = true end
						closeBtn.Visible = true
						-- Fight the tab underneath: fade its content out and switch it
						-- off, so only the page remains visible and clickable.
						for _, hose in ipairs({ TabHose, SubTabHose }) do
							Tween(hose, { GroupTransparency = 1 }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
							task.delay(0.2, function()
								if open and hose.Parent then hose.Visible = false end
							end)
						end
						overlay.Position = TabHose.Position + UDim2.fromOffset(0, 26)
						overlay.GroupTransparency = 1
						Tween(overlay, { GroupTransparency = 0, Position = TabHose.Position }, 0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
						closeBtn.TextTransparency = 1
						Tween(closeBtn, { TextTransparency = 0 }, 0.25)
						for _, c in ipairs(columns) do AnimateSectionColumn(c) end
					else
						CloseAllPopupsExcept(nil)
						if Library._openOverlay == overlay then Library._openOverlay = nil end
						-- Bring the tab underneath back before the page finishes leaving.
						for _, hose in ipairs({ TabHose, SubTabHose }) do
							hose.Visible = true
							if instant then
								hose.GroupTransparency = 0
							else
								Tween(hose, { GroupTransparency = 0 }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
							end
						end
						closeBtn.Visible = false
						if instant then
							overlay.Visible = false
							overlay.GroupTransparency = 1
							overlay.Position = TabHose.Position
						else
							Tween(overlay, { GroupTransparency = 1, Position = TabHose.Position + UDim2.fromOffset(0, 18) }, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
							task.delay(0.22, function()
								if not open then
									overlay.Visible = false
									overlay.Position = TabHose.Position
								end
							end)
						end
					end
				end
				if entry then entry.openPage = function() setOpen(true) end end
				-- Switching tabs closes the page.
				WindowObj._pageCloses = WindowObj._pageCloses or {}
				table.insert(WindowObj._pageCloses, { close = function() setOpen(false, true) end })
				Row.MouseButton1Click:Connect(function() if Library._swiped() then return end setOpen(true) end)
				closeBtn.MouseButton1Click:Connect(function() setOpen(false) end)
				return page
			end

			-- List of named entries as separate cards (NL "Map Selection"):
			-- the picked one outlined in the accent, "···" on each, and a last card
			-- for options.current (not added yet) with an "Add" button.
			-- options: { items = { "Global" }, selected, current, onSelect(name),
			-- onAdd(name), onOptions(name) }. Returns :Get(), :Set(name),
			-- :SetCurrent(name), :GetItems().
			function SectionObj:AddList(options)
				options = type(options) == "table" and options or {}
				local items = {}
				for _, v in ipairs(type(options.items) == "table" and options.items or { "Global" }) do table.insert(items, tostring(v)) end
				local selected = options.selected or items[1]
				local current = options.current
				-- Cards stand on their own: no section card behind them.
				Elements.BackgroundTransparency = 1
				local outline = Elements:FindFirstChild("GroupOutline")
				if outline then outline.Enabled = false end
				local layout = Elements:FindFirstChildOfClass("UIListLayout")
				if layout then layout.Padding = UDim.new(0, 8) end
				local obj = {}
				local function rebuild(animate)
					for _, c in ipairs(Elements:GetChildren()) do if c.Name == "ListCard" then c:Destroy() end end
					local names = {}
					for _, n in ipairs(items) do table.insert(names, { n, true }) end
					if current and not table.find(items, current) then table.insert(names, { current, false }) end
					for i, pair in ipairs(names) do
						local name, added = pair[1], pair[2]
						elemCount = elemCount + 1
						local picked = added and name == selected
						local card = New("TextButton", {
							-- Shared selection look (Library._sel): the picked card = accent text + accent 0.9 fill.
							Name = "ListCard", LayoutOrder = elemCount, Size = UDim2.new(1, 0, 0, Library._sel.h() + 4), BackgroundColor3 = picked and Color3.fromRGB(34, 36, 48) or Color3.fromRGB(23, 23, 31),
							BackgroundTransparency = 0.1, AutoButtonColor = false, Text = "",
						}, Elements)
						New("UICorner", { CornerRadius = UDim.new(0, Library._sel.radius) }, card)
						local stroke = Instance.new("UIStroke")
						stroke.Color = Color3.fromRGB(255, 255, 255)
						stroke.Transparency = picked and 0.82 or 0.93
						stroke.Thickness = 1
						stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
						stroke.Parent = card
						New("TextLabel", {
							Name = "ListName", Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -110, 1, 0), BackgroundTransparency = 1,
							Text = name, TextColor3 = picked and Library._sel.selText or (added and Library._sel.unselText or Library._sel.dim), TextSize = Library._sel.textSize, Font = FONT,
							TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
						}, card)
						if added then
							local dots = New("TextButton", {
								Name = "ListDots", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(24, 20),
								BackgroundTransparency = 1, Text = "···", TextColor3 = Color3.fromRGB(205, 208, 218), TextSize = 16, Font = FONT,
								AutoButtonColor = false,
							}, card)
							dots.MouseButton1Click:Connect(function() InvokeCallback(options.onOptions, name) end)
							card.MouseButton1Click:Connect(function() if Library._swiped() then return end
								if selected == name then return end
								selected = name
								rebuild(false)
								InvokeCallback(options.onSelect, name)
							end)
						else
							local add = New("TextButton", {
								Name = "ListAdd", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(62, 24),
								BackgroundTransparency = 1, Text = "+  Add", TextColor3 = Color3.fromRGB(205, 208, 218), TextSize = 14, Font = FONT,
								AutoButtonColor = false,
							}, card)
							add.MouseButton1Click:Connect(function()
								table.insert(items, name)
								selected = name
								rebuild(true)
								InvokeCallback(options.onAdd, name)
								InvokeCallback(options.onSelect, name)
							end)
						end
						card.MouseEnter:Connect(function() if Library._noHover then return end if not picked then Tween(stroke, { Transparency = 0.86 }, 0.12) end end)
						card.MouseLeave:Connect(function() if not picked then Tween(stroke, { Transparency = 0.93 }, 0.15) end end)
						if animate then
							WindowObj._fadeTree(card, false, 0)
							task.delay(0.03 * i, function() if card.Parent then WindowObj._fadeTree(card, true, 0.25) end end)
						end
					end
				end
				rebuild(false)
				function obj:Get() return selected end
				function obj:Set(name) if table.find(items, name) then selected = name; rebuild(false) end return self end
				function obj:SetCurrent(name) current = name; rebuild(true) return self end
				function obj:GetItems() return items end
				return obj
			end

