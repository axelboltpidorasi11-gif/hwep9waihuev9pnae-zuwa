function OV.pill(name, parent, alpha, radius, height, flat)
	-- Same capsule as the watermark: nearly clear plate, melting edge shadow,
	-- blur behind. (`radius` only sets how far the blur pulls in.)
	local pill = New("Frame", {
		Name = name, Size = UDim2.fromOffset(height or OV.h, height or OV.h), BackgroundColor3 = OV.glass,
		BackgroundTransparency = alpha, BorderSizePixel = 0, ZIndex = Z_BASE + 891,
	}, parent)
	pill:SetAttribute("PillBase", alpha)
	alpha = 1 - (1 - alpha) * (WindowObj._overlayBg or 1)
	pill.BackgroundTransparency = alpha
	pill:SetAttribute("PillAlpha", alpha)
	if Library._lightOn then
		-- Made while Light: start with the light glass alpha (see Library._themePass), so a
		-- fade-in that starts this frame already goes to it.
		pill:SetAttribute("ThemeDarkAlpha", alpha)
		alpha = math.min(alpha, alpha * 0.3 + 0.02)
		pill.BackgroundTransparency = alpha
		pill:SetAttribute("PillAlpha", alpha)
	end
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, pill)
	-- flat: entry pills under the header carry no shadow, as on NL.
	-- Soft edges instead of a drop shadow (entry pills too).
	if not flat then WindowObj._edgeShadow(pill, Z_BASE + 890) end
	-- Blur rectangle pulled in by half the height: inside the rounded ends. Only the panel's own
	-- pill (header / watermark-style capsule) gets one: per-row (flat) blur parts showed as stray
	-- rectangles in game (square glass that outlived scrolled-out / clipped / leaving rows).
	if not flat and WindowObj._attachBlur then WindowObj._attachBlur(pill, math.floor((height or OV.h) / 2)) end
	return pill
