	-- Share codes: "NL1:" + base64 of {"name","data"}. Copied from a preset's
	-- menu; pasting one into the "+" name field imports it as a new preset.
	do
		local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
		local function encode(data)
			return ((data:gsub(".", function(x)
				local r, b = "", x:byte()
				for i = 8, 1, -1 do r = r .. (b % 2 ^ i - b % 2 ^ (i - 1) > 0 and "1" or "0") end
				return r
			end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
				if #x < 6 then return "" end
				local c = 0
				for i = 1, 6 do c = c + (x:sub(i, i) == "1" and 2 ^ (6 - i) or 0) end
				return B64:sub(c + 1, c + 1)
			end) .. ({ "", "==", "=" })[#data % 3 + 1])
		end
		local function decode(data)
			data = data:gsub("[^" .. B64 .. "=]", "")
			return (data:gsub(".", function(x)
				if x == "=" then return "" end
				local r, f = "", (B64:find(x, 1, true) - 1)
				for i = 6, 1, -1 do r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and "1" or "0") end
				return r
			end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
				if #x ~= 8 then return "" end
				local c = 0
				for i = 1, 8 do c = c + (x:sub(i, i) == "1" and 2 ^ (8 - i) or 0) end
				return string.char(c)
			end))
		end
		local http = game:GetService("HttpService")
		WindowObj._makeShareCode = function(name)
			local data
			if type(readfile) == "function" and type(isfile) == "function" then
				local okExists, exists = pcall(isfile, GetConfigPath(name))
				if okExists and exists then
					local okRead, content = pcall(readfile, GetConfigPath(name))
					if okRead and type(content) == "string" then
						local okDecode, decoded = pcall(http.JSONDecode, http, content)
						if okDecode and type(decoded) == "table" then data = decoded end
					end
				end
			end
			if not data then return nil end
			local okEncode, json = pcall(http.JSONEncode, http, { name = name, data = data })
			if not okEncode then return nil end
			return "NL1:" .. encode(json)
		end
		WindowObj._shareEncode = function(name, data)
			if type(data) ~= "table" then return nil end
			local okEncode, json = pcall(http.JSONEncode, http, { name = name, data = data })
			if not okEncode then return nil end
			return "NL1:" .. encode(json)
		end
		-- Imports a preset: the share code ("NL1:..."), its bare Base64, or JSON ({ name, data } or a
		-- preset file's content). Returns the new preset name (+ its data), or nil and an error text;
		-- dryRun only checks the text (true when valid).
		WindowObj._importShareCode = function(text, dryRun)
			text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if text == "" then return nil, "Nothing to import" end
			local body
			if string.sub(text, 1, 4) == "NL1:" then
				body = decode(string.sub(text, 5))
			elseif string.sub(text, 1, 1) == "{" then
				body = text
			elseif text:match("^[%w%+/=%s]+$") then
				body = decode(text)
			else
				return nil, "Not a share code or JSON"
			end
			local okDecode, payload = pcall(function() return http:JSONDecode(body) end)
			if not okDecode or type(payload) ~= "table" then return nil, "The code is damaged or incomplete" end
			local data, name = payload, "Imported"
			if type(payload.data) == "table" then
				data = payload.data
				name = type(payload.name) == "string" and payload.name or "Shared"
			end
			local valid = false
			for k in pairs(data) do
				if type(k) == "string" and (k:find("#%d+$") or string.sub(k, 1, 8) == "__extra_") then valid = true break end
			end
			if not valid then return nil, "No settings in this code" end
			if dryRun then return true end
			if type(writefile) ~= "function" then return nil, "Saving files isn't available" end
			local finalName = WindowObj._uniqueConfigName((SanitizeConfigName(name):sub(1, 24):gsub("%s+$", "")))
			local okJson, json = pcall(http.JSONEncode, http, data)
			if not okJson then return nil, "The code is damaged or incomplete" end
			local okWrite, res = pcall(writefile, GetConfigPath(finalName), json)
			if not okWrite or res == false then return nil, "Couldn't write the file" end
			return finalName, nil, data
		end
	end

	local function ListConfigs()
		if type(listfiles) ~= "function" then return {} end
		local result = {}
		local ok, files = pcall(listfiles, "")
		if not ok or type(files) ~= "table" then return result end
		local prefix = "NeverloseConfig_" .. windowConfigId .. "_"
		for _, fileName in ipairs(files) do
			-- listfiles may return "folder/NeverloseConfig_..." paths.
			local base = type(fileName) == "string" and fileName:match("[^/\\]+$") or nil
			if base and string.sub(base, 1, #prefix) == prefix and string.sub(base, -5) == ".json" and #base > #prefix + 5 then
				local name = string.sub(base, #prefix + 1, -6)
				table.insert(result, name)
			end
		end
		table.sort(result, function(a, b) return string.lower(a) < string.lower(b) end)
		return result
	end

	

