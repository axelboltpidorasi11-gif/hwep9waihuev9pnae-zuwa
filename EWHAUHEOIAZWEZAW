-- Group popups open beside the plate (8px right of it, top at the plate top / at `yAt`);
-- no room on the right (phones) -> left of it, else clamped into the safe area.
Library._groupsUI.besidePlate = function(ctx, pop, yAt)
	pop.place = function()
		local f = pop.frame
		if not f.Parent or not ctx.popup.Parent then return end
		local sp, ss = ctx.inv.safe()
		local pp, ps, fs = ctx.popup.AbsolutePosition, ctx.popup.AbsoluteSize, f.AbsoluteSize
		local x = pp.X + ps.X + 8
		if x + fs.X > sp.X + ss.X - 6 then x = pp.X - fs.X - 8 end
		local y = yAt and yAt() or pp.Y
		x = math.clamp(x, sp.X + 6, math.max(sp.X + 6, sp.X + ss.X - fs.X - 6))
		y = math.clamp(y, sp.Y + 6, math.max(sp.Y + 6, sp.Y + ss.Y - fs.Y - 6))
		ctx.inv.place(f, x, y)
	end
end
