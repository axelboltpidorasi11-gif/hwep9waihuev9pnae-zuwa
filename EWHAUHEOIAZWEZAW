-- Saved configs from earlier theme passes (removed themes) open in Dark; a saved custom accent stays.
Library._themeAlias = { Cyber = "Dark", Forest = "Dark", Sakura = "Dark", Midnight = "Dark", Ember = "Dark" }
Library._themeAnchors = { "bg", "plate", "field", "stroke", "dim", "text" }
-- A dark-space colour -> the palette's colour (see above).
Library._palColor = function(pal, c)
	if c.R == 0 and c.G == 0 and c.B == 0 then return c end
	local _, s, v = c:ToHSV()
	if (s > 0.3 and v > 0.35) or (v >= 0.96 and s <= 0.05) then return c end
	local D, roles = Library._themes.Dark, Library._themeAnchors
	local L = (c.R + c.G + c.B) / 3
	local a, b, t = roles[#roles], roles[#roles], 0
	local first = D[roles[1]]
	if L <= (first.R + first.G + first.B) / 3 then
		a, b = roles[1], roles[1]
	else
		for i = 1, #roles - 1 do
			local A, B = D[roles[i]], D[roles[i + 1]]
			local la, lb = (A.R + A.G + A.B) / 3, (B.R + B.G + B.B) / 3
			if L >= la and L < lb then a, b, t = roles[i], roles[i + 1], (L - la) / (lb - la) break end
		end
	end
	local pa, pb, da, db = pal[a] or D[a], pal[b] or D[b], D[a], D[b]
	local function ch(k) return math.clamp(c[k] + (pa[k] - da[k]) * (1 - t) + (pb[k] - db[k]) * t, 0, 1) end
	return Color3.new(ch("R"), ch("G"), ch("B"))
end
-- Per-object palette mapping: switch tracks that show the accent take the theme's toggle colour;
-- section / sidebar group captions take the theme's caption colour.
Library._palFor = function(pal, d, prop, base)
	if pal.caption and prop == "TextColor3" and d and (d.Name == "SectionLabel" or d.Name == "TabLabel") then return pal.caption end
	if pal.toggle and prop == "BackgroundColor3" and d and (d.Name == "Effect" or d.Name == "Switch" or d.Name == "SwitchTrack") then
		local _, s, v = base:ToHSV()
		if s > 0.3 and v > 0.35 then return pal.toggle end
	end
	return Library._palColor(pal, base)
end
-- Colour without an object (gradient keypoints, tween targets on unknown objects): the active mapper.
Library._mapColor = function(c)
	local pal = Library._themePal
	if pal and not pal.light then return Library._palColor(pal, c) end
	return Library._themeColor(c)
end
