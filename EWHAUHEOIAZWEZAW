-- CS2 / Neverlose inventory: Tab:AddInventory{...} (Library._invBuild) and reusable parts
--   Library._rarities, Library._rarityColor(r), Library._rarityRank(r), Library._invNorm(x)
--   Library._itemCard(parent, o)  card: image or a clean card (rarity tint + text, no icon),
--                                 caption / sub / name, rarity bar, hover lift, press, selected dot
--   Library._itemGrid(parent, o)  grid of item cards (Section:AddItemGrid, picker, full screen)
--   Library._invPopup / Library._invList  glass plate / glass list ("Knives", "Rarity", ...)
--   Library._invSwitch, Library._invIconBtn, Library._invDrop, Library._invBox  small controls
-- Only Library fields at chunk level (the chunk is close to the 200-register limit).
Library._rarities = {
	{ "Stock", Color3.fromRGB(222, 214, 200) }, { "Consumer", Color3.fromRGB(176, 195, 217) },
	{ "Industrial", Color3.fromRGB(94, 152, 217) }, { "Mil-Spec", Color3.fromRGB(75, 105, 255) },
	{ "Restricted", Color3.fromRGB(136, 71, 255) }, { "Classified", Color3.fromRGB(211, 44, 230) },
	{ "Covert", Color3.fromRGB(235, 75, 75) }, { "Contraband", Color3.fromRGB(228, 174, 57) },
}
Library._rarityAlias = {
	default = "Stock", vanilla = "Stock", none = "Stock", base = "Consumer", common = "Consumer", uncommon = "Industrial",
	milspec = "Mil-Spec", rare = "Mil-Spec", mythical = "Restricted", legendary = "Classified", exotic = "Classified",
	ancient = "Covert", extraordinary = "Covert", immortal = "Contraband", gold = "Contraband",
}
Library._rarityRank = function(r)
	if type(r) == "number" then return r end
	local s = string.lower(tostring(r or ""))
	s = Library._rarityAlias[s] and string.lower(Library._rarityAlias[s]) or s
	for i, e in ipairs(Library._rarities) do if string.lower(e[1]) == s then return i end end
	return 0
end
Library._rarityColor = function(r)
	if typeof(r) == "Color3" then return r end
	local i = Library._rarityRank(r)
	local e = Library._rarities[math.clamp(math.floor(i), 1, #Library._rarities)]
	return i > 0 and e[2] or Library._rarities[1][2]
end
Library._rarityName = function(r)
	local i = Library._rarityRank(r)
	return i > 0 and Library._rarities[i][1] or tostring(r or "Stock")
end
-- { "Fade", "Covert", "rbxassetid://..." } / "Fade" / { name = ..., rarity = ..., image = ... } -> item table
Library._invNorm = function(x, i)
	if type(x) == "string" then return { name = x, id = x } end
	if type(x) ~= "table" then return nil end
	if x._norm then return x end
	local t = {}
	for k, v in pairs(x) do t[k] = v end
	t.name = tostring(x.name or x.Name or x[1] or ("Item " .. tostring(i or "")))
	t.rarity = x.rarity or x.Rarity or x[2]
	t.image = x.image or x.Image or x[3]
	t.id = tostring(x.id or x.Id or t.name)
	t._norm = true
	return t
end
Library._invAccent = function()
	local f = Library._invAccentFn
	if f then
		local ok, c = pcall(f)
		if ok and typeof(c) == "Color3" then return c end
	end
	return Library._accentNow()
end
-- Keeps a 32px icon holder sized to a fraction of `box` (a UIScale; drawn glyphs do not scale
-- with their image size). ScaleRef (100px) measures the window scale.
Library._invFit = function(box, holder, fx, fy)
	local ref = box:FindFirstChild("ScaleRef") or New("Frame", { Name = "ScaleRef", Size = UDim2.fromOffset(100, 0), BackgroundTransparency = 1 }, box)
	local sc = holder:FindFirstChild("FitScale")
	if not sc then sc = Instance.new("UIScale"); sc.Name = "FitScale"; sc.Parent = holder end
	local function fit()
		local g = ref.AbsoluteSize.X / 100
		if g <= 0 then return end
		local w, h = box.AbsoluteSize.X / g, box.AbsoluteSize.Y / g
		if w <= 0 or h <= 0 then return end
		sc.Scale = math.clamp(math.min(w * (holder:GetAttribute("FitX") or fx), h * (holder:GetAttribute("FitY") or fy)) / 32, 0.3, 8)
	end
	box:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	ref:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	task.defer(fit)
	return sc
end

-- Item card. o = { name, caption, sub, rarity, image, icon, label (false = no name under the box),
-- size, order, selected, empty, onClick(card) }. Returns card { frame, box, Set(o), SetSelected(on) }.
Library._itemCard = function(parent, o)
	o = o or {}
	local card = { o = o }
	local LABEL = o.label == false and 0 or 20
	local CARD, CARD_HOVER = Color3.fromRGB(17, 19, 27), Color3.fromRGB(27, 30, 41)
	local cell = New("Frame", { Name = "ItemCell", Size = o.size or UDim2.fromScale(1, 1), BackgroundTransparency = 1, LayoutOrder = o.order or 0 }, parent)
	local box = New("TextButton", {
		Name = "ItemCard", Size = UDim2.new(1, 0, 1, -LABEL), BackgroundColor3 = CARD, BackgroundTransparency = 0.1,
		AutoButtonColor = false, Text = "", BorderSizePixel = 0,
	}, cell)
	New("UICorner", { CornerRadius = UDim.new(0, 6) }, box)
	local stroke = Stroke(box, "CardStroke")
	stroke.Transparency = 0.94
	local lift = New("Frame", { Name = "Lift", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, box)
	local tint = New("Frame", { Name = "RarityTint", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(222, 214, 200), BackgroundTransparency = 0.82, BorderSizePixel = 0 }, lift)
	New("UICorner", { CornerRadius = UDim.new(0, 6) }, tint)
	do
		local g = Instance.new("UIGradient")
		g.Rotation = 90
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.92), NumberSequenceKeypoint.new(1, 0.3) })
		g.Parent = tint
	end
	local glow = New("Frame", {
		Name = "RarityGlow", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(222, 214, 200), BackgroundTransparency = 0.93, BorderSizePixel = 0,
	}, lift)
	New("UIAspectRatioConstraint", { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Height }, glow)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, glow)
	local img = New("ImageLabel", {
		Name = "ItemImage", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -14, 1, -16),
		BackgroundTransparency = 1, Image = "", ScaleType = Enum.ScaleType.Fit, Visible = false, NoTheme = true,
	}, lift)
	local ph = New("Frame", { Name = "Placeholder", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(32, 32), BackgroundTransparency = 1 }, lift)
	Library._invFit(box, ph, 0.42, 0.5)
	local caption = New("TextLabel", {
		Name = "ItemCaption", Position = UDim2.fromOffset(7, 4), Size = UDim2.new(1, -24, 0, 14), BackgroundTransparency = 1, Text = "",
		TextColor3 = Color3.fromRGB(176, 180, 192), TextSize = 11, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Visible = false,
	}, lift)
	local sub = New("TextLabel", {
		Name = "ItemSub", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 7, 1, -6), Size = UDim2.new(1, -14, 0, 13), BackgroundTransparency = 1,
		Text = "", TextColor3 = Color3.fromRGB(226, 228, 236), TextSize = 11, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Visible = false,
	}, lift)
	local bar = New("Frame", {
		Name = "RarityBar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -2, 0, 3),
		BackgroundColor3 = Color3.fromRGB(222, 214, 200), BorderSizePixel = 0,
	}, box)
	New("UICorner", { CornerRadius = UDim.new(0, 2) }, bar)
	local dot = New("Frame", {
		Name = "SelDot", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1, Visible = false,
	}, box)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	local ring = Instance.new("UIStroke")
	ring.Name = "SelRing"; ring.Thickness = 1.5; ring.Color = Library._invAccent(); ring.Parent = dot
	local core = New("Frame", {
		Name = "SelCore", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4),
		BackgroundColor3 = Library._invAccent(), BorderSizePixel = 0,
	}, dot)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, core)
	local label
	if LABEL > 0 then
		label = New("TextLabel", {
			Name = "ItemName", Position = UDim2.new(0, 1, 1, -LABEL + 3), Size = UDim2.new(1, -2, 0, LABEL - 3), BackgroundTransparency = 1, Text = "",
			TextColor3 = Color3.fromRGB(226, 228, 236), TextSize = 13, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, cell)
	end
	card.frame, card.box, card.label, card.bar = cell, box, label, bar
	local hovered, selected = false, false
	local function paint(instant)
		local d = instant and 0 or "fast"
		Library._anim.color(box, { BackgroundColor3 = hovered and CARD_HOVER or CARD }, d)
		Library._setC(stroke, "Color", selected and Library._invAccent() or Color3.fromRGB(255, 255, 255))
		Library._anim.fade(stroke, { Transparency = selected and 0.45 or (hovered and 0.86 or 0.94) }, d)
		if card.icon then Library._anim.fade(card.icon, { ImageTransparency = (o.empty and 0.6 or 0.12) - (hovered and 0.12 or 0) }, d) end
	end
	box.MouseEnter:Connect(function()
		if Library._hoverBlocked and Library._hoverBlocked(box) then return end
		hovered = true; paint()
	end)
	box.MouseLeave:Connect(function() hovered = false; paint(); Library._anim.press(box, false) end)
	box.MouseButton1Down:Connect(function() Library._anim.press(box, true) end)
	box.MouseButton1Up:Connect(function() Library._anim.press(box, false) end)
	box.MouseButton1Click:Connect(function()
		if Library._swiped and Library._swiped() then return end
		if o.onClick then o.onClick(card) end
	end)
	function card.Set(n)
		for k, v in pairs(n or {}) do o[k] = v end
		if n and n.rarity == false then o.rarity = nil end
		local rc = Library._rarityColor(o.rarity)
		local hasR = o.rarity ~= nil and not o.empty
		bar.Visible = hasR
		Library._setC(bar, "BackgroundColor3", rc)
		Library._setC(tint, "BackgroundColor3", rc)
		Library._setC(glow, "BackgroundColor3", rc)
		tint.Visible, glow.Visible = hasR, false -- (halo off: flat cards as on NL)
		if label then label.Text = tostring(o.name or "") end
		caption.Text = tostring(o.caption or "")
		caption.Visible = o.caption ~= nil and o.caption ~= ""
		-- o.center: small tiles (gear) - the name centred, up to two lines
		if o.center then
			caption.Position, caption.Size = UDim2.fromOffset(4, 3), UDim2.new(1, -8, 1, -8)
			caption.TextWrapped, caption.TextXAlignment, caption.TextSize = true, Enum.TextXAlignment.Center, 10
			caption.TextTruncate = Enum.TextTruncate.AtEnd
			caption.Text = string.match(caption.Text, "^(.-) | ") or caption.Text
			box.ClipsDescendants = true
		end
		sub.Text = tostring(o.sub or "")
		sub.Visible = o.sub ~= nil and o.sub ~= ""
		if sub.Visible then Library._setC(sub, "TextColor3", hasR and rc:Lerp(Color3.new(1, 1, 1), 0.35) or Color3.fromRGB(176, 180, 192)) end
		local image = type(o.image) == "string" and o.image ~= "" and o.image or nil
		img.Visible = image ~= nil
		if image then img.Image = image end
		-- no artwork: a clean card (rarity tint/bar + text only), no schematic icon
		ph.Visible = false
		-- (o.icon is only used by explicit icon cards, e.g. o.iconCard = true)
		if o.iconCard and not image and not card.icon then
			ph.Visible = true
			card.icon = Library._icon(ph, tostring(o.icon or "box"), 32, Color3.fromRGB(200, 204, 218), ph.ZIndex + 1)
		end
		if card.icon then card.icon.ImageTransparency = o.empty and 0.6 or 0.12 end
	end
	function card.SetSelected(on, instant)
		on = on and true or false
		local was = selected
		selected = on
		dot.Visible = on
		if on and not was and not instant then
			local s = Library._anim.scaleOf(dot)
			if s then s.Scale = 0.3; Library._anim.scale(dot, 1, "slow", "enter") end
		end
		paint(instant)
	end
	card.Set(nil)
	card.SetSelected(o.selected, true)
	return card
end

-- Grid of item cards. o = { Items, Columns (or MinWidth = adaptive), CardHeight (box px), Gap, Label,
-- Scroll (+ Position, Size), Icon (default kind), Caption(it) / Sub(it) -> text, Selected (id),
-- OnClick(item, card, grid) (default: select + Callback(item)), Animate, Z (ladder after builds),
-- EmptyText, Name, order }. Returns grid { frame, cards, items, SetItems(list, sel), SetSelected(id),
-- GetSelected(), SetFilter(fn), Get(), Set(id) }.
Library._itemGrid = function(parent, o)
	o = o or {}
	local api = { cards = {}, items = {}, view = {}, selected = o.Selected }
	local gap = o.Gap or 8
	-- Scroll grids are VIRTUAL: only the rows in view (+1 row of buffer each side) have card
	-- instances; they are recycled while scrolling (CanvasSize is set by hand). Flow grids (in a
	-- section) keep a UIGridLayout but also reuse their cards when the list is replaced.
	local virt = o.Scroll and true or false
	local holder
	if virt then
		holder = New("ScrollingFrame", {
			Name = o.Name or "ItemGrid", Position = o.Position or UDim2.new(), Size = o.Size or UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Color3.fromRGB(120, 124, 140), ScrollBarImageTransparency = 0.3,
			AutomaticCanvasSize = Enum.AutomaticSize.None, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y, LayoutOrder = o.order or 0,
		}, parent)
		New("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 1), PaddingRight = UDim.new(0, 9) }, holder)
		api.empty = New("TextLabel", {
			Name = "GridEmpty", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 30), Size = UDim2.new(1, 0, 0, 20),
			BackgroundTransparency = 1, Text = o.EmptyText or "Nothing found", TextColor3 = Color3.fromRGB(112, 116, 128), TextSize = 13,
			Font = FONT, Visible = false,
		}, parent)
	else
		holder = New("Frame", {
			Name = o.Name or "ItemGrid", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = o.order or 0,
		}, parent)
		New("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, holder)
	end
	api.frame = holder
	local layout = not virt and New("UIGridLayout", { CellPadding = UDim2.fromOffset(gap, gap), CellSize = UDim2.fromOffset(100, 100), SortOrder = Enum.SortOrder.LayoutOrder }, holder) or nil
	api.layout = layout
	local ref = New("Frame", { Name = "ScaleRef", Size = UDim2.fromOffset(100, 0), BackgroundTransparency = 1, Visible = false }, parent)
	local cols, cellH, rowH = o.Columns or 4, 96, 96 + gap
	local active, free, first, last = {}, {}, 1, 0
	local function gscale()
		local g = ref.AbsoluteSize.X / 100
		return g > 0 and g or 1
	end
	local function clicked(card)
		local it = card.item
		if not it then return end
		if o.OnClick then o.OnClick(it, card, api) return end
		api:SetSelected(it.id)
		if o.Callback then pcall(o.Callback, it) end
	end
	-- fills a card (new or recycled) with item it (all keys are passed so nothing stale stays)
	local function bind(card, it)
		card.item = it
		card.Set({
			name = it.name or "", rarity = it.rarity == nil and false or it.rarity, image = it.image or "", icon = it.icon or o.Icon,
			caption = o.Caption and o.Caption(it) or "", sub = o.Sub and o.Sub(it) or "", empty = it.empty or false,
		})
		card.SetSelected(api.selected ~= nil and it.id == api.selected, true)
	end
	local function place(card, idx)
		local c, r = (idx - 1) % cols, math.floor((idx - 1) / cols)
		card.frame.Size = UDim2.new(1 / cols, -(gap * (cols - 1)) / cols, 0, cellH)
		card.frame.Position = UDim2.new(c / cols, c * gap / cols, 0, r * rowH)
	end
	local function newCard()
		local card = Library._itemCard(holder, { size = UDim2.fromOffset(100, 100), label = o.Label, onClick = clicked })
		if o.Z then ApplyZIndexLadder(card.frame, holder.ZIndex + 1) end
		return card
	end
	-- virtual: make the cards for the rows in view match (force = rebind everything in range)
	local function refresh(force)
		local view = api.view
		local n = #view
		local g = gscale()
		local viewH = holder.AbsoluteSize.Y / g
		if viewH < 1 then viewH = 400 end
		local y = holder.CanvasPosition.Y / g
		local r1 = math.max(0, math.floor(y / rowH) - 1)
		local i1 = r1 * cols + 1
		local i2 = math.min(n, (math.floor((y + viewH) / rowH) + 2) * cols)
		if not force and i1 == first and i2 == last then return end
		first, last = i1, i2
		for idx, c in pairs(active) do
			if idx < i1 or idx > i2 then
				active[idx] = nil
				c.frame.Visible = false
				c.item = nil
				table.insert(free, c)
			end
		end
		table.clear(api.cards)
		for idx = i1, i2 do
			local c = active[idx]
			if not c then
				c = table.remove(free) or newCard()
				active[idx] = c
				bind(c, view[idx])
				place(c, idx)
				c.frame.Visible = true
			elseif force then
				bind(c, view[idx])
				place(c, idx)
			end
			table.insert(api.cards, c)
		end
	end
	local function layoutVirtual(force)
		local nCols = api.fixedColumns or o.Columns or 4
		if o.MinWidth and not api.fixedColumns then
			local w = holder.AbsoluteSize.X / gscale() - 10
			nCols = math.max(2, math.floor((w + gap) / (o.MinWidth + gap)))
		end
		local nH = (api.cardHeight or o.CardHeight or 96) + (o.Label == false and 0 or 20)
		local changed = nCols ~= cols or nH ~= cellH
		cols, cellH, rowH = nCols, nH, nH + gap
		local rows = math.ceil(#api.view / cols)
		holder.CanvasSize = UDim2.fromOffset(0, rows > 0 and (rows * rowH - gap + 12) or 0)
		refresh(force or changed)
	end
	function api:Relayout()
		local ncols = api.fixedColumns or o.Columns or 4
		if api.empty then
			local p, s = holder.Position, holder.Size
			api.empty.AnchorPoint = Vector2.zero
			api.empty.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + 30)
			api.empty.Size = UDim2.new(s.X.Scale, s.X.Offset, 0, 20)
		end
		if virt then layoutVirtual(false) return end
		if o.MinWidth and not api.fixedColumns then
			local w = holder.AbsoluteSize.X / gscale() - 10
			ncols = math.max(2, math.floor((w + gap) / (o.MinWidth + gap)))
		end
		api.columns = ncols
		layout.CellSize = UDim2.new(1 / ncols, -(gap * (ncols - 1)) / ncols, 0, (api.cardHeight or o.CardHeight or 96) + (o.Label == false and 0 or 20))
	end
	-- (a parent's UIScale tween changes AbsoluteSize every frame: layoutVirtual only touches cards when the rows in range change)
	holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() api:Relayout() end)
	holder:GetPropertyChangedSignal("Position"):Connect(function() api:Relayout() end)
	if virt then holder:GetPropertyChangedSignal("CanvasPosition"):Connect(function() refresh(false) end) end
	api:Relayout()
	function api:ApplyFilter()
		table.clear(api.view)
		for _, it in ipairs(api.items) do
			if not api.filter or api.filter(it) ~= false then table.insert(api.view, it) end
		end
		if virt then
			layoutVirtual(true)
		else
			for _, c in ipairs(api.cards) do
				c.frame.Visible = c.item ~= nil and (not api.filter or api.filter(c.item) ~= false)
			end
		end
		local n = #api.view
		if api.empty then api.empty.Visible = n == 0 and holder.Visible end
		return n
	end
	function api:SetFilter(fn) api.filter = fn; return api:ApplyFilter() end
	function api:SetSelected(id, instant)
		api.selected = id
		for _, c in ipairs(api.cards) do
			if c.item then c.SetSelected(id ~= nil and c.item.id == id, instant) end
		end
	end
	function api:GetSelected() return api.selected end
	function api:Get() return api.selected end
	function api:Set(id)
		api:SetSelected(id, true)
		if o.Callback then
			for _, it in ipairs(api.items) do if it.id == id then pcall(o.Callback, it) end end
		end
	end
	function api:SetItems(list, sel)
		api.items = {}
		if sel ~= nil then api.selected = sel end
		for i, raw in ipairs(list or {}) do
			local it = Library._invNorm(raw, i)
			if it then table.insert(api.items, it) end
		end
		if not virt then
			-- flow grid: reuse the cards, add the missing ones, hide the surplus
			for i, it in ipairs(api.items) do
				local card = api.cards[i]
				if not card then
					card = Library._itemCard(holder, { label = o.Label, order = i, onClick = clicked })
					api.cards[i] = card
				end
				card.frame.LayoutOrder = i
				bind(card, it)
			end
			for i = #api.items + 1, #api.cards do api.cards[i].item = nil; api.cards[i].frame.Visible = false end
			if o.Z then ApplyZIndexLadder(holder, holder.ZIndex) end
		end
		if virt then holder.CanvasPosition = Vector2.zero end
		api:ApplyFilter()
		if virt and o.Z then ApplyZIndexLadder(holder, holder.ZIndex) end
		-- entrance: the first cards rise in (a short stagger)
		if o.Animate ~= false and (Library._animScale or 1) > 0 then
			local k = 0
			for _, card in ipairs(api.cards) do
				if card.item and card.frame.Visible then
					k = k + 1
					if k > 18 then break end
					local d = math.min(k - 1, 14) * Library._motion.stagger
					card.box.Position = UDim2.fromOffset(0, 10)
					card.box.BackgroundTransparency = 1
					Library._anim.move(card.box, { Position = UDim2.fromOffset(0, 0) }, "slow", d)
					Library._anim.fade(card.box, { BackgroundTransparency = 0.1 }, "slow", false, d)
					if card.label then
						card.label.TextTransparency = 1
						Library._anim.fade(card.label, { TextTransparency = 0 }, "slow", false, d)
					end
				end
			end
		end
	end
	if o.Items then api:SetItems(o.Items, o.Selected) end
	return api
end

