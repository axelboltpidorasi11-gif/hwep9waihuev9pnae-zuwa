		local holding = features.autoGrenade and info and name ~= "Smoke Grenade" and name ~= "Decoy Grenade"
			and userInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		if not holding then
			heldSince = nil
			return
		end
		heldSince = heldSince or os.clock()
		if heldSince == math.huge or os.clock() - heldSince < 0.2 or os.clock() - lastCheck < 0.05 then return end
		lastCheck = os.clock()
		local simulate = Neverlose.simulateGrenade
		if not simulate then return end
		local ok, points = pcall(simulate, name, "Far")
		local landing = ok and points and points[#points]
		if not landing then return end
		local peak = (name == "HE Grenade" and 98) or (name == "Flashbang" and 70) or 50
		local function estimate(root)
			local distance = (root.Position - landing).Magnitude
			if distance >= info.radius or not Ballistics.visible(landing + Vector3.new(0, 1.5, 0), root.Position, root.Parent) then return 0 end
			return peak * (1 - distance / info.radius)
		end
		local best = 0
		for _, entity in ipairs(Game.entities()) do
			if entity ~= localPlayer and Game.isEnemy(entity, true) then
				local character = Game.character(entity)
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root then best = math.max(best, estimate(root)) end
			end
		end
		local mine = Game.localCharacter()
		local myRoot = mine and mine:FindFirstChild("HumanoidRootPart")
		local hurtsMe = name ~= "Flashbang" and myRoot and estimate(myRoot) >= 30
		if best >= (features.autoGrenadeDamage or 40) and not hurtsMe then
			heldSince = math.huge
			Neverlose.syntheticRelease = os.clock()
			if mouse1release then mouse1release() end
		end
