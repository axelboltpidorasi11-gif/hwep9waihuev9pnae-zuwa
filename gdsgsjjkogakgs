	local realClock, forced, clockHooked = os.clock, nil, false

	local function boxHit(origin, direction, half)
		local tmin, tmax = 0, math.huge
		for axis = 1, 3 do
			local o, d, h
			if axis == 1 then o, d, h = origin.X, direction.X, half.X elseif axis == 2 then o, d, h = origin.Y, direction.Y, half.Y else o, d, h = origin.Z, direction.Z, half.Z end
			if math.abs(d) < 1e-9 then
				if math.abs(o) > h then return false end
			else
				local t1, t2 = (-h - o) / d, (h - o) / d
				if t1 > t2 then t1, t2 = t2, t1 end
				if t1 > tmin then tmin = t1 end
				if t2 < tmax then tmax = t2 end
				if tmin > tmax then return false end
			end
		end
		return true
	end

	function Legit.findSeed(part, spread, budget)
		local viewport = currentCamera.ViewportSize * 0.5
		local ray = currentCamera:ViewportPointToRay(viewport.X, viewport.Y)
		local unit = ray.Direction.Magnitude > 0 and ray.Direction.Unit or Vector3.new(0, 0, 1)
		local frame = CFrame.lookAlong(Vector3.zero, unit, math.abs(unit.Y) > 0.9999 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0))
		local right, up, look = frame.RightVector, frame.UpVector, frame.LookVector
		local maxPhi = math.rad(math.min(spread, 69) * 0.5)
		local inverse = part.CFrame:Inverse()
		local localOrigin = inverse * ray.Origin
		local half = part.Size * 0.5 * 0.9
		local deadline = realClock() + (budget or 0.004)
		local distance = (part.Position - ray.Origin).Magnitude
		local attempts = 0
		repeat
			attempts += 1
			local clock = realClock()
			local random = Random.new(math.floor(clock * 1000000 % 2147483647))
			local theta = random:NextNumber(-math.pi, math.pi)
			local phi = random:NextNumber(0, maxPhi)
			local sinPhi = math.sin(phi)
			local direction = right * (-sinPhi * math.sin(theta)) + up * (sinPhi * math.cos(theta)) + look * math.cos(phi)
			if boxHit(localOrigin, inverse:VectorToWorldSpace(direction), half) and not blockedBetween(ray.Origin, ray.Origin + direction * distance) then return clock end
		until attempts > 3000 or realClock() > deadline
		return nil
	end

	function Legit.withClock(value, fn, ...)
		if not clockHooked then
			clockHooked = true
			local original = hookfunction(os.clock, newcclosure(function() return forced or realClock() end))
			if original then realClock = original end
			maid:give(function() pcall(restorefunction, os.clock) end)
		end
		forced = value
		local results = table.pack(pcall(fn, ...))
		forced = nil
		if not results[1] then error(results[2], 0) end
		return table.unpack(results, 2, results.n)
	end

	local bulletClass = Game.modules.bullet
	if bulletClass and type(bulletClass._performRaycast) == "function" and hookfunction then
		Patch.hook(bulletClass._performRaycast, function(original)
			return function(self, spread, ...)
				local target = Legit.seedTarget
				if target and type(spread) == "number" and os.clock() - target.at < 0.4 and target.part.Parent then
					Legit.seedTarget = nil
					local found = Legit.findSeed(target.part, spread)
					if found then return Legit.withClock(found, original, self, spread, ...) end
				end
				return original(self, spread, ...)
			end
		end)
	end
end

