	entry.icon.Filled, entry.icon.NumSides = true, 12
	WorldEsp.labels[key] = entry
	return entry
end

local function hideLabel(entry)
	entry.text.Visible, entry.box.Visible, entry.icon.Visible = false, false, false
end

local function renderWorld(key, position, text, color, style, maxDistance, textColor, showDistance)
	local entry = worldLabel(key)
	local distance = (position - currentCamera.CFrame.Position).Magnitude
	local point, visible = currentCamera:WorldToViewportPoint(position)
