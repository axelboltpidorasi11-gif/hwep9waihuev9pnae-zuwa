function Agents.play(model, animation, overlay)
	local controller = model:FindFirstChildWhichIsA("AnimationController") or model:FindFirstChildWhichIsA("Humanoid")
	if not controller then
		controller = Instance.new("AnimationController")
		controller.Parent = model
	end
	local animator = controller:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0.1) end
	if not animation then return end
	local ok, track = pcall(animator.LoadAnimation, animator, animation)
	if not ok or not track then return end
	track.Looped = true
	track.Priority = Enum.AnimationPriority.Idle
	track:Play(0.15)
	if overlay then
		local okTop, top = pcall(animator.LoadAnimation, animator, overlay)
		if okTop and top then
			top.Looped = true
			top.Priority = Enum.AnimationPriority.Action
			top:Play(0.15)
		end
	end
end

function Agents.rig(model)
	for _, object in ipairs(model:GetDescendants()) do
		if object:IsA("LuaSourceContainer") then
			object:Destroy()
		elseif object:IsA("BasePart") then
			object.Anchored = object.Name == "HumanoidRootPart"
			object.CanCollide, object.CanQuery, object.CanTouch, object.Massless = false, false, false, true
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and model:GetAttribute("NeverloseCustom") then

		humanoid.DisplayDistanceType, humanoid.HealthDisplayType = Enum.HumanoidDisplayDistanceType.None, Enum.HumanoidHealthDisplayType.AlwaysOff
	elseif humanoid then
		local controller = Instance.new("AnimationController")
		controller.Parent = model
		humanoid:Destroy()
	end
end

