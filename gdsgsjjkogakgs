	local RageMain = RageTab:AddSection("Main", "left")
	local RageToggle = RageMain:AddToggle("Enabled", rage.enabled, set(rage, "enabled"))
	hk["Ragebot"] = RageToggle
	local RageSettings = RageToggle:AddSettings()
	if rage.priority ~= "Health" then rage.priority = "Distance" end
	RageSettings:AddDropdown("Priority", { "Distance", "Health" }, rage.priority, set(rage, "priority"))
	RageSettings:AddSlider("Scan Rate", 5, 240, rage.scanHz, set(rage, "scanHz"), " Hz")
	RageSettings:AddDropdown("Scan Mode", { "Balanced", "Performance" }, rage.scanMode or "Balanced", set(rage, "scanMode"))
	RageSettings:AddToggle("Sticky Target", rage.stickyTarget, set(rage, "stickyTarget"))
	RageSettings:AddSlider("Max Distance", 0, 500, rage.maxDist, set(rage, "maxDist"), " st"):SetDisplay(function(v) return v == 0 and "any" or nil end)
	tip(RageMain:AddDropdown("Target", { "Highest Damage", "Closest", "Lowest Health", "Crosshair" }, rage.target, set(rage, "target")), "How the best enemy is picked")
	local Silent = RageMain:AddToggle("Silent Aim", rage.silent, set(rage, "silent"))
	tip(Silent, "Bullets are redirected at the target without moving your view")
	local SilentSettings = Silent:AddSettings()
	if rage.silentAuto ~= false then rage.silentHitChance = 0 end
	local silentSlider = SilentSettings:AddSlider("Hit Chance", 0, 100, rage.silentHitChance, function(v) rage.silentHitChance, rage.silentAuto = v, v == 0 end, "%")
	silentSlider:SetDisplay(function(v) return v == 0 and "Auto" or nil end)
	task.delay(3, function()
		if rage.silentAuto ~= false then rage.silentHitChance = 0 pcall(silentSlider.Set, silentSlider, 0) end
	end)
	SilentSettings:AddDropdown("Hitbox", { "Head", "Chest", "Stomach", "Nearest" }, rage.silentHitbox, set(rage, "silentHitbox"))
	hk["Automatic Fire"] = RageMain:AddToggle("Automatic Fire", rage.autoFire, set(rage, "autoFire"))
	local FireSettings = hk["Automatic Fire"]:AddSettings()
	tip(FireSettings:AddToggle("Quick Stop", rage.quickStop, set(rage, "quickStop")), "Stops your movement the moment a shot is about to be fired")
	tip(FireSettings:AddToggle("Quick Scope", rage.quickScope, set(rage, "quickScope")), "Snipers fire right after the scope opens")
	local OriginSettings = RageMain:AddToggle("Origin Scan", rage.originScan, set(rage, "originScan")):AddSettings()
	-- Milk: два режима Range и Scans.
	-- Auto: значения ведёт профиль оружия, слайдеры их показывают и не перебивают.
	-- Manual: слайдеры свободны, профиль эти два поля не трогает.
	-- Максимумы равны зажимам в коде скана (Range 12, Scans 10): выше слайдер ничего не даст.
	if rage.originFields ~= "Manual" then
		rage.originFields = "Auto"
		if type(rage.manualFields) == "table" then
			rage.manualFields.originRange, rage.manualFields.originScans = nil, nil
		end
	end
	local rangeSlider, scansSlider
	local uiSyncing = false
	local function syncOriginUi()
		uiSyncing = true
		if rangeSlider then pcall(rangeSlider.Set, rangeSlider, math.clamp(tonumber(rage.originRange) or 8, 1, 12)) end
		if scansSlider then pcall(scansSlider.Set, scansSlider, math.clamp(math.floor(tonumber(rage.originScans) or 4), 1, 10)) end
		uiSyncing = false
	end
	Rage.syncOriginUi = syncOriginUi

	local function manualField(name, value)
		local manual = rage.manualFields
		if type(manual) ~= "table" then manual = {} rage.manualFields = manual end
		manual[name] = value
	end

	local function fieldsMode(value)
		rage.originFields = value == "Manual" and "Manual" or "Auto"
		if rage.originFields == "Manual" then
			manualField("originRange", true)
			manualField("originScans", true)
		else
			manualField("originRange", nil)
			manualField("originScans", nil)
			Rage.profileKey = nil
			local weapon = Game.weapon()
			if weapon then pcall(Rage.applyWeaponProfile, weapon) end
			syncOriginUi()
		end
	end
