local function stripComments(src)
	local out, i, n = {}, 1, #src
	local function pushLine()
		local nl = src:find("\n", i, true)
		local stop = nl and (nl - 1) or n
		local trimmed = src:sub(i, stop):match("^[ \t]*(.-)[ \t]*$")
		if trimmed ~= "" then out[#out + 1] = trimmed end
		if nl then
			out[#out + 1] = "\n"
			i = nl + 1
		else
			i = n + 1
		end
	end
	while i <= n do
		local c = src:sub(i, i)
		if src:sub(i, i + 1) == "--" then
			local eq = src:match("^%-%-%[(=*)%[", i)
			if eq then
				local close = "]" .. eq .. "]"
				local stop = src:find(close, i, true)
				i = stop and (stop + #close) or (n + 1)
			else
				i = src:find("\n", i, true) or (n + 1)
			end
		elseif c == '"' or c == "'" then
			local start = i
			i = i + 1
			while i <= n do
				local ch = src:sub(i, i)
				if ch == "\\" then
					i = i + 2
				elseif ch == c then
					i = i + 1
					break
				elseif ch == "\n" then
					break
				else
					i = i + 1
				end
			end
			out[#out + 1] = src:sub(start, i - 1)
		elseif c == "[" and src:match("^%[(=*)%[", i) then
			local eq = src:match("^%[(=*)%[", i)
			local token = "]" .. eq .. "]"
			local closeStart = src:find(token, i + #eq + 2, true)
			local stop = closeStart and (closeStart + #token - 1) or n
			out[#out + 1] = src:sub(i, stop)
			i = stop + 1
		else
			pushLine()
		end
	end
	return table.concat(out)
end

function Menu.loadLibrary()
	local source
	local function usable(text)
		return type(text) == "string" and #text >= 100000 and text:find("AddHitSounds", 1, true) ~= nil
	end
	-- Always pull the current library first; a stale cached scr.lua lacks AddHitSounds and breaks the menu.
	local fetchedOk, fetched = pcall(function() return game:HttpGet(LIBRARY_URL) end)
	if fetchedOk and usable(fetched) then
		source = fetched
		if writefile then pcall(writefile, LIBRARY_FILE, fetched) end
	end
	-- The served library predates weapon groups: use the local ui.lua next to the script when it has them.
	if not (source and source:find("SetGroupPresets", 1, true)) and isfile and readfile then
		for _, path in ipairs({ "Neverlose Bloxstrike/ui.lua", "ui.lua" }) do
			local okFile, text = pcall(function() return isfile(path) and readfile(path) end)
			if okFile and usable(text) and text:find("SetGroupPresets", 1, true) then
				source = text
				break
			end
		end
	end
	if not source and isfile and readfile and isfile(LIBRARY_FILE) then
		source = readfile(LIBRARY_FILE)
	end
	if type(source) == "string" and not source:find("AddHitSounds", 1, true) then
		if delfile and isfile and isfile(LIBRARY_FILE) then pcall(delfile, LIBRARY_FILE) end
		error("library is outdated (no AddHitSounds): cache deleted, re-execute the script")
	end

	-- A swapped or truncated library is refused before it is ever executed.
	if type(source) ~= "string" or #source < 100000 or not source:find("AddPage", 1, true) or not source:find("AddDropdown", 1, true) then
		error("library failed validation")
	end

	-- Hit Sound plate icons: crosshair for head, user for body, skull for kills, heart for damage taken, cross for misses.
	for _, pair in ipairs({
		{ '{ key = "head", name = "Head Shot", icon = "rbxassetid://10734964441" }', '{ key = "head", name = "Head Shot", icon = "rbxassetid://107944169329467" }' },
		{ '{ key = "hurt", name = "Damage Received", icon = "rbxassetid://10723394681" }', '{ key = "hurt", name = "Damage Received", icon = "rbxassetid://10723406299" }' },
		{ '{ key = "miss", name = "Missed Aimbot Shot", icon = "rbxassetid://10709752996" }', '{ key = "miss", name = "Missed Aimbot Shot", icon = "rbxassetid://10747383819" }' },
		{ 'nameBox.Text = p.name or ""', 'nameBox.Text = p.name or ""; do local t = optionsPlate:FindFirstChild("OptTitle"); if t and current then t.Text = tostring(current.item or "Options") .. " Options" end end' },
		{ 'vols[ev.key] = math.clamp(v, 0, 100)', 'vols[ev.key] = math.clamp(v, 0, 500)' },
		{ 's.Volume = math.clamp(vol or 100, 0, 100) / 100', 's.Volume = math.clamp(vol or 100, 0, 500) / 100' },
		{ 'vs:AddSlider(ev.name, 0, 100, vols[ev.key]', 'vs:AddSlider(ev.name, 0, 500, vols[ev.key]' },
		{ 'SaveText.Text = activeConfigName or "Default"\n\t\tUpdateSavePillWidth(SaveText.Text, true)\n\t\t-- The active preset is remembered for the next run.\n\t\tWindowObj._writeLastConfig(activeConfigName or "Default")', 'SaveText.Text = activeConfigName or "Default"\n\t\tpcall(WindowObj._writeLastConfig, activeConfigName or "Default")' },
		{ [==[Stroke(chip, "ChipOutline")]==], [==[Stroke(chip, "ChipOutline")
				do
					local chipScale = Instance.new("UIScale")
					chipScale.Parent = chip
					local chipKey = group[1] .. "/" .. item
					chip.MouseEnter:Connect(function()
						if state[team][chipKey] then return end
						Tween(chip, { BackgroundColor3 = Color3.fromRGB(38, 41, 56), TextColor3 = Color3.fromRGB(205, 208, 220) }, 0.12)
						local edge = chip:FindFirstChild("ChipOutline")
						if edge then Tween(edge, { Transparency = 0.8 }, 0.12) end
					end)
					chip.MouseLeave:Connect(function()
						Tween(chipScale, { Scale = 1 }, 0.12)
						if state[team][chipKey] then return end
						Tween(chip, { BackgroundColor3 = Color3.fromRGB(30, 32, 42), TextColor3 = MUTED }, 0.14)
						local edge = chip:FindFirstChild("ChipOutline")
						if edge then Tween(edge, { Transparency = STROKE.Transparency }, 0.14) end
					end)
					chip.MouseButton1Down:Connect(function() Tween(chipScale, { Scale = 0.95 }, 0.08) end)
					chip.MouseButton1Up:Connect(function() Tween(chipScale, { Scale = 1 }, 0.2, Enum.EasingStyle.Back) end)
				end]==] },
		{ 'local homeParent, homePos, homeSize\n', 'local homeParent, homePos, homeSize, homeZ\n' },
		{ 'homeParent, homePos, homeSize = preview.Parent, preview.Position, preview.Size\n', 'homeParent, homePos, homeSize = preview.Parent, preview.Position, preview.Size\n\t\t\t\t\thomeZ = preview.ZIndex\n' },
		{ '\t\t\t\t\t\tpreview.Position, preview.Size = homePos, homeSize\n', '\t\t\t\t\t\tpreview.Position, preview.Size = homePos, homeSize\n\t\t\t\t\t\tif homeZ then pcall(ApplyZIndexLadder, preview, homeZ) end\n' },
