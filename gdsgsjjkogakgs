			end

			pcall(function()
				local weapon = Game.weapon()
				local range = weapon and weapon.Properties and weapon.Properties.Range or 500
				for _, bullet in ipairs(payload.Bullets) do
					if typeof(bullet.Origin) == "Vector3" and typeof(bullet.Direction) == "Vector3" then
						local hits = bullet.Hits
						if type(hits) ~= "table" then
							hits = Ballistics.trace(bullet.Origin, bullet.Direction.Unit, range, nil, Ballistics.allowedWalls(weapon, true))
						end
						local focus = Neverlose.Rage and Neverlose.Rage.target
						local rageConfig = Neverlose.config.rage
						local forced = focus and rageConfig.enabled and rageConfig.autoFire and {
							entity = focus.entity, part = focus.part and focus.part.Name, chance = focus.chance,
							distance = focus.distance, record = focus.record ~= nil, mode = "silent", shifted = (bullet.Origin - Game.origin()).Magnitude > 0.5, shiftMag = (bullet.Origin - Game.origin()).Magnitude > 0.5 and (bullet.Origin - Game.origin()).Magnitude or nil,
						} or nil
						-- A shot that was not aimed at the focused target is never charged to it as a miss.
						if forced and focus.part and focus.part.Parent then
							local toward = focus.part.Position - bullet.Origin
							if toward.Magnitude > 0.1 and bullet.Direction.Unit:Dot(toward.Unit) < 0.9945 then forced = nil end
						end
						Neverlose.stats = Neverlose.stats or {}
						Neverlose.stats.sent = (Neverlose.stats.sent or 0) + 1
						local okRegister, errRegister = pcall(ShotTracker.register, bullet.Origin, bullet.Direction.Unit, hits, range, nil, focus and focus.damage, forced)
						if not okRegister then
							Neverlose.stats.registerError = tostring(errRegister)
							if os.clock() - (Neverlose.stats.registerErrorAt or 0) > 3 then
								Neverlose.stats.registerErrorAt = os.clock()
								Logs.push("Combat", "tracer failed · " .. tostring(errRegister))
