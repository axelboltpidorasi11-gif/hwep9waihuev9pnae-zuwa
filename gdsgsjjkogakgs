	local groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Exclude

	local function groundDistance(root, offset)
		groundParams.FilterDescendantsInstances = { localPlayer.Character, currentCamera, workspaceService:FindFirstChild("Debris"), effectsFolder }
		local start = root.Position + (offset or Vector3.zero)
		local result = workspaceService:Raycast(start, Vector3.new(0, -60, 0), groundParams)
		return result and (start.Y - result.Position.Y) or math.huge
	end

	local function keysDown()
		local x = (userInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (userInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
		local z = (userInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0) - (userInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0)
		return x, z
	end

	local jumpedLastFrame, lastYaw, fallingSince = false, nil, nil

	do
		local codec = Game.require("MovementV2", "CommandCodec")
		if type(codec) == "table" and type(codec.encode) == "function" and Buttons and Buttons.with and Buttons.Duck ~= nil then
			Patch.hook(codec.encode, function(original)
				return function(packet, config, ...)
					if Neverlose.fakeDuck and type(packet) == "table" and type(packet.Commands) == "table" then
						local ok, changed = pcall(function()
							local copy = table.clone(packet)
							local commands = {}
							for index, command in ipairs(packet.Commands) do
								local clone = table.clone(command)
								clone.Buttons = Buttons.with(command.Buttons, Buttons.Duck, true)
								commands[index] = clone
							end
							copy.Commands = commands
							return copy
						end)
						if ok and changed then return original(changed, config, ...) end
					end
					return original(packet, config, ...)
				end
			end)
		end
	end
	local simConfigs = Game.require("MovementV2", "Simulation", "Config")
	local TICK_RATE = 64
	local alternate = 1

	local function simConfig()
		if type(simConfigs) ~= "table" then return nil end
		local mode = workspaceService:GetAttribute("ServerGamemode")
		if mode == "Casual" or mode == "Deathmatch" then return simConfigs.CasualDeathmatch or simConfigs.Default end
		if mode == "Surf" then return simConfigs.Surf or simConfigs.Default end
		return simConfigs.Competitive or simConfigs.Default
	end

	local function wasdStrafe(frame, state, velocity, keyX, keyZ)
		local config = simConfig()
		local flat = Vector2.new(velocity.X, velocity.Z)
		local speed = flat.Magnitude
		if not config or speed < 2 then return false end
		if keyX == 0 and keyZ == 0 then return false end

		local wishYaw = wrapAngle(frame.LookYaw + math.atan2(-keyX, -keyZ))
		local velocityYaw = math.atan2(-velocity.X, -velocity.Z)
		local delta = wrapAngle(wishYaw - velocityYaw)

		local baseSpeed = config.MaxSpeed or 19.5
		if state and type(state.BaseMoveSpeed) == "number" then
			baseSpeed = math.clamp(state.BaseMoveSpeed, 0, config.MaxBaseMoveSpeed or state.BaseMoveSpeed)
		end
		local stamina = 1
		if state and type(state.Stamina) == "number" then
			stamina = math.clamp((state.Stamina + (config.StaminaRecoveryRate or 0) / TICK_RATE) / math.max(config.StaminaMax or 100, 1), 0, 1)
		end
		local duck = 1
		if state and type(state.DuckAmount) == "number" and type(config.CrouchModifier) == "number" then
			duck = 1 + (config.CrouchModifier - 1) * math.clamp(state.DuckAmount, 0, 1)
		end

		local wish = baseSpeed * duck * stamina * stamina
		local cap, accel
		if (config.BunnyHopAirAccelerate or 0) > 0 and (config.BunnyHopAirSpeedCap or 0) > 0 then
			cap = math.min(wish, config.BunnyHopAirSpeedCap)
			accel = config.BunnyHopAirAccelerate * cap / TICK_RATE
		else
			cap = math.min(wish, config.AirSpeedCap or 2)
			accel = (config.AirAccelerate or 10) * wish / TICK_RATE
		end
		local gain = math.min(accel, cap)
		local optimal = math.acos(math.clamp((cap - gain) / speed, -1, 1))

		local side
		if math.abs(delta) > math.rad(Neverlose.config.movement.alignDeg) then
			side = delta > 0 and 1 or -1
		else
			alternate = -alternate
			side = alternate
		end

		local moveYaw = velocityYaw + optimal * side
		local world = Vector3.new(-math.sin(moveYaw), 0, -math.cos(moveYaw))
		local relative = CFrame.Angles(0, frame.LookYaw, 0):VectorToObjectSpace(world)
		local strength = Neverlose.config.movement.strafeStrength / 100
		local target = Vector2.new(math.clamp(relative.X, -1, 1), math.clamp(relative.Z, -1, 1))
		frame.Move = frame.Move:Lerp(target, strength)
		return true
	end

	Input.add(20, function(self, frame, state)
		local config = Neverlose.config.movement
		if Game.isChatting() then return end

		local root = self.HumanoidRootPart
		local onGround = self.OnGround == true
		local velocity = (state and typeof(state.Velocity) == "Vector3" and state.Velocity) or (typeof(self.GlobalVelocity) == "Vector3" and self.GlobalVelocity) or Vector3.zero
		local flat = Vector3.new(velocity.X, 0, velocity.Z)
		local yawDelta = lastYaw and wrapAngle(frame.LookYaw - lastYaw) or 0
		lastYaw = frame.LookYaw
		local keyX, keyZ = keysDown()
		local spaceHeld = userInputService:IsKeyDown(Enum.KeyCode.Space)

		if config.bhop and spaceHeld then

			local nearGround = false
			if not onGround and root and velocity.Y < -1 then
				nearGround = groundDistance(root) < math.max(0.35, -velocity.Y / TICK_RATE * 1.5)
			end
			local jump = (onGround or nearGround) and not jumpedLastFrame
			Input.setButton(frame, "Jump", jump)
			jumpedLastFrame = jump
		else
			jumpedLastFrame = false
		end

		if not onGround then
			if config.airDuck then Input.setButton(frame, "Duck", true) end
			if config.fakeAirDuck then
				-- Only the packets sent to the server carry Duck; the local simulation and camera stay standing.
				local clearance = root and groundDistance(root) or math.huge
				Neverlose.fakeDuck = clearance > math.max(4, -velocity.Y / TICK_RATE * 3 + 1.5)
			else
				Neverlose.fakeDuck = false
			end

			local strafed = false
			local strafeOn = config.airStrafe and (not config.strafeHoldJump or spaceHeld) and not (config.strafeStopShift and userInputService:IsKeyDown(Enum.KeyCode.LeftShift))
			if strafeOn and flat.Magnitude > 2 then
				strafed = wasdStrafe(frame, state, velocity, keyX, keyZ)
			end
			if strafeOn and not strafed and flat.Magnitude > 2 then
				if keyX == 0 and config.autoDirection and math.abs(yawDelta) > 0.002 then
					local strength = config.strafeStrength / 100
					frame.Move = Vector2.new((yawDelta > 0 and -1 or 1) * strength, frame.Move.Y * (1 - strength))
				end
			end

			if config.strafeAssist and keyX ~= 0 and math.abs(yawDelta) > 0.002 then
				local turningLeft = yawDelta > 0
				if (keyX > 0 and turningLeft) or (keyX < 0 and not turningLeft) then
					frame.Move = Vector2.new(0, frame.Move.Y)
				end
			end

			fallingSince = velocity.Y < -2 and (fallingSince or os.clock()) or nil

			if root and velocity.Y < -2 then
				local below = groundDistance(root)
				local reach = -velocity.Y / TICK_RATE * 1.15 + 0.25
				local duckHeld = userInputService:IsKeyDown(Enum.KeyCode.LeftControl) or userInputService:IsKeyDown(Enum.KeyCode.C)

				-- One shot per fall, fired only on the landing tick so it never chains into a bhop.
				if not Neverlose.jumpBugFired and below <= reach and velocity.Y < -(config.noFall and 20 or 12) then
					local manual = config.jumpBug and (duckHeld or spaceHeld) and (os.clock() - fallingSince) * 1000 >= config.jumpBugDelay
					local auto = config.noFall and velocity.Y < -30
					if manual or auto then
						Neverlose.jumpBugFired = true
						Input.setButton(frame, "Duck", true)
						Input.setButton(frame, "Jump", true)
						Logs.push("Movement", manual and "jump bug" or "no fall damage")
					end
				end
			end
		else
			fallingSince = nil
			Neverlose.jumpBugFired = false

			if config.quickStop and keyX == 0 and keyZ == 0 and flat.Magnitude > 2 then
				Input.moveToward(frame, -flat, 1)
			end

			if config.edgeJump and root and flat.Magnitude > 4 then
				local ahead = flat * (2 / 64) + flat.Unit * 0.6
				if groundDistance(root, ahead + Vector3.new(0, 0, 0)) > 4.5 then
					Input.setButton(frame, "Jump", true)
					Logs.push("Movement", "edge jump")
				end
			end
		end

		local clock = os.clock()
		if onGround then
			Neverlose.lastGroundAt = clock
			Neverlose.fakeDuck = false
		end

		if config.longJump then
			if onGround and spaceHeld then Neverlose.longJumpUntil = clock + 0.22 end
			if not onGround and clock < (Neverlose.longJumpUntil or 0) and clock - (Neverlose.lastGroundAt or 0) < 0.2 then
				Input.setButton(frame, "Duck", true)
			end
		end

		if config.edgeBug and root and not onGround and velocity.Y < -4 and velocity.Y > -45
			and clock - (Neverlose.lastGroundAt or 0) < 0.4 and groundDistance(root) < 2.4 then
			Input.setButton(frame, "Duck", true)
		end

		if config.pixelSurf and root and not onGround and flat.Magnitude > 3 then
			groundParams.FilterDescendantsInstances = { localPlayer.Character, currentCamera, workspaceService:FindFirstChild("Debris"), effectsFolder }
			local heading = flat.Unit
			local side = Vector3.new(-heading.Z, 0, heading.X)
			local best
			for _, direction in ipairs({ Vector3.new(0, -6, 0), heading * 3.5, heading * 3.5 + Vector3.new(0, -1.5, 0), side * 3.5, -side * 3.5, side * 3.5 + Vector3.new(0, -1.5, 0), -side * 3.5 + Vector3.new(0, -1.5, 0) }) do
				local hit = workspaceService:Raycast(root.Position, direction, groundParams)
				if hit and hit.Normal.Y > -0.12 and hit.Normal.Y < 0.69 and (not best or hit.Normal.Y < best.Normal.Y) then best = hit end
			end
			if best then
				local normal = best.Normal
				local along = velocity - normal * velocity:Dot(normal)
				local slide = Vector3.new(along.X, 0, along.Z)
				local into = Vector3.new(-normal.X, 0, -normal.Z)
				if slide.Magnitude > 1 and into.Magnitude > 0.01 then
					Input.moveToward(frame, slide.Unit + into.Unit * 0.45, 1)
					Input.setButton(frame, "Duck", false)
				end
			end
		end

		if config.slowWalk and typeof(frame.Move) == "Vector2" and frame.Move.Magnitude > 0 then
			frame.Move = frame.Move.Unit * (config.slowWalkSpeed / 100)
			Input.setButton(frame, "Walk", true)
		end

		local climbing = self.OnLadder == true or self.IsClimbing == true or (state and (state.OnLadder == true or state.Climbing == true))
		if config.fastLadder and climbing and keyZ < 0 then
			frame.VerticalLook = 1
			frame.Move = Vector2.new(0.7, -0.7)
		end
	end)
end

