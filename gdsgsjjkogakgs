local function fixRigid(model)
	local jointed = {}
	for _, joint in ipairs(model:GetDescendants()) do
		if joint:IsA("Motor6D") and joint.Part1 then jointed[joint.Part1] = true end
	end
	local welds = {}
	for _ = 1, 4 do
		local moved = false
		for _, constraint in ipairs(model:GetDescendants()) do
			if constraint:IsA("RigidConstraint") and constraint.Enabled then
				local a0, a1 = constraint.Attachment0, constraint.Attachment1
				local p0, p1 = a0 and a0.Parent, a1 and a1.Parent
				if p0 and p1 and p0:IsA("BasePart") and p1:IsA("BasePart") then
					if not jointed[p1] and (jointed[p0] or p0.Anchored or true) then
						p1.CFrame = p0.CFrame * a0.CFrame * a1.CFrame:Inverse()
						jointed[p1], moved = true, true
					elseif not jointed[p0] then
						p0.CFrame = p1.CFrame * a1.CFrame * a0.CFrame:Inverse()
						jointed[p0], moved = true, true
					end
					welds[constraint] = { p0, p1 }
				end
			end
		end
		if not moved then break end
	end
	for constraint, pair in pairs(welds) do
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1 = pair[1], pair[2]
		weld.Parent = pair[2]
		constraint.Enabled = false
	end
end

local function solveJoints(model)
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if not root then return end
	local links = {}
	for _, joint in ipairs(model:GetDescendants()) do
		if joint:IsA("Motor6D") or joint:IsA("Weld") or joint:IsA("ManualWeld") then
			if joint.Part0 and joint.Part1 then links[#links + 1] = { joint.Part0, joint.Part1, joint.C0, joint.C1 } end
		elseif joint:IsA("AnimationConstraint") or joint:IsA("RigidConstraint") then
			local a0, a1 = joint.Attachment0, joint.Attachment1
			local p0, p1 = a0 and a0.Parent, a1 and a1.Parent
			if p0 and p1 and p0:IsA("BasePart") and p1:IsA("BasePart") then links[#links + 1] = { p0, p1, a0.CFrame, a1.CFrame } end
		end
	end
	local placed = { [root] = true }
	for _ = 1, 16 do
		local moved = false
		for _, link in ipairs(links) do
			local p0, p1, c0, c1 = link[1], link[2], link[3], link[4]
			if placed[p0] and not placed[p1] then
				p1.CFrame = p0.CFrame * c0 * c1:Inverse()
				placed[p1], moved = true, true
			elseif placed[p1] and not placed[p0] then
				p0.CFrame = p1.CFrame * c1 * c0:Inverse()
				placed[p0], moved = true, true
			end
		end
		if not moved then break end
	end
end

function cloneOf(instance)
	pcall(function()
		instance.Archivable = true
		for _, object in ipairs(instance:GetDescendants()) do object.Archivable = true end
	end)
	local ok, copy = pcall(instance.Clone, instance)
	if ok and copy then
		if copy:GetAttribute("NeverloseCustom") then pcall(solveJoints, copy) end
		pcall(fixRigid, copy)
	end
	return ok and copy or nil
end
