function Rage.shiftedTick(weapon)
	local viewTick = Game.viewTick()
	local now = os.clock()
	local early = math.max((weapon.Properties.FireRate or 0.1) - (now - (Rage.lastDirectAt or 0)), 0)
	Rage.lastDirectAt = now
	local config = Neverlose.config.rage
	if not config.rapidFire or (Rage.tickLeadMax or 0.05) <= 0.004 then
		Rage.tickChain = nil
		return viewTick
	end
	-- Spread timestamps by the weapon's fire rate so a fast burst still looks paced to the server.
	local scale = viewTick > 1e11 and 1000 or 1
	local rate = (weapon.Properties.FireRate or 0.1) * scale
	Rage.tickChain = Rage.tickChain or {}
	local last = Rage.tickChain[weapon.Identifier]
	local value = viewTick
	if last and viewTick - last < rate then value = last + rate end
	if (value - viewTick) / scale > (Rage.tickLeadMax or 0.05) then value = viewTick end
	Rage.tickChain[weapon.Identifier] = value
	return value
end

Rage.tickLeadMax = 0.05

Events.on("rapidRejected", function()
	Rage.tickLeadMax = math.max((Rage.tickLeadMax or 0.05) * 0.5 - 0.004, 0)
	Rage.tickChain = nil
end)

Events.on("rapidAccepted", function()
	Rage.tickLeadMax = math.min((Rage.tickLeadMax or 0.05) + 0.002, 0.1)
end)

function Rage.remoteFire(weapon, target, tap)
	if (weapon.Rounds or 0) <= 0 or not Game.character(target.entity) or (Neverlose.isDown and Neverlose.isDown(target.entity)) then
		Rage.lastFail = "target gone"
		return false
	end
	local bullets = {}
	for _ = 1, math.max(weapon.Properties.BulletsPerShot or 1, 1) do
		local bullet = { Origin = Game.origin() }
		if not Rage.aimBullet(bullet, target, weapon) then Rage.lastFail = "aim point blocked or out of range" return false end
		bullets[#bullets + 1] = bullet
	end

	weapon.ShotSeq = (weapon.ShotSeq or 0) + 1
	local ok = pcall(Game.originalSend, {
		IsSniperScoped = weapon.IsSniperScoped, ShootingHand = weapon.ShootingHand,
		Identifier = weapon.Identifier, Seq = weapon.ShotSeq, Bullets = bullets,
		ViewTick = Rage.shiftedTick(weapon),
	})
	if not ok then Rage.lastFail = "send failed" return false end
	Rage.lastFail = nil

	local range = weapon.Properties.Range or 500
	for _, bullet in ipairs(bullets) do
		local okReg, errReg = pcall(ShotTracker.register, bullet.Origin, bullet.Direction, bullet.Hits or Ballistics.trace(bullet.Origin, bullet.Direction, range, target.character, 2), range, tap, target.damage,
			{ chance = target.chance, distance = target.distance, record = target.record ~= nil, direct = true,
				entity = target.entity, part = target.part and target.part.Name, shifted = target.origin ~= nil,
				mode = tap == 2 and "double tap" or (Neverlose.config.rage.rapidFire and "rapid fire" or "direct") })
		if not okReg and os.clock() - (Rage.regErrAt or 0) > 3 then
			Rage.regErrAt = os.clock()
			Logs.push("Combat", "tracer failed · " .. tostring(errReg))
		end
	end

	weapon.Rounds = math.max((weapon.Rounds or 1) - 1, 0)
	weapon.RechargeStartTime = workspaceService:GetServerTimeNow()
	local animation = weapon.Viewmodel and weapon.Viewmodel.Animation
	if animation then
		task.spawn(asGame, function() animation:play(animation:pickVariant("Shoot") or "Shoot") end)
	end
	return true
end

lastShot = 0
Rage.targets, Rage.lastScan = {}, 0

Rage.tapDelay = nil

function Rage.tapGap(fireRate)
	local config = Neverlose.config.rage
	local ceiling = math.max(fireRate, 0.02)

	if config.dtMode == "Instant" and (Rage.instantFails or 0) >= 1 and os.clock() - (Rage.instantFailAt or 0) > 20 then Rage.instantFails = 0 end
	if config.dtMode == "Instant" and (Rage.instantFails or 0) < 1 then return 0 end
	if config.dtMode == "Fixed" then
		return math.clamp(config.dtDelay / 1000, 0.01, ceiling)
	end
	Rage.tapDelay = Rage.tapDelay or math.clamp(fireRate * 0.85, 0.02, ceiling)
	return math.clamp(Rage.tapDelay, 0.02, ceiling)
end

Events.on("tapAccepted", function()
	if (Rage.lastGap or 0) <= 0 then Rage.instantFails = 0 end
	if (Rage.lastGap or 0) > 0 and Rage.tapDelay then Rage.tapDelay = math.max(Rage.tapDelay * 0.9, 0.02) end
end)

Events.on("tapRejected", function()
	if (Rage.lastGap or 0) <= 0 then Rage.instantFails, Rage.instantFailAt = (Rage.instantFails or 0) + 1, os.clock() end
	local weapon = Game.weapon()
	local fireRate = weapon and weapon.Properties and weapon.Properties.FireRate or 0.1
	Rage.tapDelay = math.min((Rage.tapDelay or fireRate * 0.6) * 1.1 + 0.003, fireRate)
	if os.clock() - (Rage.gapLogAt or 0) > 1 then
		Rage.gapLogAt = os.clock()
		Logs.push("Combat", ("double tap gap set to {%d}ms"):format(math.floor(Rage.tapDelay * 1000 + 0.5)))
	end
end)

function Rage.rapidMultiplier(cfg, fireRate, name)
	local requested = cfg.rapidAuto ~= false and 4 or math.clamp(cfg.rapidSpeed / 100, 1, 6)
	local cap = fireRate >= 0.3 and 1.2 or fireRate >= 0.2 and 1.4 or fireRate >= 0.12 and 1.8 or 2.3
	local limit = math.min(requested, cap)
	local learned = name and Rage.rapidLearn and Rage.rapidLearn[name]
	return learned and math.min(limit, learned) or limit
end

Rage.rapidPenalty = 0
Rage.rapidLearn = {}
Events.on("rapidRejected", function() Rage.rapidCoolUntil = os.clock() + 1.5 end)

Events.on("rapidRejected", function()
	Neverlose.stats = Neverlose.stats or {}
	Neverlose.stats.rapidFail = (Neverlose.stats.rapidFail or 0) + 1
	local weapon = Game.weapon()
	if not (weapon and weapon.Name) then return end
	-- One stray miss is noise; slow down only when rejections cluster.
	local now = os.clock()
	Rage.rapidFailTimes = Rage.rapidFailTimes or {}
	local times = Rage.rapidFailTimes
	times[#times + 1] = now
	while #times > 0 and now - times[1] > 1.5 do table.remove(times, 1) end
	if #times < 2 then return end
	Rage.rapidFailTimes = {}
	local cfg = Neverlose.config.rage
	local fireRate = weapon.Properties and weapon.Properties.FireRate or 0.1
	local base = Rage.rapidMultiplier(cfg, fireRate)
	local speed = math.max((Rage.rapidLearn[weapon.Name] or base) * 0.85, 1)
	Rage.rapidCeiling, Rage.rapidCeilingAt = Rage.rapidCeiling or {}, Rage.rapidCeilingAt or {}
	Rage.rapidCeiling[weapon.Name] = math.min(Rage.rapidCeiling[weapon.Name] or math.huge, speed * 1.1)
	Rage.rapidCeilingAt[weapon.Name] = now
	Rage.rapidLearn[weapon.Name] = speed
	Logs.push("Combat", ("rapid fire slowed to x{%.2f}"):format(speed))
end)
Events.on("rapidAccepted", function()
	Neverlose.stats = Neverlose.stats or {}
	Neverlose.stats.rapidOk = (Neverlose.stats.rapidOk or 0) + 1
	local weapon = Game.weapon()
	local learned = weapon and weapon.Name and Rage.rapidLearn[weapon.Name]
	if not learned then return end
	local fireRate = weapon.Properties and weapon.Properties.FireRate or 0.1
	local base = Rage.rapidMultiplier(Neverlose.config.rage, fireRate)
	local ceiling = Rage.rapidCeiling and Rage.rapidCeiling[weapon.Name]
	if ceiling and os.clock() - ((Rage.rapidCeilingAt or {})[weapon.Name] or 0) > 20 then
		Rage.rapidCeiling[weapon.Name] = nil
		ceiling = nil
	end
	local nextSpeed = learned + 0.03
	if ceiling and nextSpeed > ceiling then nextSpeed = ceiling end
	Rage.rapidLearn[weapon.Name] = nextSpeed >= base and not ceiling and nil or nextSpeed
end)

function Rage.remoteReload(weapon)
	local properties = weapon.Properties
	local remote = Game.modules.remotes and Game.modules.remotes.Inventory and Game.modules.remotes.Inventory.ReloadWeapon
	if not (properties and properties.Rounds and weapon.Identifier and remote) then return false end

	local deathmatch = Game.isDeathmatch()
	local reserve = weapon.Capacity or 0
	local missing = properties.Rounds - (weapon.Rounds or 0)
	local amount = deathmatch and missing or math.min(missing, reserve)
	if amount <= 0 then return false end

	local ok = pcall(remote.Send, { Identifier = weapon.Identifier, Capacity = reserve, Rounds = weapon.Rounds })
	if ok then
		weapon.Rounds = (weapon.Rounds or 0) + amount
		if not deathmatch then weapon.Capacity = reserve - amount end
	end
	return ok
end

