							for _, listed in ipairs(Skins.forWeapon(resolved)) do
								if listed.skin == skin then grade = gradeOf(listed.rarity) end
							end
							local pick = { skin = skin, rarity = grade }
							local saved = Neverlose.config.skins.settings[resolved]
							if type(saved) == "table" then
								if type(saved.float) == "number" then
									pick.wearFloat = math.clamp(saved.float / 100, 0, 1)
									pick.wear = WEAR_NAMES[#WEAR_NAMES]
									for wearIndex = #WEAR_TOP, 1, -1 do
										if pick.wearFloat <= WEAR_TOP[wearIndex] then pick.wear = WEAR_NAMES[wearIndex] end
									end
								end
								if saved.statTrak ~= nil then pick.stattrak = saved.statTrak and "StatTrak\226\132\162" or "None" end
								if type(saved.count) == "number" and saved.statTrak then pick.stattrakValue = saved.count end
								if type(saved.name) == "string" then pick.name = saved.name end
							end
							picks[team][category .. "#" .. index] = pick
