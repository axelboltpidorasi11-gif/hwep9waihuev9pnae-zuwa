	for _, child in ipairs(folder and folder:GetChildren() or {}) do
		local lowered = child.Name:lower()
		if isRig(child) and not lowered:find("ragdoll") and not lowered:find("zombie") then
			local side = agentSideOf(child:GetAttribute("Team")) or agentSideOf(child.Name)
			if side and not Agents.models[side] then Agents.models[side] = child end
		end
	end
end

