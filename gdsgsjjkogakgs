					end
				end
			end
			if nearest and not Game.isEnemy(nearest, true) then return end
		end

		local now = os.clock()
		for index = #recent, 1, -1 do
			local previous = recent[index]
			if now - previous.t > 0.2 then
				table.remove(recent, index)
			elseif (previous.position - position).Magnitude < 3 then
				return
			end
		end
		recent[#recent + 1] = { position = position, t = now }

		if #markers >= 40 then killMarker(table.remove(markers, 1)) end

		local ring = NewDrawing("Circle")
		ring.Filled, ring.NumSides, ring.Thickness, ring.Visible = false, 24, 2, false
		local text = NewDrawing("Text")
		text.Size, text.Center, text.Outline, text.Font, text.Visible = 12, true, true, 2, false
		local marker = { position = position, t = now, label = label, ring = ring, text = text }
		markers[#markers + 1] = marker
		stats.shown += 1
	end

	function Neverlose.styleBox(draw, position, size, color, alpha)
		local style = Neverlose.config.esp.boxStyle
		if not draw.outline then
			draw.outline = NewDrawing("Square")
			draw.outline.Filled, draw.outline.Thickness, draw.outline.Color, draw.outline.Visible = false, 3, Color3.new(), false
			draw.fill = draw.fill or NewDrawing("Square")
			draw.fill.Filled, draw.fill.Visible = true, false
			draw.corners = {}
			for index = 1, 8 do
				local line = NewDrawing("Line")
				line.Thickness, line.Visible = 1, false
				draw.corners[index] = line
			end
		end
		local box, outline, fill = draw.box, draw.outline, draw.fill
		box.Filled, box.Thickness = false, 1
		local plain = style ~= "Corners"
		outline.Position, outline.Size, outline.Transparency, outline.Visible = position, size, alpha * 0.8, plain
		box.Position, box.Size, box.Color, box.Transparency, box.Visible = position, size, color, alpha, plain
		fill.Position, fill.Size, fill.Color = position, size, color
		fill.Transparency, fill.Visible = 0.14 * alpha, style == "Filled"
		local x, y, w, h = position.X, position.Y, size.X, size.Y
		local cw, ch = w / 4, h / 4
		local segments = {
			{ Vector2.new(x, y), Vector2.new(x + cw, y) }, { Vector2.new(x, y), Vector2.new(x, y + ch) },
			{ Vector2.new(x + w, y), Vector2.new(x + w - cw, y) }, { Vector2.new(x + w, y), Vector2.new(x + w, y + ch) },
			{ Vector2.new(x, y + h), Vector2.new(x + cw, y + h) }, { Vector2.new(x, y + h), Vector2.new(x, y + h - ch) },
			{ Vector2.new(x + w, y + h), Vector2.new(x + w - cw, y + h) }, { Vector2.new(x + w, y + h), Vector2.new(x + w, y + h - ch) },
		}
		for index, line in ipairs(draw.corners) do
			line.From, line.To, line.Color, line.Transparency, line.Visible = segments[index][1], segments[index][2], color, alpha, not plain
		end
	end

	function Neverlose.hideStyleBox(draw)
