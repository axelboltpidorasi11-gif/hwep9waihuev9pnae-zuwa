do
	local segments = {}
	local shadows = {}
	for index = 1, 80 do
		shadows[index] = draw("Line", { Visible = false, Color = Color3.new(0, 0, 0), ZIndex = 1 })
		segments[index] = draw("Line", { Visible = false, ZIndex = 2 })
	end
	local impact = draw("Circle", { Filled = false, NumSides = 32, Visible = false, ZIndex = 3 })
	local impactFill = draw("Circle", { Filled = true, NumSides = 32, Visible = false, Transparency = 0.18, ZIndex = 2 })
	local bounceDots, bounceRings = {}, {}
	for index = 1, 10 do
		bounceRings[index] = draw("Circle", { Filled = false, NumSides = 16, Radius = 6, Thickness = 1, Visible = false, ZIndex = 3 })
		bounceDots[index] = draw("Circle", { Filled = true, NumSides = 12, Radius = 3, Visible = false, ZIndex = 4 })
	end
	local etaText = draw("Text", { Size = 14, Center = true, Outline = true, Font = 2, Visible = false })
	local physicsByWeapon = {}
	local defaults = { Radius = 0.25, Restitution = 0.4, MaxBounces = 20, FuseTime = 0 }
	local fuseDefaults = { ["HE Grenade"] = 1.6, Flashbang = 1.6, Molotov = 2, ["Incendiary Grenade"] = 2 }
	local floorExplode = { Molotov = true, ["Incendiary Grenade"] = true }

	local spawnRemote = Game.modules.remotes and Game.modules.remotes.Projectile and Game.modules.remotes.Projectile.Spawn
	if spawnRemote and type(spawnRemote.Listen) == "function" then
		pcall(spawnRemote.Listen, function(data)
			if type(data) == "table" and type(data.Weapon) == "string" and type(data.Physics) == "table" then
				physicsByWeapon[data.Weapon] = data.Physics
			end
		end)
	end

	local simParams = RaycastParams.new()
	simParams.FilterType = Enum.RaycastFilterType.Exclude
	simParams.RespectCanCollide = false
	simParams.IgnoreWater = true

	local function simulate(name, mode)
		local sim = Game.modules.grenadeSim
		local physics = physicsByWeapon[name] or defaults
		local fuse = (physics.FuseTime and physics.FuseTime > 0) and physics.FuseTime or fuseDefaults[name]
		local options = {
			rangeScale = 1, isNearThrow = mode == "Near",
			radius = physics.Radius or defaults.Radius, restitution = physics.Restitution or defaults.Restitution,
			maxBounces = physics.MaxBounces or defaults.MaxBounces, fuseTime = fuse,
			minimumFuseTime = floorExplode[name] and 0.1 or nil, explodeOnFloorImpact = floorExplode[name] or nil,
		}
		simParams.FilterDescendantsInstances = { localPlayer.Character, currentCamera, workspaceService:FindFirstChild("Debris") }
		if physics.CollisionGroup then simParams.CollisionGroup = physics.CollisionGroup end

		local controller = Game.modules.characterController
		local current = controller and controller.getCurrentCharacter and controller.getCurrentCharacter()
		local velocity = current and typeof(current.GlobalVelocity) == "Vector3" and current.GlobalVelocity or Vector3.zero
		local eye = currentCamera.CFrame
		local position, direction = sim.calculateThrowParameters(eye.Position, eye.LookVector, mode, 1)
		local state = sim.createInitialState(position, direction, mode, velocity, 1, tick())
		local points, markers, steps = { state.position }, {}, 0
		local lastDirection
		for _ = 1, 300 do
			local step = sim.simulate(state, options, simParams, 1 / 60)
			local before = state.position
			state = step.state
			steps += 1
			local move = state.position - before
			if move.Magnitude > 0.001 then
				local direction = move.Unit
				if lastDirection and direction:Dot(lastDirection) < 0.88 then markers[#markers + 1] = before end
				lastDirection = direction
			end
			points[#points + 1] = state.position
			local rest = state.isAtRest
			for _, event in ipairs(step.events or {}) do
				if event.type == "rest" or event.type == "fuse" or event.type == "floor_impact" then rest = true end
			end
			if rest then break end
		end
		return points, markers, steps / 60
	end

	Neverlose.simulateGrenade = simulate
	local lastSim, cached, cachedMarkers, cachedEta = 0, nil, nil, nil
	maid:give(runService.RenderStepped:Connect(function()
		local world = Neverlose.config.world
		local weapon = Game.weapon()
		local name = weapon and weapon.Name
		local active = world.trajectory and name and GRENADES[name] and Game.modules.grenadeSim
		if not active then
			for index, line in ipairs(segments) do line.Visible = false shadows[index].Visible = false end
			impact.Visible, impactFill.Visible = false, false
			etaText.Visible = false
			for index, dot in ipairs(bounceDots) do dot.Visible = false bounceRings[index].Visible = false end
			return
		end

		if os.clock() - lastSim > 1 / 20 then
			lastSim = os.clock()
			local mode = userInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) and "Near" or "Far"
			local ok, points, markers, eta = pcall(simulate, name, mode)
			if ok then cached, cachedMarkers, cachedEta = points, markers, eta end
		end
		local points = cached or {}
		local step = math.max(1, math.ceil(#points / #segments))
		local index = 0
		local total = math.max(math.ceil((#points - 1) / step), 1)
		local tail = GRENADES[name].color
		for p = 1, #points - step, step do
			index += 1
			local line = segments[index]
			if not line then break end
			local shadow = shadows[index]
			local a, aVisible = currentCamera:WorldToViewportPoint(points[p])
			local b, bVisible = currentCamera:WorldToViewportPoint(points[math.min(p + step, #points)])
			local alpha = (index - 1) / total
			local from, to = Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y)
			local visible = aVisible and bVisible and a.Z > 0 and b.Z > 0
			line.Visible, shadow.Visible = visible, visible
			line.From, line.To, shadow.From, shadow.To = from, to, from, to
			line.Color = world.trajectoryColor:Lerp(tail, alpha * alpha)
			line.Transparency = 0.35 + 0.65 * math.min(alpha * 4, 1)
			line.Thickness = world.trajectoryThickness * (1 - alpha * 0.35)
			shadow.Thickness = line.Thickness + 2
			shadow.Transparency = 0.25 * line.Transparency
		end
		for rest = index + 1, #segments do segments[rest].Visible = false shadows[rest].Visible = false end

		local last = points[#points]
		local point, visible = nil, false
		if last then point, visible = currentCamera:WorldToViewportPoint(last) end
		impact.Visible = world.trajectoryImpact and last ~= nil and visible == true
		impactFill.Visible = impact.Visible
		if impact.Visible then
			local center = Vector2.new(point.X, point.Y)
			local radius = math.clamp(GRENADES[name].radius * 40 / math.max(point.Z, 1), 4, 200)
			local pulse = 1 + math.sin(os.clock() * 4) * 0.04
			impact.Position, impactFill.Position = center, center
			impact.Radius, impactFill.Radius = radius * pulse, radius * pulse
			impact.Color, impactFill.Color = GRENADES[name].color, GRENADES[name].color
			impact.Thickness, impactFill.Transparency = 2, 0.85
		end
		for dotIndex, dot in ipairs(bounceDots) do
			local marker = cachedMarkers and cachedMarkers[dotIndex]
			local screen, onScreen
			if marker then screen, onScreen = currentCamera:WorldToViewportPoint(marker) end
			dot.Visible = marker ~= nil and onScreen == true and screen.Z > 0
			local ring = bounceRings[dotIndex]
			ring.Visible = dot.Visible
			if dot.Visible then
				local center = Vector2.new(screen.X, screen.Y)
				dot.Position, dot.Color = center, Color3.new(1, 1, 1)
				ring.Position, ring.Color = center, world.trajectoryColor
			end
		end
		etaText.Visible = false
		if last and visible then
			local inside = 0
			if name ~= "Smoke Grenade" and name ~= "Decoy Grenade" then
				for _, entity in ipairs(Game.entities()) do
					if Game.isEnemy(entity, true) then
						local character = Game.character(entity)
						local root = character and character:FindFirstChild("HumanoidRootPart")
						if root and (root.Position - last).Magnitude <= GRENADES[name].radius then inside += 1 end
					end
				end
			end
			etaText.Text = inside > 0 and ("%.1fs  %d in range"):format(cachedEta or 0, inside) or ("%.1fs"):format(cachedEta or 0)
			etaText.Position = Vector2.new(point.X, point.Y - 22)
			etaText.Color = inside > 0 and Color3.fromRGB(255, 90, 90) or Color3.new(1, 1, 1)
			etaText.Visible = true
		end
	end))
end

