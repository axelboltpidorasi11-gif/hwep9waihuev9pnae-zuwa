local Ballistics, isPassThrough, history, smokes
do
Ballistics = {}

local traceParams = RaycastParams.new()
traceParams.FilterType = Enum.RaycastFilterType.Exclude
traceParams.CollisionGroup = "Bullet"

local exitParams = RaycastParams.new()
exitParams.FilterType = Enum.RaycastFilterType.Include
exitParams.CollisionGroup = "Bullet"

local ignoreCache = { at = -1, list = nil }

function Ballistics.ignoreList()
	local now = os.clock()
	if ignoreCache.list and now - ignoreCache.at < 0.1 then return ignoreCache.list end

	local list = {}
	local rayIgnore = Game.modules.rayIgnore
	if type(rayIgnore) == "function" then
		local previousIdentity = getthreadidentity and getthreadidentity()
		local ok, result = pcall(rayIgnore)
		if setthreadidentity and previousIdentity then pcall(setthreadidentity, previousIdentity) end
		if ok and type(result) == "table" then
			for _, item in ipairs(result) do list[#list + 1] = item end
		end
	end
	list[#list + 1] = localPlayer.Character
	list[#list + 1] = currentCamera
	list[#list + 1] = effectsFolder

	ignoreCache.at, ignoreCache.list = now, list
	return list
end

function isPassThrough(part)
	return part.Name == "HumanoidRootPart" or part.Name == "CollisionCapsule"
		or part:FindFirstAncestorWhichIsA("Accessory") ~= nil or part:HasTag("CharacterAccessory")
end
Ballistics.isPassThrough = isPassThrough

function Ballistics.isGlass(part)
	return part.Material == Enum.Material.Glass or part:HasTag("BreakableGlass")
		or (part.Parent ~= nil and part.Parent:HasTag("BreakableGlass"))
end

local function toHit(result, isExit)
	return {
		Instance = result.Instance, Position = result.Position, Normal = result.Normal,
		Material = result.Material.Name, Exit = isExit == true,
	}
end

Ballistics.penBonus = {
	[Enum.Material.Plastic] = 10, [Enum.Material.SmoothPlastic] = 10, [Enum.Material.Wood] = 10, [Enum.Material.WoodPlanks] = 10,
	[Enum.Material.Cardboard] = 10, [Enum.Material.Glass] = 25, [Enum.Material.Fabric] = 25,
}
Ballistics.penVariants = { ["Sandy Brick"] = true, IndoorWall = true }

function Ballistics.trace(origin, direction, range, targetCharacter, maxWalls)
	traceParams.FilterDescendantsInstances = Ballistics.ignoreList()

	local hits, walls, cursor = {}, 0, origin
	local characters = workspaceService:FindFirstChild("Characters")
	local weapon = Game.weapon()
	local penetration = weapon and weapon.Properties and weapon.Properties.Penetration or 0
	local spent = {}
	local reactor = workspaceService:GetAttribute("Map") == "Reactor"

	for _ = 1, 48 do
		local remaining = range - (cursor - origin).Magnitude
		if remaining <= 0 then break end

		local result = workspaceService:Raycast(cursor, direction * remaining, traceParams)
		if not result then break end
		traceParams:AddToFilter(result.Instance)

		local part = result.Instance
		if not isPassThrough(part) then
			local blockedUntil = Ballistics.blocked[part]
			if blockedUntil and blockedUntil > os.clock() and not (characters and part:IsDescendantOf(characters)) then
				hits[#hits + 1] = toHit(result, false)
				return hits, false, walls + 1
			end
			if targetCharacter and part:IsDescendantOf(targetCharacter) then
				hits[#hits + 1] = toHit(result, false)
				return hits, true, walls
			end
			if characters and part:IsDescendantOf(characters) then
				hits[#hits + 1] = toHit(result, false)
				return hits, targetCharacter == nil, walls
			end

			if not Ballistics.isGlass(part) then walls += 1 end
			hits[#hits + 1] = toHit(result, false)
			if walls > maxWalls then return hits, false, walls end

			exitParams.FilterDescendantsInstances = { part }
			local far = result.Position + direction.Unit * 1000
			local back = workspaceService:Raycast(far, result.Position - far, exitParams)
			if not back then return hits, false, walls end

			local variant = part.MaterialVariant
			local key, bonus
			if variant ~= "" and Ballistics.penVariants[variant] then
				key, bonus = variant, 0
			else
				local material = (part.Parent and part.Parent:HasTag("BreakableDoor")) and Enum.Material.Metal or part.Material
				key, bonus = material, Ballistics.penBonus[material] or 0
			end
			if bonus == 0 and reactor then bonus = -1 end
			spent[key] = (spent[key] or 0) + (back.Position - result.Position).Magnitude
			local margin, slack = 0.88, 0.06
			if Ballistics.safe then margin, slack = 0.78, 0.1 end
			if spent[key] > (bonus + penetration) * margin - slack then return hits, false, walls end

			hits[#hits + 1] = toHit(back, true)
			cursor = back.Position + direction * 0.001
		end
	end

	return hits, false, walls
end

function Ballistics.wallResult(name, walls, accepted)
	if not name or walls <= 0 then return end
	local key = name .. ":" .. walls
	local st = Neverlose.stats or {}
	Neverlose.stats = st
	if accepted then
		st.wallOk = (st.wallOk or 0) + 1
		Ballistics.wallFails[key] = 0
		local learned = Ballistics.wallLimit[name]
		if learned and walls > learned.limit then Ballistics.wallLimit[name] = nil end
		return
	end
	st.wallFail = (st.wallFail or 0) + 1
	Ballistics.wallFails[key] = (Ballistics.wallFails[key] or 0) + 1
	if Ballistics.wallFails[key] >= 2 then
		Ballistics.wallLimit[name] = { limit = walls - 1, expires = os.clock() + 45 }
		Ballistics.wallFails[key] = 0
	end
end

function Ballistics.withDistances(origin, hits)
	local last = origin
	for _, hit in ipairs(hits) do
		hit.Distance = (hit.Position - last).Magnitude
		last = hit.Position
	end
	return hits
end

function Ballistics.damage(properties, partName, distance, walls, character)
	local group = PART_GROUP[partName]
	local perPart = properties and properties.DamagePerPart
	if not group or type(perPart) ~= "table" or not perPart[group] then
		return properties and properties.Damage or 0
	end

	local damage = perPart[group] * (properties.RangeModifier or 1) ^ ((distance / 0.075) / 500)
	if walls > 0 then
		damage *= (properties.WallbangMultiplier or 0.5) ^ walls
	end

	local armor, helmet = Game.armor(character)
	if armor > 0 and group ~= "Legs" and (group ~= "Head" or helmet) then
		damage *= properties.ArmorPenetration or 1
	end

	return damage * (properties.BulletsPerShot or 1)
end

function Ballistics.allowedWalls(weapon, enabled, cap)
	if not enabled then return 0 end
	local penetration = weapon and weapon.Properties and weapon.Properties.Penetration or 0
	local base
	if Game.serverHits then

		base = penetration > 0 and math.min(cap or 2, 2) or 0
	else
		base = cap or 4
	end
	base = math.min(base, Neverlose.config.rage.maxWalls or 1)

	local learned = weapon and Ballistics.wallLimit[weapon.Name]
	if learned and os.clock() < learned.expires then return math.min(base, learned.limit) end
	return base
end

local velocities = setmetatable({}, { __mode = "k" })
local lastRoots = setmetatable({}, { __mode = "k" })
history = setmetatable({}, { __mode = "k" })
Ballistics.history = history
Ballistics.wallLimit, Ballistics.wallFails = {}, {}
Ballistics.blocked = setmetatable({}, { __mode = "k" })

maid:give(runService.Heartbeat:Connect(function(delta)
	if delta <= 0 then return end
	local now = os.clock()
	local keep = HISTORY_WINDOW[Neverlose.config.rage.history] or 0

	for _, entity in ipairs(Game.entities()) do
		local character = entity ~= localPlayer and Game.character(entity)
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local previous = lastRoots[entity]
			if previous then
				local velocity = (root.Position - previous) / delta
				if velocity.Magnitude > 80 then velocity = Vector3.zero end
				velocities[entity] = (velocities[entity] or velocity):Lerp(velocity, 0.35)
			end
			lastRoots[entity] = root.Position

			if keep > 0 then
				local records = history[entity] or {}
				history[entity] = records
				local record = { t = now, cframes = {} }
				for _, name in ipairs(BODY_PARTS) do
					local part = character:FindFirstChild(name)
					if part then record.cframes[name] = part.CFrame end
				end
				records[#records + 1] = record
				while records[1] and now - records[1].t > keep do
					table.remove(records, 1)
				end
			else
				history[entity] = nil
			end
		else
			lastRoots[entity], velocities[entity], history[entity] = nil, nil, nil
		end
	end
end))

function Ballistics.predict(entity, position, ms)
	local velocity = ms > 0 and velocities[entity]
	if not velocity then return position end
	return position + Vector3.new(velocity.X, velocity.Y * 0.5, velocity.Z) * (ms / 1000)
end

function Ballistics.velocity(entity)
	return velocities[entity] or Vector3.zero
end

function Ballistics.points(part, enabled)
	local points = { part.Position }
	if not enabled then return points end
	local half = part.Size * 0.25
	local cf = part.CFrame
	points[#points + 1] = cf * Vector3.new(0, half.Y, 0)
	points[#points + 1] = cf * Vector3.new(half.X, 0, 0)
	points[#points + 1] = cf * Vector3.new(-half.X, 0, 0)
	if part.Name ~= "Head" then
		points[#points + 1] = cf * Vector3.new(0, -half.Y, 0)
	end
	return points
end

