function Menu.aimbot(window, hk)
	window:AddTabLabel("Aimbot")

	local rage, aa = Neverlose.config.rage, Neverlose.config.aa
	local AntiAim = Neverlose.AntiAim
	local RageTab = window:AddTab("Rage", "crosshair")
	Neverlose.tabs.Rage = RageTab
