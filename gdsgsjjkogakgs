local Input, Buttons, wrapAngle
do

Input = { modifiers = {} }

function Input.add(priority, callback)
	Input.modifiers[#Input.modifiers + 1] = { priority = priority, callback = callback }
	table.sort(Input.modifiers, function(a, b) return a.priority < b.priority end)
end

Buttons = Game.modules.buttons

function Input.setButton(frame, name, state)
	if not (Buttons and Buttons.with and Buttons[name] ~= nil) then return end
	frame.Buttons = Buttons.with(frame.Buttons, Buttons[name], state)
end

function Input.hasButton(frame, name)
	if not (Buttons and Buttons[name] ~= nil) then return false end
	if type(Buttons.has) == "function" then
		local ok, value = pcall(Buttons.has, frame.Buttons, Buttons[name])
		if ok then return value == true end
	end
	if type(frame.Buttons) == "number" and type(Buttons[name]) == "number" then
		return bit32.band(frame.Buttons, Buttons[name]) ~= 0
	end
	return false
end

function Input.retarget(frame, fromYaw, toYaw)
	local move = frame.Move
	if typeof(move) ~= "Vector2" or move.Magnitude == 0 then return end
	local world = CFrame.Angles(0, fromYaw, 0):VectorToWorldSpace(Vector3.new(move.X, 0, move.Y))
	local relative = CFrame.Angles(0, toYaw, 0):VectorToObjectSpace(world)
	frame.Move = Vector2.new(math.clamp(relative.X, -1, 1), math.clamp(relative.Z, -1, 1))
end

function Input.moveToward(frame, worldDirection, scale)
	local flat = Vector3.new(worldDirection.X, 0, worldDirection.Z)
	if flat.Magnitude < 1e-3 then
		frame.Move = Vector2.zero
		return
	end
	local relative = CFrame.Angles(0, frame.LookYaw, 0):VectorToObjectSpace(flat.Unit) * (scale or 1)
	frame.Move = Vector2.new(math.clamp(relative.X, -1, 1), math.clamp(relative.Z, -1, 1))
end

Input.sent = { yaw = nil, pitch = nil }

function Input.isLocal(sim)
	local controller = Game.modules.characterController
	if controller and type(controller.getCurrentCharacter) == "function" then
		local ok, current = pcall(controller.getCurrentCharacter)
		if ok and current ~= nil then return current == sim end
	end
	local root = type(sim) == "table" and sim.HumanoidRootPart
	return typeof(root) == "Instance" and localPlayer.Character ~= nil and root:IsDescendantOf(localPlayer.Character)
end

local characterClass = Game.modules.character
if characterClass and type(characterClass.SampleInput) == "function" then
	Patch.hook(characterClass.SampleInput, function(original)
		return function(self, ...)
			local context = ...
			local frame = original(self, ...)
			if type(frame) ~= "table" then return frame end
			if not Input.isLocal(self) then return frame end
			if typeof(frame.Move) ~= "Vector2" then frame.Move = Vector2.zero end
			if type(frame.LookYaw) ~= "number" then return frame end

			local state = type(context) == "table" and context.State or nil
			for _, modifier in ipairs(Input.modifiers) do
				pcall(modifier.callback, self, frame, state)
			end

			Input.sent.yaw, Input.sent.pitch = frame.LookYaw, frame.VerticalLook
			return frame
		end
	end)
end

function wrapAngle(angle)
	return (angle + math.pi) % (2 * math.pi) - math.pi
end

