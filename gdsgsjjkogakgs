function Ballistics.throughSmoke(from, to)
	local parts = {}
	for model in pairs(smokes) do
		if model.Parent then
			parts[#parts + 1] = model
		else
			smokes[model] = nil
		end
	end
	for _, grenade in ipairs(collectionService:GetTagged("Smoke")) do
		parts[#parts + 1] = grenade
	end
	if #parts == 0 then return false end
	smokeParams.FilterDescendantsInstances = parts
	return workspaceService:Raycast(from, to - from, smokeParams) ~= nil
end

