local Rage, lastShot
do
Rage = { target = nil, stable = 0, stopping = false, shooting = false, peekOrigin = nil, peekReturning = false }

function Rage.minDamage()
	local config = Neverlose.config.rage
	return config.minDmgOverride and config.minDmgOverrideValue or config.minDamage
end

local originParams = RaycastParams.new()
originParams.FilterType = Enum.RaycastFilterType.Exclude

local originOverlap = OverlapParams.new()
originOverlap.FilterType = Enum.RaycastFilterType.Exclude

---True when a shifted shot origin is not inside solid geometry.
function Rage.originClear(position)
	originOverlap.FilterDescendantsInstances = { localPlayer.Character, currentCamera }
	for _, part in ipairs(workspaceService:GetPartBoundsInRadius(position, 0.3, originOverlap)) do
		if part.CanCollide and not isPassThrough(part) then return false end
	end
	return true
end

function Rage.originShifts()

	local scale = Rage.originScale or 1
	if scale < 1 then
		scale = math.min(1, scale + (os.clock() - (Rage.originScaleAt or os.clock())) * 0.04)
		Rage.originScale = scale
	end
	Rage.originScaleAt = os.clock()
	local reach = (Neverlose.config.rage.originRange or 2) * scale
	local view = currentCamera.CFrame
	local right, up, look = view.RightVector, view.UpVector, view.LookVector
	local shifts = {}

	for _, scale in ipairs({ 0.45, 1 }) do
		local r = reach * scale
		for _, shift in ipairs({
			right * r, -right * r, up * r * 0.6, right * r * 0.6 + up * r * 0.5, -right * r * 0.6 + up * r * 0.5,
			look * r, (right + look) * r * 0.7, (-right + look) * r * 0.7,
		}) do
			shifts[#shifts + 1] = shift
		end
	end

	local velocity = Rage.selfVelocity
	if velocity then
		local flat = Vector3.new(velocity.X, 0, velocity.Z)
		if flat.Magnitude > 3 then
			if flat.Magnitude * 0.12 > reach * 1.5 then flat = flat.Unit * (reach * 1.5 / 0.12) end
			shifts[#shifts + 1] = flat * 0.06
			shifts[#shifts + 1] = flat * 0.12
		end
	end
	return shifts
end

function Rage.originShiftsFor(toward)
	local scale = Rage.originScale or 1
	local reach = (Neverlose.config.rage.originRange or 2) * scale
	local flat = Vector3.new(toward.X, 0, toward.Z)
	if flat.Magnitude < 0.1 then flat = Vector3.new(currentCamera.CFrame.LookVector.X, 0, currentCamera.CFrame.LookVector.Z) end
	local forward = flat.Magnitude > 0.01 and flat.Unit or Vector3.zAxis
	local side, up = Vector3.yAxis:Cross(forward), Vector3.yAxis
	local shifts = {}
	for _, factor in ipairs({ 0.25, 0.5, 0.75, 1 }) do
		local r = reach * factor
		for _, shift in ipairs({
			side * r, -side * r, up * r * 0.6, side * r * 0.6 + up * r * 0.5, -side * r * 0.6 + up * r * 0.5,
			(side + forward) * r * 0.7, (-side + forward) * r * 0.7, forward * r,
		}) do
			shifts[#shifts + 1] = shift
		end
	end
	local velocity = Rage.selfVelocity
	if velocity then
		local move = Vector3.new(velocity.X, 0, velocity.Z)
		if move.Magnitude > 3 then
			if move.Magnitude * 0.12 > reach * 1.5 then move = move.Unit * (reach * 1.5 / 0.12) end
			shifts[#shifts + 1] = move * 0.06
			shifts[#shifts + 1] = move * 0.12
		end
	end
	return shifts
end

Rage.threat, Rage.suspect = {}, {}

function Rage.threatOf(entity)
	local record = Rage.threat[entity]
	if not record then return 0 end
	return record.value * 0.5 ^ ((os.clock() - record.at) / 40)
end

function Rage.addThreat(entity, amount)
	Rage.threat[entity] = { value = math.min(Rage.threatOf(entity) + amount, 8), at = os.clock() }
end

---Angle in degrees between where an enemy looks and the direction to the local player.
function Rage.aimAngle(character, target)
	local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	if not head then return nil end
	local toward = target - head.Position
	if toward.Magnitude < 0.5 then return nil end
	local dot = math.clamp(head.CFrame.LookVector:Dot(toward.Unit), -1, 1)
	return math.deg(math.acos(dot)), toward.Magnitude, head.Position
end

