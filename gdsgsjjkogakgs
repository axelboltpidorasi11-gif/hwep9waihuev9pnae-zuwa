function Menu.inventory(window)
	local skinsConfig = Neverlose.config.skins
	local tab = window:AddTab("Inventory", "layers")
	Neverlose.tabs.Inventory = tab

	local TEAM_NAME = { CT = "Counter-Terrorists", T = "Terrorists" }
	local CATEGORIES = { "Pistols", "Mid-Tier", "Rifles" }
	local MID_TYPES = { SMG = true, Heavy = true }
	local WEAR_FLOAT = { ["Factory New"] = 0.035, ["Minimal Wear"] = 0.11, ["Field-Tested"] = 0.265, ["Well-Worn"] = 0.415, ["Battle-Scarred"] = 0.725 }

	local GRADE = {
		Default = "Consumer", White = "Consumer", Grey = "Consumer", Gray = "Consumer", ["Light Blue"] = "Industrial",
		Blue = "Mil-Spec", Purple = "Restricted", Pink = "Classified", Red = "Covert", Gold = "Contraband", Yellow = "Contraband",
	}

	local WEAPONS = { CT = { Pistols = {}, ["Mid-Tier"] = {}, Rifles = {} }, T = { Pistols = {}, ["Mid-Tier"] = {}, Rifles = {} } }
	do
		local database = replicatedStorage:FindFirstChild("Database")
		local folder = database and database:FindFirstChild("Custom") and database.Custom:FindFirstChild("Weapons")
		for _, module in ipairs(folder and folder:GetChildren() or {}) do
			if module:IsA("ModuleScript") then
				local ok, data = asGame(require, module)
				if ok and type(data) == "table" and data.Class == "Weapon" and (data.Slot == "Primary" or data.Slot == "Secondary") then
					local category = data.Slot == "Secondary" and "Pistols" or (data.Type == "Rifle" and "Rifles" or (MID_TYPES[data.Type] and "Mid-Tier" or nil))
					if category then
						for side, teamName in pairs(TEAM_NAME) do
							if data.Team == "Both" or data.Team == teamName then table.insert(WEAPONS[side][category], module.Name) end
						end
					end
				end
			end
		end
		for _, side in pairs(WEAPONS) do
			for _, list in pairs(side) do
				table.sort(list)
				while #list > 5 do table.remove(list) end
			end
		end

		local controllers = replicatedStorage:FindFirstChild("Controllers")
		local okData, dataController = false, nil
		if controllers and controllers:FindFirstChild("DataController") then okData, dataController = asGame(require, controllers.DataController) end
		local okLoadout, loadout = false, nil
		if okData and type(dataController) == "table" and type(dataController.Get) == "function" then
			okLoadout, loadout = asGame(dataController.Get, playersService.LocalPlayer, "Loadout")
		end
		if okLoadout and type(loadout) == "table" then
			local CATEGORY_OF = { Pistols = "Pistols", ["Mid Tier"] = "Mid-Tier", ["Mid-Tier"] = "Mid-Tier", Rifles = "Rifles" }
			for side, teamName in pairs(TEAM_NAME) do
				local groups = type(loadout[teamName]) == "table" and loadout[teamName].Loadout
				if type(groups) == "table" then
					for groupName, group in pairs(groups) do
						local category = CATEGORY_OF[groupName]
						if category and type(group) == "table" and type(group.Options) == "table" then
							local picked = {}
							for _, id in ipairs(group.Options) do
								local weaponName = tostring(id):match("^(.-)_[^_]*$") or tostring(id)
								if weaponName ~= "" then picked[#picked + 1] = weaponName end
							end
							if #picked > 0 then WEAPONS[side][category] = picked end
						end
					end
				end
			end
		end
	end

	local GEAR = {
		{ "Agent", "rbxassetid://10747373176" }, { "Badge", "rbxassetid://10709769406" }, { "Charm", "rbxassetid://10734905958" },
		{ "Knife", "rbxassetid://10734975486" }, { "Gloves", "rbxassetid://10723405649" }, { "Zeus", "rbxassetid://10734951847" },
	}
	local DEFAULT_HELD = { CT = WEAPONS.CT.Rifles[1], T = WEAPONS.T.Rifles[1] }
	for side, name in pairs({ CT = "M4A4", T = "AK-47" }) do
		if table.find(WEAPONS[side].Rifles, name) then DEFAULT_HELD[side] = name end
	end

	local function sideEntry(team) return skinsConfig.bySide[team == "T" and "T" or "CT"] end
	local function gradeOf(rarity) return GRADE[rarity] or rarity or "Consumer" end
	local RARITY_COLOR = {
		Consumer = Color3.fromRGB(176, 195, 217), Industrial = Color3.fromRGB(94, 152, 217), ["Mil-Spec"] = Color3.fromRGB(75, 105, 255),
		Restricted = Color3.fromRGB(136, 71, 255), Classified = Color3.fromRGB(211, 44, 230), Covert = Color3.fromRGB(235, 75, 75),
		Contraband = Color3.fromRGB(228, 174, 57),
	}

	local function listFor(weapon)
		local out = {}
		for _, entry in ipairs(weapon and Skins.forWeapon(weapon) or {}) do
			if entry.skin ~= "Stock" then out[#out + 1] = { entry.skin, gradeOf(entry.rarity), entry.image } end
		end
		return out
	end

	local knifeNames, gloveNames, typeIcons = {}, {}, { Knife = {}, Gloves = {} }
	local function stockImage(name)
		for _, entry in ipairs(Skins.forWeapon(name) or {}) do
			if entry.skin == "Stock" and entry.image and entry.image ~= "" then return entry.image end
		end
		for _, entry in ipairs(Skins.forWeapon(name) or {}) do
			if entry.image and entry.image ~= "" then return entry.image end
		end
		return nil
	end
	local weaponAssets = replicatedStorage:FindFirstChild("Assets") and replicatedStorage.Assets:FindFirstChild("Weapons")
	for _, name in ipairs(Skins.knives) do
		local folder = weaponAssets and weaponAssets:FindFirstChild(name)
		if folder and folder:FindFirstChild("Character") and #(Skins.forWeapon(name) or {}) > 0 then
			knifeNames[#knifeNames + 1] = name
			typeIcons.Knife[name] = stockImage(name)
		end
	end
	for name in pairs(Skins.gloves) do
		if weaponAssets and weaponAssets:FindFirstChild(name) and #(Skins.forWeapon(name) or {}) > 0 then
			gloveNames[#gloveNames + 1] = name
			typeIcons.Gloves[name] = stockImage(name)
		end
	end
	table.sort(knifeNames)
	table.sort(gloveNames)

	task.spawn(function()
		local urls, seen = {}, {}
		local function add(url)
			if type(url) == "string" and url ~= "" and not seen[url] then seen[url] = true urls[#urls + 1] = url end
		end
		local function addWeapon(name)
			for _, entry in ipairs(Skins.forWeapon(name) or {}) do add(entry.image) end
		end
		for _, side in ipairs({ "CT", "T" }) do
			for _, list in pairs(WEAPONS[side]) do
				for _, weapon in ipairs(list) do addWeapon(Skins.resolve(weapon) or weapon) end
			end
		end
		for _, name in ipairs(knifeNames) do addWeapon(name) end
		for _, name in ipairs(gloveNames) do addWeapon(name) end
		for _, pair in ipairs(GEAR) do add(pair[2]) end
		local provider = game:GetService("ContentProvider")
		for index = 1, #urls, 40 do
			local chunk = {}
			for i = index, math.min(index + 39, #urls) do chunk[#chunk + 1] = urls[i] end
			pcall(provider.PreloadAsync, provider, chunk)
			task.wait()
		end
	end)

	local function defaultKnife(team) return table.find(knifeNames, team .. " Knife") and (team .. " Knife") or knifeNames[1] end
	local function defaultGlove(team) return table.find(gloveNames, team .. " Glove") and (team .. " Glove") or gloveNames[1] end

	local function glovesFor(glove)
		local out, images = {}, {}
		for _, entry in ipairs(glove and Skins.forWeapon(glove) or {}) do images[entry.skin] = entry.image end
		for _, name in ipairs(glove and Skins.gloves[glove] or {}) do out[#out + 1] = { name, "Covert", images[name] } end
		return out
	end

	local modelCache = {}
	local function cachedModel(kind, name)
		local key = kind .. "|" .. name
		if modelCache[key] == nil then
			local lib = Game.modules.skins
			local ok, model = false, nil
			if lib then
				if kind == "Charm" then ok, model = asGame(lib.GetCharmModel, name, 1) else ok, model = asGame(lib.GetBadgeModel, name) end
			end
			modelCache[key] = (ok and typeof(model) == "Instance") and model or false
		end
		return modelCache[key] or nil
	end

	local function charmList()
		local out = {}
		local assets = replicatedStorage:FindFirstChild("Assets")
		local folder = assets and assets:FindFirstChild("Charms")
		for _, child in ipairs(folder and folder:GetChildren() or {}) do
			if child:IsA("Folder") then
				local model = cachedModel("Charm", child.Name)
				if model then out[#out + 1] = { child.Name, "Consumer", model } end
			end
		end
		table.sort(out, function(a, b) return a[1] < b[1] end)
		return out
	end
	local function badgeList()
		local out = {}
		local assets = replicatedStorage:FindFirstChild("Assets")
		local folder = assets and assets:FindFirstChild("Badges")
		for _, child in ipairs(folder and folder:GetChildren() or {}) do
			if child:IsA("Model") then
				local model = cachedModel("Badge", child.Name)
				if model then out[#out + 1] = { child.Name, "Consumer", model } end
			end
		end
		table.sort(out, function(a, b) return a[1] < b[1] end)
		return out
	end

	local function agentList(team)
		local out = {}
		local menuAgent = Agents.find(team)
		local characters = replicatedStorage:FindFirstChild("Assets") and replicatedStorage.Assets:FindFirstChild("Characters")
		for _, name in ipairs(Skins.agentsFor(team)) do
			local model = Skins.agentModels[name]
			local lowered = name:lower()

			if model and characters and model:IsDescendantOf(characters) and not lowered:find("zombie") and not lowered:find("ragdoll")
				and not (menuAgent and model.Name == menuAgent.Name) then
				out[#out + 1] = { name, "Consumer", model }
			end
		end
		local customNames = {}
		for name in pairs(Agents.custom) do if name ~= "Roblox" then customNames[#customNames + 1] = name end end
		table.sort(customNames)
		if Agents.custom.Roblox then table.insert(out, 1, { "Roblox", "Consumer", Agents.custom.Roblox }) end
		for _, name in ipairs(customNames) do out[#out + 1] = { name, "Consumer", Agents.custom[name] } end
		out[#out + 1] = { "+ Add agent", "Consumer" }
		return out
	end

	local skins = {}
	local function refreshLists(team)
		local entry = sideEntry(team)
		for _, category in ipairs(CATEGORIES) do
			for _, weapon in ipairs(WEAPONS[team][category]) do skins[weapon] = listFor(Skins.resolve(weapon)) end
		end
		skins.Knife = listFor(entry.knife or defaultKnife(team))
		skins.Gloves = glovesFor(entry.glove or defaultGlove(team))
		skins.Zeus = listFor("Zeus x27")
		skins.Agent = agentList(team)
		skins.Charm = charmList()
		skins.Badge = badgeList()
	end
	refreshLists("CT")

	local held = Agents.held
	held.CT, held.T = DEFAULT_HELD.CT, DEFAULT_HELD.T
	local loadout
	local function persist(team)
		Neverlose.loadoutSide = team
		Skins.sync()
		Skins.refresh()
	end

	local loadoutOptions
	loadoutOptions = {
		team = "CT",
		weapons = WEAPONS,
		gear = GEAR,
		types = { Knife = knifeNames, Gloves = gloveNames },
		skins = skins,
		onSelect = function(team, category, index, name)
			Neverlose.loadoutSide = team
			refreshLists(team)
			task.defer(function() if loadoutOptions.rebuildGrid then pcall(loadoutOptions.rebuildGrid) end end)
			if WEAPONS[team][category] then held[team] = name end
		end,
		onTeam = function(team)
			Neverlose.loadoutSide = team
			refreshLists(team)
		end,
		onSkin = function(team, category, index, item, skin)
			local entry = sideEntry(team)
			local none = skin == "No Skin" or skin == "Default" and item == "Agent"
			if item == "Agent" then
				entry.agent = (not none) and skin or nil
				skinsConfig["agent" .. team] = entry.agent
				Skins.applyAgent()
			elseif item == "Badge" then
				entry.badge = (not none) and skin or nil
			elseif item == "Charm" then
				entry.charm = (not none) and skin or nil
			elseif item == "Knife" then
				entry.knife = entry.knife or defaultKnife(team)
				entry.knifeSkin = (not none) and skin or nil
			elseif item == "Gloves" then
				entry.glove = entry.glove or defaultGlove(team)
				entry.gloveSkin = (not none) and skin or nil
			else
				entry.weapons[Skins.resolve(item == "Zeus" and "Zeus x27" or item)] = (not none) and skin or nil
			end
			persist(team)
		end,
		onOption = function(team, category, index, item, field, value)
			local entry = sideEntry(team)
			if field == "type" then
				if item == "Knife" and table.find(knifeNames, value) then
					entry.knife = value
					entry.knifeSkin = nil
					skins.Knife = listFor(value)
				elseif item == "Gloves" and Skins.gloves[value] then
					entry.glove = value
					entry.gloveSkin = nil
					skins.Gloves = glovesFor(value)
				end
				persist(team)
				return
			end
			local weapon = item == "Knife" and (entry.knife or defaultKnife(team)) or (item == "Gloves" and (entry.glove or defaultGlove(team)))
				or Skins.resolve(item == "Zeus" and "Zeus x27" or item)
			if not weapon or item == "Agent" or item == "Charm" or item == "Badge" then return end
			if field == "wearFloat" and type(value) == "number" then
				Skins.setSetting(weapon, "float", value * 100)
			elseif field == "wear" and WEAR_FLOAT[value] then
				Skins.setSetting(weapon, "float", WEAR_FLOAT[value] * 100)
			elseif field == "stattrak" then
				Skins.setSetting(weapon, "statTrak", value ~= "None")
			elseif field == "stattrakValue" and type(value) == "number" then
				Skins.setSetting(weapon, "count", value)
			else
				return
			end
			Skins.refresh()
		end,

		onSearchEnter = function(item, text, team)
			if item ~= "Agent" then return false end
			local added = Agents.addCustom(text)
			pcall(window.Log, window, added and "Added agent {" .. text .. "}" or "Could not find agent {" .. text .. "}", { type = added and "info" or "warning" })
			if added then skins.Agent = agentList(team) end
			return added
		end,
		onSticker = function() end,
		onAdd = function(item, team) Neverlose.openAddAgent(team) end,
		typeIcons = typeIcons,

		noSkinIcon = function(item, team)
			local entry = sideEntry(team)
			if item == "Agent" then return Agents.models[team == "T" and "T" or "CT"] end
			if item == "Charm" or item == "Badge" then return nil end
			local weapon
			if item == "Knife" then weapon = entry.knife or defaultKnife(team)
			elseif item == "Gloves" then weapon = entry.glove or defaultGlove(team)
			elseif item == "Zeus" then weapon = "Zeus x27"
			else weapon = Skins.resolve(item) end
			return weapon and stockImage(weapon) or nil
		end,
		preview = function(world, camera, info)
			Inspect.show(world, camera, info, skinsConfig, WEAR_FLOAT)
		end,
	}
	Inspect.defaults = { knife = defaultKnife, glove = defaultGlove }
	loadout = tab:AddLoadout(loadoutOptions)
	Neverlose.loadout = loadout

	do
		local extra = window._configExtras and window._configExtras["inventory"]
		if extra and type(extra.set) == "function" then
			local picks = { CT = {}, T = {} }
			for _, team in ipairs({ "CT", "T" }) do
				local entry = sideEntry(team)
				for _, category in ipairs(CATEGORIES) do
					for index, item in ipairs(WEAPONS[team][category]) do
						local resolved = Skins.resolve(item)
						local skin = entry.weapons[resolved]
						if skin then
							local grade = "Consumer"
							for _, listed in ipairs(Skins.forWeapon(resolved)) do
								if listed.skin == skin then grade = gradeOf(listed.rarity) end
							end
							picks[team][category .. "#" .. index] = { skin = skin, rarity = grade }
						end
					end
				end
				if entry.agent then picks[team]["Gear#1"] = { skin = entry.agent, rarity = "Consumer" } end
				if entry.badge then picks[team]["Gear#2"] = { skin = entry.badge, rarity = "Consumer" } end
				if entry.charm then picks[team]["Gear#3"] = { skin = entry.charm, rarity = "Consumer" } end
				picks[team]["Gear#4"] = { type = entry.knife or defaultKnife(team), skin = entry.knifeSkin, rarity = "Covert" }
				picks[team]["Gear#5"] = { type = entry.glove or defaultGlove(team), skin = entry.gloveSkin, rarity = "Covert" }
				if entry.weapons["Zeus x27"] then picks[team]["Gear#6"] = { skin = entry.weapons["Zeus x27"], rarity = "Consumer" } end
			end
			pcall(extra.set, picks)
			for _, wait in ipairs({ 0.8, 2.5 }) do task.delay(wait, function() pcall(extra.set, picks) end) end
		end
	end

	task.defer(function()
		local function setIcon(card, shown, picked)
			local icon = card:FindFirstChild("NLIcon")
			if not icon then
				icon = Instance.new("ImageLabel")
				icon.Name = "NLIcon"
				icon.AnchorPoint, icon.Position, icon.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.48), UDim2.new(1, -8, 1, -14)
				icon.BackgroundTransparency, icon.ScaleType = 1, Enum.ScaleType.Fit
				icon.ZIndex = card.ZIndex + 1
				icon.Parent = card
			end
			local image = shown and shown.image or ""
			if icon.Image ~= image then icon.Image = image end
			icon.ImageTransparency = picked and 0 or 0.35
			local name = card:FindFirstChild("PickedName")
			if name then name.Visible = false end
			local bar = card:FindFirstChild("GradeBar")
			if bar then bar.BackgroundColor3 = (shown and (RARITY_COLOR[gradeOf(shown.rarity)] or shown.color)) or Color3.fromRGB(176, 180, 192) end
		end

		local function entryOf(weapon, skin)
			if not weapon then return nil end
			for _, listed in ipairs(Skins.forWeapon(weapon)) do
				if listed.skin == (skin or "Stock") then return listed end
			end
			return nil
		end

		local function setPortrait(card, tag, model)
			local view = card:FindFirstChild("NLPortrait")
			if not model then
				if view then view:Destroy() end
				return
			end
			if view and view:GetAttribute("Tag") == tag then return end
			if view then view:Destroy() end
			local copy
			pcall(function() copy = Agents.clone(model) end)
			if not copy then return end
			view = Instance.new("ViewportFrame")
			view.Name, view.BackgroundTransparency, view.Size, view.Position = "NLPortrait", 1, UDim2.new(1, -10, 1, -18), UDim2.fromOffset(5, 3)
			view.ZIndex = card.ZIndex + 1
			view:SetAttribute("Tag", tag)
			view.Ambient, view.LightColor, view.LightDirection = Color3.fromRGB(150, 150, 165), Color3.fromRGB(255, 246, 232), Vector3.new(-1, -0.7, -0.35)
			local world = Instance.new("WorldModel")
			world.Parent = view
			for _, object in ipairs(copy:GetDescendants()) do
				if object:IsA("BasePart") then object.Anchored = true elseif object:IsA("LuaSourceContainer") then object:Destroy() end
			end
			copy.Parent = world
			pcall(function() copy:PivotTo(CFrame.Angles(0, math.pi, 0)) end)
			local camera = Instance.new("Camera")
			camera.FieldOfView = 24
			camera.Parent = view
			view.CurrentCamera = camera
			local head = copy:FindFirstChild("Head")
			if head then
				camera.CFrame = CFrame.lookAt(head.Position + Vector3.new(0, 0.2, 6.2), head.Position - Vector3.new(0, 0.6, 0))
			else
				camera.FieldOfView = 30
				local cframe, size = copy:GetBoundingBox()
				local reach = math.max(size.X, size.Y, size.Z) * 0.6 / math.tan(math.rad(15)) + size.Z / 2
				camera.CFrame = CFrame.lookAt(cframe.Position + Vector3.new(0, 0, reach), cframe.Position)
			end
			view.Parent = card
			local name = card:FindFirstChild("PickedName")
			if name then name.Visible = false end
		end

		local function paintSlots()
			local team = loadout:GetTeam() or "CT"
			local entry = sideEntry(team)
			local slots = loadout.frame:FindFirstChild("Slots", true)
			for _, card in ipairs(slots and slots:GetChildren() or {}) do
				local category, index = card.Name:match("^(.-)_(%d)$")
				local weapon = category and WEAPONS[team][category] and WEAPONS[team][category][tonumber(index)]
				if card:IsA("GuiObject") and category then
					if weapon then
						local resolved = Skins.resolve(weapon)
						local picked = entry.weapons[resolved]
						setIcon(card, entryOf(resolved, picked), picked)
					else
						setIcon(card, nil, nil)
					end
				end
			end

			local gear = loadout.frame:FindFirstChild("Gear", true)
			for _, card in ipairs(gear and gear:GetChildren() or {}) do
				if card:IsA("GuiObject") then
					if card.Name == "Gear_Agent" then
						local model, tag = Agents.find(team)
						setPortrait(card, team .. ":" .. tostring(tag), model)
					elseif card.Name == "Gear_Badge" then
						setPortrait(card, "badge:" .. tostring(entry.badge), entry.badge and cachedModel("Badge", entry.badge) or nil)
					elseif card.Name == "Gear_Charm" then
						setPortrait(card, "charm:" .. tostring(entry.charm), entry.charm and cachedModel("Charm", entry.charm) or nil)
					elseif card.Name == "Gear_Knife" then
						local knife = entry.knife or defaultKnife(team)
						local picked = entry.knifeSkin
						setIcon(card, entryOf(knife, picked), picked)
					elseif card.Name == "Gear_Gloves" then
						local type_ = entry.glove or defaultGlove(team)
						local picked = entry.gloveSkin
						setIcon(card, entryOf(type_, picked), picked)
					elseif card.Name == "Gear_Zeus" then
						local picked = entry.weapons["Zeus x27"]
						setIcon(card, entryOf("Zeus x27", picked), picked)
					end
					local name = card:FindFirstChild("PickedName")
					if name then name.Visible = false end
				end
			end
		end

		local function paintPlus()
			for _, label in ipairs(loadout.frame:GetDescendants()) do
				if label.Name == "SkinName" and label:IsA("TextLabel") then
					local card = label.Parent
					local grid = card.Parent and card.Parent:FindFirstChildOfClass("UIGridLayout")
					if grid and grid.CellSize.Y.Offset == 140 then
						label.TextWrapped, label.TextTruncate, label.TextSize = true, Enum.TextTruncate.AtEnd, 11
						label.TextYAlignment = Enum.TextYAlignment.Bottom
						label.Size = UDim2.new(1, -10, 0, 30)
						label.AnchorPoint, label.Position = Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -4)
						if label.Text == "+ Add agent" and not card:FindFirstChild("NLPlus") then
							local plus = Instance.new("TextLabel")
							plus.Name, plus.BackgroundTransparency, plus.Text, plus.TextSize = "NLPlus", 1, "+", 54
							plus.Font, plus.TextColor3 = Enum.Font.BuilderSansMedium, Color3.fromRGB(176, 195, 217)
							plus.AnchorPoint, plus.Position, plus.Size = Vector2.new(0.5, 0.5), UDim2.new(0.5, 0, 0.5, -16), UDim2.fromOffset(60, 60)
							plus.ZIndex = card.ZIndex + 1
							plus.Parent = card
						end
					end
				end
			end
		end
		local last = 0
		maid:give(runService.Heartbeat:Connect(function()
			if os.clock() - last < 0.5 then return end
			last = os.clock()
			if not loadout.frame.Parent or not loadout.frame.Visible then return end
			pcall(paintPlus)
			local ok, err = pcall(paintSlots)
			if not ok then Neverlose.slotError = tostring(err) end
		end))
	end)

	function Neverlose.openAddAgent(team)
		Neverlose.Ui.prompt({
			title = "Add agent",
			placeholder = "Roblox user name or id",
			hint = "",
			confirm = "Add",
			onSubmit = function(text, setStatus)
				if text:match("^%s*$") then
					setStatus("Type a user name or id first", Color3.fromRGB(235, 120, 120))
					return false
				end
				setStatus("Looking up the avatar...")
				if Agents.addCustom(text) then
					setStatus("Added. Pick it in the agent list.", Color3.fromRGB(120, 220, 150))
					skins.Agent = agentList(team)
					if type(loadoutOptions.rebuildGrid) == "function" then pcall(loadoutOptions.rebuildGrid) end
					return true
				end
				setStatus("No such player (or the avatar failed to load)", Color3.fromRGB(235, 120, 120))
				return false
			end,
		})
	end

	task.defer(function()
		local slots = loadout.frame:FindFirstChild("Slots", true)
		for _, card in ipairs(slots and slots:GetChildren() or {}) do
			local category, index = card.Name:match("^(.-)_(%d)$")
			if category and card:IsA("GuiObject") then
				card.MouseEnter:Connect(function()
					local team = loadout:GetTeam() or "CT"
					local name = WEAPONS[team][category] and WEAPONS[team][category][tonumber(index)]
					if name then held[team] = name end
				end)
			end
		end
	end)
	Agents.attach(loadout.frame, "AgentView", function() return loadout:GetTeam() or "CT" end, 0.8, function()
		return held[loadout:GetTeam() or "CT"]
	end, true, { 1.0, 0.97 })
end

function Menu.build()
	local Library = Menu.loadLibrary()
	Library.DaysLeft = nil

	local hk = {}
	local window = Library:AddWindow("Neverlose", "", "BloxStrike")
	window:SetScale("Auto")

	window._autoLoaded = true
	Neverlose.library, Neverlose.window = Library, window
	Neverlose.tabs = {}
	Neverlose.hk = hk

	HudShift.start()
	Menu.aimbot(window, hk)
	Menu.visuals(window, hk)
	Menu.inventory(window)
	Menu.misc(window, hk)

	if Settings.saved and Settings.saved.extras then
		task.delay(1.5, Settings.restoreExtras)
	end
	task.delay(2.2, function()
		window._autoLoaded = false
		pcall(window._autoLoad)
	end)

	window:SetWatermark({
		positionPreset = "Top Right",
		show = { logo = true, name = true, ping = true, user = true, speed = false, time = false, fps = true, ram = false },
		order = { "logo", "name", "ping", "user", "speed", "time", "fps", "ram" },
	})

	do
		local statsService = game:GetService("Stats")
		local frame = window.Watermark and window.Watermark.frame
		local clock, smooth = 0, 1 / 60
		local function setCell(name, text)
			local label = frame and frame:FindFirstChild(name, true)
			if label and label:IsA("TextLabel") and label.Text ~= text then label.Text = text end
		end
		local function stat(path)
			local ok, value = pcall(function() return statsService.PerformanceStats[path]:GetValue() end)
			return ok and value or nil
		end
		maid:give(runService.Heartbeat:Connect(function(delta)
			smooth += (delta - smooth) * 0.1
			clock += delta
			if clock < 0.25 then return end
			clock = 0
			local frameMs = math.max(smooth * 1000, 1)
			local okPing, ping = pcall(function() return statsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
			ping = okPing and ping or 0
			local character = localPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local velocity = root and root.AssemblyLinearVelocity or Vector3.zero
			local cpu, gpu = stat("CPU"), stat("GPU")
			setCell("RAM", ("%d MB"):format(statsService:GetTotalMemoryUsageMb()))
			setCell("Speed", ("%d SPEED"):format(math.floor(Vector3.new(velocity.X, 0, velocity.Z).Magnitude + 0.5)))
			setCell("KD", ("%.2f KD"):format((Neverlose.kills or 0) / math.max(Neverlose.deaths or 0, 1)))
			setCell("Latency", ("%d MS"):format(math.floor(ping + 0.5)))
			if cpu then setCell("CPU", ("%d%% CPU"):format(math.clamp(math.floor(cpu / frameMs * 100 + 0.5), 0, 100))) end
			if gpu then setCell("GPU", ("%d%% GPU"):format(math.clamp(math.floor(gpu / frameMs * 100 + 0.5), 0, 100))) end
			setCell("Issues", (1000 / frameMs < 40 or ping > 200) and "LAG" or "OK")
		end))
	end

	pcall(function() window.KeybindList.setEnabled(Neverlose.config.misc.windows) end)
	pcall(function() window.SpectatorList.setEnabled(Neverlose.config.misc.spectatorList) end)
end

function Neverlose.detach()
	maid:clean()
	pcall(function()
		local frame = Neverlose.window and Neverlose.window:GetMainFrame()
		local gui = frame and frame:FindFirstAncestorOfClass("ScreenGui")
		if gui then gui:Destroy() end
	end)
	if genv[STATE_KEY] == Neverlose then genv[STATE_KEY] = nil end
end

Neverlose.Game, Neverlose.Ballistics, Neverlose.Patch, Neverlose.Events, Neverlose.Input = Game, Ballistics, Patch, Events, Input
Neverlose.Rage, Neverlose.Legit, Neverlose.Esp, Neverlose.Skins, Neverlose.Logs, Neverlose.Maid, Neverlose.AntiAim = Rage, Legit, Esp, Skins, Logs, Maid, AntiAim
Neverlose.Agents = Agents

local function onInitializeError(error)
	warn("[Neverlose] failed to initialize.")
	warn(error)
	warn(debug.traceback())
	Neverlose.detach()
end

-- Tamper guard: stops the script when a dumping/leaking function gets hooked after load (hooks that already existed are ignored).
local Guard = { baseline = {} }

function Guard.watched()
	return { loadstring, writefile, request, http_request, setclipboard, getscriptclosure, getscriptbytecode, decompile, saveinstance }
end

function Guard.hooked(fn)
	if not isfunctionhooked or type(fn) ~= "function" then return false end
	local ok, result = pcall(isfunctionhooked, fn)
	return ok and result == true
end

function Guard.snapshot()
	for index, fn in pairs(Guard.watched()) do Guard.baseline[index] = Guard.hooked(fn) end
end

function Guard.tampered()
	for index, fn in pairs(Guard.watched()) do
		if Guard.hooked(fn) and not Guard.baseline[index] then return true end
	end
	return false
end

function Guard.trip()
	Neverlose.detach()
end

pcall(Guard.snapshot)

task.spawn(function()
	while genv[STATE_KEY] == Neverlose do
		task.wait(4 + math.random())
		local ok, bad = pcall(Guard.tampered)
		if ok and bad then
			pcall(Guard.trip)
			break
		end
	end
end)

genv[STATE_KEY] = Neverlose
xpcall(Menu.build, onInitializeError)

end
