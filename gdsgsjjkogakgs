do
	local originals = setmetatable({}, { __mode = "k" })
	local lastIcons = 0

	local function iconFor(name)
		local weapons = replicatedStorage:FindFirstChild("Database")
		weapons = weapons and weapons:FindFirstChild("Custom")
		weapons = weapons and weapons:FindFirstChild("Weapons")
		local module = weapons and weapons:FindFirstChild(name)
		if not (module and module:IsA("ModuleScript")) then return nil end
		local ok, data = pcall(require, module)
		if ok and type(data) == "table" and type(data.Icon) == "string" and data.Icon ~= "" then return data.Icon end
		return nil
	end

	maid:give(runService.Heartbeat:Connect(function()
		if os.clock() - lastIcons < 0.4 then return end
		lastIcons = os.clock()
		local node = localPlayer:FindFirstChildOfClass("PlayerGui")
		for _, name in ipairs({ "MainGui", "Gameplay", "Bottom", "Inventory", "Melee", "Weapon" }) do node = node and node:FindFirstChild(name) end
		local icon = node and node:FindFirstChildWhichIsA("ImageLabel", true)
		if not icon then return end
		local picks = Neverlose.config.skins
		local image = picks.enabled and picks.knife and iconFor(picks.knife) or nil
		if image then
			if originals[icon] == nil then originals[icon] = icon.Image end
			if icon.Image ~= image then icon.Image = image end
		elseif originals[icon] then
			icon.Image = originals[icon]
			originals[icon] = nil
		end
	end))
	maid:give(function()
		for icon, image in pairs(originals) do pcall(function() icon.Image = image end) end
		table.clear(originals)
	end)
end

do
