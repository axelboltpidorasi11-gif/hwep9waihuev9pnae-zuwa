local Rage, lastShot
do
Rage = { target = nil, stable = 0, stopping = false, shooting = false, peekOrigin = nil, peekReturning = false }

function Rage.minDamage()
	local config = Neverlose.config.rage
	return config.minDmgOverride and config.minDmgOverrideValue or config.minDamage
end

local originParams = RaycastParams.new()
originParams.FilterType = Enum.RaycastFilterType.Exclude

local originOverlap = OverlapParams.new()
originOverlap.FilterType = Enum.RaycastFilterType.Exclude

---True when a shifted shot origin is not inside solid geometry.
function Rage.originClear(position)
	-- ignoreList сам пропускает nil-персонажа и кэшируется, поэтому здесь
	-- больше нет падения "Array contains nil" во время респавна.
	originOverlap.FilterDescendantsInstances = Ballistics.ignoreList()
	for _, part in ipairs(workspaceService:GetPartBoundsInRadius(position, 0.3, originOverlap)) do
		if part.CanCollide and not isPassThrough(part) then return false end
	end
	return true
end

---Отчёт для подбора Range: сколько места вокруг, из каких точек видно вперёд
---и как часто сервер принимал смещённые выстрелы. Возвращает текст.
function Rage.probeOrigin()
	local out = {}
	local function line(fmt, ...)
		if select("#", ...) > 0 then
			out[#out + 1] = fmt:format(...)
		else
			out[#out + 1] = fmt
		end
	end
	local origin = Game.origin()
	local camera = currentCamera.CFrame
	local weapon = Game.weapon()
	local properties = weapon and weapon.Properties
	local character = Game.localCharacter()
	local cameraPart = localPlayer.Character and localPlayer.Character:FindFirstChild("CameraPart")

	line("=== NEV ORIGIN PROBE ===")
	line("time: %s", os.date("%Y-%m-%d %H:%M:%S"))
	line("game: %s | place: %s | map: %s | serverHits: %s", tostring(game.Name), tostring(game.PlaceId),
		tostring(workspaceService:GetAttribute("Map")), tostring(Game.serverHits))
	line("origin: %.2f %.2f %.2f", origin.X, origin.Y, origin.Z)
	line("cameraPart: %s | camera->origin: %.2f", cameraPart and "yes" or "no", (camera.Position - origin).Magnitude)
	if character then
		local root, head = character:FindFirstChild("HumanoidRootPart"), character:FindFirstChild("Head")
		line("root->origin: %.2f | head->origin: %.2f",
			root and (root.Position - origin).Magnitude or -1, head and (head.Position - origin).Magnitude or -1)
	end
	line("originScan: %s | Range: %.1f | reach: %.1f", tostring(Neverlose.config.rage.originScan),
		tonumber(Neverlose.config.rage.originRange) or 0, Rage.originReach())
	if properties then
		line("weapon: %s", tostring(weapon.Name))
		line("  Penetration: %s | Range: %s | Wallbang: %s | ArmorPen: %s | Bullets: %s",
			tostring(properties.Penetration), tostring(properties.Range), tostring(properties.WallbangMultiplier),
			tostring(properties.ArmorPenetration), tostring(properties.BulletsPerShot))
		line("  allowedWalls: %d | MaxWalls setting: %s | WallMinDamage: %s",
			Ballistics.allowedWalls(weapon, Neverlose.config.rage.autowall),
			tostring(Neverlose.config.rage.maxWalls), tostring(Neverlose.config.rage.wallMinDamage))
	end

	-- Куда смотрим: тестовый «угол» в 60 стадах по направлению камеры.
	local look = camera.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then flat = Vector3.zAxis else flat = flat.Unit end
	local side = Vector3.yAxis:Cross(flat).Unit
	local probePoint = origin + flat * 60
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = Ballistics.ignoreList()
	local function clearFrom(from)
		return workspaceService:Raycast(from, probePoint - from, rayParams) == nil
	end

	line("-- space around you (radius / free points / points with clear line) --")
	local maxUseful = 0
	for radius = 1, 9 do
		local free, see = 0, 0
		for step = 0, 11 do
			local angle = step / 12 * math.pi * 2
			local point = origin + (flat * math.cos(angle) + side * math.sin(angle)) * radius
			if Rage.originClear(point) then
				free += 1
				if clearFrom(point) then see += 1 end
			end
		end
		if see > 0 then maxUseful = radius end
		line("  %2d st: free %2d/12 | line %2d/12", radius, free, see)
	end
	line("max radius with at least one clear line: %d st", maxUseful)

	-- Насколько близко геометрия: по этому видно, стоишь ли ты вообще у укрытия.
	local nearest = {}
	for step = 0, 7 do
		local angle = step / 8 * math.pi * 2
		local dir = (flat * math.cos(angle) + side * math.sin(angle)).Unit
		local hit = workspaceService:Raycast(origin, dir * 12, rayParams)
		nearest[#nearest + 1] = ("%d°:%.1f"):format(step * 45, hit and (hit.Position - origin).Magnitude or 12)
	end
	line("-- nearest geometry within 12 st --")
	line("  " .. table.concat(nearest, " | "))

	local target = Rage.target
	line("-- current target --")
	if target and target.part and target.part.Parent then
		local aim = Rage.aimPoint(target)
		local distance = aim and (aim - origin).Magnitude or 0
		local maxWalls = Ballistics.allowedWalls(weapon, Neverlose.config.rage.autowall)
		if aim and distance > 0.1 then
			local direction = (aim - origin).Unit
			local _, reached, walls = Ballistics.trace(origin, direction, distance + 2, target.character, maxWalls)
			line("  direct: %s | walls %d | %.1f st", reached and "visible" or "blocked", walls, distance)
			local rank = Rage.originRank and Rage.originRank[target.entity]
			if rank and rank.shifts and #rank.shifts > 0 then
				for index = 1, math.min(#rank.shifts, 4) do
					local shift = rank.shifts[index]
					local from = origin + shift
					local lineDir = aim - from
					local _, fromReached, fromWalls = Ballistics.trace(from, lineDir.Unit, lineDir.Magnitude + 2, target.character, maxWalls)
					line("  scan %.1f st: %s | walls %d", shift.Magnitude, fromReached and "visible" or "blocked", fromWalls)
				end
			else
				line("  scan: no point cached (direct line open or too far)")
			end
		end
	else
		line("  no target (rage off / nobody in FOV)")
	end

	local data = Rage.originProbeData
	line("-- shifted shots --")
	if not data or (data.hits + data.misses) == 0 then
		line("  no shifted shots recorded yet")
	else
		local total = data.hits + data.misses
		line("  hits %d | misses %d | %.0f%%", data.hits, data.misses, data.hits / total * 100)
		local keys = {}
		for key in pairs(data.buckets) do keys[#keys + 1] = key end
		table.sort(keys)
		for _, key in ipairs(keys) do
			local bucket = data.buckets[key]
			local count = bucket.ok + bucket.fail
			line("  %.1f-%.1f st: %d/%d (%.0f%%)", key, key + 0.5, bucket.ok, count, bucket.ok / count * 100)
		end
		local reasons = {}
		for reason, count in pairs(data.reasons) do reasons[#reasons + 1] = { reason, count } end
		table.sort(reasons, function(a, b) return a[2] > b[2] end)
		for index = 1, math.min(#reasons, 6) do
			line("  miss reason: %s x%d", reasons[index][1], reasons[index][2])
		end
	end
	line("=== END ===")
	return table.concat(out, "\n")
end

---Пассивная телеметрия origin: по каким смещениям попадаем, а по каким нет.
---Нужна для отчёта, чтобы подбирать Range по реальным данным, а не на глаз.
function Rage.noteProbe(hit, reason, magnitude)
	local data = Rage.originProbeData
	if not data then
		data = { hits = 0, misses = 0, reasons = {}, buckets = {} }
		Rage.originProbeData = data
	end
	if hit then data.hits += 1 else data.misses += 1 end
	local mag = tonumber(magnitude)
	if mag and mag > 0 then
		local key = math.floor(mag * 2 + 0.5) / 2
		local bucket = data.buckets[key]
		if not bucket then bucket = { ok = 0, fail = 0 } data.buckets[key] = bucket end
		if hit then bucket.ok += 1 else bucket.fail += 1 end
	end
	if not hit and reason then
		data.reasons[reason] = (data.reasons[reason] or 0) + 1
	end
end

---Статистика по смещённым выстрелам. Раньше промах урезал рабочий диапазон
---и ронял масштаб поиска до 30% на десятки секунд — из-за этого скан
---"умирал" после пары промахов по движущейся цели.
function Rage.learnOrigin(accepted, magnitude)
	if type(magnitude) ~= "number" or magnitude < 0.3 then return end
	if accepted then
		Rage.originAccepted = math.max(Rage.originAccepted or 0, magnitude)
		Rage.originMissStreak = 0
	else
		Rage.originRejected = math.max(Rage.originRejected or 0, magnitude)
		Rage.originMissStreak = (Rage.originMissStreak or 0) + 1
	end
end

---Рабочий радиус поиска смещённого origin. Уважаем настройку и не
---схлопываемся от обычных промахов. Отдельно учитываем серверный потолок —
---он снижается только после серии отказов регистрации и медленно растёт.
local pingCache = { at = -1, ms = 60 }
function Rage.pingMs()
	local now = os.clock()
	if now - pingCache.at > 0.5 then
		pingCache.at = now
		pcall(function() pingCache.ms = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
	end
	return pingCache.ms
end

-- Extrapolation of an enemy by half the ping, used only at high ping and only for a target that really moves.
Rage.predictMinPing, Rage.predictMaxLead, Rage.predictMaxShift = 60, 0.2, 6
Rage.predictCache = setmetatable({}, { __mode = "k" })
Rage.predictParams = RaycastParams.new()
Rage.predictParams.FilterType = Enum.RaycastFilterType.Exclude

function Rage.predictCompute(entity, character, position, ping, now)
	local velocity = Ballistics.smoothVelocity(entity, position, now)
	if velocity.Magnitude <= 0 then return Vector3.zero end
	local offset = velocity * math.clamp(ping / 2000, 0, Rage.predictMaxLead)
	local length = offset.Magnitude
	if length < 0.1 then return Vector3.zero end
	if length > Rage.predictMaxShift then offset, length = offset.Unit * Rage.predictMaxShift, Rage.predictMaxShift end

	-- Do not push the point into geometry: stop short of the first solid thing on the way.
	local ignore = table.clone(Ballistics.ignoreList())
	if character then ignore[#ignore + 1] = character end
	Rage.predictParams.FilterDescendantsInstances = ignore
	local hit = workspaceService:Raycast(position, offset.Unit * (length + 0.4), Rage.predictParams)
	if hit and hit.Instance and hit.Instance.CanCollide and not Ballistics.isPassThrough(hit.Instance) then
		local free = (hit.Position - position).Magnitude - 0.4
		if free < 0.1 then return Vector3.zero end
		if free < length then offset = offset.Unit * free end
	end
	return offset
end

---Returns offset, moving, gated. gated is true when ping is high enough for prediction to apply at all.
-- Aim-point prediction stays off until it is proven not to double-count the lead bandit.
Rage.predictAim = false

function Rage.predictOffset(entity, character, position, fresh)
	if not (entity and typeof(position) == "Vector3") then return Vector3.zero, false, false end
	local ping = Rage.pingMs()
	if type(ping) ~= "number" or ping <= Rage.predictMinPing then return Vector3.zero, false, false end
	local now = os.clock()
	local cached = not fresh and Rage.predictCache[entity]
	if cached and now - cached.at < 0.05 then return cached.offset, cached.moving, true end
	local ok, offset = pcall(Rage.predictCompute, entity, character, position, ping, now)
	if not ok or typeof(offset) ~= "Vector3" then offset = Vector3.zero end
	local moving = offset.Magnitude > 0.1
	if not fresh then
		if cached then
			cached.at, cached.offset, cached.moving = now, offset, moving
		else
			Rage.predictCache[entity] = { at = now, offset = offset, moving = moving }
		end
	end
	return offset, moving, true
end

function Rage.originReach()
	local reach = math.clamp(tonumber(Neverlose.config.rage.originRange) or 8, 0.5, 16)
	if type(Rage.originCap) == "number" then reach = math.min(reach, Rage.originCap) end
	-- Until the server has shown what it accepts, shifts stay small.
	if Rage.shiftCap == nil then Rage.shiftCap, Rage.shiftCapAt = reach, os.clock() end

	local cap = Rage.shiftCap
	if type(cap) == "number" then
		if os.clock() - (Rage.shiftCapAt or 0) > 15 then
			cap = math.min(reach, cap + 0.5)
			Rage.shiftCap, Rage.shiftCapAt = cap, os.clock()
		end
		reach = math.min(reach, cap)
	end
	return math.clamp(reach, 0.5, 16)
end

---Серверный лимит сдвига. Считаем только промахи, похожие на отказ
---регистрации выстрела, а не разброс/предикт — иначе скан снова начнёт
---схлопываться от обычных миссов. После трёх таких отказов потолок
---опускается на 0.35 стада, после успешных выстрелов — поднимается.
local shiftRejectReasons = {
	["unregistered shot"] = true,
	["lag compensation"] = true,
	["direct shot not registered"] = true,
	["blocked by geometry"] = true,
	["desync"] = true,
}

function Rage.learnServerShift(accepted, reason, magnitude)
	if not Game.serverHits then return end
	local mag = tonumber(magnitude)
	if not mag or mag < 1 then return end
	if accepted then
		Rage.shiftStreak = 0
		local cap = Rage.shiftCap
		if type(cap) == "number" and mag >= cap - 0.6 then
			Rage.shiftCap = math.min(12, cap + 0.15)
			Rage.shiftCapAt = os.clock()
		end
		return
	end
	if not shiftRejectReasons[reason] then return end
	-- The configured radius is never lowered by rejections; only growth is learned.
	Rage.shiftStreak = (Rage.shiftStreak or 0) + 1
	if false then
		local cap = math.min(Rage.shiftCap or mag, mag) - 0.6
		Rage.shiftCap = math.max(1, cap)
		Rage.shiftStreak = 0
		Rage.shiftCapAt = os.clock()
		Logs.push("Combat", ("origin server cap {%.1f} st"):format(Rage.shiftCap))
	end
end

function Rage.originShifts()

	local scale = Rage.originScale or 1
	if scale < 1 then
		scale = math.min(1, scale + (os.clock() - (Rage.originScaleAt or os.clock())) * 0.2)
		Rage.originScale = scale
	end
	Rage.originScaleAt = os.clock()
	local reach = Rage.originReach() * scale
	local view = currentCamera.CFrame
	local right, up, look = view.RightVector, view.UpVector, view.LookVector
	local shifts = {}

	for _, scale in ipairs({ 0.45, 1 }) do
		local r = reach * scale
		for _, shift in ipairs({
			right * r, -right * r, up * r * 0.6, right * r * 0.6 + up * r * 0.5, -right * r * 0.6 + up * r * 0.5,
			look * r, (right + look) * r * 0.7, (-right + look) * r * 0.7,
		}) do
			shifts[#shifts + 1] = shift
		end
	end

	local velocity = Rage.selfVelocity
	if velocity then
		local flat = Vector3.new(velocity.X, 0, velocity.Z)
		if flat.Magnitude > 3 then
			if flat.Magnitude * 0.12 > reach * 1.5 then flat = flat.Unit * (reach * 1.5 / 0.12) end
			shifts[#shifts + 1] = flat * 0.06
			shifts[#shifts + 1] = flat * 0.12
		end
	end
	return shifts
end

function Rage.originShiftsFor(toward)
	local reach = Rage.originReach()
	local flat = Vector3.new(toward.X, 0, toward.Z)
	if flat.Magnitude < 0.1 then flat = Vector3.new(currentCamera.CFrame.LookVector.X, 0, currentCamera.CFrame.LookVector.Z) end
	local forward = flat.Magnitude > 0.01 and flat.Unit or Vector3.zAxis
	local side = Vector3.yAxis:Cross(forward)
	if side.Magnitude < 0.01 then side = Vector3.xAxis end
	side = side.Unit
	local up = Vector3.yAxis
	-- Полный круг по 12 азимутам на каждом радиусе + приподнятый круг и
	-- вертикаль. Раньше было 7 направлений (в основном вбок), из-за чего
	-- реальный край укрытия часто не находился.
	local shifts = {}
	local azimuths = 12
	for _, factor in ipairs({ 0.35, 0.6, 0.85, 1 }) do
		local r = reach * factor
		if r > 0.35 then
			for step = 0, azimuths - 1 do
				local angle = (step / azimuths) * math.pi * 2
				local dir = forward * math.cos(angle) + side * math.sin(angle)
				shifts[#shifts + 1] = dir * r
				if factor >= 0.6 then
					shifts[#shifts + 1] = (dir + up * 0.85).Unit * r
				end
			end
			shifts[#shifts + 1] = up * r
		end
	end
	return shifts
end

-- Origin scan: the zypdm | dumpf1x build's search for a clear point around the real origin, same order of candidates and checks.
-- FPS: per-character cache, long failure cache, 1.5 ms time budget per call (the scan resumes from where it stopped),
-- at most one fresh scan per scanAll (Rage.originBudget), free() is checked before the expensive lands() trace.
local scanCaches = setmetatable({}, { __mode = "k" })
local SCAN_BUDGET = 0.0015 -- seconds of wall time one originScan call may spend
local SCAN_FAIL_TTL = 0.5 -- a failed scan is trusted this long while camera and target barely moved
local scanParams = RaycastParams.new()
scanParams.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() scanParams.CollisionGroup = "Bullet" end)
scanParams.IgnoreWater = true
local scanOverlap = OverlapParams.new()
scanOverlap.FilterType = Enum.RaycastFilterType.Exclude
scanOverlap.MaxParts = 8

-- Путь реальная позиция -> origin: игрок обязан мог бы "дойти" до точки без стен.
-- Гипотеза: сервер сверяет Origin с позицией стрелка и/или трассирует от неё;
-- точка за стеной/полом — самый вероятный источник "direct shot not registered".
local pathParams = RaycastParams.new()
pathParams.FilterType = Enum.RaycastFilterType.Exclude
pathParams.IgnoreWater = true

function Rage.originReachable(real, point)
	local delta = point - real
	if delta.Magnitude < 0.05 then return true end
	local filter = {}
	for _, item in ipairs(Ballistics.ignoreList()) do filter[#filter + 1] = item end
	pathParams.FilterDescendantsInstances = filter
	for _ = 1, 6 do
		local result = workspaceService:Raycast(real, delta, pathParams)
		if not result then return true end
		local hit = result.Instance
		if hit.CanCollide and hit.Transparency < 0.9 then return false end
		filter[#filter + 1] = hit
		pathParams.FilterDescendantsInstances = filter
	end
	return false
end

function Rage.originScan(character, part, range, penetration, maxWalls)
	if not part or not part.Parent or not character then return nil end
	local config = Neverlose.config.rage
	local from = Game.origin()
	local aim = part.Position
	local toAim = aim - from
	local distance = toAim.Magnitude
	if distance < 0.5 then return nil end

	local radius = Rage.originReach()
	local scans = math.clamp(math.floor(tonumber(config.originScans) or 4), 1, 12)
	local mode = config.originScanMode or "optimized"

	radius = math.min(radius, math.max(distance * 0.85, 8.5))
	if radius < 0.5 then return nil end

	local rangeValue = tonumber(range) or 500
	local penValue = tonumber(penetration)
	local walls = tonumber(maxWalls) or 0
	local useLand = mode ~= "default"
	local now = os.clock()
	local cache = scanCaches[character]
	if not cache then
		cache = { at = 0 }
		scanCaches[character] = cache
	end

	-- Cheap exits first: a recent failure for (almost) the same camera and target stays a failure.
	local fromMoved = cache.from and (cache.from - from).Magnitude or math.huge
	if cache.failed and not cache.pos then
		local age = now - cache.at
		if (age < 0.15 and fromMoved < 2)
			or (age < SCAN_FAIL_TTL and fromMoved < 0.75 and cache.aim and (cache.aim - aim).Magnitude < 1) then
			return nil, "cached"
		end
	end
	local cacheOnly = (Rage.originBudget or 1) <= 0
	local retestPos = cache.pos and fromMoved < 2 and (now - cache.at < (cacheOnly and SCAN_FAIL_TTL or 0.15))
	if cacheOnly and not retestPos then return nil, "skipped" end

	local prepared = false
	local function prepare()
		if prepared then return end
		prepared = true
		local ignore = Ballistics.ignoreList()
		scanParams.FilterDescendantsInstances = ignore
		local overlapIgnore = {}
		for index = 1, #ignore do
			if ignore[index] then overlapIgnore[#overlapIgnore + 1] = ignore[index] end
		end
		overlapIgnore[#overlapIgnore + 1] = character
		scanOverlap.FilterDescendantsInstances = overlapIgnore
	end

	local function clear(point)
		local delta = aim - point
		if delta.Magnitude < 0.05 then return true end
		local result = workspaceService:Raycast(point, delta, scanParams)
		return result == nil or result.Instance == part or result.Instance:IsDescendantOf(character)
	end

	local function wallsOk(count)
		return count <= walls
	end

	local function lands(point)
		local delta = aim - point
		if delta.Magnitude < 0.05 then return true, 1 end
		local hits, reached, count = Ballistics.trace(point, delta.Unit, rangeValue, character, walls, penValue)
		return reached == true and wallsOk(count or 0), #hits
	end

	local function free(point)
		local parts = workspaceService:GetPartBoundsInRadius(point, 0.3, scanOverlap)
		for index = 1, #parts do
			local other = parts[index]
			if other.CanCollide and other.CanQuery and other.Transparency < 0.9 and not other:IsDescendantOf(character) then
				return false
			end
		end
		return true
	end

	-- Keep the shot origin from creeping right up to the target.
	local minGap = math.min(distance, 7)

	-- Same acceptance rule as before (clear+free, or lands+free); the point must be free in every branch,
	-- so the cheap free() runs before the expensive lands() trace and only once.
	local function test(point)
		if point ~= from and (aim - point).Magnitude < minGap then return nil end
		prepare()
		if mode == "precise" then
			if not free(point) then return nil end
			local ok, count = lands(point)
			return (ok and count > 0) and point or nil
		end
		if clear(point) then return free(point) and point or nil end
		if useLand and free(point) then
			local ok = lands(point)
			if ok then return point end
		end
		return nil
	end

	-- The shifted origin must be walkable from the real position, not through a wall or floor.
	local baseTest = test
	test = function(point)
		local result = baseTest(point)
		if result and result ~= from and not Rage.originReachable(from, result) then return nil end
		return result
	end

	if retestPos then
		if test(cache.pos) then
			cache.at = now
			cache.aim = aim
			return cache.pos
		end
		if cacheOnly then return nil, "skipped" end
	end

	Rage.originBudget = (Rage.originBudget or 1) - 1

	local forward = toAim.Unit
	local side = forward:Cross(Vector3.new(0, 1, 0))
	if side.Magnitude < 0.01 then side = forward:Cross(Vector3.new(1, 0, 0)) end
	side = side.Unit
	local up = side:Cross(forward).Unit

	-- Candidate list in the original order (from, rings, lift, near cluster); inside a ring the sideways
	-- directions (peek left/right) go first, then up/down, then the diagonals.
	local list = { from }
	local rings = { 0.35, 0.6, 0.8, 1 }
	local steps = math.max(scans, 8)
	local order, used = {}, {}
	for _, step in ipairs({ 0, steps // 2, steps // 4, (steps * 3) // 4 }) do
		if not used[step] then used[step] = true order[#order + 1] = step end
	end
	for step = 0, steps - 1 do
		if not used[step] then used[step] = true order[#order + 1] = step end
	end
	for ringIndex = 1, #rings do
		local ringRadius = math.max(radius * rings[ringIndex], 1)
		for _, step in ipairs(order) do
			local angle = (step / steps) * 2 * math.pi
			list[#list + 1] = from + (side * math.cos(angle) + up * math.sin(angle)) * ringRadius
		end
	end
	local lift = math.min(radius * 0.5, 2.5)
	list[#list + 1] = from + Vector3.new(0, lift, 0)
	list[#list + 1] = from - Vector3.new(0, lift, 0)
	-- High and sideways reach: over cover and around corners, for an enemy that hides behind his own shift.
	local sky = Vector3.new(0, 1, 0)
	list[#list + 1] = from + sky * radius * 0.6
	list[#list + 1] = from + sky * radius
	list[#list + 1] = from + sky * radius * 0.6 + side * radius * 0.6
	list[#list + 1] = from + sky * radius * 0.6 - side * radius * 0.6
	list[#list + 1] = from + side * radius
	list[#list + 1] = from - side * radius
	list[#list + 1] = from + sky * radius * 0.35 + side * radius
	list[#list + 1] = from + sky * radius * 0.35 - side * radius
	local near = math.max(radius * 0.24, 1.5)
	local mid = math.max(radius * 0.36, 2.5)
	local far = math.max(radius * 0.5, 3.5)
	list[#list + 1] = from + forward * near
	list[#list + 1] = from + forward * near + side * mid
	list[#list + 1] = from + forward * near - side * mid
	list[#list + 1] = from + forward * mid + side * near
	list[#list + 1] = from + forward * mid - side * near
	list[#list + 1] = from + forward * mid
	list[#list + 1] = from + side * far
	list[#list + 1] = from - side * far
	list[#list + 1] = from + forward * far

	-- Resume an interrupted scan of the same target instead of restarting from candidate 1.
	local startIndex = 1
	if cache.cursor and cache.cursorFrom and now - (cache.cursorAt or 0) < 0.35 and (cache.cursorFrom - from).Magnitude < 1 then
		startIndex = math.min(cache.cursor, #list)
	end
	cache.cursor = nil

	local deadline = now + SCAN_BUDGET
	local found
	local index = startIndex
	local visited = 0
	while visited < #list do
		found = test(list[index])
		if found then break end
		visited += 1
		index = index % #list + 1
		if visited < #list and os.clock() > deadline then
			cache.cursor, cache.cursorAt, cache.cursorFrom = index, os.clock(), from
			cache.from, cache.aim, cache.pos, cache.failed = from, aim, nil, false
			cache.at = os.clock()
			return nil, "partial"
		end
	end

	if found then
		cache.at, cache.from, cache.aim, cache.pos, cache.failed = os.clock(), from, aim, found, false
	else
		cache.at, cache.from, cache.aim, cache.pos, cache.failed = os.clock(), from, aim, nil, true
	end
	return found
end

Rage.threat, Rage.suspect = {}, {}

---Debug-модель origin.
---Над головой парит Saturn с 2 кольцами. На каждый выстрел: тонкая линия
---голова -> origin рисуется плавно с задержкой 0.15 с, затем линия origin -> враг
---(с задержкой 0.8 с). В точке origin появляется свой Saturn. Через 2.5 с всё
---плавно гаснет. Неудачные попытки рисуются красным.
do
	local SEGMENTS, RING_RADIUS = 32, 0.5
	local blue = Color3.fromRGB(40, 130, 255)
	local white = Color3.fromRGB(255, 255, 255)
	local red = Color3.fromRGB(255, 80, 80)
	local HOLD, FADE = 2.5, 0.6
	local LIFE = HOLD + FADE
	local LINE_A = { start = 0.15, time = 0.5 }
	local LINE_B = { start = 0.8, time = 0.5 }
	local MAX_TRACES = 5

	Rage.debugModel = { hover = nil, traces = {}, at = 0, lastShot = 0, lastFail = 0, pos = nil }

	local function unseen(size)
		return newInstance("Part", {
			Name = randomName(), Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
			CastShadow = false, Massless = true, Locked = true, Transparency = 1, Size = Vector3.one * (size or 0.1), Parent = effectsFolder,
		})
	end

	local function destroyPart(part)
		if part then pcall(function() part:Destroy() end) end
	end

	-- Одно кольцо: точки по окружности на якоре, соединённые Beam-ами в замкнутый контур.
	local function makeRing(tiltDeg, speed, color)
		local anchor = unseen()
		local attachments = {}
		for index = 1, SEGMENTS do
			local angle = (index / SEGMENTS) * math.pi * 2
			attachments[index] = newInstance("Attachment", {
				Position = Vector3.new(math.cos(angle) * RING_RADIUS, 0, math.sin(angle) * RING_RADIUS),
			}, anchor)
		end
		local beams = {}
		for index = 1, SEGMENTS do
			local nextIndex = index % SEGMENTS + 1
			local t0 = 0.5 + 0.5 * math.sin((index / SEGMENTS) * math.pi * 2)
			local t1 = 0.5 + 0.5 * math.sin((nextIndex / SEGMENTS) * math.pi * 2)
			beams[index] = newInstance("Beam", {
				Attachment0 = attachments[index], Attachment1 = attachments[nextIndex],
				FaceCamera = true, Segments = 1, Width0 = 0.035, Width1 = 0.035,
				LightEmission = 0.85, LightInfluence = 0, Enabled = false,
				Color = ColorSequence.new(color:Lerp(white, t0), color:Lerp(white, t1)),
				Transparency = NumberSequence.new(1),
			}, effectsFolder)
		end
		return { anchor = anchor, beams = beams, tilt = math.rad(tiltDeg), speed = speed, angle = 0 }
	end

	-- Saturn: шар + два кольца под разными наклонами и скоростями.
	local function newSaturn(color, size)
		local sphere = unseen(size * 2)
		sphere.Shape = Enum.PartType.Ball
		sphere.Material = Enum.Material.Neon
		sphere.Color = color
		return {
			sphere = sphere, size = size, color = color,
			rings = { makeRing(24, 1.0, color), makeRing(-58, -0.7, color) },
		}
	end

	local function destroySaturn(saturn)
		if not saturn then return end
		destroyPart(saturn.sphere)
		for _, ring in ipairs(saturn.rings) do
			destroyPart(ring.anchor)
			for _, beam in ipairs(ring.beams) do destroyPart(beam) end
		end
	end

	local function setSaturn(saturn, pos, dt, alpha, now)
		saturn.sphere.CFrame = CFrame.new(pos)
		saturn.sphere.Size = Vector3.one * (saturn.size * 2 * (0.96 + 0.04 * math.sin(now * 3)))
		saturn.sphere.Transparency = math.clamp(1 - alpha * 0.85, 0, 1)
		local transparency = NumberSequence.new(1 - alpha * 0.9)
		local show = alpha > 0.02
		for _, ring in ipairs(saturn.rings) do
			ring.angle = ring.angle + ring.speed * dt
			ring.anchor.CFrame = CFrame.new(pos) * CFrame.Angles(ring.tilt, ring.angle, 0)
			for _, beam in ipairs(ring.beams) do
				beam.Enabled = show
				beam.Transparency = transparency
			end
		end
	end

	--------------------------------------------------------------------
	-- Self Avatar: копия модели игрока как маркер origin.
	-- Клонировать персонажа на каждый выстрел дорого, поэтому держим пул
	-- из AVATAR_POOL готовых копий и переиспользуем их.
	--------------------------------------------------------------------
	local AVATAR_POOL, AVATAR_SCALE = 3, 0.75
	local avatarPool = { models = {}, character = nil }

	local function buildAvatar(character)
		local ok, model = pcall(function()
			character.Archivable = true
			for _, object in ipairs(character:GetDescendants()) do object.Archivable = true end
			return character:Clone()
		end)
		if not ok or not model then return nil end

		local parts, base = {}, {}
		for _, item in ipairs(model:GetDescendants()) do
			if item:IsA("BasePart") then
				item.Anchored = true
				item.CanCollide, item.CanQuery, item.CanTouch = false, false, false
				item.CastShadow = false
				item.Massless = true
				parts[#parts + 1] = item
				base[item] = item.Transparency
			elseif item:IsA("Humanoid") or item:IsA("Script") or item:IsA("LocalScript") or item:IsA("ModuleScript") then
				-- без Humanoid и скриптов копия стоит на месте и не анимируется
				item:Destroy()
			end
		end
		if #parts == 0 then
			model:Destroy()
			return nil
		end

		model.Name = randomName()
		model.Parent = effectsFolder
		pcall(function() model:ScaleTo(AVATAR_SCALE) end)

		local force = newInstance("ForceField", { Visible = true }, model)
		local highlight
		pcall(function()
			highlight = newInstance("Highlight", {
				FillTransparency = 1, OutlineTransparency = 1,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = model,
			})
		end)

		local height = AVATAR_SCALE * 4.8
		pcall(function() height = model:GetExtentsSize().Y end)

		return {
			model = model, parts = parts, base = base, force = force, highlight = highlight,
			offset = height * 0.35, busy = false,
		}
	end

	local function resetAvatar(entry)
		entry.busy = false
		if entry.highlight then
			entry.highlight.Enabled = false
			entry.highlight.FillTransparency = 1
			entry.highlight.OutlineTransparency = 1
		end
		entry.force.Visible = false
		for _, part in ipairs(entry.parts) do part.Transparency = 1 end
	end

	local function acquireAvatar(character)
		local pool = avatarPool
		if pool.character ~= character then
			for _, entry in ipairs(pool.models) do
				pcall(function() entry.model:Destroy() end)
			end
			pool.models, pool.character = {}, character
		end
		for _, entry in ipairs(pool.models) do
			if not entry.busy then return entry end
		end
		if #pool.models >= AVATAR_POOL then return nil end
		local entry = buildAvatar(character)
		if not entry then return nil end
		pool.models[#pool.models + 1] = entry
		return entry
	end

	local function newMarker(color, origin)
		local mode = Neverlose.config.rage.originModel or "Saturn"
		-- Вплотную к камере копия игрока закрыла бы весь экран, поэтому
		-- при сдвиге меньше 1.2 стада остаётся Saturn.
		if mode == "Self Avatar" and (not origin or (origin - Game.origin()).Magnitude >= 0.5) then
			local character = Game.localCharacter()
			local entry = character and acquireAvatar(character)
			if entry then
				entry.busy = true
				return { kind = "avatar", entry = entry, color = color }
			end
		end
		return { kind = "saturn", saturn = newSaturn(color, 0.2) }
	end

	local function updateMarker(marker, pos, dt, alpha, now)
		if marker.kind == "saturn" then
			setSaturn(marker.saturn, pos, dt, alpha, now)
			return
		end

		local entry = marker.entry
		local cameraPos = currentCamera.CFrame.Position
		pcall(function()
			entry.model:PivotTo(CFrame.lookAt(pos - Vector3.new(0, entry.offset, 0), cameraPos))
		end)

		local fade = math.clamp(alpha, 0, 1)
		for _, part in ipairs(entry.parts) do
			-- Полупрозрачный призрак: при fade = 1 модель не перекрывает обзор.
			local base = math.max(entry.base[part] or 0, 0.5)
			part.Transparency = math.clamp(base + (1 - base) * (1 - fade), 0, 1)
		end
		local highlight = entry.highlight
		if highlight then
			highlight.FillColor, highlight.OutlineColor = marker.color, marker.color
			highlight.FillTransparency = math.clamp(1 - fade * 0.55, 0, 1)
			highlight.OutlineTransparency = math.clamp(1 - fade, 0, 1)
			highlight.Enabled = fade > 0.02
		end
		entry.force.Visible = fade > 0.02
	end

	local function destroyMarker(marker)
		if marker.kind == "saturn" then
			destroySaturn(marker.saturn)
			return
		end
		if marker.entry then resetAvatar(marker.entry) end
	end

	-- Тонкая линия: конец уезжает от начала, пока g не станет 1.
	local function newLine(color)
		local pa, pb = unseen(), unseen()
		local beam = newInstance("Beam", {
			Attachment0 = newInstance("Attachment", {}, pa), Attachment1 = newInstance("Attachment", {}, pb),
			FaceCamera = true, Segments = 1, Width0 = 0.012, Width1 = 0.012, LightEmission = 0.7, LightInfluence = 0,
			Color = ColorSequence.new(color, white), Transparency = NumberSequence.new(1), Enabled = false,
		}, effectsFolder)
		return { pa = pa, pb = pb, beam = beam }
	end

	local function destroyLine(line)
		destroyPart(line.pa)
		destroyPart(line.pb)
		destroyPart(line.beam)
	end

	local function progress(age, spec)
		local g = math.clamp((age - spec.start) / spec.time, 0, 1)
		return g * g * (3 - 2 * g)
	end

	local function paintLine(line, a, b, g, alpha)
		if not a or not b or (b - a).Magnitude < 0.05 or g <= 0 or alpha < 0.02 then
			line.beam.Enabled = false
			return
		end
		line.pa.CFrame = CFrame.new(a)
		line.pb.CFrame = CFrame.new(a:Lerp(b, g))
		line.beam.Transparency = NumberSequence.new(1 - alpha * 0.85)
		line.beam.Enabled = true
	end

	local function newTrace(from, origin, aim, color, now)
		return {
			born = now, from = from, origin = origin, aim = aim,
			lineA = newLine(color), lineB = newLine(color),
			marker = newMarker(color, origin),
		}
	end

	local function destroyTrace(trace)
		destroyLine(trace.lineA)
		destroyLine(trace.lineB)
		destroyMarker(trace.marker)
	end

	local function updateTrace(trace, now, dt)
		local age = now - trace.born
		local alpha = 1 - math.clamp((age - HOLD) / FADE, 0, 1)
		local pop = math.clamp(age / 0.3, 0, 1)
		updateMarker(trace.marker, trace.origin, dt, alpha * pop, now)
		paintLine(trace.lineA, trace.from, trace.origin, progress(age, LINE_A), alpha)
		paintLine(trace.lineB, trace.origin, trace.aim, progress(age, LINE_B), alpha)
	end

	local function clearAll()
		local dbg = Rage.debugModel
		for index = #dbg.traces, 1, -1 do
			destroyTrace(dbg.traces[index])
			dbg.traces[index] = nil
		end
		if dbg.hover then
			destroySaturn(dbg.hover)
			dbg.hover = nil
		end
	end

	local function addTrace(from, origin, aim, color, now)
		local dbg = Rage.debugModel
		-- В режиме Self Avatar пул моделей ограничен, лишние трейсы
		-- остались бы без маркера.
		local limit = (Neverlose.config.rage.originModel or "Saturn") == "Self Avatar" and AVATAR_POOL or MAX_TRACES
		if #dbg.traces >= limit then
			destroyTrace(table.remove(dbg.traces, 1))
		end
		dbg.traces[#dbg.traces + 1] = newTrace(from, origin, aim, color, now)
	end

	function Rage.updateDebug()
		local config = Neverlose.config.rage
		local dbg = Rage.debugModel
		local character = config.originDebug and Game.localCharacter()
		if not character then
			clearAll()
			return
		end

		local mode = config.originModel or "Saturn"
		if dbg.mode ~= mode then
			if dbg.mode then clearAll() end
			dbg.mode = mode
		end

		local now = os.clock()
		local dt = math.min(now - dbg.at, 0.1)
		if dt < 0.012 then return end
		dbg.at = now

		local headPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
		if not headPart then return end
		local head = headPart.Position + Vector3.new(0, 0.4, 0)

		-- Saturn над головой: парит, покачивается, плавно догоняет игрока.
		if not dbg.hover then dbg.hover = newSaturn(blue, 0.3) end
		local hover = head + Vector3.new(math.sin(now * 1.3) * 0.15, 2.9 + math.sin(now * 2.1) * 0.12, math.cos(now * 0.9) * 0.15)
		if not dbg.pos or (dbg.pos - hover).Magnitude > 4 then dbg.pos = hover end
		dbg.pos = dbg.pos:Lerp(hover, 1 - math.exp(-dt * 7))
		setSaturn(dbg.hover, dbg.pos, dt, 0.9, now)

		-- Новый выстрел или неудачная попытка -> новый трейсер.
		local shot = Rage.shotDebug
		if shot and shot.at ~= dbg.lastShot then
			dbg.lastShot = shot.at
			if shot.origin and shot.aim then addTrace(head, shot.origin, shot.aim, blue, now) end
		end
		local fail = Rage.aimFail
		if fail and fail.at ~= dbg.lastFail then
			dbg.lastFail = fail.at
			if fail.origin and fail.aim then addTrace(head, fail.origin, fail.aim, red, now) end
		end

		for index = #dbg.traces, 1, -1 do
			local trace = dbg.traces[index]
			if now - trace.born > LIFE then
				destroyTrace(trace)
				table.remove(dbg.traces, index)
			else
				updateTrace(trace, now, dt)
			end
		end
	end
end

maid:give(runService.RenderStepped:Connect(function()
	pcall(Rage.updateDebug)
end))

function Rage.threatOf(entity)
	local record = Rage.threat[entity]
	if not record then return 0 end
	return record.value * 0.5 ^ ((os.clock() - record.at) / 40)
end

function Rage.addThreat(entity, amount)
	Rage.threat[entity] = { value = math.min(Rage.threatOf(entity) + amount, 8), at = os.clock() }
end

---Angle in degrees between where an enemy looks and the direction to the local player.
function Rage.aimAngle(character, target)
	local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	if not head then return nil end
	local toward = target - head.Position
	if toward.Magnitude < 0.5 then return nil end
	local dot = math.clamp(head.CFrame.LookVector:Dot(toward.Unit), -1, 1)
	return math.deg(math.acos(dot)), toward.Magnitude, head.Position
end

---Watch who points at the local player; aiming through a wall marks a suspected cheater.
do
	local lastTick = 0
	local aimedAt = {}
	maid:give(runService.Heartbeat:Connect(function()
		local config = Neverlose.config.rage
		if not config.enabled or false then return end
		local now = os.clock()
		if now - lastTick < 0.25 then return end
		lastTick = now
		local mine = Game.localCharacter()
		local head = mine and (mine:FindFirstChild("Head") or mine:FindFirstChild("HumanoidRootPart"))
		if not head then return end
		for _, entity in ipairs(Game.entities()) do
			if Game.isEnemy(entity, true) then
				local character = Game.character(entity)
				if character and not Game.isImmune(character) then
					local angle, distance, from = Rage.aimAngle(character, head.Position)
					if angle and distance < 160 and angle < 7 then
						local _, _, walls = Ballistics.trace(from, (head.Position - from).Unit, math.max(distance - 0.8, 0.5), nil, 8)
						if walls == 0 then
							Rage.addThreat(entity, 0.3)
							aimedAt[entity] = 0
						elseif angle < 3.5 then
							aimedAt[entity] = (aimedAt[entity] or 0) + 1
							if aimedAt[entity] >= 4 then
								Rage.suspect[entity] = now
								Rage.addThreat(entity, 0.4)
							end
						end
					else
						aimedAt[entity] = 0
					end
				end
			end
		end
	end))
end

Events.on("localHurt", function(damage, died)
	local mine = Game.localCharacter()
	local head = mine and (mine:FindFirstChild("Head") or mine:FindFirstChild("HumanoidRootPart"))
	if not head then return end
	local best, bestAngle = nil, 25
	for _, entity in ipairs(Game.entities()) do
		if Game.isEnemy(entity, true) then
			local character = Game.character(entity)
			if character and not Game.isImmune(character) then
				local angle, distance = Rage.aimAngle(character, head.Position)
				if angle and angle < bestAngle and distance < 400 then best, bestAngle = entity, angle end
			end
		end
	end
	if not best then return end
	local amount = 2 + math.min(damage / 25, 3) + (died and 4 or 0)
	local character = Game.character(best)
	local _, distance, from = Rage.aimAngle(character, head.Position)
	if from then
		local _, _, walls = Ballistics.trace(from, (head.Position - from).Unit, math.max((distance or 50) - 0.8, 0.5), nil, 8)
		if walls > 0 then
			Rage.suspect[best] = os.clock()
			amount += 2
		end
	end
	Rage.addThreat(best, amount)
	if os.clock() - (Rage.threatLogAt or 0) > 3 then
		Rage.threatLogAt = os.clock()
		Logs.push("Combat", ("priority target: {%s}%s"):format(tostring(best.DisplayName or best.Name), Rage.suspect[best] and " (hit through cover)" or ""))
	end
end)

---Cheap pre-filter: skip enemies that are out of range or far outside the aim FOV.
function Rage.inReach(character, origin, range, fovPixels)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return true end
	if (root.Position - origin).Magnitude > range + 6 then return false end
	if fovPixels ~= math.huge then
		local pixels = screenDistance(root.Position)
		if not pixels or pixels > fovPixels * 1.7 + 120 then return false end
	end
	return true
end

-- Wall search: Wall Spot / Adaptive Rays / View Priority / Wall Hug / Deep Sweep (порт с версии коллеги).
-- Вызывается из scanAll только когда цель не найдена или идёт через стену; всё под временным бюджетом и кэшем.
local SWEEP_GRID = {}
do
	local axis = { 0, -0.38, 0.38, -0.19, 0.19 }
	for _, y in ipairs(axis) do
		for _, x in ipairs(axis) do
			for _, z in ipairs({ 0, -0.3, 0.3 }) do
				SWEEP_GRID[#SWEEP_GRID + 1] = Vector3.new(x, y, z)
			end
		end
	end
end
local SWEEP_PARTS = { "Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg" }
local VIEW_PARTS = { "Head", "UpperTorso", "LowerTorso", "LeftUpperLeg", "RightUpperLeg" }
Rage.wallMemo = setmetatable({}, { __mode = "k" })

---Суммарная толщина стен вдоль трассы (вход -> выход по тому же инстансу), без лишних лучей.
function Rage.wallCost(hits)
	local cost, entries = 0, nil
	for _, hit in ipairs(hits or {}) do
		local instance = hit.Instance
		if instance then
			if hit.Exit then
				local entry = entries and entries[instance]
				if entry then cost += (hit.Position - entry).Magnitude end
			else
				entries = entries or {}
				entries[instance] = hit.Position
			end
		end
	end
	return cost
end

local function pathBetter(a, b)
	if not b then return true end
	local wa, wb = a.walls or 0, b.walls or 0
	if wa ~= wb then return wa < wb end
	local ca, cb = a.cost or 0, b.cost or 0
	if math.abs(ca - cb) > 0.05 then return ca < cb end
	return (a.damage or 0) > (b.damage or 0)
end

local function sideBasis(dir)
	local side = dir:Cross(Vector3.new(0, 1, 0))
	if side.Magnitude < 0.01 then side = dir:Cross(Vector3.new(1, 0, 0)) end
	side = side.Unit
	return side, side:Cross(dir).Unit
end

---env: entity, character, partNames, evaluate, origin, config, seenByCam, boost, deadline, spotRadius, multiRay.
---Возвращает лучший путь с меньшим числом стен/толщиной или nil, если улучшить не вышло.
function Rage.searchWalls(env, chosen)
	local config, entity, character, evaluate, origin = env.config, env.entity, env.character, env.evaluate, env.origin
	local now = os.clock()
	local root = character:FindFirstChild("HumanoidRootPart")
	local rootPos = root and root.Position or Vector3.zero
	local memo = Rage.wallMemo[entity]
	local best = chosen

	-- Найденный раньше путь проверяем одним вызовом: цель не дёргается между сканами.
	if memo and memo.part and memo.part.Parent and now - memo.at < 0.6 then
		local ok, point = pcall(function() return memo.part.CFrame:PointToWorldSpace(memo.loc) end)
		if ok then
			local cached = evaluate(entity, character, memo.part, point, nil, memo.from)
			if cached then
				if memo.from then cached.origin = memo.from end
				if pathBetter(cached, best) then best = cached end
			end
		end
	end
	local recent = memo and now - memo.searchedAt < 0.25 and (memo.root - rootPos).Magnitude < 1.5 and (memo.from0 - origin).Magnitude < 1.5
	if recent or (best and (best.walls or 0) <= 0) then return best ~= chosen and best or nil end

	local stop = math.min(env.deadline, now + env.slice)
	local function out() return os.clock() > stop end
	local function open() return best ~= nil and (best.walls or 0) <= 0 end
	local function consider(other)
		if other and pathBetter(other, best) then best = other end
	end

	local seedPart = best and best.part or nil
	if not (seedPart and seedPart.Parent) then
		seedPart = nil
		for _, name in ipairs(env.partNames) do
			seedPart = character:FindFirstChild(name)
			if seedPart then break end
		end
		seedPart = seedPart or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Head")
	end
	if not (seedPart and seedPart.Parent) then return nil end
	local seedPoint = best and best.position or seedPart.Position
	local line = seedPoint - origin
	if line.Magnitude < 1 then return nil end
	local dir = line.Unit
	local side, up = sideBasis(dir)
	local reach = Rage.originReach()
	local shifts = config.originScan == true

	-- Wall Spot (кольца) + Adaptive Rays (уточнение): точки вокруг лучшей, ищем тонкое место стены.
	if config.spotFind == true or config.adaptiveRays == true then
		local spot = config.spotFind == true
		local smallest = math.min(seedPart.Size.X, seedPart.Size.Y, seedPart.Size.Z)
		local radius = math.clamp(env.spotRadius, 0.05, smallest * 0.45)
		local rings = spot and 3 or 1
		local total = math.max(env.multiRay - 1, spot and 4 or 1)
		local perRing = math.max(1, math.ceil(total / rings))
		for ring = 1, rings do
			if open() or out() then break end
			for ray = 1, perRing do
				local angle = ((ray - 1) / perRing) * math.pi * 2 + (ring % 2 == 0 and 0.5 / perRing * math.pi * 2 or 0)
				consider(evaluate(entity, character, seedPart, seedPoint + (side * math.cos(angle) + up * math.sin(angle)) * (radius * ring / rings), nil))
				if open() or out() then break end
			end
		end
		if config.adaptiveRays == true and best and (best.walls or 0) > 0 and best.part and best.part.Parent and not out() then
			local center, refine = best.position, math.max(radius * 0.4, 0.03)
			local refinePart = best.part
			for ray = 1, 12 do
				local angle = (ray - 1) / 12 * math.pi * 2 + 0.19
				consider(evaluate(entity, character, refinePart, center + (side * math.cos(angle) + up * math.sin(angle)) * refine, nil))
				if open() or out() then break end
			end
		end
	end

	-- View Origin: камера видит цель, а выстрел с обычного origin закрыт — пробуем точки между origin и камерой.
	if env.seenByCam and shifts and config.wallHug == true and not open() and not out() then
		local camPos = currentCamera.CFrame.Position
		local focus = best and best.position or seedPart.Position
		if (focus - camPos).Magnitude > 1 then
			local unit = (focus - camPos).Unit
			local candidates = {
				camPos, camPos + unit * 0.3, camPos + unit * 0.6,
				origin:Lerp(camPos, 0.9) + unit * 0.3, origin:Lerp(camPos, 0.75), origin:Lerp(camPos, 0.5), origin:Lerp(camPos, 0.25),
			}
			for _, from in ipairs(candidates) do
				if out() then break end
				if (from - origin).Magnitude <= reach and Rage.originClear(from) and Rage.originReachable(origin, from) then
					for _, name in ipairs(VIEW_PARTS) do
						local part = character:FindFirstChild(name)
						if part and part.Parent then
							local viewed = evaluate(entity, character, part, part.Position, nil, from)
							if viewed then
								viewed.origin = from
								consider(viewed)
							end
						end
					end
					if open() then break end
				end
			end
		end
	end

	-- Deep Sweep: сетка внутренних точек по телу, берём путь с минимумом стен и толщины.
	if config.deepSweep == true and not open() and not out() then
		local limit = math.clamp(env.multiRay * 8 * env.boost, 24, 240)
		local perPart = math.max(4, math.floor(limit / #SWEEP_PARTS))
		for _, name in ipairs(SWEEP_PARTS) do
			local sweepPart = character:FindFirstChild(name)
			if sweepPart and sweepPart.Parent then
				local size, cf = sweepPart.Size, sweepPart.CFrame
				for index = 1, perPart do
					local offset = SWEEP_GRID[((index - 1) * 7) % #SWEEP_GRID + 1]
					consider(evaluate(entity, character, sweepPart, cf:PointToWorldSpace(size * offset), nil))
					if open() or out() then break end
				end
			end
			if open() or out() then break end
		end
	end

	-- Wall Spot (сдвиг origin): точка прицела та же, origin уходит вбок/вверх вдоль стены.
	if config.spotFind == true and shifts and best and (best.walls or 0) > 0 and not best.record and not out()
		and ((best.cost or 0) == 0 or (best.cost or 0) >= 0.5) and best.part and best.part.Parent and best.position then
		local slidePart, slidePoint = best.part, best.position
		local bline = slidePoint - origin
		if bline.Magnitude > 0.5 then
			local bside, bup = sideBasis(bline.Unit)
			local slide = math.clamp(env.spotRadius, 0.2, 0.85)
			local dirs = {
				bside, -bside, bup * 0.7, -bup * 0.7,
				(bside + bup).Unit * 0.8, (bside - bup).Unit * 0.8, (-bside + bup).Unit * 0.8, (-bside - bup).Unit * 0.8,
			}
			for _, scale in ipairs({ 1, 2, 3.2 }) do
				local step = math.min(slide * scale, 3.5, reach)
				for _, direction in ipairs(dirs) do
					if out() then break end
					local from = origin + direction * step
					if Rage.originClear(from) and Rage.originReachable(origin, from) then
						local other = evaluate(entity, character, slidePart, slidePoint, nil, from)
						if other then
							other.origin = from
							consider(other)
						end
					end
					if open() then break end
				end
				if open() or out() then break end
			end
		end
	end

	-- Wall Hug: origin вплотную к стене и к кромкам блока, с каждой точки проверяем несколько частей тела.
	if config.wallHug == true and shifts and not open() and not out() then
		local baseFrom = best and best.origin or origin
		local hugPoint = best and best.position or seedPart.Position
		local baseLine = hugPoint - baseFrom
		local dist = baseLine.Magnitude
		if dist > 1 then
			local hdir = baseLine.Unit
			local hside, hup = sideBasis(hdir)
			local gap = 0.4
			local step = math.clamp(env.spotRadius, 0.3, 0.85)
			local tried, probes = {}, { { 0, 0 } }
			local order, seenName = {}, {}
			for _, name in ipairs({ seedPart.Name, "Head", "UpperTorso", "LowerTorso" }) do
				if not seenName[name] then seenName[name] = true order[#order + 1] = name end
			end
			local hugBest

			-- Кромки блока в плоскости origin: куда сдвинуть origin, чтобы луч прошёл по краю или мимо блока.
			local function addEdges(blocker)
				local cf, size = blocker.CFrame, blocker.Size
				local minS, maxS, minU, maxU = math.huge, -math.huge, math.huge, -math.huge
				local valid = 0
				for sx = -1, 1, 2 do
					for sy = -1, 1, 2 do
						for sz = -1, 1, 2 do
							local w = cf:PointToWorldSpace(Vector3.new(sx * size.X, sy * size.Y, sz * size.Z) * 0.5) - baseFrom
							local f = w:Dot(hdir) / dist
							if f > 0.02 and f < 0.97 then
								local k = 1 / (1 - f)
								local s, u = w:Dot(hside) * k, w:Dot(hup) * k
								minS, maxS = math.min(minS, s), math.max(maxS, s)
								minU, maxU = math.min(minU, u), math.max(maxU, u)
								valid += 1
							end
						end
					end
				end
				if valid < 4 then return end
				for _, inset in ipairs({ -0.3, 0.15, 0.4 }) do
					probes[#probes + 1] = { maxS - inset, 0 }
					probes[#probes + 1] = { minS + inset, 0 }
					probes[#probes + 1] = { 0, maxU - inset }
					probes[#probes + 1] = { 0, minU + inset }
				end
			end

			local blockers, count = {}, 0
			local preHits = Ballistics.traceLocal(baseFrom, hdir, dist + 2, character, 16)
			for _, hit in ipairs(preHits) do
				local blocker = hit.Instance
				if not hit.Exit and blocker and not blockers[blocker] and not blocker:IsDescendantOf(character) then
					blockers[blocker] = true
					addEdges(blocker)
					count += 1
					if count >= 3 then break end
				end
			end
			for _, grid in ipairs({
				{ step, 0 }, { -step, 0 }, { 0, step * 0.8 }, { 0, -step * 0.8 },
				{ step * 2, 0 }, { -step * 2, 0 }, { step, step * 0.8 }, { -step, step * 0.8 },
				{ step, -step * 0.8 }, { -step, -step * 0.8 }, { step * 3, 0 }, { -step * 3, 0 },
			}) do
				probes[#probes + 1] = grid
			end

			local function tryCandidate(point)
				for _, seen in ipairs(tried) do
					if (seen - point).Magnitude < 0.15 then return end
				end
				if (point - origin).Magnitude > reach or not Rage.originClear(point) or not Rage.originReachable(origin, point) then return end
				tried[#tried + 1] = point
				for _, name in ipairs(order) do
					local part = character:FindFirstChild(name)
					if part and part.Parent then
						local hugged = evaluate(entity, character, part, (part == seedPart) and hugPoint or part.Position, nil, point)
						if hugged then
							hugged.origin = point
							if pathBetter(hugged, hugBest) then hugBest = hugged end
						end
					end
				end
			end

			for _, probe in ipairs(probes) do
				if out() then break end
				local moved = probe[1] ~= 0 or probe[2] ~= 0
				if math.sqrt(probe[1] * probe[1] + probe[2] * probe[2]) <= reach then
					local start = baseFrom + hside * probe[1] + hup * probe[2]
					local toSeed = hugPoint - start
					if toSeed.Magnitude > 1 and (not moved or Rage.originClear(start)) then
						if moved then tryCandidate(start) end
						local first
						for _, hit in ipairs(Ballistics.traceLocal(start, toSeed.Unit, toSeed.Magnitude + 2, character, 16)) do
							if not hit.Exit then first = hit break end
						end
						if first and first.Instance and not first.Instance:IsDescendantOf(character) then
							tryCandidate(first.Position - toSeed.Unit * gap)
						end
					end
				end
				if hugBest and (hugBest.walls or 0) <= 0 then break end
			end
			if hugBest then consider(hugBest) end
		end
	end

	local found = best ~= chosen and best or nil
	local entry = { at = now, searchedAt = now, root = rootPos, from0 = origin }
	if found and found.part and found.part.Parent and found.position then
		entry.part = found.part
		entry.loc = found.part.CFrame:PointToObjectSpace(found.position)
		entry.from = found.origin
	end
	Rage.wallMemo[entity] = entry
	return found
end

function Rage.scanAll(weapon, partNames, multipointSet, fovDegrees)
	local config = Neverlose.config.rage
	local properties = weapon.Properties
	local origin = Game.origin()
	local range = properties.Range or 500
	local maxWalls = Ballistics.allowedWalls(weapon, config.autowall)
	local fovPixels = fovDegrees >= 180 and math.huge or fovToPixels(fovDegrees)
	local spread = Ballistics.spread(weapon)
	local useHistory = not Game.serverHits and (HISTORY_WINDOW[config.history] or 0) > 0
	local minDamage = Rage.minDamage()
	local validOrigins, validShifts = {}, {}
	Ballistics.safe = true
	Rage.originBudget = 1
	originParams.FilterDescendantsInstances = Ballistics.ignoreList()
	local activeOrigins = validOrigins
	Rage.originRank = Rage.originRank or {}

	-- Поиск пути через стену (Wall Spot / Adaptive Rays / Wall Hug / Deep Sweep): параметры от Penetration оружия.
	local wallOn = config.autowall and maxWalls > 0
		and (config.spotFind == true or config.adaptiveRays == true or config.wallHug == true or config.deepSweep == true)
	local viewOn = config.viewPriority == true
	local searchEnv, searchDeadline
	if wallOn then
		local pen = tonumber(properties.Penetration) or 0
		local rate = tonumber(properties.FireRate) or 0.1
		searchEnv = {
			config = config,
			spotRadius = math.clamp(0.5 + pen * 0.35, 0.4, 0.85),
			multiRay = math.clamp((pen >= 0.85 and 14 or pen >= 0.6 and 10 or (properties.BulletsPerShot or 1) > 1 and 5 or 6) + (rate >= 0.2 and 2 or 0), 4, 16),
		}
		searchEnv.baseRays = searchEnv.multiRay
	end

	local function evaluate(entity, character, part, position, record, fromOrigin)
		local source = fromOrigin or origin
		local offset = position - source
		local distance = offset.Magnitude
		if distance > range then return nil end

		local pixels = screenDistance(position)
		if fovPixels ~= math.huge and (not pixels or pixels > fovPixels) then return nil end

		local usedOrigin, penalty
		local traceHits, reached, walls, wallPenalty = Ballistics.trace(source, offset.Unit, distance + 2, character, maxWalls)
		penalty = wallPenalty
		if not fromOrigin and #activeOrigins > 0 and not record and (not reached or walls > 0) then
			for _, from in ipairs(activeOrigins) do
				local line = position - from
				local hitsFrom, reachedFrom, wallsFrom, penaltyFrom = Ballistics.trace(from, line.Unit, line.Magnitude + 2, character, maxWalls)
				if reachedFrom and wallsFrom <= maxWalls and (not reached or wallsFrom < walls) then
					reached, walls, usedOrigin, penalty, traceHits = true, wallsFrom, from, penaltyFrom, hitsFrom
					if wallsFrom == 0 then break end
				end
			end
		end
		if not reached and not (record and walls <= maxWalls) then return nil end

		if reached and walls == 0 and not record then
			local inward = part.Position - position
			if inward.Magnitude > 0.25 then
				local from = usedOrigin or source
				local inner = position + inward.Unit * 0.2
				local line = inner - from
				local _, innerReached = Ballistics.trace(from, line.Unit, line.Magnitude + 2, character, maxWalls)
				if not innerReached then return nil end
			end
		end

		-- Wall Safety: пуля с разбросом может зацепить край стены, поэтому линию проверяем ещё и со смещением
		-- вокруг точки попадания; если хоть один луч упирается или пробивает больше стен — точка не годится.
		if reached and walls > 0 and not record and config.wallSafety ~= false then
			local from = usedOrigin or source
			local dir = (position - from)
			if dir.Magnitude > 0.5 then
				dir = dir.Unit
				local side = dir:Cross(Vector3.yAxis)
				if side.Magnitude > 0.01 then
					side = side.Unit
					local up = side:Cross(dir).Unit
					for _, delta in ipairs({ side * 0.22, -side * 0.22, up * 0.22, -up * 0.22 }) do
						local line = position + delta - from
						local _, sideReached, sideWalls = Ballistics.trace(from, line.Unit, line.Magnitude + 2, character, maxWalls)
						if not sideReached or (sideWalls or 0) > maxWalls then return nil end
					end
				end
			end
		end

		local health = character:GetAttribute("Health") or 100
		local damage = Ballistics.damage(properties, part.Name, distance, walls, character)
		if walls == 0 and damage < math.min(minDamage, health) then return nil end
		-- Shooting through a wall is a last resort: it has to be worth the bullet.
		if walls > 0 and not record then
			local wallMin = tonumber(config.wallMinDamage) or 0
			if damage < wallMin and damage < health then return nil end
		end

		return {
			entity = entity, character = character, part = part, position = position, origin = usedOrigin,
			offset = record and nil or (position - part.Position),
			damage = damage, walls = walls, record = record, distance = distance, health = health, pixels = pixels,
			cost = (wallOn and walls > 0 and not record) and Rage.wallCost(traceHits) or 0,
			chance = Ballistics.hitChance(spread, distance, part.Size.Magnitude / 3) ,
		}
	end

	local results = {}
	for _, entity in ipairs(Game.entities()) do
		if Game.isEnemy(entity, true) then
			local character = Game.character(entity)
			local maxDist = tonumber(config.maxDist) or 0
			local rootPart = maxDist > 0 and character and character:FindFirstChild("HumanoidRootPart")
			if rootPart and (rootPart.Position - origin).Magnitude > maxDist then character = nil end
			if character and not Game.isImmune(character) and Rage.inReach(character, origin, range, fovPixels) then
				local bestAny, bestTorso, bestHead

				-- View Priority: цель, которую видит камера (прижалась к стене/углу), получает приоритет и x3 бюджет поиска.
				local seenByCam = false
				if viewOn then
					local viewPart = character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso")
						or character:FindFirstChild("HumanoidRootPart")
					if viewPart then seenByCam = Ballistics.visible(currentCamera.CFrame.Position, viewPart.Position, character) end
				end
				-- Wall Aggression: 100 = как раньше, ниже = меньше лучей и меньше времени на поиск.
				local aggro = math.clamp((tonumber(config.wallAggro) or 100) / 100, 0, 1)
				local effort = 0.08 + 0.92 * aggro * aggro
				local boost = seenByCam and (1 + 2 * aggro) or 1
				local partNames = partNames
				if maxWalls > 0 and #partNames == 1 and PART_GROUP[partNames[1]] == "Head" then
					local headPart = character:FindFirstChild(partNames[1])
					if headPart then
						local blockedHit = workspaceService:Raycast(origin, headPart.Position - origin, originParams)
						if blockedHit and blockedHit.Instance ~= headPart and not blockedHit.Instance:IsDescendantOf(character) then
							partNames = HITBOX_SETS.Multipoint
						end
					end
				end

				activeOrigins = validOrigins
				if config.originScan then
					local root = character:FindFirstChild("HumanoidRootPart")
					local aimPart
					for _, name in ipairs(partNames) do
						aimPart = character:FindFirstChild(name)
						if aimPart then break end
					end
					aimPart = aimPart or root
					activeOrigins = {}
					if aimPart then
						-- Direct origin first; the scan only runs when that line is closed.
						local direct = aimPart.Position - origin
						local blocked = true
						if direct.Magnitude > 0.05 then
							local _, directReached, directWalls = Ballistics.trace(origin, direct.Unit, direct.Magnitude + 2, character, maxWalls)
							-- Простреливаемая стена (в пределах maxWalls) — это обычный wallbang с реального origin, сдвиг не нужен.
							blocked = (not directReached) or (directWalls or 0) > (tonumber(maxWalls) or 0)
						end
						if blocked and direct.Magnitude < 250 then
							local found, why = Rage.originScan(character, aimPart, range, nil, maxWalls)
							if found then
								activeOrigins[1] = found
								Rage.originRank[entity] = {
									at = os.clock(), shifts = { found - origin }, camPos = currentCamera.CFrame.Position,
									camLook = currentCamera.CFrame.LookVector, rootPos = root and root.Position or nil,
								}
							elseif why ~= "skipped" and why ~= "partial" then
								Rage.originRank[entity] = nil
							end
						end
					end
				end

				local function keep(candidate)
					if not candidate then return false end
					if not bestAny or candidate.damage > bestAny.damage then bestAny = candidate end
					if PART_GROUP[candidate.part.Name] == "Torso" and (not bestTorso or candidate.damage > bestTorso.damage) then
						bestTorso = candidate
					end
					if PART_GROUP[candidate.part.Name] == "Head" and (not bestHead or candidate.chance > bestHead.chance) then
						bestHead = candidate
					end
					return true
				end

				local missed = Rage.missStreak and Rage.missStreak[entity]
				local forceBody = config.forceBody == true or (config.missToBody == true and missed ~= nil and missed.n >= (config.missesToBody or 2))
				if forceBody then
					forceBody = false
					for _, name in ipairs(partNames) do
						if PART_GROUP[name] ~= "Head" then forceBody = true break end
					end
				end
				for _, name in ipairs(partNames) do
					local part = not (forceBody and PART_GROUP[name] == "Head") and character:FindFirstChild(name) or nil
					if part then
						for _, point in ipairs(Ballistics.points(part, multipointSet[name] == true, tonumber(config.multipointCount) or 4)) do
							if keep(evaluate(entity, character, part, point, nil)) then break end
						end
					end
				end

				local records = useHistory and not bestAny and Ballistics.history[entity]
				if records then
					for index = 1, #records, 2 do
						local record = records[index]
						for _, name in ipairs(partNames) do
							local cframe = record.cframes[name]
							local part = character:FindFirstChild(name)
							if cframe and part and keep(evaluate(entity, character, part, cframe.Position, record)) then break end
						end
					end
				end

				local chosen = bestAny
				if chosen and config.preferBodyLethal and bestTorso and bestTorso.damage >= chosen.health then chosen = bestTorso end
				-- A head that can be landed is worth more than a body shot that does not kill.
				if chosen and bestHead and chosen ~= bestHead and (Game.isSniper(weapon) or tostring(weapon.Name):lower():find("ssg")) and bestHead.chance >= Rage.requiredChance(weapon, bestHead, config) * 0.6 and (bestHead.walls or 0) <= (chosen.walls or 0) then
					chosen = bestHead
				end
				if chosen and bestHead and chosen ~= bestHead and config.preferHead ~= false and not (bestTorso and bestTorso.damage >= bestTorso.health) then
					if bestHead.damage >= chosen.damage and bestHead.chance >= Rage.requiredChance(weapon, bestHead, config) * 0.6 and (bestHead.walls or 0) <= (chosen.walls or 0) then chosen = bestHead end
				end

				if wallOn and not (chosen and chosen.record) and (not chosen or (chosen.walls or 0) > 0) then
					if not searchDeadline then searchDeadline = os.clock() + 0.006 end
					searchEnv.entity, searchEnv.character, searchEnv.partNames, searchEnv.evaluate = entity, character, partNames, evaluate
					searchEnv.origin, searchEnv.seenByCam, searchEnv.boost, searchEnv.deadline = origin, seenByCam, boost, searchDeadline
					searchEnv.slice = math.clamp((tonumber(config.sweepBudget) or 2) * boost / 1000, 0.0005, 0.012)
					-- Wall Aggression ниже 100: меньше лучей на поиск пути через стену.
					searchEnv.multiRay = math.max(2, math.floor(searchEnv.baseRays * (0.35 + 0.65 * aggro) + 0.5))
					local okSearch, found = pcall(Rage.searchWalls, searchEnv, chosen)
					if okSearch and found then chosen = found end
				end

				if chosen then
					local score
					if config.target == "Highest Damage" then
						score = -math.min(chosen.damage, chosen.health) * 10
					elseif config.target == "Lowest Health" then
						score = chosen.health * 10
					elseif config.target == "Crosshair" then
						score = (chosen.pixels or 1e5) * 10
					else
						score = chosen.distance
					end
					if config.priority == "Health" then
						score += chosen.health * 0.01
					else
						score += chosen.distance * 0.01
					end
					if chosen.damage >= chosen.health then score -= (config.target == "Highest Damage" or config.target == "Lowest Health") and 150 or (config.target == "Crosshair" and 400 or 25) end
					if true then score -= math.min(Rage.threatOf(entity), 8) * 60 end
					-- Пробитие — запасной вариант, но не абсолютно последний:
					-- смертельный выстрел через стену должен перебивать
					-- царапину по открытой цели, иначе автоволл бесполезен.
					if seenByCam then score -= 200 end
					if (chosen.walls or 0) > 0 then score += seenByCam and 20000 or 100000 end
					if config.stickyTarget and Rage.stickyEntity == entity and os.clock() - (Rage.stickyAt or 0) < 0.5 then score -= 1e6 end
					chosen.score = score
					results[#results + 1] = chosen
				end
			end
		end
	end

	Ballistics.safe = false
	table.sort(results, function(a, b) return a.score < b.score end)
	if results[1] then Rage.stickyEntity, Rage.stickyAt = results[1].entity, os.clock() end
	return results
end

function Rage.scan(weapon, partNames, multipointSet, fovDegrees)
	return Rage.scanAll(weapon, partNames, multipointSet, fovDegrees)[1]
end

function Rage.aimPoint(target)
	if target.record and not Game.serverHits then return target.position end
	local part = target.part
	if not (part and part.Parent) then return nil end
	return part.Position + (target.offset or Vector3.zero)
end

-- Moving targets keep getting missed, and the right lead depends on the server. Try a few
-- lead sizes (scaled by ping) and keep the one that actually hits.
Rage.leadArms = { -0.7, 0, 0.7, 1.5 }
Rage.leadStats = {}
function Rage.leadFor(target)
	local velocity = Ballistics.velocity(target.entity)
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	if flat.Magnitude < 8 then return Vector3.zero, nil end
	local pick = Rage.leadPick
	if not (pick and os.clock() - pick.at < 0.3) then
		local chosen
		for index = 1, #Rage.leadArms do
			local st = Rage.leadStats[index]
			if not st or st.n < 3 then chosen = index break end
		end
		if not chosen then
			if math.random() < 0.12 then
				chosen = math.random(1, #Rage.leadArms)
			else
				local bestRate = -1
				for index = 1, #Rage.leadArms do
					local st = Rage.leadStats[index]
					local rate = (st.h + 1) / (st.n + 2)
					if rate > bestRate then bestRate, chosen = rate, index end
				end
			end
		end
		pick = { arm = chosen, at = os.clock() }
		Rage.leadPick = pick
	end
	local ping = 0.08
	pcall(function() ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 end)
	local base = math.clamp(ping * 0.5, 0.02, 0.12)
	return flat * base * Rage.leadArms[pick.arm], pick.arm
end

function Rage.aimBullet(bullet, target, weapon)
	if not Game.character(target.entity) then return false end
	local aim0 = Rage.aimPoint(target)
	if not aim0 then return false end
	local lead, leadArm = Rage.leadFor(target)
	-- History / backtrack aims at the stored old position: no lead on top of it (that made History behave like Predict)
	if target.record then lead, leadArm = Vector3.zero, nil end
	-- High ping and a moving target: aim where the enemy should be by now. Never for backtrack records.
	local predicted
	if Rage.predictAim and not target.record then
		local okPredict, shift, moving = pcall(Rage.predictOffset, target.entity, target.character, aim0, true)
		if okPredict and moving and typeof(shift) == "Vector3" then predicted = shift end
	end
	local aim = aim0 + lead + (predicted or Vector3.zero)

	local real = Game.origin()
	local requested = typeof(bullet.Origin) == "Vector3" and bullet.Origin or real
	if (requested - real).Magnitude > 4 then requested = real end
	local maxWalls = Ballistics.allowedWalls(weapon, Neverlose.config.rage.autowall)
	local range = weapon and weapon.Properties and weapon.Properties.Range or 500

	local function attempt(from)
		local offset = aim - from
		local distance = offset.Magnitude
		if distance < 0.05 or distance > range then return nil end
		local direction = offset.Unit

		Ballistics.safe = true
		local hits, reached, walls = Ballistics.trace(from, direction, distance + 2, target.character, maxWalls)
		local relaxed = false
		-- The predicted point may sit just outside the rig we see; the server decides the hit, so a clear line is enough.
		if not reached and predicted and Game.serverHits then
			local _, _, blockers = Ballistics.traceLocal(from, direction, distance, nil, 0)
			if blockers == 0 then reached, walls, relaxed = true, 0, true end
		end
		Ballistics.safe = false
		if not reached and not (target.record and walls <= maxWalls) then return nil end

		if reached and walls == 0 and not relaxed and not target.record and target.part then
			local inward = target.part.Position - aim
			if inward.Magnitude > 0.25 then
				local inner = aim + inward.Unit * 0.2
				local line = inner - from
				local _, innerReached = Ballistics.trace(from, line.Unit, line.Magnitude + 2, target.character, maxWalls)
				if not innerReached then return nil end
			end
		end
		return { from = from, direction = direction, hits = hits, reached = reached, walls = walls }
	end

	-- Смещённый origin — приоритет, но не единственный вариант. Кэш точки
	-- живёт 0.35 с; если цель за это время ушла за угол, из смещённой точки
	-- её уже не прострелить, а из камеры — видно. Раньше такой выстрел
	-- просто отменялся, и получалось "линия нарисована, пули нет".
	local function find()
		local found = attempt(requested)
		-- Origin мог устареть (игрок сдвинулся с момента скана): снова проверяем
		-- путь от текущей реальной позиции и отсутствие стен до точки.
		local shiftedOrigin = target.origin
		if shiftedOrigin and not Rage.originReachable(real, shiftedOrigin) then shiftedOrigin = nil end
		if requested ~= real and not Rage.originReachable(real, requested) then
			found = nil
		end
		if shiftedOrigin then
			local shifted = attempt(shiftedOrigin)
			if shifted and (not found or not found.reached or (shifted.walls or 0) < (found.walls or 0)) then
				found = shifted
			end
		end
		if not found and requested ~= real then found = attempt(real) end
		return found
	end
	local best = find()
	if not best and leadArm then
		aim, leadArm = aim0 + (predicted or Vector3.zero), nil
		best = find()
	end
	if not best and predicted then
		aim, predicted = aim0, nil
		best = find()
	end
	Rage.leadTag = leadArm and { at = os.clock(), arm = leadArm } or nil
	-- Диагностика: что реально ушло в выстрел (после всех откатов lead/predict). Один переиспользуемый стол.
	local meta = Rage.shotMeta
	if not meta then meta = { at = -1 } Rage.shotMeta = meta end
	if best then
		meta.at, meta.arm, meta.factor = os.clock(), leadArm, leadArm and Rage.leadArms[leadArm] or nil
		meta.lead = leadArm and lead.Magnitude or nil
		meta.predicted, meta.predMag = predicted ~= nil, predicted and predicted.Magnitude or 0
	else
		meta.at = -1
	end
	if not best then
		Rage.aimFail = { at = os.clock(), origin = target.origin or real, aim = aim }
		return false
	end
	Rage.aimFail = nil

	if not best.reached then
		best.hits[#best.hits + 1] = {
			Instance = target.part, Position = aim, Normal = -best.direction,
			Material = target.part.Material.Name, Exit = false,
		}
	end

	-- Пишем debug только после успешной проверки: линия = реально ушедший
	-- выстрел, а не попытка, которую скрипт отменил.
	Rage.shotDebug = { at = os.clock(), real = real, origin = best.from, aim = aim }

	bullet.Origin, bullet.Direction = best.from, best.direction
	if Game.serverHits then
		bullet.Hits = nil
	else
		bullet.Hits = Ballistics.withDistances(best.from, best.hits)
	end
	return true
end

