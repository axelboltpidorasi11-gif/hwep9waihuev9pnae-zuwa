do
local occParams = RaycastParams.new()
occParams.FilterType = Enum.RaycastFilterType.Exclude
local occAt = -1
local passList = {}

function blockedBetween(from, to)
	local now = os.clock()
	if now - occAt > 0.5 then
		occAt = now
		local list = { currentCamera, effectsFolder, localPlayer.Character }
		for _, entity in ipairs(Game.entities()) do
			local body = entity.Character
			if typeof(body) == "Instance" then list[#list + 1] = body end
		end
		for index = #passList, 1, -1 do
			if passList[index].Parent then list[#list + 1] = passList[index] else table.remove(passList, index) end
		end
		occParams.FilterDescendantsInstances = list
	end
	local blocked = false
	for _ = 1, 4 do
		local hit = workspaceService:Raycast(from, to - from, occParams)
		if not hit then break end
		local part = hit.Instance
		if part.Transparency < 0.9 and part.CanCollide then blocked = true break end
		occParams:AddToFilter(part)
		if #passList < 400 then passList[#passList + 1] = part end
		from = hit.Position
	end
	return blocked
end

-- Second pass when the core samples are all blocked: corners of every limb, so a sliver of arm or foot counts as visible.
local limbCache = setmetatable({}, { __mode = "k" })
local LIMB_CORNERS = { Vector3.new(0, 0, 0), Vector3.new(1, 1, 1), Vector3.new(-1, 1, 1), Vector3.new(1, -1, -1), Vector3.new(-1, -1, -1), Vector3.new(1, 1, -1), Vector3.new(-1, -1, 1) }
local function limbSight(from, character)
	local cached = limbCache[character]
	local clock = os.clock()
	if cached and clock - cached.t < 0.06 then return cached.seen end
	local seen = false
	for _, object in ipairs(character:GetChildren()) do
		if object:IsA("BasePart") and object.Transparency < 0.95 and object.Name ~= "HumanoidRootPart" then
			local half = object.Size / 2
			local frame = object.CFrame
			for _, corner in ipairs(LIMB_CORNERS) do
				if not blockedBetween(from, (frame * CFrame.new(half * corner * 0.92)).Position) then seen = true break end
			end
			if seen then break end
		end
	end
	limbCache[character] = { t = clock, seen = seen }
	return seen
end

local SIGHT_FEET, SIGHT_CHEST, SIGHT_SOLE = Vector3.new(0, 2, 0), Vector3.new(0, 0.9, 0), Vector3.new(0, 2.8, 0)
function bodySight(from, root, head, character)
	local right = root.CFrame.RightVector
	local base = root.Position
	local count = head and 8 or 7
	-- Callers only test for > 0, so the first visible sample ends the scan.
	for index = 1, count do
		local point
		if index == 1 then point = base
		elseif index == 2 then point = base + right * 1.1
		elseif index == 3 then point = base - right * 1.1
		elseif index == 4 then point = base - SIGHT_FEET
		elseif index == 5 then point = base + SIGHT_CHEST + right * 0.8
		elseif index == 6 then point = base + SIGHT_CHEST - right * 0.8
		elseif index == 7 then point = base - SIGHT_SOLE
		else point = head.Position end
		if not blockedBetween(from, point) then return 1 / count end
	end
	if character and limbSight(from, character) then return 1 / count end
	return 0
end
end

end

