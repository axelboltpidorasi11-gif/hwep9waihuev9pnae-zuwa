	AutoReloadSettings:AddSlider("Reload At", 0, 10, rage.reloadAt, set(rage, "reloadAt"), " rounds")
	tip(AutoReloadSettings:AddToggle("Instant (server)", rage.remoteReload, set(rage, "remoteReload")), "Refills the magazine through the server without waiting for the animation")

	local RageAntiAim = RageTab:AddSection("Anti Aim", "right")
	local AaToggle = RageAntiAim:AddToggle("Enabled", aa.enabled, set(aa, "enabled"))
	hk["Anti-Aim"] = AaToggle
	tip(AaToggle, "Arrow keys: manual Left / Right / Back (press again to clear)")
	local AaSettings = AaToggle:AddSettings()
	local aaCtl = { refresh = function() end }
	AaSettings:AddDropdown("Yaw Base", { "At Targets", "View" }, aa.base, set(aa, "base"))
	AaSettings:AddSlider("Yaw Offset", -180, 180, aa.offset, set(aa, "offset"), "°")
	aaCtl.jitter = AaSettings:AddSlider("Jitter Range", 0, 90, aa.jitter, function(v) aa.jitter = v aaCtl.refresh() end, "°")
	aaCtl.jitterDelay = AaSettings:AddSlider("Jitter Delay", 1, 64, aa.jitterDelay, set(aa, "jitterDelay"), " ticks")
	aaCtl.spinSpeed = AaSettings:AddSlider("Spin Speed", 5, 90, aa.spinSpeed, set(aa, "spinSpeed"), "°")
	aaCtl.swaySpeed = AaSettings:AddSlider("Sway Speed", 1, 10, aa.swaySpeed, set(aa, "swaySpeed"))
	aaCtl.swayRange = AaSettings:AddSlider("Sway Range", 10, 180, aa.swayRange, set(aa, "swayRange"), "°")
	aaCtl.pitchValue = AaSettings:AddSlider("Pitch Value", -100, 100, aa.pitchValue, set(aa, "pitchValue"), "%")
	aaCtl.spin = AaSettings:AddToggle("Spin", aa.spin, function(v) aa.spin = v aaCtl.refresh() end)
	AaSettings:AddToggle("Disable On Shot", aa.disableOnShot, set(aa, "disableOnShot"))
	AaSettings:AddToggle("Manual Keys", aa.manualKeys, set(aa, "manualKeys"))

	local manualToggles = {}
	for _, direction in ipairs({ "Left", "Right", "Back" }) do
