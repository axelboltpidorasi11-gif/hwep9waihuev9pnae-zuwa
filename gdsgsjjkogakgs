	aim.lockSince = aim.lockSince or now
	local reaction = (config.reactionMs + (aim.switched and (config.switchReactionMs or 0) or 0)) * (aim.reactJitter or 1)
	if human > 0 then reaction += human * (25 + 35 * math.random()) end
	if (now - aim.lockSince) * 1000 < reaction then return end

	local amount = RANDOMIZE_AMOUNT[config.randomize] or 0
	if amount > 0 and now - Legit.offsetAt > 0.35 then
		Legit.offsetAt = now
		Legit.offset = Vector2.new(math.random() - 0.5, math.random() - 0.5) * part.Size.Magnitude * amount
	end
	local aimAt = point
	if amount > 0 then aimAt = point + part.CFrame:VectorToWorldSpace(Vector3.new(Legit.offset.X, Legit.offset.Y, 0)) end
	if human > 0 and aim.bias then
		local size = part.Size.Magnitude * 0.1 * human
		local phase = aim.phase or 0
		local dx = (aim.bias.X * 0.8 + 0.5 * math.sin(now * 0.9 + phase) + 0.3 * math.sin(now * 2.3 + phase * 1.7)) * size
		local dy = (aim.bias.Y * 0.8 + 0.5 * math.sin(now * 1.1 + phase * 2.1) + 0.3 * math.sin(now * 2.9 + phase)) * size
		aimAt += part.CFrame:VectorToWorldSpace(Vector3.new(dx, dy, 0))
	end

	Legit.indicator = { point = aimAt, part = part, at = now }
	local screen, onScreen = currentCamera:WorldToViewportPoint(aimAt)
	if not onScreen then return end
	local error = Vector2.new(screen.X, screen.Y) - currentCamera.ViewportSize / 2
	if human > 0 and aim.overshoot > 0 and not aim.overshootDir and error.Magnitude > 40 then
		aim.overshootDir = error.Unit
		aim.overshootDist = error.Magnitude * aim.overshoot
	end
	if aim.overshootDir then
		if error:Dot(aim.overshootDir) < -aim.overshootDist * 0.5 or error.Magnitude < 3 then
			aim.overshoot, aim.overshootDir, aim.overshootDist = 0, nil, 0
		else
			error += aim.overshootDir * aim.overshootDist
		end
	end
	if error.Magnitude < 0.8 + 1.2 * human then
		aim.remX, aim.remY = 0, 0
		aim.vel = Vector2.zero
		return
	end

	local smoothing = math.clamp(config.smoothing, 0, 100) / 100

	local rate
	if smoothing <= 0.5 then
		rate = 600 * (9 / 600) ^ (smoothing / 0.5)
	else
		rate = 9 * (1 / 9) ^ ((smoothing - 0.5) / 0.5)
	end
	local step = 1 - math.exp(-rate * math.min(delta, 0.05))
	local wanted = error * step
	local cap = (300 + 1e5 * (1 - smoothing) ^ 3) * math.min(delta, 0.05)
	if wanted.Magnitude > cap then wanted = wanted.Unit * cap end

	if human > 0 then
		local sinceLock = now - aim.lockSince - reaction / 1000
		local phase = aim.phase or 0
		wanted *= math.clamp(sinceLock / (0.04 + 0.16 * human), 0.12, 1)
		local follow = 1 - math.exp(-math.min(delta, 0.05) * (24 - 12 * human))
		aim.vel = aim.vel + (wanted - aim.vel) * follow
		wanted = aim.vel
		wanted *= 1 + 0.18 * human * math.sin(now * 2.7 + phase * 1.3) * math.sin(now * 1.1 + phase)
		if now >= aim.nextPause then
			aim.pauseUntil = now + 0.05 + 0.09 * math.random()
			aim.nextPause = aim.pauseUntil + 0.7 + math.random() * 1.8
		end
		if human > 0.25 and now < aim.pauseUntil and error.Magnitude > 12 then wanted *= 0.15 end
		local perp = Vector2.new(-wanted.Y, wanted.X)
		wanted += perp * (human * 0.22 * math.sin(now * 3.1 + phase))
		wanted += Vector2.new(math.sin(now * 3.7 + phase), math.cos(now * 4.3 + phase)) * 0.12 * human
	else
		local follow = 1 - math.exp(-math.min(delta, 0.05) * 24)
		aim.vel = aim.vel + (wanted - aim.vel) * follow
		wanted = aim.vel
	end

	local x = wanted.X / aim.gainX + aim.remX
	local y = wanted.Y / aim.gainY + aim.remY
	local ix, iy = math.round(x), math.round(y)
	aim.remX, aim.remY = x - ix, y - iy
	if ix == 0 and iy == 0 then return end

	aim.sentX, aim.sentY = aim.sentX + ix, aim.sentY + iy
	aim.lastLook, aim.lastPosition = currentCamera.CFrame.LookVector, currentCamera.CFrame.Position
	mousemoverel(ix, iy)
end))

do
	local realClock, forced, clockHooked = os.clock, nil, false

	local function boxHit(origin, direction, half)
		local tmin, tmax = 0, math.huge
		for axis = 1, 3 do
			local o, d, h
			if axis == 1 then o, d, h = origin.X, direction.X, half.X elseif axis == 2 then o, d, h = origin.Y, direction.Y, half.Y else o, d, h = origin.Z, direction.Z, half.Z end
			if math.abs(d) < 1e-9 then
				if math.abs(o) > h then return false end
			else
				local t1, t2 = (-h - o) / d, (h - o) / d
				if t1 > t2 then t1, t2 = t2, t1 end
				if t1 > tmin then tmin = t1 end
				if t2 < tmax then tmax = t2 end
				if tmin > tmax then return false end
			end
		end
		return true
	end

	function Legit.findSeed(part, spread, budget)
		local viewport = currentCamera.ViewportSize * 0.5
		local ray = currentCamera:ViewportPointToRay(viewport.X, viewport.Y)
		local unit = ray.Direction.Magnitude > 0 and ray.Direction.Unit or Vector3.new(0, 0, 1)
		local frame = CFrame.lookAlong(Vector3.zero, unit, math.abs(unit.Y) > 0.9999 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0))
		local right, up, look = frame.RightVector, frame.UpVector, frame.LookVector
		local maxPhi = math.rad(math.min(spread, 69) * 0.5)
		local inverse = part.CFrame:Inverse()
		local localOrigin = inverse * ray.Origin
		local half = part.Size * 0.5 * 0.9
		local deadline = realClock() + (budget or 0.004)
		local distance = (part.Position - ray.Origin).Magnitude
		local attempts = 0
		repeat
			attempts += 1
			local clock = realClock()
			local random = Random.new(math.floor(clock * 1000000 % 2147483647))
			local theta = random:NextNumber(-math.pi, math.pi)
			local phi = random:NextNumber(0, maxPhi)
			local sinPhi = math.sin(phi)
			local direction = right * (-sinPhi * math.sin(theta)) + up * (sinPhi * math.cos(theta)) + look * math.cos(phi)
			if boxHit(localOrigin, inverse:VectorToWorldSpace(direction), half) and not blockedBetween(ray.Origin, ray.Origin + direction * distance) then return clock end
		until attempts > 3000 or realClock() > deadline
		return nil
	end

	function Legit.withClock(value, fn, ...)
		if not clockHooked then
			clockHooked = true
			local original = hookfunction(os.clock, newcclosure(function() return forced or realClock() end))
			if original then realClock = original end
			maid:give(function() pcall(restorefunction, os.clock) end)
		end
		forced = value
		local results = table.pack(pcall(fn, ...))
		forced = nil
		if not results[1] then error(results[2], 0) end
		return table.unpack(results, 2, results.n)
	end

	local bulletClass = Game.modules.bullet
	if bulletClass and type(bulletClass._performRaycast) == "function" and hookfunction then
		Patch.hook(bulletClass._performRaycast, function(original)
			return function(self, spread, ...)
				local target = Legit.seedTarget
				if target and type(spread) == "number" and os.clock() - target.at < 0.4 and target.part.Parent then
					Legit.seedTarget = nil
					local found = Legit.findSeed(target.part, spread)
					if found then return Legit.withClock(found, original, self, spread, ...) end
				end
				return original(self, spread, ...)
			end
		end)
	end
end

do
	local triggerParams = RaycastParams.new()
	triggerParams.FilterType = Enum.RaycastFilterType.Exclude
	triggerParams.CollisionGroup = "Bullet"
	local onTargetSince, holding, releaseAt, lastShot = nil, false, 0, 0
	local lostAt
	local seedProbe = { at = 0 }
	local reactionRoll = 1

	maid:give(runService.RenderStepped:Connect(function()
		local base = Neverlose.config.legit
		local config = Legit.cfg()
		local now = os.clock()

		if holding and now >= releaseAt then
			holding = false
			if mouse1release then mouse1release() end
		end

		local weapon = Game.weapon()
		if not (base.master and config.trigger) or Game.isChatting() or not Game.weaponReady(weapon) or not Legit.stateOk(config.triggerConditionList) then
			onTargetSince = nil
			return
		end

		local viewport = currentCamera.ViewportSize
		local ray = currentCamera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
		local triggerCondition = Legit.condition(config.triggerConditionList)
		local through = triggerCondition == "Through Walls"
		local result

		if through then
			local hits = Ballistics.trace(ray.Origin, ray.Direction, weapon.Properties.Range or 500, nil, Ballistics.allowedWalls(weapon, true))
			for _, hit in ipairs(hits) do
				if Game.ownerOf(hit.Instance) then
					result = hit
					break
				end
			end
		else
			triggerParams.FilterDescendantsInstances = Ballistics.ignoreList()
			for _ = 1, 6 do
				result = workspaceService:Raycast(ray.Origin, ray.Direction * 1000, triggerParams)
				if not (result and Ballistics.isPassThrough(result.Instance)) then break end
				triggerParams:AddToFilter(result.Instance)
			end
		end

		local allowed = Legit.parts(config.triggerHitboxList, config.triggerHitboxes)
		local instance = result and result.Instance
		local owner = instance and Game.ownerOf(instance)
		local character = owner and Game.isEnemy(owner, true) and Game.character(owner)
		if character and Game.isImmune(character) then character = nil end
		local valid = character and table.find(allowed, instance.Name) ~= nil

		if valid and triggerCondition == "Visible Only" and Ballistics.throughSmoke(ray.Origin, result.Position) then valid = false end
		local seeded = config.triggerHitChance >= 100
		if valid then
			local distance = (result.Position - ray.Origin).Magnitude
			local damage = Ballistics.damage(weapon.Properties, instance.Name, distance, 0, character)
			local chance = Ballistics.hitChance(Ballistics.spread(weapon), distance, instance.Size.Magnitude / 3)
			valid = damage >= math.min(config.triggerMinDamage, character:GetAttribute("Health") or 100)
				and (seeded or chance >= config.triggerHitChance)
		end

		if seeded then
			local spreadDegrees = math.deg(Ballistics.spread(weapon))
			if now - seedProbe.at > 0.04 then
				seedProbe.at, seedProbe.part, seedProbe.character = now, nil, nil
				local part, candidate = nil, nil
				if valid then
					part, candidate = instance, character
				else
					local found, _, owner2 = Legit.scan(allowed, 1.5, triggerCondition, config.triggerMinDamage)
					part, candidate = found, owner2
				end
				if part and Legit.findSeed(part, spreadDegrees, 0.002) then seedProbe.part, seedProbe.character = part, candidate end
			end
			valid = seedProbe.part ~= nil and seedProbe.part.Parent ~= nil and now - seedProbe.at < 0.1
			if valid then instance, character = seedProbe.part, seedProbe.character end
		end

		-- Short grace so one missed frame on a moving target does not restart the reaction timer.
		if not valid then
			if not lostAt then lostAt = now end
			if now - lostAt > 0.07 then onTargetSince = nil end
			return
		end
		lostAt = nil
		if config.triggerQuickScope and not ensureScoped(weapon, config.triggerQuickScopeDelay) then return end

		if not onTargetSince then
			onTargetSince = now
			local human = math.clamp((config.humanize or 0) / 100, 0, 1)
			reactionRoll = 1 + (math.random() * 2 - 1) * (0.15 + 0.3 * human) + human * 40 / math.max(config.triggerReactionMs, 40) * math.random()
		end
		if holding or (now - onTargetSince) * 1000 < config.triggerReactionMs * reactionRoll then return end

		local automatic = weapon.Properties.Automatic == true
		if not automatic and now - lastShot < (weapon.Properties.FireRate or 0.2) + 0.012 then return end

		holding = true
		lastShot = now
		releaseAt = now + (automatic and config.triggerBurstMs / 1000 or 0.05)
		Legit.seedTarget = seeded and { part = instance, at = now } or nil
		if mouse1press then mouse1press() end
	end))

	maid:give(function()
		if holding and mouse1release then mouse1release() end
	end)
end

