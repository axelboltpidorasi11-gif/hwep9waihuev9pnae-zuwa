		local controller = Instance.new("AnimationController")
		controller.Parent = model
		humanoid:Destroy()
	end
end

local WEAPON_JOINT = { AWP = "UpperTorso", C4 = "LeftHand" }

function Agents.weaponModel(weaponName, skin, float, charm)
	local resolved = Skins.resolve and Skins.resolve(weaponName) or weaponName
	local lib = Game.modules.skins
	if lib and type(lib.GetCharacterModel) == "function" then
		local charmArg = charm and { _id = "nl", Position = "1", Skin = charm, Pattern = 1 } or nil
		local ok, result = asGame(lib.GetCharacterModel, resolved, skin or "Stock", float or 0.03, nil, nil, charmArg)
		if ok and typeof(result) == "Instance" then return result, resolved end
	end
	local assets = replicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Weapons")
	folder = folder and folder:FindFirstChild(resolved)
	local base = folder and folder:FindFirstChild("Character")
	return base and cloneOf(base) or nil, resolved
end

function Agents.hold(model, weaponName, skin, float, charm)
	for _, old in ipairs(model:GetChildren()) do
		if old.Name == "NeverloseWeapon" then old:Destroy() end
	end
	local weapon, resolved = Agents.weaponModel(weaponName, skin, float, charm)
	local side = model:GetAttribute("NeverloseSide")
	if not weapon then
		Agents.play(model, idleAnimation(side))
		return
	end
	weapon.Name = "NeverloseWeapon"
	for _, object in ipairs(weapon:GetDescendants()) do
		if object:IsA("LuaSourceContainer") then
			object:Destroy()
		elseif object:IsA("BasePart") then
			object.Anchored, object.CanCollide, object.CanQuery, object.CanTouch, object.Massless = false, false, false, false, true
			if object.Name == "Hitbox" or object.Name == "Insert" or object.Name:find("MuzzlePart") then object.Transparency = 1 end
		end
	end
	local properties = weapon:FindFirstChild("Properties")
	local function offsets(suffix)
		local c0, c1 = CFrame.identity, CFrame.identity
		local v0 = properties and properties:FindFirstChild("C0" .. suffix)
		local v1 = properties and properties:FindFirstChild("C1" .. suffix)
		if v0 and v0:IsA("CFrameValue") then c0 = v0.Value end
		if v1 and v1:IsA("CFrameValue") then c1 = v1.Value end
		return c0, c1
	end
	local function bindPart(name)
		local found = name and weapon:FindFirstChild(name, true)
		if found and found:IsA("BasePart") then return found end
		if weapon.PrimaryPart then return weapon.PrimaryPart end
		local insert = weapon:FindFirstChild("Insert", true)
		if insert and insert:IsA("BasePart") then return insert end
		return weapon:FindFirstChildWhichIsA("BasePart", true)
	end
	weapon.Parent = model

	local rightHand, leftHand = model:FindFirstChild("RightHand"), model:FindFirstChild("LeftHand")
	local dual = weapon:FindFirstChild("HandleR", true) ~= nil and weapon:FindFirstChild("HandleL", true) ~= nil
	local function motor(hand, part, suffix)
		if not (hand and part) then return end
		local c0, c1 = offsets(suffix)
		local joint = Instance.new("Motor6D")
		joint.Name = "WeaponAttachment" .. suffix
		joint.C0, joint.C1, joint.Part0, joint.Part1 = c0, c1, hand, part
		joint.Parent = hand
	end
	if dual and rightHand and leftHand then
		motor(rightHand, bindPart("HandleR"), "RIGHT")
		motor(leftHand, bindPart("HandleL"), "LEFT")
	else
		motor(model:FindFirstChild(WEAPON_JOINT[resolved] or "RightHand"), bindPart(nil), "")
	end
	Agents.play(model, idleAnimation(side), weaponIdle(resolved))
end

