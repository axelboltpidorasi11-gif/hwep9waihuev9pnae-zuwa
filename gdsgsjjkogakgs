		local look, origin = camera.LookVector, camera.Position
		local za, zb = (a - origin):Dot(look), (b - origin):Dot(look)
		local near = 0.3
		if za < near and zb < near then return nil end
		if za < near then a = a:Lerp(b, (near - za) / (zb - za)) elseif zb < near then b = b:Lerp(a, (near - zb) / (za - zb)) end
