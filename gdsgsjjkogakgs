local HELIX_SEGMENTS, HELIX_WINDOW, HELIX_PITCH = 26, 30, 7

local function holderPart(position)
	return newInstance("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 1,
		Size = Vector3.one * 0.1, CFrame = CFrame.new(position),
	}, effectsFolder)
end

local function ribbon(a0, a1, width, tailColor, headColor, headAlpha)
	return newInstance("Beam", {
		Attachment0 = a0, Attachment1 = a1, FaceCamera = true, LightEmission = 1, LightInfluence = 0, Segments = 1, Width0 = 0, Width1 = width,
		Color = ColorSequence.new(tailColor, headColor),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.55, headAlpha + (1 - headAlpha) * 0.4), NumberSequenceKeypoint.new(1, headAlpha),
		}),
	}, a0.Parent)
end

local function buildHelix(from, unit, scale, colors, core)
	local holder = holderPart(from)
	local helper = math.abs(unit.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	local right = unit:Cross(helper).Unit
	local up = right:Cross(unit).Unit
	local thickness = 0.16 * scale
	local strands = {}
	for strandIndex = 1, 2 do
		local points, beams, widths = {}, {}, {}
		for index = 0, HELIX_SEGMENTS do points[index + 1] = newInstance("Attachment", {}, holder) end
		local color = colors[strandIndex]
		for index = 1, HELIX_SEGMENTS do
			local u0, u1 = (index - 1) / HELIX_SEGMENTS, index / HELIX_SEGMENTS
			local w0, w1 = thickness * (1 - u0) ^ 0.8, thickness * (1 - u1) ^ 0.8
			beams[index] = newInstance("Beam", {
				Attachment0 = points[index], Attachment1 = points[index + 1], FaceCamera = true, LightEmission = 1, LightInfluence = 0, Segments = 1,
				Width0 = w0, Width1 = w1,
				Color = ColorSequence.new(color:Lerp(core, 0.35 * (1 - u0)), color:Lerp(core, 0.35 * (1 - u1))),
				Transparency = NumberSequence.new(0.05 + 0.95 * u0 ^ 1.3, 0.05 + 0.95 * u1 ^ 1.3),
			}, holder)
			widths[index] = { w0, w1 }
		end
		strands[strandIndex] = { points = points, beams = beams, widths = widths, phase = (strandIndex - 1) * math.pi }
	end
	return { holder = holder, strands = strands, unit = unit, right = right, up = up, radius = 0.3 + 0.3 * scale, lastFade = 1 }
end

local function updateHelix(helix, front, back, age, fade)
	local twist = math.pi * 2 / HELIX_PITCH
	local radius = helix.radius * fade
	local spin = age * 5
	local step = HELIX_WINDOW / HELIX_SEGMENTS
	for _, strand in ipairs(helix.strands) do
		for index = 0, HELIX_SEGMENTS do
			local along = math.max(front - index * step, back)
			local u = math.clamp((front - along) / HELIX_WINDOW, 0, 1)
			local angle = along * twist + strand.phase + spin
			strand.points[index + 1].Position = helix.unit * along + (helix.right * math.cos(angle) + helix.up * math.sin(angle)) * radius * (1 - 0.65 * u)
		end
	end
	if fade ~= helix.lastFade then
		helix.lastFade = fade
		for _, strand in ipairs(helix.strands) do
			for index, beamObject in ipairs(strand.beams) do
				beamObject.Width0, beamObject.Width1 = strand.widths[index][1] * fade, strand.widths[index][2] * fade
			end
		end
	end
end

