Neverlose.Vfx = {}
do
local Vfx = Neverlose.Vfx
local assets = replicatedStorage:FindFirstChild("Assets")

local function find(path)
	local node = assets
	for segment in path:gmatch("[^/]+") do node = node and node:FindFirstChild(segment) end
	return node
end

local function prepare(part)
	part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = true, false, false, false, false
end

local function dispose(object, life)
	task.delay(life, function() pcall(function() object:Destroy() end) end)
end

function Vfx.emit(path, cframe, life, boost, tint, mix, scale)
	local source = find(path)
	if not source then return false end
	local template = source:IsA("BasePart") and source or source:FindFirstChildWhichIsA("BasePart", true)
	if not template then return false end
	local ok, part = pcall(function() return template:Clone() end)
	if not (ok and part) then return false end
	prepare(part)
	part.Transparency = 1
	part.CFrame = cframe
	part.Parent = effectsFolder
	for _, object in ipairs(part:GetDescendants()) do
		if object:IsA("ParticleEmitter") then
			local count = tonumber(object:GetAttribute("EmitCount")) or math.clamp(math.floor(object.Rate * 0.6), 3, 40)
			object.Enabled = false
			if tint then
				local keys = {}
				for _, key in ipairs(object.Color.Keypoints) do keys[#keys + 1] = ColorSequenceKeypoint.new(key.Time, key.Value:Lerp(tint, mix or 0.4)) end
				object.Color = ColorSequence.new(keys)
			end
			if scale and scale ~= 1 then
				local sizes = {}
				for _, key in ipairs(object.Size.Keypoints) do sizes[#sizes + 1] = NumberSequenceKeypoint.new(key.Time, key.Value * scale, key.Envelope * scale) end
				object.Size = NumberSequence.new(sizes)
				object.Speed = NumberRange.new(object.Speed.Min * scale, object.Speed.Max * scale)
			end
			object:Emit(math.max(math.floor(count * (boost or 1)), 1))
		elseif object:IsA("Sound") then
			object:Destroy()
		end
	end
	dispose(part, life or 2)
	return true
end

local HIT_PATHS = {
	Body = "Impacts/BodyShot", Helmet = "Impacts/Helmet Headshot", Registration = "Impacts/Hit Registration", Blood = "Impacts/Blood Splatter",
}

function Vfx.hit(position, partName, kill)
	local misc = Neverlose.config.misc
	if not misc.hitVfx or typeof(position) ~= "Vector3" then return end
	local style = misc.hitVfxStyle or "Auto"
	local path = HIT_PATHS[style]
	if not path then
		path = kill and HIT_PATHS.Blood or (partName == "Head" and HIT_PATHS.Helmet or HIT_PATHS.Body)
	end
	Vfx.emit(path, CFrame.new(position), 1.5, kill and 1.6 or 1)
end

function Vfx.kill(position, kind, tint)
	local cframe = CFrame.new(position)
	if kind == "Explosion" then
		Vfx.emit("GrenadeParticles/HE Grenade", cframe, 3, 1, tint, 0.3, 0.8)
	elseif kind == "Debris" then
		Vfx.emit("Other/BombExplosion", cframe, 3, 0.5, tint, 0.3, 0.35)
		Vfx.emit("Impacts/Metal", cframe, 1.5, 2)
	elseif kind == "Ember Pop" then
		Vfx.emit("GrenadeParticles/HE Grenade", cframe, 3, 0.45, tint, 0.65, 0.5)
		Vfx.emit("Impacts/Helmet Headshot", cframe, 1.5, 3)
	elseif kind == "Zeus" then
		Vfx.emit("Other/ZeusBeam", cframe, 2.5, 1.4)
		Vfx.emit("Impacts/Helmet Headshot", cframe, 1.5, 2)
	elseif kind == "Blood" then
		Vfx.emit("Impacts/Blood Splatter", cframe, 2.5, 2)
		Vfx.emit("Impacts/BodyShot", cframe, 1.5, 2)
	elseif kind == "Sparks" then
		Vfx.emit("Impacts/Helmet Headshot", cframe, 1.5, 4)
		Vfx.emit("Impacts/Metal", cframe, 1.5, 2)
	end
end

function Vfx.tracer(from, finish, color)
	local source = find("Tracers/Default")
	if not source then return false end
	local ok, part = pcall(function() return source:Clone() end)
	if not (ok and part) then return false end
	prepare(part)
	part.Transparency = 1
	local direction = finish - from
	if direction.Magnitude < 1 then return false end
	part.CFrame = CFrame.lookAt(from, finish)
	part.Parent = effectsFolder
	for _, object in ipairs(part:GetDescendants()) do
		if object:IsA("Trail") then
			object.Enabled = true
			object.Color = ColorSequence.new(color)
			object.Lifetime = math.max(object.Lifetime, 0.3)
		end
	end
	local duration = math.clamp(direction.Magnitude / 800, 0.05, 0.4)
	tweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(finish, finish + direction) }):Play()
	dispose(part, duration + 1.4)
	return true
end

function Vfx.marker(position, kill)
	local misc = Neverlose.config.misc
	local source = find("Other/HitMarker")
	if not source then return false end
	local ok, part = pcall(function() return source:Clone() end)
	if not (ok and part) then return false end
	prepare(part)
	local scale = (misc.hitMarker3dSize or 12) / 12
	part.Size = part.Size * scale
	part.CFrame = CFrame.lookAt(position, currentCamera.CFrame.Position)
	part.Parent = effectsFolder
	local color = kill and misc.hitMarker3dKill and misc.hitMarker3dKillColor or misc.hitMarker3dColor
	local life = misc.hitMarker3dTime or 0.9
	for _, decal in ipairs(part:GetDescendants()) do
		if decal:IsA("Decal") then
			decal.Color3 = color
			tweenService:Create(decal, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
		end
	end
