			end

			local predictLine, predictDot, soundRing = draw.lines[14], draw.lines[15], draw.lines[16]
			predictLine.Visible, predictDot.Visible, soundRing.Visible = false, false, false
			if esp.enabled and esp.lastSeen and alive and not live then
				local useHeard = heard ~= nil and heard.t >= info.t - 0.01 and now - heard.t < esp.soundDuration + 1.5
				local baseAge = now - (useHeard and heard.t or info.t)
				if baseAge < esp.lastSeenTime then
					local base = useHeard and (heard.position + Vector3.new(0, 3, 0)) or info.position
					local velocity = useHeard and heard.velocity or info.velocity
					local spot, blocked = Neverlose.predictSpot(base, velocity, baseAge)
					local color = useHeard and esp.soundColor or esp.lastSeenColor
					local fade = 1 - math.clamp(baseAge / esp.lastSeenTime, 0, 1) * 0.7
					local fromPoint, fromVisible = currentCamera:WorldToViewportPoint(base - Vector3.new(0, 3, 0))
					local toPoint, toVisible = currentCamera:WorldToViewportPoint(spot - Vector3.new(0, 3, 0))
					if toVisible and toPoint.Z > 0 and (spot - base).Magnitude > 1.5 then
						predictDot.Position, predictDot.Color, predictDot.Radius = Vector2.new(toPoint.X, toPoint.Y), color, blocked and 4 or 6
						predictDot.Thickness, predictDot.Filled, predictDot.NumSides, predictDot.Transparency, predictDot.Visible = 2, false, 20, fade, true
						if fromVisible and fromPoint.Z > 0 then
							predictLine.From, predictLine.To = Vector2.new(fromPoint.X, fromPoint.Y), Vector2.new(toPoint.X, toPoint.Y)
							predictLine.Color, predictLine.Thickness, predictLine.Transparency, predictLine.Visible = color, 1.5, fade * 0.8, true
						end
					end
					if useHeard then
						local center = heard.position + Vector3.new(0, 1, 0)
						local radiusWorld = math.min(2 + baseAge * 5, 30)
						local cPoint, cVisible = currentCamera:WorldToViewportPoint(center)
						local ePoint = currentCamera:WorldToViewportPoint(center + currentCamera.CFrame.RightVector * radiusWorld)
						if cVisible and cPoint.Z > 0 then
							local pixels = (Vector2.new(ePoint.X, ePoint.Y) - Vector2.new(cPoint.X, cPoint.Y)).Magnitude
							soundRing.Position, soundRing.Color, soundRing.Radius = Vector2.new(cPoint.X, cPoint.Y), esp.soundColor, math.clamp(pixels, 4, 400)
							soundRing.Thickness, soundRing.Filled, soundRing.NumSides, soundRing.Transparency, soundRing.Visible = 1, false, 36, fade * 0.6, true
						end
					end
				end
			end

			if not entity.Parent then
				pcall(function()
					draw.box:Remove()
					draw.text:Remove()
					Neverlose.removeStyleBox(draw)
					for _, line in ipairs(draw.lines) do line:Remove() end
				end)
				seenDraws[entity] = nil
				Neverlose.lastKnown[entity] = nil
			end
		end
	end))
	maid:give(function()
		for _, draw in pairs(seenDraws) do
			pcall(function()
				draw.box:Remove()
				draw.text:Remove()
				Neverlose.removeStyleBox(draw)
				for _, line in ipairs(draw.lines) do line:Remove() end
			end)
		end
		table.clear(seenDraws)
	end)
	maid:give(function()
		for _, draw in pairs(heardDraws) do pcall(function() draw.box:Remove() draw.text:Remove() Neverlose.removeStyleBox(draw) end) end
		table.clear(heardDraws)
		Neverlose.heard = {}
	end)

	local function fromRemote(payload)
		if type(payload) ~= "table" then return end
		local position = payload.Position
		if typeof(position) ~= "Vector3" then
			local source = payload.CFrame or payload.Origin
			position = typeof(source) == "CFrame" and source.Position or (typeof(source) == "Vector3" and source or nil)
		end
		if typeof(position) ~= "Vector3" then
			local part = payload.Part or payload.Parent or payload.Instance
			position = typeof(part) == "Instance" and part:IsA("BasePart") and part.Position or nil
		end
		noteHeard(payload.Class, payload.Name, position)
		local label, group = classifyPayload(payload.Class, payload.Name or payload.Sound or payload.SoundName or payload.Type or payload.Id)
		push(position, label, group)
	end

	local function soundPosition(sound)
		local node = sound.Parent
		while node and node ~= workspaceService do
			if node:IsA("BasePart") then return node.Position end
			if node:IsA("Attachment") then return node.WorldPosition end
			if node:IsA("Camera") then return nil end
			node = node.Parent
		end
		return nil
	end

	local function onPlayed(sound)
		if not Neverlose.config.esp.sounds then return end
		local position = soundPosition(sound)
		if not position then return end
		local names, node = "", sound
		for _ = 1, 3 do
			if not node or node == workspaceService then break end
			names = names .. " " .. node.Name
			node = node.Parent
		end
		local label, group = classify(names)
		push(position, label, group)
	end

	local function watch(sound)
		if watched[sound] then return end
		local connections = {}
		watched[sound] = connections
		connections[1] = sound.Played:Connect(function() onPlayed(sound) end)
		connections[2] = sound:GetPropertyChangedSignal("Playing"):Connect(function()
			if sound.Playing then onPlayed(sound) end
		end)
		connections[3] = sound.Destroying:Connect(function()
			for _, connection in ipairs(connections) do connection:Disconnect() end
			watched[sound] = nil
		end)
	end

	for _, descendant in ipairs(workspaceService:GetDescendants()) do
		if descendant:IsA("Sound") then watch(descendant) end
	end
	maid:give(workspaceService.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("Sound") then watch(descendant) end
	end))
	maid:give(function()
		for _, connections in pairs(watched) do
			for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
		end
		table.clear(watched)
	end)

	if soundRemote and type(soundRemote.Connect) == "function" then
		local ok, disconnect = pcall(soundRemote.Connect, fromRemote)
		if ok then
			maid:give(function()
				if type(disconnect) == "function" then pcall(disconnect)
				elseif typeof(disconnect) == "RBXScriptConnection" then disconnect:Disconnect() end
			end)
		end
	end

	maid:give(runService.RenderStepped:Connect(function()
		local esp = Neverlose.config.esp
		local now = os.clock()
		local cameraPosition = currentCamera.CFrame.Position

		for index = #markers, 1, -1 do
			local marker = markers[index]
			local age = now - marker.t
			if age > esp.soundDuration or not esp.sounds then
				killMarker(marker)
				table.remove(markers, index)
			else
				local point, visible = currentCamera:WorldToViewportPoint(marker.position)
				local fade = 1 - age / esp.soundDuration
				local radius = (6 + age * 30) * math.clamp(60 / math.max(point.Z, 1), 0.3, 2)

				if marker.glow then

					local life = math.min(esp.soundDuration, 2.4)
					local fadeOut = math.min(age / life, 1)
					local walls = Neverlose.config.esp.enemyModel.walls
					local style = CHAMS_STYLE[walls.mode]
					local color = style and walls.color or esp.soundColor
					local hidden = not Ballistics.visible(cameraPosition, marker.position + Vector3.new(0, 2.5, 0), marker.ghost)
					if age >= life or not hidden then

						pcall(function() marker.glow:Destroy() marker.ghost:Destroy() end)
						marker.glow, marker.ghost = nil, nil
					else
						local fill, outline = style and style.fill or 0.45, style and style.outline or 0.1
						marker.glow.Enabled = true
						marker.glow.FillColor = color
						marker.glow.OutlineColor = color:Lerp(Color3.new(1, 1, 1), 0.35)
						marker.glow.FillTransparency = fill + (1 - fill) * fadeOut ^ 2
						marker.glow.OutlineTransparency = outline + (1 - outline) * fadeOut ^ 2
					end
				end

				marker.ring.Visible = visible
				marker.ring.Position = Vector2.new(point.X, point.Y)
				marker.ring.Radius, marker.ring.Color, marker.ring.Transparency = radius, esp.soundColor, fade

				marker.text.Visible = visible and esp.soundLabels
				marker.text.Text = ("%s  %dm"):format(marker.label, (marker.position - cameraPosition).Magnitude * STUDS_PER_METER)
				marker.text.Position = Vector2.new(point.X, point.Y - radius - 14)
				marker.text.Color, marker.text.Transparency = esp.soundColor, fade
			end
		end
	end))

	maid:give(function()
		for _, marker in ipairs(markers) do killMarker(marker) end
		table.clear(markers)
	end)
end

