local Inspect = { spin = {} }

local function inspectName(info, config)
	local item = info.item
	local entry = config.bySide[info.team == "T" and "T" or "CT"] or {}
	local defaults = Inspect.defaults
	if item == "Knife" then return entry.knife or (defaults and defaults.knife(info.team == "T" and "T" or "CT")) or Skins.knives[1] end
	if item == "Gloves" then return entry.glove or (defaults and defaults.glove(info.team == "T" and "T" or "CT")) end
	if item == "Agent" or item == "Charm" or item == "Music" or item == "Badge" then return nil end
	return Skins.resolve(item)
end

function Inspect.build(world, camera, info, config, wearFloat, keepSpin)
	world:ClearAllChildren()
	local viewport = camera.Parent
	for _, child in ipairs(viewport:GetChildren()) do
		if child:GetAttribute("NLCharmUi") then child:Destroy() end
	end
	local previous = Inspect.spin[viewport]
	local token = (previous and previous.token or 0) + 1
	local state = { token = token, yaw = keepSpin and previous and previous.yaw or 0, pitch = keepSpin and previous and previous.pitch or 0, drag = false, attach = keepSpin and previous and previous.attach or false }
	local placeWeapon
	Inspect.spin[viewport] = state

	local model
	if info.item == "Agent" then
		local side = info.team == "T" and "T" or "CT"
		local source = Agents.find(side)
		model = source and cloneOf(source)
		if model then
			Agents.rig(model)
			model:SetAttribute("NeverloseSide", side)
			model.Parent = world
			Agents.play(model, idleAnimation(side))
		end
	else
		local weapon = inspectName(info, config)
		local skinsLib = Game.modules.skins
		local pick = info.pick or {}
		local entry = config.bySide[info.team == "T" and "T" or "CT"] or {}
		if info.item == "Charm" or info.item == "Badge" then
			local name = pick.skin
			if name == nil then name = info.item == "Charm" and entry.charm or entry.badge end
			if name and name ~= "No Skin" and skinsLib then
				local ok, result
				if info.item == "Charm" then ok, result = asGame(skinsLib.GetCharmModel, name, 1) else ok, result = asGame(skinsLib.GetBadgeModel, name) end
				if ok and typeof(result) == "Instance" then model = result end
				if not model and info.item == "Badge" then
					-- Badges that only ship an icon get a flat plate carrying it.
					local image
					for _, spelling in ipairs({ name, (name:gsub("[%s%.]", "")) }) do
						local okInfo, data = pcall(skinsLib.GetSkinInformation, "Badge", spelling)
						if okInfo and type(data) == "table" and type(data.imageAssetId) == "string" and data.imageAssetId ~= "" then image = data.imageAssetId break end
					end
					if image then
						local plate = Instance.new("Part")
						plate.Size, plate.Color, plate.Anchored, plate.CanCollide = Vector3.new(4, 4, 0.05), Color3.fromRGB(18, 18, 27), true, false
						local decal = Instance.new("Decal")
						decal.Texture, decal.Face = image, Enum.NormalId.Front
						decal.Parent = plate
						local back = decal:Clone()
						back.Face = Enum.NormalId.Back
						back.Parent = plate
						local holder = Instance.new("Model")
						plate.Parent = holder
						holder.PrimaryPart = plate
						model = holder
					end
				end
			end
		elseif weapon and skinsLib and info.item == "Gloves" and skinsLib.GetGloves then
			local skin = pick.skin
			if not skin or skin == "No Skin" then skin = "Stock" end
			local float = type(pick.wearFloat) == "number" and pick.wearFloat or wearFloat[pick.wear or "Factory New"] or 0.03
			local ok, result = asGame(skinsLib.GetGloves, weapon, skin, float)
			if ok and typeof(result) == "Instance" then model = result end
		elseif weapon and skinsLib and skinsLib.GetInspectModel then
			local skin = pick.skin
			if not skin or skin == "No Skin" then skin = "Stock" end
			local float = type(pick.wearFloat) == "number" and pick.wearFloat or wearFloat[pick.wear or "Factory New"] or 0.03
			local charmArg = entry.charm and not Skins.customCharm(weapon) and { _id = "nl", Position = "1", Skin = entry.charm, Pattern = 1 } or nil
			local ok, result = asGame(skinsLib.GetInspectModel, weapon, skin, float, nil, nil, charmArg)
			if ok and typeof(result) == "Instance" then
				model = result
				placeWeapon = weapon
				pcall(Skins.attachCharms, model, weapon)
			end
		end
		if model then
			for _, object in ipairs(model:GetDescendants()) do
				if object:IsA("BasePart") then object.Anchored = true end
			end
			model.Parent = world
		end
	end
	if not model then return end

	local pivot = model:GetPivot()
	local _, size = Agents.visibleBox(model)

	local base = info.item == "Agent" and CFrame.Angles(0, math.pi, 0) or (size.Z > size.X and CFrame.Angles(0, math.rad(90), 0) or CFrame.identity)
	model:PivotTo(base * pivot.Rotation)
	local cframe, box = Agents.visibleBox(model)
	model:PivotTo(model:GetPivot() + (Vector3.zero - cframe.Position))

	local center = model:GetPivot()
	local radius = math.sqrt(box.X * box.X + box.Y * box.Y + box.Z * box.Z) / 2
	local function refit()
		local area = viewport.AbsoluteSize
		local aspect = (area.X > 0 and area.Y > 0) and area.X / area.Y or 1.5
		local vertical = math.tan(math.rad(camera.FieldOfView / 2))
		local horizontal = vertical * aspect

		local zoom = 0.78 + 0.22 * math.clamp((area.X - 420) / 700, 0, 1)
		local halfHeight = box.Y / 2
		local halfReach = info.item == "Agent" and math.max(box.X, box.Z) / 2 or math.sqrt(box.X * box.X + box.Z * box.Z) / 2
		local need = math.max(halfHeight * 1.1 / vertical, halfReach * 1.1 / horizontal)
		camera.CFrame = CFrame.new(Vector3.new(0, 0, need * zoom + halfReach), Vector3.zero)
	end
	local function turn()
		model:PivotTo(CFrame.Angles(state.pitch, 0, 0) * CFrame.Angles(0, state.yaw, 0) * center)
	end
	refit()

	-- Charm pinning: pick a charm in the Charm slot, press Attach, then click the spot on the weapon.
	local sideEntry = config.bySide[info.team == "T" and "T" or "CT"] or {}
	local canAttach = placeWeapon ~= nil and type(sideEntry.charm) == "string" and sideEntry.charm ~= "No Skin" and info.item ~= "Gloves"
	local attachButton
	local function rayHit(position)
		local area = viewport.AbsoluteSize
		if area.X <= 0 or area.Y <= 0 then return nil end
		local rel = position - viewport.AbsolutePosition
		local tanHalf = math.tan(math.rad(camera.FieldOfView / 2))
		local nx, ny = (rel.X / area.X - 0.5) * 2, (0.5 - rel.Y / area.Y) * 2
		local direction = (camera.CFrame:VectorToWorldSpace(Vector3.new(nx * tanHalf * area.X / area.Y, ny * tanHalf, -1))).Unit
		local origin = camera.CFrame.Position
		local best, bestPoint
		for _, object in ipairs(model:GetDescendants()) do
			if object:IsA("BasePart") and object.Transparency < 0.95 and not object:FindFirstAncestor("NeverloseCharm") then
				local localOrigin = object.CFrame:PointToObjectSpace(origin)
				local localDirection = object.CFrame:VectorToObjectSpace(direction)
				local half = object.Size / 2
				local tMin, tMax = -math.huge, math.huge
				local hit = true
				for _, axis in ipairs({ "X", "Y", "Z" }) do
					local o, d, h = localOrigin[axis], localDirection[axis], half[axis]
					if math.abs(d) < 1e-6 then
						if math.abs(o) > h then hit = false break end
					else
						local t1, t2 = (-h - o) / d, (h - o) / d
						if t1 > t2 then t1, t2 = t2, t1 end
						tMin, tMax = math.max(tMin, t1), math.min(tMax, t2)
						if tMin > tMax then hit = false break end
					end
				end
				if hit and tMax > 0 and (not best or tMin < best) then best, bestPoint = math.max(tMin, 0), origin + direction * math.max(tMin, 0) end
			end
		end
		return bestPoint
	end
	local function pin(point)
		local pivot, low, high = Skins.pivotBounds(model)
		if not pivot then return end
		local local3 = pivot:PointToObjectSpace(point)
		local size = high - low
		local function fraction(value, lo, span) return span > 1e-4 and math.clamp((value - lo) / span - 0.5, -0.5, 0.5) or 0 end
		local list = config.charms
		local owner = Skins.resolve(placeWeapon)
		local size100 = 100
		for index = #list, 1, -1 do
			if list[index].at == "Custom" and list[index].weapon == owner then size100 = list[index].size or 100 table.remove(list, index) end
		end
		list[#list + 1] = { name = sideEntry.charm, at = "Custom", fx = fraction(local3.X, low.X, size.X), fy = fraction(local3.Y, low.Y, size.Y), fz = fraction(local3.Z, low.Z, size.Z), size = size100, weapon = owner }
		pcall(Skins.save)
		task.defer(Inspect.build, world, camera, info, config, wearFloat, true)
	end
	if canAttach then
		local function chip(text, offset, width)
			local button = Instance.new("TextButton")
			button.Name, button.Size, button.Position = randomName(), UDim2.fromOffset(width, 22), UDim2.new(1, -offset, 1, -30)
			button.BackgroundColor3, button.BackgroundTransparency, button.BorderSizePixel = Color3.fromRGB(24, 28, 42), 0.1, 0
			button.Text, button.TextSize, button.Font, button.TextColor3 = text, 11, Enum.Font.GothamMedium, Color3.fromRGB(205, 208, 220)
			button.AutoButtonColor, button.ZIndex = false, 20
			button:SetAttribute("NLCharmUi", true)
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 6)
			corner.Parent = button
			button.Parent = viewport
			return button
		end
		attachButton = chip(state.attach and "Click weapon…" or "Attach Charm", 214, 100)
		local reset = chip("Reset", 108, 52)
		local function paintButton()
			attachButton.Text = state.attach and "Click weapon…" or "Attach Charm"
			attachButton.BackgroundColor3 = state.attach and Color3.fromRGB(110, 130, 255) or Color3.fromRGB(24, 28, 42)
		end
		paintButton()
		attachButton.MouseButton1Click:Connect(function() state.attach = not state.attach paintButton() end)
		reset.MouseButton1Click:Connect(function()
			local owner = Skins.resolve(placeWeapon)
			for index = #config.charms, 1, -1 do
				if config.charms[index].at == "Custom" and config.charms[index].weapon == owner then table.remove(config.charms, index) end
			end
			pcall(Skins.save)
			task.defer(Inspect.build, world, camera, info, config, wearFloat, true)
		end)
	end

	local dragging, lastX, lastY = false, 0, 0
	local moveDistance = 0
	local began = viewport.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging, lastX, lastY, moveDistance = true, input.Position.X, input.Position.Y, 0 end
	end)
	local released = viewport.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and canAttach and state.attach and moveDistance < 5 then
			local point = rayHit(Vector2.new(input.Position.X, input.Position.Y))
			if point then pin(point) end
		end
	end)
	local ended = userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	local moved = userInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			moveDistance += math.abs(input.Position.X - lastX) + math.abs(input.Position.Y - lastY)
			state.yaw += (input.Position.X - lastX) * 0.012
			state.pitch += (input.Position.Y - lastY) * 0.012
			lastX, lastY = input.Position.X, input.Position.Y
		end
	end)
	local clock = os.clock()
	local step
	step = runService.RenderStepped:Connect(function()
		if Inspect.spin[viewport] ~= state or not model.Parent then
			step:Disconnect() began:Disconnect() ended:Disconnect() moved:Disconnect() released:Disconnect()
			return
		end
		turn()
		refit()
	end)
	maid:give(function() pcall(function() step:Disconnect() began:Disconnect() ended:Disconnect() moved:Disconnect() released:Disconnect() end) end)
end

