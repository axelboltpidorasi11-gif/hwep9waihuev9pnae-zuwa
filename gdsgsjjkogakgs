do
	local localHighlight = newInstance("Highlight", { Enabled = false, Name = randomName() }, highlightFolder)
	local localBody = { store = setmetatable({}, { __mode = "k" }), scan = 0 }
	maid:give(function() BodyMat.restore(localBody.store) end)
	local viewmodelOriginals = setmetatable({}, { __mode = "k" })
	local weaponHighlight = newInstance("Highlight", { Enabled = false, Name = randomName() }, highlightFolder)
	local stripped = setmetatable({}, { __mode = "k" })
	local function stripTextures(part)
		if stripped[part] then return end
		local saved = { appearances = {} }
		if part:IsA("MeshPart") and part.TextureID ~= "" then saved.tex = part.TextureID part.TextureID = "" end
		for _, child in ipairs(part:GetChildren()) do
			if child:IsA("SurfaceAppearance") or child:IsA("Decal") or child:IsA("Texture") then
				saved.appearances[#saved.appearances + 1] = child
				child.Parent = nil
			end
		end
		stripped[part] = saved
	end
	local function restoreTextures(part)
		local saved = stripped[part]
		if not saved then return end
		stripped[part] = nil
		if saved.tex and part.Parent then part.TextureID = saved.tex end
		for _, child in ipairs(saved.appearances) do child.Parent = part end
	end
	local handsHidden = setmetatable({}, { __mode = "k" })
	local HAND_WORDS = { "arm", "hand", "glove", "sleeve" }
	local function materialOf(mode)
		if mode == "Metal" then return Enum.Material.Metal end
		local style = CHAMS_STYLE[mode]
		return style and (style.material or Enum.Material.Neon) or nil
	end

	local function isHand(part)
		local name = part.Name:lower()
		for _, word in ipairs(HAND_WORDS) do
			if name:find(word, 1, true) then return true end
		end
		return false
	end

	local function restoreViewmodel()
		for part, original in pairs(viewmodelOriginals) do
			if part.Parent then part.Material, part.Color = original[1], original[2] end
		end
		table.clear(viewmodelOriginals)
		for part in pairs(stripped) do restoreTextures(part) end
		weaponHighlight.Enabled = false
		for part in pairs(handsHidden) do
			if part.Parent then part.LocalTransparencyModifier = 0 end
		end
		table.clear(handsHidden)
	end
	maid:give(restoreViewmodel)

	maid:give(runService.RenderStepped:Connect(function()
		local config = Neverlose.config.esp.localModel
		local character = localPlayer.Character

		local style = nil
		if config.model ~= "Default" then style = CHAMS_STYLE[config.model] end
		BodyMat.drive(localBody, character, style, config.modelColor)
		localHighlight.Enabled = style ~= nil and character ~= nil
		if localHighlight.Enabled then
			localHighlight.Adornee = character
			local lc, ld = Neverlose.styleFx(config.model, config.modelColor)
			localHighlight.FillColor = lc
			localHighlight.OutlineColor = lc:Lerp(Color3.new(1, 1, 1), 0.3)
			localHighlight.FillTransparency = math.clamp((style.material and 1 or style.fill) + ld, 0, 1)
			localHighlight.OutlineTransparency = config.outline == false and 1 or style.outline
		end

		local weapon = Game.weapon()
		local model = weapon and weapon.Viewmodel and weapon.Viewmodel.Model
		local hideHands = Neverlose.config.world.removeHands
		local weaponRoot = weapon and weapon.Viewmodel and (weapon.Viewmodel.LargeWeaponModel or weapon.Viewmodel.SmallWeaponModel)
		if model and (config.weapon ~= "Default" or config.hands ~= "Default" or hideHands or next(viewmodelOriginals) or next(handsHidden)) then
			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") and part.Transparency < 1 and part.Name ~= "HumanoidRootPart" and part.Name ~= "CameraPart" then
					-- Everything that is not part of the weapon model is the arms: sleeves, gloves, skin.
					local hand = not (weaponRoot and part:IsDescendantOf(weaponRoot)) and (weaponRoot ~= nil or isHand(part))
					local mode = hand and config.hands or config.weapon
					local color = hand and config.handsColor or config.weaponColor

					if mode ~= "Default" and materialOf(mode) then
						if not viewmodelOriginals[part] then viewmodelOriginals[part] = { part.Material, part.Color } end
						part.Material, part.Color = materialOf(mode), color
						stripTextures(part)
					elseif viewmodelOriginals[part] then
						part.Material, part.Color = viewmodelOriginals[part][1], viewmodelOriginals[part][2]
						viewmodelOriginals[part] = nil
						restoreTextures(part)
					end

					if hand and hideHands then
						part.LocalTransparencyModifier = 1
						handsHidden[part] = true
					elseif handsHidden[part] then
						part.LocalTransparencyModifier = 0
						handsHidden[part] = nil
					end
				end
			end
		end

		local overlayStyle = weaponRoot and config.weapon ~= "Default" and CHAMS_STYLE[config.weapon] or nil
		weaponHighlight.Enabled = overlayStyle ~= nil
		if overlayStyle then
			weaponHighlight.Adornee = weaponRoot
			local wc, wd = Neverlose.styleFx(config.weapon, config.weaponColor)
			weaponHighlight.FillColor = wc
			weaponHighlight.OutlineColor = wc:Lerp(Color3.new(1, 1, 1), 0.3)
			weaponHighlight.FillTransparency = math.clamp((overlayStyle.material and 1 or overlayStyle.fill) + wd, 0, 1)
			weaponHighlight.OutlineTransparency = config.weaponOutline == false and 1 or overlayStyle.outline
			weaponHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
		end

		if character and config.transparency > 0 and Neverlose.config.world.thirdPerson then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "CameraPart" then
					part.LocalTransparencyModifier = config.transparency / 100
				end
			end
		end
	end))
	maid:give(localHighlight)
	maid:give(weaponHighlight)
end

do
	local markers, recent, watched = {}, {}, setmetatable({}, { __mode = "k" })

	local function killMarker(marker)
		pcall(function() marker.text:Remove() end)
		for _, line in ipairs(marker.ring or {}) do pcall(function() line:Remove() end) end
		for _, set in ipairs(marker.neon or {}) do
			for _, line in ipairs(set) do pcall(function() line:Remove() end) end
		end
		for _, set in ipairs(marker.solidSets or {}) do
			for _, line in ipairs(set) do pcall(function() line:Remove() end) end
		end
		if marker.ghost then pcall(function() marker.ghost:Destroy() end) end
		if marker.glow then pcall(function() marker.glow:Destroy() end) end
	end

	local function makeGhost(position)
		local best, bestDistance
		for _, entity in ipairs(Game.entities()) do
			local character = entity ~= localPlayer and Game.character(entity)
			if character and Game.isEnemy(entity, true) then
				local root = character:FindFirstChild("HumanoidRootPart")
				local distance = root and (root.Position - position).Magnitude
				if distance and distance < 7 and (not bestDistance or distance < bestDistance) then best, bestDistance = character, distance end
			end
		end
		if not best then return nil end
		local ok, copy = pcall(function()
			best.Archivable = true
			for _, object in ipairs(best:GetDescendants()) do object.Archivable = true end
			return best:Clone()
		end)
		if not (ok and copy) then return nil end
		for _, object in ipairs(copy:GetDescendants()) do
			if object:IsA("LuaSourceContainer") or object:IsA("Humanoid") or object:IsA("Sound") or object:IsA("BillboardGui") or object:IsA("Highlight") then
				object:Destroy()
			elseif object:IsA("BasePart") then
				object.Anchored, object.CanCollide, object.CanQuery, object.CanTouch, object.Massless = true, false, false, false, true
				object.LocalTransparencyModifier = 0
			elseif object:IsA("Decal") or object:IsA("Texture") or object:IsA("SurfaceAppearance") or object:IsA("Clothing") then
				object:Destroy()
			end
		end
		copy.Name = randomName()
		copy.Parent = effectsFolder
		return copy
	end
	local soundRemote = Game.modules.remotes and Game.modules.remotes.Sound and Game.modules.remotes.Sound.ReplicateSound

	local KINDS = {
		{ "Footstep", "Footsteps", { "step", "foot", "walk", "sprint", "land", "jump", "run" } },
		{ "Utility", "Utility", { "grenade", "flash", "smoke", "molotov", "decoy", "explo", "bomb", "c4", "defus", "plant", "throw" } },
		{ "Reload", "Utility", { "reload", "magazine", "magin", "magout", "clip", "cock", "slide", "bolt", "equip", "draw" } },
		{ "Shot", "Shots", { "shoot", "shot", "fire", "gun", "bang", "rifle", "pistol", "smg", "awp", "deagle", "knife", "slash", "stab", "tap" } },
	}

	local function classify(text)
		text = tostring(text or ""):lower()
		for _, kind in ipairs(KINDS) do
			for _, word in ipairs(kind[3]) do
				if text:find(word, 1, true) then return kind[1], kind[2] end
			end
		end
		return "Sound", "Other"
	end

	-- The server tags footsteps with Class "FloorSounds" and the surface as Name, so the keyword scan alone never sees them.
	local function classifyPayload(class, name)
		class, name = tostring(class or ""), tostring(name or "")
		if class == "FloorSounds" then
			if name == "Jump" then return "Jump", "Footsteps" end
			if name:sub(1, 7) == "Landing" then return "Landing", "Footsteps" end
			return "Step", "Footsteps"
		end
		return classify(name ~= "" and name or class)
	end

	-- Один и тот же шаг приходит двумя путями (remote FloorSounds и сам Sound
	-- в персонаже), поэтому для склейки дублей считаем Step/Footstep/Jump/Landing
	-- одним видом.
	local function soundFamily(name)
		if name == "Step" or name == "Footstep" or name == "Jump" or name == "Landing" then return "Footsteps" end
		return name
	end

	-- Donor logic: only players that are alive but not streamed into Workspace can be the source of a sound we cannot see.
	local function culledEnemies()
		local list = {}
		for _, entity in ipairs(Game.entities()) do
			if entity ~= localPlayer and Game.isEnemy(entity, true) and entity:GetAttribute("Dead") == false then
				local character = entity.Character
				if not (character and character:IsDescendantOf(workspaceService)) then
					local raw = entity:GetAttribute("CurrentEquipped")
					local ok, decoded = pcall(httpService.JSONDecode, httpService, type(raw) == "string" and raw or "")
					list[#list + 1] = { entity = entity, weapon = ok and type(decoded) == "table" and decoded.Name or nil }
				end
			end
		end
		return list
	end

	local function whoMadeSound(isShot, weaponClass)
		local list = culledEnemies()
		if #list == 1 then return list[1].entity end
		if isShot then
			local found
			for _, item in ipairs(list) do
				if item.weapon == weaponClass then
					if found then return nil end
					found = item.entity
				end
			end
			return found
		end
		return nil
	end

	local groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Exclude
	groundParams.IgnoreWater = true
	groundParams.RespectCanCollide = true

	local filterAt = 0
	local function setFilter()
		local now = os.clock()
		if now - filterAt < 0.5 then return end
		filterAt = now
		groundParams.FilterDescendantsInstances = { localPlayer.Character, currentCamera, effectsFolder, workspaceService:FindFirstChild("Characters") }
	end

	-- Floor under the sound, so the ring lands at the enemy's feet and never sinks below the surface.
	local function groundPoint(position, label)
		if label == "Utility" then return position end
		local drop = (label == "Step" or label == "Footstep" or label == "Jump" or label == "Landing") and 0 or 3.2
		local fallback = position - Vector3.new(0, drop, 0)
		setFilter()
		local ok, hit = pcall(workspaceService.Raycast, workspaceService, position + Vector3.new(0, 1.5, 0), Vector3.new(0, -40, 0), groundParams)
		if ok and hit then return hit.Position + Vector3.new(0, 0.1, 0) end
		return fallback
	end

	local SEGMENTS, GRAVITY = 16, 196.2
	local ringDirs = {}
	for index = 1, SEGMENTS do
		local angle = (index - 1) / SEGMENTS * math.pi * 2
		ringDirs[index] = Vector3.new(math.cos(angle), 0, math.sin(angle))
	end

	local SOLID_SEGMENTS = 40

	local function newLines(count)
		local set = {}
		for index = 1, count or SEGMENTS do
			local line = NewDrawing("Line")
			line.Thickness, line.Visible = 2, false
			set[index] = line
		end
		return set
	end

	-- Sound rings stay flat at the source height: no per-point ground casts, so nothing stretches along walls.
	local function ringHeights(marker)
		if not marker.heights then
			local heights = {}
			for index = 1, SEGMENTS do heights[index] = marker.position.Y end
			marker.heights = heights
		end
		return marker.heights
	end

	local function paint(set, points, visible, color, thickness, alpha)
		local count = #set
		for index, line in ipairs(set) do
			local following = index % count + 1
			if visible[index] and visible[following] then
				line.From, line.To = points[index], points[following]
				line.Color, line.Thickness, line.Transparency, line.Visible = color, thickness, alpha, true
			else
				line.Visible = false
			end
		end
	end

	local function hideSet(set)
		for _, line in ipairs(set or {}) do line.Visible = false end
	end

	local function ringStyle(esp)
		local style = esp.soundRing
		if type(style) == "table" then style = style[1] end
		return style == "Solid" and "Solid" or "Segmented"
	end

	-- Flat ring lying on the world floor: drawn from world-space points, so it stays horizontal from any camera angle.
	local function drawRing(marker, esp, age, pulse, fade, now)
		local settled = age >= pulse
		local maxRadius = math.max(esp.soundMaxRadius or 10, 2) * (marker.inView and 1.3 or 1)
		local grow = math.min(age, pulse) / pulse
		local radius = 1.5 + (maxRadius - 1.5) * (1 - (1 - grow) * (1 - grow))
		local lift = math.max(0, marker.drop - 0.5 * GRAVITY * age * age)
		local heights = ringHeights(marker)
		local solid = ringStyle(esp) == "Solid"
		local points, visible = {}, {}

		if solid then
			hideSet(marker.ring)
			for _, set in ipairs(marker.neon or {}) do hideSet(set) end
			if not marker.solidSets then
				marker.solidSets = { newLines(SOLID_SEGMENTS), newLines(SOLID_SEGMENTS), newLines(SOLID_SEGMENTS), newLines(SOLID_SEGMENTS) }
				for _, line in ipairs(marker.solidSets[1]) do pcall(function() line.ZIndex = 2 end) end
				pcall(function() marker.text.ZIndex = 3 end)
			end
			for index = 1, SOLID_SEGMENTS do
				local angle = (index - 1) / SOLID_SEGMENTS * math.pi * 2
				local scaled = (index - 1) / SOLID_SEGMENTS * SEGMENTS
				local low = math.floor(scaled)
				local blend = scaled - low
				local height = heights[low + 1] + (heights[low % SEGMENTS + 2 > SEGMENTS and 1 or low % SEGMENTS + 2] - heights[low + 1]) * blend
				local world = marker.position + Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius
				local screen = currentCamera:WorldToViewportPoint(Vector3.new(world.X, height + 0.1 + lift, world.Z))
				points[index], visible[index] = Vector2.new(screen.X, screen.Y), screen.Z > 0
			end
			local power = math.clamp((esp.soundNeonPower or 60) / 100, 0, 1)
			local spread = 1 + (esp.soundNeonSize or 50) / 25
			local glowColor = esp.soundNeonColor or esp.soundColor
			for layer = 3, 1, -1 do
				paint(marker.solidSets[layer + 1], points, visible, glowColor, 2 + layer * spread * 2, fade * power * 0.4 / layer)
			end
			paint(marker.solidSets[1], points, visible, esp.soundColor:Lerp(Color3.new(1, 1, 1), 0.35), 2, fade)
			return
		end

		for _, set in ipairs(marker.solidSets or {}) do hideSet(set) end
		for index = 1, SEGMENTS do
			local world = marker.position + ringDirs[index] * radius
			local screen = currentCamera:WorldToViewportPoint(Vector3.new(world.X, heights[index] + 0.1 + lift, world.Z))
			points[index], visible[index] = Vector2.new(screen.X, screen.Y), screen.Z > 0
		end
		paint(marker.ring, points, visible, esp.soundColor, 2, fade)

		if esp.soundNeon then
			if not marker.neon then
				marker.neon = { newLines(), newLines(), newLines() }
				for _, line in ipairs(marker.ring) do pcall(function() line.ZIndex = 2 end) end
				pcall(function() marker.text.ZIndex = 3 end)
			end
			local power = math.clamp((esp.soundNeonPower or 60) / 100, 0, 1)
			local spread = 1 + (esp.soundNeonSize or 50) / 25
			local glowColor = esp.soundNeonColor or esp.soundColor
			for index, set in ipairs(marker.neon) do
				paint(set, points, visible, glowColor, 2 + index * spread * 2, fade * power * 0.4 / index)
			end
		elseif marker.neon then
			for _, set in ipairs(marker.neon) do hideSet(set) end
		end
	end

	Neverlose.soundStats = { received = 0, shown = 0, groups = {}, filtered = 0 }

	local function push(position, label, group, owner, isShot, weaponClass)
		local esp = Neverlose.config.esp
		if not esp.sounds or typeof(position) ~= "Vector3" then return end
		local stats = Neverlose.soundStats
		stats.received += 1
		stats.groups[group] = (stats.groups[group] or 0) + 1
		local filter = esp.soundKinds
		local allowed = filter == nil or filter == "All" or filter == group
		if type(filter) == "table" then
			allowed = #filter == 0 or table.find(filter, "All") ~= nil or table.find(filter, group) ~= nil
		end
		if group == "Other" or not allowed then
			stats.filtered += 1
			return
		end
		if (position - currentCamera.CFrame.Position).Magnitude > esp.soundDistance then return end

		local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
		if localRoot and (localRoot.Position - position).Magnitude < 16 then return end

		-- A player already standing in Workspace next to the source is visible, so no marker is needed for it.
		if label ~= "Utility" then
			local visible = workspaceService:FindFirstChild("Characters")
			if visible then
				for _, model in ipairs(visible:GetChildren()) do
					local root = model:IsA("Model") and model:FindFirstChild("HumanoidRootPart")
					if root and (root.Position - position).Magnitude < 7 then return end
				end
			end
		end

		if owner and label ~= "Utility" then
			-- The sound sits inside a character, so its owner is known exactly.
			if owner == localPlayer then return end
			if not esp.soundTeam and not Game.isEnemy(owner, true) then return end
		elseif not esp.soundTeam and label ~= "Utility" then
			-- Whoever stands closest to the source made the sound; a teammate there means it is not an enemy.
			local limit = group == "Footsteps" and 16 or 60
			local nearest, nearestDistance
			for _, entity in ipairs(Game.entities()) do
				if entity ~= localPlayer and not Neverlose.isDown(entity) then
					local reference = Neverlose.entityPosition(entity)
					if reference and math.abs(reference.Y - position.Y) < 30 then
						local distance = (Vector3.new(reference.X, 0, reference.Z) - Vector3.new(position.X, 0, position.Z)).Magnitude
						if distance < limit and (not nearestDistance or distance < nearestDistance) then nearest, nearestDistance = entity, distance end
					end
				end
			end
			if nearest and not Game.isEnemy(nearest, true) then return end
		end

		local now = os.clock()
		local shotFlag = isShot == true or (isShot == nil and label == "Shot")
		local ground = groundPoint(position, label)

		-- Каждый звук — своя метка. Раньше звук в пределах 16 стадов
		-- переиспользовал чужую метку: старый круг пропадал и «тянулся»
		-- к новому источнику. Теперь склеиваем только настоящий дубль
		-- одного события (remote + сам Sound в пределах кадра).
		local marker
		for _, existing in ipairs(markers) do
			local gap = existing.raw and (existing.raw - position).Magnitude or math.huge
			local sameKind = soundFamily(existing.label) == soundFamily(label)
				and (owner == nil or existing.owner == nil or existing.owner == owner)
			if sameKind and gap < 1.5 and now - existing.last < 0.12 then marker = existing break end
		end

		if not marker then
			if #markers >= 20 then killMarker(table.remove(markers, 1)) end
			local ring = newLines()
			local text = NewDrawing("Text")
			text.Size, text.Center, text.Outline, text.Font, text.Visible = 12, true, true, 2, false
			marker = { ring = ring, text = text }
			markers[#markers + 1] = marker
			stats.shown += 1
		end

		if marker.raw and marker.last and shotFlag == marker.wasShot and now - marker.last > 0.05 and now - marker.last < 1.5 then
			local flat = (position - marker.raw) / (now - marker.last)
			flat = Vector3.new(flat.X, 0, flat.Z)
			marker.vel = flat.Magnitude < 32 and flat or nil
		else
			marker.vel = nil
		end

		marker.wasShot = shotFlag
		marker.raw, marker.last = position, now
		marker.label = label
