-- The game's own client gates (pull-out time, action lockout) are lowered while Fast Equip is on, so manual shots are allowed at once too.
do
	local timings
	pcall(function() timings = require(replicatedStorage.Components.Common.WeaponTimings) end)
	if type(timings) == "table" then
		local original = {
			EQUIP_PULLOUT_FRACTION = timings.EQUIP_PULLOUT_FRACTION,
			DEFAULT_EQUIP_PULLOUT = timings.DEFAULT_EQUIP_PULLOUT,
			EQUIP_ACTION_LOCKOUT = timings.EQUIP_ACTION_LOCKOUT,
		}
		local function write(key, value)
			if timings[key] == value then return end
			local frozen = isreadonly and isreadonly(timings)
			if frozen and setreadonly then setreadonly(timings, false) end
			pcall(rawset, timings, key, value)
			if frozen and setreadonly then setreadonly(timings, true) end
		end
		local function apply()
			local features = Neverlose.config and Neverlose.config.features
			if not features then return end
			if features.fastEquip ~= false then
				local skip = features.equipSkip
				write("EQUIP_PULLOUT_FRACTION", skip and 0 or original.EQUIP_PULLOUT_FRACTION * math.clamp((features.equipReady or 100) / 100, 0.1, 1) / math.max(features.equipSpeed or 1, 1) ^ 0.5)
				write("DEFAULT_EQUIP_PULLOUT", skip and 0 or original.DEFAULT_EQUIP_PULLOUT * math.clamp((features.equipReady or 100) / 100, 0.1, 1) / math.max(features.equipSpeed or 1, 1) ^ 0.5)
				write("EQUIP_ACTION_LOCKOUT", skip and 0 or original.EQUIP_ACTION_LOCKOUT / math.max(features.equipSpeed or 1, 1))
			else
				for key, value in pairs(original) do write(key, value) end
			end
		end
		maid:give(runService.Heartbeat:Connect(apply))
		maid:give(function() for key, value in pairs(original) do write(key, value) end end)
	end
end

