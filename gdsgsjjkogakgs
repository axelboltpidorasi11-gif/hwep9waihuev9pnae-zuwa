function HitEffects.shockwave(position, color)
	for index = 0, 1 do
		task.delay(index * 0.12, function()
			local base = CFrame.new(position - Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, 0, math.pi / 2)
			local ring = HitEffects.glow(base, Vector3.new(0.15, 2, 2), color, Enum.PartType.Cylinder, 0.15)
