		local known = 0
		for _, entry in ipairs(list) do
			if entry.skin ~= "Stock" and Skins.inAssets(entry.skin) then known += 1 end
		end
		if known >= math.max(3, math.floor((#list - 1) * 0.3)) then
			for index = #list, 1, -1 do
				local entry = list[index]
				if entry.skin ~= "Stock" and not Skins.inAssets(entry.skin) then table.remove(list, index) end
			end
		end

		table.sort(list, function(a, b)
			if a.skin == "Stock" then return true end
			if b.skin == "Stock" then return false end
			if a.rank ~= b.rank then return a.rank > b.rank end
			return a.skin < b.skin
		end)
