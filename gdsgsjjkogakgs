	-- Настройки пункта ESP живут внутри самого пикера (picker.AddOptions): тумблеры, слайдеры и списки
	-- библиотеки. Вкладки Layout/Options/Colors/Glow = список "Page", остальные строки видны по странице.
	-- Цвет-настройки: пресет из списка или Custom (Hue + Light).
	local COLOR_PRESETS = {
		Black = Color3.fromRGB(0, 0, 0), White = Color3.fromRGB(255, 255, 255), Red = Color3.fromRGB(255, 70, 70),
		Orange = Color3.fromRGB(255, 160, 60), Yellow = Color3.fromRGB(255, 225, 80), Green = Color3.fromRGB(90, 255, 110),
		Cyan = Color3.fromRGB(80, 220, 255), Blue = Color3.fromRGB(70, 110, 255), Purple = Color3.fromRGB(170, 100, 255),
		Pink = Color3.fromRGB(255, 110, 200),
	}
	local COLOR_ORDER = { "Black", "White", "Red", "Orange", "Yellow", "Green", "Cyan", "Blue", "Purple", "Pink", "Custom" }
	local function sameColor(a, b)
		return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.02
	end
	local function colorFromHueLight(hue, light)
		hue, light = hue / 360, math.clamp(light, 0, 100)
		if light <= 50 then return Color3.fromHSV(hue, 1, light / 50) end
		return Color3.fromHSV(hue, 1 - (light - 50) / 50, 1)
	end
	local function hueLightOf(color)
		local h, sat, val = Color3.toHSV(color)
		local light = val < 1 and val * 50 or (100 - sat * 50)
		return math.floor(h * 360 + 0.5), math.floor(light + 0.5)
	end

	local function buildExtras(picker, defs)
		local state = { controls = {}, team = "Enemies" }
		for _, d in ipairs(defs) do d.key = d.key or d[3] end
		local function read(def)
			local value
			if def.global then value = esp[def.key] else value = esp.colors[state.team or "Enemies"][def.key] end
			if value == nil then value = def.default end
			return value
		end
		local function write(def, value)
			if def.global then esp[def.key] = value
			elseif def.both then esp.colors.Enemies[def.key], esp.colors.Teammates[def.key] = value, value
			else esp.colors[state.team or "Enemies"][def.key] = value end
		end
		local tabsOrder, seen = {}, {}
		for _, d in ipairs(defs) do
			d.tab = d[2] == "color" and "Colors" or (tostring(d[1]):find("Glow", 1, true) and "Glow") or (d[2] == "toggle" and "Options") or "Layout"
			if not seen[d.tab] then seen[d.tab] = true tabsOrder[#tabsOrder + 1] = d.tab end
		end
		local multi = #tabsOrder > 1
		local function onPage(tab)
			return function(values) return not multi or values.Page == tab end
		end
		local options = {}
		if multi then
			options[#options + 1] = { Type = "Dropdown", Name = "Page", Options = tabsOrder, Default = tabsOrder[1] }
		end
		for _, def in ipairs(defs) do
			local label, kind = def[1], def[2]
			local visible = onPage(def.tab)
			if kind == "toggle" then
				options[#options + 1] = { Type = "Toggle", Name = label, Default = read(def) == true, Visible = visible,
					Callback = function(value) write(def, value == true) end }
				state.controls[#state.controls + 1] = function() picker.SetOption(label, read(def) == true, true) end
			elseif kind == "slider" then
				local fallback = def.default or def.min
				options[#options + 1] = { Type = "Slider", Name = label, Min = def.min, Max = def.max, Suffix = def.suffix and (def.suffix == "px" and " px" or def.suffix) or nil,
					Default = tonumber(read(def)) or fallback, Visible = visible, Callback = function(value) write(def, value) end }
				state.controls[#state.controls + 1] = function() picker.SetOption(label, tonumber(read(def)) or fallback, true) end
			elseif kind == "dropdown" then
				options[#options + 1] = { Type = "Dropdown", Name = label, Options = def.options, Default = read(def) or def.options[1], Visible = visible,
					Callback = function(value) write(def, value) end }
				state.controls[#state.controls + 1] = function() picker.SetOption(label, read(def) or def.options[1], true) end
			else
				local hueName, lightName = label .. " Hue", label .. " Light"
				local function custom(values) return values[label] == "Custom" end
				local current = read(def)
				if typeof(current) ~= "Color3" then current = Color3.new(1, 1, 1) end
				local function presetOf(color)
					for _, name in ipairs(COLOR_ORDER) do
						local preset = COLOR_PRESETS[name]
						if preset and sameColor(preset, color) then return name end
					end
					return "Custom"
				end
				local hue0, light0 = hueLightOf(current)
				local function apply(values)
					local choice = values[label]
					if choice == "Custom" then write(def, colorFromHueLight(values[hueName] or hue0, values[lightName] or light0))
					elseif COLOR_PRESETS[choice] then write(def, COLOR_PRESETS[choice]) end
				end
				local function push(name, value)
					-- значения соседних опций читаются из самого пикера
					local values = { [label] = picker.GetOption(label), [hueName] = picker.GetOption(hueName), [lightName] = picker.GetOption(lightName) }
					values[name] = value
					apply(values)
				end
				options[#options + 1] = { Type = "Dropdown", Name = label, Options = COLOR_ORDER, Default = presetOf(current), Visible = visible,
					Callback = function(value) push(label, value) end }
				options[#options + 1] = { Type = "Slider", Name = hueName, Min = 0, Max = 360, Default = hue0,
					Visible = function(values) return visible(values) and custom(values) end, Callback = function(value) push(hueName, value) end }
				options[#options + 1] = { Type = "Slider", Name = lightName, Min = 0, Max = 100, Default = light0,
					Visible = function(values) return visible(values) and custom(values) end, Callback = function(value) push(lightName, value) end }
				state.controls[#state.controls + 1] = function()
					local color = read(def)
					if typeof(color) ~= "Color3" then return end
					local h, l = hueLightOf(color)
					picker.SetOption(label, presetOf(color), true)
					picker.SetOption(hueName, h, true)
					picker.SetOption(lightName, l, true)
				end
			end
		end
		picker.SetOptions(options)
		return state
	end

	local function onPicker(team, group, itemName, picker, createPicker)
		local defs = EXTRA[group .. "/" .. itemName]
		if not defs then return end
		local state = extraState[picker]
		if not state then
			state = buildExtras(picker, defs)
			extraState[picker] = state
		end
		state.team = team
		for _, refresh in ipairs(state.controls) do pcall(refresh) end
	end

