local Settings
do

Settings = { file = FOLDER .. "/settings.json", skipKeys = { skins = true }, saved = nil, version = 3 }

local function encodeValue(value)
	local kind = typeof(value)
	if kind == "Color3" then return { __color = { value.R, value.G, value.B } } end
	if kind == "string" or kind == "number" or kind == "boolean" then return value end
	if kind == "table" then

		local count, total = #value, 0
		for _ in pairs(value) do total += 1 end
		local out = {}
		if count > 0 and count == total then
			for index, item in ipairs(value) do out[index] = encodeValue(item) end
			return out
		end
		for key, item in pairs(value) do
			if type(key) == "string" or type(key) == "number" then
				local encoded = encodeValue(item)
				if encoded ~= nil then out[tostring(key)] = encoded end
			end
		end
		return out
	end
	return nil
end

local function decodeValue(value)
	if type(value) == "table" and type(value.__color) == "table" then
		return Color3.new(tonumber(value.__color[1]) or 1, tonumber(value.__color[2]) or 1, tonumber(value.__color[3]) or 1)
	end
	if type(value) == "table" then
		local out = {}
		for key, item in pairs(value) do out[key] = decodeValue(item) end
		return out
	end
	return value
end

local function mergeInto(target, saved)
	for key, value in pairs(saved) do
		local current = target[key]
		if current == nil then
			target[key] = decodeValue(value)
		elseif type(current) == "table" and type(value) == "table" and value.__color == nil then

			if (#value > 0 or next(value) == nil) and (#current > 0 or next(current) == nil) then
				target[key] = decodeValue(value)
			else
				mergeInto(current, value)
			end
		elseif typeof(current) == "Color3" and type(value) == "table" and value.__color then
			target[key] = decodeValue(value)
		elseif type(value) == type(current) then
			target[key] = value
		end
	end
end

function Settings.encode()
	local config = {}
	for key, value in pairs(Neverlose.config) do
		if not Settings.skipKeys[key] then config[key] = encodeValue(value) end
	end
	local data = { version = Settings.version, config = config, extras = {} }
	local window = Neverlose.window

	for key, extra in pairs(window and window._configExtras or {}) do
		if type(extra) == "table" and type(extra.get) == "function" then
			local ok, result = pcall(extra.get)
			local encoded = ok and encodeValue(result) or nil
			if encoded ~= nil then data.extras[key] = encoded end
		end
	end

	for key, previous in pairs(Settings.saved and Settings.saved.extras or {}) do
		if data.extras[key] == nil then data.extras[key] = previous end
	end
	return httpService:JSONEncode(data)
end

function Settings.restoreExtras()
	local window = Neverlose.window
	local saved = Settings.saved and Settings.saved.extras
	if not (window and window._configExtras and type(saved) == "table") then return end
	for key, value in pairs(saved) do
		local extra = window._configExtras[key]
		if type(extra) == "table" and type(extra.set) == "function" then pcall(extra.set, decodeValue(value)) end
	end
end

function Settings.load()
	if not (isfile and readfile and isfile(Settings.file)) then return end
	local ok, data = pcall(function() return httpService:JSONDecode(readfile(Settings.file)) end)
	if not ok or type(data) ~= "table" then return end
	if data.version ~= Settings.version then return end
	Settings.saved = data
	if type(data.config) == "table" then
		for key, value in pairs(data.config) do
			if type(value) == "table" and type(Neverlose.config[key]) == "table" and not Settings.skipKeys[key] then
				mergeInto(Neverlose.config[key], value)
			end
		end
	end
end

pcall(Settings.load)

end

