local function newText(properties)
	local store = {
		Text = "", Position = Vector2.zero, Color = Color3.new(1, 1, 1), Size = properties.Size or 13,
		Align = properties.Center and "Center" or "Left", Visible = false, Transparency = 1, FontName = "Plex", Glow = false,
	}
	local drawing = draw("Text", { Size = store.Size, Center = store.Align ~= "Left", Outline = true, Font = 2, Visible = false })

	local function makeLabel(zIndex, color)
		local made, label = pcall(newInstance, "TextLabel", {
			Name = randomName(), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
			Size = UDim2.fromOffset(320, 240), Text = "", TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			TextScaled = false, TextWrapped = false, RichText = false, TextTruncate = Enum.TextTruncate.None,
			TextStrokeTransparency = 1, ZIndex = zIndex,
		}, uiRoot)
		if made then
			maid:give(label)
			return label
		end
		return nil
	end
	local label = makeLabel(5, Color3.new(1, 1, 1))
	local shadow = label and makeLabel(4, Color3.new(0, 0, 0)) or nil

	local function each(callback)
		if label then callback(label) end
		if shadow then callback(shadow) end
	end

	local function pixelMode()
		local name = store.FontName
		return label ~= nil and (PIXEL_FONTS[name] ~= nil or FONT_SOURCES[name] ~= nil)
	end

	local faceKey
	local function applyFace()
		if not label then return end
		local name = store.FontName
		local custom = FONT_SOURCES[name] and customFonts[name] or nil
		local key = custom and name or (PIXEL_FONTS[name] and name or "Code")
		if key == faceKey then return end
		faceKey = key
		each(function(target)
			if custom then target.FontFace = custom else target.Font = PIXEL_FONTS[name] or Enum.Font.Code end
		end)
	end

	local function push(key)
		if pixelMode() then
			if key == "Text" then
				applyFace()
				each(function(target) target.Text = store.Text end)
			elseif key == "Position" then
				local x, y = math.floor(store.Position.X + 0.5), math.floor(store.Position.Y + 0.5)
				label.Position = UDim2.fromOffset(x, y)
				if shadow then shadow.Position = UDim2.fromOffset(x + 1, y + 1) end
			elseif key == "Color" then label.TextColor3 = store.Color
			elseif key == "Size" then
				local pixels = math.floor(store.Size + 0.5)
				each(function(target) target.TextSize = pixels end)
			elseif key == "Transparency" then
				label.TextTransparency = 1 - store.Transparency
				if shadow then shadow.TextTransparency = 1 - store.Transparency * 0.9 end
			elseif key == "Align" then
				local anchor = store.Align == "Center" and 0.5 or (store.Align == "Right" and 1 or 0)
				local alignment = store.Align == "Center" and Enum.TextXAlignment.Center or (store.Align == "Right" and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left)
				each(function(target)
					target.AnchorPoint = Vector2.new(anchor, 0)
					target.TextXAlignment = alignment
				end)
			elseif key == "Visible" then
				each(function(target) target.Visible = store.Visible end)
			elseif key == "Glow" then
				label.TextStrokeColor3 = store.Glow or Color3.new()
				label.TextStrokeTransparency = store.Glow and 0.35 or 1
			end
		else
			if key == "Align" then
				drawing.Center = store.Align ~= "Left"
				push("Position")
			elseif key == "Position" then
				local at = store.Position
				if store.Align == "Right" then at = at - Vector2.new(#store.Text * store.Size * 0.28, 0) end
				drawing.Position = at
			elseif key == "Text" then
				drawing.Text = store.Text
				if store.Align == "Right" then push("Position") end
			elseif key == "Glow" then
				drawing.OutlineColor = store.Glow or Color3.new()
			else
				drawing[key] = store[key]
			end
		end
	end
	local function refresh()
		drawing.Visible = false
		each(function(target) target.Visible = false end)
		if pixelMode() then
			faceKey = nil
			applyFace()
		else
			drawing.Font = DRAW_FONTS[store.FontName] or 2
		end
		for _, key in ipairs({ "Text", "Size", "Color", "Transparency", "Align", "Position", "Visible", "Glow" }) do push(key) end
	end

	return setmetatable({}, {
		__index = function(_, key)
			if key == "Remove" then
				return function()
					pcall(function() drawing:Remove() end)
					each(function(target) pcall(function() target:Destroy() end) end)
				end
			end
			if key == "Center" then return store.Align == "Center" end
			return store[key]
		end,
		__newindex = function(_, key, value)
			if key == "Font" or value == nil then return end
			if key == "Center" then key, value = "Align", value and "Center" or "Left" end
			if key == "FontName" then
				if store.FontName ~= value then
					store.FontName = value
					refresh()
				end
				return
			end
			if store[key] == value then return end
			store[key] = value
			push(key)
		end,
	})
end

