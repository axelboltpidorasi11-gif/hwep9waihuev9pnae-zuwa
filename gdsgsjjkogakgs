local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.CollisionGroup = "Bullet"

local losList
function Ballistics.visible(origin, position, character)
	local list = Ballistics.ignoreList()
	if losList ~= list then
		losList = list
		losParams.FilterDescendantsInstances = list
	end
	for _ = 1, 8 do
		local result = workspaceService:Raycast(origin, position - origin, losParams)
		if not result then return true end
		if character and result.Instance:IsDescendantOf(character) then return true end
		if not isPassThrough(result.Instance) then return false end
		losParams:AddToFilter(result.Instance)
		losList = nil
	end
	return false
end

function Ballistics.passesCondition(condition, origin, part, character)
	if condition == "Through Walls" or condition == "None" then return true end
	if not Ballistics.visible(origin, part.Position, character) then return false end
	if condition == "Visible Only" then
		return not Ballistics.throughSmoke(origin, part.Position)
	end
	return true
end

function Ballistics.spread(weapon)
	local bullet = weapon and weapon.Bullet
	if type(bullet) ~= "table" or type(bullet.getTrueSpread) ~= "function" then return 0 end
	local ok, value = pcall(bullet.getTrueSpread, bullet)
	if not ok or type(value) ~= "number" then return 0 end
	return math.rad(value)
end

function Ballistics.hitChance(spread, distance, radius)
	if spread <= 1e-4 then return 100 end
	local cone = math.tan(spread) * distance
	if cone <= radius then return 100 end
	return math.clamp((radius / cone) ^ 2 * 100, 0, 100)
end

