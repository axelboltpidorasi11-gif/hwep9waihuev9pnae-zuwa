function Rage.applyWeaponProfile(weapon)
	local config = Neverlose.config.rage
	-- Оружие из своей группы: значения ведёт группа (настройки группы в меню), автопрофиль не вмешивается.
	if Neverlose.inCustomGroup and Neverlose.inCustomGroup() then Rage.profileKey = nil return end
	local profilesOn = config.weaponProfilesOn ~= false
	local originAuto = config.originFields ~= "Manual"
	-- Milk: Range & Scans в режиме Auto ведёт профиль оружия, даже если общий Weapon Profiles выключен.
	if not profilesOn and not originAuto then Rage.profileKey = nil return end
	if not weapon then return end
	local key = weapon.Identifier or weapon.Name
	if type(key) ~= "string" or key == "" or key == Rage.profileKey then return end
	local profile = Rage.weaponProfileFor(weapon)
	if not profile then return end
	Rage.profileKey = key
	local manual = config.manualFields
	if type(manual) ~= "table" then manual = {} config.manualFields = manual end
	local changed = false
	for name, value in pairs(profile) do
		local allowed = profilesOn or (originAuto and (name == "originRange" or name == "originScans"))
		if allowed and not manual[name] and config[name] ~= value then
			config[name] = value
			changed = true
		end
	end
	if changed then
		if Rage.syncOriginUi then pcall(Rage.syncOriginUi) end
	end
end

-- Автопрофиль работает даже при выключенном рейдже: значения в меню и в
-- Probe Report всегда соответствуют текущему оружию, а не старому конфигу.
maid:give(runService.Heartbeat:Connect(function()
	if os.clock() - (Rage.profileCheckAt or 0) < 0.5 then return end
	Rage.profileCheckAt = os.clock()
	local weapon = Game.weapon()
	if weapon then pcall(Rage.applyWeaponProfile, weapon) end
end))

-- Есть ли вообще враг в радиусе/FOV: дешёвая проверка без трассировки. Нужна,
-- чтобы не запускать скан «всё тело» тогда, когда в поле никого нет.
function Rage.anyInReach(weapon, config)
	local origin = Game.origin()
	local range = weapon and weapon.Properties and weapon.Properties.Range or 500
	local fovPixels = (tonumber(config.fov) or 180) >= 180 and math.huge or fovToPixels(config.fov)
	for _, entity in ipairs(Game.entities()) do
		if Game.isEnemy(entity, true) then
			local character = Game.character(entity)
			if character and not Game.isImmune(character) and Rage.inReach(character, origin, range, fovPixels) then return true end
		end
	end
	return false
end

function Rage.refresh(weapon, config)
	if weapon then pcall(Rage.applyWeaponProfile, weapon) end
	local now = os.clock()

	local scanMs = (Neverlose.stats or {}).scanMs or 99
	local fast = config.scanMode == "Performance"
	-- Scan Rate goes up to 240 Hz; Performance caps it at 60. With targets in the list the scan runs at least at 120 Hz so
	-- a new wallbang is caught on the next frame; with none it searches at the top rate (an empty scan costs almost nothing).
	local rate = math.clamp(tonumber(config.scanHz) or 30, 1, 240)
	if fast then rate = math.min(rate, 60) end
	local interval = 1 / rate
	if #Rage.targets == 0 then
		interval = math.min(interval, 1 / 240)
	else
		interval = math.min(interval, 1 / 120)
	end
	-- Frame guard: a scan may not eat more than ~60% of a frame, so the rate falls to what the raycasts allow
	if scanMs > 0.4 then interval = math.max(interval, scanMs * 0.6 / 1000) end
	-- Wall Aggression ниже 100: при автоволле пересканируем реже.
	local aggro = math.clamp((tonumber(config.wallAggro) or 100) / 100, 0, 1)
	if config.autowall and aggro < 1 then interval = interval / (0.3 + 0.7 * aggro) end
	if now - Rage.lastScan >= interval then
		Rage.lastScan = now
		local scanStart = os.clock()
		local results = Rage.scanAll(weapon, hitboxParts(config.hitboxList, config.hitboxes), setFromSet(hitboxParts(config.multipointList, config.multipoint, true)), config.fov)
		local scanTime = (os.clock() - scanStart) * 1000
		local st = Neverlose.stats or {}
		Neverlose.stats = st
		st.scanMs = (st.scanMs or scanTime) * 0.8 + scanTime * 0.2
		st.scanMax = math.max(st.scanMax or 0, scanTime)

		if Rage.sticky then
			for _, entry in ipairs(results) do
				if entry.entity == Rage.sticky then entry.score -= 30 end
			end
			table.sort(results, function(a, b) return a.score < b.score end)
		end
		Rage.sticky = results[1] and results[1].entity or nil
		Rage.targets = results
	else
		for index = #Rage.targets, 1, -1 do
			local entry = Rage.targets[index]
			if not (entry.part and entry.part.Parent) or not Game.character(entry.entity) then table.remove(Rage.targets, index) end
		end
	end
	return Rage.targets
end

function Rage.requiredChance(weapon, target, config)
	local fixedChance = config.hitChance or 0
	if fixedChance > 0 and config.autoHitChance == false then return fixedChance end
	local properties = weapon.Properties
	local need
	if Game.isSniper(weapon) then
		need = 75
	elseif (properties.BulletsPerShot or 1) > 1 then
		need = 40
	elseif (properties.FireRate or 0.1) < 0.1 then
		need = 50
	else
		need = 65
	end
	if (target.distance or 100) < 20 then need -= 10 end
	if (target.damage or 0) >= (target.health or 100) then need -= 15 end
	local streak = Rage.missStreak and Rage.missStreak[target.entity]
	if streak and os.clock() - streak.t < 2.5 then need += math.min(streak.n * 3, 9) end
	need += Rage.accuracyBonus()
	return math.clamp(need, 20, 95)
end

-- Recent real results tune how picky the ragebot is: many misses -> wait for better shots.
Rage.accWindow = {}
function Rage.recordShot(ok)
	local tag = Rage.leadTag
	if tag and os.clock() - tag.at < 1.5 then
		Rage.leadTag = nil
		local st = Rage.leadStats[tag.arm] or { n = 0, h = 0 }
		Rage.leadStats[tag.arm] = st
		st.n += 1
		if ok then st.h += 1 end
		if st.n > 24 then st.n, st.h = st.n / 2, st.h / 2 end
	end
	local window = Rage.accWindow
	if #window > 0 and os.clock() - (Rage.accAt or 0) > 25 then table.clear(window) end
	Rage.accAt = os.clock()
	window[#window + 1] = ok
	if #window > 12 then table.remove(window, 1) end
end
function Rage.accuracyBonus()
	local window = Rage.accWindow
	if #window < 5 or os.clock() - (Rage.accAt or 0) > 25 then return 0 end
	local hits = 0
	for _, ok in ipairs(window) do if ok then hits += 1 end end
	local rate = hits / #window
	if rate < 0.35 then return 14 end
	if rate < 0.5 then return 9 end
	if rate < 0.65 then return 4 end
	if rate > 0.85 then return -3 end
	return 0
end
Events.on("hit", function()
	Rage.recordShot(true)
	Neverlose.stats = Neverlose.stats or {}
	Neverlose.stats.hitCount = (Neverlose.stats.hitCount or 0) + 1
end)
Events.on("kill", function() Rage.recordShot(true) end)

-- Учёт попаданий для диагностики (ведра пинга / лидирование / путь) и строка в hitLog.
local function logHit(shot, damage)
	if type(shot) ~= "table" then return end
	local stats = Neverlose.stats or {}
	Neverlose.stats = stats
	ShotTracker.account(shot, true)
	local info = shot.info or {}
	stats.hitLog = stats.hitLog or {}
	table.insert(stats.hitLog, ("%s | %s | %s | hc %s | %s st | mode %s | shift %s | %s"):format(
		tostring(shot.weapon), tostring(shot.part), damage and ("-" .. math.floor(damage + 0.5)) or "kill",
		tostring(info.chance and math.floor(info.chance + 0.5)), tostring(info.distance and math.floor(info.distance + 0.5)), tostring(info.mode),
		tostring(info.shiftMag and math.floor(info.shiftMag * 10 + 0.5) / 10), ShotTracker.tag(shot)))
	if #stats.hitLog > 40 then table.remove(stats.hitLog, 1) end
end
Events.on("hit", function(_, shot, damage) pcall(logHit, shot, damage) end)
Events.on("kill", function(_, shot) pcall(logHit, shot, nil) end)

local function rageStep()
	local config = Neverlose.config.rage
	Rage.target, Rage.stopping, Rage.shooting = nil, false, false
	if not config.enabled or Game.isChatting() or not Game.localCharacter() then
		Rage.stable = 0
		Rage.targets = {}
		return
	end

	local weapon = Game.weapon()
	if not (weapon and weapon.Bullet and weapon.Properties) then return end

	local targets = Rage.refresh(weapon, config)
	local target = targets[1]
	Rage.target = target
	if target then Rage.lastTargetAt = os.clock() end
	if target then
		-- Диагностика: сколько непрерывно эта цель остаётся целью рейджа (для строки отчёта).
		local track = Rage.visTrack
		if not track then track = { last = -1 } Rage.visTrack = track end
		local stamp = os.clock()
		if track.entity ~= target.entity or stamp - track.last > 0.3 then track.entity, track.since = target.entity, stamp end
		track.last = stamp
	end
	if target and not Rage.seenAt then
		Rage.seenAt = os.clock()
	elseif not target and os.clock() - (Rage.lastTargetAt or 0) > 0.3 then
		Rage.seenAt = nil
	end
	Rage.stable = target and Rage.stable + 1 or ((os.clock() - (Rage.lastTargetAt or 0) < 0.12) and Rage.stable or 0)
	if not (target and config.autoFire and Game.weaponReady(weapon)) then return end

	if config.quickStop then Rage.stopping = true end

	local sniper = Game.isSniper(weapon)
	local revolver = weapon.Properties.ShootingOptions == "Revolver"

	local slowGun = (weapon.Properties.FireRate or 0.1) >= 0.3
	local direct = not revolver and ((config.doubleTap and not slowGun) or (config.rapidFire and Rage.rapidCapable(weapon)))
	local need = Rage.requiredChance(weapon, target, config)
	-- An enemy that just stepped out gets shot at once, before he steps back.
	local fresh = Rage.seenAt and os.clock() - Rage.seenAt < 0.45 and (target.walls or 0) == 0 and (target.damage or 0) >= math.max(config.minDamage or 0, 1)
	-- Shoot Visible First: открытая цель стреляется сразу, без ожидания стабильности, Delay Shot и паузы после промахов.
	local fastOpen = config.visFast == true and (target.walls or 0) == 0 and not target.record
		and (target.damage or 0) >= math.max(config.minDamage or 0, 1)

	-- A target strafing across the line of fire is the main source of misses at range.
	local lateral = 0
	do
		local velocity = Ballistics.velocity(target.entity)
		local line = target.position and target.position - Game.origin()
		if velocity and line and line.Magnitude > 1 then
			local dir = line.Unit
			lateral = (velocity - dir * velocity:Dot(dir)).Magnitude
		end
	end
	if lateral > 14 and not fresh and not fastOpen and (target.distance or 0) > 35 then need = math.min(need + math.min((lateral - 14) * 0.8, 12), 97) end
	if Rage.stable < 1 and not (fresh or fastOpen) then return end

	if (target.walls or 0) > 0 then
		need = math.min(need + 4, 97)
		if Rage.stable < 2 then return end
	end
	local bar = fresh and need * 0.75 or need
	if fastOpen then bar = math.min(bar, math.clamp(need * 0.6, 25, 55)) end
	if not direct and target.chance < bar then return end
	if direct and target.chance < need * 0.65 and (target.damage or 0) < (target.health or 100) then return end
	if direct and (target.walls or 0) > 0 and target.chance < need then return end
	local delayList = type(config.delayShot) == "table" and config.delayShot or {}
	local needDamage, needChance = table.find(delayList, "Damage"), table.find(delayList, "Hit Chance")
	if (needDamage or needChance) and not fastOpen and not (fresh and target.chance >= need * 0.75) then
		if Rage.stable < 3 then return end
		if Rage.delayEntity ~= target.entity then Rage.delayEntity, Rage.delaySince = target.entity, os.clock() end
		local ready = true
		if needDamage and (target.damage or 0) < math.max(config.minDamage, math.min(target.health or 100, 40)) then ready = false end
		if needChance and target.chance < math.min(need + 10, 99) then ready = false end
		if not ready and os.clock() - (Rage.delaySince or 0) < 0.3 then return end
	end

	local streak = Rage.missStreak and Rage.missStreak[target.entity]
	if streak and streak.n >= 2 and os.clock() - streak.t < 1.2 and not fresh and not fastOpen then
		if Rage.stable < 2 then return end
	end

	if sniper then
		local scoped = weapon.IsSniperScoped or (weapon.CurrentScopeIncrement or 0) > 0
		scoped = true
		if not scoped then
			if mouse2click and os.clock() - (Rage.scopeAsked or 0) > 0.5 then
				Rage.scopeAsked = os.clock()
				mouse2click()
			end
			return
		end
		if os.clock() - (Rage.scopeAsked or 0) < ((config.quickScope or fresh or fastOpen) and 0.02 or 0.12) then return end
		if config.quickStop and (Rage.selfSpeed or 0) > 4 then return end
	end

	local now = os.clock()
	local alternate = revolver and weapon.Properties.FireModes and weapon.Properties.FireModes.Secondary
	local fireRate = alternate and alternate.FireRate or weapon.Properties.FireRate or 0.1
	local semiAuto = fireRate >= 0.3 or weapon.Properties.FireMode == "Semi" or weapon.Properties.ShootingOptions == "Semi"
	local recentMiss = Rage.missStreak and Rage.missStreak[target.entity]
	local cooling = (recentMiss and recentMiss.n >= 2 and os.clock() - recentMiss.t < 1.5) or os.clock() < (Rage.rapidCoolUntil or 0)
	local rapidOk = not fresh and (target.walls or 0) == 0 and target.chance >= math.min(need + 5, 97) and (target.distance or 0) < 80 and lateral < 10 and Rage.stable >= 6 and Rage.accuracyBonus() <= 4
	local multiplier = (config.rapidFire and not semiAuto and not cooling and rapidOk) and math.max(Rage.rapidMultiplier(config, fireRate, weapon.Name), 1) or 1
	local cadence = math.max(fireRate / multiplier + 0.012, 0.055)
	if now - lastShot < cadence then return end
	if semiAuto then
		local waiting = ShotTracker.pending[target.entity]
		if waiting and now - waiting.t < math.min(fireRate + 0.12, 0.45) then return end
	end
	local retryAt = now - cadence + 0.07
	lastShot = now
	Rage.shooting = true
	local shotStats = Neverlose.stats or {}
	Neverlose.stats = shotStats
	shotStats.attempts = (shotStats.attempts or 0) + 1
	shotStats.reactMs = (now - (Rage.seenAt or now)) * 1000
	Rage.delayEntity = nil

	local multi = config.multiTarget and #targets > 1
	if not revolver and (direct or (multi and not slowGun) or (config.doubleTap and not slowGun)) then
		local list = {}
		for _, entry in ipairs(targets) do
			if direct or entry.chance >= Rage.requiredChance(weapon, entry, config) then list[#list + 1] = entry end
		end
		if #list == 0 then list[1] = target end

		local perTarget = (config.doubleTap and not slowGun and (weapon.Rounds or 0) >= 2 and (target.walls or 0) == 0) and 2 or 1
		local budget = (config.multiTarget and #list or 1) * perTarget
		local gap = perTarget == 2 and Rage.tapGap(fireRate) or 0
		Rage.lastGap = gap

		local plan = {}
		for _, entry in ipairs(list) do
			if budget <= 0 then break end
			local need = entry.damage > 0 and math.ceil(entry.health / entry.damage) or 1
			local count = math.clamp(need, 1, math.min(perTarget, budget))
			plan[#plan + 1] = { entry = entry, count = count }
			budget -= count
			if not (config.multiTarget or config.doubleTap) then break end
		end

		local fired = 0
		for _, step in ipairs(plan) do
			for tapIndex = 1, step.count do
				if config.autoReload and config.remoteReload and (weapon.Rounds or 0) <= config.reloadAt then Rage.remoteReload(weapon) end
				if (weapon.Rounds or 0) <= 0 then break end
				if tapIndex == 1 or gap <= 0 then
					if Rage.remoteFire(weapon, step.entry, tapIndex) then fired += 1 end
				else
					local entry = step.entry
					task.delay(gap, function()
						if not Game.weaponReady(weapon) then return end

						if (Neverlose.isDown and Neverlose.isDown(entry.entity)) or not Game.character(entry.entity) then return end
						local again = Rage.target
						if not (again and again.entity == entry.entity) then again = entry end
						Rage.remoteFire(weapon, again, tapIndex)
					end)
					fired += 1
				end
			end
		end

		if fired > 0 then
			lastShot = now + (fired > 1 and (gap > 0 and gap or fireRate) or 0)
			return
		end
		if Rage.lastFail and os.clock() - (Rage.failLogAt or 0) > 2 then
			Rage.failLogAt = os.clock()
			Logs.push("Combat", "direct shot refused · " .. Rage.lastFail)
		end

		if multi or Rage.lastFail == "aim point blocked or out of range" then
			lastShot = retryAt
			return
		end
	end

	-- Instant Shot: пуля уходит напрямую тем же путём, что double tap, без синтетического клика. Не вышло — обычный клик.
	if config.instantShot == true and not revolver then
		local okInstant, sent = pcall(Rage.remoteFire, weapon, target, 1, true)
		if okInstant and sent then
			Rage.clickAt = os.clock()
			return
		end
		if Rage.lastFail == "aim point blocked or out of range" and ((target.walls or 0) > 0 or target.record) then
			lastShot = retryAt
			return
		end
	end

	if not Rage.aimBullet({ Origin = Game.origin() }, target, weapon) then
		shotStats.refused = (shotStats.refused or 0) + 1
		-- An open-line target is still shot: the send hook re-aims the bullet at him instead of the crosshair.
		if (target.walls or 0) > 0 or target.record then
			lastShot = retryAt
			return
		end
	end
	shotStats.shots = (shotStats.shots or 0) + 1
	Rage.clickAt = os.clock()

	if revolver and mouse2click then
		mouse2click()
	elseif mouse1click then
		mouse1click()
	end
end

local lastRageError
maid:give(runService.Heartbeat:Connect(function()
	local ok, err = pcall(rageStep)
	if not ok and err ~= lastRageError then
		lastRageError = err
		warn("[Neverlose] ragebot error: " .. tostring(err))
	end
end))

-- Multipoint Visual: точки хитбоксов цели, видны сквозь стены. Это 2D-точки поверх экрана (выше слоя Neon-чамсов),
-- поэтому оверлей чамсов их не перекрывает. Набор точек считается раз в 0.2 с, позиция каждый кадр.
do
	local dots, list, shown, lastAt = {}, {}, 0, 0
	local gui = newInstance("ScreenGui", { Name = randomName(), ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20 }, hiddenRoot)
	maid:give(gui)
	local function dot(index)
		local item = dots[index]
		if not item then
			local frame = newInstance("Frame", {
				Name = randomName(), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(7, 7),
				BorderSizePixel = 0, BackgroundTransparency = 0.1, Visible = false, Active = false,
			}, gui)
			newInstance("UICorner", { CornerRadius = UDim.new(1, 0) }, frame)
			newInstance("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.35, Thickness = 1 }, frame)
			item = { frame = frame }
			dots[index] = item
		end
		return item
	end
	local function refresh()
		local config = Neverlose.config.rage
		local color = config.multipointColor
		table.clear(list)
		if config.enabled and config.multipointVisual ~= false and typeof(color) == "Color3" then
			local count = math.clamp(math.floor(tonumber(config.multipointCount) or 4), 0, 10)
			local names = hitboxParts(config.multipointList, config.multipoint, true)
			local targets = Rage.targets or {}
			for index = 1, math.min(#targets, 3) do
				local character = targets[index] and targets[index].character
				if character and character.Parent then
					for _, name in ipairs(names) do
						local part = character:FindFirstChild(name)
						if part then
							for _, point in ipairs(Ballistics.points(part, true, count)) do
								if #list >= 96 then break end
								local okLocal, localCf = pcall(function() return part.CFrame:ToObjectSpace(CFrame.new(point)) end)
								if okLocal then list[#list + 1] = { part = part, offset = localCf, color = color } end
							end
						end
					end
				end
			end
		end
	end
	local function place()
		local camera = workspaceService.CurrentCamera
		local used = 0
		if camera then
			for _, entry in ipairs(list) do
				local part = entry.part
				if part and part.Parent then
					local screen, onScreen = camera:WorldToViewportPoint((part.CFrame * entry.offset).Position)
					if onScreen and screen.Z > 0 then
						used += 1
						local item = dot(used)
						local frame = item.frame
						frame.Position = UDim2.fromOffset(screen.X, screen.Y)
						if item.color ~= entry.color then item.color = entry.color frame.BackgroundColor3 = entry.color end
						if not frame.Visible then frame.Visible = true end
					end
				end
			end
		end
		for index = used + 1, shown do
			local item = dots[index]
			if item and item.frame.Visible then item.frame.Visible = false end
		end
		shown = used
	end
	maid:give(runService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - lastAt >= 0.2 then
			lastAt = now
			pcall(refresh)
		end
		pcall(place)
	end))
end

Events.on("shot", function()
	if Neverlose.config.rage.quickPeek and Neverlose.config.rage.peekReturn == "Shot" and Rage.peekOrigin then
		Rage.peekReturning = true
	end
end)

Events.on("kill", function()
	if Neverlose.config.rage.quickPeek and Neverlose.config.rage.peekReturn == "Kill" and Rage.peekOrigin then
		Rage.peekReturning = true
	end
end)

Input.add(10, function(self, frame)
	local config = Neverlose.config.rage
	if not config.enabled and not config.quickPeek then
		Rage.peekOrigin, Rage.peekReturning = nil, false
		return
	end

	do
		local velocity = typeof(self.GlobalVelocity) == "Vector3" and self.GlobalVelocity or Vector3.zero
		Rage.selfSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		Rage.selfVelocity = velocity
	end

	if Rage.stopping and self.OnGround then
		local velocity = typeof(self.GlobalVelocity) == "Vector3" and self.GlobalVelocity or Vector3.zero
		local flat = Vector3.new(velocity.X, 0, velocity.Z)
		if flat.Magnitude > 2 then
			Input.moveToward(frame, -flat, 1)
		else
			frame.Move = Vector2.zero
		end
	end

	if config.enabled and config.duckPeek then
		Input.setButton(frame, "Duck", not Rage.shooting and not Neverlose.onStairs(self))
	end

	local root = self.HumanoidRootPart
	if config.quickPeek and root then
		Rage.peekOrigin = Rage.peekOrigin or root.Position
		if Rage.peekReturning then
			local offset = Rage.peekOrigin - root.Position
			if Vector3.new(offset.X, 0, offset.Z).Magnitude < 1 then
				Rage.peekReturning = false
			else
				Input.moveToward(frame, offset, 1)
			end
		end
	else
