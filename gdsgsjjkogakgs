local HudShift
do

local function IsAncestorVisibleSafe(object)
	local node = object
	while node and not node:IsA("LayerCollector") do
		if node:IsA("GuiObject") and not node.Visible then return false end
		node = node.Parent
	end
	return true
end

HudShift = { state = setmetatable({}, { __mode = "k" }) }

local function contentRect(frame)
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible and child.AbsoluteSize.X > 4 and child.AbsoluteSize.Y > 4
			and child.AbsoluteSize.X < frame.AbsoluteSize.X * 0.95 then
			local position, size = child.AbsolutePosition, child.AbsoluteSize
			minX, minY = math.min(minX, position.X), math.min(minY, position.Y)
			maxX, maxY = math.max(maxX, position.X + size.X), math.max(maxY, position.Y + size.Y)
		end
	end
	if minX == math.huge then return nil end
	return minX, minY, maxX, maxY
end

local function targetsOf()
	local gui = localPlayer:FindFirstChild("PlayerGui")
	local main = gui and gui:FindFirstChild("MainGui")
	local gameplay = main and main:FindFirstChild("Gameplay")
	if not gameplay then return {} end
	local middle = gameplay:FindFirstChild("Middle")
	return {
		{ frame = gameplay:FindFirstChild("Top"), down = true, rectOf = contentRect },
		{ frame = middle and middle:FindFirstChild("KillFeed"), down = true, rectOf = function(frame)
			local position, size = frame.AbsolutePosition, frame.AbsoluteSize
			return position.X, position.Y, position.X + size.X, position.Y + math.min(size.Y, 60)
		end },
		{ frame = gameplay:FindFirstChild("Bottom"), down = false, rectOf = contentRect },
	}
end

function HudShift.start()
	local lastMeasure = 0
	local wanted = setmetatable({}, { __mode = "k" })

	local function measure()
		local watermark = Neverlose.window and Neverlose.window.Watermark and Neverlose.window.Watermark.frame
		local wmOn = watermark ~= nil and watermark.Parent ~= nil and watermark.Visible and IsAncestorVisibleSafe(watermark)
		local wx, wy, ww, wh
		if wmOn then
			wx, wy, ww, wh = watermark.AbsolutePosition.X, watermark.AbsolutePosition.Y, watermark.AbsoluteSize.X, watermark.AbsoluteSize.Y
			if ww < 4 then wmOn = false end
		end
		local wmTop = wmOn and wy < currentCamera.ViewportSize.Y / 2 - 58
		for _, target in ipairs(targetsOf()) do
			local frame = target.frame
			local entry = frame and HudShift.state[frame]
			if entry then
				local value = 0
				if wmOn and ((target.down and wmTop) or (not target.down and not wmTop)) then
					local x1, y1, x2, y2 = target.rectOf(frame)
					if x1 then
						y1, y2 = y1 - entry.shift, y2 - entry.shift
						if x2 > wx and x1 < wx + ww then
							if target.down then value = math.max(0, wy + wh + 6 - y1) else value = -math.max(0, y2 - (wy - 6)) end
						end
					end
				end
				local current = wanted[frame] or 0
				if value == 0 or current == 0 or math.abs(value - current) > 4 then wanted[frame] = value end
			end
		end
	end

	maid:give(runService.RenderStepped:Connect(function(delta)
		for _, target in ipairs(targetsOf()) do
			local frame = target.frame
			if frame then
				local entry = HudShift.state[frame]
				if not entry then
					entry = { original = frame.Position, applied = frame.Position, shift = 0 }
					HudShift.state[frame] = entry
				end

				if frame.Position ~= entry.applied then entry.original = frame.Position end
				local goal = wanted[frame] or 0
				if math.abs(goal - entry.shift) < 0.25 then entry.shift = goal else entry.shift += (goal - entry.shift) * math.min(1, delta * 12) end
				local position = UDim2.new(entry.original.X.Scale, entry.original.X.Offset, entry.original.Y.Scale, entry.original.Y.Offset + entry.shift)
				entry.applied = position
				if entry.shift ~= 0 or frame.Position ~= position then frame.Position = position end
			end
		end
		if os.clock() - lastMeasure >= 0.3 then
			lastMeasure = os.clock()
			pcall(measure)
		end
	end))
	maid:give(function()
		for frame, entry in pairs(HudShift.state) do
			pcall(function() frame.Position = entry.original end)
		end
	end)
end

end

