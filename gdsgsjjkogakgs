		if light.noShadows then
			save("shadows", { lightingService.GlobalShadows })
			lightingService.GlobalShadows = false
		else
			restore("shadows", function(values) lightingService.GlobalShadows = values[1] end)
		end

		if light.exposure then
			save("exposure", { lightingService.ExposureCompensation })
			lightingService.ExposureCompensation = light.exposureValue / 100
		else
			restore("exposure", function(values) lightingService.ExposureCompensation = values[1] end)
		end

		if light.fog then
			save("fog", { lightingService.FogStart, lightingService.FogEnd, lightingService.FogColor, {} })
			lightingService.FogStart, lightingService.FogEnd, lightingService.FogColor = light.fogStart, light.fogEnd, light.fogColor
			for _, atmosphere in ipairs(lightingService:GetChildren()) do
				if atmosphere:IsA("Atmosphere") then
					saved.fog[4][atmosphere] = saved.fog[4][atmosphere] or { atmosphere.Density, atmosphere.Color }
					atmosphere.Density, atmosphere.Color = math.clamp(100 / math.max(light.fogEnd, 1), 0, 1), light.fogColor
				end
			end
		else
			restore("fog", function(values)
				lightingService.FogStart, lightingService.FogEnd, lightingService.FogColor = values[1], values[2], values[3]
				for atmosphere, original in pairs(values[4]) do
					if atmosphere.Parent then atmosphere.Density, atmosphere.Color = original[1], original[2] end
				end
			end)
		end

		if light.cc then
			colorEffect = ensureEffect("ColorCorrectionEffect", colorEffect)
			colorEffect.Enabled = true
			local grade = GRADES[light.grade]
			if grade then
				colorEffect.TintColor, colorEffect.Saturation, colorEffect.Brightness, colorEffect.Contrast = grade[1], grade[2], grade[3], grade[4]
			else
				colorEffect.Saturation, colorEffect.Brightness, colorEffect.Contrast = light.ccSaturation / 100, light.ccBrightness / 100, light.ccContrast / 100
				colorEffect.TintColor = light.ccTint
			end
		elseif colorEffect and colorEffect.Parent then
			colorEffect.Enabled = false
		end

		if light.bloom then
			bloomEffect = ensureEffect("BloomEffect", bloomEffect)
			bloomEffect.Enabled = true
			bloomEffect.Intensity, bloomEffect.Size, bloomEffect.Threshold = light.bloomIntensity / 100, light.bloomSize, light.bloomThreshold / 100
		elseif bloomEffect and bloomEffect.Parent then
			bloomEffect.Enabled = false
		end

		if light.wp then
			local signature = light.wpType .. "|" .. tostring(light.wpColor) .. "|" .. light.wpRate
			if not (wpPart and wpPart.Parent) then
				stopWp()
				wpPart = newInstance("Part", {
					Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
					Size = Vector3.new(90, 50, 90), Name = randomName(),
				}, effectsFolder)
				wpEmitter = newInstance("ParticleEmitter", {}, wpPart)
				pcall(function()
					wpEmitter.Shape, wpEmitter.ShapeStyle = Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume
				end)
				wpSignature = nil
			end
			if signature ~= wpSignature then
				wpSignature = signature
				configureWp(wpEmitter, light.wpType, light.wpColor, light.wpRate)
				pump.wp, pump.wpCarry = wpEmitter.Rate, 0
				wpEmitter.Rate = 0
				wpEmitter:Emit(math.clamp(math.floor(pump.wp * 6), 20, 500))
			end
			pump.wpCarry += pump.wp * math.min(delta or 0.016, 0.1)
			local wpCount = math.floor(pump.wpCarry)
			if wpCount > 0 then
				pump.wpCarry -= wpCount
				wpEmitter:Emit(math.min(wpCount, 100))
			end
			wpPart.CFrame = CFrame.new(currentCamera.CFrame.Position)
		elseif wpPart then
			stopWp()
		end

		if light.storm then
			local now = os.clock()
			nextStrike = nextStrike or now + 1
			if now >= nextStrike then
				nextStrike = now + (0.5 + math.random()) * 60 / math.max(light.stormRate, 1)
				pcall(HitEffects.skybolt, nil, light.stormColor, true)
				if math.random() < 0.4 then
					task.delay(0.16, function() pcall(HitEffects.skybolt, nil, light.stormColor, true) end)
				end
			end
		else
			nextStrike = nil
		end

		if light.tint then
			save("tint", { lightingService.ColorShift_Top, lightingService.ColorShift_Bottom })
			lightingService.ColorShift_Top, lightingService.ColorShift_Bottom = light.tintTop, light.tintBottom
		else
			restore("tint", function(values) lightingService.ColorShift_Top, lightingService.ColorShift_Bottom = values[1], values[2] end)
		end
		if light.env then
			save("env", { lightingService.EnvironmentDiffuseScale, lightingService.EnvironmentSpecularScale })
			lightingService.EnvironmentDiffuseScale, lightingService.EnvironmentSpecularScale = light.envDiffuse / 100, light.envSpecular / 100
		else
			restore("env", function(values) lightingService.EnvironmentDiffuseScale, lightingService.EnvironmentSpecularScale = values[1], values[2] end)
		end

		if light.clouds then
			if not (cloudObject and cloudObject.Parent) then
				cloudObject = workspaceService.Terrain:FindFirstChildOfClass("Clouds")
				cloudOurs = false
				if not cloudObject then
					cloudObject, cloudOurs = newInstance("Clouds", {}, workspaceService.Terrain), true
				else
					save("clouds", { cloudObject, cloudObject.Cover, cloudObject.Density, cloudObject.Color, cloudObject.Enabled })
				end
			end
			cloudObject.Enabled, cloudObject.Cover, cloudObject.Density, cloudObject.Color = true, light.cloudCover / 100, light.cloudDensity / 100, light.cloudColor
		else
			restore("clouds", function(values)
				local target = values[1]
				if target.Parent then target.Cover, target.Density, target.Color, target.Enabled = values[2], values[3], values[4], values[5] end
			end)
			if cloudOurs and cloudObject then cloudObject:Destroy() end
			cloudObject, cloudOurs = nil, false
		end

		if light.dof then
			dofEffect = ensureEffect("DepthOfFieldEffect", dofEffect)
			dofEffect.Enabled = true
			dofEffect.FocusDistance, dofEffect.InFocusRadius = light.dofFocus, light.dofRadius
			dofEffect.NearIntensity, dofEffect.FarIntensity = 0, light.dofFar / 100
		elseif dofEffect and dofEffect.Parent then
			dofEffect.Enabled = false
		end

		if light.sunRays then
			sunEffect = ensureEffect("SunRaysEffect", sunEffect)
			sunEffect.Enabled = true
			sunEffect.Intensity, sunEffect.Spread = light.sunIntensity / 100, light.sunSpread / 100
		elseif sunEffect and sunEffect.Parent then
			sunEffect.Enabled = false
		end

		local skyTinted = light.sky and light.skyTint and not light.atmosphere
		if light.atmosphere or skyTinted then
			if not (atmoTarget and atmoTarget.Parent) then
				atmoTarget = lightingService:FindFirstChildOfClass("Atmosphere")
				atmoOurs = false
				if not atmoTarget then
					atmoTarget, atmoOurs = newInstance("Atmosphere", { Name = randomName() }, lightingService), true
				else
					save("atmo", { atmoTarget, atmoTarget.Density, atmoTarget.Offset, atmoTarget.Color, atmoTarget.Decay, atmoTarget.Glare, atmoTarget.Haze })
				end
			end
			if skyTinted then
				atmoTarget.Density, atmoTarget.Offset = 0.3, 0.25
				atmoTarget.Color, atmoTarget.Decay = light.skyColor, light.skyColor:Lerp(Color3.new(0, 0, 0), 0.4)
				atmoTarget.Glare, atmoTarget.Haze = 0, 1.2
			else
				atmoTarget.Density, atmoTarget.Offset = light.atmoDensity / 100, light.atmoOffset / 100
				atmoTarget.Color, atmoTarget.Decay = light.atmoColor, light.atmoDecay
				atmoTarget.Glare, atmoTarget.Haze = light.atmoGlare / 10, light.atmoHaze / 10
			end
		else
			restore("atmo", function(values)
				local target = values[1]
				if target.Parent then
					target.Density, target.Offset, target.Color, target.Decay, target.Glare, target.Haze = values[2], values[3], values[4], values[5], values[6], values[7]
				end
			end)
			if atmoOurs and atmoTarget then atmoTarget:Destroy() end
			if not (light.atmosphere or skyTinted) then atmoTarget, atmoOurs = nil, false end
		end

		if light.sky ~= skyShown or (light.sky and light.skyPreset ~= skyPreset) then
			skyShown, skyPreset = light.sky, light.skyPreset
			if light.sky then setSky(light.skyPreset) else clearSky() end
		elseif light.sky and os.clock() - (Neverlose.skyCheckAt or 0) > 0.3 then
			-- The game wipes and refills Lighting when a round starts; bring our sky back.
			Neverlose.skyCheckAt = os.clock()
			local alive = skyInstance and skyInstance.Parent == lightingService
			if alive then
				hideOtherSkies()
			elseif skyInstance and skyInstance.Parent == nil and not pcall(function() skyInstance.Parent = lightingService end) then
				setSky(light.skyPreset)
			elseif not skyInstance then
				setSky(light.skyPreset)
			end
		end

		if light.fx then
			local signature = light.fxType .. "|" .. tostring(light.fxColor) .. "|" .. light.fxRate
			if not (fxPart and fxPart.Parent) then
				stopFx()
				fxPart = newInstance("Part", {
					Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
					Size = Vector3.new(260, 140, 260), Name = randomName(),
				}, effectsFolder)
				fxEmitter = newInstance("ParticleEmitter", {}, fxPart)
				pcall(function()
					fxEmitter.Shape, fxEmitter.ShapeStyle = Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume
				end)
				fxSignature = nil
			end
			if signature ~= fxSignature then
				fxSignature = signature
				configureFx(fxEmitter, light.fxType, light.fxColor, light.fxRate)
				pump.fx, pump.fxCarry = fxEmitter.Rate, 0
				fxEmitter.Rate = 0
				fxEmitter:Emit(math.clamp(math.floor(pump.fx * 0.9), 30, 400))
			end
			pump.fxCarry += pump.fx * math.min(delta or 0.016, 0.1)
			local count = math.floor(pump.fxCarry)
			if count > 0 then
				pump.fxCarry -= count
				fxEmitter:Emit(math.min(count, 300))
			end
			fxPart.CFrame = CFrame.new(currentCamera.CFrame.Position + Vector3.new(0, 45, 0))
		elseif fxPart then
			stopFx()
		end
	end))

	maid:give(lightingService.ChildAdded:Connect(function(child)
		if skyShown and skyInstance and child:IsA("Sky") and child ~= skyInstance then
			hiddenSkies[child] = lightingService
			child.Parent = nil
		end
	end))

	maid:give(function()
		restore("time", function(values) lightingService.ClockTime = values[1] end)
		restore("ambient", function(values)
			lightingService.Ambient, lightingService.OutdoorAmbient, lightingService.Brightness = values[1], values[2], values[3]
		end)
		restore("shadows", function(values) lightingService.GlobalShadows = values[1] end)
		restore("exposure", function(values) lightingService.ExposureCompensation = values[1] end)
		restore("fog", function(values)
			lightingService.FogStart, lightingService.FogEnd, lightingService.FogColor = values[1], values[2], values[3]
			for atmosphere, original in pairs(values[4]) do
				if atmosphere.Parent then atmosphere.Density, atmosphere.Color = original[1], original[2] end
			end
		end)
		clearSky()
		stopFx()
		stopWp()
		restore("atmo", function(values)
			local target = values[1]
			if target.Parent then
				target.Density, target.Offset, target.Color, target.Decay, target.Glare, target.Haze = values[2], values[3], values[4], values[5], values[6], values[7]
			end
		end)
		if atmoOurs and atmoTarget then atmoTarget:Destroy() end
		if colorEffect then colorEffect:Destroy() end
		if bloomEffect then bloomEffect:Destroy() end
		if sunEffect then sunEffect:Destroy() end
		if dofEffect then dofEffect:Destroy() end
		restore("tint", function(values) lightingService.ColorShift_Top, lightingService.ColorShift_Bottom = values[1], values[2] end)
		restore("env", function(values) lightingService.EnvironmentDiffuseScale, lightingService.EnvironmentSpecularScale = values[1], values[2] end)
		restore("clouds", function(values)
			local target = values[1]
			if target.Parent then target.Cover, target.Density, target.Color, target.Enabled = values[2], values[3], values[4], values[5] end
		end)
		if cloudOurs and cloudObject then cloudObject:Destroy() end
	end)
end

do
	local RING_SEGMENTS, MAX_ZONES = 20, 6
	local rings = {}
	for zone = 1, MAX_ZONES do
		rings[zone] = {}
		for segment = 1, RING_SEGMENTS do rings[zone][segment] = draw("Line", { Thickness = 2, Visible = false }) end
	end
	local zoneLabels = {}
	for zone = 1, MAX_ZONES do zoneLabels[zone] = draw("Text", { Size = 12, Center = true, Outline = true, Font = 2, Visible = false }) end

	local function positionOf(object)
		if object:IsA("Model") then return object:GetPivot().Position end
		if object:IsA("BasePart") then return object.Position end
		return nil
	end

	maid:give(runService.RenderStepped:Connect(function()
		local world = Neverlose.config.world
		local used = 0

		if world.zones.enabled then
			local sources = {}
			for model in pairs(Ballistics.smokes) do
				if model.Parent and world.zones.smokeOn then sources[#sources + 1] = { position = positionOf(model), radius = GRENADES["Smoke Grenade"].radius, color = world.zones.smokeColor, label = "SMOKE" } end
			end
			local debris = workspaceService:FindFirstChild("Debris")
			for _, child in ipairs(debris and debris:GetChildren() or {}) do
				if child.Name:find("VoxelFire") and world.zones.fireOn then
					sources[#sources + 1] = { position = positionOf(child), radius = GRENADES.Molotov.radius, color = world.zones.fireColor, label = "FIRE" }
				end
			end

			for _, source in ipairs(sources) do
				if used >= MAX_ZONES then break end
				if source.position and (source.position - currentCamera.CFrame.Position).Magnitude < 400 then
					used += 1
					local ring = rings[used]
					local floor = source.position - Vector3.new(0, 2.5, 0)
					local previous, previousVisible
					for segment = 0, RING_SEGMENTS do
						local angle = segment / RING_SEGMENTS * math.pi * 2
						local point, visible = currentCamera:WorldToViewportPoint(floor + Vector3.new(math.cos(angle), 0, math.sin(angle)) * source.radius * 0.4)
						local screen = Vector2.new(point.X, point.Y)
						if segment > 0 then
							local line = ring[segment]
							line.Visible = visible and previousVisible
							line.From, line.To, line.Color = previous, screen, source.color
						end
						previous, previousVisible = screen, visible
					end
					local center, centerVisible = currentCamera:WorldToViewportPoint(source.position)
					local label = zoneLabels[used]
					label.Visible = centerVisible
					label.Text, label.Color = source.label, world.zones.iconColor
					label.Position = Vector2.new(center.X, center.Y)
				end
			end
		end

		for zone = used + 1, MAX_ZONES do
			zoneLabels[zone].Visible = false
			for _, line in ipairs(rings[zone]) do line.Visible = false end
		end
	end))
end

do
	local crossLines = {}
	for index = 1, 4 do crossLines[index] = draw("Line", { Visible = false }) end
	local indicator = draw("Square", { Filled = true, Visible = false })
	local indicatorOutline = draw("Square", { Filled = false, Thickness = 1, Color = Color3.new(), Visible = false })
	local penetrationAt, penetrationYes = 0, true

	maid:give(runService.RenderStepped:Connect(function()
		local world = Neverlose.config.world
		local center = currentCamera.ViewportSize / 2

		local scoped = world.scopeCrosshair.enabled and isScoped() and not menuOpen()
		local cross = world.scopeCrosshair
		local dirs = { Vector2.new(1, 0), Vector2.new(-1, 0), Vector2.new(0, 1), Vector2.new(0, -1) }
		for index, line in ipairs(crossLines) do
			line.Visible = scoped
			if scoped then
				local length = 12 * cross.size / 100
				line.From, line.To = center + dirs[index] * cross.gap, center + dirs[index] * (cross.gap + length)
				line.Color, line.Thickness = cross.color, 2
			end
		end

		local weapon = Game.weapon()
		local show = world.penetration.enabled and not menuOpen() and weapon ~= nil and weapon.Properties ~= nil and weapon.Bullet ~= nil and Game.localCharacter() ~= nil
		if show and os.clock() - penetrationAt > 0.05 then
			penetrationAt = os.clock()
			local ray = currentCamera:ViewportPointToRay(center.X, center.Y)
			local _, _, walls = Ballistics.trace(ray.Origin, ray.Direction, weapon.Properties.Range or 500, nil, 8)
			penetrationYes = walls <= Ballistics.allowedWalls(weapon, true)
		end
		indicator.Visible, indicatorOutline.Visible = show == true, show == true
		if show then
			local size = world.penetration.size
			local corner = center + Vector2.new(size * 1.4, size * 1.4)
			indicator.Size, indicator.Position = Vector2.new(size, size), corner
			indicator.Color = penetrationYes and world.penetration.yes or world.penetration.no
			indicatorOutline.Size, indicatorOutline.Position = Vector2.new(size, size), corner
		end
	end))
end

