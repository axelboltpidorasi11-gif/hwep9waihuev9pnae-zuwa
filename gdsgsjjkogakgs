	local CATEGORIES = { "Pistols", "Mid Tier", "Rifles", "Grenades" }
	local ALIASES = {
		Glock = "Glock-18", USP = "USP-S", Deagle = "Desert Eagle", Revolver = "R8 Revolver",
	}
	local GROUPS = {
		{ "AK-47", "M4A1-S", "M4A4" }, { "Glock-18", "USP-S", "P2000" },
	}
	local bought, lastBuy, lastState = {}, 0, ""

	local function loadoutPaths()
		local paths = {}
		local inventory = Game.modules.inventory
		if not (inventory and inventory.GetEquippedInventoryItem) then return paths end
		for _, category in ipairs(CATEGORIES) do
			for index = 1, 8 do
				local path = ("Loadout.%s.Options.%d"):format(category, index)
				local ok, entry = asGame(inventory.GetEquippedInventoryItem, localPlayer, path)
				if ok and type(entry) == "table" and type(entry.Name) == "string" then paths[entry.Name] = path end
			end
		end
		local ok, zeus = asGame(inventory.GetEquippedInventoryItem, localPlayer, "Equipped.Equipped Zeus x27")
		if ok and type(zeus) == "table" and type(zeus.Name) == "string" then paths[zeus.Name] = "Equipped.Equipped Zeus x27" end
		return paths
	end

	local function ownedWeapons()
		local names = {}
		local inventory = Game.modules.inventory
		if inventory and inventory.getInventorySlot then
			pcall(function()
				local _, slots = pcall(debug.getupvalue, inventory.getInventorySlot, 1)
				if type(slots) ~= "table" then return end
				for _, value in pairs(slots) do
					if type(value) == "table" then
						if type(rawget(value, "Name")) == "string" then names[value.Name] = true end
						for _, inner in pairs(value) do
							if type(inner) == "table" and type(rawget(inner, "Name")) == "string" then names[inner.Name] = true end
						end
					end
				end
			end)
		end
		local held = Game.equipped(localPlayer)
		if held and held.Name then names[held.Name] = true end
		for attribute, value in pairs(localPlayer:GetAttributes()) do
			if type(value) == "string" and attribute:find("^Slot%d") then
				local ok, decoded = pcall(function() return httpService:JSONDecode(value) end)
				if ok and type(decoded) == "table" and type(decoded.Weapon) == "string" then names[decoded.Weapon] = true end
			end
		end
		for _, container in ipairs({ localPlayer.Character, localPlayer:FindFirstChildOfClass("Backpack") }) do
			if container then
				for _, child in ipairs(container:GetChildren()) do
					if child:IsA("Tool") then names[child.Name] = true end
				end
			end
		end
		return names
	end

	local function alreadyHave(name, owned)
		if owned[name] then return true end
		for _, group in ipairs(GROUPS) do
			if table.find(group, name) then
				for _, alternative in ipairs(group) do
					if owned[alternative] then return true end
				end
			end
		end
		return false
	end

	local function resolve(name, paths)
		if paths[name] then return name, paths[name] end
		for _, group in ipairs(GROUPS) do
			if table.find(group, name) then
				for _, alternative in ipairs(group) do
					if paths[alternative] then return alternative, paths[alternative] end
				end
			end
		end
		return nil, nil
	end

	local tries = {}
	local function armorOwned(kind)
		local armor = localPlayer:GetAttribute("Armor")
		if type(armor) == "string" then
			local ok, decoded = pcall(function() return httpService:JSONDecode(armor) end)
			armor = ok and decoded or nil
		end
		if type(armor) ~= "table" or (tonumber(armor.Health) or 0) < 1 then return false end
		return kind == "Kevlar" or armor.Type == "Kevlar + Helmet"
	end

	local function itemCost(name, equipment)
		local ok, cost = pcall(function()
			local root = replicatedStorage.Database.Custom
			local holder = equipment and root.GameStats.Equipment or root.Weapons
			return require(holder[name]).Cost
		end)
		return ok and tonumber(cost) or 0
	end

	maid:give(runService.Heartbeat:Connect(function()
		if not features.autoBuy then return end
		local buyMenu, buyArea = Game.modules.buyMenu, Game.modules.buyArea
		if not (buyMenu and type(buyMenu.purchase) == "function") or not Game.localCharacter() then return end

		local gameState = Game.gameState()
		if gameState ~= lastState then
			if gameState == "Buy Period" then table.clear(bought) table.clear(tries) end
			lastState = gameState
		end
		if gameState ~= "Buy Period" and localPlayer:GetAttribute("BuyMenu") ~= true then return end
		if type(buyArea) == "function" then
			local ok, inside = asGame(buyArea, localPlayer)
			if ok and inside ~= true then return end
		end
		if os.clock() - lastBuy < 0.4 then return end

		local terrorist = localPlayer:GetAttribute("Team") == "Terrorists"
		local gamemode = workspaceService:GetAttribute("Gamemode")
		local primary = features.buyPrimary == "Auto" and (terrorist and "AK-47" or "M4A4") or features.buyPrimary
		local secondary = features.buySecondary == "Auto" and "Desert Eagle" or (ALIASES[features.buySecondary] or features.buySecondary)
		local paths, owned = loadoutPaths(), ownedWeapons()
		local money = tonumber(localPlayer:GetAttribute("Money")) or 0
		local free = gamemode == "Deathmatch" or gameState == "Warmup"

		local plan = {}
		if primary ~= "None" then plan[#plan + 1] = { name = primary } end
		if secondary ~= "None" then plan[#plan + 1] = { name = secondary } end
		if features.buyArmor and features.buyArmor ~= "None" then
			plan[#plan + 1] = { name = features.buyArmor, equipment = true, have = armorOwned(features.buyArmor) }
		end
		if features.buyKit and not terrorist and gamemode == "Bomb Defusal" then
			plan[#plan + 1] = { name = "Defuse Kit", equipment = true, have = localPlayer:GetAttribute("HasDefuseKit") == true }
		end
		if features.buyZeus then plan[#plan + 1] = { name = "Zeus x27", utility = true } end
		if features.buyHE then plan[#plan + 1] = { name = "HE Grenade", utility = true } end
		if features.buyFlash then plan[#plan + 1] = { name = "Flashbang", utility = true } end
		if features.buySmoke then plan[#plan + 1] = { name = "Smoke Grenade", utility = true } end
		if features.buyFire then plan[#plan + 1] = { name = terrorist and "Molotov" or "Incendiary Grenade", utility = true, alt = terrorist and "Incendiary Grenade" or "Molotov" } end
		if features.buyDecoy then plan[#plan + 1] = { name = "Decoy Grenade", utility = true } end

		for _, entry in ipairs(plan) do
			local name, path = entry.name, nil
			if not entry.equipment then
				if entry.utility then
					path = paths[name] or ""
				else
					name, path = resolve(entry.name, paths)
				end
			end
			local key = entry.equipment and ("eq:" .. entry.name) or name
			if name and not bought[key] then
				local have = entry.have
				if have == nil then have = alreadyHave(name, owned) or (entry.alt ~= nil and owned[entry.alt] == true) end
				if have or (tries[key] or 0) >= 2 then
					bought[key] = true
				elseif free or money >= itemCost(name, entry.equipment) then
					tries[key] = (tries[key] or 0) + 1
					lastBuy = os.clock()
					if asGame(buyMenu.purchase, name, path, entry.equipment == true) then
						Logs.push("UI", "bought {" .. name .. "}")
					end
					return
				end
			end
		end
	end))

	local lastScan = 0
	maid:give(runService.Heartbeat:Connect(function()
		if not features.autoAccept or os.clock() - lastScan < 1 then return end
		lastScan = os.clock()
		local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
		if not playerGui then return end
		for _, button in ipairs(playerGui:GetDescendants()) do
			if button:IsA("GuiButton") and button.Visible and button.AbsoluteSize.X > 0 then
				local label = button:IsA("TextButton") and button.Text or ""
				local child = button:FindFirstChildWhichIsA("TextLabel", true)
				local text = (label ~= "" and label or (child and child.Text) or ""):lower()
				if text:find("accept") then
					if firesignal then
						pcall(firesignal, button.MouseButton1Click)
						pcall(firesignal, button.Activated)
					elseif getconnections then
						for _, connection in ipairs(getconnections(button.MouseButton1Click)) do pcall(connection.Fire, connection) end
					end
					Logs.push("UI", "accepted match")
				end
			end
		end
	end))
end

