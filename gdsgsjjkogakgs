function EspObject:applyChams(character, visible, walls, glow, forceColor, inSight)
	local wallStyle, visibleStyle = CHAMS_STYLE[walls.mode], CHAMS_STYLE[visible.mode]

	if wallStyle and not wallStyle.neon and not (inSight == true and visibleStyle ~= nil) then
		local record = { cframes = {} }
		for _, name in ipairs(BODY_PARTS) do
			local live = character:FindFirstChild(name)
			if live then record.cframes[name] = live.CFrame end
		end
		self:drawGhost(character, record, { mode = walls.mode, color = forceColor or walls.color or Color3.new(1, 1, 1), slot = "wallGhost" })
	else
		self:hideGhost("wallGhost")
	end
	local cache = self.chamsCache
	if not cache then cache = {} self.chamsCache = cache end
	local glowOn = glow and glow.on
	local frameStyle = (inSight == true and visibleStyle) or wallStyle
	local pulsing = (wallStyle and (wallStyle.pulse or wallStyle.rainbow or wallStyle.neon)) or (visibleStyle and (visibleStyle.rainbow or visibleStyle.neon))
	local refresh = pulsing and frameStyle ~= nil and frameStyle.neon == true
	if cache.character == character and cache.wm == walls.mode and cache.wc == walls.color and cache.vm == visible.mode and cache.vc == visible.color
		and cache.sight == inSight and cache.glow == glowOn and cache.gc == (glow and glow.color) and cache.force == forceColor then
		if not pulsing or (not refresh and os.clock() - cache.at < 0.04) then return end
	end
	cache.character, cache.wm, cache.wc, cache.vm, cache.vc = character, walls.mode, walls.color, visible.mode, visible.color
	cache.sight, cache.glow, cache.gc, cache.force, cache.at = inSight, glowOn, glow and glow.color, forceColor, os.clock()

	local back = self.highlight
	self.highlightVisible.Enabled = false
	local sighted = inSight == true and visibleStyle ~= nil
	local style = sighted and visibleStyle or wallStyle
	local layer = sighted and visible or walls
	local color = forceColor or layer.color or Color3.new(1, 1, 1)
	if style and style.rainbow and not forceColor then color = Color3.fromHSV((os.clock() * 0.2) % 1, 0.7, 1) end
	if style and style.neon then
		self:neonShow(character, color, glow)
	else
		self:neonHide()
	end
	local xray = style ~= nil and not sighted
	Neverlose.Xray.clear(self)
	if style and not xray and not style.neon then
		back.Adornee, back.DepthMode = character, Enum.HighlightDepthMode.AlwaysOnTop
		local breath = 0.5 + 0.5 * math.sin(os.clock() * 2.4)
		local fillT = math.min(style.fill + (style.pulse and 0.16 * breath or 0), 1)
		if style.material then fillT = 1 end
		back.FillColor, back.FillTransparency = color, fillT
		back.OutlineColor = color:Lerp(Color3.new(1, 1, 1), style.rim or 0.35)
		back.OutlineTransparency = math.max(style.outline - 0.05, 0)
		back.Enabled = true
	else
		back.Enabled = false
	end
	if sighted and visibleStyle.material then self:setMaterial(character, visibleStyle, color) else self:setMaterial(nil) end
end

function EspObject:underlay(key, kind, properties)
	local object = self.underlays[key]
	if not object then
		object = draw(kind, properties)
		self.underlays[key] = object
		self.barObjects[#self.barObjects + 1] = object
	end
	return object
end

local GLOW_LAYERS = {
	{ thickness = 2, transparency = 0.5, radius = 2 },
	{ thickness = 4, transparency = 0.72, radius = 4 },
	{ thickness = 7, transparency = 0.85, radius = 7 },
	{ thickness = 11, transparency = 0.93, radius = 11 },
}
local LINE_HALOS = { { 3, 0.34 }, { 7, 0.14 } }

function EspObject:glowRect(key, x, y, w, h, color)
	local kit = self.glowKits[key]
	if not kit then
		local made, holder = pcall(newInstance, "Frame", {
			Name = randomName(), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 0,
		}, uiRoot)
		if not made then return end
		maid:give(holder)
		kit = { holder = holder, strokes = {} }
		for index, spec in ipairs(GLOW_LAYERS) do
			local layer = newInstance("Frame", {
				Name = randomName(), BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 0,
			}, holder)
			newInstance("UICorner", { CornerRadius = UDim.new(0, spec.radius) }, layer)
			kit.strokes[index] = newInstance("UIStroke", {
				Thickness = spec.thickness, Transparency = spec.transparency, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			}, layer)
		end
		self.glowKits[key] = kit
		self.barObjects[#self.barObjects + 1] = setmetatable({}, {
			__index = function(_, name)
				if name == "Remove" then return function() pcall(function() holder:Destroy() end) end end
				return nil
			end,
			__newindex = function(_, name, value)
				if name == "Visible" then holder.Visible = value end
			end,
		})
	end
	kit.holder.Position, kit.holder.Size, kit.holder.Visible = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h), true
	for _, stroke in ipairs(kit.strokes) do stroke.Color = color end
end

function EspObject:glowHide(key)
	local kit = self.glowKits[key]
	if kit then kit.holder.Visible = false end
end

function EspObject:haloLine(key, from, to, color, thickness, visible)
	for layer, spec in ipairs(LINE_HALOS) do
		local halo = self:underlay(key .. layer, "Line", { ZIndex = 0 })
		halo.From, halo.To, halo.Color, halo.Thickness, halo.Transparency, halo.Visible = from, to, color, thickness + spec[1], spec[2], visible
	end
end

function EspObject:haloCircle(key, position, radius, color)
	for layer, spec in ipairs(LINE_HALOS) do
		local halo = self:underlay(key .. layer, "Circle", { Filled = true, NumSides = 20, ZIndex = 0 })
		halo.Position, halo.Radius, halo.Color, halo.Transparency, halo.Visible = position, radius + spec[1], color, spec[2], true
	end
end

function EspObject:haloHide(key)
	for layer = 1, #LINE_HALOS do
		local halo = self.underlays[key .. layer]
		if halo then halo.Visible = false end
	end
end

local chamsFolder, chamsAdornee, chamsInv, chamsGen = nil, nil, nil, 0
local chamsShade, chamsCull

pcall(function() chamsShade = Enum.AdornShading.XRay end)
pcall(function() chamsCull = Enum.AdornCullingMode.Never end)

local CHAMS_PARTS = {
	Head = true, UpperTorso = true, LowerTorso = true,
	LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
	RightUpperArm = true, RightLowerArm = true, RightHand = true,
	LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
	RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
	Torso = true, ["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true,
}
local CHAMS_MUL = {
	UpperTorso = Vector3.new(1, 1.04, 1),
	LowerTorso = Vector3.new(0.95, 1.5, 1),
	Torso = Vector3.one,
}

local function chamsMeshScale(part)
	local mesh = part:FindFirstChildOfClass("SpecialMesh")
	if mesh then
		local scale = mesh.Scale
		if typeof(scale) == "Vector3" then return scale end
	end
	return nil
end

local function chamsBase(part, headTrim)
	local size = part.Size
	if part.Name == "Head" then
		local scale = chamsMeshScale(part)
		local base = scale and size * scale or size
		return headTrim ~= 1 and base * headTrim or base
	end
	local scale = chamsMeshScale(part)
	if scale then return size * scale end
	local mul = CHAMS_MUL[part.Name]
	if mul then return size * mul end
	local x, y, z = size.X, size.Y, size.Z
	if y >= x and y >= z then
		return Vector3.new(x, y * 1.08, z)
	elseif x >= y and x >= z then
		return Vector3.new(x * 1.08, y, z)
	end
	return Vector3.new(x, y, z * 1.08)
end

local function chamsIsPart(part, character)
	if not part or part.Parent ~= character then return false end
	if not CHAMS_PARTS[part.Name] or not part:IsA("BasePart") then return false end
	local size = part.Size
	return size.X > 0.05 and size.Y > 0.05 and size.Z > 0.05
end

local function chamsTarget()
	local camera = workspaceService.CurrentCamera or currentCamera
	if not camera then return nil end
	if not chamsFolder or not chamsFolder.Parent then
		chamsGen = chamsGen + 1
		chamsFolder = Instance.new("Folder")
		chamsFolder.Name = randomName()
		chamsFolder.Parent = camera
		maid:give(chamsFolder)
		chamsAdornee = Instance.new("Part")
		chamsAdornee.Name = randomName()
		chamsAdornee.Size = Vector3.one
		chamsAdornee.Anchored = true
		chamsAdornee.CanCollide = false
		chamsAdornee.CanQuery = false
		chamsAdornee.CanTouch = false
		chamsAdornee.CastShadow = false
		chamsAdornee.Massless = true
		chamsAdornee.Locked = true
		chamsAdornee.Transparency = 1
		chamsAdornee.Parent = chamsFolder
	elseif chamsFolder.Parent ~= camera then
		chamsFolder.Parent = camera
	end
	local cf = camera.CFrame
	chamsAdornee.CFrame = cf
	chamsInv = cf:Inverse()
	return camera
end

local function chamsBox(zIndex)
	local box = Instance.new("BoxHandleAdornment")
	box.Name = randomName()
	box.Adornee = chamsAdornee
	box.Transparency = 0
	box.ZIndex = zIndex
	box.Visible = false
	if chamsShade then pcall(function() box.Shading = chamsShade end) end
	if chamsCull then pcall(function() box.AdornCullingMode = chamsCull end) end
	box.Parent = chamsFolder
	return box
end

function EspObject:neonDrop(part)
	local neon = self.neon
	if not neon then return end
	local slot = neon.slots[part]
	if slot then
		neon.slots[part] = nil
		if slot.glow then pcall(function() slot.glow:Destroy() end) end
		if slot.fill then pcall(function() slot.fill:Destroy() end) end
	end
	for index = #neon.parts, 1, -1 do
		if neon.parts[index] == part then table.remove(neon.parts, index) end
	end
end

function EspObject:neonAdd(part)
	local neon = self.neon
	if not neon or neon.slots[part] or not chamsIsPart(part, neon.character) then return end
	local slot = { base = chamsBase(part, neon.headTrim), size = part.Size, glow = nil, fill = nil }
	if neon.armed then
		slot.glow, slot.fill = chamsBox(0), chamsBox(1)
		slot.glow.Color3, slot.fill.Color3 = neon.glowCol or Color3.new(1, 1, 1), neon.fillCol or Color3.new(1, 1, 1)
		slot.glow.Transparency, slot.fill.Transparency = neon.fade or 0, neon.fade or 0
		slot.glow.Visible, slot.fill.Visible = neon.shown, neon.shown
	end
	neon.parts[#neon.parts + 1] = part
	neon.slots[part] = slot
end

function EspObject:neonClear()
	local neon = self.neon
	if not neon then return end
	for index = #neon.links, 1, -1 do
		pcall(function() neon.links[index]:Disconnect() end)
		neon.links[index] = nil
	end
	for _, slot in pairs(neon.slots) do
		if slot.glow then pcall(function() slot.glow:Destroy() end) end
		if slot.fill then pcall(function() slot.fill:Destroy() end) end
	end
	table.clear(neon.slots)
	table.clear(neon.parts)
	neon.character = nil
	neon.headTrim = 1
	neon.shown = false
	neon.armed = false
	neon.fillCol = nil
	neon.glowCol = nil
	neon.fade = nil
	neon.gen = chamsGen
end

function EspObject:neonBind(character)
	self:neonClear()
	local neon = self.neon
	if not (character and character.Parent) then return end
	neon.character = character
	local team = character:GetAttribute("Team")
	neon.headTrim = (team == "Counter-Terrorists" or team == "CT") and 0.88 or 1
	for _, child in ipairs(character:GetChildren()) do self:neonAdd(child) end
	neon.links[#neon.links + 1] = character.ChildAdded:Connect(function(child)
		if self.neon and self.neon.character == character then self:neonAdd(child) end
	end)
	neon.links[#neon.links + 1] = character.ChildRemoved:Connect(function(child)
		if self.neon and self.neon.character == character then self:neonDrop(child) end
	end)
end

function EspObject:neonHide()
	local neon = self.neon
	if not neon then return end
	neon.shown = false
	for _, slot in pairs(neon.slots) do
		if slot.fill then slot.glow.Visible, slot.fill.Visible = false, false end
	end
end

function EspObject:neonDestroy()
	if self.neon then self:neonClear() end
	self.neon = nil
end

function EspObject:neonShow(character, color, glow)
	if not chamsTarget() then self:neonHide() return end
	local settings = Neverlose.config.esp
	local intensity = math.clamp(settings.neonIntensity or 4, 1, 8)
	local glowScale = 1 + math.clamp(settings.neonHalo or 18, 0, 60) / 150
	local neon = self.neon
	if not neon then
		neon = {
			parts = {}, slots = setmetatable({}, { __mode = "k" }), links = {},
			character = nil, headTrim = 1, shown = false, armed = false,
			fillCol = nil, glowCol = nil, fade = nil, gen = chamsGen,
		}
		self.neon = neon
	end
	if neon.gen ~= chamsGen then self:neonClear() end
	if neon.character ~= character then self:neonBind(character) end
	if not (neon.character and neon.character.Parent) then self:neonHide() return end
	local fillColor = color or Color3.new(1, 1, 1)
	local glowBase = fillColor
	if glow and glow.on and typeof(glow.color) == "Color3" then glowBase = glow.color end
	local glowColor = Color3.new(glowBase.R * intensity, glowBase.G * intensity, glowBase.B * intensity)
	local transparency = 0
	if not neon.armed then
		neon.armed = true
		for index = 1, #neon.parts do
			local slot = neon.slots[neon.parts[index]]
			if slot and not slot.fill then
				slot.glow, slot.fill = chamsBox(0), chamsBox(1)
				slot.glow.Color3, slot.fill.Color3 = glowColor, fillColor
				slot.glow.Transparency, slot.fill.Transparency = transparency, transparency
				slot.glow.Visible, slot.fill.Visible = false, false
			end
		end
	end
	if neon.fillCol ~= fillColor or neon.glowCol ~= glowColor then
		neon.fillCol, neon.glowCol = fillColor, glowColor
		for _, slot in pairs(neon.slots) do
			if slot.fill then slot.fill.Color3, slot.glow.Color3 = fillColor, glowColor end
		end
	end
	if neon.fade ~= transparency then
		neon.fade = transparency
		for _, slot in pairs(neon.slots) do
			if slot.fill then slot.fill.Transparency, slot.glow.Transparency = transparency, transparency end
		end
	end
	if not neon.shown then
		neon.shown = true
		for _, slot in pairs(neon.slots) do
			if slot.fill then slot.glow.Visible, slot.fill.Visible = true, true end
		end
	end
	for index = #neon.parts, 1, -1 do
		local part = neon.parts[index]
		local slot = neon.slots[part]
		if not part.Parent then
			self:neonDrop(part)
		elseif slot and slot.fill then
			if slot.size ~= part.Size then
				slot.size = part.Size
				slot.base = chamsBase(part, neon.headTrim)
			end
			local relative = chamsInv * part.CFrame
			local position = relative.Position
			local shrink = math.min(4 / math.max(position.Magnitude, 0.001), 1)
			local frame = CFrame.new(position * shrink) * (relative - position)
			local size = (slot.base * shrink):Max(Vector3.new(0.004, 0.004, 0.004))
			slot.fill.CFrame, slot.fill.Size = frame, size
			slot.glow.CFrame, slot.glow.Size = frame, size * glowScale
		end
	end
end

function EspObject:drawCorners(position, size, color)
	local x, y, w, h = position.X, position.Y, size.X, size.Y
	local cw, ch = w / 4, h / 4
	local segments = {
		{ Vector2.new(x, y), Vector2.new(x + cw, y) }, { Vector2.new(x, y), Vector2.new(x, y + ch) },
		{ Vector2.new(x + w, y), Vector2.new(x + w - cw, y) }, { Vector2.new(x + w, y), Vector2.new(x + w, y + ch) },
		{ Vector2.new(x, y + h), Vector2.new(x + cw, y + h) }, { Vector2.new(x, y + h), Vector2.new(x, y + h - ch) },
		{ Vector2.new(x + w, y + h), Vector2.new(x + w - cw, y + h) }, { Vector2.new(x + w, y + h), Vector2.new(x + w, y + h - ch) },
	}
	for index, segment in ipairs(segments) do
		local line = self.corners[index]
		line.From, line.To, line.Color, line.Visible = segment[1], segment[2], color, true
	end
end

function EspObject:drawGradientBox(position, size, top, bottom)
	local x, y, w, h = position.X, position.Y, size.X, size.Y
	local upper, lower = top:Lerp(bottom, 0.25), top:Lerp(bottom, 0.75)
	local segments = {
		{ Vector2.new(x, y), Vector2.new(x + w, y), top },
		{ Vector2.new(x, y + h), Vector2.new(x + w, y + h), bottom },
		{ Vector2.new(x, y), Vector2.new(x, y + h / 2), upper },
		{ Vector2.new(x, y + h / 2), Vector2.new(x, y + h), lower },
		{ Vector2.new(x + w, y), Vector2.new(x + w, y + h / 2), upper },
		{ Vector2.new(x + w, y + h / 2), Vector2.new(x + w, y + h), lower },
	}
	for index, segment in ipairs(segments) do
		local line = self.gradLines[index]
		line.From, line.To, line.Color, line.Visible = segment[1], segment[2], segment[3], true
	end
end

local function gradientAt(first, second, third, t)
	t = math.clamp(t, 0, 1)
	if not third then return first:Lerp(second, t) end
	if t < 0.5 then return first:Lerp(second, t * 2) end
	return second:Lerp(third, (t - 0.5) * 2)
end

function EspObject:hidePixel()
	for _, list in ipairs({ self.pixOutlines, self.pixRects }) do
		for _, object in ipairs(list) do object.Visible = false end
	end
end

local function mixCurve(t, mix)
	local m = math.clamp((mix or 50) / 100, 0.05, 0.95)
	return math.clamp(t, 0, 1) ^ (math.log(0.5) / math.log(m))
end

local function makeFillStrip() return draw("Square", { Filled = true, Transparency = 0.2 }) end
local function makePixRect() return draw("Square", { Filled = true, Transparency = 1, ZIndex = 2 }) end
local function makePixOutline() return draw("Square", { Filled = true, Transparency = 0.9, Color = Color3.new(), ZIndex = 1 }) end
local function makeHpSegment() return draw("Square", { Filled = true, Transparency = 1 }) end

function EspObject:drawFill(x, y, w, h, first, second, gradient, direction, mix, opacity)
	local alpha = math.clamp((opacity or 26) / 100, 0.02, 0.9)
	local strips = self.fillStrips
	if w < 2 or h < 2 then
		self.fill.Visible = false
		for _, strip in ipairs(strips) do strip.Visible = false end
		return
	end
	if not gradient then
		self.fill.Position, self.fill.Size, self.fill.Color, self.fill.Transparency = Vector2.new(x, y), Vector2.new(w, h), first, alpha
		self.fill.Visible = true
		for _, strip in ipairs(strips) do strip.Visible = false end
		return
	end
	self.fill.Visible = false
	local across = direction == "Horizontal"
	local length = across and w or h
	local from = across and x or y
	local count = math.clamp(math.floor(length / 3), 6, FILL_STRIPS)
	for index = 1, count do
		local strip = pooled(strips, index, makeFillStrip)
		local p0 = math.floor(from + length * (index - 1) / count + 0.5)
		local p1 = math.floor(from + length * index / count + 0.5)
		if p1 > p0 then
			local t = (index - 0.5) / count
			if across then
				strip.Position, strip.Size = Vector2.new(p0, y), Vector2.new(p1 - p0, h)
			else
				strip.Position, strip.Size = Vector2.new(x, p0), Vector2.new(w, p1 - p0)
			end
			strip.Color = first:Lerp(second, mixCurve(t, mix))
			strip.Transparency = math.clamp(alpha * (0.6 + 0.8 * t), 0.02, 0.9)
			strip.Visible = true
		else
			strip.Visible = false
		end
	end
	for index = count + 1, #strips do strips[index].Visible = false end
end

function EspObject:drawPixelBox(x, y, w, h, colors, boxColor, c, classic)
	local gradient = colors.boxGradient
	local second = colors.box2
	local direction = colors.boxGradDir or "Vertical"
	local rects, outlines = self.pixRects, self.pixOutlines
	local used, usedOutline = 0, 0

	local function tone(cx, cy)
		if not gradient then return boxColor end
		local tx = math.clamp((cx - x) / math.max(w, 1), 0, 1)
		local ty = math.clamp((cy - y) / math.max(h, 1), 0, 1)
		local t = direction == "Horizontal" and tx or (direction == "Diagonal" and (tx + ty) / 2 or ty)
		return boxColor:Lerp(second, mixCurve(t, colors.gradMix))
	end
	local function put(rx, ry, rw, rh)
		if rw < 1 or rh < 1 or used >= PIX_RECTS then return end
		used += 1
		local rect = pooled(rects, used, makePixRect)
		rect.Position, rect.Size, rect.Color, rect.Transparency, rect.Visible = Vector2.new(rx, ry), Vector2.new(rw, rh), tone(rx + rw / 2, ry + rh / 2), 1, true
	end
	local function shade(rx, ry, rw, rh)
		if not colors.outline or rw < 1 or rh < 1 or usedOutline >= PIX_OUTLINES then return end
		usedOutline += 1
		local rect = pooled(outlines, usedOutline, makePixOutline)
		if classic then
			rect.Position, rect.Size = Vector2.new(rx + 1, ry + 1), Vector2.new(rw, rh)
		else
			rect.Position, rect.Size = Vector2.new(rx - 1, ry - 1), Vector2.new(rw + 2, rh + 2)
		end
		rect.Color, rect.Visible = colors.outlineColor, true
	end
	local function strip(rx, ry, rw, rh, horizontal, split)
		local length = horizontal and rw or rh
		local start = horizontal and rx or ry
		local n = split and math.clamp(math.floor(length / 6), 1, PIX_SIDE) or 1
		for index = 1, n do
			local p0 = math.floor(start + length * (index - 1) / n + 0.5)
			local p1 = math.floor(start + length * index / n + 0.5)
			if horizontal then put(p0, ry, p1 - p0, rh) else put(rx, p0, rw, p1 - p0) end
		end
	end

	local splitX = gradient and direction ~= "Vertical"
	local splitY = gradient and direction ~= "Horizontal"

	if classic then
		local innerH = h - 2 * c
		shade(x, y, w, c)
		shade(x, y + h - c, w, c)
		shade(x, y + c, c, innerH)
		shade(x + w - c, y + c, c, innerH)
		strip(x, y, w, c, true, splitX)
		strip(x, y + h - c, w, c, true, splitX)
		strip(x, y + c, c, innerH, false, splitY)
		strip(x + w - c, y + c, c, innerH, false, splitY)
	else
		local innerW, innerH = w - 4 * c, h - 4 * c
		shade(x + 2 * c, y, innerW, c)
		shade(x + 2 * c, y + h - c, innerW, c)
		shade(x, y + 2 * c, c, innerH)
		shade(x + w - c, y + 2 * c, c, innerH)
		shade(x + c, y + c, c, c)
		shade(x + w - 2 * c, y + c, c, c)
		shade(x + c, y + h - 2 * c, c, c)
		shade(x + w - 2 * c, y + h - 2 * c, c, c)

		strip(x + 2 * c, y, innerW, c, true, splitX)
		strip(x + 2 * c, y + h - c, innerW, c, true, splitX)
		strip(x, y + 2 * c, c, innerH, false, splitY)
		strip(x + w - c, y + 2 * c, c, innerH, false, splitY)
		put(x + c, y + c, c, c)
		put(x + w - 2 * c, y + c, c, c)
		put(x + c, y + h - 2 * c, c, c)
		put(x + w - 2 * c, y + h - 2 * c, c, c)
	end

	for index = used + 1, #rects do rects[index].Visible = false end
	for index = usedOutline + 1, #outlines do outlines[index].Visible = false end
end

local function darken(color, factor)
	return Color3.new(color.R * factor, color.G * factor, color.B * factor)
end

function EspObject:drawGradBar(id, back, bar, thick, segmentCount, colorAt, glowColor)
	local kit = self.gradBars[id]
	if not kit then
		kit = {
			frame = draw("Square", { Filled = true, Transparency = 0.9, Color = Color3.new(), ZIndex = 1 }),
			back = draw("Square", { Filled = true, Transparency = 0.9, Color = Color3.fromRGB(24, 24, 30), ZIndex = 2 }),
			segs = {},
		}
		self.gradBars[id] = kit
		self.barObjects[#self.barObjects + 1] = kit.frame
		self.barObjects[#self.barObjects + 1] = kit.back
	end
	local function clear()
		kit.frame.Visible, kit.back.Visible = false, false
		self:glowHide("bar" .. id)
		for _, segment in ipairs(kit.segs) do segment.Visible = false end
	end
	if not bar.Visible then
		clear()
		return nil
	end

	local a, b = back.From, back.To
	local vertical = math.abs(a.X - b.X) < 0.5
	local length = vertical and (a.Y - b.Y - 2) or (b.X - a.X - 2)
	if length < 4 then
		back.Visible, bar.Visible = false, false
		clear()
		return nil
	end
	local ratio = math.clamp((bar.To - bar.From).Magnitude / length, 0, 1)
	back.Visible, bar.Visible = false, false

	thick = math.clamp(math.floor(thick), 1, 8)
	local lead, cross
	if vertical then
		lead, cross = math.floor(a.Y - 1 + 0.5), math.floor(a.X - thick / 2 + 0.5)
		kit.frame.Position, kit.frame.Size = Vector2.new(cross - 1, lead - length - 1), Vector2.new(thick + 2, length + 2)
		kit.back.Position, kit.back.Size = Vector2.new(cross, lead - length), Vector2.new(thick, length)
	else
		lead, cross = math.floor(a.X + 1 + 0.5), math.floor(a.Y - thick / 2 + 0.5)
		kit.frame.Position, kit.frame.Size = Vector2.new(lead - 1, cross - 1), Vector2.new(length + 2, thick + 2)
		kit.back.Position, kit.back.Size = Vector2.new(lead, cross), Vector2.new(length, thick)
	end
	kit.frame.Visible, kit.back.Visible = true, true
	if glowColor then
		self:glowRect("bar" .. id, kit.frame.Position.X, kit.frame.Position.Y, kit.frame.Size.X, kit.frame.Size.Y, glowColor)
	else
		self:glowHide("bar" .. id)
	end

	for index = 1, segmentCount do
		local s0, s1 = (index - 1) / segmentCount, index / segmentCount
		local shown = false
		if ratio > s0 then
			local e1 = math.min(ratio, s1)
			local p0 = math.floor(length * s0 + 0.5)
			local p1 = math.floor(length * e1 + 0.5)
			if p1 > p0 then
				shown = true
				local segment = kit.segs[index]
				if not segment then
					segment = draw("Square", { Filled = true, Transparency = 1, ZIndex = 3 })
					kit.segs[index] = segment
					self.barObjects[#self.barObjects + 1] = segment
				end
				if vertical then
					segment.Position, segment.Size = Vector2.new(cross, lead - p1), Vector2.new(thick, p1 - p0)
				else
					segment.Position, segment.Size = Vector2.new(lead + p0, cross), Vector2.new(p1 - p0, thick)
				end
				segment.Color = colorAt((s0 + s1) / 2, ratio)
				segment.Visible = true
			end
		end
		if not shown and kit.segs[index] then kit.segs[index].Visible = false end
	end
	for index = segmentCount + 1, #kit.segs do kit.segs[index].Visible = false end

	return { vertical = vertical, lead = lead, cross = cross, length = length, thick = thick, ratio = ratio }
end

function EspObject:drawBars(colors, position, width)
	local low, mid, high = colors.healthLow, colors.healthMid or Color3.fromRGB(255, 205, 70), colors.health
	local smooth = colors.healthGradient ~= false
	local info = self:drawGradBar("health", self.healthBack, self.healthBar, colors.hpWidth or 2, HP_SEGMENTS, function(t, ratio)
		return smooth and gradientAt(low, mid, high, t) or low:Lerp(high, ratio)
	end, colors.glowHealth and colors.glowHealthColor or nil)
	local function tinted(base)
		return function(t) return darken(base, 0.5 + 0.5 * t) end
	end
	self:drawGradBar("armor", self.armorBack, self.armorBar, colors.armorWidth or 2, 10, tinted(colors.armor), colors.glowArmor and colors.glowArmorColor or nil)
	self:drawGradBar("ammo", self.ammoBack, self.ammoBar, colors.ammoWidth or 2, 10, tinted(colors.ammo), colors.glowAmmo and colors.glowAmmoColor or nil)
	self:drawGradBar("ready", self.readyBack, self.readyBar, colors.readyWidth or 2, 10, tinted(colors.ready), colors.glowReady and colors.glowReadyColor or nil)

	local text = self.healthText
	if text.Visible and info then
		local size = colors.healthTextSize or 11
		text.Color = smooth and gradientAt(low, mid, high, info.ratio) or colors.healthText
		if info.vertical then
			local top = info.lead - info.length
			local tip = math.clamp(info.lead - math.floor(info.length * info.ratio + 0.5), top, info.lead)
			local y = tip - math.floor(size / 2) - 1
			if info.cross + info.thick / 2 < position.X + width / 2 then
				text.Align = "Right"
				text.Position = Vector2.new(info.cross - 4, y)
			else
				text.Align = "Left"
				text.Position = Vector2.new(info.cross + info.thick + 4, y)
			end
		else
			text.Align = "Center"
			text.Position = Vector2.new(info.lead + math.floor(info.length * info.ratio + 0.5), info.cross + info.thick + 3)
		end
	end
end

function EspObject:drawReferenceBox(x, y, w, h, colors, boxColor, thickness)
	local kit = self.refBox
	if not kit then
		local holder = newInstance("Frame", { Name = randomName(), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false }, uiRoot)
		maid:give(holder)
		local function framed(zIndex, color)
			local frame = newInstance("Frame", {
				Name = randomName(), BackgroundTransparency = 1, BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1), ZIndex = zIndex,
			}, holder)
			local stroke = newInstance("UIStroke", {
				Color = color, Thickness = 1, LineJoinMode = Enum.LineJoinMode.Miter,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			}, frame)
			return frame, stroke
		end
		local shadowFrame, shadowStroke = framed(1, Color3.new())
		shadowFrame.Position = UDim2.fromOffset(1, 1)
		local boxFrame, boxStroke = framed(2, Color3.new(1, 1, 1))
		local gradient = newInstance("UIGradient", { Enabled = false }, boxStroke)
		kit = { holder = holder, shadowFrame = shadowFrame, shadowStroke = shadowStroke, boxStroke = boxStroke, gradient = gradient }
		self.refBox = kit
		self.barObjects[#self.barObjects + 1] = setmetatable({}, {
			__index = function(_, key)
				if key == "Remove" then return function() pcall(function() holder:Destroy() end) end end
				return nil
			end,
			__newindex = function(_, key, value)
				if key == "Visible" then holder.Visible = value end
			end,
		})
	end

	kit.holder.Position, kit.holder.Size, kit.holder.Visible = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h), true
	kit.shadowFrame.Visible = colors.outline ~= false
	kit.boxStroke.Thickness, kit.shadowStroke.Thickness = thickness, thickness
	if colors.boxGradient then
		local direction = colors.boxGradDir or "Vertical"
		local mix = math.clamp((colors.gradMix or 50) / 100, 0.05, 0.95)
		local second = colors.box2
		kit.boxStroke.Color = Color3.new(1, 1, 1)
		kit.gradient.Rotation = direction == "Horizontal" and 0 or (direction == "Diagonal" and 45 or 90)
		kit.gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, boxColor),
			ColorSequenceKeypoint.new(mix, boxColor:Lerp(second, 0.5)),
			ColorSequenceKeypoint.new(1, second),
		})
		kit.gradient.Enabled = true
	else
		kit.gradient.Enabled = false
		kit.boxStroke.Color = boxColor
	end
end

function EspObject:tightBox(character)
	local now = os.clock()
	if self.tightCharacter ~= character or now - (self.tightAt or 0) > 1.5 then
		self.tightCharacter, self.tightAt = character, now
		local list = {}
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				local name = part.Name:lower()
				if name:find("head", 1, true) or name:find("torso", 1, true) or name:find("arm", 1, true)
					or name:find("leg", 1, true) or name:find("foot", 1, true) or name:find("hand", 1, true) then
					list[#list + 1] = part
				end
			end
		end
		self.tightParts = list
	end
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local found = false
	for _, part in ipairs(self.tightParts) do
		if part.Parent then
			local cf, extent = part.CFrame, part.Size / 2
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local point = currentCamera:WorldToViewportPoint(cf * Vector3.new(extent.X * sx, extent.Y * sy, extent.Z * sz))
						if point.Z > 0 then
							found = true
							minX, maxX = math.min(minX, point.X), math.max(maxX, point.X)
							minY, maxY = math.min(minY, point.Y), math.max(maxY, point.Y)
						end
					end
				end
			end
		end
	end
	if not found then return nil end
	return minX, minY, maxX, maxY
end

function EspObject:hideArrow()
	self.arrow.Visible, self.arrowWing.Visible, self.arrowEdge.Visible, self.arrowEdge2.Visible = false, false, false, false
	self.arrowGlow.Visible, self.arrowText.Visible = false, false
end

function EspObject:drawArrow(worldPosition, color)
	local config = Neverlose.config.esp
	local relative = currentCamera.CFrame:PointToObjectSpace(worldPosition)
	local target = math.atan2(relative.Z, relative.X)
	local now = os.clock()
	local previous = self.arrowAngle or target
	local delta = (target - previous + math.pi) % (math.pi * 2) - math.pi
	self.arrowAngle = previous + delta * math.clamp((now - (self.arrowClock or now)) * 18, 0, 1)
	self.arrowClock = now

	local direction = Vector2.new(math.cos(self.arrowAngle), math.sin(self.arrowAngle))
	local side = Vector2.new(-direction.Y, direction.X)
	local distance = (worldPosition - currentCamera.CFrame.Position).Magnitude
	local length = config.arrowSize
	local base = currentCamera.ViewportSize / 2 + direction * config.arrowRadius
	local nose = base + direction * length
	local wingA = base + side * (length * 0.5)
	local wingB = base - side * (length * 0.5)
	local notch = base + direction * (length * 0.22)
	local fade = math.clamp(1 - distance / 600, 0.45, 1)

	self.arrowGlow.Visible = false
	self.arrow.PointA, self.arrow.PointB, self.arrow.PointC = nose, wingA, wingB
	self.arrowEdge.PointA, self.arrowEdge.PointB, self.arrowEdge.PointC = nose, wingA, wingB
	self.arrowWing.Visible, self.arrowEdge2.Visible = false, false
	self.arrow.Color, self.arrow.Transparency, self.arrow.Visible = color:Lerp(Color3.new(), (1 - fade) * 0.6), 1, true
	self.arrowEdge.Visible = false
	self.arrowText.Size = 11
	self.arrowText.Text = ("%dm"):format(distance * STUDS_PER_METER)
	self.arrowText.Position = base - direction * 13 - Vector2.new(0, 6)
	self.arrowText.Transparency, self.arrowText.Visible = fade, true
end

local function verticalBar(back, bar, x, top, height, ratio, color)
	back.From, back.To = Vector2.new(x, top + height + 1), Vector2.new(x, top - 1)
	bar.From, bar.To = Vector2.new(x, top + height), Vector2.new(x, top + height - height * ratio)
	if color then bar.Color = color end
	back.Visible, bar.Visible = true, true
end

local function horizontalBar(back, bar, left, y, width, ratio, color)
	back.From, back.To = Vector2.new(left - 1, y), Vector2.new(left + width + 1, y)
	bar.From, bar.To = Vector2.new(left, y), Vector2.new(left + width * ratio, y)
	if color then bar.Color = color end
	back.Visible, bar.Visible = true, true
end

Neverlose.LAYOUT_ORDER = { "health", "armor", "ammo", "ready", "name", "aim", "distance", "weapon", "weaponIcon", "flags" }
Neverlose.LAYOUT_DEFAULT = { health = "Left", armor = "Left", ammo = "Bottom", ready = "Bottom", name = "Top", aim = "Top", distance = "Bottom", weapon = "Bottom", weaponIcon = "Bottom", flags = "Right" }
Neverlose.LAYOUT_BARS = { health = true, armor = true, ammo = true, ready = true }

function Neverlose.textExtent(text, size)
	text = tostring(text)
	local longest = 0
	for row in text:gmatch("[^\n]+") do longest = math.max(longest, #row) end
	local lines = select(2, text:gsub("\n", "")) + 1
	return longest * size * 0.52 + 4, lines * (size + 2)
end

function Neverlose.layoutSolve(layout, shown, x, y, w, h)
	local edge = { Left = x - 3, Right = x + w + 3, Top = y - 3, Bottom = y + h + 1 }
	local placed = {}
	for _, id in ipairs(Neverlose.LAYOUT_ORDER) do
		local info = shown[id]
		if info then
			local side = layout and layout[id] or Neverlose.LAYOUT_DEFAULT[id]
			if not edge[side] then side = Neverlose.LAYOUT_DEFAULT[id] end
			local spot = { side = side }
			if Neverlose.LAYOUT_BARS[id] then
				if side == "Left" then
					spot.cx = edge.Left - 2
					spot.x, spot.y, spot.w, spot.h = spot.cx - 2, y - 1, 4, h + 2
					edge.Left -= 5
				elseif side == "Right" then
					spot.cx = edge.Right + 2
					spot.x, spot.y, spot.w, spot.h = spot.cx - 2, y - 1, 4, h + 2
					edge.Right += 5
				elseif side == "Top" then
					spot.cy = edge.Top - 2
					spot.x, spot.y, spot.w, spot.h = x - 1, spot.cy - 2, w + 2, 4
					edge.Top -= 5
				else
					spot.cy = edge.Bottom + 2
					spot.x, spot.y, spot.w, spot.h = x - 1, spot.cy - 2, w + 2, 4
					edge.Bottom += 5
				end
			else
				local width, height = info.width, info.height
				if side == "Top" then
					spot.top = edge.Top - height
					edge.Top = spot.top
				elseif side == "Bottom" then
					spot.top = edge.Bottom + 2
					edge.Bottom = spot.top + height
				elseif side == "Left" then
					spot.left, spot.top = edge.Left - width, y
					edge.Left = spot.left - 2
				else
					spot.left, spot.top = edge.Right + 1, y
					edge.Right = spot.left + width + 2
				end
				if side == "Top" or side == "Bottom" then spot.left = x + w / 2 - width / 2 end
				spot.cx = spot.left + width / 2
				spot.width, spot.height = width, height
			end
			placed[id] = spot
		end
	end
	return placed
end

function EspObject:applyLayout(position, size, colors)
	local layout = Neverlose.config.esp.layout
	if type(layout) ~= "table" then layout = {} end
	local x, y, w, h = position.X, position.Y, size.X, size.Y
	local bars = {
		health = { self.healthBack, self.healthBar, h }, armor = { self.armorBack, self.armorBar, h },
		ammo = { self.ammoBack, self.ammoBar, w }, ready = { self.readyBack, self.readyBar, w },
	}
	local texts = { name = self.name, aim = self.aim, distance = self.distance, weapon = self.weapon, flags = self.flags }
	local shown, ratios = {}, {}
	for id, entry in pairs(bars) do
		if entry[2].Visible then
			shown[id] = true
			ratios[id] = math.clamp((entry[2].To - entry[2].From).Magnitude / math.max(entry[3], 1), 0, 1)
		end
	end
	for id, text in pairs(texts) do
		if text.Visible then
			local width, height = Neverlose.textExtent(text.Text, text.Size)
			shown[id] = { width = width, height = height }
		end
	end
	if self.iconOn then
		local iconW = math.clamp((colors and colors.iconWidth) or 46, 8, 300)
		local iconH = math.clamp((colors and colors.iconHeight) or 18, 4, 200)
		shown.weaponIcon = { width = iconW, height = iconH }
	end
	local placed = Neverlose.layoutSolve(layout, shown, x, y, w, h)
	self.iconSpot = placed.weaponIcon
	for id, entry in pairs(bars) do
		local spot = placed[id]
		if spot then
			if spot.side == "Left" or spot.side == "Right" then
				verticalBar(entry[1], entry[2], spot.cx, y, h, ratios[id])
			else
				horizontalBar(entry[1], entry[2], x, spot.cy, w, ratios[id])
			end
		end
	end
	for id, text in pairs(texts) do
		local spot = placed[id]
		if spot then
			text.Position = id == "flags" and Vector2.new(spot.left, spot.top) or Vector2.new(spot.cx, spot.top)
		end
	end
	local health = placed.health
	if self.healthText.Visible and health and health.side ~= "Left" then
		local current = self.healthText.Position
		if health.side == "Right" then
			self.healthText.Position = Vector2.new(health.cx + 9, current.Y)
		else
			self.healthText.Position = Vector2.new(x - 10, health.cy - 6)
		end
	end
end

function EspObject:placeWeaponIcon(image, colors, position, size, root)
	if image == "" then
		self.billboard.Enabled = false
		return
	end
	local iconW = math.clamp(colors.iconWidth or 46, 8, 300)
	local iconH = math.clamp(colors.iconHeight or 18, 4, 200)
	local center
	local spot = self.iconSpot
	if spot then
		center = Vector2.new(spot.cx, spot.top + spot.height / 2)
	else
		local side = Neverlose.LAYOUT_DEFAULT.weaponIcon
		if side == "Top" then
			center = Vector2.new(position.X + size.X / 2, position.Y - 4 - iconH / 2)
		elseif side == "Left" then
			center = Vector2.new(position.X - 4 - iconW / 2, position.Y + size.Y / 2)
		elseif side == "Right" then
			center = Vector2.new(position.X + size.X + 4 + iconW / 2, position.Y + size.Y / 2)
		else
			center = Vector2.new(position.X + size.X / 2, position.Y + size.Y + 4 + iconH / 2)
		end
	end
	local cam = currentCamera
	local anchor = cam:WorldToViewportPoint(root.Position)
	local depth = math.max(anchor.Z, 1)
	local perPixel = depth * 2 * math.tan(math.rad(cam.FieldOfView) / 2) / math.max(cam.ViewportSize.Y, 1)
	if self.billboard.Parent ~= cam then self.billboard.Parent = cam end
	self.billboard.Enabled = true
	self.billboard.Adornee = root
	self.icon.Image = image
	self.icon.ImageColor3 = colors.weaponIcon
	self.billboard.Size = UDim2.fromOffset(iconW, iconH)
	self.billboard.StudsOffsetWorldSpace = cam.CFrame.RightVector * ((center.X - anchor.X) * perPixel) + cam.CFrame.UpVector * ((anchor.Y - center.Y) * perPixel)
end

function EspObject:updateRendering(character, hide)
	if not hide then
		self:restoreRendering()
		return
	end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = 1
			self.hiddenParts[part] = true
		end
	end
end

function EspObject:isRevealed(character, root, head)
	local config = Neverlose.config.esp
	if not config.legit or localPlayer:GetAttribute("IsSpectating") == true then return true end
	local now = os.clock()
	local heard = Neverlose.heard and Neverlose.heard[self.entity]
	if heard and now - heard.t < 1.5 then return true end
	if now - (self.spotAt or 0) > 0.25 then
		self.spotAt = now
		local seen = false
		local velocity = root.AssemblyLinearVelocity
		if Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 11 and (root.Position - currentCamera.CFrame.Position).Magnitude < config.soundDistance then
			seen = true
		end
		if not seen then
			local target = (head or root).Position
			for _, entity in ipairs(Game.entities()) do
				if entity ~= localPlayer and entity ~= self.entity and not Game.isEnemy(entity, true) then
					local mate = Game.character(entity)
					local eye = mate and mate:FindFirstChild("Head")
					if eye then
						local offset = target - eye.Position
						if offset.Magnitude < 600 and eye.CFrame.LookVector:Dot(offset.Unit) > 0.2 and (not blockedBetween(eye.Position, target) or not blockedBetween(eye.Position, root.Position - Vector3.new(0, 2, 0)) or not blockedBetween(eye.Position, root.Position)) then
							seen = true
							break
						end
					end
				end
			end
		end
		if seen then self.spotUntil = now + 1.6 end
	end
	return now < (self.spotUntil or 0)
end

function EspObject:update()
	local config = Neverlose.config.esp
	local entity = self.entity
	local rawCharacter = entity.Character
	local character = Game.character(entity)

	if character then
		self.lastCharacter, self.lastCharacterAt = character, os.clock()
	elseif self.lastCharacter and os.clock() - (self.lastCharacterAt or 0) < 0.3 and self.lastCharacter.Parent
		and self.lastCharacter:GetAttribute("Dead") ~= true and self.lastCharacter:FindFirstChild("HumanoidRootPart") then
		character = self.lastCharacter
	end

	if not character then
		self:hideDrawings()
		self:restoreRendering()

		do
			local heard = Neverlose.heard and Neverlose.heard[entity]
			if config.enabled and config.arrows and config.heardPlayers and heard and os.clock() - heard.t < config.soundDuration + 1
				and not Neverlose.isDown(entity) and Game.isEnemy(entity, true) then
				local point = currentCamera:WorldToViewportPoint(heard.position)
				local viewport = currentCamera.ViewportSize
				if not (point.Z > 0 and point.X > 0 and point.X < viewport.X and point.Y > 0 and point.Y < viewport.Y) then
					self:drawArrow(heard.position, config.soundColor)
				end
			end
		end
		local ragdolls = config.enemyModel.ragdolls
		if config.enabled and rawCharacter and rawCharacter.Parent and CHAMS_STYLE[ragdolls.mode] and Game.isEnemy(entity, true) then
			self:applyChams(rawCharacter, { mode = "Disabled" }, ragdolls, nil)
		else
			self:hideHighlights()
		end
		return
	end

	local isEnemy = Game.isEnemy(entity, true)
	local team = isEnemy and "Enemies" or "Teammates"
	local colors = config.colors[team]
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		self:hideDrawings()
		self:hideHighlights()
		return
	end
	local head = character:FindFirstChild("Head")
	local distance = (root.Position - currentCamera.CFrame.Position).Magnitude
	if distance < 12 and localPlayer:GetAttribute("IsSpectating") == true then
		self:hideDrawings()
		self:hideHighlights()
		return
	end

	local modelsOn = config.enabled and (isEnemy or config.teamEnabled or config.showTeam)
	local model = isEnemy and config.enemyModel or config.teamModel
	local revealed = true
	if modelsOn or config.legit then

		if os.clock() - (self.wallsAt or 0) > 0.15 then
			self.wallsAt = os.clock()
			local eye = currentCamera.CFrame.Position
			local fraction = bodySight(eye, root, head)
			self.sightFrac = fraction
			self.inSight = fraction >= 0.99 or (self.inSight == true and fraction >= 0.8)
		end
		revealed = (not isEnemy) or (self.sightFrac or 0) > 0 or self:isRevealed(character, root, head)
	else
		self.inSight = true
	end
	if modelsOn and revealed then
		self:applyChams(character, model.player, model.walls, model.glow, nil, self.inSight)
	else
		self:hideHighlights()
	end
	self:updateRendering(character, (not isEnemy) and modelsOn and model.disableRender)

	local espOn = config.enabled and revealed and (isEnemy or (config.teamEnabled or config.showTeam)) and distance <= config.maxDistance
	if not espOn then return self:hideDrawings() end

	local boxColor, nameColor, skeletonColor, fillColor, snapColor = colors.box, colors.name, colors.skeleton, colors.fill, colors.snapline
	if config.visCheck then
		if os.clock() - self.visibleAt > 0.1 then
			self.visibleAt = os.clock()
			self.visible = not blockedBetween(currentCamera.CFrame.Position, (head or root).Position)
		end
		local tint = self.visible and config.visibleColor or config.hiddenColor
		boxColor, nameColor, skeletonColor, fillColor, snapColor = tint, tint, tint, tint, tint
	end

	local rootPoint = currentCamera:WorldToViewportPoint(root.Position)
	local viewport = currentCamera.ViewportSize
	local onScreen = rootPoint.Z > 0 and rootPoint.X > -150 and rootPoint.X < viewport.X + 150 and rootPoint.Y > -250 and rootPoint.Y < viewport.Y + 250

	if not onScreen then
		self:hideDrawings()
		if config.arrows and isEnemy then self:drawArrow(root.Position, config.arrowColor) end
		return
	end
	self:hideArrow()

	local top = currentCamera:WorldToViewportPoint((head and head.Position or root.Position) + Vector3.new(0, 0.75, 0))
	local bottom = currentCamera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
	local height = math.max(bottom.Y - top.Y, 4)
	local width = height * 0.55
	local position = Vector2.new(rootPoint.X - width / 2, top.Y)
	local size = Vector2.new(width, height)

	if colors.tightBox ~= false then
		local x0, y0, x1, y1 = self:tightBox(character)
		if x0 and x1 - x0 > 2 and y1 - y0 > 2 then
			position = Vector2.new(math.floor(x0), math.floor(y0))
			width, height = math.floor(x1 - x0), math.floor(y1 - y0)
			size = Vector2.new(width, height)
			rootPoint = Vector3.new(position.X + width / 2, rootPoint.Y, rootPoint.Z)
			top = Vector3.new(rootPoint.X, position.Y, rootPoint.Z)
			bottom = Vector3.new(rootPoint.X, position.Y + height, rootPoint.Z)
		end
	end

	local naturalHeight, skelScale = height, 1
	if colors.fixedBox == true then
		width = math.clamp(colors.fixedW or 46, 10, 400)
		height = math.clamp(colors.fixedH or 84, 10, 600)
		skelScale = math.clamp(height / naturalHeight, 0.05, 30)
		position = Vector2.new(rootPoint.X - width / 2, rootPoint.Y - height / 2)
		size = Vector2.new(width, height)
		top = Vector3.new(rootPoint.X, position.Y, rootPoint.Z)
		bottom = Vector3.new(rootPoint.X, position.Y + height, rootPoint.Z)
	end

	if colors.fixedBox ~= true then
		local pad = height * math.clamp((colors.boxPad or 5) / 100, 0, 0.4)
		position = Vector2.new(position.X - pad, position.Y - pad)
		width, height = width + pad * 2, height + pad * 2
		size = Vector2.new(width, height)
		top = Vector3.new(top.X, position.Y, top.Z)
		bottom = Vector3.new(bottom.X, position.Y + height, bottom.Z)
	end

	local function fixPoint(point)
		return Vector2.new(rootPoint.X + (point.X - rootPoint.X) * skelScale, rootPoint.Y + (point.Y - rootPoint.Y) * skelScale)
	end

	local widthScale = math.clamp((colors.boxWidth or 100) / 100, 0.3, 3)
	if widthScale ~= 1 then
		width = width * widthScale
		position, size = Vector2.new(rootPoint.X - width / 2, position.Y), Vector2.new(width, height)
	end

	local showBox = item(team, "Main/Bounding Box")
	local style = config.boxStyle
	local pixel = showBox and (style == "Pixel" or style == "Pixel Filled")
	local classic = showBox and (style == "Classic" or style == "Classic Filled")
	local reference = showBox and (style == "Reference" or style == "Reference Filled")
	local corners = showBox and style == "Corners"
	local plain = showBox and not corners and not pixel and not classic and not reference
	local gradient = plain and colors.boxGradient
	local cell = math.clamp(math.floor(colors.boxThick or 2), 1, 4)

	if pixel or classic or reference then
		local snapX = math.floor(position.X / cell + 0.5) * cell
		local snapY = math.floor(position.Y / cell + 0.5) * cell
		width = math.max(math.floor(width / cell + 0.5), 8) * cell
		height = math.max(math.floor(height / cell + 0.5), 10) * cell
		position, size = Vector2.new(snapX, snapY), Vector2.new(width, height)
	end

	self.boxOutline.Visible = plain and colors.outline
	self.box.Visible = plain and not gradient
	if plain then
		self.box.Thickness, self.boxOutline.Thickness = cell, cell + 2
		self.boxOutline.Position, self.boxOutline.Size, self.boxOutline.Color = position, size, colors.outlineColor
		self.box.Position, self.box.Size, self.box.Color = position, size, boxColor
	end
	self.boxGlow.Visible = plain
	if plain then
		local targeted = Rage.target ~= nil and Rage.target.entity == entity
		self.boxGlow.Position, self.boxGlow.Size, self.boxGlow.Color = position, size, boxColor
		self.boxGlow.Transparency = targeted and (0.2 + 0.1 * math.sin(os.clock() * 8)) or 0.1
	end
	for _, line in ipairs(self.gradLines) do line.Visible = false end
	if gradient then self:drawGradientBox(position, size, boxColor, colors.box2) end

	if pixel or classic then
		local ok, err = pcall(self.drawPixelBox, self, position.X, position.Y, width, height, colors, boxColor, cell, classic)
		if not ok then report(err) end
	else
		self:hidePixel()
	end

	if reference then
		local okRef, errRef = pcall(self.drawReferenceBox, self, position.X, position.Y, width, height, colors, boxColor, cell)
		if not okRef then report(errRef) end
	elseif self.refBox then
		self.refBox.holder.Visible = false
	end

	local filled = showBox and (style == "Filled" or style == "Pixel Filled" or style == "Classic Filled" or style == "Reference Filled")
	if filled then
		local inset = (pixel or classic) and cell or 0
		local ok, err = pcall(self.drawFill, self, position.X + inset, position.Y + inset, width - 2 * inset, height - 2 * inset, fillColor, colors.fill2, colors.fillGradient, colors.boxGradDir, colors.gradMix, colors.fillAlpha)
		if not ok then report(err) end
	else
		pcall(self.drawFill, self, 0, 0, 0, 0, fillColor, colors.fill2, false)
	end
	if corners then
		self:drawCorners(position, size, boxColor)
	else
		for _, line in ipairs(self.corners) do line.Visible = false end
	end

	if showBox and colors.glowBox then
		self:glowRect("box", position.X, position.Y, width, height, colors.glowBoxColor)
	else
		self:glowHide("box")
	end

	self.name.Visible = item(team, "Main/Name")
	if self.name.Visible then
		self.name.FontName, self.name.Size = colors.nameFont or "Pixel", colors.nameSize or 13
		self.name.Text = tostring(entity.DisplayName or entity.Name)
		self.name.Position = Vector2.new(rootPoint.X, top.Y - (colors.nameSize or 13) - 4)
		self.name.Color = nameColor
		self.name.Glow = colors.glowName and colors.glowNameColor or false
	end

	self.snap.Visible = item(team, "Main/Snaplines")
	if self.snap.Visible then
		local view = currentCamera.ViewportSize
		local origin = config.snapOrigin == "Top" and Vector2.new(view.X / 2, 0)
			or config.snapOrigin == "Center" and view / 2 or Vector2.new(view.X / 2, view.Y)
		self.snap.From, self.snap.To, self.snap.Color = origin, Vector2.new(rootPoint.X, bottom.Y), snapColor
		self.snap.Thickness = colors.snapThick or 1
		self.snap.ZIndex = 1
		if colors.glowSnap then
			self:haloLine("snap", self.snap.From, self.snap.To, colors.glowSnapColor, self.snap.Thickness, true)
		else
			self:haloHide("snap")
		end
	else
		self:haloHide("snap")
	end
	self.headDot.Visible = item(team, "Main/Head Dot") and head ~= nil
	if self.headDot.Visible then
		local headPoint = currentCamera:WorldToViewportPoint(head.Position)
		self.headDot.Position = fixPoint(headPoint)
		self.headDot.Radius = math.clamp(height * 0.045 * (colors.dotSize or 100) / 100, 2, 24)
		self.headDot.Color = colors.headDot
		self.headDot.ZIndex = 1
		if colors.glowHead then
			self:haloCircle("head", self.headDot.Position, self.headDot.Radius, colors.glowHeadColor)
		else
			self:haloHide("head")
		end
	else
		self:haloHide("head")
	end

	local health = character:GetAttribute("Health") or 100
	local maxHealth = character:GetAttribute("MaxHealth") or 100
	local healthRatio = math.clamp(health / maxHealth, 0, 1)
	local barX = position.X - 2 - (colors.hpWidth or 2) / 2
	if item(team, "Main/Health Bar") then
		local shown = self.healthShown or healthRatio
		shown += (healthRatio - shown) * math.min((os.clock() - (self.healthAt or os.clock())) * 10, 1)
		self.healthShown, self.healthAt = shown, os.clock()
		verticalBar(self.healthBack, self.healthBar, barX, position.Y, height, shown, colors.healthLow:Lerp(colors.health, shown))
		barX -= ((colors.hpWidth or 2) + (colors.armorWidth or 2)) / 2 + 3
	else
		self.healthBack.Visible, self.healthBar.Visible = false, false
	end
	self.healthText.Visible = item(team, "Main/Health Text")
	if self.healthText.Visible then
		self.healthText.FontName, self.healthText.Size = colors.healthTextFont or "Pixel", colors.healthTextSize or 11
		self.healthText.Text = tostring(math.floor(health + 0.5))
		self.healthText.Color = colors.healthText
		self.healthText.Glow = colors.glowHealthText and colors.glowHealthTextColor or false
		self.healthText.Align = "Right"
		self.healthText.Position = Vector2.new(position.X - 5, position.Y + height * (1 - healthRatio) - (colors.healthTextSize or 11) / 2 - 1)
	end
	local armor, helmet = Game.armor(character)
	self.armorBar.Thickness, self.armorBack.Thickness = colors.armorWidth or 2, (colors.armorWidth or 2) + 2
	if item(team, "Main/Armor Bar") and armor > 0 then
		verticalBar(self.armorBack, self.armorBar, barX, position.Y, height, math.clamp(armor / 100, 0, 1), colors.armor)
	else
		self.armorBack.Visible, self.armorBar.Visible = false, false
	end

	local equipped = Game.equipped(entity)
	local equipName = equipped and equipped.Name
	if equipName ~= self.equipName then
		self.equipName, self.equipAt = equipName, os.clock()
	end
	local readiness = math.clamp((os.clock() - self.equipAt) / 0.6, 0, 1)
	if equipped and equipped.IsReloading then readiness = 0.3 end

	self.ammoBar.Thickness, self.ammoBack.Thickness = colors.ammoWidth or 2, (colors.ammoWidth or 2) + 2
	self.readyBar.Thickness, self.readyBack.Thickness = colors.readyWidth or 2, (colors.readyWidth or 2) + 2
	local barY = position.Y + height + 3

	local rounds = equipped and tonumber(equipped.Rounds)
	local maxRounds = equipped and tonumber(equipped.MaxRounds or equipped.Capacity or equipped.MagazineSize)
	if item(team, "Main/Ammo Bar") and rounds and maxRounds and maxRounds > 0 then
		horizontalBar(self.ammoBack, self.ammoBar, position.X, barY + (colors.ammoWidth or 2) / 2, width, math.clamp(rounds / maxRounds, 0, 1), colors.ammo)
		barY += (colors.ammoWidth or 2) + 3
	else
		self.ammoBack.Visible, self.ammoBar.Visible = false, false
	end

	if item(team, "Weapon/Readiness Bar") and equipName then
		horizontalBar(self.readyBack, self.readyBar, position.X, barY + (colors.readyWidth or 2) / 2, width, readiness, colors.ready)
		barY += (colors.readyWidth or 2) + 3
	else
		self.readyBack.Visible, self.readyBar.Visible = false, false
	end

	local textY = barY + 1
	self.distance.Visible = item(team, "Main/Distance")
	if self.distance.Visible then
		self.distance.Text = ("%dm"):format(distance * STUDS_PER_METER)
		self.distance.FontName, self.distance.Size = colors.distanceFont or "Pixel", colors.distanceSize or 12
		self.distance.Position = Vector2.new(rootPoint.X, textY)
		self.distance.Color = colors.distance
		self.distance.Glow = colors.glowDistance and colors.glowDistanceColor or false
		textY += (colors.distanceSize or 12) + 2
	end

	local weaponTags = {}
	if item(team, "Weapon/Text") and equipName then weaponTags[#weaponTags + 1] = equipName end
	if item(team, "Weapon/Bomb") and (equipName == "C4" or slotHas(entity, "C4")) then weaponTags[#weaponTags + 1] = "C4" end
	if item(team, "Weapon/Defuser") and entity:GetAttribute("HasDefuseKit") == true then weaponTags[#weaponTags + 1] = "KIT" end
	if item(team, "Weapon/Taser") and slotHas(entity, "Zeus") then weaponTags[#weaponTags + 1] = "ZEUS" end
	self.weapon.Visible = #weaponTags > 0
	if self.weapon.Visible then
		self.weapon.Text = table.concat(weaponTags, " · ")
		self.weapon.FontName, self.weapon.Size = colors.weaponFont or "Pixel", colors.weaponSize or 12
		self.weapon.Position = Vector2.new(rootPoint.X, textY)
		self.weapon.Color = colors.weapon
		self.weapon.Glow = colors.glowWeapon and colors.glowWeaponColor or false
		textY += (colors.weaponSize or 12) + 2
	end

	local flags = {}
	local function flag(key, text, condition)
		if condition and item(team, "Flags/" .. key) then flags[#flags + 1] = text end
	end
	flag("Unarmored", "NO ARMOR", armor <= 0)
	if item(team, "Flags/Unarmored") and armor > 0 then flags[#flags + 1] = helmet and "HK" or "K" end
	flag("Defuser", "KIT", entity:GetAttribute("HasDefuseKit") == true)
	flag("Blind", "BLIND", entity:GetAttribute("IsFlashed") == true or character:GetAttribute("Flashed") == true or character:GetAttribute("IsFlashed") == true)
	flag("Scoped", "ZOOM", (tonumber(entity:GetAttribute("ScopeIncrement")) or 0) > 0)
	flag("Reload", "RELOAD", (equipped and equipped.IsReloading == true) or entity:GetAttribute("IsReloading") == true)
	flag("Immunity", "IMMUNE", Game.isImmune(character))
	local speed = Ballistics.velocity(entity).Magnitude
	flag("Slowed", "SLOW", speed > 0.5 and speed < 7)
	flag("Vulnerable", "LETHAL", health <= 30)
	flag("Bomb", "C4", equipName == "C4" or slotHas(entity, "C4"))
	flag("Defuse", "DEFUSING", entity:GetAttribute("IsDefusingBomb") == true)
	flag("Pin Pulled", "PIN", equipName ~= nil and GRENADES[equipName] ~= nil and (entity:GetAttribute("IsThrowing") == true or entity:GetAttribute("IsShooting") == true))
	local money = tonumber(entity:GetAttribute("Money"))
	flag("Money", money and ("$" .. math.floor(money)) or "", money ~= nil)
	flag("Order Priority", "TARGET", Rage.target ~= nil and Rage.target.entity == entity)
	flag("Delay", "DELAY", readiness < 1)
	flag("Sees You", "SEES YOU", item(team, "Flags/Sees You") and Neverlose.seesYou(entity, character))

	self.flags.Visible = #flags > 0
	if self.flags.Visible then
		self.flags.FontName, self.flags.Size = colors.flagsFont or "Pixel", colors.flagsSize or 11
		self.flags.Text = table.concat(flags, "\n")
		self.flags.Color = colors.flags
		self.flags.Glow = colors.glowFlags and colors.glowFlagsColor or false
		self.flags.Position = Vector2.new(position.X + width + 4, position.Y)
	end

	local aimTexts = {}
	local weapon = Game.weapon()
	if item(team, "Aimbot/Hit Chance") and weapon and weapon.Properties and head then
		local chance = Ballistics.hitChance(Ballistics.spread(weapon), (head.Position - Game.origin()).Magnitude, head.Size.Magnitude / 3)
		local focus = Rage.target and Rage.target.entity == entity and Rage.target or nil
		local health = character:GetAttribute("Health")
		health = type(health) == "number" and health or 100
		local damage = Ballistics.damage(weapon.Properties, focus and focus.part and focus.part.Name or "Head", distance, 0, character)
		local need = damage > 0 and math.ceil(health / damage) or 99
		aimTexts[#aimTexts + 1] = ("HC %d%%  KC %d%%"):format(chance, (chance / 100) ^ need * 100)
	end
	self.aim.Visible = #aimTexts > 0
	if self.aim.Visible then
		self.aim.FontName, self.aim.Size = colors.aimFont or "Pixel", colors.aimSize or 11
		self.aim.Text = table.concat(aimTexts, " ")
		self.aim.Color = colors.aim
		self.aim.Glow = colors.glowAim and colors.glowAimColor or false
		self.aim.Position = Vector2.new(rootPoint.X, top.Y - 28)
	end

	local iconImage = item(team, "Weapon/Icon") and equipName and weaponIcon(equipName, true) or ""
	self.iconOn = iconImage ~= ""
	self:applyLayout(position, size, colors)
	self:placeWeaponIcon(iconImage, colors, position, size, root)
	local okHp, errHp = pcall(self.drawBars, self, colors, position, width)
	if not okHp then report(errHp) end
	local aimedPart = Rage.target and Rage.target.entity == entity and Rage.target.part and Rage.target.part.Name or nil
	local selected = item(team, "Aimbot/Hitboxes") and Rage.target and Rage.target.entity == entity and BODY_PARTS or {}
	local chosen = hitboxParts(Neverlose.config.rage.hitboxList, Neverlose.config.rage.hitboxes)
	self.hitBlend = self.hitBlend or {}
	local blendStep = math.min((os.clock() - (self.hitBlendAt or os.clock())) * 9, 1)
	self.hitBlendAt = os.clock()
	local function toScreen(world)
		local point = currentCamera:WorldToViewportPoint(world)
		return point.Z > 0 and Vector2.new(point.X, point.Y) or nil
	end
	for index, name in ipairs(BODY_PARTS) do
		local fill, outline = self.hitDots[index], self.hitDots[#BODY_PARTS + index]
		local part = table.find(selected, name) and character:FindFirstChild(name)
		fill.Visible, outline.Visible = false, false
		self.hitAdorns = self.hitAdorns or {}
		local adorn = self.hitAdorns[name]
		if part then
			local blend = self.hitBlend[name] or 0
			blend += ((aimedPart == name and 1 or 0) - blend) * blendStep
			self.hitBlend[name] = blend
			local pulse = 0.5 + 0.5 * math.sin(os.clock() * 5)
			if not (adorn and adorn.Parent) then
				adorn = newInstance("BoxHandleAdornment", { AlwaysOnTop = true, ZIndex = 2 }, effectsFolder)
				self.hitAdorns[name] = adorn
			end
			adorn.Adornee = part
			adorn.Size = part.Size + Vector3.new(0.08, 0.08, 0.08)
			adorn.Color3 = colors.hitboxes:Lerp(colors.hitboxes2 or Color3.fromRGB(255, 110, 150), blend)
			adorn.Transparency = (table.find(chosen, name) and 0.5 or 0.78) - blend * 0.25 - pulse * 0.06 * blend
			adorn.Visible = true
		elseif adorn then
			adorn.Visible = false
		end
	end

	local skeleton = item(team, "Main/Skeleton")
	local skeletonGlow = colors.glowSkeleton and colors.glowSkeletonColor or nil
	for index, bone in ipairs(BONES) do
		local line = self.bones[index]
		local from, to = character:FindFirstChild(bone[1]), character:FindFirstChild(bone[2])
		if skeleton and from and to then
			local a, aVisible = currentCamera:WorldToViewportPoint(from.Position)
			local b, bVisible = currentCamera:WorldToViewportPoint(to.Position)
			line.Visible = aVisible and bVisible
			line.From, line.To, line.Color = fixPoint(a), fixPoint(b), skeletonColor
			line.Thickness = colors.skelThick or 1
			line.ZIndex = 1
			if skeletonGlow then
				self:haloLine("bone" .. index, line.From, line.To, skeletonGlow, line.Thickness, line.Visible)
			else
				self:haloHide("bone" .. index)
			end
		else
			line.Visible = false
			self:haloHide("bone" .. index)
		end
	end

	local historyChams = config.enemyModel.history
	local aimedAt = Rage.target ~= nil and Rage.target.entity == entity
	local records = aimedAt and isEnemy and historyChams.mode ~= "Disabled" and Ballistics.history[entity]
	local headNow = character:FindFirstChild("Head")
	local oldest
	if records and headNow then
		for index = 1, #records do
			local past = records[index].cframes.Head
			if past and (past.Position - headNow.Position).Magnitude <= 5 then
				oldest = records[index]
				break
			end
		end
	end
	local headThen = oldest and oldest.cframes.Head
	if oldest and headNow and headThen and (headThen.Position - headNow.Position).Magnitude > 0.4 then
		self:drawGhost(character, oldest, historyChams)
	else
		self:hideGhost("ghost")
	end
end

local espStepName = randomName()

runService:BindToRenderStep(espStepName, Enum.RenderPriority.Last.Value + 21, function()
	if not Game.inMatch() then
		for _, object in pairs(Esp.objects) do pcall(object.hide, object) end
		return
	end
	local alive = {}
	for _, entity in ipairs(Game.entities()) do
		if entity ~= localPlayer then
			alive[entity] = true
			local object = Esp.objects[entity]
			if not object then
				local created, made = pcall(EspObject.new, entity)
				if created then
					object = made
					Esp.objects[entity] = object
				else
					report(made)
				end
			end
			if object then
				local ok, err = pcall(object.update, object)
				if ok then
					object.failures = 0
				else
					object.failures = (object.failures or 0) + 1
					if object.failures >= 4 then object:hide() end
					report(err)
				end
			end
		end
	end
	for entity, object in pairs(Esp.objects) do
		if not alive[entity] then
			object:destroy()
			Esp.objects[entity] = nil
		end
	end
end)
maid:give(function() pcall(runService.UnbindFromRenderStep, runService, espStepName) end)

maid:give(function()
	for entity, object in pairs(Esp.objects) do
		object:destroy()
		Esp.objects[entity] = nil
	end
end)

do
	local localHighlight = newInstance("Highlight", { Enabled = false, Name = randomName() }, highlightFolder)
	local localBody = { store = setmetatable({}, { __mode = "k" }), scan = 0 }
	maid:give(function() BodyMat.restore(localBody.store) end)
	local viewmodelOriginals = setmetatable({}, { __mode = "k" })
	local handsHidden = setmetatable({}, { __mode = "k" })
	local HAND_WORDS = { "arm", "hand", "glove", "sleeve" }
	local function materialOf(mode)
		if mode == "Metal" then return Enum.Material.Metal end
		local style = CHAMS_STYLE[mode]
		return style and (style.material or Enum.Material.Neon) or nil
	end

	local function isHand(part)
		local name = part.Name:lower()
		for _, word in ipairs(HAND_WORDS) do
			if name:find(word, 1, true) then return true end
		end
		return false
	end

	local function restoreViewmodel()
		for part, original in pairs(viewmodelOriginals) do
			if part.Parent then part.Material, part.Color = original[1], original[2] end
		end
		table.clear(viewmodelOriginals)
		for part in pairs(handsHidden) do
			if part.Parent then part.LocalTransparencyModifier = 0 end
