					if not box or not box.Parent then
						box = Instance.new("BoxHandleAdornment")
						box.Adornee, box.ZIndex, box.AlwaysOnTop = Xray.anchor, 1, true
						if SHADING then pcall(function() box.Shading = SHADING end) end
						if CULLING then pcall(function() box.AdornCullingMode = CULLING end) end
						box.Parent = Xray.folder
						set[name] = box
					end
