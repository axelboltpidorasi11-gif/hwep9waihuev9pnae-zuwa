local function ownsCharm(entry, target)
	local owner = entry.weapon
	return owner == nil or owner == "All" or owner == target or Skins.resolve(owner) == target
end

-- True when the player pinned a charm to this weapon in the 3D preview, so the default charm slot must stay empty.
function Skins.customCharm(weaponName)
	local target = weaponName and Skins.resolve(weaponName == "Zeus" and "Zeus x27" or weaponName) or nil
	for _, entry in ipairs(Neverlose.config.skins.charms or {}) do
