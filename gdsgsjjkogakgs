}

function Skins.rarityColor(rarity)
	local text = tostring(rarity or ""):lower()
	for _, pair in ipairs(RARITY_COLORS) do
		if text:find(pair[1], 1, true) then return pair[2] end
	end
	return Color3.fromRGB(176, 180, 192)
end

local SKIN_RANKS = { contraband = 8, extraordinary = 8, covert = 7, legendary = 7, classified = 6, epic = 6, restricted = 5, mil = 4, rare = 4, industrial = 3, uncommon = 3, consumer = 2 }

function Skins.rarityRank(rarity)
	local text = tostring(rarity or ""):lower()
	for key, rank in pairs(SKIN_RANKS) do
		if text:find(key, 1, true) then return rank end
	end
	return 1
end

local function assetImage(value)
	if value == nil then return "" end
	local text = tostring(value)
	if text == "" then return "" end
	if text:find("rbxasset", 1, true) or text:find("rbxthumb", 1, true) then return text end
	local digits = text:match("%d+")
	return digits and ("rbxassetid://" .. digits) or ""
end

