	function Neverlose.predictSpot(from, velocity, age)
		if not velocity or velocity.Magnitude < 2 then return from, false end
		local tau = 1.1
		local travel = velocity * tau * (1 - math.exp(-math.min(age, 4) / tau))
		if travel.Magnitude < 0.5 then return from, false end
		predictParams.FilterDescendantsInstances = { localPlayer.Character, currentCamera, effectsFolder, workspaceService:FindFirstChild("Characters") }
		local hit = workspaceService:Raycast(from, travel, predictParams)
		if hit then return hit.Position - travel.Unit * 1.2, true end
		return from + travel, false
	end
	local function noteKnown(entity, position, nowClock)
		local entry = Neverlose.lastKnown[entity]
		if not entry then
			entry = { trail = {} }
			Neverlose.lastKnown[entity] = entry
		end
		local previous, previousAt = entry.position, entry.t
		if previous and previousAt then
			local delta = nowClock - previousAt
			if delta > 0.004 and delta < 0.4 then
				local speed = Vector3.new(position.X - previous.X, 0, position.Z - previous.Z) / delta
				if speed.Magnitude > 40 then speed = speed.Unit * 40 end
				entry.velocity = entry.velocity and entry.velocity:Lerp(speed, 0.25) or speed
			end
		end
		entry.position, entry.t = position, nowClock
		local trail = entry.trail
		local lastPoint = trail[#trail]
		if not lastPoint or (position - lastPoint.position).Magnitude > 2 then
			trail[#trail + 1] = { position = position - Vector3.new(0, 2.8, 0), t = nowClock }
			if #trail > 14 then table.remove(trail, 1) end
