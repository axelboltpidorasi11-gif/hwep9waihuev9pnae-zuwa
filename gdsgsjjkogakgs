local function updateFlight(entry, age)
	local head = math.clamp(age / entry.flight, 0, 1)
	local tail = math.clamp((age - entry.tailDelay) / entry.flight, 0, 1)
	tail = tail * tail * (3 - 2 * tail)
	local unit = (entry.to - entry.from) / entry.distance
	entry.tailPart.CFrame = CFrame.new(entry.from + unit * (entry.distance * tail))
	entry.headPart.CFrame = CFrame.new(entry.from + unit * (entry.distance * head))
	local shrink = 1 - tail * 0.6
	local fadeOut = 1 - math.clamp((age - entry.flight) / (entry.tailDelay + 0.1), 0, 1) ^ 1.5
	for _, layer in ipairs(entry.layers) do layer.beam.Width1 = layer.base * shrink * fadeOut end
	if entry.emitters and not entry.stopped then
		local previous = entry.lastHead or 0
		local travelled = (head - previous) * entry.distance
		local steps = math.clamp(math.ceil(travelled / 2.5), 1, 48)
		for step = 1, steps do
			local along = previous + (head - previous) * step / steps
			entry.sparkPart.CFrame = CFrame.new(entry.from + unit * (entry.distance * along))
			entry.emitters[1]:Emit(1)
			if step % 2 == 0 then entry.emitters[2]:Emit(1) end
		end
		entry.lastHead = head
		if head >= 1 then entry.stopped = true end
	end
	entry.head.ImageTransparency = 0.15 + 0.85 * math.clamp((age - entry.flight) / 0.12, 0, 1)
	if entry.helix then
		updateHelix(entry.helix, entry.distance * head, entry.distance * tail, age, 1 - math.clamp((age - entry.flight) / 0.25, 0, 1))
	end
end

function HitEffects.tracer(origin, finish, hit, normal, surfaces)
	local misc = Neverlose.config.misc
	local now = os.clock()
	if misc.tracers then
		local view = currentCamera.CFrame
		local from = origin + view.LookVector * 2.2 + view.RightVector * 0.45 - view.UpVector * 0.35
		if (finish - from).Magnitude < 3 then from = origin end
		local style = misc.tracerStyle
		if style ~= "Lightning" and style ~= "Spiral" and style ~= "Sparkle Trail" and style ~= "Neon" then style = "Comet" end
		if style == "Lightning" then
			local width = math.clamp((misc.tracerThickness or 2) * 0.03, 0.03, 0.4)
			local color = misc.tracerColor
			local entry = { kind = "tracer", t = now, life = misc.tracerLife or 1.5, style = style, parts = {}, base = {}, from = from, to = finish, width = width, color = color }
			local direction = finish - from
			local length = direction.Magnitude
			local steps = math.clamp(math.floor(length / 4), 4, 28)
			local right, up = across(direction.Unit)
			local jitter = math.min(length / steps * 0.4, 1.5)
			local points = { from }
			for index = 1, steps - 1 do
				points[#points + 1] = from + direction * (index / steps) + right * ((math.random() - 0.5) * 2 * jitter) + up * ((math.random() - 0.5) * 2 * jitter)
			end
			points[#points + 1] = finish
			for index = 1, #points - 1 do
				local part = beam(points[index], points[index + 1], width, color, 0)
				if part then entry.parts[#entry.parts + 1], entry.base[#entry.parts] = part, 0 end
			end
			tracers[#tracers + 1] = entry
			pcall(HitEffects.sprite, from, color, 1.3, 0.16, GLOW_TEXTURE, false)
			if hit then pcall(HitEffects.sprite, finish, color, 2.2, 0.3, GLOW_TEXTURE, false) end
		elseif style == "Neon" then
			HitEffects.neon(from, finish)
		else
			spawnFlight(from, finish, style)
		end
	end

	if misc.impacts and hit then
		local list = {}
		for _, surface in ipairs(type(surfaces) == "table" and surfaces or {}) do
			if not surface.Exit and typeof(surface.Position) == "Vector3" then list[#list + 1] = surface end
		end
		if #list > 0 then
			for index = 1, math.min(#list, 4) do spawnImpact(list[index].Position, list[index].Normal) end
		else
			spawnImpact(finish, normal)
		end
	end
end

