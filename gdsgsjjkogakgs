function HitEffects.skybolt(target, color, weather)
	local camera = currentCamera.CFrame.Position
	local top
	local width = 2
	if not weather and typeof(target) == "Vector3" then
		local view, onScreen = currentCamera:WorldToViewportPoint(target)
		if not onScreen or view.Z <= 0 then return end
	end
	if weather then
		local look = currentCamera.CFrame.LookVector
		local heading = math.atan2(look.Z, look.X)
		local angle = heading + (math.random() - 0.5) * 1.0
		local distance = 450 + math.random() * 350
		local ground = Vector3.new(camera.X + math.cos(angle) * distance, camera.Y, camera.Z + math.sin(angle) * distance)
		local hit = workspaceService:Raycast(ground + Vector3.new(0, 500, 0), Vector3.new(0, -1100, 0))
		target = hit and hit.Position or ground - Vector3.new(0, 25, 0)
		top = target + Vector3.new((math.random() - 0.5) * 220, 520 + math.random() * 220, (math.random() - 0.5) * 220)
		width = 5
	else
		top = target + Vector3.new((math.random() - 0.5) * 120, 460, (math.random() - 0.5) * 120)
	end

	local points = { top }
	local steps = 22
	for index = 1, steps - 1 do
		local alpha = index / steps
		local spread = (weather and 55 or 32) * (1 - alpha)
		points[#points + 1] = top:Lerp(target, alpha) + Vector3.new((math.random() - 0.5) * spread, 0, (math.random() - 0.5) * spread)
	end
	points[#points + 1] = target

	local core = Color3.new(1, 1, 1):Lerp(color, 0.3)
	for index = 2, #points do
		local a, b = points[index - 1], points[index]
		local length = (b - a).Magnitude
		if length > 0.05 then
			local thick = width * (0.6 + 0.4 * index / #points)
			local middle = CFrame.lookAt(a:Lerp(b, 0.5), b)
			HitEffects.fade(HitEffects.glow(middle, Vector3.new(thick * 3, thick * 3, length), color, nil, 0.5), { Size = Vector3.new(0.1, 0.1, length) }, 0.6)
			HitEffects.fade(HitEffects.glow(middle, Vector3.new(thick, thick, length), core), { Size = Vector3.new(0.05, 0.05, length) }, 0.42)
		end
	end
	for _ = 1, 3 do
		local previous = points[math.random(4, #points - 4)]
		local direction = Vector3.new((math.random() - 0.5) * 2, -0.7, (math.random() - 0.5) * 2).Unit
		for step = 1, 5 do
			local following = previous + direction * (weather and 38 or 18) + Vector3.new((math.random() - 0.5) * 8, 0, (math.random() - 0.5) * 8)
			local length = (following - previous).Magnitude
			local fork = HitEffects.glow(CFrame.lookAt(previous:Lerp(following, 0.5), following), Vector3.new(width * 0.45, width * 0.45, length), color, nil, 0.2)
			HitEffects.fade(fork, { Size = Vector3.new(0.05, 0.05, length) }, 0.28 + step * 0.04)
			previous = following
		end
	end

	if weather then
		local light = Neverlose.config.world.light
		if light.stormSound then HitEffects.thunder((target - camera).Magnitude, (light.stormVolume or 60) / 100) end
	end
	pcall(HitEffects.sprite, target, color, weather and 60 or 14, 0.45, GLOW_TEXTURE, false)
	pcall(HitEffects.sprite, top, color, weather and 160 or 60, 0.35, GLOW_TEXTURE, false)
	if not weather then
		pcall(HitEffects.sprite, target, Color3.new(1, 1, 1), 9, 0.25, "rbxassetid://15202086620", true)
		particleLayer(target, {
			{ texture = SPARK_TEXTURE, color = color, lifetime = NumberRange.new(0.4, 1), speed = NumberRange.new(12, 28), spread = Vector2.new(180, 180), acceleration = Vector3.new(0, -16, 0), drag = 1, size = shrink(0.7), count = 34 },
			{ texture = GLOW_TEXTURE, color = color, lifetime = NumberRange.new(0.3, 0.6), speed = NumberRange.new(0, 2), size = shrink(5, 9), count = 3 },
		}, 1.6)
	end
	Neverlose.flash(weather and 0.22 or 0.16)
end

