	local function save(group, values)
		if not saved[group] then saved[group] = values end
	end

	local function restore(group, apply)
		local values = saved[group]
		if values then
			saved[group] = nil
			apply(values)
		end
	end

	local function ensureEffect(class, current)
		if current and current.Parent then return current end
		return newInstance(class, { Name = randomName() }, lightingService)
	end

	local hiddenSkies = {}
	local SKY_ROOTS = { "Neverlose Bloxstrike/skyboxes", "neurothycal/storage/skyboxes" }
	local SKY_SIDES = { bk = "SkyboxBk", dn = "SkyboxDn", ft = "SkyboxFt", lf = "SkyboxLf", rt = "SkyboxRt", up = "SkyboxUp" }
	local localSkies

	---Skybox folders on disk: a folder holding six faces named *_bk/_dn/_ft/_lf/_rt/_up.
	local function scanLocalSkies()
		if localSkies then return localSkies end
		localSkies = {}
		if not (listfiles and isfolder and getcustomasset) then return localSkies end
		for _, root in ipairs(SKY_ROOTS) do
			local okRoot, folders = pcall(function() return isfolder(root) and listfiles(root) or {} end)
			for _, folder in ipairs(okRoot and folders or {}) do
				local okFiles, files = pcall(listfiles, folder)
				local faces, count = {}, 0
				for _, file in ipairs(okFiles and files or {}) do
					local side = tostring(file):lower():match("[_%-%./\\](%a%a)%.%a+$")
					if side and SKY_SIDES[side] and not faces[SKY_SIDES[side]] then
						faces[SKY_SIDES[side]] = file
						count += 1
					end
				end
				if count == 6 then
					local name = "local: " .. tostring(folder):match("[^/\\]+$")
					localSkies[name] = localSkies[name] or faces
				end
			end
		end
		return localSkies
	end

	---Every skybox the menu can offer: online presets plus folders found on disk.
	function Neverlose.skyNames()
		local names = {}
		for name in pairs(SKY_ASSETS) do table.insert(names, name) end
		for name in pairs(SKY_FACES) do table.insert(names, name) end
		table.sort(names)
		local extra = {}
		for name in pairs(scanLocalSkies()) do table.insert(extra, name) end
		table.sort(extra)
		for _, name in ipairs(extra) do table.insert(names, name) end
		return names
	end

	local function hideOtherSkies()
		for _, child in ipairs(lightingService:GetChildren()) do
			if child:IsA("Sky") and child ~= skyInstance then
				hiddenSkies[child] = child.Parent
				child.Parent = nil
			end
		end
	end

	local function clearSky()
		skyToken += 1
		if skyInstance then pcall(function() skyInstance:Destroy() end) skyInstance = nil end
		for sky, parent in pairs(hiddenSkies) do
			if sky.Parent == nil then pcall(function() sky.Parent = parent or lightingService end) end
		end
		table.clear(hiddenSkies)
	end

	local function adoptSky(sky)
		hideOtherSkies()
		if skyInstance and skyInstance ~= sky then pcall(function() skyInstance:Destroy() end) end
		sky.Parent = lightingService
		skyInstance = sky
	end

	local function setSky(preset)
		skyToken += 1
		local token = skyToken
		local disk = scanLocalSkies()[preset]
		if disk then
			local props = {}
			for property, file in pairs(disk) do
				local ok, asset = pcall(getcustomasset, file)
				if ok then props[property] = asset end
			end
			props.StarCount, props.CelestialBodiesShown = 0, false
			adoptSky(newInstance("Sky", props))
			return
		end
		local faces = SKY_FACES[preset]
		if faces then
			adoptSky(newInstance("Sky", faces))
			return
		end

		local assetId = SKY_ASSETS[preset]
		if not assetId then return end
		task.spawn(function()
			local ok, objects = pcall(game.GetObjects, game, "rbxassetid://" .. assetId)
			if not ok or type(objects) ~= "table" then return end
			local sky
			for _, object in ipairs(objects) do
				sky = sky or (object:IsA("Sky") and object or object:FindFirstChildWhichIsA("Sky", true))
			end
			if not sky or token ~= skyToken or not effective(Neverlose.config.world.light).sky then
				for _, object in ipairs(objects) do object:Destroy() end
				return
			end
			sky.StarCount, sky.CelestialBodiesShown = 0, false
			adoptSky(sky)
		end)
	end

