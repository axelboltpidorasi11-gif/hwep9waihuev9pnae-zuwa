	end
	return false
end

-- Model-space bounds measured in the pivot frame, so a spot picked on one model maps onto another build of the same weapon.
function Skins.pivotBounds(model)
	local pivot = model:GetPivot()
	local low, high = Vector3.one * math.huge, Vector3.one * -math.huge
	for _, object in ipairs(model:GetDescendants()) do
		if object:IsA("BasePart") and object.Transparency < 0.95 and not object:FindFirstAncestor("NeverloseCharm") then
			local half = object.Size / 2
			for _, corner in ipairs({ Vector3.new(1, 1, 1), Vector3.new(1, 1, -1), Vector3.new(1, -1, 1), Vector3.new(1, -1, -1), Vector3.new(-1, 1, 1), Vector3.new(-1, 1, -1), Vector3.new(-1, -1, 1), Vector3.new(-1, -1, -1) }) do
				local point = pivot:PointToObjectSpace((object.CFrame * CFrame.new(half * corner)).Position)
				low, high = low:Min(point), high:Max(point)
			end
		end
	end
	if low.X == math.huge then return nil end
	return pivot, low, high
end

function Skins.attachCharms(model, weaponName)
	local all = Neverlose.config.skins.charms
	local list = {}
	local target = weaponName and Skins.resolve(weaponName == "Zeus" and "Zeus x27" or weaponName) or nil
	for _, entry in ipairs(type(all) == "table" and all or {}) do
		local owner = entry.weapon
		if ownsCharm(entry, target) then
			if #list < 5 then list[#list + 1] = entry end
		end
	end
	local lib = Game.modules.skins
	if typeof(model) ~= "Instance" or type(list) ~= "table" or #list == 0 or not (lib and type(lib.GetCharmModel) == "function") then return end
	local parts = {}
	for _, object in ipairs(model:GetDescendants()) do
		if object:IsA("BasePart") and object.Transparency < 0.95 and not object:FindFirstAncestor("NeverloseCharm") then parts[#parts + 1] = object end
	end
	if #parts == 0 then return end
	local okBox, boxCf, boxSize = pcall(model.GetBoundingBox, model)
	if not okBox then return end
	local rng = Random.new(#list * 7919)
	for index, entry in ipairs(list) do
		local ok, charm = asGame(lib.GetCharmModel, entry.name, 1)
		if ok and typeof(charm) == "Instance" and charm.PrimaryPart then
			local world
			if entry.at == "Custom" then
				local pivot, low, high = Skins.pivotBounds(model)
				if pivot then
					local spot = low + (Vector3.new(entry.fx or 0, entry.fy or 0, entry.fz or 0) + Vector3.new(0.5, 0.5, 0.5)) * (high - low)
					world = pivot * CFrame.new(spot)
				else
					world = boxCf
				end
			elseif entry.at == "Charm Point" then
				local point = model:FindFirstChild("Charm" .. tostring(entry.slot or 1), true) or model:FindFirstChildWhichIsA("Attachment", true)
				world = point and point:IsA("Attachment") and point.WorldCFrame or boxCf
			elseif entry.at == "Random" then
				local local3 = Vector3.new(rng:NextNumber(-0.5, 0.5), rng:NextNumber(-0.5, 0.5), rng:NextNumber(-0.5, 0.5))
				world = boxCf * CFrame.new(boxSize * local3)
			else
				world = boxCf * CFrame.new(boxSize * (CHARM_SPOTS[entry.at] or Vector3.zero))
			end
			world = world * CFrame.new((entry.x or 0) / 10, (entry.y or 0) / 10, (entry.z or 0) / 10)
			local scale = (entry.size or 100) / 100
			if scale ~= 1 then pcall(charm.ScaleTo, charm, scale) end
			charm.Name = "NeverloseCharm"
			charm:PivotTo(world)
			local best, bestDistance = parts[1], math.huge
			for _, part in ipairs(parts) do
				local distance = (part.Position - world.Position).Magnitude
				if distance < bestDistance then best, bestDistance = part, distance end
			end
			for _, object in ipairs(charm:GetDescendants()) do
				if object:IsA("BasePart") then object.Massless, object.CanCollide = true, false end
			end
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = charm.PrimaryPart, best
			weld.Parent = charm.PrimaryPart
			charm.Parent = model
		end
	end
end

local MVP_SOUND_ID = "95976833351497"
Skins.music = { sound = nil }

function Skins.musicEntries()
	local out = {}
	local database = replicatedStorage:FindFirstChild("Database")
	local audio = database and database:FindFirstChild("Audio")
	for _, def in ipairs({ { "Main Menu", "Main Menu", "Main Menu Music" }, { "Bomb Planted", "Counter-Terrorists", "Bomb Planted Music" }, { "Survival", "Survival", "Music" } }) do
		local module = audio and audio:FindFirstChild(def[2])
		local ok, data = false, nil
		if module then ok, data = pcall(require, module) end
		local row = ok and type(data) == "table" and data[def[3]] or nil
		local id = type(row) == "table" and type(row.Identifiers) == "table" and row.Identifiers[1] or nil
		if id then out[#out + 1] = { name = def[1], id = tostring(id), start = 0, stop = 0 } end
	end
	for _, entry in ipairs(Neverlose.config.skins.musicList or {}) do out[#out + 1] = entry end
	return out
end

function Skins.musicFind(name)
	for _, entry in ipairs(Skins.musicEntries()) do
		if entry.name == name then return entry end
	end
	return nil
end

function Skins.musicStop()
	local current = Skins.music.sound
	Skins.music.sound, Skins.music.owner = nil, nil
	if current then pcall(function() current:Stop() current:Destroy() end) end
end

function Skins.musicPlay(entry)
	Skins.musicStop()
	if not entry then return end
	local sound = Instance.new("Sound")
	sound.Name = "NeverloseMusic"
	sound.SoundId = "rbxassetid://" .. tostring(entry.id):gsub("%D", "")
	sound.Volume = math.clamp((tonumber(entry.volume) or Neverlose.config.skins.musicVolume or 70) / 100, 0, 3)
	sound.Parent = game:GetService("SoundService")
	Skins.music.sound = sound
	local start, stop = tonumber(entry.start) or 0, tonumber(entry.stop) or 0
	task.spawn(function()
		local waited = 0
		while sound.Parent and not sound.IsLoaded and waited < 5 do task.wait(0.1) waited += 0.1 end
		if not sound.Parent then return end
		sound.TimePosition = math.max(start, 0)
		sound:Play()
		if stop > start then
			task.delay(stop - start, function()
				if Skins.music.sound == sound then Skins.musicStop() end
			end)
		end
	end)
	sound.Ended:Connect(function() if Skins.music.sound == sound then Skins.music.sound = nil sound:Destroy() end end)
end

function Skins.musicAdd(text, extra)
	local id, rest = tostring(text or ""):match("^%s*(%d+)%s*(.*)$")
	if not id then return false end
	local start, stop, name = rest:match("^(%d+%.?%d*)%s+(%d+%.?%d*)%s*(.*)$")
	if not start then name = rest end
	if type(extra) == "table" then
		if extra.name and extra.name ~= "" then name = extra.name end
		start, stop = extra.start or start, extra.stop or stop
	end
	name = (name and name ~= "") and name or ("Track " .. id)
	local list = Neverlose.config.skins.musicList
	for _, entry in ipairs(list) do if entry.name == name then return false end end
	list[#list + 1] = { name = name, id = id, start = tonumber(start) or 0, stop = tonumber(stop) or 0, volume = type(extra) == "table" and tonumber(extra.volume) or nil }
	Skins.save()
	return true
end

do
	-- The game builds its MVP sound ahead of time, so the track starts on the moment that sound really plays and ends with it.
	local function onSound(object)
		if not object:IsA("Sound") or object.Name == "NeverloseMusic" then return end
		if not tostring(object.SoundId):find(MVP_SOUND_ID, 1, true) then return end
		local function start()
			local config = Neverlose.config.skins
			if not config.enabled then return end
			local entry = config.bySide and config.bySide[Skins.activeSide()]
			local picked = entry and entry.music and Skins.musicFind(entry.music)
			if not picked then return end
			object.Volume = 0
			Skins.musicPlay(picked)
			Skins.music.owner = object
		end
		local function finish()
			if Skins.music.owner == object then Skins.musicStop() end
		end
		if object.Playing then start() end
		object:GetPropertyChangedSignal("Playing"):Connect(function()
			if object.Playing then start() else finish() end
		end)
		object.Ended:Connect(finish)
		object.Destroying:Connect(finish)
	end
	maid:give(game.DescendantAdded:Connect(onSound))
	maid:give(Skins.musicStop)
end

