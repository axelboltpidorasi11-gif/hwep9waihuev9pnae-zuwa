	ui.healthText = label(10)
	ui.flags = label(10, Enum.TextXAlignment.Left)
	ui.flags.TextYAlignment = Enum.TextYAlignment.Top
	ui.flags.Size = UDim2.fromOffset(80, 200)
	local function bar(vertical, color)
		local back = frame(layer, { BackgroundColor3 = Color3.new(), ZIndex = z })
		local fill = frame(back, { BackgroundColor3 = color, ZIndex = z + 1, AnchorPoint = vertical and Vector2.new(0, 1) or Vector2.new(0, 0), Position = vertical and UDim2.new(0, 1, 1, -1) or UDim2.fromOffset(1, 1) })
		local hit = frame(layer, { BackgroundTransparency = 1, ZIndex = z + 3, Visible = false })
		return { back = back, fill = fill, vertical = vertical, hit = hit }
	end
	ui.health = bar(true, Color3.fromRGB(90, 255, 110))
	ui.armor = bar(true, Color3.fromRGB(90, 170, 255))
	ui.ammo = bar(false, Color3.fromRGB(90, 170, 255))
	ui.ready = bar(false, Color3.fromRGB(255, 210, 90))
	ui.headDot = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 6), ZIndex = z + 3, Visible = false })
	newInstance("UICorner", { CornerRadius = UDim.new(1, 0) }, ui.headDot)
	ui.snap = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z + 1, Visible = false })
	ui.bones, ui.dots, ui.strokes, ui.cores = {}, {}, {}, {}
	for index = 1, #BONES do ui.bones[index] = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z + 1, Visible = false }) end
	for index = 1, #BODY_PARTS do
		ui.dots[index] = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(11, 11), BackgroundColor3 = Color3.fromRGB(150, 164, 255), BackgroundTransparency = 0.25, ZIndex = z + 2, Visible = false })
		newInstance("UICorner", { CornerRadius = UDim.new(1, 0) }, ui.dots[index])
		ui.strokes[index] = newInstance("UIStroke", { Thickness = 1.5, Transparency = 0.25, Color = Color3.fromRGB(190, 200, 255), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ui.dots[index])
		local core = frame(ui.dots[index], { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = z + 3 })
		newInstance("UICorner", { CornerRadius = UDim.new(1, 0) }, core)
		ui.cores[index] = core
	end

	do
		Preview.centers = Preview.centers or {}
		Preview.drag = nil
		ui.slot = frame(layer, { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.9, ZIndex = z + 5, Visible = false })
		newInstance("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.55 }, ui.slot)
		newInstance("UICorner", { CornerRadius = UDim.new(0, 3) }, ui.slot)

		local function sideOf(point, current)
			local rect = Preview.rect
			if not rect then return "Bottom" end
			local dx = (point.X - (rect.x + rect.w / 2)) / (rect.w / 2 + 36)
			local dy = (point.Y - (rect.y + rect.h / 2)) / (rect.h / 2 + 36)
			local ax, ay = math.abs(dx), math.abs(dy)
			if current == "Left" or current == "Right" then
				if ax + 0.2 >= ay then return dx < 0 and "Left" or "Right" end
			elseif current == "Top" or current == "Bottom" then
				if ay + 0.2 >= ax then return dy < 0 and "Top" or "Bottom" end
			end
			if ax > ay then return dx < 0 and "Left" or "Right" end
			return dy < 0 and "Top" or "Bottom"
		end

		local function grab(id, element)
			element.Active = true
			element.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton2 then
					Neverlose.config.esp.layout[id] = nil
				elseif (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and Preview.centers[id] then
					Preview.drag = { id = id, origin = input.Position, start = Preview.centers[id], point = Preview.centers[id] }
				end
			end)
		end
		for _, id in ipairs({ "name", "aim", "distance", "weapon", "flags" }) do grab(id, ui[id]) end
		for _, id in ipairs({ "health", "armor", "ammo", "ready" }) do grab(id, ui[id].hit) end
		grab("weaponIcon", ui.weaponIcon)

		maid:give(userInputService.InputChanged:Connect(function(input)
			local drag = Preview.drag
			if not drag or (input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch) then return end
			local delta = input.Position - drag.origin
			local point = Vector2.new(drag.start.X + delta.X, drag.start.Y + delta.Y)
			drag.point, drag.side = point, sideOf(point, drag.side)
		end))
		maid:give(userInputService.InputEnded:Connect(function(input)
			local drag = Preview.drag
			if not drag or (input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch) then return end
			if drag.side then
				Neverlose.config.esp.layout[drag.id] = drag.side ~= Neverlose.LAYOUT_DEFAULT[drag.id] and drag.side or nil
			end
			Preview.drag = nil
		end))
	end
	Preview.ui, Preview.viewport, Preview.api = ui, viewport, api
end

local originals = setmetatable({}, { __mode = "k" })

local function paintModel(model, visible, walls)
	local style = CHAMS_STYLE[walls and walls.mode or ""] and walls or visible
	local def = style and CHAMS_STYLE[style.mode or ""]
	Preview.bodyState = Preview.bodyState or { store = originals, scan = 0 }
	if def then
		local shown
		if def.neon then
			shown = { material = Enum.Material.Neon, alpha = 0 }
		else
			shown = { material = def.material or (def.fill >= 1 and Enum.Material.ForceField) or Enum.Material.Neon, alpha = def.alpha }
		end
		Preview.bodyState.scan = 0
		BodyMat.drive(Preview.bodyState, model, shown, style.color)
	else
		BodyMat.drive(Preview.bodyState, nil, nil, nil)
	end
end

function Preview.standIn(world, camera, viewport)
	if os.clock() - (Preview.standInAt or -10) < 2 then return nil end
	Preview.standInAt = os.clock()

	local ok, rig = pcall(function()
		return playersService:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if not ok or typeof(rig) ~= "Instance" then return nil end

	local existing = world:FindFirstChildOfClass("Model")
	if existing then
		rig:Destroy()
		return existing
	end

	for _, object in ipairs(rig:GetDescendants()) do
		if object:IsA("BasePart") then
			object.Anchored, object.CanCollide = true, false
		elseif object:IsA("LuaSourceContainer") or object:IsA("Sound") then
			object:Destroy()
		end
	end
	rig.Parent = world
	pcall(function() rig:PivotTo(CFrame.Angles(0, math.pi, 0)) end)

	local cframe, size = rig:GetBoundingBox()
	local view = viewport.AbsoluteSize
	local aspect = (view.X > 0 and view.Y > 0) and view.X / view.Y or 0.75
	local span = math.max(size.Y, math.max(size.X, size.Z) / aspect)
	camera.CFrame = CFrame.new(cframe.Position + Vector3.new(0, 0, span / 2 / math.tan(math.rad(15)) * 1.3), cframe.Position)
	return rig
end

function Preview.update()
	local ui, viewport, api = Preview.ui, Preview.viewport, Preview.api
	if not (ui and viewport and viewport.Parent) then return end
	local mainFrame = Neverlose.window and Neverlose.window.GetMainFrame and Neverlose.window:GetMainFrame()
	if mainFrame and not mainFrame.Visible then return end

	local node = viewport
	while node and not node:IsA("LayerCollector") do
		if node:IsA("GuiObject") and not node.Visible then return end
		node = node.Parent
	end
	local size = viewport.AbsoluteSize
	if size.X < 10 then return end
	if os.clock() - (Preview.lastAt or 0) < 1 / 30 then return end
	Preview.lastAt = os.clock()

	local itemsCard = viewport.Parent and viewport.Parent:FindFirstChild("ESPItems")
	ui.layer.Visible = not (itemsCard and itemsCard.Visible)

	local camera = viewport.CurrentCamera
	local world = viewport:FindFirstChildOfClass("WorldModel")
	local model = world and world:FindFirstChildOfClass("Model")
	if world and camera and not model then model = Preview.standIn(world, camera, viewport) end
	if not (camera and model) then return end

	local config = Neverlose.config.esp
	local team = api:GetTeam() == "Teammates" and "Teammates" or "Enemies"
	local isEnemy = team == "Enemies"
	local colors = config.colors[team]

	local signature = table.concat({ team, tostring(model), tostring(config.enemyModel.player.mode), tostring(config.enemyModel.player.color),
		tostring(config.enemyModel.walls.mode), tostring(config.enemyModel.walls.color), config.localModel.model, tostring(config.localModel.modelColor),
		tostring(config.teamModel.player.mode), tostring(config.teamModel.player.color) }, "|")
	local repaint = Preview.signature ~= signature
	Preview.signature = signature
	if Preview.lastModel ~= model then
		Preview.lastModel, repaint = model, true
		Preview.bodyState = nil
		table.clear(originals)
	end
	if isEnemy then
		if repaint then paintModel(model, config.enemyModel.player, config.enemyModel.walls) end
	else
		local localStyle = config.localModel.model
		local style = localStyle ~= "Default" and { mode = localStyle, color = config.localModel.modelColor } or config.teamModel.player
		if repaint then paintModel(model, style, nil) end
	end

	local minV, maxV = Vector2.new(math.huge, math.huge), Vector2.new(-math.huge, -math.huge)
	local points = {}
	for _, name in ipairs(BODY_PARTS) do
		local part = model:FindFirstChild(name)
		if part then
			local point = project(camera, size, part.Position)
			if point then
				points[name] = point
				minV = Vector2.new(math.min(minV.X, point.X), math.min(minV.Y, point.Y))
				maxV = Vector2.new(math.max(maxV.X, point.X), math.max(maxV.Y, point.Y))
			end
		end
	end
	if minV.X == math.huge then return end
	local pad = (maxV.Y - minV.Y) * 0.08
	local position = Vector2.new(minV.X - pad * 1.6, minV.Y - pad * 1.5)
	local boxSize = Vector2.new(maxV.X - minV.X + pad * 3.2, maxV.Y - minV.Y + pad * 2.5)
	local center = position.X + boxSize.X / 2

	local boxColor, nameColor, skeletonColor, fillColor = colors.box, colors.name, colors.skeleton, colors.fill
	if config.visCheck then
		boxColor, nameColor, skeletonColor, fillColor = config.visibleColor, config.visibleColor, config.visibleColor, config.visibleColor
	end

	local showBox = item(team, "Main/Bounding Box")
	local corners = showBox and config.boxStyle == "Corners"
	local plain = showBox and not corners
	local filled = showBox and (config.boxStyle == "Filled" or config.boxStyle == "Pixel Filled" or config.boxStyle == "Classic Filled" or config.boxStyle == "Reference Filled")
	for _, element in ipairs({ ui.box, ui.boxOutline }) do
		element.Position, element.Size = UDim2.fromOffset(position.X, position.Y), UDim2.fromOffset(boxSize.X, boxSize.Y)
	end
	ui.boxOutline.Visible = plain and colors.outline
	ui.outlineStroke.Color = colors.outlineColor
	ui.boxStroke.Color = boxColor
	ui.boxStroke.Enabled = plain
	ui.box.BackgroundColor3 = filled and fillColor or boxColor
	ui.box.BackgroundTransparency = filled and 0.75 or 1
	ui.boxGradient.Enabled = (filled and colors.fillGradient) or (plain and colors.boxGradient) or false
	if ui.boxGradient.Enabled then
		ui.box.BackgroundColor3 = Color3.new(1, 1, 1)
		ui.boxGradient.Color = ColorSequence.new(filled and fillColor or boxColor, filled and colors.fill2 or colors.box2)
		if plain then
			ui.boxStroke.Color = boxColor:Lerp(colors.box2, 0.5)
			ui.box.BackgroundTransparency = 1
		end
	end
	ui.box.Visible = plain or filled

	local x, y, w, h = position.X, position.Y, boxSize.X, boxSize.Y
	local cw, ch = w / 4, h / 4
	local segments = {
		{ Vector2.new(x, y), Vector2.new(x + cw, y) }, { Vector2.new(x, y), Vector2.new(x, y + ch) },
		{ Vector2.new(x + w, y), Vector2.new(x + w - cw, y) }, { Vector2.new(x + w, y), Vector2.new(x + w, y + ch) },
		{ Vector2.new(x, y + h), Vector2.new(x + cw, y + h) }, { Vector2.new(x, y + h), Vector2.new(x, y + h - ch) },
		{ Vector2.new(x + w, y + h), Vector2.new(x + w - cw, y + h) }, { Vector2.new(x + w, y + h), Vector2.new(x + w, y + h - ch) },
	}
	for index, holder in ipairs(ui.corners) do
		if corners then line(holder, segments[index][1], segments[index][2], boxColor, 1) else holder.Visible = false end
	end

	local layout = config.layout
	ui.name.Visible = item(team, "Main/Name")
	ui.name.Text = isEnemy and "Enemy" or localPlayer.DisplayName
	ui.name.TextColor3 = nameColor

	ui.distance.Visible = item(team, "Main/Distance")
	ui.distance.Text = "12m"
	ui.distance.TextColor3 = colors.distance

	local previewIcon = item(team, "Weapon/Icon") and weaponIcon("AK-47", true) or ""
	local tags = {}
	if item(team, "Weapon/Text") then tags[#tags + 1] = "AK-47" end
	if item(team, "Weapon/Bomb") then tags[#tags + 1] = "C4" end
	if item(team, "Weapon/Defuser") then tags[#tags + 1] = "KIT" end
	if item(team, "Weapon/Taser") then tags[#tags + 1] = "ZEUS" end
	ui.weapon.Visible = #tags > 0
	ui.weapon.Text = table.concat(tags, " · ")
	ui.weapon.TextColor3 = colors.weapon

	local flags = {}
	for _, key in ipairs(FLAG_ORDER) do
		if item(team, "Flags/" .. key) then flags[#flags + 1] = SAMPLE_FLAGS[key] end
	end
	ui.flags.Visible = #flags > 0
	ui.flags.Text = table.concat(flags, "\n")
	ui.flags.TextColor3 = colors.flags

	local previewSelected = hitboxParts(Neverlose.config.rage.hitboxList, Neverlose.config.rage.hitboxes)
	local aimedName = #previewSelected > 0 and previewSelected[math.floor(os.clock() / 1.5) % #previewSelected + 1] or nil
	local previewWeapon = Game.weapon()
	local previewProps = previewWeapon and previewWeapon.Properties
	local previewChance = previewProps and Ballistics.hitChance(Ballistics.spread(previewWeapon), 25, 1.2) or 87
	local previewDamage = previewProps and Ballistics.damage(previewProps, aimedName or "Head", 25, 0, nil) or 0
	local previewNeed = previewDamage > 0 and math.ceil(100 / previewDamage) or 2
	ui.aim.Visible = item(team, "Aimbot/Hit Chance")
	ui.aim.Text = ("HC %d%%  KC %d%%"):format(previewChance, (previewChance / 100) ^ previewNeed * 100)
	ui.aim.TextColor3 = colors.aim

	ui.healthText.Visible = item(team, "Main/Health Text")
	ui.healthText.Text = "76"
	ui.healthText.TextColor3 = colors.healthText

	local shown = {}
	if item(team, "Main/Health Bar") then shown.health = true end
	if item(team, "Main/Armor Bar") then shown.armor = true end
	if item(team, "Main/Ammo Bar") then shown.ammo = true end
	if item(team, "Weapon/Readiness Bar") then shown.ready = true end
	local sized = { name = ui.name, aim = ui.aim, distance = ui.distance, weapon = ui.weapon, flags = ui.flags }
	for id, label in pairs(sized) do
		if label.Visible then
			local width, height = Neverlose.textExtent(label.Text, label.TextSize)
			shown[id] = { width = width, height = height }
		end
	end
	local iconW = math.clamp(colors.iconWidth or 46, 8, 300)
	local iconH = math.clamp(colors.iconHeight or 18, 4, 200)
	if previewIcon ~= "" then shown.weaponIcon = { width = iconW, height = iconH } end
	local drag = Preview.drag
	local previewLayout = layout
	if drag and drag.side then
		previewLayout = table.clone(layout)
		previewLayout[drag.id] = drag.side ~= Neverlose.LAYOUT_DEFAULT[drag.id] and drag.side or nil
	end
	local placed = Neverlose.layoutSolve(previewLayout, shown, x, y, w, h)
	Preview.placed, Preview.rect = placed, { x = x, y = y, w = w, h = h }
	Preview.centers = Preview.centers or {}
	table.clear(Preview.centers)

	local nowClock = os.clock()
	local dt = math.min(nowClock - (Preview.animAt or nowClock), 0.1)
	Preview.animAt = nowClock
	Preview.anim = Preview.anim or {}
	local anim = Preview.anim
	local follow = 1 - math.exp(-dt * 14)
	local grabFollow = 1 - math.exp(-dt * 30)

	local function rectOf(id)
		local spot = placed[id]
		if not spot then return nil end
		if spot.w then return spot.x, spot.y, spot.w, spot.h end
		return spot.left, spot.top, spot.width, spot.height
	end

	local function animate(id)
		local tx, ty, tw, th = rectOf(id)
		if not tx then
			anim[id] = nil
			return nil
		end
		local state = anim[id]
		if not state then
			state = { x = tx, y = ty, w = tw, h = th }
			anim[id] = state
		end
		state.w += (tw - state.w) * follow
		state.h += (th - state.h) * follow
		if drag and drag.id == id and drag.point then
			state.x += (drag.point.X - state.w / 2 - state.x) * grabFollow
			state.y += (drag.point.Y - state.h / 2 - state.y) * grabFollow
		else
			state.x += (tx - state.x) * follow
			state.y += (ty - state.y) * follow
		end
		return state
	end

	local hp = 0.5 + 0.46 * math.sin(nowClock * 1.15)
	local healthMid = colors.healthMid or Color3.fromRGB(255, 205, 70)
	local function healthAt(t)
		t = math.clamp(t, 0, 1)
		if colors.healthGradient == false then return colors.healthLow:Lerp(colors.health, hp) end
		if t < 0.5 then return colors.healthLow:Lerp(healthMid, t * 2) end
		return healthMid:Lerp(colors.health, (t - 0.5) * 2)
	end

	local function setBar(entry, id, ratio, color, topColor, lowColor)
		local state = animate(id)
		entry.back.Visible, entry.hit.Visible = state ~= nil, state ~= nil
		if not state then return end
		local held = drag ~= nil and drag.id == id
		Preview.centers[id] = Vector2.new(state.x + state.w / 2, state.y + state.h / 2)
		entry.back.Position, entry.back.Size = UDim2.fromOffset(state.x, state.y), UDim2.fromOffset(state.w, state.h)
		entry.back.BackgroundTransparency = held and 0.35 or 0
		entry.hit.Position, entry.hit.Size = UDim2.fromOffset(state.x - 3, state.y - 3), UDim2.fromOffset(state.w + 6, state.h + 6)
		local vertical = state.h >= state.w
		entry.fill.BackgroundColor3 = color
		if topColor then
			entry.gradient = entry.gradient or newInstance("UIGradient", {}, entry.fill)
			entry.gradient.Enabled = true
			entry.gradient.Rotation = vertical and 90 or 0
			entry.gradient.Color = vertical and ColorSequence.new(topColor, lowColor) or ColorSequence.new(lowColor, topColor)
			entry.fill.BackgroundColor3 = Color3.new(1, 1, 1)
		elseif entry.gradient then
			entry.gradient.Enabled = false
		end
		if vertical then
			entry.fill.AnchorPoint, entry.fill.Position, entry.fill.Size = Vector2.new(0, 1), UDim2.new(0, 1, 1, -1), UDim2.new(1, -2, ratio, -2)
		else
			entry.fill.AnchorPoint, entry.fill.Position, entry.fill.Size = Vector2.new(0, 0), UDim2.fromOffset(1, 1), UDim2.new(ratio, -2, 1, -2)
		end
	end
	setBar(ui.health, "health", hp, healthAt(hp), healthAt(hp), colors.healthLow)
	setBar(ui.armor, "armor", 0.55, colors.armor)
	setBar(ui.ammo, "ammo", 0.6, colors.ammo)
	setBar(ui.ready, "ready", 0.85, colors.ready)

	for id, label in pairs(sized) do
		local state = animate(id)
		if state then
			label.Size = UDim2.fromOffset(state.w, state.h)
			label.Position = id == "flags" and UDim2.fromOffset(state.x, state.y) or UDim2.fromOffset(state.x + state.w / 2, state.y)
			label.TextTransparency = (drag and drag.id == id) and 0.3 or 0
			Preview.centers[id] = Vector2.new(state.x + state.w / 2, state.y + state.h / 2)
		end
	end

	local iconLabel = ui.weaponIcon
	if iconLabel then
		local iconState = previewIcon ~= "" and animate("weaponIcon") or nil
		iconLabel.Visible = iconState ~= nil
		if iconState then
			iconLabel.Image = previewIcon
			iconLabel.ImageColor3 = colors.weaponIcon
			iconLabel.Position = UDim2.fromOffset(iconState.x, iconState.y)
			iconLabel.Size = UDim2.fromOffset(iconState.w, iconState.h)
			Preview.centers.weaponIcon = Vector2.new(iconState.x + iconState.w / 2, iconState.y + iconState.h / 2)
		end
	end

	local slot = ui.slot
	if slot then
		local sx, sy, sw, sh
		if drag and drag.side then sx, sy, sw, sh = rectOf(drag.id) end
		if sx then
			local state = Preview.slotAnim
			if not state then
				state = { x = sx, y = sy, w = sw, h = sh }
				Preview.slotAnim = state
			end
			state.x += (sx - state.x) * follow
			state.y += (sy - state.y) * follow
			state.w += (sw - state.w) * follow
			state.h += (sh - state.h) * follow
			slot.Position, slot.Size, slot.Visible = UDim2.fromOffset(state.x - 1, state.y - 1), UDim2.fromOffset(state.w + 2, state.h + 2), true
		else
			slot.Visible = false
			Preview.slotAnim = nil
		end
	end

	local healthLabel = ui.healthText
	healthLabel.Text = tostring(math.floor(hp * 100 + 0.5))
	healthLabel.TextColor3 = (colors.healthGradient ~= false) and healthAt(hp) or colors.healthText
	local bar = anim.health
	if bar and ui.health.back.Visible then
		if bar.h >= bar.w then
			local outerLeft = bar.x + bar.w / 2 < x + w / 2
			local tip = bar.y + bar.h - 1 - (bar.h - 2) * hp
			healthLabel.AnchorPoint = Vector2.new(outerLeft and 1 or 0, 0.5)
			healthLabel.TextXAlignment = outerLeft and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
			healthLabel.Position = UDim2.fromOffset(outerLeft and bar.x - 4 or bar.x + bar.w + 4, tip)
		else
			local tip = bar.x + 1 + (bar.w - 2) * hp
			healthLabel.AnchorPoint = Vector2.new(0.5, 0)
			healthLabel.TextXAlignment = Enum.TextXAlignment.Center
			healthLabel.Position = UDim2.fromOffset(tip, bar.y + bar.h + 3)
		end
	else
		healthLabel.AnchorPoint = Vector2.new(1, 0.5)
		healthLabel.TextXAlignment = Enum.TextXAlignment.Right
		healthLabel.Position = UDim2.fromOffset(x - 4, y + h * (1 - hp))
	end

	local head = points.Head
	ui.headDot.Visible = item(team, "Main/Head Dot") and head ~= nil
	if ui.headDot.Visible then
		ui.headDot.Position = UDim2.fromOffset(head.X, head.Y)
		ui.headDot.BackgroundColor3 = colors.headDot
	end

	ui.snap.Visible = item(team, "Main/Snaplines")
	if ui.snap.Visible then
		local origin = config.snapOrigin == "Top" and Vector2.new(center, 0)
			or config.snapOrigin == "Center" and Vector2.new(size.X / 2, size.Y / 2) or Vector2.new(size.X / 2, size.Y)
		line(ui.snap, origin, Vector2.new(center, y + h), colors.snapline, 1)
	end

	local skeleton = item(team, "Main/Skeleton")
	for index, bone in ipairs(BONES) do
		local a, b = points[bone[1]], points[bone[2]]
		if skeleton and a and b then line(ui.bones[index], a, b, skeletonColor, 1) else ui.bones[index].Visible = false end
	end

	local selected = item(team, "Aimbot/Hitboxes") and BODY_PARTS or {}
	Preview.blend = Preview.blend or {}
	local blendStep = math.min((os.clock() - (Preview.blendAt or os.clock())) * 7, 1)
	Preview.blendAt = os.clock()
	local folder = Preview.hitFolder
	if not (folder and folder.Parent == world) then
		if folder then pcall(function() folder:Destroy() end) end
		folder = Instance.new("Folder")
		folder.Name = randomName()
		folder.Parent = world
		Preview.hitFolder, Preview.hitParts = folder, {}
	end
	for index, name in ipairs(BODY_PARTS) do
		local part, glow = model:FindFirstChild(name), Preview.hitParts[name]
		ui.dots[index].Visible, ui.cores[index].Visible = false, false
		if part and #selected > 0 then
			if not (glow and glow.Parent) then
				glow = Instance.new("Part")
				glow.Name, glow.Anchored, glow.CanCollide, glow.CanQuery, glow.CanTouch, glow.CastShadow = randomName(), true, false, false, false, false
				glow.Material = Enum.Material.Neon
				glow.Parent = folder
				Preview.hitParts[name] = glow
			end
			local blend = Preview.blend[name] or 0
			blend += ((aimedName == name and 1 or 0) - blend) * blendStep
			Preview.blend[name] = blend
			local pulse = 0.5 + 0.5 * math.sin(os.clock() * 4)
			glow.CFrame, glow.Size = part.CFrame, part.Size + Vector3.new(0.07, 0.07, 0.07)
			glow.Color = colors.hitboxes:Lerp(colors.hitboxes2 or Color3.fromRGB(255, 110, 150), blend)
			glow.Transparency = (table.find(previewSelected, name) and 0.28 or 0.62) - blend * 0.18 - pulse * 0.05 * blend
		elseif glow then
			glow.Transparency = 1
		end
	end
end

maid:give(runService.RenderStepped:Connect(function()
	pcall(Preview.update)
end))
