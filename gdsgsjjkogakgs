			if os.clock() - last < 0.5 then return end
			last = os.clock()
			if not loadout.frame.Parent or not loadout.frame.Visible then return end
			pcall(paintPlus)
			local ok, err = pcall(paintSlots)
			if not ok then Neverlose.slotError = tostring(err) end
		end))
	end)

	task.defer(function()
		local slots = loadout.frame:FindFirstChild("Slots", true)
		for _, card in ipairs(slots and slots:GetChildren() or {}) do
			local category, index = card.Name:match("^(.-)_(%d)$")
			if category and card:IsA("GuiObject") then
				card.MouseEnter:Connect(function()
					local team = loadout:GetTeam() or "CT"
					local name = WEAPONS[team][category] and WEAPONS[team][category][tonumber(index)]
					if name then held[team] = name end
				end)
			end
		end
	end)
	Agents.attach(loadout.frame, "AgentView", function() return loadout:GetTeam() or "CT" end, 0.8, function()
		return held[loadout:GetTeam() or "CT"]
	end, true, { 1.0, 0.97 })
end

-- Inventory tab on the new library (Tab:AddInventory). Our data -> Items / Loadout, library callbacks -> the same Skins / Agents
-- calls the old AddLoadout UI made. Neverlose.config.skins stays the single source of truth (saved by Skins.save as before);
-- the library only keeps a view of it (state is rebuilt from the config; the library's own config extra is replaced).
-- Item ids: "w:<weapon>" "k:<knife>" "g:<gloves>" "a:<agent>" "b:<badge>" "m:<music>"; "__add_agent" / "__add_music" open the input plate.
function Menu.inventoryNew(window, tab, env)
	local WEAPONS, TEAM_NAME, MID_TYPES, held, persist = env.WEAPONS, env.TEAM_NAME, env.MID_TYPES, env.held, env.persist
	local sideEntry, gradeOf, listFor, glovesFor, stockImage = env.sideEntry, env.gradeOf, env.listFor, env.glovesFor, env.stockImage
	local knifeNames, gloveNames, typeIcons, agentList, badgeList = env.knifeNames, env.gloveNames, env.typeIcons, env.agentList, env.badgeList
	local defaultKnife, defaultGlove = env.defaultKnife, env.defaultGlove
	local skinsConfig = Neverlose.config.skins
	local SIDES = { "CT", "T" }
	local CAT_OF_GROUP = { Pistols = "pistol", ["Mid-Tier"] = "smg", Rifles = "rifle" }
	local CONFIG_KEY = "inventory_NL"

	local Inventory
	local meta = {}

	local function skinTable(list)
		local out = {}
		for _, skin in ipairs(list or {}) do
			out[#out + 1] = { name = skin[1], rarity = skin[2], image = (type(skin[3]) == "string" and skin[3] ~= "") and skin[3] or nil }
		end
		return out
	end

	-- every weapon of the game (not only the 5 per group the loadout shows) + the weapons of the real loadout
	local function weaponUniverse()
		local found = {}
		local function mark(name, category, side)
			local row = found[name]
			if not row then row = { category = category, CT = false, T = false } found[name] = row end
			if side then row[side] = true end
		end
		local database = replicatedStorage:FindFirstChild("Database")
		local folder = database and database:FindFirstChild("Custom") and database.Custom:FindFirstChild("Weapons")
		for _, module in ipairs(folder and folder:GetChildren() or {}) do
			if module:IsA("ModuleScript") then
				local ok, data = asGame(require, module)
				if ok and type(data) == "table" and data.Class == "Weapon" and (data.Slot == "Primary" or data.Slot == "Secondary") then
					local category
					if data.Slot == "Secondary" then category = "pistol"
					elseif data.Type == "Rifle" or tostring(data.Type):lower():find("sniper") then category = "rifle"
					elseif MID_TYPES[data.Type] then category = data.Type == "SMG" and "smg" or "heavy" end
					if category then
						for side, teamName in pairs(TEAM_NAME) do
							if data.Team == "Both" or data.Team == teamName then mark(module.Name, category, side) end
						end
					end
				end
			end
		end
		for _, side in ipairs(SIDES) do
			for group, list in pairs(WEAPONS[side]) do
				for _, name in ipairs(list) do mark(name, CAT_OF_GROUP[group] or "rifle", side) end
			end
		end
		return found
	end

	local function sideOf(row)
		if row.CT and row.T then return nil end
		return row.CT and "CT" or (row.T and "T" or nil)
	end

	local function buildItems()
		local items = {}
		table.clear(meta)
		local found = weaponUniverse()
		local names = {}
		for name in pairs(found) do names[#names + 1] = name end
		table.sort(names)
		for _, name in ipairs(names) do
			local row, resolved = found[name], Skins.resolve(name)
			local id = "w:" .. name
			meta[id] = { kind = "weapon", name = name, weapon = resolved, settings = resolved }
			items[#items + 1] = { id = id, name = name, category = row.category, side = sideOf(row), image = stockImage(resolved), skins = skinTable(listFor(resolved)) }
		end
		for _, name in ipairs(knifeNames) do
			local id = "k:" .. name
			meta[id] = { kind = "knife", name = name, settings = name }
			items[#items + 1] = { id = id, name = name, category = "knife", rarity = "Covert", image = typeIcons.Knife[name], skins = skinTable(listFor(name)) }
		end
		for _, name in ipairs(gloveNames) do
			local id = "g:" .. name
			meta[id] = { kind = "gloves", name = name, settings = name }
			items[#items + 1] = { id = id, name = name, category = "gloves", rarity = "Covert", image = typeIcons.Gloves[name], skins = skinTable(glovesFor(name)) }
		end
		do
			local id = "w:Zeus x27"
			meta[id] = { kind = "weapon", name = "Zeus x27", weapon = "Zeus x27", settings = "Zeus x27" }
			items[#items + 1] = { id = id, name = "Zeus x27", category = "equipment", image = stockImage("Zeus x27"), skins = skinTable(listFor("Zeus x27")) }
		end
		-- agents: per side lists merged (an agent on both sides has no side); custom agents are on both
		local agentRows, agentOrder = {}, {}
		for _, side in ipairs(SIDES) do
			for _, row in ipairs(agentList(side)) do
				if row[1] ~= "+ Add agent" then
					local item = agentRows[row[1]]
					if not item then
						item = { id = "a:" .. row[1], name = row[1], category = "agent", rarity = row[2] or "Covert", sides = {} }
						agentRows[row[1]] = item
						agentOrder[#agentOrder + 1] = item
					end
					item.sides[side] = true
				end
			end
		end
		for _, item in ipairs(agentOrder) do
			item.side = (item.sides.CT and item.sides.T) and nil or (item.sides.CT and "CT" or "T")
			item.sides = nil
			meta[item.id] = { kind = "agent", name = item.name }
			items[#items + 1] = item
		end
		meta.__add_agent = { kind = "add_agent" }
		items[#items + 1] = { id = "__add_agent", name = "+ Add agent", category = "agent", rarity = "Covert" }
		for _, row in ipairs(badgeList()) do
			local id = "b:" .. row[1]
			meta[id] = { kind = "badge", name = row[1] }
			items[#items + 1] = { id = id, name = row[1], category = "medal", rarity = row[2], image = type(row[3]) == "string" and row[3] or nil }
		end
		for _, entry in ipairs(Skins.musicEntries()) do
			local id = "m:" .. entry.name
			meta[id] = { kind = "music", name = entry.name }
			items[#items + 1] = { id = id, name = entry.name, category = "music", rarity = (entry.stop and entry.stop > 0) and "Covert" or "Contraband" }
		end
		meta.__add_music = { kind = "add_music" }
		items[#items + 1] = { id = "__add_music", name = "+ Add music", category = "music", rarity = "Covert" }
		return items
	end

	local function loadoutFor(side)
		local entry, out = sideEntry(side), {}
		local slotCount = 5
		for group, list in pairs(WEAPONS[side]) do
			local row = {}
			slotCount = math.max(slotCount, #list)
			for index, name in ipairs(list) do row[index] = "w:" .. name end
			out[group] = row
		end
		for _, row in pairs(out) do for index = 1, slotCount do if row[index] == nil then row[index] = false end end end
		local knife, glove = entry.knife or defaultKnife(side), entry.glove or defaultGlove(side)
		out.knife = knife and ("k:" .. knife) or false
		out.gloves = glove and ("g:" .. glove) or false
		out.agent = entry.agent and ("a:" .. entry.agent) or false
		out.medal = entry.badge and ("b:" .. entry.badge) or false
		out.music = entry.music and ("m:" .. entry.music) or false
		out.equipment = "w:Zeus x27"
		return out, slotCount
	end

	-- library state (skin + options per side/item) rebuilt from Neverlose.config.skins
	local function itemsFromConfig()
		local items = { CT = {}, T = {} }
		for _, side in ipairs(SIDES) do
			local entry, bucket = sideEntry(side), items[side]
			for id, m in pairs(meta) do
				if m.settings then
					local e = {}
					if m.kind == "weapon" then e.skin = entry.weapons[m.weapon]
					elseif m.kind == "knife" and entry.knife == m.name then e.skin = entry.knifeSkin
					elseif m.kind == "gloves" and entry.glove == m.name then e.skin = entry.gloveSkin end
					local saved = skinsConfig.settings[m.settings]
					if type(saved) == "table" then
						if type(saved.float) == "number" then e.float = math.clamp(saved.float / 100, 0, 1) end
						if saved.statTrak ~= nil then e.stattrak = saved.statTrak == true end
						if type(saved.count) == "number" and saved.statTrak then e.stcount = saved.count end
						if type(saved.name) == "string" and saved.name ~= "" then e.name = saved.name end
					end
					if next(e) ~= nil then bucket[id] = e end
				end
			end
		end
		return items
	end

	local function applyOptions(side, id, e)
		local m = meta[id]
		if not m or not m.settings or type(e) ~= "table" then return end
		local key = m.settings
		Skins.setSetting(key, "float", type(e.float) == "number" and e.float * 100 or nil)
		if e.stattrak == nil then Skins.setSetting(key, "statTrak", nil) else Skins.setSetting(key, "statTrak", e.stattrak == true) end
		Skins.setSetting(key, "count", type(e.stcount) == "number" and e.stcount or nil)
		Skins.setSetting(key, "name", (type(e.name) == "string" and e.name ~= "") and e.name or nil)
		persist(side)
	end

	local function libSkin(side, id)
		local e = Inventory and Inventory:GetEntry(side, id)
		return e and e.skin or nil, e ~= nil
	end

	local equipped = { CT = {}, T = {} }
	local reverting = false
	local function plate(kind, side, slot)
		local previous = equipped[side][slot]
		task.defer(function()
			reverting = true
			pcall(function() Inventory:Equip(side, slot, previous) end)
			reverting = false
			pcall(function() Inventory:Close() end)
			if kind == "agent" then
				if not Neverlose.agentPlate and window._inputPlate then
					Neverlose.agentPlate = window._inputPlate({
						title = "Add Agent", button = "Add",
						fields = { { key = "name", label = "User", placeholder = "Roblox username or user id" } },
						onSubmit = function(v)
							if v.name == "" then return false, "name" end
							local added = Agents.addCustom(v.name)
							pcall(window.Log, window, added and "Added agent {" .. v.name .. "}" or "Could not find agent {" .. v.name .. "}", { type = added and "info" or "warning" })
							if not added then return false, "name" end
							pcall(function() Inventory:Refresh() end)
						end,
					})
				end
				if Neverlose.agentPlate then Neverlose.agentPlate.Toggle() end
			else
				if not Neverlose.musicPlate and window._inputPlate then
					Neverlose.musicPlate = window._inputPlate({
						title = "Add Music", button = "Add",
						fields = {
							{ key = "id", label = "Sound ID", placeholder = "Roblox audio id", numeric = true },
							{ key = "name", label = "Name", placeholder = "Track name" },
							{ key = "start", label = "Start", placeholder = "seconds, 0 = from the start" },
							{ key = "stop", label = "End", placeholder = "seconds, 0 = to the end" },
							{ key = "volume", label = "Volume", placeholder = "% (default 70)", numeric = true },
						},
						onSubmit = function(v)
							if v.id == "" then return false, "id" end
							local added = Skins.musicAdd(v.id, { name = v.name, start = tonumber(v.start), stop = tonumber(v.stop), volume = tonumber(v.volume) })
							if not added then return false, "name" end
							pcall(function() Inventory:Refresh() end)
						end,
					})
				end
				if Neverlose.musicPlate then Neverlose.musicPlate.Toggle() end
			end
		end)
	end

	local function onEquip(side, slot, id)
		if reverting then return end
		local entry = sideEntry(side)
		local m = id and meta[id] or nil
		if id and not m then return end
		if m and (m.kind == "add_agent" or m.kind == "add_music") then
			plate(m.kind == "add_agent" and "agent" or "music", side, slot)
			return
		end
		equipped[side][slot] = id
		local gear = slot:sub(1, 2) == "g_" and slot:sub(3) or nil
		if gear == "agent" then
			entry.agent = m and m.name or nil
			skinsConfig["agent" .. side] = entry.agent
			Skins.applyAgent()
		elseif gear == "medal" then
			entry.badge = m and m.name or nil
		elseif gear == "music" then
			entry.music = m and m.name or nil
			if not entry.music then Skins.musicStop() end
		elseif gear == "knife" then
			entry.knife = m and m.name or nil
			entry.knifeSkin = m and libSkin(side, id) or nil
		elseif gear == "gloves" then
			entry.glove = m and m.name or nil
			entry.gloveSkin = m and libSkin(side, id) or nil
		elseif m and m.kind == "weapon" then
			-- weapon slot / Zeus: remember the held weapon; a skin carried over by "both sides" is applied
			if gear == nil then held[side] = m.name end
			local skin, known = libSkin(side, id)
			if known then entry.weapons[m.weapon] = skin end
		end
		persist(side)
	end

	local function onSkin(side, id, skin)
		local m = id and meta[id]
		if not m then return end
		local entry = sideEntry(side)
		if m.kind == "weapon" then
			entry.weapons[m.weapon] = skin
			if m.weapon ~= "Zeus x27" then held[side] = m.name end
		elseif m.kind == "knife" then
			entry.knife = m.name
			entry.knifeSkin = skin
		elseif m.kind == "gloves" then
			entry.glove = m.name
			entry.gloveSkin = skin
		else
			return
		end
		persist(side)
	end

	local startSide = Skins.activeSide()
	if startSide ~= "T" then startSide = "CT" end
	local slotCount = 5
	local loadout = {}
	for _, side in ipairs(SIDES) do
		local row, count = loadoutFor(side)
		loadout[side] = row
		slotCount = math.max(slotCount, count)
	end
	local noStickers = { "pistol", "smg", "heavy", "rifle", "equipment", "agent" }
	local categories = {}
	for _, id in ipairs({ "pistol", "smg", "heavy", "rifle", "knife", "gloves", "agent", "medal", "music", "equipment" }) do
		categories[#categories + 1] = { id = id, noStickers = table.find(noStickers, id) ~= nil or nil }
	end
	local openCtx
	local ok, api = pcall(tab.AddInventory, tab, {
		Sides = SIDES, Side = startSide, ConfigKey = "NL", Slots = slotCount,
		-- the previous menu's team thumbnails (the lib's own pack shield / balaclava art is not used)
		Emblems = { CT = "rbxthumb://type=Asset&id=259949118&w=150&h=150", T = "rbxthumb://type=Asset&id=9159346967&w=150&h=150" },
		Items = function()
			local okItems, items = pcall(buildItems)
			if not okItems then Neverlose.inventoryError = tostring(items) return {} end
			return items
		end,
		Categories = categories,
		Loadout = loadout,
		Callbacks = {
			OnEquip = function(side, slot, id) onEquip(side, slot, id) end,
			OnSkinChanged = onSkin,
			OnOptionsChanged = applyOptions,
			OnApply = applyOptions,
			OnOpen = function(side, key, id)
				openCtx = { side = side, key = key, id = id }
				local m = id and meta[id]
				if m and m.kind == "weapon" and m.weapon ~= "Zeus x27" then held[side] = m.name end
			end,
			OnSideChanged = function(side) Neverlose.loadoutSide = side end,
		},
	})
	if not ok or type(api) ~= "table" then
		Neverlose.inventoryError = tostring(api)
		return false
	end
	Inventory = api
	Neverlose.inventory = api
	function api:GetTeam() return self:GetSide() end
	for _, side in ipairs(SIDES) do
		for slot, id in pairs(api:GetState().slots[side] or {}) do equipped[side][slot] = id end
	end

	-- the library's saved view is replaced by one rebuilt from Neverlose.config.skins (loading a preset / the 1.5 s restore re-syncs it)
	local extras = window._configExtras
	local original = extras and extras[CONFIG_KEY]
	if original and type(original.set) == "function" then
		local function resync()
			original.set({ side = api:GetSide(), items = itemsFromConfig() })
			for _, side in ipairs(SIDES) do
				table.clear(equipped[side])
				for slot, id in pairs(api:GetState().slots[side] or {}) do equipped[side][slot] = id end
			end
		end
		extras[CONFIG_KEY] = { get = function() return nil end, set = function() pcall(resync) end }
		pcall(resync)
	end

	-- 3D agent (holding the selected weapon) inside the agent box of the main board, like the old loadout view
	pcall(function()
		local box = api.frame:FindFirstChild("AgentView", true)
		if not box then return end
		local view = Instance.new("ViewportFrame")
		view.Name, view.BackgroundTransparency, view.Size, view.ZIndex = "NLAgentView", 1, UDim2.new(1, 0, 1, -10), box.ZIndex + 1
		view.Ambient, view.LightColor, view.LightDirection = Color3.fromRGB(150, 150, 165), Color3.fromRGB(255, 246, 232), Vector3.new(-1, -0.7, -0.35)
		local world = Instance.new("WorldModel")
		world.Parent = view
		local camera = Instance.new("Camera")
		camera.FieldOfView = 30
		camera.Parent = view
		view.CurrentCamera = camera
		view.Parent = box
		Agents.attach(api.frame, "NLAgentView", function() return api:GetSide() end, 0.8, function() return held[api:GetSide()] end, true, { 1.0, 0.97 })
	end)

	-- no coloured line under the agent figure
	pcall(function()
		local function kill(line)
			if not (line:IsA("GuiObject") and line.Name == "AgentLine") then return end
			line.Visible = false
			line:GetPropertyChangedSignal("Visible"):Connect(function() if line.Visible then line.Visible = false end end)
		end
		local root = api.frame:FindFirstAncestorOfClass("ScreenGui") or api.frame
		for _, object in ipairs(root:GetDescendants()) do kill(object) end
		root.DescendantAdded:Connect(function(object) task.defer(kill, object) end)
	end)

	-- the agent slot shows a head-and-shoulders preview of the equipped agent instead of its name
	pcall(function()
		local cell = api.frame:FindFirstChild("Gear_agent", true)
		local box = cell and cell:FindFirstChild("ItemCard")
		local lift = box and box:FindFirstChild("Lift")
		if not lift then return end
		local view = Instance.new("ViewportFrame")
		view.Name, view.BackgroundTransparency, view.Size, view.ZIndex = "NLAgentIcon", 1, UDim2.new(1, 0, 1, -4), (lift.ZIndex or 1) + 3
		view.Ambient, view.LightColor, view.LightDirection = Color3.fromRGB(160, 160, 172), Color3.fromRGB(255, 246, 232), Vector3.new(-1, -0.7, -0.35)
		local world = Instance.new("WorldModel")
		world.Parent = view
		local camera = Instance.new("Camera")
		camera.FieldOfView = 28
		camera.Parent = view
		view.CurrentCamera = camera
		view.Parent = lift
		local shownTag
		local function hideText()
			for _, name in ipairs({ "ItemSub", "ItemCaption", "ItemImage", "Placeholder" }) do
				local object = lift:FindFirstChild(name)
				if object and object:IsA("GuiObject") and object.Visible then object.Visible = false end
			end
		end
		local function update()
			local side = api:GetSide()
			local source, tag = Agents.find(side)
			if not source then
				world:ClearAllChildren()
				shownTag = nil
				view.Visible = false
				return
			end
			hideText()
			tag = side .. ":" .. tostring(tag)
			view.Visible = true
			if shownTag == tag and world:FindFirstChildOfClass("Model") then return end
			shownTag = tag
			world:ClearAllChildren()
			local clone = Agents.clone(source)
			if not clone then return end
			for _, object in ipairs(clone:GetDescendants()) do
				if object:IsA("BasePart") then object.Anchored = true
				elseif object:IsA("LuaSourceContainer") or object:IsA("Sound") then object:Destroy() end
			end
			clone.Parent = world
			pcall(function() clone:PivotTo(CFrame.Angles(0, math.pi, 0)) end)
			camera.FieldOfView = 24
			local head = clone:FindFirstChild("Head", true)
			if head then
				camera.CFrame = CFrame.lookAt(head.Position + Vector3.new(0, 0.2, 6.2), head.Position - Vector3.new(0, 0.6, 0))
			else
				local cframe, size = clone:GetBoundingBox()
				camera.FieldOfView = 30
				camera.CFrame = CFrame.lookAt(cframe.Position + Vector3.new(0, 0, math.max(size.X, size.Y, size.Z) * 1.1 / math.tan(math.rad(15)) + size.Z / 2), cframe.Position)
			end
		end
		for _, name in ipairs({ "ItemSub", "ItemCaption", "ItemImage", "Placeholder" }) do
			local object = lift:FindFirstChild(name)
			if object then
				object:GetPropertyChangedSignal("Visible"):Connect(function()
					if view.Visible and object.Visible then object.Visible = false end
				end)
			end
		end
		local sub = lift:FindFirstChild("ItemSub")
		if sub then sub:GetPropertyChangedSignal("Text"):Connect(function() task.defer(update) end) end
		task.delay(0.5, update)
		task.delay(2.5, update)
	end)

	-- 3D previews: agents and weapons on the inventory cards and in the big picker preview
	pcall(function()
		local root = api.frame:FindFirstAncestorOfClass("ScreenGui") or api.frame
		local templates = {}
		local function itemByName(name)
			for id, m in pairs(meta) do
				if m.name == name and (m.kind == "weapon" or m.kind == "knife" or m.kind == "agent") then return m end
			end
		end
		local function template(kind, name, skin)
			local tag = kind .. "|" .. tostring(name) .. "|" .. tostring(skin)
			local cached = templates[tag]
			if cached ~= nil then return cached or nil end
			local model
			pcall(function()
				if kind == "agent" then
					local source = (Skins.agentModels and Skins.agentModels[name]) or Agents.custom[name]
					model = source and Agents.clone(source)
				else
					model = Agents.weaponModel(name, skin or "Stock", 0.03)
				end
			end)
			if model then
				for _, object in ipairs(model:GetDescendants()) do
					local label = object.Name:lower()
					if object:IsA("BasePart") and kind == "agent" and (label:find("outline") or label:find("hull") or label:find("shell") or label:find("border")) then
						object:Destroy()
					elseif object:IsA("BasePart") then object.Anchored = true
					elseif object:IsA("LuaSourceContainer") or object:IsA("Highlight") or object:IsA("SelectionBox") or object:IsA("ForceField")
						or object:IsA("BillboardGui") or object:IsA("SurfaceGui") or object:IsA("UIStroke") or object:IsA("ParticleEmitter") or object:IsA("Sound") then
						object:Destroy()
					end
				end
			end
			templates[tag] = model or false
			return model
		end
		-- (re)builds the viewport named viewName inside holder; big = whole figure instead of a head portrait
		local function show(holder, viewName, kind, name, skin, big, z)
			local tag = kind .. "|" .. tostring(name) .. "|" .. tostring(skin) .. "|" .. tostring(big)
			local view = holder:FindFirstChild(viewName)
			if view and view:GetAttribute("Tag") == tag then view.Visible = true return true end
			if view then view:Destroy() end
			local source = template(kind, name, skin)
			if not source then return false end
			local copy = source:Clone()
			view = Instance.new("ViewportFrame")
			view.Name, view.BackgroundTransparency, view.ZIndex = viewName, 1, z or ((holder.ZIndex or 1) + 3)
			view.Size = big and UDim2.fromScale(1, 1) or UDim2.new(1, -10, 1, -(kind == "agent" and 18 or 22))
			view.Position = big and UDim2.new() or UDim2.fromOffset(5, 3)
			view:SetAttribute("Tag", tag)
			view.Ambient, view.LightColor, view.LightDirection = Color3.fromRGB(150, 150, 165), Color3.fromRGB(255, 246, 232), Vector3.new(-1, -0.7, -0.35)
			local world = Instance.new("WorldModel")
			world.Parent = view
			copy.Parent = world
			local camera = Instance.new("Camera")
			camera.Parent = view
			view.CurrentCamera = camera
			if kind == "agent" then
				pcall(function() copy:PivotTo(CFrame.Angles(0, math.pi, 0)) end)
				local head = copy:FindFirstChild("Head", true)
				if head and not big then
					camera.FieldOfView = 24
					camera.CFrame = CFrame.lookAt(head.Position + Vector3.new(0, 0.2, 6.2), head.Position - Vector3.new(0, 0.6, 0))
				else
					local cframe, size = copy:GetBoundingBox()
					camera.FieldOfView = 30
					camera.CFrame = CFrame.lookAt(cframe.Position + Vector3.new(0, 0, math.max(size.X, size.Y, size.Z) * 0.62 / math.tan(math.rad(15)) + size.Z / 2), cframe.Position)
				end
			else
				-- side view: the longest axis runs across the screen, the thinnest one points at the camera
				local cframe, size = copy:GetBoundingBox()
				local axes = { { cframe.RightVector, size.X }, { cframe.UpVector, size.Y }, { cframe.LookVector, size.Z } }
				table.sort(axes, function(l, r) return l[2] > r[2] end)
				local up = axes[2][1]
				if up.Y < 0 then up = -up end
				local toward = axes[3][1]
				camera.FieldOfView = 30
				-- fit the long side into ~80% of the viewport width (and the height into ~80% of its height)
				local aspect = (holder.AbsoluteSize.X > 0 and holder.AbsoluteSize.Y > 0) and holder.AbsoluteSize.X / holder.AbsoluteSize.Y or 2
				local tan = math.tan(math.rad(15))
				local reach = math.max(axes[1][2] / (1.6 * aspect * tan), axes[2][2] / (1.6 * tan)) + axes[3][2] / 2
				-- the muzzle must point to the right: pick the camera side from MuzzlePart (fallback: the model's forward)
				local muzzle = copy:FindFirstChild("MuzzlePart", true)
				local forward = muzzle and muzzle:IsA("BasePart") and (muzzle.Position - cframe.Position) or cframe.LookVector
				local along = axes[1][1]
				local sign = forward:Dot(along) >= 0 and 1 or -1
				local function rightOf(side)
					return (-side):Cross(up)
				end
				if (along * sign):Dot(rightOf(toward)) < 0 then toward = -toward end
				camera.CFrame = CFrame.lookAt(cframe.Position + toward * reach, cframe.Position, up)
				view.Ambient, view.LightColor = Color3.fromRGB(235, 235, 240), Color3.fromRGB(255, 255, 255)
				view.LightDirection = camera.CFrame.LookVector + Vector3.new(0, -0.3, 0)
			end
			view.Parent = holder
			if big then
				-- drag to rotate: the camera orbits the model around its vertical (agent) / view-up (weapon) axis
				local pivot, offset, upAxis = nil, nil, nil
				pcall(function()
					local cframe = copy:GetBoundingBox()
					pivot = cframe.Position
					offset = camera.CFrame.Position - pivot
					upAxis = kind == "agent" and Vector3.yAxis or camera.CFrame.UpVector
				end)
				if pivot then
					local yaw, dragging, lastX = 0, false, 0
					view.Active = true
					local function apply()
						local rotated = CFrame.fromAxisAngle(upAxis, yaw) * offset
						camera.CFrame = CFrame.lookAt(pivot + rotated, pivot, upAxis)
						if kind ~= "agent" then view.LightDirection = camera.CFrame.LookVector + Vector3.new(0, -0.3, 0) end
					end
					view.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							dragging, lastX = true, input.Position.X
						end
					end)
					view.InputChanged:Connect(function(input)
						if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
							yaw += (input.Position.X - lastX) * 0.012
							lastX = input.Position.X
							apply()
						end
					end)
					view.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
					end)
					local userInputService = game:GetService("UserInputService")
					view.Destroying:Connect(function() dragging = false end)
					local ended = userInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
					end)
					view.Destroying:Connect(function() ended:Disconnect() end)
				end
			end
			return true
		end
		local function clear(holder, viewName)
			local view = holder:FindFirstChild(viewName)
			if view then view:Destroy() end
		end

		-- cards: the loadout slots and every picker grid
		local function identify(box)
			local cell = box.Parent
			local lift = box:FindFirstChild("Lift")
			local label = cell and cell:FindFirstChild("ItemName")
			local caption = lift and lift:FindFirstChild("ItemCaption")
			local sub = lift and lift:FindFirstChild("ItemSub")
			local name = label and label.Text ~= "" and label.Text or (caption and caption.Text ~= "" and caption.Text) or ""
			name = name:match("^(.-) | ") or name
			if name == "" or name == "+ Add agent" then return nil end
			local m = itemByName(name)
			if m then
				local skin = sub and sub.Visible and sub.Text ~= "" and sub.Text or nil
				return m.kind == "agent" and "agent" or "weapon", m.kind == "agent" and m.name or (m.weapon or m.name), skin
			end
			-- skin grid of the open item
			local current = openCtx and openCtx.id and meta[openCtx.id]
			if current and (current.kind == "weapon" or current.kind == "knife") then
				return "weapon", current.weapon or current.name, name
			end
		end
		local function decorate(box)
			local lift = box:FindFirstChild("Lift")
			if not lift or box.Parent.Name == "Gear_agent" then return end
			local image = lift:FindFirstChild("ItemImage")
			local kind, name, skin = identify(box)
			if kind == "weapon" then kind = nil end -- weapon cards keep their screenshots; the 3D model is in the opened preview
			if kind and show(box, "NL3D", kind, name, skin, false, lift.ZIndex + 3) then
				if image then image.Visible = false end
				local sub = lift:FindFirstChild("ItemSub")
				local caption = lift:FindFirstChild("ItemCaption")
				if kind == "agent" then
					if caption then caption.Visible = false end
				end
				local label = box.Parent:FindFirstChild("ItemName")
				if label then label.ZIndex = math.max(label.ZIndex, lift.ZIndex + 5) end
				if sub then sub.ZIndex = math.max(sub.ZIndex, lift.ZIndex + 5) end
				if caption then caption.ZIndex = math.max(caption.ZIndex, lift.ZIndex + 5) end
			else
				clear(box, "NL3D")
			end
		end
		local hooked = setmetatable({}, { __mode = "k" })
		local pending = setmetatable({}, { __mode = "k" })
		local function schedule(box)
			if pending[box] then return end
			pending[box] = true
			task.delay(0.06, function()
				pending[box] = nil
				if box.Parent then pcall(decorate, box) end
			end)
		end
		local function hook(box)
			if hooked[box] or box.Name ~= "ItemCard" or not box:IsA("GuiButton") then return end
			hooked[box] = true
			task.defer(function()
				local lift = box:FindFirstChild("Lift")
				local cell = box.Parent
				for _, object in ipairs({ cell and cell:FindFirstChild("ItemName"), lift and lift:FindFirstChild("ItemCaption"), lift and lift:FindFirstChild("ItemSub") }) do
					if object then
						object:GetPropertyChangedSignal("Text"):Connect(function() schedule(box) end)
					end
				end
				local image = lift and lift:FindFirstChild("ItemImage")
				if image then
					image:GetPropertyChangedSignal("Visible"):Connect(function()
						if image.Visible and box:FindFirstChild("NL3D") and box.NL3D.Visible then image.Visible = false end
					end)
				end
				schedule(box)
			end)
		end
		for _, object in ipairs(root:GetDescendants()) do hook(object) end
		root.DescendantAdded:Connect(hook)

		-- the knife slot always shows its rarity (the equipped skin's grade, Covert for the plain knife)
		local RARITY = {
			Stock = Color3.fromRGB(222, 214, 200), Consumer = Color3.fromRGB(176, 195, 217), Industrial = Color3.fromRGB(94, 152, 217),
			["Mil-Spec"] = Color3.fromRGB(75, 105, 255), Restricted = Color3.fromRGB(136, 71, 255), Classified = Color3.fromRGB(211, 44, 230),
			Covert = Color3.fromRGB(235, 75, 75), Contraband = Color3.fromRGB(228, 174, 57),
		}
		local knifeHooked = setmetatable({}, { __mode = "k" })
		local function knifeRarity()
			local side = api:GetSide()
			local entry = sideEntry(side)
			local knife = entry.knife or defaultKnife(side)
			local grade = "Covert"
			if knife and entry.knifeSkin then
				for _, listed in ipairs(Skins.forWeapon(knife) or {}) do
					if listed.skin == entry.knifeSkin then grade = gradeOf(listed.rarity) break end
				end
			end
			return RARITY[grade] or RARITY.Covert
		end
		local function hookKnife(cell)
			if knifeHooked[cell] or cell.Name ~= "Gear_knife" then return end
			knifeHooked[cell] = true
			task.defer(function()
				local box = cell:FindFirstChild("ItemCard")
				local lift = box and box:FindFirstChild("Lift")
				local bar = box and box:FindFirstChild("RarityBar")
				local tint = lift and lift:FindFirstChild("RarityTint")
				if not bar then return end
				local function paint()
					local color = knifeRarity()
					bar.Visible = true
					if bar.BackgroundColor3 ~= color then bar.BackgroundColor3 = color end
					if tint then
						tint.Visible = true
						if tint.BackgroundColor3 ~= color then tint.BackgroundColor3 = color end
					end
				end
				bar:GetPropertyChangedSignal("BackgroundColor3"):Connect(function() task.defer(paint) end)
				bar:GetPropertyChangedSignal("Visible"):Connect(function() task.defer(paint) end)
				paint()
			end)
		end
		for _, object in ipairs(root:GetDescendants()) do hookKnife(object) end
		root.DescendantAdded:Connect(hookKnife)

		-- the big preview of the open picker
		local function pickerPreview(holder)
			local title = holder.Parent and holder.Parent:FindFirstChild("PickerTitle", true)
			local text = title and title.Text or ""
			local name, skin = text:match("^(.-) | (.+)$")
			name = name or text
			local m = itemByName(name)
			local current = openCtx and openCtx.id and meta[openCtx.id]
			local kind, shown
			if m then kind, shown = (m.kind == "agent" and "agent" or "weapon"), (m.weapon or m.name)
			elseif current and (current.kind == "weapon" or current.kind == "knife") then kind, shown = "weapon", current.weapon or current.name
			end
			local image = holder:FindFirstChild("PreviewImage")
			if kind and show(holder, "NLPickerView", kind, shown, skin, true, 3) then
				if image then image.Visible = false end
				local pv = holder:FindFirstChild("PreviewName")
				if pv then pv.Visible = false end
			else
				clear(holder, "NLPickerView")
			end
		end
		local previewHooked = setmetatable({}, { __mode = "k" })
		local function hookPreview(holder)
			if previewHooked[holder] or holder.Name ~= "PickerPreview" then return end
			previewHooked[holder] = true
			task.defer(function()
				local picker = holder.Parent
				local title = picker and picker:FindFirstChild("PickerTitle", true)
				local function refresh() task.delay(0.05, function() if holder.Parent then pcall(pickerPreview, holder) end end) end
				if title then title:GetPropertyChangedSignal("Text"):Connect(refresh) end
				local image = holder:FindFirstChild("PreviewImage")
				if image then
					image:GetPropertyChangedSignal("Visible"):Connect(function()
						local view = holder:FindFirstChild("NLPickerView")
						if image.Visible and view and view.Visible then image.Visible = false end
					end)
				end
				local name = holder:FindFirstChild("PreviewName")
				if name then
					name:GetPropertyChangedSignal("Visible"):Connect(function()
						local view = holder:FindFirstChild("NLPickerView")
						if name.Visible and view and view.Visible then name.Visible = false end
					end)
				end
				refresh()
			end)
		end
		for _, object in ipairs(root:GetDescendants()) do hookPreview(object) end
		root.DescendantAdded:Connect(hookPreview)
	end)

	-- custom agents load asynchronously after the menu is built: refresh once when the list grew
	local function customCount()
		local n = 0
		for _ in pairs(Agents.custom) do n = n + 1 end
		return n
	end
	local before = customCount()
	task.delay(4, function()
		if customCount() ~= before then pcall(function() api:Refresh() end) end
	end)
	return true
end

-- Weapon groups (new library): every Rage / Legit element keeps a value per group, and the group of the held weapon is selected while the menu is closed.
function Menu.weaponNames()
	local knives = {}
	for _, name in ipairs(Skins.knives) do knives[name] = true end
	local list = {}
	for _, name in pairs(Skins.gameWeapons) do
		if not knives[name] and not name:lower():find("knife") then list[#list + 1] = name end
	end
	table.sort(list)
	return list
end

function Menu.weaponKey(Library, name)
	local info = type(Library._weaponInfo) == "function" and Library._weaponInfo(name) or nil
	if info then return info[2] end
	return (string.gsub(string.lower(tostring(name or "")), "[^%w]", ""))
end

function Menu.weaponGroups(Library, tab)
	if type(tab.SetGroupPresets) ~= "function" then return false end
	local names = Menu.weaponNames()
	local icons = {}
	for _, name in ipairs(names) do
		local okIcon, image = pcall(function()
			for _, entry in ipairs(Skins.forWeapon(name) or {}) do
				if entry.skin == "Stock" and type(entry.image) == "string" and entry.image ~= "" then return entry.image end
			end
			for _, entry in ipairs(Skins.forWeapon(name) or {}) do
				if type(entry.image) == "string" and entry.image ~= "" then return entry.image end
			end
		end)
		if okIcon and image then icons[name] = image end
	end
	Menu.weaponIcons = icons
	-- Нет картинки из набора библиотеки: рисуем иконку оружия из игры.
	local Lib = Library
	if type(Lib._weaponIcon) == "function" and not Lib._nlIconWrapped then
		Lib._nlIconWrapped = true
		local original = Lib._weaponIcon
		Lib._weaponIcon = function(weaponName, parent, w, h, color, z)
			local holder = original(weaponName, parent, w, h, color, z)
			pcall(function()
				local image = Menu.weaponIcons and Menu.weaponIcons[tostring(weaponName)]
				if image and holder and not holder:FindFirstChild("WeaponImage") then
					for _, child in ipairs(holder:GetChildren()) do child:Destroy() end
					local label = Instance.new("ImageLabel")
					label.Name = "WeaponImage"
					label.BackgroundTransparency = 1
					label.Size = UDim2.fromScale(1, 1)
					label.Image = image
					label.ScaleType = Enum.ScaleType.Fit
					label.ZIndex = holder.ZIndex + 1
					label.Parent = holder
				end
			end)
			return holder
		end
	end
	-- пробуем сначала с иконками из игры (Icons), при отказе библиотеки — прежний набор
	if not pcall(tab.SetGroupPresets, tab, { Items = names, Icons = icons, Default = "Global" }) then
		if not pcall(tab.SetGroupPresets, tab, { Items = names, Default = "Global" }) then return false end
	end
	Menu.groupTabs = Menu.groupTabs or {}
	table.insert(Menu.groupTabs, tab)
	-- Переключение группы выставляет значения контролов колбэками: это не ручная правка.
	local W = Neverlose.window
	if W and type(W._gvSwitch) == "function" and not W._nlGvWrapped then
		W._nlGvWrapped = true
		local original = W._gvSwitch
		W._gvSwitch = function(...)
			local was = Neverlose.groupSwitching
			Neverlose.groupSwitching = true
			local results = table.pack(pcall(original, ...))
			Neverlose.groupSwitching = was
			if not results[1] then error(results[2], 0) end
			return table.unpack(results, 2, results.n)
		end
	end
	Neverlose.inCustomGroup = function()
		for _, groupTab in ipairs(Menu.groupTabs or {}) do
			local okGroup, name = pcall(function() return (groupTab:GetGroup()) end)
			if okGroup and name and name ~= "Global" then return true end
		end
		return false
	end
	return true
end

function Menu.followWeapon(Library)
	local lastName, lastAt = nil, 0
	maid:give(runService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - lastAt < 0.25 or menuOpen() then return end
		local weapon = Game.weapon()
		local name = weapon and weapon.Name
		if not name or (name == lastName and now - lastAt < 1) then return end
		lastName, lastAt = name, now
		local key = Menu.weaponKey(Library, name)
		for _, tab in ipairs(Menu.groupTabs or {}) do
			pcall(function()
				local target = "Global"
				for _, group in ipairs(tab:GetGroups()) do
					if group.Name ~= "Global" then
						for _, item in ipairs(group.Items) do
							if Menu.weaponKey(Library, item) == key then target = group.Name break end
						end
						if target ~= "Global" then break end
					end
				end
				if (tab:GetGroup()) ~= target then tab:SelectGroup(target) end
			end)
		end
	end))
end

function Menu.build()
	local Library = Menu.loadLibrary()
	Library.DaysLeft = nil

	local hk = {}
	local window = Library:AddWindow("Neverlose", "", "BloxStrike")
	window:SetScale("Auto")

	window._autoLoaded = true
	Neverlose.library, Neverlose.window = Library, window
	Neverlose.tabs = {}
	Neverlose.hk = hk

	HudShift.start()
	Neverlose.rainbowStart()
	Menu.aimbot(window, hk)
	Menu.visuals(window, hk)
	Menu.inventory(window)
	Menu.misc(window, hk)

	task.delay(2.2, function()
		window._autoLoaded = false
		pcall(window._autoLoad)
	end)
	if Settings.saved and Settings.saved.extras then
		-- After the config autoload, so it can't wipe binds loaded from the config.
		task.delay(3.4, function() Settings.restoreExtras(true) end)
	end
	-- The save pill always shows the active config's name (not the "Default" placeholder) and resizes to fit it.
	do
		local lastCheck, shown = 0, nil
		local textService = game:GetService("TextService")
		maid:give(runService.Heartbeat:Connect(function()
			local now = os.clock()
			if now - lastCheck < 0.4 then return end
			lastCheck = now
			local box = window._saveBox
			local label = box and box.Parent and box.Parent:FindFirstChild("SaveText")
			if not label then return end
			local name = window._activePresetName
			if not name and now > 3 and isfile and readfile then
				local path = "NeverloseConfig_1__last.txt"
				local okFile, exists = pcall(isfile, path)
				local okRead, saved = false, nil
				if okFile and exists then okRead, saved = pcall(readfile, path) end
				if okRead and type(saved) == "string" and saved ~= "" then name = saved end
			end
			if not name then return end
			if label.Text ~= name then label.Text = name end
			if shown ~= name then
				shown = name
				pcall(function()
					local save = label.Parent
					local size = textService:GetTextSize(name, 15, label.Font, Vector2.new(1000, 100))
					local width = math.clamp(math.ceil(size.X) + 83, 150, 266)
					local newLib = Menu.groupTabs and #Menu.groupTabs > 0
					save.Size = UDim2.fromOffset(width, newLib and 30 or 28)
					local presets = save.Parent and save.Parent:FindFirstChild("GlobalPreset")
					if presets then
						presets.Position = newLib and UDim2.fromOffset(10 + width + 12, 8) or UDim2.fromOffset(11 + width + 12, 13)
					end
				end)
			end
		end))
	end

	window:SetWatermark({
		positionPreset = "Top Right",
		show = { logo = true, name = true, ping = true, user = true, speed = false, time = false, fps = true, ram = false },
		order = { "logo", "name", "ping", "user", "speed", "time", "fps", "ram" },
	})

	do
		local statsService = game:GetService("Stats")
		local frame = window.Watermark and window.Watermark.frame
		local clock, smooth = 0, 1 / 60
		local function setCell(name, text)
			local label = frame and frame:FindFirstChild(name, true)
			if label and label:IsA("TextLabel") and label.Text ~= text then label.Text = text end
		end
		local function stat(path)
			local ok, value = pcall(function() return statsService.PerformanceStats[path]:GetValue() end)
			return ok and value or nil
		end
		maid:give(runService.Heartbeat:Connect(function(delta)
			smooth += (delta - smooth) * 0.1
			clock += delta
			if clock < 0.25 then return end
			clock = 0
			local frameMs = math.max(smooth * 1000, 1)
			local okPing, ping = pcall(function() return statsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
			ping = okPing and ping or 0
			if Neverlose.fakePingValue and Neverlose.fakePingValue() then ping = Neverlose.fakePingValue() end
			local character = localPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local velocity = root and root.AssemblyLinearVelocity or Vector3.zero
			local cpu, gpu = stat("CPU"), stat("GPU")
			setCell("RAM", ("%d MB"):format(statsService:GetTotalMemoryUsageMb()))
			setCell("Speed", ("%d SPEED"):format(math.floor(Vector3.new(velocity.X, 0, velocity.Z).Magnitude + 0.5)))
			setCell("KD", ("%.2f KD"):format((Neverlose.kills or 0) / math.max(Neverlose.deaths or 0, 1)))
			setCell("Latency", ("%d MS"):format(math.floor(ping + 0.5)))
			if cpu then setCell("CPU", ("%d%% CPU"):format(math.clamp(math.floor(cpu / frameMs * 100 + 0.5), 0, 100))) end
			if gpu then setCell("GPU", ("%d%% GPU"):format(math.clamp(math.floor(gpu / frameMs * 100 + 0.5), 0, 100))) end
			setCell("Issues", (1000 / frameMs < 40 or ping > 200) and "LAG" or "OK")
		end))
	end

	-- Что библиотека конфигов не сохраняет: положение и ячейки ватермарки, число Displayed Ping.
	do
		local FILE = "NeverloseExtra.json"
		local http = service("HttpService")
		local features = Neverlose.config.features
		local wm = window._wm
		local frame = window.Watermark and window.Watermark.frame
		local KEYS = { "logo", "name", "ping", "user", "speed", "time", "fps", "ram" }
		local function apply(data)
			if type(data.pingMs) == "number" then
				features.fakePingMs = math.clamp(math.floor(data.pingMs), 0, 999)
				if Neverlose.pingBox then Neverlose.pingBox.Text = tostring(features.fakePingMs) end
			end
			if type(data.shown) == "table" and wm and wm.setShown then
				for key, on in pairs(data.shown) do pcall(wm.setShown, key, on == true) end
			end
			if type(data.pos) == "table" and frame then
				pcall(function()
					if type(data.anchor) == "table" then frame.AnchorPoint = Vector2.new(data.anchor[1], data.anchor[2]) end
					frame.Position = UDim2.new(data.pos[1], data.pos[2], data.pos[3], data.pos[4])
				end)
			end
		end
		if isfile and readfile and writefile then
			local okRead, raw = pcall(function() return isfile(FILE) and readfile(FILE) or nil end)
			if okRead and type(raw) == "string" then
				local okDecode, data = pcall(function() return http:JSONDecode(raw) end)
				if okDecode and type(data) == "table" then
					apply(data)
					-- библиотека может переставить ватермарку при загрузке конфига, поэтому применяем ещё раз позже
					task.delay(2, function() pcall(apply, data) end)
				end
			end
			-- Положение и ячейки записываются только пока открыто меню: вне его ватермарка может быть временно сдвинута.
			local state = {}
			if okRead and type(raw) == "string" then
				local okState, decoded = pcall(function() return http:JSONDecode(raw) end)
				if okState and type(decoded) == "table" then state = decoded end
			end
			local lastRaw, lastSave = raw, 0
			maid:give(runService.Heartbeat:Connect(function()
				local now = os.clock()
				if now - lastSave < 1 then return end
				lastSave = now
				pcall(function()
					state.pingMs = features.fakePingMs
					if menuOpen() then
						state.shown = {}
						if wm and wm.isShown then for _, key in ipairs(KEYS) do state.shown[key] = wm.isShown(key) end end
						if frame then
							local pos = frame.Position
							state.pos = { pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset }
							state.anchor = { frame.AnchorPoint.X, frame.AnchorPoint.Y }
						end
					end
					local encoded = http:JSONEncode(state)
					if encoded ~= lastRaw then
						lastRaw = encoded
						writefile(FILE, encoded)
					end
				end)
			end))
		end
	end

	pcall(function() window.KeybindList.setEnabled(Neverlose.config.misc.windows) end)
	pcall(function() window.SpectatorList.setEnabled(Neverlose.config.misc.spectatorList) end)

	-- The Hotkeys pill draws a square blur inset and stacked shadow rings that show up as a hard rectangle behind it.
	do
		local nextFix = 0
		maid:give(runService.Heartbeat:Connect(function()
			local now = os.clock()
			if now < nextFix then return end
			nextFix = now + 0.5
			local ui = game:GetService("CoreGui"):FindFirstChild("NLUI")
			local header = ui and ui:FindFirstChild("Keybinds") and ui.Keybinds:FindFirstChild("Header")
			if not header then return end
			for _, child in ipairs(header:GetChildren()) do
				if (child.Name == "BlurArea" or child.Name:find("^ShadowRing")) and child.Visible then child.Visible = false end
			end
		end))
	end
end

function Neverlose.detach()
	maid:clean()
	pcall(function()
		local frame = Neverlose.window and Neverlose.window:GetMainFrame()
		local gui = frame and frame:FindFirstAncestorOfClass("ScreenGui")
		if gui then gui:Destroy() end
	end)
	if genv[STATE_KEY] == Neverlose then genv[STATE_KEY] = nil end
end

Neverlose.Game, Neverlose.Ballistics, Neverlose.Patch, Neverlose.Events, Neverlose.Input = Game, Ballistics, Patch, Events, Input
Neverlose.Rage, Neverlose.Legit, Neverlose.Esp, Neverlose.Skins, Neverlose.Logs, Neverlose.Maid, Neverlose.AntiAim = Rage, Legit, Esp, Skins, Logs, Maid, AntiAim
Neverlose.Agents = Agents

local function onInitializeError(error)
	warn("[Neverlose] failed to initialize.")
	warn(error)
	warn(debug.traceback())
	Neverlose.detach()
end

-- Tamper guard: stops the script when a dumping/leaking function gets hooked after load (hooks that already existed are ignored).
local Guard = { baseline = {} }

function Guard.watched()
	return { loadstring, writefile, request, http_request, setclipboard, getscriptclosure, getscriptbytecode, decompile, saveinstance }
end

function Guard.hooked(fn)
	if not isfunctionhooked or type(fn) ~= "function" then return false end
	local ok, result = pcall(isfunctionhooked, fn)
	return ok and result == true
end

function Guard.snapshot()
	for index, fn in pairs(Guard.watched()) do Guard.baseline[index] = Guard.hooked(fn) end
end

function Guard.tampered()
	for index, fn in pairs(Guard.watched()) do
		if Guard.hooked(fn) and not Guard.baseline[index] then return true end
	end
	return false
end

function Guard.trip()
	Neverlose.detach()
end

pcall(Guard.snapshot)

task.spawn(function()
	while genv[STATE_KEY] == Neverlose do
		task.wait(4 + math.random())
		local ok, bad = pcall(Guard.tampered)
		if ok and bad then
			pcall(Guard.trip)
			break
		end
	end
end)

genv[STATE_KEY] = Neverlose
xpcall(Menu.build, onInitializeError)

end
