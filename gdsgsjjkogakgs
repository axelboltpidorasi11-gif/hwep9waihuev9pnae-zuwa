local runService
do
	local function gatedSignal(signal)
		local wrapper = {}
		function wrapper:Connect(callback)
			return signal:Connect(function(...)
				if Neverlose.ready then return callback(...) end
			end)
		end
		function wrapper:Once(callback) return signal:Once(callback) end
		function wrapper:Wait() return signal:Wait() end
		return wrapper
	end

	local function lateSignal()
		local wrapper = gatedSignal(realRunService.RenderStepped)
		function wrapper:Connect(callback)
			local name = game:GetService("HttpService"):GenerateGUID(false):gsub("-", ""):sub(1, 12)
			realRunService:BindToRenderStep(name, Enum.RenderPriority.Last.Value + 20, function(...)
				if Neverlose.ready then return callback(...) end
			end)
			local object = {}
			function object.Disconnect() pcall(realRunService.UnbindFromRenderStep, realRunService, name) end
			object.Remove = object.Disconnect
			return object
		end
		return wrapper
	end
	local signals = {
		Heartbeat = gatedSignal(realRunService.Heartbeat),
		RenderStepped = lateSignal(),
		Stepped = gatedSignal(realRunService.Stepped),
	}
	runService = setmetatable({}, {
		__index = function(_, key)
			if signals[key] then return signals[key] end
			if key == "BindToRenderStep" then
				return function(_, name, priority, callback)
					return realRunService:BindToRenderStep(name, priority, function(...)
						if Neverlose.ready then return callback(...) end
					end)
				end
			end
			local value = realRunService[key]
			if type(value) == "function" then return function(_, ...) return value(realRunService, ...) end end
			return value
		end,
	})
end
