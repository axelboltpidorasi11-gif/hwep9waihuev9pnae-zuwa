function HitEffects.lightning(position, color)
	local view, onScreen = currentCamera:WorldToViewportPoint(position)
	if not onScreen or view.Z <= 0 then return end
	local top = position + Vector3.new((math.random() - 0.5) * 6, 45, (math.random() - 0.5) * 6)
	local previous = top
	for index = 1, 9 do
		local alpha = index / 9
		local point = top:Lerp(position, alpha)
		if index < 9 then
			local spread = 5 * (1 - alpha * 0.5)
			point += Vector3.new((math.random() - 0.5) * spread, 0, (math.random() - 0.5) * spread)
		end
		local length = (point - previous).Magnitude
		if length > 0.05 then
			local bolt = HitEffects.glow(CFrame.lookAt(previous:Lerp(point, 0.5), point), Vector3.new(0.35, 0.35, length), color)
			HitEffects.fade(bolt, { Size = Vector3.new(0.05, 0.05, length) }, 0.45)
		end
		previous = point
	end
	local flash = HitEffects.glow(CFrame.new(position), Vector3.new(1, 1, 1), color, Enum.PartType.Ball, 0.1)
	HitEffects.fade(flash, { Size = Vector3.new(7, 7, 7) }, 0.4)
end

function HitEffects.shatter(position, color)
	for _ = 1, 16 do
		local size = 0.3 + math.random() * 0.5
		local cube = HitEffects.glow(CFrame.new(position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6), Vector3.new(size, size, size), color)
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.2, math.random() - 0.5).Unit
		HitEffects.fade(cube, {
			Position = position + dir * (5 + math.random() * 6), Size = Vector3.new(0.05, 0.05, 0.05),
			Orientation = Vector3.new(math.random() * 360, math.random() * 360, math.random() * 360),
		}, 0.9)
	end
end

function HitEffects.halo(position, color)
