local ShotTracker, originalSend, Killfeed
do
ShotTracker = { pending = {} }
Neverlose.ShotTracker = ShotTracker

local function snapshot(character)
	local cframes, sizes = {}, {}
	for _, name in ipairs(BODY_PARTS) do
		local part = character:FindFirstChild(name)
		if part then cframes[name], sizes[name] = part.CFrame, part.Size end
	end
	return cframes, sizes
end

function ShotTracker.register(origin, direction, hits, range, tap, expect, info)
	local last = hits[#hits]
	local finish = last and last.Position or origin + direction * range
	local enemyEntity, enemyPart

	for _, hit in ipairs(hits) do
		local entity = hit.Instance and Game.ownerOf(hit.Instance)
		if entity and entity ~= localPlayer and Game.isEnemy(entity, true) then
			enemyEntity, enemyPart = entity, hit.Instance
			finish = hit.Position
			break
		end
	end

	if not enemyEntity and info and info.entity and info.entity.Parent then
		enemyEntity, enemyPart = info.entity, { Name = info.part or "Body" }
		info.blocked = true
	end

	HitEffects.tracer(origin, finish, last ~= nil, last and last.Normal, hits)

	if enemyEntity then
		local character = enemyEntity.Character
		local wallCount, wallParts = 0, {}
		for _, hit in ipairs(hits) do
			if hit.Instance == enemyPart then break end
			if not hit.Exit then
				wallCount += 1
				wallParts[#wallParts + 1] = hit.Instance
			end
		end
		local heldWeapon = Game.weapon()

		local previous = ShotTracker.pending[enemyEntity]
		if tap == 2 and previous and previous.taps == 1 and os.clock() - previous.t < 0.3 then

			previous.taps, previous.expect, previous.t = 2, expect, os.clock()
		elseif previous and previous.taps == 1 and tap ~= 2 and os.clock() - previous.t < 0.35 and os.clock() - (previous.first or previous.t) < 0.6 then
			previous.t, previous.shots = os.clock(), (previous.shots or 1) + 1
			previous.part, previous.hitPos, previous.info = enemyPart.Name, finish, info or previous.info
		else
			if previous then ShotTracker.flushPending(enemyEntity, previous) end
			ShotTracker.pending[enemyEntity] = {
				t = os.clock(), first = os.clock(), part = enemyPart.Name, character = character, taps = 1, expect = expect,
				walls = wallCount, wallParts = wallParts, weapon = heldWeapon and heldWeapon.Name,
				hp = character and character:GetAttribute("Health") or 100,
				info = info, origin = origin, hitPos = finish,
				pos0 = character and character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.Position or nil,
			}
		end

		local onShot = Neverlose.config.esp.enemyModel.onShot
		if onShot.mode ~= "Disabled" and character then
			local cframes, sizes = snapshot(character)
			HitEffects.ghost(cframes, sizes, onShot.color, 1.2, onShot.mode == "Wireframe" and Enum.Material.ForceField or Enum.Material.Neon)
		end
	end
end

---Log a pending shot that is being replaced so its outcome is never silently lost.
function ShotTracker.flushPending(entity, shot)
	local character = shot.character
	local health = character and character:GetAttribute("Health")
	if type(health) == "number" and health < shot.hp then
		Logs.push("Combat", ("hit {%s} ({%s}) for {%d} · {%d} hp left"):format(tostring(entity.DisplayName or entity.Name), shot.part, shot.hp - health, math.max(math.floor(health + 0.5), 0)))
		Events.fire("hit", entity, shot, shot.hp - health)
	else
		ShotTracker.logMiss(entity, shot)
	end
end

---Log a missed shot with its reason and feed the miss back to the ragebot.
function ShotTracker.logMiss(entity, shot)
	local name = tostring(entity.DisplayName or entity.Name)
	local reason, detail = ShotTracker.missReason(shot, entity)
	Logs.push("Combat", ("missed {%s} ({%s}) · {%s}%s"):format(name, shot.part, reason, detail))
	HitSounds.play("miss")
	do
		local rage = Neverlose.Rage
		if rage then
			rage.missStreak = rage.missStreak or {}
			local streak = rage.missStreak[entity] or { n = 0 }
			streak.n, streak.t = streak.n + 1, os.clock()
			rage.missStreak[entity] = streak
		end
	end
	if shot.info and shot.info.mode == "rapid fire" and (shot.walls or 0) == 0 and not shot.info.blocked then Events.fire("rapidRejected") end
	if shot.taps == 2 then Events.fire("tapRejected", entity, shot) end
	Ballistics.wallResult(shot.weapon, shot.walls or 0, false)
	if (shot.walls or 0) > 0 and shot.wallParts and reason ~= "target died" then
		local expires = os.clock() + 25
		for _, wallPart in ipairs(shot.wallParts) do Ballistics.blocked[wallPart] = expires end
	end
	if shot.info and shot.info.shifted and reason ~= "target died" and Neverlose.Rage then
		Neverlose.Rage.originScale = math.max((Neverlose.Rage.originScale or 1) * 0.7, 0.3)
		Neverlose.Rage.originScaleAt = os.clock()
	end
end

function ShotTracker.missReason(shot, entity)
	local info = shot.info or {}
	local distance = info.distance or (shot.origin and shot.pos0 and (shot.pos0 - shot.origin).Magnitude) or 0
	local detail = ""
	if info.chance then detail = (" (hc {%d}%%, {%d} studs)"):format(math.floor(info.chance + 0.5), math.floor(distance + 0.5)) end
	local selfSpeed = 0
	local character = localPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local velocity = root.AssemblyLinearVelocity
		selfSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	end
	local dead = entity.Character and entity.Character:GetAttribute("Dead") == true

	if dead then return "target died", detail end
	if info.blocked then
		if (shot.walls or 0) > 0 then return "blocked by geometry", (" ({%d} obstacles)"):format(shot.walls) end
		return "shot missed the hitbox", detail
	end
	if info.direct and shot.taps == 2 then
		return "double tap not registered", (" (gap {%d}ms)"):format(math.floor((Neverlose.Rage.lastGap or 0) * 1000 + 0.5))
	end
	if info.mode == "rapid fire" then return "rapid fire cadence", (" ({%d} shots)"):format(shot.shots or 1) end
	if info.mode == "direct" then return "direct shot not registered", (" ({%d} studs)"):format(math.floor(distance + 0.5)) end
	if info.chance and info.chance < 60 and not info.direct then return "spread", detail end
	if (shot.walls or 0) > 0 then return "penetration", (" ({%d} walls)"):format(shot.walls) end
	if shot.speed and shot.speed > 10 then return "prediction", (" (target {%d} st/s)"):format(math.floor(shot.speed + 0.5)) end
	if info.record then return "backtrack", detail end
	if selfSpeed > 6 then return "movement inaccuracy", (" (speed {%d})"):format(math.floor(selfSpeed + 0.5)) end
	if distance > 140 then return "range", detail end
	if Game.serverHits then return "lag compensation", detail end
	if info.chance then return "desync", detail end
	return "unregistered shot", detail
end

maid:give(runService.Heartbeat:Connect(function()
	local now = os.clock()
	for entity, shot in pairs(ShotTracker.pending) do
		local character = shot.character
		local health = character and character:GetAttribute("Health")
		local dead = not character or not character.Parent or character:GetAttribute("Dead") == true or (type(health) == "number" and health <= 0)
		local name = tostring(entity.DisplayName or entity.Name)

		if not shot.speed and now - shot.t > 0.06 and shot.pos0 and character then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root then shot.speed = (root.Position - shot.pos0).Magnitude / math.max(now - shot.t, 0.01) end
		end

		local settled = shot.taps ~= 2 or now - shot.t >= 0.45

		if dead then
			ShotTracker.pending[entity] = nil
			markerUntil, markerKill = now + 0.45, true
			playHitSound("kill")
