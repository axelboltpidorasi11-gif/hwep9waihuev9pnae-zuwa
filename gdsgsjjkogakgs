runService:BindToRenderStep(xrayStep, Enum.RenderPriority.Last.Value + 22, function()
	if next(Xray.entries) == nil and next(Xray.boxes) == nil then return end
	host()
	local camera = currentCamera.CFrame
	local inverse = camera:Inverse()
	Xray.anchor.CFrame = camera
	for owner, entry in pairs(Xray.entries) do
		local character = entry.character
		if character and character.Parent then
			local set = Xray.boxes[owner]
