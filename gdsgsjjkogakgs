do
	local NameSpoof = { fake = nil, hooked = setmetatable({}, { __mode = "k" }) }
	Neverlose.NameSpoof = NameSpoof

	local function escape(text) return (text:gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0")) end

	local function fakeName()
		local features = Neverlose.config.features
		if not features.nameSpoof then return nil end
		if features.nameMode == "Custom" then
			local text = features.nameCustom
			if type(text) == "string" and #text > 0 then return text end
		elseif features.nameMode == "Random" then
			NameSpoof.random = NameSpoof.random or ("User" .. math.random(10000, 99999))
			return NameSpoof.random
		end
		return "Neverlose"
	end

	local function patch(label)
		local fake = NameSpoof.fake
		if not fake then return end
		local text = label.Text
		if text == "" then return end
		for _, real in ipairs({ localPlayer.DisplayName, localPlayer.Name }) do
			if real ~= "" and text:find(real, 1, true) then
				text = text:gsub(escape(real), (fake:gsub("%%", "%%%%")))
			end
		end
		if text ~= label.Text then label.Text = text end
	end

	local function watch(object)
		if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then return end
		if NameSpoof.hooked[object] then return end
		NameSpoof.hooked[object] = true
		maid:give(object:GetPropertyChangedSignal("Text"):Connect(function() patch(object) end))
		patch(object)
	end

	function NameSpoof.prompt()
		Neverlose.Ui.prompt({
			title = "Custom name",
			placeholder = "Name shown instead of yours",
			default = Neverlose.config.features.nameCustom,
			hint = "",
			confirm = "Apply",
			onSubmit = function(text, setStatus)
				text = text:gsub("^%s+", ""):gsub("%s+$", "")
				if #text == 0 or #text > 24 then
					setStatus("1 to 24 characters", Color3.fromRGB(235, 120, 120))
					return false
				end
				Neverlose.config.features.nameCustom = text
				NameSpoof.refresh()
				setStatus("Applied", Color3.fromRGB(120, 220, 150))
				return true
			end,
		})
	end

	function NameSpoof.refresh()
		NameSpoof.fake = fakeName()
		if not NameSpoof.fake then return end
		local gui = localPlayer:FindFirstChildOfClass("PlayerGui")
		if not gui then return end
		for _, object in ipairs(gui:GetDescendants()) do watch(object) end
		for object in pairs(NameSpoof.hooked) do if object.Parent then patch(object) end end
	end

	task.spawn(function()
		local gui = localPlayer:WaitForChild("PlayerGui")
		maid:give(gui.DescendantAdded:Connect(function(object)
			if NameSpoof.fake then watch(object) end
		end))
		NameSpoof.refresh()
	end)
end

do
local WorldEsp = { labels = {} }

local function worldLabel(key)
	local entry = WorldEsp.labels[key]
	if entry then
		entry.seen = true
		return entry
	end
	entry = {
		seen = true,
		text = NewDrawing("Text"),
		box = NewDrawing("Square"),
		icon = NewDrawing("Circle"),
	}
	entry.text.Center, entry.text.Outline, entry.text.Size, entry.text.Font = true, true, 13, 2
	entry.box.Filled, entry.box.Thickness = false, 1
	entry.icon.Filled, entry.icon.NumSides = true, 12
	WorldEsp.labels[key] = entry
	return entry
end

local function hideLabel(entry)
	entry.text.Visible, entry.box.Visible, entry.icon.Visible = false, false, false
end

local function renderWorld(key, position, text, color, style, maxDistance, textColor, showDistance)
	local entry = worldLabel(key)
	local distance = (position - currentCamera.CFrame.Position).Magnitude
	local point, visible = currentCamera:WorldToViewportPoint(position)
	if not visible or distance > maxDistance then return hideLabel(entry) end

	local screen = Vector2.new(point.X, point.Y)
	local scale = math.clamp(40 / math.max(point.Z, 1), 0.4, 3)
	entry.text.Text = showDistance == false and text or ("%s [%dm]"):format(text, distance * STUDS_PER_METER)
	entry.text.Color = textColor or color
	entry.text.Position = screen + Vector2.new(0, 10 * scale)
	entry.text.Visible = true

	entry.box.Visible = style == "Box"
	if entry.box.Visible then
		local size = Vector2.new(22, 14) * scale
		entry.box.Size, entry.box.Position, entry.box.Color = size, screen - size / 2, color
	end
	entry.icon.Visible = style == "Icon"
	if entry.icon.Visible then
		entry.icon.Position, entry.icon.Radius, entry.icon.Color = screen, 5 * scale, color
	end
end

local bombInfo = {}
local hostageCache, hostageAt = {}, -1
local grenadeWarning = draw("Text", { Size = 16, Center = true, Outline = true, Font = 2, Color = Color3.fromRGB(255, 90, 90), Visible = false })
local warnBack = draw("Square", { Filled = true, Color = Color3.fromRGB(10, 10, 14), Transparency = 0.6, Visible = false })
local warnFill = draw("Square", { Filled = true, Visible = false })
local warnArrows = {}
for index = 1, 3 do warnArrows[index] = draw("Triangle", { Filled = true, Thickness = 1, Visible = false }) end
local WARN_NAMES = { ["HE Grenade"] = "HE", Molotov = "MOLOTOV", ["Incendiary Grenade"] = "INCENDIARY" }

maid:give(runService.RenderStepped:Connect(function()
	local world = Neverlose.config.world
	for _, entry in pairs(WorldEsp.labels) do entry.seen = false end

	local debris = workspaceService:FindFirstChild("Debris")

	if world.bomb.enabled or world.weapons.enabled then
		local bombs = collectionService:GetTagged("Bomb")
		for _, model in ipairs(debris and debris:GetChildren() or {}) do
			if model:IsA("Model") then
				local planted = model:GetAttribute("BombPlanted")
				local weaponName = model:GetAttribute("Weapon")
				local pivot = model:GetPivot().Position
				if type(planted) == "string" and world.bomb.enabled then
					bombs[#bombs + 1] = model
				elseif type(weaponName) == "string" and world.weapons.enabled then
					renderWorld(model, pivot, weaponName, weaponName == "C4" and world.bomb.color or world.weapons.color, world.weapons.style, weaponName == "C4" and world.bomb.maxDistance or world.weapons.maxDistance, nil, (weaponName == "C4" and world.bomb or world.weapons).showDistance)
				end
			end
		end

		if world.bomb.enabled then
			for _, bomb in ipairs(bombs) do
				if bomb:IsDescendantOf(workspaceService) then
					local planted = bomb:GetAttribute("BombPlanted")
					local label, textColor = "C4", world.bomb.timerColor
					if type(planted) == "string" then
						local info = bombInfo[planted]
						if not info then
							local ok, data = pcall(httpService.JSONDecode, httpService, planted)
							info = ok and type(data) == "table" and data or {}
							bombInfo[planted] = info
						end
						local fuse = math.max(tonumber(info.TimeUntilExplode) or 40, 0.1)
						local remaining = math.max((tonumber(info.Time) or workspaceService:GetServerTimeNow()) + fuse - workspaceService:GetServerTimeNow(), 0)
						local stateText = bomb:GetAttribute("Defused") == true and "DEFUSED" or (bomb:GetAttribute("Exploded") or bomb:GetAttribute("Exploding")) and "EXPLODED" or ("%.1fs"):format(remaining)
						label = world.bomb.showTimer and ("C4 %s %s"):format(type(info.Site) == "string" and info.Site or "", stateText) or ("C4 %s"):format(type(info.Site) == "string" and info.Site or "")
						textColor = world.bomb.timerGradient and world.bomb.timerColor2:Lerp(world.bomb.timerColor, math.clamp(remaining / fuse, 0, 1)) or world.bomb.timerColor
					end
					local position = bomb:IsA("Model") and bomb:GetPivot().Position or bomb:IsA("BasePart") and bomb.Position
					if position then renderWorld(bomb, position, label, world.bomb.color, world.bomb.style, world.bomb.maxDistance, textColor, world.bomb.showDistance) end
				end
			end
		end
	end

	if false then
		if os.clock() - hostageAt > 2 then
			hostageAt = os.clock()
			hostageCache = collectionService:GetTagged("Hostage")
			if #hostageCache == 0 then
				for _, object in ipairs(workspaceService:GetDescendants()) do
					if object:IsA("Model") and object.Name:find("Hostage") then hostageCache[#hostageCache + 1] = object end
				end
			end
		end
		for _, hostage in ipairs(hostageCache) do
			if hostage.Parent and hostage:IsA("Model") then
				renderWorld(hostage, hostage:GetPivot().Position, "Hostage", world.hostages.color, "Box", 5000, nil, world.hostages.showDistance)
			end
		end
	end

	local threats = {}
	local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
	local warnRange = world.proximityRange or 1.5
	for _, grenade in ipairs(collectionService:GetTagged("Grenade")) do
		local name = grenade:GetAttribute("GrenadeName")
		local info = name and GRENADES[name]
		local part = grenade:IsA("Model") and grenade.PrimaryPart or grenade:IsA("BasePart") and grenade
		if info and part then
			if world.grenades.enabled then
				renderWorld(grenade, part.Position, name, (world.grenades.colors and world.grenades.colors[name]) or info.color, world.grenades.style, world.grenades.maxDistance, nil, world.grenades.showDistance)
			end
			if localRoot and WARN_NAMES[name] then
				local distance = (part.Position - localRoot.Position).Magnitude
				local reach = info.radius * warnRange
				if distance < reach then
					threats[#threats + 1] = { name = name, position = part.Position, distance = distance, danger = 1 - distance / reach }
				end
			end
		end
	end
	table.sort(threats, function(a, b) return a.distance < b.distance end)

	local top = world.proximity and threats[1] or nil
	local screen = currentCamera.ViewportSize
	if top then
		local pulse = 0.7 + 0.3 * math.sin(os.clock() * (6 + top.danger * 10))
		local color = Color3.fromRGB(255, 205, 70):Lerp(Color3.fromRGB(255, 60, 60), math.clamp(top.danger * 1.4, 0, 1))
		grenadeWarning.Text = ("%s  %dm"):format(WARN_NAMES[top.name], math.max(math.floor(top.distance * STUDS_PER_METER + 0.5), 0))
		grenadeWarning.Position = Vector2.new(screen.X / 2, screen.Y * 0.36)
		grenadeWarning.Color, grenadeWarning.Transparency, grenadeWarning.Visible = color, pulse, true
		local width = 120
		warnBack.Position, warnBack.Size, warnBack.Visible = Vector2.new(screen.X / 2 - width / 2, screen.Y * 0.36 + 14), Vector2.new(width, 4), true
		warnFill.Position, warnFill.Size = warnBack.Position, Vector2.new(width * math.clamp(top.danger, 0.04, 1), 4)
		warnFill.Color, warnFill.Visible = color, true
	else
		grenadeWarning.Visible, warnBack.Visible, warnFill.Visible = false, false, false
	end

	local camera = currentCamera.CFrame
	for index, arrow in ipairs(warnArrows) do
		local threat = world.proximity and world.proximityArrows ~= false and threats[index] or nil
		if threat then
			local offset = threat.position - camera.Position
			local angle = math.atan2(offset:Dot(camera.RightVector), offset:Dot(camera.LookVector))
			local direction = Vector2.new(math.sin(angle), -math.cos(angle))
			local side = Vector2.new(-direction.Y, direction.X)
			local center = screen / 2 + direction * 150
			arrow.PointA = center + direction * 12
			arrow.PointB = center - direction * 6 + side * 9
			arrow.PointC = center - direction * 6 - side * 9
			arrow.Color = Color3.fromRGB(255, 205, 70):Lerp(Color3.fromRGB(255, 60, 60), math.clamp(threat.danger * 1.4, 0, 1))
			arrow.Transparency, arrow.Visible = 0.9, true
