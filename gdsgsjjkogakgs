		end
		if (position - currentCamera.CFrame.Position).Magnitude > esp.soundDistance then return end

		local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
		if localRoot and (localRoot.Position - position).Magnitude < 8 then return end

		if not esp.soundTeam and group ~= "Utility" then

