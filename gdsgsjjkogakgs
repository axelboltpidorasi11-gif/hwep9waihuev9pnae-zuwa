		local ok, result = asGame(lib.GetCharacterModel, resolved, skin or "Stock", float or 0.03, nil, nil, charmArg)
		if ok and typeof(result) == "Instance" then
			pcall(Skins.attachCharms, result, resolved)
			return result, resolved
		end
	end
	local assets = replicatedStorage:FindFirstChild("Assets")
