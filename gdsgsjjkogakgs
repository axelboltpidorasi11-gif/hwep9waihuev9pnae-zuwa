local FLAG_ORDER = { "Unarmored", "Defuser", "Blind", "Scoped", "Reload", "Immunity", "Slowed", "Vulnerable", "Bomb", "Defuse", "Pin Pulled", "Money", "Order Priority", "Delay", "Sees You" }

local function project(camera, size, position)
	local relative = camera.CFrame:PointToObjectSpace(position)
	if relative.Z >= -0.01 then return nil end
	local tanHalf = math.tan(math.rad(camera.FieldOfView) / 2)
	local aspect = size.X / math.max(size.Y, 1)
	local x = (relative.X / -relative.Z) / (tanHalf * aspect)
	local y = (relative.Y / -relative.Z) / tanHalf
	return Vector2.new((x + 1) / 2 * size.X, (1 - y) / 2 * size.Y)
end

local function frame(parent, properties)
	properties.BorderSizePixel = 0
	return newInstance("Frame", properties, parent)
end

local function line(holder, from, to, color, thickness)
	local delta = to - from
	holder.Size = UDim2.fromOffset(delta.Magnitude, thickness or 1)
	holder.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
	holder.Rotation = math.deg(math.atan2(delta.Y, delta.X))
	holder.BackgroundColor3 = color
	holder.Visible = true
end

function Preview.build(api)
	local page = api and api.frame
	local body = page and page:FindFirstChild("Body")
	local viewport = body and body:FindFirstChild("PlayerView")
	if not viewport then return end

	local top = viewport.ZIndex
	for _, object in ipairs(page:GetDescendants()) do
		if object:IsA("GuiObject") and object.ZIndex > top and object.ZIndex < 9000 then top = object.ZIndex end
	end
	local layer = frame(body, { Name = "NeverloseEsp", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = top + 1 })
	local z = layer.ZIndex
	local ui = { layer = layer }
	ui.boxOutline = frame(layer, { BackgroundTransparency = 1, ZIndex = z })
	ui.outlineStroke = newInstance("UIStroke", { Color = Color3.new(), Thickness = 3 }, ui.boxOutline)
	ui.box = frame(layer, { BackgroundTransparency = 1, ZIndex = z + 1 })
	ui.boxStroke = newInstance("UIStroke", { Thickness = 1 }, ui.box)
	ui.boxGradient = newInstance("UIGradient", { Rotation = 90 }, ui.box)
	ui.corners = {}
	for index = 1, 8 do ui.corners[index] = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z + 1 }) end
	local function label(size, alignment)
		return newInstance("TextLabel", {
			BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = size, TextStrokeTransparency = 0.4,
			TextColor3 = Color3.new(1, 1, 1), TextXAlignment = alignment or Enum.TextXAlignment.Center, ZIndex = z + 2,
			Size = UDim2.fromOffset(160, size + 2), AnchorPoint = Vector2.new(alignment and 0 or 0.5, 0),
		}, layer)
	end
	ui.name = label(13)
	ui.distance = label(11)
	ui.weapon = label(11)
	ui.weaponIcon = newInstance("ImageLabel", {
		BackgroundTransparency = 1, Visible = false, ScaleType = Enum.ScaleType.Fit, ZIndex = z + 2,
	}, layer)
	ui.aim = label(11)
	ui.healthText = label(10)
	ui.flags = label(10, Enum.TextXAlignment.Left)
	ui.flags.TextYAlignment = Enum.TextYAlignment.Top
	ui.flags.Size = UDim2.fromOffset(80, 200)
	local function bar(vertical, color)
		local back = frame(layer, { BackgroundColor3 = Color3.new(), ZIndex = z })
		local fill = frame(back, { BackgroundColor3 = color, ZIndex = z + 1, AnchorPoint = vertical and Vector2.new(0, 1) or Vector2.new(0, 0), Position = vertical and UDim2.new(0, 1, 1, -1) or UDim2.fromOffset(1, 1) })
		local hit = frame(layer, { BackgroundTransparency = 1, ZIndex = z + 3, Visible = false })
		return { back = back, fill = fill, vertical = vertical, hit = hit }
	end
	ui.health = bar(true, Color3.fromRGB(90, 255, 110))
	ui.armor = bar(true, Color3.fromRGB(90, 170, 255))
	ui.ammo = bar(false, Color3.fromRGB(90, 170, 255))
	ui.ready = bar(false, Color3.fromRGB(255, 210, 90))
	ui.headDot = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 6), ZIndex = z + 3, Visible = false })
	newInstance("UICorner", { CornerRadius = UDim.new(1, 0) }, ui.headDot)
	ui.snap = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z + 1, Visible = false })
	ui.bones, ui.dots, ui.strokes, ui.cores = {}, {}, {}, {}
	for index = 1, #BONES do ui.bones[index] = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z + 1, Visible = false }) end
	for index = 1, #BODY_PARTS do
		ui.dots[index] = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(11, 11), BackgroundColor3 = Color3.fromRGB(150, 164, 255), BackgroundTransparency = 0.25, ZIndex = z + 2, Visible = false })
		newInstance("UICorner", { CornerRadius = UDim.new(1, 0) }, ui.dots[index])
		ui.strokes[index] = newInstance("UIStroke", { Thickness = 1.5, Transparency = 0.25, Color = Color3.fromRGB(190, 200, 255), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ui.dots[index])
		local core = frame(ui.dots[index], { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = z + 3 })
		newInstance("UICorner", { CornerRadius = UDim.new(1, 0) }, core)
		ui.cores[index] = core
	end

	do
		Preview.centers = Preview.centers or {}
		Preview.drag = nil
		ui.slot = frame(layer, { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.9, ZIndex = z + 5, Visible = false })
		newInstance("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.55 }, ui.slot)
		newInstance("UICorner", { CornerRadius = UDim.new(0, 3) }, ui.slot)

		local function sideOf(point, current)
			local rect = Preview.rect
			if not rect then return "Bottom" end
			local dx = (point.X - (rect.x + rect.w / 2)) / (rect.w / 2 + 36)
			local dy = (point.Y - (rect.y + rect.h / 2)) / (rect.h / 2 + 36)
			local ax, ay = math.abs(dx), math.abs(dy)
			if current == "Left" or current == "Right" then
				if ax + 0.2 >= ay then return dx < 0 and "Left" or "Right" end
			elseif current == "Top" or current == "Bottom" then
				if ay + 0.2 >= ax then return dy < 0 and "Top" or "Bottom" end
			end
			if ax > ay then return dx < 0 and "Left" or "Right" end
			return dy < 0 and "Top" or "Bottom"
		end

		local function grab(id, element)
			element.Active = true
			element.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton2 then
					Neverlose.config.esp.layout[id] = nil
				elseif (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and Preview.centers[id] then
					Preview.drag = { id = id, origin = input.Position, start = Preview.centers[id], point = Preview.centers[id] }
				end
			end)
		end
		for _, id in ipairs({ "name", "aim", "distance", "weapon", "flags" }) do grab(id, ui[id]) end
		for _, id in ipairs({ "health", "armor", "ammo", "ready" }) do grab(id, ui[id].hit) end
		grab("weaponIcon", ui.weaponIcon)

		maid:give(userInputService.InputChanged:Connect(function(input)
			local drag = Preview.drag
			if not drag or (input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch) then return end
			local delta = input.Position - drag.origin
			local point = Vector2.new(drag.start.X + delta.X, drag.start.Y + delta.Y)
			drag.point, drag.side = point, sideOf(point, drag.side)
		end))
		maid:give(userInputService.InputEnded:Connect(function(input)
			local drag = Preview.drag
			if not drag or (input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch) then return end
			if drag.side then
				Neverlose.config.esp.layout[drag.id] = drag.side ~= Neverlose.LAYOUT_DEFAULT[drag.id] and drag.side or nil
			end
			Preview.drag = nil
		end))
	end
	Preview.ui, Preview.viewport, Preview.api = ui, viewport, api
end

local originals = setmetatable({}, { __mode = "k" })

local function paintModel(model, visible, walls)
	local style = CHAMS_STYLE[walls and walls.mode or ""] and walls or visible
	local def = style and CHAMS_STYLE[style.mode or ""]
	Preview.bodyState = Preview.bodyState or { store = originals, scan = 0 }
	if def then
		local shown
		if def.neon then
			shown = { material = Enum.Material.Neon, alpha = 0 }
		else
			shown = { material = def.material or (def.fill >= 1 and Enum.Material.ForceField) or Enum.Material.Neon, alpha = def.alpha, reflectance = def.reflectance }
		end
		Preview.bodyState.scan = 0
		BodyMat.drive(Preview.bodyState, model, shown, style.color)
	else
		BodyMat.drive(Preview.bodyState, nil, nil, nil)
	end
end

-- Layered glow identical to the live ESP: stacked rounded strokes around a rectangle.
-- Self-contained copy of the live layer table so the preview never depends on outer-scope locals.
Preview.glowLayers = {
	{ thickness = 2, transparency = 0.5, radius = 2 },
	{ thickness = 4, transparency = 0.72, radius = 4 },
	{ thickness = 7, transparency = 0.85, radius = 7 },
	{ thickness = 11, transparency = 0.93, radius = 11 },
}
function Preview.glowStyle(spec, size, power)
	local scale = 0.35 + (size or 50) / 50 * 0.65
	local boost = (power or 50) / 50
	return math.max(1, spec.thickness * scale), math.clamp(1 - (1 - spec.transparency) * boost, 0, 0.98)
end

function Preview.glowRect(store, key, parent, zIndex, x, y, w, h, color, size, power, round)
	local kit = store[key]
	if not kit then
		local holder = newInstance("Frame", { Name = randomName(), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = zIndex }, parent)
		kit = { holder = holder, strokes = {}, corners = {} }
		for index, spec in ipairs(Preview.glowLayers) do
			local layer = newInstance("Frame", { Name = randomName(), BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = zIndex }, holder)
			kit.corners[index] = newInstance("UICorner", { CornerRadius = UDim.new(0, spec.radius) }, layer)
			kit.strokes[index] = newInstance("UIStroke", { Thickness = spec.thickness, Transparency = spec.transparency, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, layer)
		end
		store[key] = kit
	end
	kit.holder.Position, kit.holder.Size, kit.holder.Visible = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h), true
	for index, stroke in ipairs(kit.strokes) do
		stroke.Color = color
		stroke.Thickness, stroke.Transparency = Preview.glowStyle(Preview.glowLayers[index], size, power)
		if round ~= nil then
			kit.corners[index].CornerRadius = UDim.new(0, round > 0 and round + Preview.glowLayers[index].radius or 0)
			stroke.LineJoinMode = round > 0 and Enum.LineJoinMode.Round or Enum.LineJoinMode.Miter
		end
	end
end

function Preview.glowHide(store, key)
	local kit = store[key]
	if kit then kit.holder.Visible = false end
end

function Preview.standIn(world, camera, viewport)
	if os.clock() - (Preview.standInAt or -10) < 2 then return nil end
	Preview.standInAt = os.clock()

	local ok, rig = pcall(function()
		return playersService:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if not ok or typeof(rig) ~= "Instance" then return nil end

	local existing = world:FindFirstChildOfClass("Model")
	if existing then
		rig:Destroy()
		return existing
	end

	for _, object in ipairs(rig:GetDescendants()) do
		if object:IsA("BasePart") then
			object.Anchored, object.CanCollide = true, false
		elseif object:IsA("LuaSourceContainer") or object:IsA("Sound") then
			object:Destroy()
		end
	end
	rig.Parent = world
	pcall(function() rig:PivotTo(CFrame.Angles(0, math.pi, 0)) end)

	local cframe, size = rig:GetBoundingBox()
	local view = viewport.AbsoluteSize
	local aspect = (view.X > 0 and view.Y > 0) and view.X / view.Y or 0.75
	local span = math.max(size.Y, math.max(size.X, size.Z) / aspect)
	camera.CFrame = CFrame.new(cframe.Position + Vector3.new(0, 0, span / 2 / math.tan(math.rad(15)) * 1.3), cframe.Position)
	return rig
end

function Preview.update()
	local ui, viewport, api = Preview.ui, Preview.viewport, Preview.api
	if not (ui and viewport and viewport.Parent) then return end
	local mainFrame = Neverlose.window and Neverlose.window.GetMainFrame and Neverlose.window:GetMainFrame()
	if mainFrame and not mainFrame.Visible then return end

	local node = viewport
	while node and not node:IsA("LayerCollector") do
		if node:IsA("GuiObject") and not node.Visible then return end
		node = node.Parent
	end
	local size = viewport.AbsoluteSize
	if size.X < 10 then return end
	if os.clock() - (Preview.lastAt or 0) < 1 / 30 then return end
	Preview.lastAt = os.clock()

	local itemsCard = viewport.Parent and viewport.Parent:FindFirstChild("ESPItems")
	ui.layer.Visible = not (itemsCard and itemsCard.Visible)

	local camera = viewport.CurrentCamera
	local world = viewport:FindFirstChildOfClass("WorldModel")
	local model = world and world:FindFirstChildOfClass("Model")
	if world and camera and not model then model = Preview.standIn(world, camera, viewport) end
	if not (camera and model) then return end

	local config = Neverlose.config.esp
	local team = api:GetTeam() == "Teammates" and "Teammates" or "Enemies"
	local isEnemy = team == "Enemies"
	local colors = config.colors[team]

	local signature = table.concat({ team, tostring(model), tostring(config.enemyModel.player.mode), tostring(config.enemyModel.player.color),
		tostring(config.enemyModel.walls.mode), tostring(config.enemyModel.walls.color), config.localModel.model, tostring(config.localModel.modelColor),
		tostring(config.teamModel.player.mode), tostring(config.teamModel.player.color) }, "|")
	local repaint = Preview.signature ~= signature
	Preview.signature = signature
	if Preview.lastModel ~= model then
		Preview.lastModel, repaint = model, true
		Preview.bodyState = nil
		table.clear(originals)
	end
	if isEnemy then
		if repaint then paintModel(model, config.enemyModel.player, config.enemyModel.walls) end
	else
		local localStyle = config.localModel.model
		local style = localStyle ~= "Default" and { mode = localStyle, color = config.localModel.modelColor } or config.teamModel.player
		if repaint then paintModel(model, style, nil) end
	end

	local minV, maxV = Vector2.new(math.huge, math.huge), Vector2.new(-math.huge, -math.huge)
	local points = {}
	for _, name in ipairs(BODY_PARTS) do
		local part = model:FindFirstChild(name)
		if part then
			local point = project(camera, size, part.Position)
			if point then
				points[name] = point
				minV = Vector2.new(math.min(minV.X, point.X), math.min(minV.Y, point.Y))
				maxV = Vector2.new(math.max(maxV.X, point.X), math.max(maxV.Y, point.Y))
			end
		end
	end
	if minV.X == math.huge then return end
	-- Same box maths as the live ESP: tight corners of the body parts, then padding, fixed size and width scale.
	local position, boxSize
	do
		local cfg = Neverlose.config.esp.colors[api:GetTeam() == "Teammates" and "Teammates" or "Enemies"]
		local rootPart = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
		local headPart = model:FindFirstChild("Head")
		local rootPoint = rootPart and project(camera, size, rootPart.Position)
		local bx0, by0, bx1, by1 = math.huge, math.huge, -math.huge, -math.huge
		if cfg.tightBox ~= false then
			for _, part in ipairs(model:GetDescendants()) do
				if Neverlose.silhouettePart(part) then
					local cf, extent = part.CFrame, Neverlose.partExtents(part) / 2
					for _, sx in ipairs({ -1, 1 }) do
						for _, sy in ipairs({ -1, 1 }) do
							for _, sz in ipairs({ -1, 1 }) do
								local point = project(camera, size, cf * Vector3.new(extent.X * sx, extent.Y * sy, extent.Z * sz))
								if point then
									bx0, bx1 = math.min(bx0, point.X), math.max(bx1, point.X)
									by0, by1 = math.min(by0, point.Y), math.max(by1, point.Y)
								end
							end
						end
					end
				end
			end
		end
		local centerX, centerY
		if bx0 ~= math.huge and bx1 - bx0 > 2 then
			bx0, by0, bx1, by1 = math.floor(bx0), math.floor(by0), math.floor(bx1), math.floor(by1)
			position, boxSize = Vector2.new(bx0, by0), Vector2.new(bx1 - bx0, by1 - by0)
			centerX, centerY = bx0 + (bx1 - bx0) / 2, rootPoint and rootPoint.Y or (by0 + by1) / 2
		else
			local topPoint = project(camera, size, (headPart and headPart.Position or rootPart.Position) + Vector3.new(0, 0.75, 0))
			local bottomPoint = project(camera, size, rootPart.Position - Vector3.new(0, 3, 0))
			if not (topPoint and bottomPoint and rootPoint) then return end
			local height = math.max(bottomPoint.Y - topPoint.Y, 4)
			position, boxSize = Vector2.new(rootPoint.X - height * 0.275, topPoint.Y), Vector2.new(height * 0.55, height)
			centerX, centerY = rootPoint.X, rootPoint.Y
		end
		if cfg.fixedBox == true then
			local fw, fh = math.clamp(cfg.fixedW or 46, 10, 400), math.clamp(cfg.fixedH or 84, 10, 600)
			position, boxSize = Vector2.new(centerX - fw / 2, centerY - fh / 2), Vector2.new(fw, fh)
		else
			local pad = boxSize.Y * math.clamp((cfg.boxPad or 5) / 100, 0, 0.4)
			position = Vector2.new(position.X - pad, position.Y - pad)
			boxSize = Vector2.new(boxSize.X + pad * 2, boxSize.Y + pad * 2)
		end
		local widthScale = math.clamp((cfg.boxWidth or 100) / 100, 0.3, 3)
		if widthScale ~= 1 then
			boxSize = Vector2.new(boxSize.X * widthScale, boxSize.Y)
			position = Vector2.new(centerX - boxSize.X / 2, position.Y)
		end
		if cfg.fixedBox ~= true then
			local minWidth = math.clamp(tonumber(cfg.minWidth) or 18, 0, 200)
			local minHeight = math.clamp(tonumber(cfg.minHeight) or 36, 0, 400)
			local grow = math.clamp(minHeight / math.max(boxSize.Y, 0.001), 1, 1.2)
			if grow > 1 or boxSize.X < minWidth then
				local midX, midY = position.X + boxSize.X / 2, position.Y + boxSize.Y / 2
				boxSize = Vector2.new(math.max(boxSize.X * grow, minWidth), boxSize.Y * grow)
				position = Vector2.new(midX - boxSize.X / 2, midY - boxSize.Y / 2)
			end
		end
	end
	local center = position.X + boxSize.X / 2

	local boxColor, nameColor, skeletonColor, fillColor = colors.box, colors.name, colors.skeleton, colors.fill
	local showBox = item(team, "Main/Bounding Box")
	local style = config.boxStyle
	local pixelBox = showBox and (style == "Pixel" or style == "Pixel Filled")
	local classicBox = showBox and (style == "Classic" or style == "Classic Filled")
	local referenceBox = showBox and (style == "Reference" or style == "Reference Filled")
	local boxRadius = 0
	local corners = showBox and (style == "Corners" or (referenceBox and boxRadius == 0))
	local plain = showBox and style ~= "Corners"
	local filled = showBox and (style == "Filled" or style == "Pixel Filled" or style == "Classic Filled" or style == "Reference Filled")
	local cell = math.clamp(math.floor(colors.boxThick or 2), 1, 4)
	if pixelBox or classicBox or referenceBox then
		position = Vector2.new(math.floor(position.X / cell + 0.5) * cell, math.floor(position.Y / cell + 0.5) * cell)
		boxSize = Vector2.new(math.max(math.floor(boxSize.X / cell + 0.5), 8) * cell, math.max(math.floor(boxSize.Y / cell + 0.5), 10) * cell)
	end
	ui.box.Position, ui.box.Size = UDim2.fromOffset(position.X, position.Y), UDim2.fromOffset(boxSize.X, boxSize.Y)
	ui.boxOutline.Position, ui.boxOutline.Size = UDim2.fromOffset(position.X - 1, position.Y - 1), UDim2.fromOffset(boxSize.X + 2, boxSize.Y + 2)
	ui.boxOutline.Visible = plain and (colors.outline or classicBox) and not referenceBox
	ui.outlineStroke.Color = colors.outlineColor
	ui.outlineStroke.Thickness = cell + 1
	ui.boxStroke.Color = boxColor
	ui.boxStroke.Thickness = pixelBox and cell + 1 or cell
	ui.boxStroke.Transparency = (referenceBox and boxRadius == 0) and 0.65 or 0
	ui.boxStroke.Enabled = plain
	ui.boxCorner = ui.boxCorner or newInstance("UICorner", {}, ui.box)
	ui.outlineCorner = ui.outlineCorner or newInstance("UICorner", {}, ui.boxOutline)
	ui.boxCorner.CornerRadius, ui.outlineCorner.CornerRadius = UDim.new(0, boxRadius), UDim.new(0, boxRadius)
	ui.boxStroke.LineJoinMode = boxRadius > 0 and Enum.LineJoinMode.Round or Enum.LineJoinMode.Miter
	ui.outlineStroke.LineJoinMode = ui.boxStroke.LineJoinMode
	local fillAlpha = 1 - math.clamp((colors.fillAlpha or 26) / 100, 0.05, 0.8)
	ui.box.BackgroundColor3 = filled and fillColor or boxColor
	ui.box.BackgroundTransparency = filled and fillAlpha or 1
	local gradDir = colors.boxGradDir or "Vertical"
	ui.boxGradient.Rotation = gradDir == "Horizontal" and 0 or gradDir == "Diagonal" and 45 or 90
	local mix = math.clamp((colors.gradMix or 50) / 100, 0.05, 0.95)
	ui.boxGradient.Enabled = (filled and colors.fillGradient) or (plain and colors.boxGradient) or false
	if ui.boxGradient.Enabled then
		ui.box.BackgroundColor3 = Color3.new(1, 1, 1)
		local first, second = filled and fillColor or boxColor, filled and colors.fill2 or colors.box2
		ui.boxGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, first), ColorSequenceKeypoint.new(mix, first:Lerp(second, 0.5)), ColorSequenceKeypoint.new(1, second),
		})
