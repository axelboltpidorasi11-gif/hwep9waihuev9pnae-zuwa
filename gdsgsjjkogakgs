BodyMat = {}

function BodyMat.one(store, object, material, color, alpha)
	if object:IsA("BasePart") then
		local saved = store[object]
		if not saved then
			if object.Name == "HumanoidRootPart" or object.Transparency >= 0.99 then return end
			saved = { Material = object.Material, Color = object.Color, Transparency = object.Transparency }
			if object:IsA("MeshPart") then saved.TextureID = object.TextureID end
			store[object] = saved
		end
		local original = saved.Color
		local shade = math.clamp(0.5 + 0.9 * (original.R * 0.3 + original.G * 0.59 + original.B * 0.11), 0.4, 1.15)
		object.Material = material
		object.Color = Color3.new(math.min(color.R * shade, 1), math.min(color.G * shade, 1), math.min(color.B * shade, 1))
		if object:IsA("MeshPart") then object.TextureID = "" end
		object.Transparency = alpha and math.max(saved.Transparency, alpha) or saved.Transparency
	elseif object:IsA("Decal") or object:IsA("Texture") then
		if not store[object] then store[object] = { Transparency = object.Transparency } end
		object.Transparency = 1
	elseif object:IsA("SpecialMesh") then
		if not store[object] then store[object] = { MeshTexture = object.TextureId } end
		object.TextureId = ""
	elseif object:IsA("SurfaceAppearance") or object:IsA("Clothing") or object:IsA("ShirtGraphic") then
		if not store[object] then store[object] = { Parent = object.Parent } end
		object.Parent = nil
	end
end

function BodyMat.scan(store, model, material, color, alpha)
	BodyMat.one(store, model, material, color, alpha)
	for _, object in ipairs(model:GetDescendants()) do BodyMat.one(store, object, material, color, alpha) end
end

function BodyMat.restore(store)
	for object, saved in pairs(store) do
		pcall(function()
			if saved.Parent then
				object.Parent = saved.Parent
			elseif saved.MeshTexture ~= nil then
				object.TextureId = saved.MeshTexture
			elseif saved.Material then
				object.Material, object.Color, object.Transparency = saved.Material, saved.Color, saved.Transparency
				if saved.TextureID ~= nil then object.TextureID = saved.TextureID end
			elseif saved.Transparency ~= nil then
				object.Transparency = saved.Transparency
			end
		end)
	end
	table.clear(store)
end

function BodyMat.drive(state, model, style, color)
	if not (style and style.material and model) then
		if state.key then
			BodyMat.restore(state.store)
			state.key, state.char = nil, nil
		end
		return
	end
	local key = tostring(style.material) .. "|" .. tostring(color)
	if state.key ~= key or state.char ~= model then
		BodyMat.restore(state.store)
		state.key, state.char, state.scan = key, model, 0
	end
	local now = os.clock()
	if now - state.scan > 1.5 then
		state.scan = now
		BodyMat.scan(state.store, model, style.material, color, style.alpha)
	end
end

local iconCache = {}
local function iconAsset(value)
	if value == nil then return "" end
	local text = tostring(value)
	if text == "" then return "" end
	if text:find("rbxasset", 1, true) or text:find("rbxthumb", 1, true) or text:find("https://", 1, true) then return text end
	local digits = text:match("%d+")
	return digits and ("rbxassetid://" .. digits) or ""
end
local function iconFromEntry(entry)
	if type(entry) ~= "table" then return nil, nil end
	local asset = iconAsset(entry.image)
	if asset == "" and type(entry.wearImages) == "table" then
		local wear = entry.wearImages[1]
		asset = iconAsset(type(wear) == "table" and wear.assetId or wear)
	end
	if asset == "" then return nil, nil end
	return asset, entry.skin
end
local function iconFromList(list)
	if type(list) ~= "table" then return "" end
	local first
	for _, entry in pairs(list) do
		local asset, skin = iconFromEntry(entry)
		if asset then
