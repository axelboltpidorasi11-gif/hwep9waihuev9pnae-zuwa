---Rising soul: a bright core drifts up on a slow spiral with a ghost tail, two wisps wind
---around it leaving spark trails, a sigil fades on the floor, and the soul bursts into sparks.
function HitEffects.soul(position, color)
	local floor = HitEffects.floorBelow(position)
	local hot = color:Lerp(Color3.new(1, 1, 1), 0.65)
	local deep = color:Lerp(Color3.new(0, 0, 0), 0.3)
	local duration = 2.4
	local fade = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.55, 0.4), NumberSequenceKeypoint.new(1, 1) })

	-- Floor sigil and the first flash.
	pcall(HitEffects.sprite, floor + Vector3.new(0, 0.12, 0), color, 13, 1.5, GLOW_TEXTURE, false)
	pcall(HitEffects.sprite, position, hot, 9, 0.45, GLOW_TEXTURE, true)
	HitEffects.floorRing(floor, hot, 0.8, 8, 0.8)
	HitEffects.floorRing(floor, color, 0.5, 13, 1.3, 0.14)
	HitEffects.floorRing(floor, deep, 0.5, 18, 1.7, 0.3)

	local anchors, parts, pumps = {}, {}, {}
	local function anchor()
		local part = newInstance("Part", {
			Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
			Size = Vector3.one, CFrame = CFrame.new(position),
		}, effectsFolder)
		table.insert(anchors, part)
		return part
	end
	local function pump(part, props, rate)
		props.Rate = 0
		local emitter = newInstance("ParticleEmitter", props, part)
		table.insert(pumps, { emitter = emitter, rate = rate, carry = 0 })
	end
	local function ball(size, tint, transparency)
		local part = HitEffects.glow(CFrame.new(position), Vector3.one * size, tint, Enum.PartType.Ball, transparency)
		table.insert(parts, part)
		return part
	end

	local coreAnchor = anchor()
	pump(coreAnchor, {
		Texture = "rbxassetid://131064608749055", Color = ColorSequence.new(color), LightEmission = 1,
		Lifetime = NumberRange.new(1.1, 1.7), Speed = NumberRange.new(0.5, 2), SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 1.5, 0), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-50, 50),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0.1) }), Transparency = fade,
	}, 26)
	pump(coreAnchor, {
		Texture = SPARK_TEXTURE, Color = ColorSequence.new(hot), LightEmission = 1,
		Lifetime = NumberRange.new(0.6, 1.1), Speed = NumberRange.new(1, 4), SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 2, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) }), Transparency = fade,
	}, 40)
	pump(coreAnchor, {
		Texture = GLOW_TEXTURE, Color = ColorSequence.new(color), LightEmission = 1,
		Lifetime = NumberRange.new(0.35, 0.35), Speed = NumberRange.new(0, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3.2), NumberSequenceKeypoint.new(1, 0.6) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
	}, 14)

	local core = ball(0.75, hot, 0)
	local shell = ball(1.5, color, 0.7)
	local tail = {}
	for index = 1, 5 do tail[index] = ball(0.55 * (1 - index / 6), color, 0.25 + index * 0.12) end
	local orbs = {}
	for index = 1, 2 do
		local orbAnchor = anchor()
		pump(orbAnchor, {
			Texture = SPARK_TEXTURE, Color = ColorSequence.new(index == 1 and hot or color), LightEmission = 1,
			Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(0, 0.6),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) }), Transparency = fade,
		}, 36)
		orbs[index] = { anchor = orbAnchor, part = ball(0.3, index == 1 and hot or color, 0) }
	end

	local function pathAt(age)
		local progress = math.clamp(age / duration, 0, 1)
		local lift = 11 * (1 - (1 - progress) ^ 2)
		local radius = 0.9 * math.sin(progress * math.pi)
		local angle = age * 2.4
		return position + Vector3.new(math.cos(angle) * radius, lift, math.sin(angle) * radius)
	end

	local last, head = 0, position
	HitEffects.animate(duration, function(t, age)
		local step = math.min(age - last, 0.1)
		last = age
		head = pathAt(age)
		local dissolve = math.clamp((t - 0.78) / 0.22, 0, 1)
		local keep = 1 - dissolve

		local pulse = 1 + 0.12 * math.sin(age * 12)
		core.CFrame, core.Size, core.Transparency = CFrame.new(head), Vector3.one * math.max(0.05, 0.75 * pulse * keep), dissolve
		shell.CFrame, shell.Size, shell.Transparency = CFrame.new(head), Vector3.one * math.max(0.05, 1.5 * pulse * keep), math.min(1, 0.7 + dissolve)
		coreAnchor.CFrame = CFrame.new(head)
		for index, part in ipairs(tail) do
			part.CFrame = CFrame.new(pathAt(math.max(age - index * 0.07, 0)))
			part.Size = Vector3.one * math.max(0.05, 0.55 * (1 - index / 6) * keep)
			part.Transparency = math.min(1, 0.25 + index * 0.12 + dissolve)
		end
		for index, orb in ipairs(orbs) do
			local angle = age * 5.2 + index * math.pi
			local radius = 0.5 + 1.3 * math.sin(t * math.pi)
			local spot = head + Vector3.new(math.cos(angle) * radius, math.sin(age * 3.4 + index * 2) * 0.7, math.sin(angle) * radius)
			orb.part.CFrame, orb.anchor.CFrame = CFrame.new(spot), CFrame.new(spot)
			orb.part.Size, orb.part.Transparency = Vector3.one * math.max(0.05, 0.3 * keep), dissolve
		end
		for _, entry in ipairs(pumps) do
			entry.carry += entry.rate * step * (1 - dissolve * 0.8)
			local count = math.floor(entry.carry)
			if count > 0 then
				entry.carry -= count
				entry.emitter:Emit(math.min(count, 12))
			end
		end
	end, function()
		for _, part in ipairs(parts) do part:Destroy() end
		local finale = newInstance("ParticleEmitter", {
			Texture = SPARK_TEXTURE, Color = ColorSequence.new(hot), LightEmission = 1, Rate = 0, Drag = 2,
			Lifetime = NumberRange.new(0.6, 1.2), Speed = NumberRange.new(6, 14), SpreadAngle = Vector2.new(180, 180),
			Acceleration = Vector3.new(0, 3, 0),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		}, coreAnchor)
		finale:Emit(40)
		pcall(HitEffects.sprite, head, hot, 8, 0.5, GLOW_TEXTURE, true)
		pcall(HitEffects.sprite, head, Color3.new(1, 1, 1), 3, 0.25, GLOW_TEXTURE, true)
		task.delay(1.8, function()
			for _, part in ipairs(anchors) do part:Destroy() end
		end)
	end)
end

