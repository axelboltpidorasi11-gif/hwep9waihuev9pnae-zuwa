		{ "Utility", "Utility", { "grenade", "flash", "smoke", "molotov", "decoy", "explo", "bomb", "c4", "defus", "plant", "throw" } },
		{ "Reload", "Utility", { "reload", "magazine", "magin", "magout", "clip", "cock", "slide", "bolt", "equip", "draw" } },
		{ "Shot", "Shots", { "shoot", "shot", "fire", "gun", "bang", "rifle", "pistol", "smg", "awp", "deagle", "knife", "slash", "stab", "tap" } },
	}

	local function classify(text)
		text = tostring(text or ""):lower()
		for _, kind in ipairs(KINDS) do
			for _, word in ipairs(kind[3]) do
				if text:find(word, 1, true) then return kind[1], kind[2] end
			end
		end
		return "Sound", "Other"
	end

