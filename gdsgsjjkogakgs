			Texture = spec.texture, Color = ColorSequence.new(spec.color), LightEmission = spec.emission or 1, Rate = 0,
			Lifetime = spec.lifetime, Speed = spec.speed, SpreadAngle = spec.spread or Vector2.new(180, 180),
			Acceleration = spec.acceleration or Vector3.zero, Drag = spec.drag or 0, Rotation = NumberRange.new(0, 360),
			RotSpeed = spec.rotSpeed or NumberRange.new(-80, 80), Size = spec.size,
			Transparency = spec.transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0.35), NumberSequenceKeypoint.new(1, 1) }),
		}, anchor)
		if spec.direction then emitter.EmissionDirection = spec.direction end
		if spec.orientation then pcall(function() emitter.Orientation = spec.orientation end) end
		if spec.zOffset then emitter.ZOffset = spec.zOffset end
		emitter:Emit(spec.count)
	end
	task.delay(life or 2.5, function() pcall(function() anchor:Destroy() end) end)
