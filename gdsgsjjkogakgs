-- Fake Ping: меняет только число пинга (таблица игроков и ватермарк), сеть не трогает.
do
	local labels, scannedAt = {}, 0
	function Neverlose.fakePingValue()
		local features = Neverlose.config and Neverlose.config.features
		if features and features.fakePing then return math.clamp(math.floor(tonumber(features.fakePingMs) or 60), 0, 999) end
		return nil
	end
	local function pingStep()
		local value = Neverlose.fakePingValue()
		if not value then
			if next(labels) then
				table.clear(labels)
				scannedAt = 0
			end
			return
		end
		local now = os.clock()
		if now - scannedAt > 0.4 then
			scannedAt = now
			table.clear(labels)
			pcall(function()
				local mine = { localPlayer.Name:lower() }
				if localPlayer.DisplayName ~= "" then mine[#mine + 1] = localPlayer.DisplayName:lower() end
				local function collect(root)
					for _, label in ipairs(root:GetDescendants()) do
						if label.Name == "Ping" and label:IsA("TextLabel") then
							local holder = label.Parent
							for _ = 1, 2 do
								local nameLabel = holder and holder:FindFirstChild("PlayerName")
								if nameLabel and nameLabel:IsA("TextLabel") then
									local text = nameLabel.Text:gsub("<[^>]+>", ""):lower()
									for _, who in ipairs(mine) do
										if text:find(who, 1, true) then labels[#labels + 1] = label break end
									end
									break
								end
								holder = holder and holder.Parent
							end
						end
					end
				end
				local gui = localPlayer.PlayerGui
				local board = gui.MainGui.Gameplay.Middle:FindFirstChild("Leaderboard")
				if board then collect(board) end
				-- своей строки нет в таблице: ищем такую же пару во всём интерфейсе (другие экраны со счётом)
				if #labels == 0 then collect(gui) end
			end)
		end
		for _, label in ipairs(labels) do
			if label.Parent and label.Text ~= tostring(value) then label.Text = tostring(value) end
		end
		-- игра хранит пинг игрока атрибутом Ping; локальная подмена не уходит на сервер
		if localPlayer:GetAttribute("Ping") ~= value then pcall(localPlayer.SetAttribute, localPlayer, "Ping", value) end
	end
	maid:give(runService.Heartbeat:Connect(pingStep))
	maid:give(runService.RenderStepped:Connect(pingStep))
end

-- The game's own client gates (pull-out time, action lockout) are lowered while Fast Equip is on, so manual shots are allowed at once too.
do
	local timings
	pcall(function() timings = require(replicatedStorage.Components.Common.WeaponTimings) end)
	if type(timings) == "table" then
		local original = {
			EQUIP_PULLOUT_FRACTION = timings.EQUIP_PULLOUT_FRACTION,
			DEFAULT_EQUIP_PULLOUT = timings.DEFAULT_EQUIP_PULLOUT,
			EQUIP_ACTION_LOCKOUT = timings.EQUIP_ACTION_LOCKOUT,
		}
		local function write(key, value)
			if timings[key] == value then return end
			local frozen = isreadonly and isreadonly(timings)
			if frozen and setreadonly then setreadonly(timings, false) end
			pcall(rawset, timings, key, value)
			if frozen and setreadonly then setreadonly(timings, true) end
		end
		local function apply()
			local features = Neverlose.config and Neverlose.config.features
			if not features then return end
			if features.fastEquip ~= false then
				local skip = features.equipSkip
				write("EQUIP_PULLOUT_FRACTION", skip and 0 or original.EQUIP_PULLOUT_FRACTION * math.clamp((features.equipReady or 100) / 100, 0.1, 1) / math.max(features.equipSpeed or 1, 1) ^ 0.5)
				write("DEFAULT_EQUIP_PULLOUT", skip and 0 or original.DEFAULT_EQUIP_PULLOUT * math.clamp((features.equipReady or 100) / 100, 0.1, 1) / math.max(features.equipSpeed or 1, 1) ^ 0.5)
				write("EQUIP_ACTION_LOCKOUT", skip and 0 or original.EQUIP_ACTION_LOCKOUT / math.max(features.equipSpeed or 1, 1))
			else
				for key, value in pairs(original) do write(key, value) end
			end
		end
		maid:give(runService.Heartbeat:Connect(apply))
		maid:give(function() for key, value in pairs(original) do write(key, value) end end)
	end
end

