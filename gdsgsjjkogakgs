function Legit.visiblePoint(part, origin, condition)
	local center = part.Position
	if condition == "Through Walls" or not blockedBetween(origin, center) then return center end
	local half = part.Size * 0.42
	local frame = part.CFrame
	for _, offset in ipairs({ Vector3.new(half.X, 0, 0), Vector3.new(-half.X, 0, 0), Vector3.new(0, half.Y, 0), Vector3.new(0, -half.Y, 0) }) do
		local point = frame * offset
		if not blockedBetween(origin, point) then return point end
	end
	return nil
end

function Legit.scan(partNames, fovDegrees, condition, minDamage, only)
	local weapon = Game.weapon()
	local properties = weapon and weapon.Properties
	local origin = currentCamera.CFrame.Position
	local look = currentCamera.CFrame.LookVector
	local bestPart, bestPoint, bestCharacter, bestAngle = nil, nil, nil, math.rad(fovDegrees)

	for _, entity in ipairs(Game.entities()) do
		if Game.isEnemy(entity, true) then
			local character = Game.character(entity)
			if character and (not only or character == only) and not Game.isImmune(character) then
				for _, name in ipairs(partNames) do
					local part = character:FindFirstChild(name)
					if part then
						local offset = part.Position - origin
						local angle = math.acos(math.clamp(look:Dot(offset.Unit), -1, 1))
						if angle < bestAngle then
							local point = Legit.visiblePoint(part, origin, condition)
							if point and not (condition == "Visible Only" and Ballistics.throughSmoke(origin, point)) then
								local walls, penalty = 0, nil
								if condition == "Through Walls" then
									local _, _, wallCount, wallPenalty = Ballistics.trace(origin, offset.Unit, offset.Magnitude + 2, character, 4)
									walls, penalty = wallCount, wallPenalty
								end
								local damage = properties and Ballistics.damage(properties, name, offset.Magnitude, walls, character, penalty) or math.huge
								if damage >= math.min(minDamage, character:GetAttribute("Health") or 100) then
									bestPart, bestPoint, bestCharacter, bestAngle = part, point, character, angle
								end
							end
						end
					end
				end
			end
		end
	end

	return bestPart, bestPoint, bestCharacter
end

local scopeRequestedAt = 0
local function ensureScoped(weapon, delayMs)
	if not Game.isSniper(weapon) then return true end
	if weapon.IsSniperScoped or (weapon.CurrentScopeIncrement or 0) > 0 then
		return os.clock() - scopeRequestedAt >= delayMs / 1000
	end
	if os.clock() - scopeRequestedAt > 0.4 and mouse2click then
		mouse2click()
		scopeRequestedAt = os.clock()
	end
	return false
end

