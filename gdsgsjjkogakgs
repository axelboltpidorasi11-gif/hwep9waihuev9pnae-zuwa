	styleText(ui.name, "nameFont", "nameSize", "glowName", 12)
	styleText(ui.distance, "distanceFont", "distanceSize", "glowDistance", 11)
	styleText(ui.weapon, "weaponFont", "weaponSize", "glowWeapon", 11)
	styleText(ui.flags, "flagsFont", "flagsSize", "glowFlags", 11)
	styleText(ui.aim, "aimFont", "aimSize", "glowAim", 11)
	styleText(ui.healthText, "healthTextFont", "healthTextSize", "glowHealthText", 11)
	ui.name.Visible = item(team, "Main/Name")
