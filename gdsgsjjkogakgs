local function stripComments(src)
	local out, i, n = {}, 1, #src
	local function pushLine()
		local nl = src:find("\n", i, true)
		local stop = nl and (nl - 1) or n
		local trimmed = src:sub(i, stop):match("^[ \t]*(.-)[ \t]*$")
		if trimmed ~= "" then out[#out + 1] = trimmed end
		if nl then
			out[#out + 1] = "\n"
			i = nl + 1
		else
			i = n + 1
		end
	end
	while i <= n do
		local c = src:sub(i, i)
		if src:sub(i, i + 1) == "--" then
			local eq = src:match("^%-%-%[(=*)%[", i)
			if eq then
				local close = "]" .. eq .. "]"
				local stop = src:find(close, i, true)
				i = stop and (stop + #close) or (n + 1)
			else
				i = src:find("\n", i, true) or (n + 1)
			end
		elseif c == '"' or c == "'" then
			local start = i
			i = i + 1
			while i <= n do
				local ch = src:sub(i, i)
				if ch == "\\" then
					i = i + 2
				elseif ch == c then
					i = i + 1
					break
				elseif ch == "\n" then
					break
				else
					i = i + 1
				end
			end
			out[#out + 1] = src:sub(start, i - 1)
		elseif c == "[" and src:match("^%[(=*)%[", i) then
			local eq = src:match("^%[(=*)%[", i)
			local token = "]" .. eq .. "]"
			local closeStart = src:find(token, i + #eq + 2, true)
			local stop = closeStart and (closeStart + #token - 1) or n
			out[#out + 1] = src:sub(i, stop)
			i = stop + 1
		else
			pushLine()
		end
	end
	return table.concat(out)
end

function Menu.loadLibrary()
	local source
	if isfile and readfile and isfile(LIBRARY_FILE) then
		source = readfile(LIBRARY_FILE)
	else
		source = game:HttpGet(LIBRARY_URL)
	end

	-- A swapped or truncated library is refused before it is ever executed.
	if type(source) ~= "string" or #source < 100000 or not source:find("AddPage", 1, true) or not source:find("AddDropdown", 1, true) then
		error("library failed validation")
	end

	local function replaceOnceEarly(text, old, new)
		local from, to = text:find(old, 1, true)
		if not from then return text end
