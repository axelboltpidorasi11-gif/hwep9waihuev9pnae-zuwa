AntiAim.manualOn, AntiAim.manualOrder = { Left = false, Right = false, Back = false }, {}

function AntiAim.setManual(direction, on)
	AntiAim.manualOn[direction] = on == true
	local order = AntiAim.manualOrder
	for index = #order, 1, -1 do
		if order[index] == direction then table.remove(order, index) end
	end
	if on then order[#order + 1] = direction end

	AntiAim.manual = nil
	for index = #order, 1, -1 do
		if AntiAim.manualOn[order[index]] then
			AntiAim.manual = order[index]
			break
		end
	end
	if AntiAim.onManual then pcall(AntiAim.onManual) end
