do
	-- Gear strip in place of the "(@username)" part of each living player's name in the game's scoreboard.
	local icons, holders, labels = {}, setmetatable({}, { __mode = "k" }), {}
	local labelsAt, lastGear, needRefresh = 0, 0, false
	local ICON_H = 16
	local SLOT_KEYS = { Slot1 = "primary", Slot2 = "secondary", Slot3 = "knife", Slot4 = "grenade" }
	local equipmentIcons

	local function weaponIcon(name)
		local cached = icons[name]
		if cached ~= nil then return cached or nil end
		local weapons = replicatedStorage:FindFirstChild("Database")
		weapons = weapons and weapons:FindFirstChild("Custom")
		weapons = weapons and weapons:FindFirstChild("Weapons")
		local module = weapons and weapons:FindFirstChild(name)
		local image
		if module and module:IsA("ModuleScript") then
			local ok, data = pcall(require, module)
			if ok and type(data) == "table" and type(data.Icon) == "string" and data.Icon ~= "" then image = data.Icon end
		end
		icons[name] = image or false
		return image
	end

	local function equipmentIcon(name)
		if not equipmentIcons then
			equipmentIcons = {}
			pcall(function()
				local stats = require(replicatedStorage.Database.Custom.GameStats)
				for key, data in pairs(stats.Equipment or {}) do
					if type(data) == "table" and data.Icon then equipmentIcons[key] = data.Icon end
				end
			end)
		end
		return equipmentIcons[name]
	end

	local function numeric(value)
		if type(value) == "number" then return "rbxassetid://" .. math.floor(value) end
		return value
	end

	local function iconObject(holder, key, order)
		local object = holder:FindFirstChild(key)
		if object then return object end
		return newInstance("ImageLabel", { Name = key, LayoutOrder = order, Size = UDim2.fromOffset(ICON_H * 2, ICON_H), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, ZIndex = holder.ZIndex + 1 }, holder)
	end

	local function textObject(holder, key, order)
		local object = holder:FindFirstChild(key)
		if object then return object end
		return newInstance("TextLabel", {
			Name = key, LayoutOrder = order, Size = UDim2.fromOffset(0, ICON_H), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Color3.new(1, 1, 1), ZIndex = holder.ZIndex + 1,
		}, holder)
	end

	local function holderFor(label)
		local holder = label:FindFirstChild("NLGear")
		if holder then return holder end
		holder = newInstance("Frame", {
			Name = "NLGear", BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 1, BorderSizePixel = 0,
			Size = UDim2.fromOffset(0, ICON_H + 4), AutomaticSize = Enum.AutomaticSize.X, ZIndex = label.ZIndex + 20,
		}, label)
		newInstance("UICorner", { CornerRadius = UDim.new(0, 4) }, holder)
		newInstance("UIStroke", { Color = Color3.fromRGB(70, 70, 86), Transparency = 0.5, Thickness = 1 }, holder)
		newInstance("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, holder)
		newInstance("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, holder)
		newInstance("UIScale", {}, holder)
		return holder
	end

	local function restore(label)
		local user = label:GetAttribute("NLUser")
		local full = label:GetAttribute("NLFull")
		if user and full and label.Text == label:GetAttribute("NLShown") then label.Text = full end
		label:SetAttribute("NLUser", nil)
		label:SetAttribute("NLFull", nil)
		label:SetAttribute("NLShown", nil)
	end

	local function hideAll()
		for holder in pairs(holders) do
			if holder.Parent then
				holder.Visible = false
				local label = holder.Parent
				if label:GetAttribute("NLFull") then restore(label) end
			end
		end
	end

	local function moneyLeft(label)
		local row = label.Parent
		local money = row and row:FindFirstChild("Money")
		if money and money:IsA("GuiObject") then return money.AbsolutePosition.X end
		return label.AbsolutePosition.X + label.AbsoluteSize.X
	end

	local function update()
		local gear = Neverlose.config.hud.gear
		local frame = localPlayer:FindFirstChildOfClass("PlayerGui")
		for _, name in ipairs({ "MainGui", "Gameplay", "Middle", "Leaderboard" }) do frame = frame and frame:FindFirstChild(name) end
		if not frame or not gear or not gear.enabled or not frame.Visible then return hideAll() end

		local now = os.clock()
		if now - labelsAt > 2 or needRefresh then
			labelsAt, needRefresh = now, false
			table.clear(labels)
			for _, object in ipairs(frame:GetDescendants()) do
				if object.Name == "PlayerName" and object:IsA("TextLabel") then labels[#labels + 1] = object end
			end
		end
		local byName, byDisplay, clash = {}, {}, {}
		for _, entity in ipairs(Game.entities()) do
			byName[tostring(entity.Name)] = entity
			local display = tostring(entity.DisplayName or entity.Name)
			if byDisplay[display] then clash[display] = true end
			byDisplay[display] = tostring(entity.Name)
		end
		for display in pairs(clash) do byDisplay[display] = nil end

		for _, label in ipairs(labels) do
			if label.Parent then
				local holder = holderFor(label)
				holders[holder] = true
				local username = label:GetAttribute("NLUser")
				if not username or label.Text ~= label:GetAttribute("NLShown") then
					username = nil
					local text = label.Text
					local display, user = text:match("^(.-)%s*%(@(.-)%)%s*$")
					if user then
						username = user
						label:SetAttribute("NLUser", user)
						label:SetAttribute("NLFull", text)
						if gear.hideName then
							text = display ~= "" and display or user
							label.Text = text
						end
						label:SetAttribute("NLShown", text)
					else
						local plain = text:match("^%s*(.-)%s*$")
						local match = byName[plain] and plain or byDisplay[plain]
						if match then
							username = match
							label:SetAttribute("NLUser", match)
							label:SetAttribute("NLFull", text)
							label:SetAttribute("NLShown", text)
						end
					end
				end
				if username and label:GetAttribute("NLFull") ~= label:GetAttribute("NLShown") and not gear.hideName and label.Text == label:GetAttribute("NLShown") then
					label.Text = label:GetAttribute("NLFull")
					label:SetAttribute("NLShown", label.Text)
				elseif username and gear.hideName and label.Text == label:GetAttribute("NLFull") and label.Text:find("%(@") then
					local display = label.Text:match("^(.-)%s*%(@")
					label.Text = (display and display ~= "") and display or username
					label:SetAttribute("NLShown", label.Text)
				end

				local entity = username and byName[username]
				if not entity or Neverlose.isDown(entity) then
					holder.Visible = false
				else
					local order = 0
					local shown = 0
					local held = Game.equipped(entity)
					local attributes = {}
					for slot = 1, 8 do
						local value = entity:GetAttribute("Slot" .. slot)
						if value ~= nil then attributes["Slot" .. slot] = value end
					end
					local used = {}
					for _, kind in ipairs({ "primary", "secondary", "knife", "grenade" }) do
						if gear[kind] then
							local keys = {}
							for key, role in pairs(attributes) do
								if type(key) == "string" and key:match("^Slot%d+$") then keys[#keys + 1] = key end
							end
							table.sort(keys)
							for _, key in ipairs(keys) do
								if SLOT_KEYS[key] == kind or (kind == "grenade" and not SLOT_KEYS[key]) then
									local data = attributes[key]
									local weapon
									if type(data) == "string" then
										local ok, decoded = pcall(function() return httpService:JSONDecode(data) end)
										weapon = ok and type(decoded) == "table" and decoded.Weapon or nil
									end
									local image = weapon and weaponIcon(weapon)
									order += 1
									local object = iconObject(holder, "Slot_" .. key, order)
									used[object] = true
									if image then
										object.Image, object.Visible = image, true
										object.ImageTransparency = (held and held.Name == weapon) and 0 or 0.45
										shown += 1
									else
										object.Visible = false
									end
								end
							end
						end
					end
					for _, child in ipairs(holder:GetChildren()) do
						if child.Name:match("^Slot_") and not used[child] then child.Visible = false end
					end

					local character = entity.Character
					local armor, helmet = Game.armor(character)
					order += 1
					local armorIcon = iconObject(holder, "Armor", order)
					armorIcon.Size = UDim2.fromOffset(ICON_H, ICON_H)
					local armorType = "Kevlar"
					local rawArmor = entity:GetAttribute("Armor")
					if type(rawArmor) == "string" then
						local ok, decoded = pcall(function() return httpService:JSONDecode(rawArmor) end)
						if ok and type(decoded) == "table" and decoded.Type then armorType = decoded.Type end
					end
					local armorImage = equipmentIcon(armorType) or equipmentIcon(helmet and "Kevlar + Helmet" or "Kevlar")
					armorIcon.Visible = gear.armor and armor > 0 and armorImage ~= nil
					if armorIcon.Visible then armorIcon.Image = numeric(armorImage) shown += 1 end

					order += 1
					local kitIcon = iconObject(holder, "Kit", order)
					kitIcon.Size = UDim2.fromOffset(ICON_H, ICON_H)
					local kitImage = equipmentIcon("Defuse Kit")
					kitIcon.Visible = gear.kit and entity:GetAttribute("HasDefuseKit") == true and kitImage ~= nil
					if kitIcon.Visible then kitIcon.Image = numeric(kitImage) shown += 1 end

					order += 1
					local healthText = textObject(holder, "Health", order)
					local health = character and tonumber(character:GetAttribute("Health"))
					healthText.Visible = gear.health and health ~= nil
					if healthText.Visible then healthText.Text = tostring(math.floor(health + 0.5)) shown += 1 end

					holder.Visible = shown > 0
					if holder.Visible then
						local textWidth = math.min(label.TextBounds.X, label.AbsoluteSize.X)
						holder.Position = UDim2.fromOffset(textWidth + 8, (label.AbsoluteSize.Y - (ICON_H + 4)) / 2)
						local scale = holder:FindFirstChildOfClass("UIScale")
						scale.Scale = 1
						local available = moneyLeft(label) - (label.AbsolutePosition.X + textWidth + 8) - 6
						local width = holder.AbsoluteSize.X
						if width > 0 and available > 0 and width > available then scale.Scale = math.max(available / width, 0.4) end
						if available <= 0 then holder.Visible = false end
					end
				end
			end
		end
	end

