		local stats = Neverlose.soundStats
		stats.received += 1
		stats.groups[group] = (stats.groups[group] or 0) + 1
		local filter = esp.soundKinds
		local allowed = filter == nil or filter == "All" or filter == group
		if type(filter) == "table" then
			allowed = #filter == 0 or table.find(filter, "All") ~= nil or table.find(filter, group) ~= nil
		end
		if group == "Other" or not allowed then
			stats.filtered += 1
