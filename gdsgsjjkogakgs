						Neverlose.stats = Neverlose.stats or {}
						Neverlose.stats.badBullet = (Neverlose.stats.badBullet or 0) + 1
					end
				end
			end)

			Events.fire("shot", payload)
			return callOriginal(payload, ...)
		end
	end)
end

