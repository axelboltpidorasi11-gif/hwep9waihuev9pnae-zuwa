local SHADING = Enum.AdornShading and Enum.AdornShading.XRay
local CULLING = Enum.AdornCullingMode and Enum.AdornCullingMode.Never

local function host()
	if Xray.folder and Xray.folder.Parent == currentCamera and Xray.anchor and Xray.anchor.Parent then return end
	if Xray.folder then pcall(function() Xray.folder:Destroy() end) end
	Xray.folder = newInstance("Folder", { Name = randomName() }, currentCamera)
