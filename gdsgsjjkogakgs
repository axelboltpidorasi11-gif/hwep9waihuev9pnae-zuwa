			if AntiAim then AntiAim.setManual(direction, on) end
		end)
		manualToggles[direction] = toggle
		hk["Manual " .. direction] = toggle
	end
	if AntiAim then
		AntiAim.onManual = function()
			for direction, toggle in pairs(manualToggles) do
				if toggle:Get() ~= AntiAim.manualOn[direction] then toggle:Set(AntiAim.manualOn[direction], true) end
			end
		end
	end
	RageAntiAim:AddToggle("Manual Arrows", aa.indicator, set(aa, "indicator"))
	local YAW_MODES = { "Off", "Left", "Right", "Backwards", "Sideways", "Spin", "Jitter", "Random", "Sway" }
	local PITCH_MODES = { "Off", "Up", "Down", "Zero", "Jitter", "Random", "Custom" }
	RageAntiAim:AddDropdown("Yaw", YAW_MODES, aa.yaw == "Backward" and "Backwards" or aa.yaw, function(v) aa.yaw = v aaCtl.refresh() end)
	RageAntiAim:AddDropdown("Pitch", PITCH_MODES, aa.pitch, function(v) aa.pitch = v aaCtl.refresh() end)
	local desyncToggle = RageAntiAim:AddToggle("Desync", aa.desync, set(aa, "desync"))
	local desyncSettings = desyncToggle:AddSettings()
	desyncSettings:AddSlider("Amount", 10, 120, aa.desyncAmount, set(aa, "desyncAmount"), "°")
	desyncSettings:AddSlider("Period", 5, 200, aa.desyncPeriod, set(aa, "desyncPeriod"), " ms")

	aaCtl.refresh = function()
		local function gate(control, on)
			if control then pcall(control.SetDisabled, control, not on) end
		end
		local yawMode, pitchMode = aa.yaw, aa.pitch
		gate(aaCtl.spin, yawMode ~= "Spin")
		gate(aaCtl.spinSpeed, yawMode == "Spin" or aa.spin == true)
		gate(aaCtl.swaySpeed, yawMode == "Sway")
		gate(aaCtl.swayRange, yawMode == "Sway")
		gate(aaCtl.pitchValue, pitchMode == "Custom")
		gate(aaCtl.jitter, yawMode ~= "Spin" and yawMode ~= "Sway")
		gate(aaCtl.jitterDelay, yawMode == "Jitter" or yawMode == "Random" or aa.jitter > 0 or pitchMode == "Jitter")
	end
	task.defer(aaCtl.refresh)
	RageAntiAim:AddDropdown("Freestanding", { "Off", "On", "Auto" }, aa.freestanding, set(aa, "freestanding"))

	local Builder = RageAntiAim:AddToggle("Use Builder", aa.useBuilder, set(aa, "useBuilder"))
	hk["AA Builder"] = Builder
	tip(Builder, "Pick a condition, then set the values used while you are in it")
	local BuilderSettings = Builder:AddSettings()
	local stateNames, selectedState, stateControls = { "Standing", "Moving", "Air", "Crouching" }, "Standing", {}
	local builderLive = false
	task.delay(3, function() builderLive = true end)
	local function stateValues() return aa.states[selectedState] end
	local function writeState(key) return function(v) if builderLive then stateValues()[key] = v end end end
	BuilderSettings:AddDropdown("Condition", stateNames, selectedState, function(value)
		selectedState = value
		for _, apply in ipairs(stateControls) do apply() end
	end)
	local function stateControl(object, key)
		stateControls[#stateControls + 1] = function() object:Set(stateValues()[key], true) end
	end
	stateControl(BuilderSettings:AddDropdown("State Yaw", YAW_MODES, stateValues().yaw, writeState("yaw")), "yaw")
	stateControl(BuilderSettings:AddSlider("State Offset", -180, 180, stateValues().offset, writeState("offset"), "°"), "offset")
	stateControl(BuilderSettings:AddSlider("State Jitter", 0, 90, stateValues().jitter, writeState("jitter"), "°"), "jitter")
	stateControl(BuilderSettings:AddSlider("State Jitter Delay", 1, 64, stateValues().jitterDelay, writeState("jitterDelay"), " ticks"), "jitterDelay")
	stateControl(BuilderSettings:AddSlider("State Spin Speed", 5, 90, stateValues().spinSpeed, writeState("spinSpeed"), "°"), "spinSpeed")
	stateControl(BuilderSettings:AddDropdown("State Pitch", PITCH_MODES, stateValues().pitch, writeState("pitch")), "pitch")
	stateControl(BuilderSettings:AddSlider("State Pitch Value", -100, 100, stateValues().pitchValue, writeState("pitchValue"), "%"), "pitchValue")

	local legit = Neverlose.config.legit
	local LegitTab = window:AddTab("Legit", "mouse")
	Neverlose.tabs.Legit = LegitTab

	local selected = "Global"
	local controls = {}
	local syncing = false

	local function same(a, b)
		if type(a) == "table" and type(b) == "table" then return table.concat(a, "\0") == table.concat(b, "\0") end
		return a == b
	end
	local function read(key)
		if selected == "Global" then return legit[key] end
		local group = legit.groups[selected]
		local value = group and group.settings[key]
		if value ~= nil then return value end
		return legit[key]
	end
	local function write(key, value)
		if syncing or same(read(key), value) then return end
		if selected == "Global" then
			legit[key] = value
		elseif legit.groups[selected] then
			legit.groups[selected].settings[key] = value
		end
	end

	local function reg(key, make)
		local control = make(function(value) write(key, value) end)
		controls[key] = control
		return control
	end

	local function weaponNames()
		local knives = {}
		for _, name in ipairs(Skins.knives) do knives[name] = true end
		local list = {}
		for _, name in pairs(Skins.gameWeapons) do
			if not knives[name] and not name:lower():find("knife") then list[#list + 1] = name end
		end
		table.sort(list)
		return list
	end

	local function ensureGroup(name)
		if name == "Global" then return end
		if not legit.groups[name] then legit.groups[name] = { weapons = {}, settings = {} } end
		if not table.find(legit.groupNames, name) then table.insert(legit.groupNames, name) end
	end
	for _, name in ipairs(legit.groupNames) do ensureGroup(name) end

	local function sync()
		syncing = true
		for key, control in pairs(controls) do
			pcall(function() control:Set(read(key)) end)
		end
		syncing = false
	end

	local function refreshPresets()
		pcall(function() window:SetWeaponPresets(legit.groupNames) end)
	end

	local function ownerOf(weapon)
		for _, groupName in ipairs(legit.groupNames) do
			local group = legit.groups[groupName]
			if group and table.find(group.weapons, weapon) then return groupName end
		end
	end

	local function openGroupPlate()
		local Ui = Neverlose.Ui
		if not Ui then return end
		local current = selected ~= "Global" and legit.groups[selected] and selected or nil
		if not current then
			local note = Ui.pop("Group weapons", 280, 96)
			if note then Ui.label(note.body, "Pick a custom group in the Global list first.", 13, Ui.MUTED, UDim2.fromOffset(14, 4), UDim2.new(1, -28, 0, 36)) end
			return
		end
		local panel = Ui.pop(current .. " weapons", 300, 430)
		if not panel then return end
		local body = panel.body
		local search = Ui.input(body, "Search weapon", UDim2.fromOffset(12, 2), UDim2.new(1, -24, 0, 32))
		local list = Instance.new("ScrollingFrame")
		list.BackgroundTransparency, list.BorderSizePixel, list.ZIndex = 1, 0, 601
		list.Position, list.Size = UDim2.fromOffset(12, 42), UDim2.new(1, -24, 1, -92)
		list.ScrollBarThickness, list.CanvasSize, list.AutomaticCanvasSize = 3, UDim2.new(), Enum.AutomaticSize.Y
		list.ScrollBarImageColor3 = Ui.MUTED
		local layout = Instance.new("UIListLayout")
		layout.Padding, layout.SortOrder = UDim.new(0, 4), Enum.SortOrder.LayoutOrder
		layout.Parent = list
		list.Parent = body

		local function build()
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			local filter = search.Text:lower()
			for index, weapon in ipairs(weaponNames()) do
				if filter == "" or weapon:lower():find(filter, 1, true) then
					local owner = ownerOf(weapon)
					local mine = owner == current
					local row, mark = Ui.row(list, weapon, function()
						local group = legit.groups[current]
						if not group then return end
						local from = ownerOf(weapon)
						if from then
							local weapons = legit.groups[from].weapons
							table.remove(weapons, table.find(weapons, weapon))
						end
						if from ~= current then table.insert(group.weapons, weapon) end
						build()
					end, 32)
					row.LayoutOrder = index
					row.TextTransparency = (owner and not mine) and 0.5 or 0
					mark(mine)
					local tag = mine and "In group" or owner and ("in " .. owner) or ""
					Ui.label(row, tag, 12, mine and Ui.accent() or Ui.MUTED, UDim2.new(0.5, 0, 0, 0), UDim2.new(0.5, 0, 1, 0), Enum.TextXAlignment.Right)
				end
			end
		end
		search:GetPropertyChangedSignal("Text"):Connect(build)
		build()

		local delete = Ui.button(body, "Delete group", UDim2.new(0, 12, 1, -42), UDim2.new(1, -24, 0, 32), function()
			if not legit.groups[current] then return end
			legit.groups[current] = nil
			table.remove(legit.groupNames, table.find(legit.groupNames, current))
			selected = "Global"
			refreshPresets()
			panel.close()
		end, false)
		delete.TextColor3 = Color3.fromRGB(235, 130, 140)
	end

	pcall(function()
		window:SetWeaponPresets(legit.groupNames)
		window:OnWeaponPreset(function(name)
			selected = name
			ensureGroup(name)
			sync()
		end)
	end)

	local LegitMain = LegitTab:AddSection("Main", "left")
	hk["Legit"] = LegitMain:AddToggle("Enabled", legit.master, function(v) legit.master = v end)
	local groupWeapons
	groupWeapons = LegitMain:AddToggle("Group Weapons", false, function(v)
		if not v then return end
		openGroupPlate()
		task.defer(function() pcall(function() groupWeapons:Set(false, true) end) end)
	end)
	tip(groupWeapons, "Which weapons belong to the selected group (pick the group in the Global list)")

