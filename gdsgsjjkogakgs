function Input.retarget(frame, fromYaw, toYaw)
	local move = frame.Move
	if typeof(move) ~= "Vector2" or move.Magnitude == 0 then return end
	local world = CFrame.Angles(0, fromYaw, 0):VectorToWorldSpace(Vector3.new(move.X, 0, move.Y))
	local relative = CFrame.Angles(0, toYaw, 0):VectorToObjectSpace(world)
	frame.Move = Vector2.new(math.clamp(relative.X, -1, 1), math.clamp(relative.Z, -1, 1))
end

function Input.moveToward(frame, worldDirection, scale)
	local flat = Vector3.new(worldDirection.X, 0, worldDirection.Z)
	if flat.Magnitude < 1e-3 then
		frame.Move = Vector2.zero
		return
	end
	local relative = CFrame.Angles(0, frame.LookYaw, 0):VectorToObjectSpace(flat.Unit) * (scale or 1)
	frame.Move = Vector2.new(math.clamp(relative.X, -1, 1), math.clamp(relative.Z, -1, 1))
end

Input.sent = { yaw = nil, pitch = nil }

function Input.isLocal(sim)
	local controller = Game.modules.characterController
	if controller and type(controller.getCurrentCharacter) == "function" then
