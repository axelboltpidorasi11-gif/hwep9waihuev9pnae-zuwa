local dressed = setmetatable({}, { __mode = "k" })

function Skins.undress(target)
	local state = dressed[target]
	if not state then return end
	dressed[target] = nil
	if state.overlay then state.overlay:Destroy() end
	for object, transparency in pairs(state.hidden) do
		if object.Parent then object.Transparency = transparency end
	end
end

function Skins.dress(target, agentName, anchored)
	local current = dressed[target]
	if current and current.agent == agentName and current.overlay and current.overlay.Parent then return end
	Skins.undress(target)
	local source = agentName and Skins.agentModels[agentName]
	if not (target and source) then return end

	local overlay = source:Clone()
	overlay.Name = randomName()
	for _, object in ipairs(overlay:GetDescendants()) do
		if object:IsA("Humanoid") then
			pcall(function()
				object.EvaluateStateMachine, object.RequiresNeck, object.BreakJointsOnDeath, object.PlatformStand = false, false, false, true
				object.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				object.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			end)
		elseif object:IsA("LuaSourceContainer") or object:IsA("AnimationController") or object:IsA("Animator") then
			object:Destroy()
		elseif object:IsA("Motor6D") then
			if object.Part1 == nil or R15_PARTS[object.Part1.Name] or object.Part1.Name == "HumanoidRootPart" then object:Destroy() end
		elseif object:IsA("BasePart") then
			object.Anchored, object.CanCollide, object.CanQuery, object.CanTouch = anchored == true, false, false, false
			object.Massless, object.CastShadow = true, false
		end
	end

	local placed, mapped = {}, {}
	for _, part in ipairs(overlay:GetDescendants()) do
		if part:IsA("BasePart") and not part:FindFirstAncestorWhichIsA("Accessory") then
			local map = R6_MAP[part.Name]
			local anchorName = R15_PARTS[part.Name] and part.Name or map and map[1] or nil
			local anchor = anchorName and target:FindFirstChild(anchorName, true)
			if anchor and anchor:IsA("BasePart") then
				placed[part] = { anchor, map and map[2] or CFrame.new() }
				mapped[part] = true
			end
		end
	end

	local extras = {}
	for _, part in ipairs(overlay:GetDescendants()) do
		if part:IsA("BasePart") and not mapped[part] and part.Name ~= "HumanoidRootPart" and not part:FindFirstAncestorWhichIsA("Accessory") then
			local nearest, best = nil, math.huge
			for other in pairs(mapped) do
				local distance = (other.Position - part.Position).Magnitude
				if distance < best then nearest, best = other, distance end
			end
			if nearest then
				extras[part] = { placed[nearest][1], placed[nearest][2] * nearest.CFrame:ToObjectSpace(part.CFrame) }
			end
		end
	end
	for part, info in pairs(extras) do placed[part] = info end

	if next(placed) == nil then
		overlay:Destroy()
		return
	end

	for part, info in pairs(placed) do
		part.CFrame = info[1].CFrame * info[2]
		if not anchored then
			newInstance("Weld", { Part0 = info[1], Part1 = part, C0 = info[2] }, part)
		end
	end
	for _, object in ipairs(overlay:GetDescendants()) do
		if object:IsA("BasePart") and not placed[object] and not object:FindFirstAncestorWhichIsA("Accessory") then
			object:Destroy()
		end
	end

	local accessories = {}
	for _, object in ipairs(overlay:GetDescendants()) do
		if object:IsA("Accessory") then accessories[#accessories + 1] = object end
	end
	for _, accessory in ipairs(accessories) do
		local handle = accessory:FindFirstChild("Handle")
		local attachment = handle and handle:FindFirstChildOfClass("Attachment")
		local attachedTo = false
		if attachment then
			for part, info in pairs(placed) do
				local mount = part:FindFirstChild(attachment.Name)
				if mount and mount:IsA("Attachment") then
					for _, joint in ipairs(handle:GetChildren()) do
						if joint:IsA("JointInstance") then joint:Destroy() end
					end
					local offset = info[2] * mount.CFrame * attachment.CFrame:Inverse()
					handle.Anchored = anchored == true
					handle.CFrame = info[1].CFrame * offset
					if not anchored then
						newInstance("Weld", { Part0 = info[1], Part1 = handle, C0 = offset }, handle)
					end
					attachedTo = true
					break
				end
			end
		end
		if not attachedTo then accessory:Destroy() end
	end

	local hidden = {}
	for _, object in ipairs(target:GetDescendants()) do
		if (object:IsA("BasePart") or object:IsA("Decal") or object:IsA("Texture"))
			and not KEEP_VISIBLE[object.Name] and object.Transparency < 1 then
			hidden[object] = object.Transparency
			object.Transparency = 1
		end
	end

	overlay.Parent = target
	dressed[target] = { agent = agentName, overlay = overlay, hidden = hidden }
end

