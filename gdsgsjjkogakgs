	Slowed = "SLOW", Vulnerable = "LETHAL", Bomb = "C4", Defuse = "DEFUSING", ["Pin Pulled"] = "PIN",
	Money = "$4750", ["Order Priority"] = "TARGET", Delay = "DELAY", ["Sees You"] = "SEES YOU",
}
local FLAG_ORDER = { "Unarmored", "Defuser", "Blind", "Scoped", "Reload", "Immunity", "Slowed", "Vulnerable", "Bomb", "Defuse", "Pin Pulled", "Money", "Order Priority", "Delay", "Sees You" }

local function project(camera, size, position)
	local relative = camera.CFrame:PointToObjectSpace(position)
	if relative.Z >= -0.01 then return nil end
	local tanHalf = math.tan(math.rad(camera.FieldOfView) / 2)
	local aspect = size.X / math.max(size.Y, 1)
	local x = (relative.X / -relative.Z) / (tanHalf * aspect)
	local y = (relative.Y / -relative.Z) / tanHalf
	return Vector2.new((x + 1) / 2 * size.X, (1 - y) / 2 * size.Y)
end

local function frame(parent, properties)
	properties.BorderSizePixel = 0
	return newInstance("Frame", properties, parent)
end

local function line(holder, from, to, color, thickness)
	local delta = to - from
	holder.Size = UDim2.fromOffset(delta.Magnitude, thickness or 1)
	holder.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
	holder.Rotation = math.deg(math.atan2(delta.Y, delta.X))
	holder.BackgroundColor3 = color
	holder.Visible = true
end

function Preview.build(api)
	local page = api and api.frame
	local body = page and page:FindFirstChild("Body")
	local viewport = body and body:FindFirstChild("PlayerView")
	if not viewport then return end

	local top = viewport.ZIndex
	for _, object in ipairs(page:GetDescendants()) do
		if object:IsA("GuiObject") and object.ZIndex > top and object.ZIndex < 9000 then top = object.ZIndex end
	end
	local layer = frame(body, { Name = "NeverloseEsp", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = top + 1 })
	local z = layer.ZIndex
	local ui = { layer = layer }
	ui.boxOutline = frame(layer, { BackgroundTransparency = 1, ZIndex = z })
	ui.outlineStroke = newInstance("UIStroke", { Color = Color3.new(), Thickness = 3 }, ui.boxOutline)
	ui.box = frame(layer, { BackgroundTransparency = 1, ZIndex = z + 1 })
	ui.boxStroke = newInstance("UIStroke", { Thickness = 1 }, ui.box)
	ui.boxGradient = newInstance("UIGradient", { Rotation = 90 }, ui.box)
	ui.corners = {}
	for index = 1, 8 do ui.corners[index] = frame(layer, { AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z + 1 }) end
	local function label(size, alignment)
		return newInstance("TextLabel", {
			BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = size, TextStrokeTransparency = 0.4,
			TextColor3 = Color3.new(1, 1, 1), TextXAlignment = alignment or Enum.TextXAlignment.Center, ZIndex = z + 2,
			Size = UDim2.fromOffset(160, size + 2), AnchorPoint = Vector2.new(alignment and 0 or 0.5, 0),
		}, layer)
	end
	ui.name = label(13)
	ui.distance = label(11)
	ui.weapon = label(11)
	ui.weaponIcon = newInstance("ImageLabel", {
		BackgroundTransparency = 1, Visible = false, ScaleType = Enum.ScaleType.Fit, ZIndex = z + 2,
	}, layer)
