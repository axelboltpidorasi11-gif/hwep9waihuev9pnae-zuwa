			{ beam = ribbon(a0, a1, 0.3 * scale, c1:Lerp(c2, 0.5), c2, 0.88), base = 0.3 * scale },
			{ beam = ribbon(a0, a1, 0.07 * scale, c1:Lerp(white, 0.6), white, 0.1), base = 0.07 * scale },
		}
		helix = buildHelix(from, (finish - from).Unit, scale, { c1, c2 }, white)
	elseif sparkle then
		layers = {
			{ beam = ribbon(a0, a1, 0.2 * scale, c1:Lerp(c2, 0.5), c2, 0.8), base = 0.2 * scale },
			{ beam = ribbon(a0, a1, 0.06 * scale, c1:Lerp(white, 0.6), white, 0.2), base = 0.06 * scale },
		}
		sparkPart = holderPart(from)
		local sequence = ColorSequence.new({ ColorSequenceKeypoint.new(0, white), ColorSequenceKeypoint.new(0.35, c2), ColorSequenceKeypoint.new(1, c1) })
		local size = 0.5 + 0.35 * scale
		emitters = {
			newInstance("ParticleEmitter", {
				Texture = SPARK_TEXTURE, Rate = 0, Lifetime = NumberRange.new(sparkleLife * 0.6, sparkleLife), Speed = NumberRange.new(1, 4),
				SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, -4, 0), Drag = 1.2, LockedToPart = false, LightEmission = 1, LightInfluence = 0,
				Color = sequence, Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) }),
			}, sparkPart),
			newInstance("ParticleEmitter", {
