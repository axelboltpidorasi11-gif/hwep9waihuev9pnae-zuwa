		{ 'Name = "SelectedCheck", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -22, 0.5, 0)', 'Name = "SelectedCheck", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -15, 0.5, 0)' },
	}) do
		local from, to = source:find(pair[1], 1, true)
		if from then source = source:sub(1, from - 1) .. pair[2] .. source:sub(to + 1) end
	end
	local chunk, err = loadstring(stripComments(source), "scr.lua")
	if not chunk then error("library compile failed: " .. tostring(err)) end
	local library = chunk()
	if type(library) ~= "table" or type(library.AddWindow) ~= "function" then error("library did not return a table") end
