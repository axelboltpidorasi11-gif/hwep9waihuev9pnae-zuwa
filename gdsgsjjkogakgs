	maid:give(runService.RenderStepped:Connect(function(delta)
		local light = effective(Neverlose.config.world.light)

		if light.time then
			save("time", { lightingService.ClockTime })
			local hour = light.hour
			if light.cycle then
				cycleHour = ((cycleHour or hour) + (delta or 0.016) * light.cycleSpeed / 60) % 24
				hour = cycleHour
			else
				cycleHour = nil
			end
			if math.abs(lightingService.ClockTime - hour) > 0.001 then lightingService.ClockTime = hour end
		else
			restore("time", function(values) lightingService.ClockTime = values[1] end)
		end

		if light.fullbright or light.ambient then
			save("ambient", { lightingService.Ambient, lightingService.OutdoorAmbient, lightingService.Brightness })
			local color = light.fullbright and light.fullbrightColor or light.ambientColor
			lightingService.Ambient, lightingService.OutdoorAmbient = color, color
			if light.fullbright then lightingService.Brightness = light.fullbrightPower / 100 * math.max(saved.ambient[3], 1) end
		else
			restore("ambient", function(values)
				lightingService.Ambient, lightingService.OutdoorAmbient, lightingService.Brightness = values[1], values[2], values[3]
			end)
		end

		if light.noShadows then
			save("shadows", { lightingService.GlobalShadows })
			lightingService.GlobalShadows = false
		else
			restore("shadows", function(values) lightingService.GlobalShadows = values[1] end)
		end

		if light.exposure then
			save("exposure", { lightingService.ExposureCompensation })
			lightingService.ExposureCompensation = light.exposureValue / 100
		else
			restore("exposure", function(values) lightingService.ExposureCompensation = values[1] end)
		end

		if light.fog then
			save("fog", { lightingService.FogStart, lightingService.FogEnd, lightingService.FogColor, {} })
			lightingService.FogStart, lightingService.FogEnd, lightingService.FogColor = light.fogStart, light.fogEnd, light.fogColor
			for _, atmosphere in ipairs(lightingService:GetChildren()) do
				if atmosphere:IsA("Atmosphere") then
					saved.fog[4][atmosphere] = saved.fog[4][atmosphere] or { atmosphere.Density, atmosphere.Color }
					atmosphere.Density, atmosphere.Color = math.clamp(100 / math.max(light.fogEnd, 1), 0, 1), light.fogColor
				end
			end
		else
			restore("fog", function(values)
				lightingService.FogStart, lightingService.FogEnd, lightingService.FogColor = values[1], values[2], values[3]
				for atmosphere, original in pairs(values[4]) do
					if atmosphere.Parent then atmosphere.Density, atmosphere.Color = original[1], original[2] end
				end
			end)
		end

		if light.cc then
			colorEffect = ensureEffect("ColorCorrectionEffect", colorEffect)
			colorEffect.Enabled = true
			local grade = GRADES[light.grade]
			if grade then
				colorEffect.TintColor, colorEffect.Saturation, colorEffect.Brightness, colorEffect.Contrast = grade[1], grade[2], grade[3], grade[4]
			else
				colorEffect.Saturation, colorEffect.Brightness, colorEffect.Contrast = light.ccSaturation / 100, light.ccBrightness / 100, light.ccContrast / 100
				colorEffect.TintColor = light.ccTint
			end
		elseif colorEffect and colorEffect.Parent then
			colorEffect.Enabled = false
		end

		if light.bloom then
			bloomEffect = ensureEffect("BloomEffect", bloomEffect)
			bloomEffect.Enabled = true
			bloomEffect.Intensity, bloomEffect.Size, bloomEffect.Threshold = light.bloomIntensity / 100, light.bloomSize, light.bloomThreshold / 100
		elseif bloomEffect and bloomEffect.Parent then
			bloomEffect.Enabled = false
		end

		if light.wp then
			local signature = light.wpType .. "|" .. tostring(light.wpColor) .. "|" .. light.wpRate
			if not (wpPart and wpPart.Parent) then
				stopWp()
				wpPart = newInstance("Part", {
					Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
					Size = Vector3.new(90, 50, 90), Name = randomName(),
				}, effectsFolder)
				wpEmitter = newInstance("ParticleEmitter", {}, wpPart)
				pcall(function()
					wpEmitter.Shape, wpEmitter.ShapeStyle = Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume
				end)
				wpSignature = nil
			end
			if signature ~= wpSignature then
				wpSignature = signature
				configureWp(wpEmitter, light.wpType, light.wpColor, light.wpRate)
				pump.wp, pump.wpCarry = wpEmitter.Rate, 0
				wpEmitter.Rate = 0
				wpEmitter:Emit(math.clamp(math.floor(pump.wp * 6), 20, 500))
			end
			pump.wpCarry += pump.wp * math.min(delta or 0.016, 0.1)
			local wpCount = math.floor(pump.wpCarry)
			if wpCount > 0 then
				pump.wpCarry -= wpCount
				wpEmitter:Emit(math.min(wpCount, 100))
			end
			wpPart.CFrame = CFrame.new(currentCamera.CFrame.Position)
		elseif wpPart then
			stopWp()
		end

		if light.storm then
			local now = os.clock()
			nextStrike = nextStrike or now + 1
			if now >= nextStrike then
				nextStrike = now + math.max(1.5, (0.5 + math.random()) * 60 / math.max(light.stormRate, 1))
				pcall(HitEffects.skybolt, nil, light.stormColor, true)
			end
		else
			nextStrike = nil
		end

		ambienceTick("rain", light.ambRain == true, light.ambRainVolume)
		ambienceTick("vibe", light.ambVibe == true, light.ambVibeVolume)
		if light.ambStorm then
			local now = os.clock()
			if now >= ambienceThunder.at then
				ambienceThunder.at = now + 4 + math.random() * 7
				local level = math.clamp(tonumber(light.ambStormVolume) or 55, 0, 100) / 100
				pcall(HitEffects.thunder, 700 + math.random() * 900, level * 0.8)
			end
		else
			ambienceThunder.at = 0
		end

		if light.tint then
			save("tint", { lightingService.ColorShift_Top, lightingService.ColorShift_Bottom })
			lightingService.ColorShift_Top, lightingService.ColorShift_Bottom = light.tintTop, light.tintBottom
		else
			restore("tint", function(values) lightingService.ColorShift_Top, lightingService.ColorShift_Bottom = values[1], values[2] end)
		end
		if light.env then
			save("env", { lightingService.EnvironmentDiffuseScale, lightingService.EnvironmentSpecularScale })
			lightingService.EnvironmentDiffuseScale, lightingService.EnvironmentSpecularScale = light.envDiffuse / 100, light.envSpecular / 100
		else
			restore("env", function(values) lightingService.EnvironmentDiffuseScale, lightingService.EnvironmentSpecularScale = values[1], values[2] end)
		end

		if light.clouds then
			if not (cloudObject and cloudObject.Parent) then
				cloudObject = workspaceService.Terrain:FindFirstChildOfClass("Clouds")
				cloudOurs = false
				if not cloudObject then
					cloudObject, cloudOurs = newInstance("Clouds", {}, workspaceService.Terrain), true
				else
					save("clouds", { cloudObject, cloudObject.Cover, cloudObject.Density, cloudObject.Color, cloudObject.Enabled })
				end
			end
			cloudObject.Enabled, cloudObject.Cover, cloudObject.Density, cloudObject.Color = true, light.cloudCover / 100, light.cloudDensity / 100, light.cloudColor
		else
			restore("clouds", function(values)
				local target = values[1]
				if target.Parent then target.Cover, target.Density, target.Color, target.Enabled = values[2], values[3], values[4], values[5] end
			end)
			if cloudOurs and cloudObject then cloudObject:Destroy() end
			cloudObject, cloudOurs = nil, false
		end

		if light.dof then
			dofEffect = ensureEffect("DepthOfFieldEffect", dofEffect)
			Neverlose.worldDof = dofEffect
			dofEffect.Enabled = true
			dofEffect.FocusDistance, dofEffect.InFocusRadius = light.dofFocus, light.dofRadius
			dofEffect.NearIntensity, dofEffect.FarIntensity = 0, light.dofFar / 100
		elseif dofEffect and dofEffect.Parent then
			dofEffect.Enabled = false
		end

		if light.sunRays then
			sunEffect = ensureEffect("SunRaysEffect", sunEffect)
			sunEffect.Enabled = true
			sunEffect.Intensity, sunEffect.Spread = light.sunIntensity / 100, light.sunSpread / 100
		elseif sunEffect and sunEffect.Parent then
			sunEffect.Enabled = false
		end

		local skyTinted = light.sky and light.skyTint and not light.atmosphere
		if light.atmosphere or skyTinted then
			if not (atmoTarget and atmoTarget.Parent) then
				atmoTarget = lightingService:FindFirstChildOfClass("Atmosphere")
				atmoOurs = false
				if not atmoTarget then
					atmoTarget, atmoOurs = newInstance("Atmosphere", { Name = randomName() }, lightingService), true
				else
					save("atmo", { atmoTarget, atmoTarget.Density, atmoTarget.Offset, atmoTarget.Color, atmoTarget.Decay, atmoTarget.Glare, atmoTarget.Haze })
				end
			end
			if skyTinted then
				atmoTarget.Density, atmoTarget.Offset = 0.3, 0.25
				atmoTarget.Color, atmoTarget.Decay = light.skyColor, light.skyColor:Lerp(Color3.new(0, 0, 0), 0.4)
				atmoTarget.Glare, atmoTarget.Haze = 0, 1.2
			else
				atmoTarget.Density, atmoTarget.Offset = light.atmoDensity / 100, light.atmoOffset / 100
				atmoTarget.Color, atmoTarget.Decay = light.atmoColor, light.atmoDecay
				atmoTarget.Glare, atmoTarget.Haze = light.atmoGlare / 10, light.atmoHaze / 10
			end
		else
			restore("atmo", function(values)
				local target = values[1]
				if target.Parent then
					target.Density, target.Offset, target.Color, target.Decay, target.Glare, target.Haze = values[2], values[3], values[4], values[5], values[6], values[7]
				end
			end)
			if atmoOurs and atmoTarget then atmoTarget:Destroy() end
			if not (light.atmosphere or skyTinted) then atmoTarget, atmoOurs = nil, false end
		end

		if light.sky ~= skyShown or (light.sky and light.skyPreset ~= skyPreset) then
			skyShown, skyPreset = light.sky, light.skyPreset
			if light.sky then setSky(light.skyPreset) else clearSky() end
		elseif light.sky and os.clock() - (Neverlose.skyCheckAt or 0) > 0.3 then
			-- The game wipes and refills Lighting when a round starts; bring our sky back.
			Neverlose.skyCheckAt = os.clock()
			local alive = skyInstance and skyInstance.Parent == lightingService
			if alive then
				hideOtherSkies()
			elseif skyInstance and skyInstance.Parent == nil and not pcall(function() skyInstance.Parent = lightingService end) then
				setSky(light.skyPreset)
			elseif not skyInstance then
				setSky(light.skyPreset)
			end
		end

		if light.fx then
			local signature = light.fxType .. "|" .. tostring(light.fxColor) .. "|" .. light.fxRate
			if not (fxPart and fxPart.Parent) then
				stopFx()
				fxPart = newInstance("Part", {
					Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
					Size = Vector3.new(260, 140, 260), Name = randomName(),
				}, effectsFolder)
				fxEmitter = newInstance("ParticleEmitter", {}, fxPart)
				pcall(function()
					fxEmitter.Shape, fxEmitter.ShapeStyle = Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume
				end)
				fxSignature = nil
			end
			if signature ~= fxSignature then
				fxSignature = signature
				configureFx(fxEmitter, light.fxType, light.fxColor, light.fxRate)
				pump.fx, pump.fxCarry = fxEmitter.Rate, 0
				fxEmitter.Rate = 0
				fxEmitter:Emit(math.clamp(math.floor(pump.fx * 0.9), 30, 400))
			end
			pump.fxCarry += pump.fx * math.min(delta or 0.016, 0.1)
			local count = math.floor(pump.fxCarry)
			if count > 0 then
				pump.fxCarry -= count
				fxEmitter:Emit(math.min(count, 300))
			end
			fxPart.CFrame = CFrame.new(currentCamera.CFrame.Position + Vector3.new(0, 45, 0))
		elseif fxPart then
			stopFx()
		end
	end))

	maid:give(lightingService.ChildAdded:Connect(function(child)
		if skyShown and skyInstance and child:IsA("Sky") and child ~= skyInstance then
			hiddenSkies[child] = lightingService
			child.Parent = nil
		end
	end))

	maid:give(function()
		restore("time", function(values) lightingService.ClockTime = values[1] end)
		restore("ambient", function(values)
			lightingService.Ambient, lightingService.OutdoorAmbient, lightingService.Brightness = values[1], values[2], values[3]
		end)
		restore("shadows", function(values) lightingService.GlobalShadows = values[1] end)
		restore("exposure", function(values) lightingService.ExposureCompensation = values[1] end)
		restore("fog", function(values)
			lightingService.FogStart, lightingService.FogEnd, lightingService.FogColor = values[1], values[2], values[3]
			for atmosphere, original in pairs(values[4]) do
				if atmosphere.Parent then atmosphere.Density, atmosphere.Color = original[1], original[2] end
			end
		end)
		clearSky()
		stopFx()
		stopWp()
		restore("atmo", function(values)
			local target = values[1]
			if target.Parent then
				target.Density, target.Offset, target.Color, target.Decay, target.Glare, target.Haze = values[2], values[3], values[4], values[5], values[6], values[7]
			end
		end)
		if atmoOurs and atmoTarget then atmoTarget:Destroy() end
		if colorEffect then colorEffect:Destroy() end
		if bloomEffect then bloomEffect:Destroy() end
		if sunEffect then sunEffect:Destroy() end
		if dofEffect then dofEffect:Destroy() end
		restore("tint", function(values) lightingService.ColorShift_Top, lightingService.ColorShift_Bottom = values[1], values[2] end)
		restore("env", function(values) lightingService.EnvironmentDiffuseScale, lightingService.EnvironmentSpecularScale = values[1], values[2] end)
		restore("clouds", function(values)
			local target = values[1]
			if target.Parent then target.Cover, target.Density, target.Color, target.Enabled = values[2], values[3], values[4], values[5] end
		end)
		if cloudOurs and cloudObject then cloudObject:Destroy() end
	end)
end

do
	local SEG, MAX_ZONES = 28, 4
	local ZONE_MAX_ALPHA = 0.9
	-- false = зону видно сквозь стены (заливка, контур и подпись), форма всё равно режется стенами. true = прячется за стенами.
	local ZONE_HIDE_BEHIND_WALLS = false
	-- true = зона обрезается стенами и не заходит за них (как контур). false = всегда полный круг.
	local ZONE_SHAPE = true

	-- Размер зоны относительно измеренного (1.0 = как есть). Там, где зону режет стена, размер не растёт.
	local ZONE_SCALE = 1.08
	-- Неон только на самой кромке: яркая тонкая линия и мягкие слои свечения, шире и слабее.
	-- Первое число — толщина в пикселях, второе — непрозрачность слоя.
	local NEON_CORE = { 2, 1 }
	local NEON_GLOW = { { 18, 0.05 }, { 12, 0.09 }, { 7, 0.16 }, { 4, 0.3 } }

	local zoneSets = {}
	for zone = 1, MAX_ZONES do
		local set = { fill = {}, edge = {}, glow = {} }
		for segment = 1, SEG do
			set.fill[segment] = draw("Triangle", { Filled = true, Thickness = 0, Visible = false })
			set.edge[segment] = draw("Line", { Thickness = NEON_CORE[1], Visible = false })
			set.glow[segment] = {}
			for layer, spec in ipairs(NEON_GLOW) do
				set.glow[segment][layer] = draw("Line", { Thickness = spec[1], Visible = false })
			end
		end
		set.heights, set.castAt, set.castKey = {}, 0, nil
		zoneSets[zone] = set
	end
	local zoneLabels = {}
	for zone = 1, MAX_ZONES do zoneLabels[zone] = draw("Text", { Size = 12, Center = true, Outline = true, Font = 2, Visible = false }) end

	local zoneParams = RaycastParams.new()
	zoneParams.FilterType = Enum.RaycastFilterType.Exclude
	zoneParams.IgnoreWater = true
	local paramsAt = 0
	local refreshZoneFilter -- задаётся ниже, когда известен список зон
	-- Milk: стены ищем лучами из группы столкновений "Bullet", как делают пули в этом скрипте.
	-- обычный луч (группа Default) может пролетать сквозь карту, если стены лежат в другой группе.
	local wallParams = RaycastParams.new()
	wallParams.FilterType = Enum.RaycastFilterType.Exclude
	wallParams.IgnoreWater = true
	pcall(function() wallParams.CollisionGroup = "Bullet" end)

	local function positionOf(object)
		if object:IsA("Model") then return object:GetPivot().Position end
		if object:IsA("BasePart") then return object.Position end
		return nil
	end

	-- Real footprint of a smoke or fire: the horizontal span of its voxel parts, measured a few times a second.
	local extentCache = setmetatable({}, { __mode = "k" })
	local function extentOf(object, now)
		local cached = extentCache[object]
		if cached and now - cached.t < 0.4 then return cached.centre, cached.radius, cached.mid end
		local low, high, count, sumY = Vector3.one * math.huge, Vector3.one * -math.huge, 0, 0
		local function take(part)
			if part:IsA("BasePart") then
				local half = part.Size / 2
				local position = part.Position
				low = low:Min(position - Vector3.new(half.X, half.Y, half.Z))
				high = high:Max(position + Vector3.new(half.X, half.Y, half.Z))
				count += 1
				sumY += position.Y
			end
		end
		if object:IsA("BasePart") then take(object) end
		for _, part in ipairs(object:GetDescendants()) do take(part) end
		local centre, radius, mid
		if count >= 4 then
			mid = sumY / count
			centre = Vector3.new((low.X + high.X) / 2, low.Y, (low.Z + high.Z) / 2)
			radius = math.max(math.max(high.X - low.X, high.Z - low.Z) / 2, 1)
		end
		extentCache[object] = { t = now, centre = centre, radius = radius, mid = mid }
		return centre, radius, mid
	end

	local function hideZone(set)
		for segment = 1, SEG do
			set.fill[segment].Visible = false
			set.edge[segment].Visible = false
			for _, line in ipairs(set.glow[segment]) do line.Visible = false end
		end
	end

	-- Ground height under each point of the zone, clamped around the centre so the ring cannot climb walls.
	local function sampleGround(set, centre, radius, now, mid)
		local key = centre.X + centre.Z * 7 + radius
		if set.castKey == key and now - set.castAt < 1.5 then return end
		if set.castKey and now - set.castAt < 0.25 then return end
		set.castAt, set.castKey = now, key
		if now - paramsAt > 0.5 then
			paramsAt = now
			if refreshZoneFilter then
				refreshZoneFilter()
			else
				zoneParams.FilterDescendantsInstances = { localPlayer.Character, currentCamera, effectsFolder, workspaceService:FindFirstChild("Characters"), workspaceService:FindFirstChild("Debris") }
			end
		end
		-- The measured bottom of the voxels can sit inside the floor, so the ring is anchored to the ground found under the centre.
		local start = Vector3.new(centre.X, math.max(mid or centre.Y, centre.Y + 3), centre.Z)
		local base = workspaceService:Raycast(start, Vector3.new(0, -60, 0), zoneParams)
		local baseY = base and base.Position.Y + 0.12 or centre.Y + 0.3
		set.baseY = baseY
		for segment = 1, SEG do
			local angle = (segment - 1) / SEG * math.pi * 2
			local origin = Vector3.new(centre.X + math.cos(angle) * radius, baseY + 3, centre.Z + math.sin(angle) * radius)
			local hit = workspaceService:Raycast(origin, Vector3.new(0, -12, 0), zoneParams)
			set.heights[segment] = hit and math.clamp(hit.Position.Y + 0.12, baseY - 3, baseY + 3) or baseY
		end
	end

	-- Milk: поиск зон. своя граната может лежать не в Debris — смотрим везде:
	-- Debris, workspace, камера, персонаж, реестр CreateVoxelSmoke, тег Smoke.
	local scanAt, candidates, candidateSet = 0, {}, {}

	local function zoneKind(object)
		if not object or not object.Parent or object == effectsFolder then return nil end
		if not (object:IsA("Model") or object:IsA("Folder") or object:IsA("BasePart")) then return nil end
		if object:GetAttribute("GrenadeName") ~= nil or object:GetAttribute("Weapon") ~= nil or object:HasTag("Grenade") then return nil end
		local name = object.Name
		if name:sub(1, 11) == "VoxelSmoke_" then return "smoke" end
		if name:sub(1, 10) == "VoxelFire_" then return "fire" end
		local lower = name:lower()
		if lower:find("grenade", 1, true) then return nil end
		-- Предмет в руках (вьюмодель в камере, инструмент, модель на персонаже) — не зона. Настоящие
		-- VoxelSmoke_ / VoxelFire_ выше пропускаются без проверки, здесь только поиск по названию.
		if object:IsA("Tool") or object:IsDescendantOf(currentCamera) or (localPlayer.Character and object:IsDescendantOf(localPlayer.Character)) then return nil end
		if object:IsA("Model") and (object:FindFirstChildOfClass("Humanoid") or playersService:GetPlayerFromCharacter(object)) then return nil end
		if lower:find("smoke", 1, true) then return "smoke" end
		if lower:find("molotov", 1, true) or lower:find("incendiary", 1, true) or lower:find("inferno", 1, true) or lower:find("flame", 1, true) or lower:find("fire", 1, true) then return "fire" end
		return nil
	end

	local function fireLabel(object)
		local name = tostring(object:GetAttribute("GrenadeName") or object.Name):lower()
		if name:find("incendiary", 1, true) then return "INCENDIARY" end
		if name:find("molotov", 1, true) then return "MOLOTOV" end
		return "FIRE"
	end

	local function rescan(now)
		if now - scanAt < 0.25 then return end
		scanAt = now
		table.clear(candidates)
		table.clear(candidateSet)
		local function consider(object, forced)
			if candidateSet[object] or object == effectsFolder then return end
			local kind = forced or zoneKind(object)
			if kind then
				candidateSet[object] = true
				candidates[#candidates + 1] = { object = object, kind = kind }
			end
		end
		local function scan(parent)
			if not parent then return end
			for _, child in ipairs(parent:GetChildren()) do consider(child) end
		end
		local debris = workspaceService:FindFirstChild("Debris")
		scan(debris)
		scan(workspaceService)
		scan(currentCamera)
		scan(localPlayer.Character)
		local registry = Neverlose.Ballistics and Neverlose.Ballistics.smokes
		if registry then
			for object in pairs(registry) do
				if typeof(object) == "Instance" and object.Parent then consider(object, "smoke") end
			end
		end
		for _, object in ipairs(collectionService:GetTagged("Smoke")) do
			local root = object
			if object:IsA("BasePart") and object.Parent and object.Parent ~= workspaceService and object.Parent ~= debris then root = object.Parent end
			consider(root, "smoke")
		end
	end

	local function collectSources(zones, now)
		rescan(now)
		local sources = {}
		for _, entry in ipairs(candidates) do
			local object = entry.object
			if object.Parent and ((entry.kind == "smoke" and zones.smokeOn) or (entry.kind == "fire" and zones.fireOn)) then
				local centre, measured, mid = extentOf(object, now)
				if centre and measured and measured <= 60 then
					local label, color = "SMOKE", zones.smokeColor
					if entry.kind == "fire" then label, color = fireLabel(object), zones.fireColor end
					sources[#sources + 1] = { position = centre + Vector3.new(0, 2.5, 0), radius = measured, color = color, label = label, key = object, mid = mid }
				end
			end
		end
		local cam = currentCamera.CFrame.Position
		table.sort(sources, function(a, b) return (a.position - cam).Magnitude < (b.position - cam).Magnitude end)
		return sources
	end

	-- Milk: луч для стен. триггеры и невидимые не-коллизионные объекты (зоны покупки и т.п.) стеной не считаются.
	refreshZoneFilter = function()
		local ignore, wallIgnore = {}, {}
		local function push(item)
			if item then
				ignore[#ignore + 1] = item
				wallIgnore[#wallIgnore + 1] = item
			end
		end
		push(localPlayer.Character)
		push(currentCamera)
		push(effectsFolder)
		push(workspaceService:FindFirstChild("Characters"))
		push(workspaceService:FindFirstChild("Debris"))
		for _, entry in ipairs(candidates) do push(entry.object) end
		zoneParams.FilterDescendantsInstances = ignore
		local okList, gameIgnore = pcall(Ballistics.ignoreList)
		if okList and type(gameIgnore) == "table" then
			for _, item in ipairs(gameIgnore) do wallIgnore[#wallIgnore + 1] = item end
		end
		wallParams.FilterDescendantsInstances = wallIgnore
	end

	local function castSolid(origin, vector)
		local length = vector.Magnitude
		if length < 1e-3 then return nil end
		local unit, travelled = vector / length, 0
		for _ = 1, 4 do
			local hit = workspaceService:Raycast(origin, unit * (length - travelled), wallParams)
			if not hit then return nil end
			local object = hit.Instance
			if isPassThrough(object) or (object.CanCollide == false and object.Transparency > 0.95) then
				local step = hit.Distance + 0.05
				origin = origin + unit * step
				travelled += step
				if travelled >= length then return nil end
			else
				return hit, travelled + hit.Distance
			end
		end
		return nil
	end

	-- Физика как у контура: заливка и контур режутся стенами. От центра на SEG направлений,
	-- на двух высотах, летит луч; где он упёрся в стену, зона кончается. Результат — доли радиуса.
	local function updateClip(set, source, floor, baseY, now)
		if not ZONE_SHAPE then
			set.segFrac = nil
			return
		end
		local radius = math.max(source.radius, 1)
		local key = math.floor(radius * 2) .. ":" .. math.floor(floor.X * 2) .. ":" .. math.floor(floor.Z * 2) .. ":" .. math.floor(baseY * 2)
		if set.clipKey == key and now - (set.clipAt or 0) < 2 then return end
		if set.clipKey ~= key and now - (set.clipAt or -1) < 0.15 then return end
		set.clipKey, set.clipAt = key, now
		refreshZoneFilter()
		local heights = { baseY + 1.0, baseY + 2.6 }
		local fractions = set.segFrac or {}
		for segment = 1, SEG do
			local angle = (segment - 1) / SEG * math.pi * 2
			local direction = Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius
			local reach = radius
			for _, y in ipairs(heights) do
				local hit, distance = castSolid(Vector3.new(floor.X, y, floor.Z), direction)
				if hit then reach = math.min(reach, math.max(distance - 0.15, 0.3)) end
			end
			fractions[segment] = reach / radius
		end
		set.segFrac = fractions
	end

	-- Milk: контур и подпись Drawing не знают про глубину, поэтому стены проверяются лучами от камеры.
	-- 10 раз в секунду, на каждый сегмент контура и на центр зоны.
	local function updateOcclusion(set, floor, radius, labelPoint, now)
		if now - (set.occAt or 0) < 0.1 then return end
		set.occAt = now
		set.hidden = set.hidden or {}
		refreshZoneFilter()
		local origin = currentCamera.CFrame.Position
		local baseY = set.baseY or floor.Y
		for segment = 1, SEG do
			local angle = (segment - 1) / SEG * math.pi * 2
			local point = Vector3.new(floor.X + math.cos(angle) * radius, (set.heights[segment] or baseY) + 0.8, floor.Z + math.sin(angle) * radius)
			set.hidden[segment] = workspaceService:Raycast(origin, (point - origin) * 0.99, wallParams) ~= nil
		end
		set.labelHidden = workspaceService:Raycast(origin, (labelPoint - origin) * 0.99, wallParams) ~= nil
	end

	maid:give(runService.RenderStepped:Connect(function()
		local world = Neverlose.config.world
		local zones = world.zones
		local used = 0
		local now = os.clock()

		if zones.enabled then
			local okSources, sources = pcall(collectSources, zones, now)
			if not okSources then sources = {} end
			local camera = currentCamera.CFrame.Position

			for _, source in ipairs(sources) do
				if used >= MAX_ZONES then break end
				if source.position and (source.position - camera).Magnitude < 400 then
					used += 1
					local set = zoneSets[used]
					local floor = source.position - Vector3.new(0, 2.5, 0)
					local age = source.key:GetAttribute("NLZoneSeen")
					if not age then age = now; source.key:SetAttribute("NLZoneSeen", now) end
					local grow = math.clamp((now - age) / 0.45, 0, 1)
					local radius = source.radius * (1 - (1 - grow) * (1 - grow))
					sampleGround(set, floor, math.max(radius, 1), now, source.mid)
					updateClip(set, source, floor, set.baseY or floor.Y, now)
					if ZONE_HIDE_BEHIND_WALLS then updateOcclusion(set, floor, math.max(radius, 1), source.position, now) end

					local pulse = 0.5 + 0.5 * math.sin(now * 3)
					local baseAlpha = math.clamp((zones.fillAlpha or 35) / 100, 0, 1) * 0.875

					-- Точки края, спроецированные на экран. Высота идёт по земле (set.heights),
					-- форма режется стенами (set.segFrac): там, где стена, зона и неон кончаются на ней.
					local fractions = set.segFrac
					local baseY = set.baseY or floor.Y
					local outerPts, outerVis = {}, {}
					for segment = 1, SEG do
						local angle = (segment - 1) / SEG * math.pi * 2
						local frac = fractions and fractions[segment] or 1
						local clipped = frac < 0.97
						local reach = clipped and 1 or ZONE_SCALE
						local height = (clipped and baseY) or set.heights[segment] or baseY
						local screen = currentCamera:WorldToViewportPoint(Vector3.new(floor.X + math.cos(angle) * radius * reach * frac, height, floor.Z + math.sin(angle) * radius * reach * frac))
						outerPts[segment], outerVis[segment] = Vector2.new(screen.X, screen.Y), screen.Z > 0
					end
					local centreScreen = currentCamera:WorldToViewportPoint(Vector3.new(floor.X, baseY, floor.Z))
					local centrePoint, centreVisible = Vector2.new(centreScreen.X, centreScreen.Y), centreScreen.Z > 0

					-- Одна сплошная заливка: веер от центра, один цвет и одна прозрачность без градиента.
					local alpha = math.min(baseAlpha, ZONE_MAX_ALPHA)
					local showFill = zones.fill ~= false and alpha > 0.02
					local neonOn = zones.glow ~= false
					-- Сердцевина неона светлее цвета зоны, как у настоящей неоновой трубки.
					local coreColor = source.color:Lerp(Color3.new(1, 1, 1), 0.55)
					for segment = 1, SEG do
						local following = segment % SEG + 1
						local both = outerVis[segment] and outerVis[following]

						local triangle = set.fill[segment]
						local filled = showFill and centreVisible and both
						triangle.Visible = filled
						if filled then
							triangle.PointA, triangle.PointB, triangle.PointC = centrePoint, outerPts[segment], outerPts[following]
							triangle.Color, triangle.Transparency = source.color, alpha
						end

						local neon = neonOn and both
						local edge = set.edge[segment]
						edge.Visible = neon
						if neon then
							edge.From, edge.To, edge.Color, edge.Thickness, edge.Transparency = outerPts[segment], outerPts[following], coreColor, NEON_CORE[1], NEON_CORE[2]
						end
						for layer, line in ipairs(set.glow[segment]) do
							line.Visible = neon
							if neon then
								line.From, line.To, line.Color = outerPts[segment], outerPts[following], source.color
								line.Transparency = math.min(NEON_GLOW[layer][2] * (0.85 + 0.3 * pulse), 1)
							end
						end
					end

					local label = zoneLabels[used]
					local labelScreen, labelVisible = currentCamera:WorldToViewportPoint(source.position)
					label.Visible = labelVisible and zones.labels ~= false and not (ZONE_HIDE_BEHIND_WALLS and set.labelHidden)
					label.Text, label.Color = source.label, zones.iconColor
					label.Position = Vector2.new(labelScreen.X, labelScreen.Y)
				end
			end
		end

		for zone = used + 1, MAX_ZONES do
			zoneLabels[zone].Visible = false
			hideZone(zoneSets[zone])
		end
	end))
end
