function EspObject:drawGhost(character, record, chams)
	local style = CHAMS_STYLE[chams.mode]
	local slot = chams.slot or "ghost"
	if not (style and record) then return self:hideGhost(slot) end
	local ghost = self[slot]
	if not (ghost and ghost.model.Parent) then
		local model = newInstance("Model", { Name = randomName() }, effectsFolder)
		local parts = {}
		for _, name in ipairs(BODY_PARTS) do
			parts[name] = newInstance("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 1 }, model)
		end
		local light = newInstance("Highlight", { Name = randomName(), DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = model }, model)
		ghost = { model = model, parts = parts, light = light }
		self[slot] = ghost
	end
	local color = chams.color
	if style.rainbow then color = Color3.fromHSV((os.clock() * 0.2) % 1, 0.7, 1) end
	local fxDelta
	color, fxDelta = Neverlose.styleFx(chams.mode, color)
	local breath = 0.5 + 0.5 * math.sin(os.clock() * 2.4)
	-- overlay: per-hitbox полупрозрачные части с материалом и Reflectance —
	-- тот же приём, что у Neon, но без Highlight/Xray и не в плотную.
	local overlay = chams.overlay == true
	local alpha = style.ghostAlpha
	if alpha == nil then
		alpha = style.material and (style.alpha and 1 - style.alpha or 0.45) or 0.9
	end
	if chams.depth == "Occluded" then alpha = 0.97 end
	-- opaque: настоящие части в мире (материал, цвет, глубина), без Highlight — как рисуется Neon.
	if chams.opaque then
		alpha = style.alpha and (1 - style.alpha) or math.clamp(0.08 + style.fill * 0.7, 0.08, 0.85)
		if style.pulse then alpha += 0.12 * breath end
		alpha = math.clamp(alpha + fxDelta, 0, 0.95)
	end
	local grow = overlay and (chams.opaque and 1.04 or 1.025) or 1
	local any = false
	for name, part in pairs(ghost.parts) do
		local cframe, live = record.cframes[name], character:FindFirstChild(name)
		if cframe and live then
			part.CFrame, part.Color = cframe, color
			part.Size = live.Size * grow
			part.Material = style.material or Enum.Material.SmoothPlastic
			part.Reflectance = style.reflectance or (chams.opaque and 0.05) or 0
			part.Transparency = alpha
			any = true
		else
			part.Transparency = 1
		end
	end
	ghost.character = character
	if chams.live then Neverlose.liveGhosts[ghost] = true else Neverlose.liveGhosts[ghost] = nil end
	local light = ghost.light
	local occluded = chams.depth == "Occluded"
	light.DepthMode = occluded and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
	if overlay then
		light.Enabled = false
		if Neverlose.Xray then Neverlose.Xray.clear(ghost) end
		return
	end
	light.Enabled = any
	light.FillColor = color
	local boost = slot == "wallGhost" and math.clamp((Neverlose.config.esp.wallBoost or 60) / 100, 0, 1) or 0
	local fillT = math.clamp(style.fill + (style.pulse and 0.16 * breath or 0) + fxDelta, 0, 1)
	light.FillTransparency = fillT + (math.min(fillT, 0.4) - fillT) * boost
	light.OutlineColor = slot == "wallGhost" and color or color:Lerp(Color3.new(1, 1, 1), style.rim or 0.35)
	light.OutlineTransparency = math.max(style.outline - 0.05, 0) * (1 - boost)
	if occluded then
		-- Открытый враг: призрак с обычной глубиной (закрытые стеной части не рисуются), без Xray.
		if Neverlose.Xray then Neverlose.Xray.clear(ghost) end
		return
	end
	if any and Neverlose.Xray then
		local xrayT = math.clamp(0.42 + style.fill * 0.4, 0.42, 0.85)
		Neverlose.Xray.set(ghost, character, color, xrayT + (0.18 - xrayT) * boost, (not chams.live) and record or nil)
	elseif Neverlose.Xray then
		Neverlose.Xray.clear(ghost)
	end
end

function EspObject:hideGhost(only)
	for _, key in ipairs({ "ghost", "wallGhost", "glossGhost", "visGhost", "realGhost" }) do
		local ghost = (not only or only == key) and self[key]
		if ghost then
			ghost.light.Enabled = false
			if Neverlose.Xray then Neverlose.Xray.clear(ghost) end
			for _, part in pairs(ghost.parts) do part.Transparency = 1 end
		end
	end
end

local BONE_KEYS, EMPTY_LIST = {}, {}
for index = 1, #BONES do BONE_KEYS[index] = "bone" .. index end

function EspObject:hideDrawings()
	self.realShift = nil
	if not self.drawn then return end
	self.drawn = false
	for _, key in ipairs(DRAWING_KEYS) do self[key].Visible = false end
	if self.hitAdorns then
		for _, adorn in pairs(self.hitAdorns) do pcall(function() adorn.Visible = false end) end
	end
	for _, list in ipairs({ self.fillStrips, self.gradLines, self.corners, self.bones, self.ghostBones, self.hitDots, self.pixOutlines, self.pixRects, self.hpSegs, self.barObjects }) do
		for _, object in ipairs(list) do object.Visible = false end
	end
	pcall(function() self.billboard.Enabled = false end)
	self:hideGhost("ghost")
	self:hideGhost("realGhost")
end

function EspObject:hide()
	self:hideDrawings()
	self:hideHighlights()
	self:restoreRendering()
end

function EspObject:restoreRendering()
	for part in pairs(self.hiddenParts) do
		if part.Parent then part.LocalTransparencyModifier = 0 end
	end
	table.clear(self.hiddenParts)
end

function EspObject:destroy()
	pcall(self.dropGhostClone, self)
	self:hide()
	if self.hitAdorns then
		for _, adorn in pairs(self.hitAdorns) do pcall(function() adorn:Destroy() end) end
		self.hitAdorns = nil
	end
	for _, key in ipairs(DRAWING_KEYS) do pcall(function() self[key]:Remove() end) end
	for _, list in ipairs({ self.fillStrips, self.gradLines, self.corners, self.bones, self.ghostBones, self.hitDots, self.pixOutlines, self.pixRects, self.hpSegs, self.barObjects }) do
		for _, object in ipairs(list) do pcall(function() object:Remove() end) end
	end
	pcall(function() self.highlight:Destroy() end)
	pcall(function() self.highlightVisible:Destroy() end)
	if self.ghost then pcall(function() self.ghost.model:Destroy() end) end
	if self.wallGhost then pcall(function() self.wallGhost.model:Destroy() end) end
	if self.glossGhost then pcall(function() self.glossGhost.model:Destroy() end) end
	if self.visGhost then pcall(function() self.visGhost.model:Destroy() end) end
	if self.realGhost then pcall(function() self.realGhost.model:Destroy() end) end
	self:neonDestroy()
	pcall(self.hitmatDestroy, self)
	self.billboard:Destroy()
end

function Neverlose.makeGhostClone(source)
	local ok, clone = pcall(function()
		for _, object in ipairs(source:GetDescendants()) do object.Archivable = true end
		source.Archivable = true
		return source:Clone()
	end)
	if not ok or not clone then return nil end
	for _, object in ipairs(clone:GetDescendants()) do
		if object:IsA("BasePart") then
			object.Anchored, object.CanCollide, object.CanQuery, object.CanTouch, object.CastShadow = true, false, false, false, false
		elseif object:IsA("LuaSourceContainer") or object:IsA("Sound") or object:IsA("Humanoid") or object:IsA("Animator") or object:IsA("Highlight") or object:IsA("BillboardGui") then
			object:Destroy()
		end
	end
	clone.Parent = effectsFolder
	return clone
end

function EspObject:dropGhostClone()
	if self.ghostClone then
		pcall(function() self.ghostClone:Destroy() end)
		self.ghostClone, self.ghostSource = nil, nil
		self:hideHighlights()
	end
end

function EspObject:hideHighlights()
	self.chamsCache = nil
	self.highlight.Enabled, self.highlightVisible.Enabled = false, false
	if Neverlose.Xray then Neverlose.Xray.clear(self) end
	self:hideGhost("wallGhost")
	self:hideGhost("glossGhost")
	self:hideGhost("visGhost")
	self:setMaterial(nil)
	self:neonHide()
	self.hitmatOn = nil
	self:hitmatHide()
end

function EspObject:setMaterial(character, style, color)
	self.bodyState = self.bodyState or { store = self.originalParts, scan = 0 }
	BodyMat.drive(self.bodyState, character, style, color)
end

