	local linger = math.clamp((misc.tracerLife or 1.5) * 0.25, 0.15, 0.8)
	local tailDelay = spiral and linger * 1.4 or linger
	local sparkleLife = 0.9

	local tailPart, headPart = holderPart(from), holderPart(from)
	local a0, a1 = newInstance("Attachment", {}, tailPart), newInstance("Attachment", {}, headPart)
	local layers, helix, emitters, sparkPart
	if spiral then
