-- Hit log icon: the round cross badge (embedded PNG, written next to the settings on first use).
local HITLOG_ICON_FILE = FOLDER .. "/hitlog.png"
local HITLOG_ICON_B64 = ""

local function base64Decode(data)
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local out, value, bits = {}, 0, 0
	for index = 1, #data do
		local char = data:sub(index, index)
		if char == "=" then break end
		local slot = alphabet:find(char, 1, true)
		if slot then
			value = value * 64 + (slot - 1)
			bits += 6
			if bits >= 8 then
				bits -= 8
				out[#out + 1] = string.char(math.floor(value / 2 ^ bits) % 256)
				value = value % 2 ^ bits
			end
		end
	end
	return table.concat(out)
end

local hitlogIconAsset, hitlogIconNext
local function hitlogIcon()
	if type(hitlogIconAsset) == "string" then return hitlogIconAsset end
	if hitlogIconNext and os.clock() < hitlogIconNext then return nil end
	hitlogIconNext = os.clock() + 5
	if not (getcustomasset and writefile) then return nil end
	pcall(function()
		if not (isfile and isfile(HITLOG_ICON_FILE)) then
			writefile(HITLOG_ICON_FILE, base64Decode(HITLOG_ICON_B64))
		end
		local asset = getcustomasset(HITLOG_ICON_FILE)
		if type(asset) == "string" and asset ~= "" then hitlogIconAsset = asset end
	end)
	return hitlogIconAsset
end

-- Hit log look: themed text and highlights plus the round cross icon.
local function decorateHitLog(row, misc)
	if not (typeof(row) == "Instance" and row:IsA("Frame")) then return end
	local capsule = row:FindFirstChild("LogCapsule")
	local pill = capsule and capsule:FindFirstChild("LogPill")
	if not (pill and pill:IsA("Frame")) then return end

	local text = pill:FindFirstChild("LogText")
	if text and typeof(misc.hitlogTextColor) == "Color3" then text.TextColor3 = misc.hitlogTextColor end

	local icon = pill:FindFirstChild("LogIcon")
	if icon and icon:IsA("ImageLabel") then
		-- Leave the tint the library gave it: the custom picture then gets the very
		-- same accent colour as the stock hit / kill / miss icons.
		if typeof(icon.ImageColor3) ~= "Color3" then icon.ImageColor3 = Color3.new(1, 1, 1) end
	end
end

local function emitLog(text, icon, count)
	local window = Neverlose.window
	if not (window and window.Log) then return end
	local misc = Neverlose.config and Neverlose.config.misc or {}
	local damage = icon == "hit" or icon == "kill" or icon == "miss"
	local options = { type = icon }
	if damage then
		if typeof(misc.hitlogColor) == "Color3" then options.highlight = misc.hitlogColor end
	end
	local payload = count > 1 and (text .. " x" .. count) or text
	local ok, row = pcall(window.Log, window, payload, options)
	if ok and damage then pcall(decorateHitLog, row, misc) end
end

