		if Skins.catalog[weapon] then return Skins.catalog[weapon] end
		local list = {}
		if skinsLib and type(skinsLib.GetAllSkinsForWeapon) == "function" then
			local ok, entries = pcall(skinsLib.GetAllSkinsForWeapon, weapon)
			if ok and type(entries) == "table" then
