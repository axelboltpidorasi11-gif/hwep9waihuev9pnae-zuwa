function Agents.attach(root, viewName, getSide, yaw, getWeapon, rotatable, fill)
	local last = 0
	local userYaw = yaw or 0
	local dragging, dragView = false, nil
	local userInputService = game:GetService("UserInputService")

	local function applyYaw(model)
		model:SetAttribute("NeverloseYaw", userYaw)
		pcall(function() model:PivotTo(CFrame.new(model:GetPivot().Position) * CFrame.Angles(0, math.pi + userYaw, 0)) end)
	end
	local fits = setmetatable({}, { __mode = "k" })

	local function bodyBox(model)
		return Agents.visibleBox(model, model:FindFirstChild("NeverloseWeapon"))
	end

	local function fit(view, camera, model)
		local cframe, size = bodyBox(model)
		local armsCf, armsSize = Agents.visibleBox(model, model:FindFirstChild("NeverloseWeapon"), true)
		local state = fits[model]
		if not state then
			state = { size = size, center = cframe.Position, lo = armsCf.Position.X - armsSize.X / 2, hi = armsCf.Position.X + armsSize.X / 2 }
			fits[model] = state
		end
		state.size = Vector3.new(math.max(state.size.X, size.X), math.max(state.size.Y, size.Y), math.max(state.size.Z, size.Z))
		state.lo = math.min(state.lo, armsCf.Position.X - armsSize.X / 2)
		state.hi = math.max(state.hi, armsCf.Position.X + armsSize.X / 2)
		local area = view.AbsoluteSize
		local aspect = (area.X > 0 and area.Y > 0) and area.X / area.Y or 0.75
		local vertical = math.tan(math.rad(camera.FieldOfView / 2))
		local horizontal = vertical * aspect
		local height = state.size.Y
		local width = state.hi - state.lo

		local boxW, boxH = fill and fill[1] or 0.8, fill and fill[2] or 0.84
		local visibleHeight = math.max(height / boxH, width / (boxW * aspect))
		local distance = visibleHeight / 2 / vertical + math.max(state.size.Z, armsSize.Z) / 2
		local center = Vector3.new((state.lo + state.hi) / 2, state.center.Y, state.center.Z)
		camera.CFrame = CFrame.new(center + Vector3.new(0, 0, distance), center)
	end

	maid:give(runService.Heartbeat:Connect(function()
		if os.clock() - last < 0.3 then return end
		last = os.clock()
		local view = root and root.Parent and root:FindFirstChild(viewName, true)
		local world = view and view:FindFirstChildOfClass("WorldModel")
		local camera = view and view.CurrentCamera
		if not (view and world and camera) then return end

		if rotatable and dragView ~= view then
			dragView = view
			maid:give(view.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
			end))
			maid:give(userInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
			end))
			maid:give(userInputService.InputChanged:Connect(function(input)
				if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
				userYaw += input.Delta.X * 0.012
				local model = world.Parent and world:FindFirstChildOfClass("Model")
				if model then
					applyYaw(model)
					fits[model] = nil
				end
			end))
		end

		local side = getSide()
		local source, tag = Agents.find(side)
		if not source then return end
		tag = side .. ":" .. tostring(tag)
		local weaponName = getWeapon and getWeapon() or nil
		local skin, float, charm
		if weaponName then skin, float, charm = Agents.spec(side, weaponName) end
		local heldKey = weaponName and (weaponName .. "|" .. tostring(skin) .. "|" .. tostring(charm)) or ""

		local current = world:FindFirstChildOfClass("Model")
		if current and current:GetAttribute("NeverloseAgent") == tag then
			if current:GetAttribute("NeverloseHeld") ~= heldKey then
				current:SetAttribute("NeverloseHeld", heldKey)
				if weaponName then Agents.hold(current, weaponName, skin, float, charm) else
					for _, held in ipairs(current:GetChildren()) do if held.Name == "NeverloseWeapon" then held:Destroy() end end
					Agents.play(current, idleAnimation(side))
				end
			end
			fit(view, camera, current)
			return
		end

		world:ClearAllChildren()
		local clone = cloneOf(source)
		if not clone then return end
		Agents.rig(clone)
		clone:SetAttribute("NeverloseAgent", tag)
		clone:SetAttribute("NeverloseSide", side)
		clone:SetAttribute("NeverloseYaw", userYaw)
		clone:SetAttribute("NeverloseHeld", heldKey)
		clone.Parent = world
		pcall(function() clone:PivotTo(CFrame.Angles(0, math.pi + userYaw, 0)) end)
		if weaponName then Agents.hold(clone, weaponName, skin, float, charm) else Agents.play(clone, idleAnimation(side)) end
		fit(view, camera, clone)
	end))
end

function Agents.spec(side, weaponName)
	local config = Neverlose.config.skins
	local entry = config.bySide[side == "T" and "T" or "CT"] or {}
	local resolved = Skins.resolve and Skins.resolve(weaponName) or weaponName
	local settings = Skins.settingsFor(resolved)
	return entry.weapons and entry.weapons[resolved], math.max((settings.float or 0) / 100, 0.001), entry.charm
end

end

local Inspect = { spin = {} }

local function inspectName(info, config)
	local item = info.item
	local entry = config.bySide[info.team == "T" and "T" or "CT"] or {}
	local defaults = Inspect.defaults
	if item == "Knife" then return entry.knife or (defaults and defaults.knife(info.team == "T" and "T" or "CT")) or Skins.knives[1] end
	if item == "Gloves" then return entry.glove or (defaults and defaults.glove(info.team == "T" and "T" or "CT")) end
	if item == "Agent" or item == "Charm" or item == "Badge" then return nil end
	return Skins.resolve(item)
end

function Inspect.build(world, camera, info, config, wearFloat)
	world:ClearAllChildren()
	local viewport = camera.Parent
	local token = (Inspect.spin[viewport] and Inspect.spin[viewport].token or 0) + 1
	local state = { token = token, yaw = 0, pitch = 0, drag = false }
	Inspect.spin[viewport] = state

	local model
	if info.item == "Agent" then
		local side = info.team == "T" and "T" or "CT"
		local source = Agents.find(side)
		model = source and cloneOf(source)
		if model then
			Agents.rig(model)
			model:SetAttribute("NeverloseSide", side)
			model.Parent = world
			Agents.play(model, idleAnimation(side))
		end
	else
		local weapon = inspectName(info, config)
		local skinsLib = Game.modules.skins
		local pick = info.pick or {}
		local entry = config.bySide[info.team == "T" and "T" or "CT"] or {}
		if info.item == "Charm" or info.item == "Badge" then
			local name = pick.skin
			if name == nil then name = info.item == "Charm" and entry.charm or entry.badge end
			if name and name ~= "No Skin" and skinsLib then
				local ok, result
				if info.item == "Charm" then ok, result = asGame(skinsLib.GetCharmModel, name, 1) else ok, result = asGame(skinsLib.GetBadgeModel, name) end
				if ok and typeof(result) == "Instance" then model = result end
			end
		elseif weapon and skinsLib and info.item == "Gloves" and skinsLib.GetGloves then
			local skin = pick.skin
			if not skin or skin == "No Skin" then skin = "Stock" end
			local float = type(pick.wearFloat) == "number" and pick.wearFloat or wearFloat[pick.wear or "Factory New"] or 0.03
			local ok, result = asGame(skinsLib.GetGloves, weapon, skin, float)
			if ok and typeof(result) == "Instance" then model = result end
		elseif weapon and skinsLib and skinsLib.GetInspectModel then
			local skin = pick.skin
			if not skin or skin == "No Skin" then skin = "Stock" end
			local float = type(pick.wearFloat) == "number" and pick.wearFloat or wearFloat[pick.wear or "Factory New"] or 0.03
			local charmArg = entry.charm and { _id = "nl", Position = "1", Skin = entry.charm, Pattern = 1 } or nil
			local ok, result = asGame(skinsLib.GetInspectModel, weapon, skin, float, nil, nil, charmArg)
			if ok and typeof(result) == "Instance" then model = result end
		end
		if model then
			for _, object in ipairs(model:GetDescendants()) do
				if object:IsA("BasePart") then object.Anchored = true end
			end
			model.Parent = world
		end
	end
	if not model then return end

	local pivot = model:GetPivot()
	local _, size = Agents.visibleBox(model)

	local base = info.item == "Agent" and CFrame.Angles(0, math.pi, 0) or (size.Z > size.X and CFrame.Angles(0, math.rad(90), 0) or CFrame.identity)
	model:PivotTo(base * pivot.Rotation)
	local cframe, box = Agents.visibleBox(model)
	model:PivotTo(model:GetPivot() + (Vector3.zero - cframe.Position))

	local center = model:GetPivot()
	local radius = math.sqrt(box.X * box.X + box.Y * box.Y + box.Z * box.Z) / 2
	local function refit()
		local area = viewport.AbsoluteSize
		local aspect = (area.X > 0 and area.Y > 0) and area.X / area.Y or 1.5
		local vertical = math.tan(math.rad(camera.FieldOfView / 2))
		local horizontal = vertical * aspect

		local zoom = 0.78 + 0.22 * math.clamp((area.X - 420) / 700, 0, 1)
		local halfHeight = box.Y / 2
		local halfReach = info.item == "Agent" and math.max(box.X, box.Z) / 2 or math.sqrt(box.X * box.X + box.Z * box.Z) / 2
		local need = math.max(halfHeight * 1.1 / vertical, halfReach * 1.1 / horizontal)
		camera.CFrame = CFrame.new(Vector3.new(0, 0, need * zoom + halfReach), Vector3.zero)
	end
	local function turn()
		model:PivotTo(CFrame.Angles(state.pitch, 0, 0) * CFrame.Angles(0, state.yaw, 0) * center)
	end
	refit()

	local dragging, lastX, lastY = false, 0, 0
	local began = viewport.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging, lastX, lastY = true, input.Position.X, input.Position.Y end
	end)
	local ended = userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	local moved = userInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			state.yaw += (input.Position.X - lastX) * 0.012
			state.pitch += (input.Position.Y - lastY) * 0.012
			lastX, lastY = input.Position.X, input.Position.Y
		end
	end)
	local clock = os.clock()
	local step
	step = runService.RenderStepped:Connect(function()
		if Inspect.spin[viewport] ~= state or not model.Parent then
			step:Disconnect() began:Disconnect() ended:Disconnect() moved:Disconnect()
			return
		end
		turn()
		refit()
	end)
	maid:give(function() pcall(function() step:Disconnect() began:Disconnect() ended:Disconnect() moved:Disconnect() end) end)
end

function Inspect.show(...)
	local ok, err = pcall(Inspect.build, ...)
	if not ok then Neverlose.inspectError = tostring(err) end
end
