Neverlose.cbTags = setmetatable({}, { __mode = "k" })

function set(tbl, key)
	local callback = function(value) tbl[key] = value end
	Neverlose.cbTags[callback] = { tbl = tbl, key = key }
	return callback
end

local function setColor(tbl, key)
	local callback = function(color) tbl[key] = color end
	Neverlose.cbTags[callback] = { tbl = tbl, key = key }
	return callback
end

---Wrap a menu section so every control built on a light setting is remembered by key.
function Neverlose.presetTrack(section)
	return setmetatable({}, { __index = function(_, name)
		local member = section[name]
		if type(member) ~= "function" then return member end
		return function(_, ...)
			local result = member(section, ...)
			if type(result) ~= "table" then return result end
			for index = 1, select("#", ...) do
				local tag = Neverlose.cbTags[select(index, ...)]
				if tag and tag.tbl == Neverlose.config.world.light and not Neverlose.presetControls[tag.key] then
					Neverlose.presetControls[tag.key] = result
				end
			end
			return Neverlose.presetTrack(result)
		end
	end })
end
Neverlose.presetControls = {}

---Copy every plain ambience value of the live config.
function Neverlose.presetSnapshot()
	local out = {}
	for key, value in pairs(Neverlose.config.world.light) do
		if type(value) ~= "table" then out[key] = value end
	end
	return out
end

---Write a saved preset into the config and into the controls on the page.
function Neverlose.presetApply(data)
	local light = Neverlose.config.world.light
	for key, value in pairs(data) do
		if light[key] ~= nil and typeof(light[key]) == typeof(value) then
			light[key] = value
			local control = Neverlose.presetControls[key]
			if control then pcall(function() control:Set(value) end) end
		end
	end
end

---Switch the edited preset: store the live values under the old one, load the new one.
function Neverlose.presetSelect(name)
	local presets = Neverlose.config.world.mapPresets
	local previous = Neverlose.presetSelected or "Global"
	if previous == name then return end
	presets[previous] = Neverlose.presetSnapshot()
	Neverlose.presetSelected = name
	if presets[name] then Neverlose.presetApply(presets[name]) end
end

---Thumbnail of a map from the game's own map database.
function Neverlose.mapIcon(name)
	local cached = Neverlose.mapIcons and Neverlose.mapIcons[name]
	if cached ~= nil then return cached or nil end
	Neverlose.mapIcons = Neverlose.mapIcons or {}
	local icon = false
	pcall(function()
		local module = replicatedStorage.Database.Custom.GameStats.Maps:FindFirstChild(name == "Main Menu" and "Seaside" or name)
		local data = module and require(module)
		if type(data) == "table" and type(data.Icon) == "string" and data.Icon ~= "" then icon = data.Icon end
	end)
	Neverlose.mapIcons[name] = icon
	return icon or nil
end

---Put the map photo behind a list card.
function Neverlose.decorateMapCard(card)
	if card.Name ~= "ListCard" or card:FindFirstChild("MapArt") then return end
	local label = card:FindFirstChild("ListName")
	if not label then return end
	local art
	if label.Text == "Global" then
		local shots = {}
		for _, mapName in ipairs({ "Oasis", "Office", "Reactor", "Skyline", "Seaside" }) do
			local shot = Neverlose.mapIcon(mapName)
			if shot then shots[#shots + 1] = shot end
		end
		if #shots == 0 then return end
		art = newInstance("CanvasGroup", { Name = "MapArt", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1 }, card)
		newInstance("UICorner", { CornerRadius = UDim.new(0, 10) }, art)
		local width = 1 / #shots
		for index, shot in ipairs(shots) do
			newInstance("ImageLabel", {
				Position = UDim2.fromScale((index - 1) * width, 0), Size = UDim2.fromScale(width, 1), BackgroundTransparency = 1, Image = shot,
				ScaleType = Enum.ScaleType.Crop, ImageColor3 = Color3.fromRGB(150, 150, 160), ZIndex = 1,
			}, art)
			if index > 1 then
				newInstance("Frame", {
					Position = UDim2.new((index - 1) * width, -1, 0, 0), Size = UDim2.new(0, 2, 1, 0), BackgroundColor3 = Color3.fromRGB(12, 13, 19),
					BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 2,
				}, art)
			end
		end
		newInstance("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.3) }),
		}, art)
		newInstance("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 11, 16), BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 2,
		}, art)
	else
		local icon = Neverlose.mapIcon(label.Text)
		if not icon then return end
		art = newInstance("ImageLabel", {
			Name = "MapArt", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = icon, ScaleType = Enum.ScaleType.Crop,
			ImageColor3 = Color3.fromRGB(150, 150, 160), ImageTransparency = 1, ZIndex = 1,
		}, card)
		newInstance("UICorner", { CornerRadius = UDim.new(0, 10) }, art)
		newInstance("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.45, 0.45), NumberSequenceKeypoint.new(1, 0.2) }),
		}, art)
		tweenService:Create(art, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { ImageTransparency = 0 }):Play()
	end
	for _, child in ipairs(card:GetChildren()) do
		if child:IsA("GuiObject") and child ~= art then child.ZIndex = 3 end
	end
	label.TextColor3 = Color3.fromRGB(240, 242, 250)
end

---Find the list's cards in the menu and keep decorating them as they are rebuilt.
function Neverlose.watchMapCards()
	task.defer(function()
		local first
		for _, root in ipairs({ hiddenRoot, service("CoreGui") }) do
			for _, descendant in ipairs(root:GetDescendants()) do
				if descendant.Name == "ListCard" then first = descendant break end
			end
			if first then break end
		end
		local holder = first and first.Parent
		if not holder then return end
		for _, card in ipairs(holder:GetChildren()) do Neverlose.decorateMapCard(card) end
		maid:give(holder.ChildAdded:Connect(function(card)
			task.defer(function() task.wait() if card.Parent then Neverlose.decorateMapCard(card) end end)
		end))
	end)
end

