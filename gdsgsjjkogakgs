Neverlose.cbTags = setmetatable({}, { __mode = "k" })

function set(tbl, key)
	local callback = function(value)
		tbl[key] = value
		-- Ручная правка рейджевого слайдера: автопрофиль больше это поле не трогает.
		if tbl == Neverlose.config.rage and not Neverlose.groupSwitching then
			local manual = tbl.manualFields
			if type(manual) ~= "table" then manual = {} tbl.manualFields = manual end
			manual[key] = true
		end
	end
	Neverlose.cbTags[callback] = { tbl = tbl, key = key }
	return callback
end

function Neverlose.styleColor(plate, text, options, tbl, styleKey, colorKey, fallback)
	local current = tbl[styleKey]
	if table.find(options, current) == nil then current = fallback or options[1] end
	local onColor = function(color) tbl[colorKey] = color end
	Neverlose.cbTags[onColor] = { tbl = tbl, key = colorKey }
	local control = plate:AddDropdownColorpicker(text, options, tbl[colorKey], set(tbl, styleKey), onColor)
	control:Set(current)
	Neverlose.rb(control, tbl, colorKey)
	return control
end


-- Rainbow для пикеров: Rainbow/Speed лежат внутри самого пикера (AddPickerOptions), цвет с радугой считает библиотека.
Neverlose.rainbowEntries = Neverlose.rainbowEntries or {}
function Neverlose.rb(control, tbl, key, speed)
	if type(control) ~= "table" or type(control.AddPickerOptions) ~= "function" then return control end
	local ok = pcall(function()
		control:AddPickerOptions({
			{ Type = "Toggle", Name = "Rainbow", Default = false },
			{ Type = "Slider", Name = "Speed", Min = 0, Max = 10, Default = speed or 3, DependsOn = "Rainbow" },
		})
	end)
	if ok then table.insert(Neverlose.rainbowEntries, { control = control, tbl = tbl, key = key, on = false }) end
	return control
end
function Neverlose.rainbowStart()
	local last = 0
	maid:give(runService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - last < 1 / 30 then return end
		last = now
		for _, entry in ipairs(Neverlose.rainbowEntries) do
			pcall(function()
				local control = entry.control
				if control:GetPickerOption("Rainbow") == true then
					entry.on = true
					entry.tbl[entry.key] = control:GetColor()
				elseif entry.on then
					entry.on = false
					entry.tbl[entry.key] = control:GetColor()
				end
			end)
		end
	end))
end

local function setColor(tbl, key)
	local callback = function(color) tbl[key] = color end
	Neverlose.cbTags[callback] = { tbl = tbl, key = key }
	return callback
end

---Wrap a menu section so every control built on a light setting is remembered by key.
function Neverlose.presetTrack(section)
	return setmetatable({}, { __index = function(_, name)
		local member = section[name]
		if type(member) ~= "function" then return member end
		return function(_, ...)
			local result = member(section, ...)
			if type(result) ~= "table" then return result end
			for index = 1, select("#", ...) do
				local tag = Neverlose.cbTags[select(index, ...)]
				if tag and tag.tbl == Neverlose.config.world.light and not Neverlose.presetControls[tag.key] then
					Neverlose.presetControls[tag.key] = result
				end
			end
			return Neverlose.presetTrack(result)
		end
	end })
end
Neverlose.presetControls = {}

---Copy every plain ambience value of the live config.
function Neverlose.presetSnapshot()
	local out = {}
	for key, value in pairs(Neverlose.config.world.light) do
		if type(value) ~= "table" then out[key] = value end
	end
	return out
end

---Write a saved preset into the config and into the controls on the page.
function Neverlose.presetApply(data)
	local light = Neverlose.config.world.light
	for key, value in pairs(data) do
		if light[key] ~= nil and typeof(light[key]) == typeof(value) then
			light[key] = value
			local control = Neverlose.presetControls[key]
			if control then pcall(function() control:Set(value) end) end
		end
	end
end

---Switch the edited preset: store the live values under the old one, load the new one.
function Neverlose.presetSelect(name)
	local presets = Neverlose.config.world.mapPresets
	local previous = Neverlose.presetSelected or "Global"
	if previous == name then return end
	presets[previous] = Neverlose.presetSnapshot()
	Neverlose.presetSelected = name
	if presets[name] then Neverlose.presetApply(presets[name]) end
end

---Thumbnail of a map from the game's own map database.
function Neverlose.mapIcon(name)
	local cached = Neverlose.mapIcons and Neverlose.mapIcons[name]
	if cached ~= nil then return cached or nil end
	Neverlose.mapIcons = Neverlose.mapIcons or {}
	local icon = false
	pcall(function()
		local module = replicatedStorage.Database.Custom.GameStats.Maps:FindFirstChild(name == "Main Menu" and "Seaside" or name)
		local data = module and require(module)
		if type(data) == "table" and type(data.Icon) == "string" and data.Icon ~= "" then icon = data.Icon end
	end)
	Neverlose.mapIcons[name] = icon
	return icon or nil
end

---Put the map photo behind a list card.
function Neverlose.decorateMapCard(card)
	if card.Name ~= "ListCard" or card:FindFirstChild("MapArt") then return end
	local label = card:FindFirstChild("ListName")
	if not label then return end
	local art
	if label.Text == "Global" then
		local shots = {}
		for _, mapName in ipairs({ "Oasis", "Office", "Reactor", "Skyline", "Seaside" }) do
			local shot = Neverlose.mapIcon(mapName)
			if shot then shots[#shots + 1] = shot end
		end
		if #shots == 0 then return end
		art = newInstance("CanvasGroup", { Name = "MapArt", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1 }, card)
		newInstance("UICorner", { CornerRadius = UDim.new(0, 10) }, art)
		local width = 1 / #shots
		for index, shot in ipairs(shots) do
			newInstance("ImageLabel", {
				Position = UDim2.fromScale((index - 1) * width, 0), Size = UDim2.fromScale(width, 1), BackgroundTransparency = 1, Image = shot,
				ScaleType = Enum.ScaleType.Crop, ImageColor3 = Color3.fromRGB(150, 150, 160), ZIndex = 1,
			}, art)
			if index > 1 then
				newInstance("Frame", {
					Position = UDim2.new((index - 1) * width, -1, 0, 0), Size = UDim2.new(0, 2, 1, 0), BackgroundColor3 = Color3.fromRGB(12, 13, 19),
					BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 2,
				}, art)
			end
		end
		newInstance("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.3) }),
		}, art)
		newInstance("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 11, 16), BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 2,
		}, art)
	else
		local icon = Neverlose.mapIcon(label.Text)
		if not icon then return end
		art = newInstance("ImageLabel", {
			Name = "MapArt", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = icon, ScaleType = Enum.ScaleType.Crop,
			ImageColor3 = Color3.fromRGB(150, 150, 160), ImageTransparency = 1, ZIndex = 1,
		}, card)
		newInstance("UICorner", { CornerRadius = UDim.new(0, 10) }, art)
		newInstance("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.45, 0.45), NumberSequenceKeypoint.new(1, 0.2) }),
		}, art)
		tweenService:Create(art, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { ImageTransparency = 0 }):Play()
	end
	for _, child in ipairs(card:GetChildren()) do
		if child:IsA("GuiObject") and child ~= art then child.ZIndex = 3 end
	end
	label.TextColor3 = Color3.fromRGB(240, 242, 250)
end

---Find the list's cards in the menu and keep decorating them as they are rebuilt.
function Neverlose.watchMapCards()
	task.defer(function()
		local first
		for _, root in ipairs({ hiddenRoot, service("CoreGui") }) do
			for _, descendant in ipairs(root:GetDescendants()) do
				if descendant.Name == "ListCard" then first = descendant break end
			end
			if first then break end
		end
		local holder = first and first.Parent
		if not holder then return end
		for _, card in ipairs(holder:GetChildren()) do Neverlose.decorateMapCard(card) end
		maid:give(holder.ChildAdded:Connect(function(card)
			task.defer(function() task.wait() if card.Parent then Neverlose.decorateMapCard(card) end end)
		end))
	end)
end

---Small popup next to the cursor with Copy / Delete for a preset.
function Neverlose.presetMenu(name, canDelete, callback)
	if Neverlose.presetPopup then Neverlose.presetPopup:Destroy() end
	local mouse = userInputService:GetMouseLocation()
	local target = UDim2.fromOffset(mouse.X - 104, mouse.Y + 8)
	local popup = newInstance("CanvasGroup", {
		Name = "PresetMenu", Position = target + UDim2.fromOffset(0, -8), Size = UDim2.fromOffset(118, canDelete and 74 or 41), GroupTransparency = 1,
		BackgroundColor3 = Color3.fromRGB(20, 21, 29), BorderSizePixel = 0, ZIndex = 50, Active = true,
	}, uiRoot)
	Neverlose.presetPopup = popup
	newInstance("UICorner", { CornerRadius = UDim.new(0, 10) }, popup)
	newInstance("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.9, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, popup)
	tweenService:Create(popup, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { GroupTransparency = 0, Position = target }):Play()
	local connection
	local closing = false
	local function close()
		if closing then return end
		closing = true
		if connection then connection:Disconnect() end
		if Neverlose.presetPopup == popup then Neverlose.presetPopup = nil end
		tweenService:Create(popup, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1, Position = target + UDim2.fromOffset(0, -6) }):Play()
		task.delay(0.16, function() if popup.Parent then popup:Destroy() end end)
	end
	local function drawIcon(parent, action, color)
		local box = newInstance("Frame", { Position = UDim2.fromOffset(12, 7), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ZIndex = 52 }, parent)
		if action == "Copy" then
			newInstance("Frame", { Position = UDim2.fromOffset(4, 0), Size = UDim2.fromOffset(9, 9), BackgroundTransparency = 1, ZIndex = 52 }, box)
			newInstance("UIStroke", { Color = color, Thickness = 1.4 }, box.Frame)
			newInstance("UICorner", { CornerRadius = UDim.new(0, 2) }, box.Frame)
			local back = newInstance("Frame", { Position = UDim2.fromOffset(0, 4), Size = UDim2.fromOffset(9, 9), BackgroundColor3 = Color3.fromRGB(20, 21, 29), ZIndex = 53 }, box)
			newInstance("UIStroke", { Color = color, Thickness = 1.4 }, back)
			newInstance("UICorner", { CornerRadius = UDim.new(0, 2) }, back)
		else
			newInstance("Frame", { Position = UDim2.fromOffset(2, 4), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 52 }, box)
			newInstance("UIStroke", { Color = color, Thickness = 1.4 }, box.Frame)
			newInstance("UICorner", { CornerRadius = UDim.new(0, 2) }, box.Frame)
			newInstance("Frame", { Position = UDim2.fromOffset(0, 1), Size = UDim2.fromOffset(14, 2), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 52 }, box)
			newInstance("Frame", { Position = UDim2.fromOffset(5, -1), Size = UDim2.fromOffset(4, 2), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 52 }, box)
		end
	end
	for index, action in ipairs(canDelete and { "Copy", "Delete" } or { "Copy" }) do
		local color = action == "Delete" and Color3.fromRGB(255, 110, 120) or Color3.fromRGB(226, 228, 236)
		local button = newInstance("TextButton", {
			Position = UDim2.new(0, 5, 0, 5 + (index - 1) * 33), Size = UDim2.new(1, -10, 0, 30), BackgroundTransparency = 1,
			BackgroundColor3 = color, Text = "", AutoButtonColor = false, ZIndex = 51,
		}, popup)
		newInstance("UICorner", { CornerRadius = UDim.new(0, 7) }, button)
		drawIcon(button, action, color)
		newInstance("TextLabel", {
			Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -42, 1, 0), BackgroundTransparency = 1, Text = action, TextColor3 = color,
			TextSize = 14, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 52,
		}, button)
		button.MouseEnter:Connect(function() tweenService:Create(button, TweenInfo.new(0.12), { BackgroundTransparency = 0.88 }):Play() end)
		button.MouseLeave:Connect(function() tweenService:Create(button, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play() end)
		button.MouseButton1Click:Connect(function()
			close()
			callback(action)
		end)
	end
	task.defer(function()
		if closing or not popup.Parent then return end
		connection = userInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
			local position = userInputService:GetMouseLocation()
			local at, size = popup.AbsolutePosition, popup.AbsoluteSize
			if position.X < at.X or position.X > at.X + size.X or position.Y < at.Y or position.Y > at.Y + size.Y then close() end
		end)
		maid:give(connection)
	end)
end

