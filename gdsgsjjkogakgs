	PeekAssist:AddSettings():AddDropdown("Return After", { "Shot", "Kill", "Never" }, rage.peekReturn, set(rage, "peekReturn"))
	local RapidFire = RageOther:AddToggle("Rapid Fire", rage.rapidFire, set(rage, "rapidFire"))
