-- Возвращает цвет стиля и добавку к прозрачности заливки.
function Neverlose.styleFx(mode, color)
	local fx = Neverlose.STYLE_FX[mode]
	if not fx then return color, 0 end
	local now = os.clock()
	local out, delta = color, 0
	if fx.tint then
		local amount = fx.amt
		if fx.wave then amount = amount * (0.5 + 0.5 * math.sin(now * fx.wave * 2)) end
		out = out:Lerp(fx.tint, amount)
	end
	if fx.hue then
		local h, sat, val = out:ToHSV()
		out = Color3.fromHSV((h + fx.hue * math.sin(now * 0.9)) % 1, sat, val)
	end
	if fx.flicker then delta = -0.2 * math.max(0, math.sin(now * fx.flicker)) end
	if fx.strobe then delta = math.sin(now * fx.strobe * math.pi) > 0 and 0.55 or 0 end
	return out, delta
end

BodyMat = {}

-- Тонировка части: цвет стиля, подсвеченный яркостью оригинала (flat: ровный цвет без тонировки).
local function bodyTint(original, color, flat)
	local shade = flat and 1 or math.clamp(0.5 + 0.9 * (original.R * 0.3 + original.G * 0.59 + original.B * 0.11), 0.4, 1.15)
	return Color3.new(math.min(color.R * shade, 1), math.min(color.G * shade, 1), math.min(color.B * shade, 1))
end

function BodyMat.one(store, object, material, color, alpha, reflectance, flat)
	if object:IsA("BasePart") then
		local saved = store[object]
		if not saved then
			if object.Name == "HumanoidRootPart" or object.Transparency >= 0.99 then return end
			saved = {
				Material = object.Material, Color = object.Color,
				Transparency = object.Transparency, Reflectance = object.Reflectance,
			}
			if object:IsA("MeshPart") then saved.TextureID = object.TextureID end
			store[object] = saved
		end
		object.Material = material
		object.Color = bodyTint(saved.Color, color, flat)
		if object:IsA("MeshPart") then object.TextureID = "" end
		object.Transparency = alpha and math.max(saved.Transparency, alpha) or saved.Transparency
		-- Глянец: чем выше reflectance, тем ярче отражённый свет/блик.
		object.Reflectance = reflectance or saved.Reflectance or 0
	elseif object:IsA("Decal") or object:IsA("Texture") then
		if not store[object] then store[object] = { Transparency = object.Transparency } end
		object.Transparency = 1
	elseif object:IsA("SpecialMesh") then
		if not store[object] then store[object] = { MeshTexture = object.TextureId } end
		object.TextureId = ""
	elseif object:IsA("SurfaceAppearance") or object:IsA("Clothing") or object:IsA("ShirtGraphic") then
		if not store[object] then store[object] = { Parent = object.Parent } end
		object.Parent = nil
	end
end

function BodyMat.scan(store, model, material, color, alpha, reflectance, flat)
	BodyMat.one(store, model, material, color, alpha, reflectance, flat)
	for _, object in ipairs(model:GetDescendants()) do BodyMat.one(store, object, material, color, alpha, reflectance, flat) end
end

-- Смена цвета без полного восстановления и пересканирования: красим уже сохранённые части.
function BodyMat.recolor(store, color, flat)
	for object, saved in pairs(store) do
		if saved.Material and saved.Color and object.Parent then object.Color = bodyTint(saved.Color, color, flat) end
	end
end

function BodyMat.restore(store)
	for object, saved in pairs(store) do
		pcall(function()
			if saved.Parent then
				object.Parent = saved.Parent
			elseif saved.MeshTexture ~= nil then
				object.TextureId = saved.MeshTexture
			elseif saved.Material then
				object.Material, object.Color, object.Transparency = saved.Material, saved.Color, saved.Transparency
				if saved.Reflectance then object.Reflectance = saved.Reflectance end
				if saved.TextureID ~= nil then object.TextureID = saved.TextureID end
			elseif saved.Transparency ~= nil then
				object.Transparency = saved.Transparency
			end
		end)
	end
	table.clear(store)
end

function BodyMat.drive(state, model, style, color)
	if not (style and style.material and model) then
		if state.key then
			BodyMat.restore(state.store)
			state.key, state.char = nil, nil
		end
		return
	end
	local key = tostring(style.material) .. "|" .. tostring(style.reflectance) .. "|" .. tostring(style.alpha) .. "|" .. tostring(style.flat)
	if state.key ~= key or state.char ~= model then
		BodyMat.restore(state.store)
		state.key, state.char, state.scan, state.color = key, model, 0, nil
	end
	local now = os.clock()
	if now - state.scan > 0.4 then
		state.scan = now
		state.color = color
		BodyMat.scan(state.store, model, style.material, color, style.alpha, style.reflectance, style.flat)
	elseif state.color ~= color then
		state.color = color
		BodyMat.recolor(state.store, color, style.flat)
	end
end

local iconCache = {}
local function iconAsset(value)
	if value == nil then return "" end
	local text = tostring(value)
	if text == "" then return "" end
	if text:find("rbxasset", 1, true) or text:find("rbxthumb", 1, true) or text:find("https://", 1, true) then return text end
	local digits = text:match("%d+")
	return digits and ("rbxassetid://" .. digits) or ""
end
local function iconFromEntry(entry)
	if type(entry) ~= "table" then return nil, nil end
	local asset = iconAsset(entry.image)
	if asset == "" and type(entry.wearImages) == "table" then
		local wear = entry.wearImages[1]
		asset = iconAsset(type(wear) == "table" and wear.assetId or wear)
	end
	if asset == "" then return nil, nil end
	return asset, entry.skin
end
local function iconFromList(list)
	if type(list) ~= "table" then return "" end
	local first
	for _, entry in pairs(list) do
		local asset, skin = iconFromEntry(entry)
		if asset then
			if skin == "Stock" then return asset end
			first = first or asset
		end
	end
	return first or ""
end
function weaponIcon(name, allowFallback)
	if type(name) ~= "string" or name == "" then return "" end
	local hit = iconCache[name]
	if hit and hit.image ~= "" then return hit.image end
	if hit and os.clock() - hit.at < 1.5 then return "" end
	local resolved = name
	if type(Skins) == "table" and type(Skins.resolve) == "function" then
		local ok, value = pcall(Skins.resolve, name)
		if ok and type(value) == "string" and value ~= "" then resolved = value end
	end
	local image = ""
	if type(Skins) == "table" and type(Skins.forWeapon) == "function" then
		local ok, list = pcall(Skins.forWeapon, resolved)
		if ok then image = iconFromList(list) end
	end
	if image == "" then
		local skins = Game.modules.skins
		if skins and type(skins.GetAllSkinsForWeapon) == "function" then
			for _, candidate in ipairs({ resolved, name }) do
				local ok, list = pcall(skins.GetAllSkinsForWeapon, candidate)
				if ok then image = iconFromList(list) end
				if image ~= "" then break end
			end
		end
	end
	if image == "" and allowFallback and type(Skins) == "table" and type(Skins.forWeapon) == "function" then
		for _, candidate in ipairs({ "AK-47", "M4A4", "AWP", "USP-S", "Glock-18", "Desert Eagle" }) do
			local ok, list = pcall(Skins.forWeapon, candidate)
			if ok then image = iconFromList(list) end
			if image ~= "" then break end
		end
	end
	if image == "" and allowFallback then image = "rbxassetid://93001822915827" end
	iconCache[name] = { image = image, at = os.clock() }
	return image
end

