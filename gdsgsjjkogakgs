---Body part name -> English phrase used by the hit log.
local PART_PHRASE = {
	Head = "head",
	UpperTorso = "chest",
	LowerTorso = "stomach",
	LeftUpperArm = "left arm", LeftLowerArm = "left arm", LeftHand = "left hand",
	RightUpperArm = "right arm", RightLowerArm = "right arm", RightHand = "right hand",
	LeftUpperLeg = "left leg", LeftLowerLeg = "left leg", LeftFoot = "left foot",
	RightUpperLeg = "right leg", RightLowerLeg = "right leg", RightFoot = "right foot",
}

local function bodyPhrase(name)
	local key = tostring(name or ""):gsub("Hitbox$", "")
	return PART_PHRASE[key] or "body"
end

local ShotTracker, originalSend, Killfeed
do
ShotTracker = { pending = {} }
Neverlose.ShotTracker = ShotTracker

local function snapshot(character)
	local cframes, sizes = {}, {}
	for _, name in ipairs(BODY_PARTS) do
		local part = character:FindFirstChild(name)
		if part then cframes[name], sizes[name] = part.CFrame, part.Size end
	end
	return cframes, sizes
end

-- Диагностика промахов (только учёт, на поведение выстрелов не влияет). Всё O(1) на выстрел,
-- никаких проходов по данным каждый кадр; запись файла остаётся в logMiss как раньше.
ShotTracker.PING_LABELS = { "<60", "60-120", "120-180", "180+" }

function ShotTracker.pingBucket(ms)
	if ms < 60 then return 1 elseif ms < 120 then return 2 elseif ms < 180 then return 3 end
	return 4
end

---Снимает пинг / плечо лидирования / предикт / путь / время жизни цели в момент выстрела.
function ShotTracker.stamp(shot, info, entity)
	local rage = Neverlose.Rage
	local now = os.clock()
	shot.ping = (rage and rage.pingMs and tonumber(rage.pingMs())) or 0
	local meta = rage and rage.shotMeta
	if meta and now - meta.at < 0.5 then
		shot.arm, shot.armFactor, shot.leadMag = meta.arm, meta.factor, meta.lead
		shot.predicted, shot.predMag = meta.predicted, meta.predMag
	end
	shot.predOn = rage and rage.predictAim == true
	if not info then shot.path = "manual"
	elseif info.instant then shot.path = "instant"
	elseif info.direct then shot.path = "direct"
	elseif rage and now - (rage.clickAt or -1) < 0.3 then shot.path = "click"
	else shot.path = "silent" end
	local vis = rage and rage.visTrack
	if vis and vis.entity == entity and now - vis.last < 0.3 then shot.seenMs = (now - vis.since) * 1000 end
end

---Короткий хвост для строки отчёта: пинг | лидирование | предикт | путь | время цели в кадре.
function ShotTracker.tag(shot)
	local lead = shot.arm and ("x%.1f #%d %.1fst"):format(shot.armFactor or 0, shot.arm, shot.leadMag or 0) or "-"
	local pred = shot.predicted and ("yes %.1fst"):format(shot.predMag or 0) or (shot.predOn and "no(on)" or "off")
	return ("ping %d | lead %s | pred %s | path %s | seen %s"):format(
		math.floor((shot.ping or 0) + 0.5), lead, pred, tostring(shot.path or "?"), shot.seenMs and (math.floor(shot.seenMs + 0.5) .. "ms") or "-")
end

---Счётчики попаданий/выстрелов по ведрам пинга, плечу лидирования, пути и предикту.
function ShotTracker.account(shot, hit)
	local stats = Neverlose.stats or {}
	Neverlose.stats = stats
	local function bump(group, key)
		local bucket = group[key]
		if not bucket then bucket = { n = 0, h = 0 } group[key] = bucket end
		bucket.n += 1
		if hit then bucket.h += 1 end
	end
	stats.pingB, stats.leadB, stats.pathB, stats.predB = stats.pingB or {}, stats.leadB or {}, stats.pathB or {}, stats.predB or {}
	bump(stats.pingB, ShotTracker.pingBucket(shot.ping or 0))
	bump(stats.leadB, shot.arm or 0)
	bump(stats.pathB, shot.path or "?")
	bump(stats.predB, shot.predicted and "yes" or "no")
end

function ShotTracker.register(origin, direction, hits, range, tap, expect, info)
	local last = hits[#hits]
	local finish = last and last.Position or origin + direction * range
	local enemyEntity, enemyPart

	for _, hit in ipairs(hits) do
		local entity = hit.Instance and Game.ownerOf(hit.Instance)
		if entity and entity ~= localPlayer and Game.isEnemy(entity, true) then
			enemyEntity, enemyPart = entity, hit.Instance
			finish = hit.Position
			break
		end
	end

	if not enemyEntity and info and info.entity and info.entity.Parent then
		enemyEntity, enemyPart = info.entity, { Name = info.part or "Body" }
		info.blocked = true
	end

	HitEffects.tracer(origin, finish, last ~= nil, last and last.Normal, hits)

	if enemyEntity then
		local character = enemyEntity.Character
		local wallCount, wallParts = 0, {}
		for _, hit in ipairs(hits) do
			if hit.Instance == enemyPart then break end
			if not hit.Exit then
				wallCount += 1
				wallParts[#wallParts + 1] = hit.Instance
			end
		end
		local heldWeapon = Game.weapon()

		local previous = ShotTracker.pending[enemyEntity]
		if tap == 2 and previous and previous.taps == 1 and os.clock() - previous.t < 0.3 then

			previous.taps, previous.expect, previous.t = 2, expect, os.clock()
		elseif previous and previous.taps == 1 and tap ~= 2 and os.clock() - previous.t < 0.35 and os.clock() - (previous.first or previous.t) < 0.6 then
			previous.t, previous.shots = os.clock(), (previous.shots or 1) + 1
			previous.part, previous.hitPos, previous.info = enemyPart.Name, finish, info or previous.info
		else
			if previous then ShotTracker.flushPending(enemyEntity, previous) end
			ShotTracker.pending[enemyEntity] = {
				t = os.clock(), first = os.clock(), part = enemyPart.Name, character = character, taps = 1, expect = expect,
				walls = wallCount, wallParts = wallParts, weapon = heldWeapon and heldWeapon.Name,
				hp = character and character:GetAttribute("Health") or 100,
				info = info, origin = origin, hitPos = finish,
				pos0 = character and character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.Position or nil,
			}
			pcall(ShotTracker.stamp, ShotTracker.pending[enemyEntity], info, enemyEntity)
		end

		local onShot = Neverlose.config.esp.enemyModel.onShot
		if onShot.mode ~= "Disabled" and character then
			local cframes, sizes = snapshot(character)
			HitEffects.ghost(cframes, sizes, onShot.color, 1.2, onShot.mode == "Wireframe" and Enum.Material.ForceField or Enum.Material.Neon)
		end
	end
end

---Log a pending shot that is being replaced so its outcome is never silently lost.
function ShotTracker.flushPending(entity, shot)
	local character = shot.character
	local health = character and character:GetAttribute("Health")
	if type(health) == "number" and health < shot.hp then
		Logs.push("Combat", ("hit {%s} in the %s for {%d} damage ({%d} health left)"):format(tostring(entity.DisplayName or entity.Name), bodyPhrase(shot.part), shot.hp - health, math.max(math.floor(health + 0.5), 0)))
		Events.fire("hit", entity, shot, shot.hp - health)
	else
		ShotTracker.logMiss(entity, shot)
	end
end

---Log a missed shot with its reason and feed the miss back to the ragebot.
function ShotTracker.logMiss(entity, shot)
	if shot.character and shot.character.Parent and Game.isImmune(shot.character) then return end
	local name = tostring(entity.DisplayName or entity.Name)
	local reason, detail = ShotTracker.missReason(shot, entity)
	Logs.push("Combat", ("missed {%s} ({%s}) · {%s}%s"):format(name, shot.part, reason, detail))
	HitSounds.play("miss")
	pcall(function()
		local rage = Neverlose.Rage
		if rage and rage.recordShot then rage.recordShot(false) end
		local stats = Neverlose.stats or {}
		Neverlose.stats = stats
		pcall(ShotTracker.account, shot, false)
		stats.missBy = stats.missBy or {}
		stats.missBy[reason] = (stats.missBy[reason] or 0) + 1
		stats.missLog = stats.missLog or {}
		local info = shot.info or {}
		table.insert(stats.missLog, ("%s | %s | %s | hc %s | %s st | walls %s | mode %s | shift %s | speed %s"):format(
			tostring(shot.weapon), tostring(shot.part), reason, tostring(info.chance and math.floor(info.chance + 0.5)),
			tostring(info.distance and math.floor(info.distance + 0.5)), tostring(shot.walls or 0), tostring(info.mode),
			tostring(info.shiftMag and math.floor(info.shiftMag * 10 + 0.5) / 10), tostring(shot.speed and math.floor(shot.speed + 0.5))) .. (function()
				local names = {}
				for _, wallPart in ipairs(shot.wallParts or {}) do names[#names + 1] = tostring(wallPart.Material and wallPart.Material.Name) end
				return #names > 0 and (" | wall " .. table.concat(names, ",")) or ""
			end)() .. " | " .. ShotTracker.tag(shot))
		if #stats.missLog > 60 then table.remove(stats.missLog, 1) end
		if writefile then
			local lines = { "misses by reason:" }
			for key, count in pairs(stats.missBy) do lines[#lines + 1] = ("  %s: %d"):format(key, count) end
			lines[#lines + 1] = ("hits: %d  shots fired: %d  attempts: %d  refused before click: %d"):format((stats.hitCount or 0), stats.shots or 0, stats.attempts or 0, stats.refused or 0)
			for index, factor in ipairs(rage and rage.leadArms or {}) do
				local st = rage.leadStats[index]
				lines[#lines + 1] = ("lead x%.1f: %s/%s hits"):format(factor, st and tostring(st.h) or "0", st and tostring(st.n) or "0")
			end
			lines[#lines + 1] = ("origin cap: %s  wall ok/fail: %d/%d"):format(tostring(rage and rage.shiftCap), stats.wallOk or 0, stats.wallFail or 0)
			local function ratio(bucket)
				if not bucket or bucket.n == 0 then return "0/0" end
				return ("%d/%d (%d%%)"):format(bucket.h, bucket.n, math.floor(bucket.h / bucket.n * 100 + 0.5))
			end
			local parts = {}
			for index, label in ipairs(ShotTracker.PING_LABELS) do parts[#parts + 1] = ("%s ms: %s"):format(label, ratio(stats.pingB and stats.pingB[index])) end
			lines[#lines + 1] = "hits/shots by ping: " .. table.concat(parts, " | ")
			parts = { "none: " .. ratio(stats.leadB and stats.leadB[0]) }
			for index, factor in ipairs(rage and rage.leadArms or {}) do parts[#parts + 1] = ("#%d x%.1f: %s"):format(index, factor, ratio(stats.leadB and stats.leadB[index])) end
			lines[#lines + 1] = "hits/shots by lead arm (lifetime): " .. table.concat(parts, " | ")
			lines[#lines + 1] = ("hits/shots by path: direct %s | silent %s | click %s | manual %s"):format(
				ratio(stats.pathB and stats.pathB.direct), ratio(stats.pathB and stats.pathB.silent), ratio(stats.pathB and stats.pathB.click), ratio(stats.pathB and stats.pathB.manual))
			lines[#lines + 1] = ("hits/shots by predict: yes %s | no %s"):format(ratio(stats.predB and stats.predB.yes), ratio(stats.predB and stats.predB.no))
			lines[#lines + 1] = "last misses (weapon | part | reason | hit chance | distance | walls | mode | origin shift | target speed | ping | lead | pred | path | seen):"
			for _, line in ipairs(stats.missLog) do lines[#lines + 1] = line end
			lines[#lines + 1] = "last hits (weapon | part | damage | hit chance | distance | mode | origin shift | ping | lead | pred | path | seen); refreshed on each miss:"
			for _, line in ipairs(stats.hitLog or {}) do lines[#lines + 1] = line end
			writefile("nev_miss_report.txt", table.concat(lines, "\n"))
		end
	end)
	do
		local rage = Neverlose.Rage
		if rage then
			rage.missStreak = rage.missStreak or {}
			local streak = rage.missStreak[entity] or { n = 0 }
			streak.n, streak.t = streak.n + 1, os.clock()
			rage.missStreak[entity] = streak
		end
	end
	if shot.info and shot.info.mode == "rapid fire" and (shot.walls or 0) == 0 and not shot.info.blocked then Events.fire("rapidRejected") end
	if shot.taps == 2 then Events.fire("tapRejected", entity, shot) end
	Ballistics.wallResult(shot.weapon, shot.walls or 0, false, reason ~= "target died" and shot.wallParts or nil)
	if (shot.walls or 0) > 0 and shot.wallParts and reason ~= "target died" then
		local expires = os.clock() + 20
		for _, wallPart in ipairs(shot.wallParts) do Ballistics.blocked[wallPart] = expires end
	end
	-- Промах по смещённому origin — это чаще разброс или движущаяся цель, а не
	-- отказ сервера. Раньше он урезал радиус поиска и origin scan фактически
	-- выключался после пары промахов.
	if shot.info and shot.info.shifted and reason ~= "target died" and Neverlose.Rage then
		Neverlose.Rage.learnOrigin(false, shot.info.shiftMag)
		Neverlose.Rage.noteProbe(false, reason, shot.info.shiftMag)
		Neverlose.Rage.learnServerShift(false, reason, shot.info.shiftMag)
	end
end

function ShotTracker.missReason(shot, entity)
	local info = shot.info or {}
	local distance = info.distance or (shot.origin and shot.pos0 and (shot.pos0 - shot.origin).Magnitude) or 0
	local detail = ""
	if info.chance then detail = (" (hc {%d}%%, {%d} studs)"):format(math.floor(info.chance + 0.5), math.floor(distance + 0.5)) end
	local selfSpeed = 0
	local character = localPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local velocity = root.AssemblyLinearVelocity
		selfSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	end
	local dead = entity.Character and entity.Character:GetAttribute("Dead") == true

	if dead then return "target died", detail end
	if info.blocked then
		if (shot.walls or 0) > 0 then return "blocked by geometry", (" ({%d} obstacles)"):format(shot.walls) end
		return "shot missed the hitbox", detail
	end
	if info.direct and shot.taps == 2 then
		return "double tap not registered", (" (gap {%d}ms)"):format(math.floor((Neverlose.Rage.lastGap or 0) * 1000 + 0.5))
	end
	if info.mode == "rapid fire" then return "rapid fire cadence", (" ({%d} shots)"):format(shot.shots or 1) end
	if info.mode == "direct" and (shot.walls or 0) > 0 then return "penetration", (" ({%d} walls)"):format(shot.walls) end
	if info.mode == "direct" then return "direct shot not registered", (" ({%d} studs)"):format(math.floor(distance + 0.5)) end
	if info.chance and info.chance < 60 and not info.direct then return "spread", detail end
	if (shot.walls or 0) > 0 then return "penetration", (" ({%d} walls)"):format(shot.walls) end
	if shot.speed and shot.speed > 10 then return "prediction", (" (target {%d} st/s)"):format(math.floor(shot.speed + 0.5)) end
	if info.record then return "backtrack", detail end
	if selfSpeed > 6 then return "movement inaccuracy", (" (speed {%d})"):format(math.floor(selfSpeed + 0.5)) end
	if distance > 140 then return "range", detail end
	if Game.serverHits then return "lag compensation", detail end
	if info.chance then return "desync", detail end
	return "unregistered shot", detail
end

function ShotTracker.missWindow(shot)
	local ping = 0.08
	pcall(function() ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 end)
	return math.clamp(0.15 + ping * 1.6, 0.3, 0.75) + (shot.taps == 2 and 0.3 or 0)
end

