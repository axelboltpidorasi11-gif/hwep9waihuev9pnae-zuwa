function Xray.set(owner, character, color, transparency, record)
	Xray.entries[owner] = { character = character, color = color, transparency = transparency, record = record }
end

function Xray.clear(owner)
	Xray.entries[owner] = nil
	local set = Xray.boxes[owner]
	if set then
		for _, box in pairs(set) do pcall(function() box:Destroy() end) end
		Xray.boxes[owner] = nil
