local worldMarks = {}

function HitEffects.world(position, kill)
	local misc = Neverlose.config.misc
	if not misc.hitMarker3d or typeof(position) ~= "Vector3" then return end
	if misc.hitMarker3dStyle == "Game" and Neverlose.Vfx.marker(position, kill) then return end
	local lines = {}
	for index = 1, 4 do
		local line = NewDrawing("Line")
		line.Thickness, line.Visible = 2, false
		lines[index] = line
	end
	worldMarks[#worldMarks + 1] = { position = position, t = os.clock(), kill = kill, lines = lines, ring = misc.hitMarker3dStyle == "Ring" and NewDrawing("Circle") or nil }
end

maid:give(runService.RenderStepped:Connect(function()
	local misc = Neverlose.config.misc
	local now = os.clock()
	local life = misc.hitMarker3dTime or 0.9
	for index = #worldMarks, 1, -1 do
		local mark = worldMarks[index]
		local age = now - mark.t
		if age > life then
			for _, line in ipairs(mark.lines) do line:Remove() end
			if mark.ring then mark.ring:Remove() end
			table.remove(worldMarks, index)
		else
			local t = age / life
			local ease = 1 - (1 - t) ^ 3
			local point, onScreen = currentCamera:WorldToViewportPoint(mark.position + Vector3.new(0, ease * 1.6, 0))
			local color = mark.kill and misc.hitMarker3dKill and misc.hitMarker3dKillColor or misc.hitMarker3dColor
			local alpha = math.clamp((1 - t) * 1.8, 0, 1)
			local size = (misc.hitMarker3dSize or 10) * (mark.kill and 1.4 or 1) * (0.7 + 0.5 * math.min(t * 4, 1))
			local center = Vector2.new(point.X, point.Y)
			local visible = onScreen and point.Z > 0
			local style = misc.hitMarker3dStyle or "Cross"
			for lineIndex, line in ipairs(mark.lines) do
				line.Visible = visible and style ~= "Ring"
				if line.Visible then
					local direction
					if style == "Diamond" then
						local corners = { Vector2.new(0, -1), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(-1, 0) }
						line.From = center + corners[lineIndex] * size
						line.To = center + corners[lineIndex % 4 + 1] * size
					else
						direction = ({ Vector2.new(1, 1), Vector2.new(-1, 1), Vector2.new(1, -1), Vector2.new(-1, -1) })[lineIndex].Unit
						line.From, line.To = center + direction * size * 0.35, center + direction * size
					end
					line.Color, line.Transparency = color, alpha
