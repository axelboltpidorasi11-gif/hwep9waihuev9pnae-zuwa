local markerSeen, markerStart = 0, 0
maid:give(runService.RenderStepped:Connect(function()
	local misc = Neverlose.config.misc
	if markerUntil ~= markerSeen then markerSeen, markerStart = markerUntil, os.clock() end
	local duration = (misc.hitMarkerTime or 0.4) * (markerKill and 1.4 or 1)
	local age = os.clock() - markerStart
	local live = misc.hitMarker and markerStart > 0 and age < duration
	local style = misc.hitMarkerStyle or "Cross"

	for _, line in ipairs(markerLines) do line.Visible = false end
	markerRing.Visible = false
	if not live then return end

	local t = age / duration
	local ease = 1 - (1 - t) ^ 3
	local alpha = math.clamp((1 - t) * 1.7, 0, 1)
	local center = currentCamera.ViewportSize / 2
	local size = misc.hitMarkerSize * 0.5 * (markerKill and 1.35 or 1)
	local color = markerKill and misc.hitMarkerKill ~= false and misc.hitMarkerKillColor or misc.hitMarkerColor

	local function stroke(index, from, to)
		local line = markerLines[index]
		line.From, line.To, line.Color, line.Transparency, line.Visible = center + from, center + to, color, alpha, true
	end

	local diagonals = { Vector2.new(1, 1), Vector2.new(-1, 1), Vector2.new(1, -1), Vector2.new(-1, -1) }
	local gap, length, turn = 4, size, 0
	if style == "Pop" then
		local x = math.min(t / 0.3, 1) - 1
		length = size * 1.15 * (1 + 2.70158 * x ^ 3 + 1.70158 * x ^ 2)
	elseif style == "Spin" then
		turn = (1 - (1 - math.min(t * 1.6, 1)) ^ 3) * math.pi * 0.5
		length = size * (0.5 + 0.5 * math.min(t * 5, 1))
	elseif style == "Pulse" then
		gap = 3 + math.abs(math.sin(t * math.pi * 3)) * 3
		length = size * (0.9 + 0.2 * math.sin(t * math.pi * 6))
	elseif style == "Spread" then
		gap, length = 3 + ease * size * 1.1, size * 0.6
	elseif style == "Neon" then
		gap, length = 5, size * (0.8 + 0.35 * math.sin(math.min(t * 3, 1) * math.pi / 2))
	else
		length = size * (1.3 - 0.3 * math.min(t * 6, 1))
	end
	local cosTurn, sinTurn = math.cos(turn), math.sin(turn)
	for index, dir in ipairs(diagonals) do
		dir = dir.Unit
		dir = Vector2.new(dir.X * cosTurn - dir.Y * sinTurn, dir.X * sinTurn + dir.Y * cosTurn)
		local from, to = dir * gap, dir * (gap + length)
		stroke(index, from, to)
		local glow = markerLines[index + 4]
		glow.From, glow.To = center + from, center + to
		glow.Color, glow.Thickness, glow.Transparency, glow.Visible = color, 6, alpha * 0.25, true
	end
	if style == "Neon" or markerKill then
		markerRing.Position, markerRing.Radius = center, gap + length + ease * size * (markerKill and 2.2 or 1.4)
		markerRing.Color, markerRing.Transparency, markerRing.Thickness, markerRing.Visible = color, alpha * 0.55, markerKill and 2 or 1.2, true
	end
end))

tracers = {}

local function beam(from, to, thickness, color, transparency)
	local length = (to - from).Magnitude
	if length < 0.05 then return nil end
	return newInstance("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
		Material = Enum.Material.Neon, Color = color, Transparency = transparency,
		Size = Vector3.new(thickness, thickness, length), CFrame = CFrame.lookAt((from + to) / 2, to),
	}, effectsFolder)
end

local function effectPart(shape, size, cframe, color, transparency)
	return newInstance("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Shape = shape,
		Material = Enum.Material.Neon, Color = color, Transparency = transparency, Size = size, CFrame = cframe,
	}, effectsFolder)
end

function across(direction)
	local helper = math.abs(direction.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	local right = direction:Cross(helper).Unit
	return right, direction:Cross(right).Unit
end

local function spawnImpact(finish, normal)
	local misc = Neverlose.config.misc
	local now = os.clock()
	local style = misc.impactStyle == "Burst" and "Burst" or "Square"
	local size = misc.impactSize or 1
	local color = misc.impactColor
	local up = typeof(normal) == "Vector3" and normal.Magnitude > 0.1 and normal.Unit or Vector3.yAxis
	local at = finish + up * 0.04
	local entry = { kind = "impact", t = now, life = misc.impactLife or 2.5, style = style, parts = {}, base = {}, at = at, normal = up, size = size, color = color }
	local function add(part, base)
		if part then entry.parts[#entry.parts + 1], entry.base[#entry.parts + 1] = part, base end
	end
	local right, forward = across(up)
	if style == "Burst" then
		entry.life = 0.42
		entry.shards = {}
		for _ = 1, math.clamp(math.floor(misc.impactCount or 16), 3, 48) do
			local length = (0.35 + math.random() * 0.5) * size
			local cone = up + right * (math.random() - 0.5) * 1.9 + forward * (math.random() - 0.5) * 1.9
			local velocity = cone.Unit * (9 + math.random() * 8) * size
			local part = effectPart(Enum.PartType.Block, Vector3.new(0.035 * size, 0.035 * size, length), CFrame.lookAt(at, at + velocity), color, 0)
			entry.shards[#entry.shards + 1] = { part = part, position = at, velocity = velocity, length = length }
			add(part, 0)
		end
	else
		style = "Square"
		entry.style = style
		local tone = color
		add(effectPart(Enum.PartType.Block, Vector3.one * 0.1, CFrame.lookAt(at, at + up), tone, 0.55), 0.55)
		add(effectPart(Enum.PartType.Block, Vector3.one * 0.1, CFrame.lookAt(at, at + up), tone:Lerp(Color3.new(1, 1, 1), 0.35), 0), 0)
		add(effectPart(Enum.PartType.Block, Vector3.one * 0.1, CFrame.lookAt(at, at + up), tone:Lerp(Color3.new(1, 1, 1), 0.7), 0.35), 0.35)
	end
	tracers[#tracers + 1] = entry
end

