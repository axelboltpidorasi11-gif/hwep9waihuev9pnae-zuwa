local LOG_ICONS = { killed = "kill", hit = "hit", missed = "miss", hurt = "hurt", bought = "purchase", direct = "warning", ["anti"] = "lua", legit = "crosshair", jump = "info", edge = "info", accepted = "vote" }

function Logs.emit(text, icon, count)
	local window = Neverlose.window
	if window and window.Log then
		pcall(window.Log, window, count > 1 and (text .. " x" .. count) or text, { type = icon })
	end
end

function Logs.flush()
	local entry = Logs.last
	if entry and entry.count > entry.shown then
		entry.shown = entry.count
		Logs.emit(entry.text, entry.icon, entry.count)
	end
end

function Logs.tick()
	local entry = Logs.last
	if not entry or entry.count <= entry.shown then return end
	if os.clock() - entry.at >= 1.2 then
		Logs.flush()
	else
		task.delay(entry.at + 1.22 - os.clock(), Logs.tick)
	end
end

function Logs.push(kind, text, color)
	local features = Neverlose.config.features
	if not features.logEvents then return end
	local lower = text:lower()
	local word = lower:match("^(%a+)") or ""
	local category
	local damageLine = word == "killed" or word == "hit" or word == "missed"
	local diagnostic = kind == "Combat" and (word == "rapid" or word == "double" or word == "direct" or word == "tracer")
	if diagnostic then
		category = nil
	elseif kind == "Combat" then
		category = (word == "killed" or word == "hit") and "Damage Dealt" or word == "missed" and "Missed Shots" or "Damage Received"
	elseif word == "bought" then
		category = "Purchases"
	else
		category = "Movement"
	end
	if category and not table.find(features.logTypes, category) then return end
	local shown = text:sub(1, 1):upper() .. text:sub(2)
	local now = os.clock()
	local last = Logs.last
	if not damageLine and last and last.text == shown and now - last.at < 1.2 then
		last.count += 1
		last.at = now
		if last.count - last.shown == 1 then task.delay(1.22, Logs.tick) end
	else
		Logs.flush()
		local icon = LOG_ICONS[word] or "info"
		Logs.last = { text = shown, icon = icon, count = 1, shown = 1, at = now }
		Logs.emit(shown, icon, 1)
	end
end

