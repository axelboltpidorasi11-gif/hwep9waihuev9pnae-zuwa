function HitEffects.pillar(position, color)
	local beam = HitEffects.glow(CFrame.new(position + Vector3.new(0, 30, 0)), Vector3.new(1.6, 60, 1.6), color, nil, 0.2)
	HitEffects.fade(beam, { Size = Vector3.new(0.1, 60, 0.1) }, 0.8)
	local flash = HitEffects.glow(CFrame.new(position), Vector3.new(2, 2, 2), color, Enum.PartType.Ball, 0.2)
