local isScoped, viewmodelClass
do

local function sniperScopeGui()
	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	return playerGui and playerGui:FindFirstChild("SniperScope", true)
end

function isScoped()
	local scope = sniperScopeGui()
	if scope and scope.Visible then return true end
	local weapon = Game.weapon()
	return weapon ~= nil and (weapon.IsAiming == true or weapon.IsSniperScoped == true or (weapon.CurrentScopeIncrement or 0) > 0)
end

local function restoreScope()
	for object, visible in pairs(World.scopeHidden) do
		if object.Parent then object.Visible = visible end
	end
	table.clear(World.scopeHidden)
end
maid:give(restoreScope)

local function hideScope(scope, everything)
	for _, object in ipairs(scope:GetDescendants()) do
		local border = object:IsA("Frame") and (object.Name == "Left" or object.Name == "Right" or object.Name == "Top" or object.Name == "Bottom")
		if object:IsA("GuiObject") and (everything or border or object:IsA("ImageLabel")) then
			if World.scopeHidden[object] == nil then World.scopeHidden[object] = object.Visible end
			object.Visible = false
		end
	end
end

local scopeLines = {}
for index = 1, 2 do scopeLines[index] = draw("Line", { Visible = false }) end

do
	local bindName = randomName()
	local blurs = {}

	runService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value + 1, function()
		local world, hud = Neverlose.config.world, Neverlose.config.hud
		local scoped = isScoped()
		local fieldOfView = currentCamera.FieldOfView

		if not scoped then
			World.baseFov = World.baseFov or fieldOfView
			if world.fovOn then currentCamera.FieldOfView = world.fov end
		elseif world.removeZoom then
			currentCamera.FieldOfView = world.fovOn and world.fov or (World.baseFov or 70)
		end

		for _, holder in ipairs({ lightingService, currentCamera }) do
			for _, effect in ipairs(holder:GetChildren()) do
				if effect:IsA("BlurEffect") or effect:IsA("DepthOfFieldEffect") then
					if world.removeBlur then
						if blurs[effect] == nil then blurs[effect] = effect.Enabled end
						effect.Enabled = false
					elseif blurs[effect] ~= nil then
						effect.Enabled = blurs[effect]
						blurs[effect] = nil
					end
				end
			end
		end

		local scope = sniperScopeGui()
		local overlay = hud.scopeOverlay
		local hideAll = world.removeScope or overlay == "None"
		local hideBorders = world.removeOverlay or overlay == "Classic" or overlay == "Minimal"
		if scope and scope.Visible and (hideAll or hideBorders) then
			hideScope(scope, hideAll)
		elseif next(World.scopeHidden) then
			restoreScope()
		end

		local drawLines = scope and scope.Visible and not world.removeScope and (world.removeOverlay or overlay == "Classic" or overlay == "Minimal")
		local viewport = currentCamera.ViewportSize
		for index, line in ipairs(scopeLines) do
			line.Visible = drawLines == true
			if line.Visible then
				line.Color = world.scopeColor
				line.Thickness = overlay == "Minimal" and 1 or 2
				if index == 1 then
					line.From, line.To = Vector2.new(0, viewport.Y / 2), Vector2.new(viewport.X, viewport.Y / 2)
				else
					line.From, line.To = Vector2.new(viewport.X / 2, 0), Vector2.new(viewport.X / 2, viewport.Y)
				end
			end
		end
	end)

	maid:give(function()
		pcall(runService.UnbindFromRenderStep, runService, bindName)
		if World.baseFov then currentCamera.FieldOfView = World.baseFov end
		for effect, enabled in pairs(blurs) do
			if effect.Parent then effect.Enabled = enabled end
		end
	end)
end

viewmodelClass = Game.modules.viewmodel
if viewmodelClass and type(viewmodelClass.render) == "function" then
	Patch.hook(viewmodelClass.render, function(original)
		return function(self, ...)
			local result = original(self, ...)
			local world = Neverlose.config.world
			if self.Player == localPlayer and self.Model and not World.thirdActive then
				local depth = world.vmFovOn and (world.vmFov - 68) / 12 or 0
				local vx, vy, vz = 0, 0, 0
				if world.vmPosOn then vx, vy, vz = math.clamp(world.vmX, -1, 1), math.clamp(world.vmY, -1, 1), math.clamp(world.vmZ, -1, 1) end
				local angled = world.vmAngOn and (world.vmPitch ~= 0 or world.vmYaw ~= 0 or world.vmRoll ~= 0)
				if vx ~= 0 or vy ~= 0 or vz ~= 0 or depth ~= 0 or angled then
					pcall(function()
						self.Model:PivotTo(self.Model:GetPivot() * CFrame.new(vx, vy, vz + depth) * (angled and CFrame.Angles(math.rad(world.vmPitch), math.rad(world.vmYaw), math.rad(world.vmRoll)) or CFrame.identity))
						if self.LargeWeaponModel and self.SmallWeaponModel then
							self.LargeWeaponModel:PivotTo(self.SmallWeaponModel:GetPivot())
						end
					end)
				end
			end
			return result
		end
	end)
end

do
	local bindName = randomName()
	local cameraParams = RaycastParams.new()
	cameraParams.FilterType = Enum.RaycastFilterType.Exclude
	local applied, eye = nil, nil
	local hiddenViewmodel = {}
	local weaponModelShown = false

	local function showViewmodel()
		for part in pairs(hiddenViewmodel) do
			if part.Parent then part.LocalTransparencyModifier = 0 end
		end
		table.clear(hiddenViewmodel)
	end

	local function setBodyVisible(character, visible)
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "CameraPart" then
				part.LocalTransparencyModifier = visible and 0 or 1
			end
		end
	end

	local function refreshWeaponModel(show)
		local creator = Game.modules.weaponModel
		if type(creator) ~= "table" and type(creator) ~= "function" then return end
		if show then
			local equipped = Game.equipped(localPlayer)
			if equipped and type(equipped.Name) == "string" then
				local picks = Neverlose.config.skins
				if picks.enabled then
					Skins.sync()
					local isKnife = false
					for _, name in ipairs(Skins.knives) do if name == equipped.Name then isKnife = true end end
					if isKnife and picks.knife and picks.knifeSkin then
						equipped.Name, equipped.Skin = picks.knife, picks.knifeSkin
					elseif picks.weapons[equipped.Name] then
						equipped.Skin = picks.weapons[equipped.Name]
					end
				end
				task.spawn(asGame, function() creator(localPlayer, equipped, {}) end)
				weaponModelShown = true
			end
		elseif weaponModelShown then
			weaponModelShown = false
			task.spawn(asGame, function()
				if type(creator) == "table" and creator.ClearPlayerCache then creator.ClearPlayerCache(localPlayer) end
			end)
		end
	end

	local lastEquipped
	runService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value, function(delta)
		local world = Neverlose.config.world
		local character = Game.localCharacter()
		local spectating = localPlayer:GetAttribute("IsSpectating") == true or not character
		local unlock = world.unlockSpectating
		local freeAllowed
		if unlock == "Always" then
			freeAllowed = true
		elseif unlock == "On Death" then
			freeAllowed = spectating
		else
			freeAllowed = not spectating
		end

		if world.freeCam and freeAllowed then
			World.freeCamCFrame = World.freeCamCFrame or currentCamera.CFrame
			local move = Vector3.zero
			if userInputService:IsKeyDown(Enum.KeyCode.W) then move += Vector3.new(0, 0, -1) end
			if userInputService:IsKeyDown(Enum.KeyCode.S) then move += Vector3.new(0, 0, 1) end
			if userInputService:IsKeyDown(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
			if userInputService:IsKeyDown(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
			if userInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
			if userInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move += Vector3.new(0, -1, 0) end
			local speed = userInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 80 or 30
			local rotation = currentCamera.CFrame.Rotation
			World.freeCamCFrame = rotation + World.freeCamCFrame.Position + rotation:VectorToWorldSpace(move) * speed * delta
			eye = currentCamera.CFrame
			currentCamera.CFrame = World.freeCamCFrame
			applied = currentCamera.CFrame
			World.freeActive = true
			if character then setBodyVisible(character, true) World.bodyShown = true end
			return
		end
		World.freeCamCFrame, World.freeActive = nil, false

		World.thirdActive = world.thirdPerson and character ~= nil and not spectating
		if not World.thirdActive then
			if World.bodyShown then
				World.bodyShown = false
				if character then setBodyVisible(character, false) end
			end
			if next(hiddenViewmodel) then showViewmodel() end
			refreshWeaponModel(false)
			return
		end

		eye = currentCamera.CFrame
		local distance = world.thirdDistance / 10
		local origin = eye.Position
		local direction = eye.LookVector * -distance
		cameraParams.FilterDescendantsInstances = { character, currentCamera, effectsFolder }
		local result = workspaceService:Raycast(origin, direction, cameraParams)
		if result then
			distance = math.max((result.Position - origin).Magnitude - 0.3, 0.5)
		end
		currentCamera.CFrame = eye.Rotation + (origin + eye.LookVector * -distance + eye.RightVector * (world.thirdShoulder / 10) + Vector3.new(0, world.thirdHeight / 10, 0))
		applied = currentCamera.CFrame

		setBodyVisible(character, true)
		World.bodyShown = true

		local weapon = Game.weapon()
		local model = weapon and weapon.Viewmodel and weapon.Viewmodel.Model
		if model then
			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = 1
					hiddenViewmodel[part] = true
				end
			end
		end

		local equipped = tostring(localPlayer:GetAttribute("CurrentEquipped")) .. tostring(Neverlose.config.skins.knife) .. tostring(Neverlose.config.skins.knifeSkin)
		if equipped ~= lastEquipped or not weaponModelShown then
			lastEquipped = equipped
			refreshWeaponModel(true)
		end
	end)

	World.ratio = { applied = nil, eye = nil }
	runService:BindToRenderStep(bindName .. "R", Enum.RenderPriority.Last.Value + 1, function()
		local world = Neverlose.config.world
		local ratio = World.ratio
		ratio.applied = nil
		if not world.ratioOn or world.ratioValue == 100 then return end
		local scale = world.ratioValue / 100
		local sx, sy = 1, 1
		if world.ratioMode == "Horizontal" then sx = scale elseif world.ratioMode == "Vertical" then sy = scale else sx, sy = scale, 1 / scale end
		ratio.eye = currentCamera.CFrame
		currentCamera.CFrame = ratio.eye * CFrame.new(0, 0, 0, sx, 0, 0, 0, sy, 0, 0, 0, 1)
		ratio.applied = currentCamera.CFrame
	end)
	maid:give(function() pcall(runService.UnbindFromRenderStep, runService, bindName .. "R") end)

	maid:give(runService.Heartbeat:Connect(function()
		local ratio = World.ratio
		if ratio and ratio.applied and currentCamera.CFrame == ratio.applied then currentCamera.CFrame = ratio.eye end
		if ratio then ratio.applied = nil end
		if applied and eye and currentCamera.CFrame == applied then
			currentCamera.CFrame = eye
		end
		applied = nil
	end))

	maid:give(function()
		pcall(runService.UnbindFromRenderStep, runService, bindName)
		showViewmodel()
		refreshWeaponModel(false)
		local character = localPlayer.Character
		if character then setBodyVisible(character, false) end
	end)
end

