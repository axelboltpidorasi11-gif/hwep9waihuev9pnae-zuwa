function addCustom(name, userId, save)
	if Agents.custom[name] then return true end
	local ok, model = pcall(function()
		local description = playersService:GetHumanoidDescriptionFromUserId(userId)
		return playersService:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not (ok and typeof(model) == "Instance") then ok, model = pcall(playersService.CreateHumanoidModelFromUserId, playersService, userId) end
	if not (ok and typeof(model) == "Instance") then return false end
	model.Name = name
	model:SetAttribute("NeverloseCustom", true)
	Agents.custom[name] = model
	Skins.agentModels[name] = model
	if save then
		local list = Neverlose.config.skins.customAgents
		list[#list + 1] = { name = name, userId = userId }
		Skins.save()
	end
	return true
end

function Agents.removeCustom(name)
	if name == "Roblox" or not Agents.custom[name] then return false end
	local config = Neverlose.config.skins
	for index = #config.customAgents, 1, -1 do
		if type(config.customAgents[index]) == "table" and config.customAgents[index].name == name then table.remove(config.customAgents, index) end
	end
	local model = Agents.custom[name]
	Agents.custom[name] = nil
	Skins.agentModels[name] = nil
	pcall(function() model:Destroy() end)
	for _, entry in pairs(config.bySide or {}) do
		if type(entry) == "table" then
			if entry.agent == name then entry.agent = nil end
			if entry.agentCT == name then entry.agentCT = nil end
			if entry.agentT == name then entry.agentT = nil end
		end
	end
	if config.agentCT == name then config.agentCT = nil end
	if config.agentT == name then config.agentT = nil end
	Skins.save()
	pcall(Skins.refresh)
	return true
end

function Agents.addCustom(text)
	text = tostring(text or ""):match("^%s*(.-)%s*$")
	if text == "" then return false end
	local userId = tonumber(text)
	local name = text
	if not userId then
		local ok, id = pcall(playersService.GetUserIdFromNameAsync, playersService, text)
		if not (ok and type(id) == "number") then return false end
		userId = id
	else
		local ok, resolved = pcall(playersService.GetNameFromUserIdAsync, playersService, userId)
		name = ok and resolved or ("User " .. userId)
