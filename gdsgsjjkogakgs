	local HITBOXES = {"Head", "Chest", "Stomach", "Arms", "Legs"}

	local LegitAim = LegitTab:AddSection("Aimbot", "left")
	hk["Legit Aimbot"] = reg("enabled", function(cb) return LegitAim:AddToggle("Enabled", legit.enabled, cb) end)
	reg("activation", function(cb) return LegitAim:AddDropdown("Activation", {"Assisted", "On Attack", "Always on"}, legit.activation, cb) end)
	reg("conditionList", function(cb) return LegitAim:AddDropdown("Conditions", CONDITIONS, legit.conditionList, cb) end)
	reg("hitboxList", function(cb) return LegitAim:AddDropdown("Hitboxes", HITBOXES, legit.hitboxList, cb) end)
	reg("fov", function(cb) return LegitAim:AddSlider("Field of View", 1, 90, legit.fov, cb, "°") end)
	local Smoothing = reg("smoothing", function(cb) return LegitAim:AddSlider("Smoothing", 0, 100, legit.smoothing, cb, "%") end)
	local SmoothingSettings = Smoothing:AddSettings()
	reg("firstBulletDelay", function(cb) return SmoothingSettings:AddToggle("First Bullet Delay", legit.firstBulletDelay, cb) end)
	local Reaction = reg("reactionMs", function(cb) return LegitAim:AddSlider("Reaction Time", 0, 500, legit.reactionMs, cb, "ms") end)
	local ReactionSettings = Reaction:AddSettings()
	reg("switchDelay", function(cb) return ReactionSettings:AddSlider("Target Switch Delay", 0, 1000, legit.switchDelay, cb, "ms") end)
	reg("switchDelayMax", function(cb) return ReactionSettings:AddSlider("Max Switch Delay (random)", 0, 1000, legit.switchDelayMax, cb, "ms") end):SetDisplay(function(v) return v == 0 and "= min" or nil end)
	reg("switchReactionMs", function(cb) return ReactionSettings:AddSlider("Reaction After Switch", 0, 500, legit.switchReactionMs, cb, "ms") end)
	reg("humanize", function(cb) return LegitAim:AddSlider("Humanize", 0, 100, legit.humanize, cb, "%") end)
	reg("minDamage", function(cb) return LegitAim:AddSlider("Min Damage", 0, 100, legit.minDamage, cb) end):SetDisplay(function(v) return v == 0 and "auto" or nil end)
	local RecoilControl = reg("rcs", function(cb) return LegitAim:AddToggle("Recoil Control", legit.rcs, cb) end)
	local RecoilSettings = RecoilControl:AddSettings()
	reg("rcsReduction", function(cb) return RecoilSettings:AddSlider("Reduction", 0, 100, legit.rcsReduction, cb, "%") end)
	reg("rcsRecovery", function(cb) return RecoilSettings:AddSlider("Recovery", 0, 100, legit.rcsRecovery, cb, "%") end)
	local AimQuickScope = reg("quickScope", function(cb) return LegitAim:AddToggle("Quick Scope", legit.quickScope, cb) end)
	local AimQuickScopeSettings = AimQuickScope:AddSettings()
	reg("autoScope", function(cb) return AimQuickScopeSettings:AddToggle("Automatic Scope", legit.autoScope, cb) end)
	reg("quickScopeDelay", function(cb) return AimQuickScopeSettings:AddSlider("Delay", 0, 500, legit.quickScopeDelay, cb, "ms") end)

	local LegitTrigger = LegitTab:AddSection("Triggerbot", "right")
	hk["Triggerbot"] = reg("trigger", function(cb) return LegitTrigger:AddToggle("Enabled", legit.trigger, cb) end)
	reg("triggerConditionList", function(cb) return LegitTrigger:AddDropdown("Conditions", CONDITIONS, legit.triggerConditionList, cb) end)
	reg("triggerHitboxList", function(cb) return LegitTrigger:AddDropdown("Hitboxes", HITBOXES, legit.triggerHitboxList, cb) end)
	local HitChance = reg("triggerHitChance", function(cb) return LegitTrigger:AddSlider("Hit Chance", 0, 100, legit.triggerHitChance, cb, "%") end)
	HitChance:SetDisplay(function(v) return v >= 100 and "seed" or nil end)
	tip(HitChance, "100% = seed trigger: the shot's random seed is picked so the bullet lands in the hitbox")
