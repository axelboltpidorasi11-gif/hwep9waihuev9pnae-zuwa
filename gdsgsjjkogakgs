	end
	entry = {
		seen = true,
		text = NewDrawing("Text"),
		box = NewDrawing("Square"),
		icon = NewDrawing("Circle"),
	}
	entry.text.Center, entry.text.Outline, entry.text.Size, entry.text.Font = true, true, 13, 2
