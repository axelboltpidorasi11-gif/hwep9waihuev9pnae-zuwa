do
	local numbers = {}

	local function spawnNumber(entity, shot, label, color)
		local misc = Neverlose.config.misc
		if not misc.hitDamage then return end
		local part = shot.character and shot.character:FindFirstChild(shot.part)
		local position = part and part.Position
		if not position then return end
		local text = NewDrawing("Text")
		text.Size, text.Center, text.Outline, text.Font, text.Visible = 16, true, true, 2, false
		numbers[#numbers + 1] = { position = position + Vector3.new((math.random() - 0.5) * 1.2, 0, 0), t = os.clock(), text = text, label = label, color = color }
		if #numbers > 24 then
			local oldest = table.remove(numbers, 1)
			pcall(function() oldest.text:Remove() end)
		end
	end

	Events.on("hit", function(entity, shot, damage)
		local misc = Neverlose.config.misc
		local color = misc.hitDamageColor
		if shot.part == "Head" and misc.hitDamageHead and misc.hitDamageHeadColor then color = misc.hitDamageHeadColor end
		spawnNumber(entity, shot, tostring(math.floor(damage + 0.5)), color)
	end)
	Events.on("kill", function(entity, shot)
		local misc = Neverlose.config.misc
		spawnNumber(entity, shot, "KILL", misc.hitDamageKill and misc.hitDamageKillColor or misc.hitDamageColor)
	end)

	maid:give(runService.RenderStepped:Connect(function()
		local misc = Neverlose.config.misc
		local now = os.clock()
		for index = #numbers, 1, -1 do
			local entry = numbers[index]
			local age = now - entry.t
			if age > 1.1 then
				pcall(function() entry.text:Remove() end)
				table.remove(numbers, index)
			else
				local point, visible = currentCamera:WorldToViewportPoint(entry.position + Vector3.new(0, misc.hitDamageRise * age, 0))
				entry.text.Visible = visible
				entry.text.Text, entry.text.Color = entry.label, entry.color
				entry.text.Position = Vector2.new(point.X, point.Y)
				entry.text.Transparency = 1 - age / 1.1
			end
		end
	end))

	maid:give(function()
		for _, entry in ipairs(numbers) do pcall(function() entry.text:Remove() end) end
		table.clear(numbers)
	end)
end

