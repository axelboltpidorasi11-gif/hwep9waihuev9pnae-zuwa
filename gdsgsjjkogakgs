				end

			pcall(function()
				local held = Game.weapon()
				if held and type(payload.Seq) == "number" then held.ShotSeq = math.max(held.ShotSeq or 0, payload.Seq) end
			end)
			for _, rewrite in ipairs(shotRewriters) do
