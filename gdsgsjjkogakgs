function Rage.weaponProfileFor(weapon)
	local config = Neverlose.config.rage
	local profiles = config.weaponProfiles
	if type(profiles) ~= "table" then profiles = {} config.weaponProfiles = profiles end
	local key = weapon and (weapon.Identifier or weapon.Name)
	if type(key) ~= "string" or key == "" then return nil end
	-- Версия профилей: при смене формулы старые кэши не используются.
	local cacheKey = key .. "|milk2"
	local profile = profiles[cacheKey]
	if profile then return profile, key end

	local stats = Rage.WEAPON_STATS[weapon.Name or key] or Rage.WEAPON_STATS[key]
	local properties = weapon.Properties or {}
	local perPart = properties.DamagePerPart
	local function field(name)
		local value = tonumber(properties[name])
		if value == nil and stats then value = tonumber(stats[name]) end
		return value
	end

	local pen = field("Penetration") or 0
	local wb = field("WallbangMultiplier") or 0.5
	local bullets = field("BulletsPerShot") or 1
	local rate = field("FireRate") or 0.1
	local head = (type(perPart) == "table" and tonumber(perPart.Head)) or (stats and stats.Head) or 0
	local torso = (type(perPart) == "table" and tonumber(perPart.Torso)) or (stats and stats.Torso) or field("Damage") or 40

	-- Milk: профиль считается из реальных параметров ствола (дамп оружия),
	-- а не «на глаз». Penetration + WallbangMultiplier задают, сколько стен
	-- вообще имеет смысл простреливать, темп и урон — скан и пороги.
	local maxWalls
	if wb <= 0 then
		maxWalls = 0
	elseif bullets > 1 then
		maxWalls = 1
	else
		maxWalls = math.clamp(1 + math.floor(pen * 2 + (wb - 0.5) * 3), 1, 4)
	end

	local wallMin = math.clamp(math.floor(wb * 18 + 0.5), 0, 20)
	if bullets > 1 or pen < 0.2 then wallMin = math.min(wallMin, 5) end

	profile = {
		originRange = math.floor(math.clamp(6 + pen * 6 + (rate >= 0.2 and 1 or 0), 5, 12) * 10 + 0.5) / 10,
		originScans = math.clamp((pen >= 0.85 and 8 or pen >= 0.6 and 6 or 4) + (rate >= 0.2 and 1 or 0), 3, 10),
		multiRay = math.clamp((pen >= 0.85 and 14 or pen >= 0.6 and 10 or bullets > 1 and 5 or 6) + (rate >= 0.2 and 2 or 0), 4, 16),
		spotRadius = math.floor(math.clamp(0.5 + pen * 0.35, 0.4, 0.85) * 100 + 0.5) / 100,
		minDamage = math.clamp(math.floor(torso * 0.3 + 0.5), 8, 30),
		wallMinDamage = wallMin,
		maxWalls = maxWalls,
	}
	-- Снайперский хедшот: смысл ждать есть только при высоком уроне.
	if head >= 300 then profile.minDamage = math.max(profile.minDamage, 25) end
	profiles[cacheKey] = profile
	return profile, key
end

