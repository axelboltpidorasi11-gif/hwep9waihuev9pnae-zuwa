			end
			if mark.ring then
				mark.ring.Visible = visible
				mark.ring.Position, mark.ring.Radius, mark.ring.Color, mark.ring.Transparency = center, size * (0.5 + ease * 0.8), color, alpha
				mark.ring.Filled, mark.ring.Thickness, mark.ring.NumSides = false, 2, 32
			end
		end
	end
end))

