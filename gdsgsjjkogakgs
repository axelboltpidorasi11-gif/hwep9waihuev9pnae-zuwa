	if not aim.lockSince then
		aim.phase = math.random() * 6.28
		aim.reactJitter = 1 + (math.random() * 2 - 1) * 0.35 * human
		aim.bias = Vector2.new(math.random() - 0.5, math.random() - 0.5)
		aim.overshoot = math.random() < 0.4 * human and (0.04 + 0.08 * math.random()) or 0
		aim.overshootDir, aim.overshootDist = nil, 0
		aim.vel = Vector2.zero
		aim.nextPause, aim.pauseUntil = now + 0.5 + math.random() * 1.6, 0
