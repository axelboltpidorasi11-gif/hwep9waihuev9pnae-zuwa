	if type(Skins) == "table" and type(Skins.resolve) == "function" then
		local ok, value = pcall(Skins.resolve, name)
		if ok and type(value) == "string" and value ~= "" then resolved = value end
	end
	local image = ""
	if type(Skins) == "table" and type(Skins.forWeapon) == "function" then
		local ok, list = pcall(Skins.forWeapon, resolved)
		if ok then image = iconFromList(list) end
	end
	if image == "" then
		local skins = Game.modules.skins
		if skins and type(skins.GetAllSkinsForWeapon) == "function" then
			for _, candidate in ipairs({ resolved, name }) do
				local ok, list = pcall(skins.GetAllSkinsForWeapon, candidate)
				if ok then image = iconFromList(list) end
				if image ~= "" then break end
			end
		end
	end
	if image == "" and allowFallback and type(Skins) == "table" and type(Skins.forWeapon) == "function" then
		for _, candidate in ipairs({ "AK-47", "M4A4", "AWP", "USP-S", "Glock-18", "Desert Eagle" }) do
			local ok, list = pcall(Skins.forWeapon, candidate)
			if ok then image = iconFromList(list) end
			if image ~= "" then break end
		end
	end
	if image == "" and allowFallback then image = "rbxassetid://93001822915827" end
	iconCache[name] = { image = image, at = os.clock() }
	return image
end

function slotHas(entity, needle)
