local function nearestEnemy(origin)
	local bestPosition, bestDistance = nil, math.huge
	for _, entity in ipairs(Game.entities()) do
		if Game.isEnemy(entity, true) then
			local character = Game.character(entity)
			if character then
				local distance = (character.HumanoidRootPart.Position - origin).Magnitude
				if distance < bestDistance then bestPosition, bestDistance = character.HumanoidRootPart.Position, distance end
			end
		end
	end
	return bestPosition
end

local function freestandOffset(root, enemy, base)
	freestandParams.FilterDescendantsInstances = Ballistics.ignoreList()
	local eye = enemy + Vector3.new(0, 1.6, 0)
	local blocked = {}
	for index, side in ipairs({ math.pi / 2, -math.pi / 2 }) do
		local lateral = CFrame.Angles(0, base + side, 0):VectorToWorldSpace(Vector3.new(0, 0, -1.6))
		local head = root.Position + Vector3.new(0, 1.5, 0) + lateral
		blocked[index] = workspaceService:Raycast(eye, head - eye, freestandParams) ~= nil
	end
	if blocked[1] == blocked[2] then return nil end
	return blocked[1] and math.pi / 2 or -math.pi / 2
end

local function aaState(self, frame)
	if not self.OnGround then return "Air" end
	if Input.hasButton(frame, "Duck") then return "Crouching" end
	local velocity = typeof(self.GlobalVelocity) == "Vector3" and self.GlobalVelocity or Vector3.zero
	if Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 2 then return "Moving" end
	return "Standing"
end

Neverlose.stairParams = RaycastParams.new()
Neverlose.stairParams.FilterType = Enum.RaycastFilterType.Exclude
function Neverlose.onStairs(self)
	local at = os.clock()
	if at - (Neverlose.stairAt or 0) < 0.08 then return Neverlose.stairNow end
	Neverlose.stairAt = at

	local held = at < (Neverlose.stairHold or 0)
	Neverlose.stairNow = held
	local root = self.HumanoidRootPart
	if not (root and self.OnGround == true) then return held end
	local velocity = typeof(self.GlobalVelocity) == "Vector3" and self.GlobalVelocity or Vector3.zero
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	if flat.Magnitude < 1 then return held end
	local params = Neverlose.stairParams
	params.FilterDescendantsInstances = { localPlayer.Character, currentCamera, effectsFolder, workspaceService:FindFirstChild("Characters") }
	local reach = flat.Unit * 2.4
	local low = workspaceService:Raycast(root.Position - Vector3.new(0, 1.6, 0), reach, params)
	local high = workspaceService:Raycast(root.Position + Vector3.new(0, 1.2, 0), reach, params)
	if (low ~= nil and high == nil) or velocity.Y > 1.5 then
		Neverlose.stairHold = at + 0.4
		Neverlose.stairNow = true
	end
	return Neverlose.stairNow
end

Input.add(50, function(self, frame)
	local config = Neverlose.config.aa
	if not config.enabled or World.freeActive then return end

	local weapon = Game.weapon()
	local shooting = (weapon and (weapon.IsShooting or weapon.IsFireHeld)) or Rage.shooting
		or userInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	local shotNow = config.disableOnShot and (shooting or os.clock() - AntiAim.lastShotAt < 0.15)
	if weapon and weapon.Name and GRENADES[weapon.Name] then AntiAim.grenadeUntil = os.clock() + 0.9 return end
	if os.clock() < (AntiAim.grenadeUntil or 0) then return end
	if Neverlose.onStairs(self) then return end

	local root = self.HumanoidRootPart
	local viewYaw = frame.LookYaw
	local base = viewYaw

	local enemy = root and nearestEnemy(root.Position)
	if config.base == "At Targets" and enemy then
		local offset = enemy - root.Position
		base = math.atan2(-offset.X, -offset.Z)
	end

	local settings = config.useBuilder and config.states[aaState(self, frame)] or config
	local mode = AntiAim.manual or settings.yaw
	if mode == "Backward" then mode = "Backwards" end
	if mode == "Back" then mode = "Backwards" end
	local yaw = base

	if mode == "Left" then
		yaw = base + math.pi / 2
	elseif mode == "Right" then
		yaw = base - math.pi / 2
	elseif mode == "Backwards" then
		yaw = base + math.pi
	elseif mode == "Sideways" then
		yaw = base + math.pi / 2
	end

	if config.freestanding ~= "Off" and root and enemy and not AntiAim.manual and (config.freestanding == "On" or mode == "Off") then
		local offset = freestandOffset(root, enemy, base)
		if offset then yaw = base + offset end
	end

	if not AntiAim.manual then
		if mode == "Spin" or config.spin then
			AntiAim.spin = wrapAngle(AntiAim.spin + math.rad(settings.spinSpeed))
			yaw = base + AntiAim.spin
		elseif mode == "Random" then
			AntiAim.randomTick = (AntiAim.randomTick or 0) + 1
			if AntiAim.randomTick >= math.max(settings.jitterDelay or 1, 1) then
				AntiAim.randomTick = 0
				AntiAim.randomYaw = math.rad(math.random(-180, 180))
			end
			yaw = base + (AntiAim.randomYaw or 0)
		elseif mode == "Sway" then
			yaw = base + math.pi + math.sin(os.clock() * (config.swaySpeed or 3)) * math.rad(config.swayRange or 60)
		elseif mode == "Jitter" or settings.jitter > 0 then
			AntiAim.jitterTick += 1
			if AntiAim.jitterTick >= math.max(settings.jitterDelay or 1, 1) then
				AntiAim.jitterTick = 0
				AntiAim.jitterSide = -AntiAim.jitterSide
			end
			if mode == "Jitter" then yaw = base + math.pi end
			yaw += math.rad(settings.jitter) * AntiAim.jitterSide
		end
	end

	if config.desync then
		local now = os.clock()
		if not AntiAim.desyncAt or now >= AntiAim.desyncAt then
			local period = math.max(config.desyncPeriod or 30, 1) / 1000
			AntiAim.desyncAt = now + period * (0.85 + math.random() * 0.3)
			AntiAim.desyncSide = -(AntiAim.desyncSide or 1)
		end
		yaw += math.rad(config.desyncAmount or 58) * (AntiAim.desyncSide or 1)
	end
	yaw = wrapAngle(yaw + math.rad(settings.offset or 0))
	if not shotNow and (mode ~= "Off" or config.desync or config.spin or settings.jitter > 0 or config.freestanding ~= "Off" or (settings.offset or 0) ~= 0) then
		Input.retarget(frame, viewYaw, yaw)
		frame.LookYaw = yaw
	end

	local pitch = settings.pitch
	if pitch == "Up" then
		frame.VerticalLook = 1
	elseif pitch == "Down" then
		frame.VerticalLook = -1
	elseif pitch == "Zero" then
		frame.VerticalLook = 0
	elseif pitch == "Custom" then
		frame.VerticalLook = math.clamp((settings.pitchValue or 0) / 100, -1, 1)
	elseif pitch == "Random" then
		frame.VerticalLook = math.random(-100, 100) / 100
	elseif pitch == "Jitter" then
		AntiAim.pitchTick += 1
		if AntiAim.pitchTick >= math.max(settings.jitterDelay or 1, 1) then
			AntiAim.pitchTick = 0
			AntiAim.pitchSide = -AntiAim.pitchSide
		end
		frame.VerticalLook = AntiAim.pitchSide
	end
end)

