		Skins.assetNames[normalize(descendant.Name)] = descendant
	end
end

function Skins.inAssets(skinName)
	return Skins.assetNames[normalize(skinName)] ~= nil
end

local RARITY_NAMES = { "Consumer", "Industrial", "Mil-Spec", "Restricted", "Classified", "Covert", "Contraband" }
local RARITY_FIELDS = { "rarity", "Rarity", "grade", "Grade", "quality", "Quality", "tier", "Tier", "rarityName", "RarityName" }

function Skins.rarityOf(entry)
	if entry.skin == "Stock" then return "Default", Skins.rarityColor(nil), 0 end

	local raw
	for _, key in ipairs(RARITY_FIELDS) do
		local value = entry[key]
		if value ~= nil and value ~= "" then raw = value break end
	end
	if raw == nil then
		local asset = Skins.assetNames[normalize(entry.skin)]
		if asset then raw = asset:GetAttribute("Rarity") or asset:GetAttribute("Grade") or asset:GetAttribute("Quality") end
	end
	if type(raw) == "table" then raw = raw.Name or raw.name or raw.Display end
	if type(raw) == "number" then raw = RARITY_NAMES[math.clamp(math.floor(raw), 1, #RARITY_NAMES)] end

	local text = raw ~= nil and tostring(raw) or ""
	if text == "" then return "Unrated", Skins.rarityColor(nil), 1 end
	return text, Skins.rarityColor(text), Skins.rarityRank(text)
end

