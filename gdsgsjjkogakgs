function Neverlose.partShape(part, toScreen)
	local cf, size = part.CFrame, part.Size
	local axes = { { cf.RightVector, size.X }, { cf.UpVector, size.Y }, { cf.LookVector, size.Z } }
	table.sort(axes, function(a, b) return a[2] > b[2] end)
	local middle, centerPoint = cf.Position, toScreen(cf.Position)
	local a = toScreen(middle + axes[1][1] * axes[1][2] / 2)
	local b = toScreen(middle - axes[1][1] * axes[1][2] / 2)
	if not (a and b and centerPoint) then return nil end
	local sides, total = 0, 0
	for index = 2, 3 do
		local edge = toScreen(middle + axes[index][1] * axes[index][2] / 2)
		if edge then
			sides += 1
			total += (edge - centerPoint).Magnitude
		end
	end
	return a, b, math.max(sides > 0 and total / sides or 0, 2.5)
end

function Neverlose.seesYou(entity, character)
	local cache = Neverlose.seesCache
	if not cache then cache = {} Neverlose.seesCache = cache end
	local entry = cache[entity]
	local now = os.clock()
	if entry and now - entry.at < 0.08 then return entry.value end
	entry = entry or {}
	cache[entity] = entry
	entry.at, entry.value = now, false
	local head = character:FindFirstChild("Head")
	local mine = localPlayer.Character and localPlayer.Character:FindFirstChild("Head")
	local target = mine and mine.Position or currentCamera.CFrame.Position
	if head then
		local offset = target - head.Position
		local distance = offset.Magnitude
		if distance > 1 and distance < 300 and head.CFrame.LookVector:Dot(offset.Unit) > 0.86 and not blockedBetween(head.Position, target) then
			entry.value = true
		end
	end
	return entry.value
end

function EspObject:drawGhost(character, record, chams)
	local style = CHAMS_STYLE[chams.mode]
	local slot = chams.slot or "ghost"
	if not (style and record) then return self:hideGhost(slot) end
	local ghost = self[slot]
	if not (ghost and ghost.model.Parent) then
		local model = newInstance("Model", { Name = randomName() }, effectsFolder)
		local parts = {}
		for _, name in ipairs(BODY_PARTS) do
			parts[name] = newInstance("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 1 }, model)
		end
		local light = newInstance("Highlight", { Name = randomName(), DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = model }, model)
		ghost = { model = model, parts = parts, light = light }
		self[slot] = ghost
	end
	local color = chams.color
	if style.rainbow then color = Color3.fromHSV((os.clock() * 0.2) % 1, 0.7, 1) end
	local breath = 0.5 + 0.5 * math.sin(os.clock() * 2.4)
	local any = false
	for name, part in pairs(ghost.parts) do
		local cframe, live = record.cframes[name], character:FindFirstChild(name)
		if cframe and live then
			part.CFrame, part.Size, part.Color = cframe, live.Size, color
			part.Material = style.material or Enum.Material.SmoothPlastic
			part.Transparency = style.material and (style.alpha and 1 - style.alpha or 0.45) or 0.9
			any = true
		else
			part.Transparency = 1
		end
	end
	local light = ghost.light
	light.Enabled = any
	light.FillColor = color
	light.FillTransparency = math.min(style.fill + (style.pulse and 0.16 * breath or 0), 1)
	light.OutlineColor = color:Lerp(Color3.new(1, 1, 1), style.rim or 0.35)
	light.OutlineTransparency = math.max(style.outline - 0.05, 0)
	if any and Neverlose.Xray then
		Neverlose.Xray.set(ghost, character, color, math.clamp(0.42 + style.fill * 0.4, 0.42, 0.85), record)
	elseif Neverlose.Xray then
		Neverlose.Xray.clear(ghost)
	end
end

