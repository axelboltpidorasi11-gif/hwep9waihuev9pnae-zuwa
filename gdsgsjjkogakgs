	local ambienceSounds, ambienceThunder = {}, { at = 0 }
	local soundService = game:GetService("SoundService")

	local function ambienceSound(kind)
		local sound = ambienceSounds[kind]
		if sound and sound.Parent then return sound end
		local id = AMBIENCE_IDS[kind]
		if not id then return nil end
		local name = "NL_Ambience_" .. kind
		-- A previous injection may have left the same loop playing.
		for _, existing in ipairs(soundService:GetChildren()) do
			if existing:IsA("Sound") and existing.Name == name then existing:Destroy() end
		end
		sound = newInstance("Sound", {
			Name = name, SoundId = "rbxassetid://" .. id, Looped = true, Volume = 0,
		}, soundService)
		Neverlose.ambienceSounds = Neverlose.ambienceSounds or {}
		Neverlose.ambienceSounds[kind] = sound
		ambienceSounds[kind] = sound
		return sound
	end

	-- Volume eases towards its target so the toggle never clicks.
	local function ambienceTick(kind, enabled, volume)
		local sound = ambienceSounds[kind]
		if not (sound and sound.Parent) then
			if not enabled then return end
			sound = ambienceSound(kind)
			if not sound then return end
		end
		local target = 0
		if enabled then target = math.clamp(tonumber(volume) or 0, 0, 100) / 100 * 0.6 end
		if enabled and not sound.IsPlaying then sound:Play() end
		sound.Volume = sound.Volume + (target - sound.Volume) * 0.12
		if not enabled and sound.Volume < 0.01 then
			sound.Volume = 0
			if sound.IsPlaying then sound:Stop() end
		end
	end

