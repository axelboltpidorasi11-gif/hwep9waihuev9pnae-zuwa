					local part = character:FindFirstChild(name)
					if part then
						local offset = part.Position - origin
						local angle = math.acos(math.clamp(look:Dot(offset.Unit), -1, 1))
						if angle < bestAngle then
							local point = Legit.visiblePoint(part, origin, condition)
							if point and not (condition == "Visible Only" and Ballistics.throughSmoke(origin, point)) then
								local walls = condition == "Through Walls" and select(3, Ballistics.trace(origin, offset.Unit, offset.Magnitude + 2, character, 4)) or 0
								local damage = properties and Ballistics.damage(properties, name, offset.Magnitude, walls, character) or math.huge
								if damage >= math.min(minDamage, character:GetAttribute("Health") or 100) then
									bestPart, bestPoint, bestCharacter, bestAngle = part, point, character, angle
								end
							end
						end
					end
				end
			end
		end
	end

	return bestPart, bestPoint, bestCharacter
end

local scopeRequestedAt = 0
local function ensureScoped(weapon, delayMs)
	if not Game.isSniper(weapon) then return true end
	if weapon.IsSniperScoped or (weapon.CurrentScopeIncrement or 0) > 0 then
