function Agents.visibleBox(model, skip, keepLimbs)
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part.Transparency < 0.95 and not (skip and part:IsDescendantOf(skip))
			and not (skip and not keepLimbs and (part.Name:find("Arm") or part.Name:find("Hand"))) then
			local cf, size = part.CFrame, part.Size
			local function extent(axis)
				return (math.abs(cf.RightVector[axis]) * size.X + math.abs(cf.UpVector[axis]) * size.Y + math.abs(cf.LookVector[axis]) * size.Z) / 2
			end
			local ext = Vector3.new(extent("X"), extent("Y"), extent("Z"))
			lo = lo:Min(cf.Position - ext)
			hi = hi:Max(cf.Position + ext)
		end
	end
	if lo.X == math.huge then return model:GetBoundingBox() end
	return CFrame.new((lo + hi) / 2), hi - lo
end

