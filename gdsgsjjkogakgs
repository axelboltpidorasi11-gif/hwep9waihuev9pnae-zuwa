	list[#list + 1] = localPlayer.Character
	list[#list + 1] = currentCamera
	list[#list + 1] = effectsFolder

	ignoreCache.at, ignoreCache.list = now, list
	return list
end

function isPassThrough(part)
	return part.Name == "HumanoidRootPart" or part.Name == "CollisionCapsule"
		or part:FindFirstAncestorWhichIsA("Accessory") ~= nil or part:HasTag("CharacterAccessory")
end
Ballistics.isPassThrough = isPassThrough

function Ballistics.isGlass(part)
	return part.Material == Enum.Material.Glass or part:HasTag("BreakableGlass")
		or (part.Parent ~= nil and part.Parent:HasTag("BreakableGlass"))
end

local function toHit(result, isExit)
	return {
		Instance = result.Instance, Position = result.Position, Normal = result.Normal,
		Material = result.Material.Name, Exit = isExit == true,
	}
end

Ballistics.penBonus = {
	[Enum.Material.Plastic] = 10, [Enum.Material.SmoothPlastic] = 10, [Enum.Material.Wood] = 10, [Enum.Material.WoodPlanks] = 10,
	[Enum.Material.Cardboard] = 10, [Enum.Material.Glass] = 25, [Enum.Material.Fabric] = 25,
}
Ballistics.penVariants = { ["Sandy Brick"] = true, IndoorWall = true }

-- How much a bullet loses when it leaves a wall of that material. Glass is
-- free, metal and concrete eat a lot of damage, wood barely does.
Ballistics.wallDamage = {
	[Enum.Material.Glass] = 1, [Enum.Material.Plastic] = 0.9, [Enum.Material.SmoothPlastic] = 0.9,
	[Enum.Material.Wood] = 0.88, [Enum.Material.WoodPlanks] = 0.88, [Enum.Material.Cardboard] = 0.92,
	[Enum.Material.Fabric] = 0.95, [Enum.Material.Metal] = 0.55, [Enum.Material.CorrodedMetal] = 0.5,
	[Enum.Material.DiamondPlate] = 0.45, [Enum.Material.Concrete] = 0.5, [Enum.Material.Brick] = 0.5,
	[Enum.Material.Cobblestone] = 0.5, [Enum.Material.Slate] = 0.45, [Enum.Material.Basalt] = 0.45,
	[Enum.Material.Granite] = 0.45, [Enum.Material.Marble] = 0.45,
}

function Ballistics.wallPenalty(material, thickness)
	local factor = material and Ballistics.wallDamage[material] or 0.6
	-- A thick wall eats a little more than a thin one.
	local thin = 1 - math.clamp((thickness or 1) / 8, 0, 1) * 0.35
	return factor * thin
end

-- Autowall как в шитаро: накопленная толщина по материалу (или варианту),
-- толщина по лучу назад от выхода, порог = бонус материала + Penetration оружия,
-- карта Reactor даёт -1 к бонусу нулевых материалов.
local function penThreshold(bonus)
	if bonus ~= 0 then return bonus end
	if workspaceService:GetAttribute("Map") == "Reactor" then return -1 end
	return 0
end

local function wallMaterial(part)
	local parent = part.Parent
	if parent and parent:HasTag("BreakableDoor") then return Enum.Material.Metal end
	return part.Material
end

Ballistics.wallMaterial = wallMaterial
-- Materials the server really refused to shoot through; each one is learned from a failed wall shot.
Ballistics.matBlocked = {}
-- Per-material share of the computed penetration the server really allows; learned from wall shot results.
Ballistics.penScale = {}

-- The game ships its own penetration code (ReplicatedStorage.Shared.Raycast); the server runs the same rules.
-- Asking it directly tells us exactly which wall shots the server will let through.
local oracleFn = type(Game.modules.raycast) == "table" and rawget(Game.modules.raycast, "castThroughDistance") or nil

local function oracleTrace(origin, direction, range, character, maxWalls, pen)
	if type(oracleFn) ~= "function" or not character then return nil end
	local ok, list = pcall(oracleFn, origin, direction.Unit * range, pen, Ballistics.ignoreList(), character)
	if not ok or type(list) ~= "table" then return nil end

	local hits, seen, walls, reached = {}, {}, 0, false
	for _, entry in ipairs(list) do
		local instance = entry.instance
		if typeof(instance) ~= "Instance" then break end
		local isExit = seen[instance] == true
		hits[#hits + 1] = {
			Instance = instance, Position = entry.position, Normal = entry.normal,
			Material = tostring(entry.material and entry.material.Name or entry.material), Exit = isExit,
		}
		if instance:IsDescendantOf(character) then reached = true break end
		if not isExit then
			seen[instance] = true
			if not Ballistics.isGlass(instance) then walls += 1 end
		end
	end
	if walls > maxWalls then reached = false end
	return hits, reached, walls
end

function Ballistics.trace(origin, direction, range, targetCharacter, maxWalls, penetration)
	local weapon = Game.weapon()
	local pen = penetration or (weapon and weapon.Properties and weapon.Properties.Penetration) or 0
	local hits, reached, walls = oracleTrace(origin, direction, range, targetCharacter, maxWalls or 0, pen)
	if not hits then return Ballistics.traceLocal(origin, direction, range, targetCharacter, maxWalls, penetration) end
	if walls == 0 or not reached then return hits, reached, walls end
	-- A wall shot needs both the game's rules and the learned local thickness check to agree.
	local lhits, lreached, lwalls = Ballistics.traceLocal(origin, direction, range, targetCharacter, maxWalls, penetration)
	if reached and not lreached then return lhits, false, lwalls end
	return hits, reached, walls
end

function Ballistics.traceLocal(origin, direction, range, targetCharacter, maxWalls, penetration)
	traceParams.FilterDescendantsInstances = Ballistics.ignoreList()

	local weapon = Game.weapon()
	local pen = penetration or (weapon and weapon.Properties and weapon.Properties.Penetration) or 0
	local dir = direction.Unit
	local hits, walls, cursor = {}, 0, origin
	local characters = workspaceService:FindFirstChild("Characters")
	local spent = {}

	for _ = 1, 48 do
		local remaining = range - (cursor - origin).Magnitude
		if remaining <= 0 then break end

		local result = workspaceService:Raycast(cursor, dir * remaining, traceParams)
		if not result then break end
		traceParams:AddToFilter(result.Instance)

		local part = result.Instance
		if not isPassThrough(part) then
			local blockedUntil = Ballistics.blocked[part]
			if blockedUntil and blockedUntil > os.clock() and not (characters and part:IsDescendantOf(characters)) then
				hits[#hits + 1] = toHit(result, false)
				return hits, false, walls + 1
			end
			if targetCharacter and part:IsDescendantOf(targetCharacter) then
				hits[#hits + 1] = toHit(result, false)
				return hits, true, walls
			end
			if characters and part:IsDescendantOf(characters) then
				hits[#hits + 1] = toHit(result, false)
				return hits, targetCharacter == nil, walls
			end

			if not Ballistics.isGlass(part) then walls += 1 end
			hits[#hits + 1] = toHit(result, false)
			if walls > maxWalls then return hits, false, walls end

			-- Луч назад от входа: даёт выход и толщину стены.
			exitParams.FilterDescendantsInstances = { part }
			local far = result.Position + dir * 1000
			local back = workspaceService:Raycast(far, result.Position - far, exitParams)
			if not back then return hits, false, walls end

			local thickness = (back.Position - result.Position).Magnitude
			local variant = part.MaterialVariant
			local key, bonus
			if variant ~= "" and Ballistics.penVariants[variant] then
				key, bonus = variant, 0
			else
				key = wallMaterial(part)
				bonus = Ballistics.penBonus[key] or 0
			end

			spent[key] = (spent[key] or 0) + thickness
			if spent[key] > (penThreshold(bonus) + pen) * (Ballistics.penScale[key] or 0.75) then return hits, false, walls end

			hits[#hits + 1] = toHit(back, true)
			cursor = back.Position + dir * 0.001
		end
	end

	return hits, false, walls
end


function Ballistics.wallResult(name, walls, accepted, parts)
	if not name or walls <= 0 then return end
	for _, wallPart in ipairs(parts or {}) do
		local ok, material = pcall(Ballistics.wallMaterial, wallPart)
		if ok and material then
			Ballistics.matBlocked[material] = nil
			local current = Ballistics.penScale[material] or 0.75
			Ballistics.penScale[material] = accepted and math.min(1, current + 0.04) or math.max(0.3, current - 0.1)
		end
	end
	local key = name .. ":" .. walls
	local st = Neverlose.stats or {}
	Neverlose.stats = st
	if accepted then
		st.wallOk = (st.wallOk or 0) + 1
		st.wallStreak = 0
		Ballistics.wallFails[key] = 0
		local learned = Ballistics.wallLimit[name]
		if learned and walls > learned.limit then Ballistics.wallLimit[name] = nil end
		return
	end
	st.wallFail = (st.wallFail or 0) + 1
	st.wallStreak = (st.wallStreak or 0) + 1
	if st.wallStreak >= 8 then
		Ballistics.wallPause = os.clock() + 10
		st.wallStreak = 0
	end
	Ballistics.wallFails[key] = (Ballistics.wallFails[key] or 0) + 1
	-- Три отказа подряд по одному и тому же числу стен — только тогда это
	-- похоже на серверный лимит, а не на разброс или бегущую цель. Раньше
	-- хватало двух промахов, и автоволл душился на 45 секунд.
	if Ballistics.wallFails[key] >= 4 then
		Ballistics.wallLimit[name] = { limit = math.max(walls - 1, 0), expires = os.clock() + 20 }
		Ballistics.wallFails[key] = 0
	end
end

function Ballistics.withDistances(origin, hits)
	local last = origin
	for _, hit in ipairs(hits) do
		hit.Distance = (hit.Position - last).Magnitude
		last = hit.Position
	end
	return hits
end

-- Урон как в шитаро: falloff по дистанции, один WallbangMultiplier за пробитие,
-- броня: часть урона уходит в броню (до её запаса), остаток идёт в HP.
function Ballistics.damage(properties, partName, distance, walls, character)
	local group = PART_GROUP[partName]
	local perPart = properties and properties.DamagePerPart
	if not group or type(perPart) ~= "table" or not perPart[group] then
		return properties and properties.Damage or 0
	end

	local base = perPart[group]
	if base <= 0 then return 0 end

	local damage = base * (properties.RangeModifier or 1) ^ math.max((distance / 0.075) / 500, 0)
	if walls > 0 then
		damage *= (properties.WallbangMultiplier or 0.5) ^ walls
	end

	local armor, helmet = Game.armor(character)
	if armor > 0 and (group ~= "Head" or helmet) then
		local armorPen = math.clamp(properties.ArmorPenetration or 1, 0, 1)
		local after = damage * armorPen
		local absorbed = (damage - after) * 0.5
		if absorbed > armor then
			absorbed = armor
			after = damage - armor / 0.5
		end
		damage = math.max(after, 0)
	end

	return damage * (properties.BulletsPerShot or 1)
end


function Ballistics.allowedWalls(weapon, enabled, cap)
	if not enabled then return 0 end
	-- Three wall shots in a row that the server did not take: pause wallbangs for a while.
	if os.clock() < (Ballistics.wallPause or 0) then return 0 end
	local config = Neverlose.config.rage
	-- Сколько стен вообще считать, задаёт пользователь (Max Walls). Реальную
	-- возможность пробития проверяет Ballistics.trace — по материалу, толщине
	-- и Penetration оружия. Раньше здесь была эвристика от Penetration/10,
	-- которая при Penetration 0.9 (SSG 08) резала всё до одной стены, хотя
	-- WallbangMultiplier 0.98 позволяет пробивать заметно больше.
	local base = tonumber(cap) or tonumber(config.maxWalls) or 2
	base = math.clamp(math.floor(base), 0, 4)
	if base <= 0 then return 0 end

	-- Мягкий выученный лимит: сервер уже отклонял пробития с таким числом стен.
	-- Живёт 20 секунд, чтобы одна неудачная серия не отключала автоволл на
	-- весь матч, и восстанавливается первым же успешным пробитием.
	local stats = Neverlose.stats or {}
	local learned = weapon and Ballistics.wallLimit[weapon.Name]
	if learned and os.clock() < learned.expires then return math.max(math.min(base, learned.limit), 0) end
	return base
end

local velocities = setmetatable({}, { __mode = "k" })
local lastRoots = setmetatable({}, { __mode = "k" })
history = setmetatable({}, { __mode = "k" })
Ballistics.history = history
Ballistics.wallLimit, Ballistics.wallFails = {}, {}
Ballistics.blocked = setmetatable({}, { __mode = "k" })

maid:give(runService.Heartbeat:Connect(function(delta)
	if delta <= 0 then return end
	local now = os.clock()
	local keep = HISTORY_WINDOW[Neverlose.config.rage.history] or 0

	for _, entity in ipairs(Game.entities()) do
		local character = entity ~= localPlayer and Game.character(entity)
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local previous = lastRoots[entity]
			if previous then
				local velocity = (root.Position - previous) / delta
				if velocity.Magnitude > 80 then velocity = Vector3.zero end
				velocities[entity] = (velocities[entity] or velocity):Lerp(velocity, 0.35)
			end
			lastRoots[entity] = root.Position
			Ballistics.sample(entity, root.Position, now)

			if keep > 0 then
				local records = history[entity] or {}
				history[entity] = records
				local record = { t = now, cframes = {} }
				for _, name in ipairs(BODY_PARTS) do
					local part = character:FindFirstChild(name)
					if part then record.cframes[name] = part.CFrame end
				end
				records[#records + 1] = record
				while records[1] and now - records[1].t > keep do
					table.remove(records, 1)
				end
			else
				history[entity] = nil
			end
		else
			lastRoots[entity], velocities[entity], history[entity] = nil, nil, nil
			Ballistics.samples[entity] = nil
		end
	end
end))

function Ballistics.predict(entity, position, ms)
	local velocity = ms > 0 and velocities[entity]
	if not velocity then return position end
	return position + Vector3.new(velocity.X, velocity.Y * 0.5, velocity.Z) * (ms / 1000)
end

function Ballistics.velocity(entity)
	return velocities[entity] or Vector3.zero
end

-- Ring buffer of replicated root positions (~0.3 s). A sample is stored only when the rig actually moved,
-- so frames without a replication update add nothing.
Ballistics.samples = setmetatable({}, { __mode = "k" })
function Ballistics.sample(entity, position, now)
	local ring = Ballistics.samples[entity]
	if not ring then
		ring = { head = 0, count = 0, ts = {}, ps = {} }
		Ballistics.samples[entity] = ring
	end
	if ring.count > 0 then
		local step = (position - ring.ps[ring.head]).Magnitude
		if step < 0.02 then return end
		if step > 10 then ring.count = 0 end
	end
	local head = ring.head % 32 + 1
	ring.head, ring.ts[head], ring.ps[head] = head, now, position
	ring.count = math.min(ring.count + 1, 32)
end

-- Horizontal velocity over the buffer window. Zero when the target stopped, reversed direction, or the
-- numbers look like a teleport. The newer half wins when it is slower, so a stop is not overshot.
function Ballistics.smoothVelocity(entity, position, now)
	local ring = Ballistics.samples[entity]
	if not ring or ring.count < 3 then return Vector3.zero end
	local total, first = 0, nil
	for back = 0, ring.count - 1 do
		local index = (ring.head - 1 - back) % 32 + 1
		if now - ring.ts[index] > 0.3 then break end
		total += 1
		first = index
	end
	if total < 3 then return Vector3.zero end
	local mid = (first - 1 + total // 2) % 32 + 1
	local t0, p0, tm, pm = ring.ts[first], ring.ps[first], ring.ts[mid], ring.ps[mid]
	if now - t0 < 0.1 or now - tm < 0.04 then return Vector3.zero end

	local newer = Vector3.new(position.X - pm.X, 0, position.Z - pm.Z) / (now - tm)
	local older = newer
	if tm - t0 > 0.03 then older = Vector3.new(pm.X - p0.X, 0, pm.Z - p0.Z) / (tm - t0) end
	local newSpeed, oldSpeed = newer.Magnitude, older.Magnitude
	if newSpeed < 3 or newSpeed > 40 or oldSpeed > 40 then return Vector3.zero end
	if oldSpeed >= 3 and newer:Dot(older) / (newSpeed * oldSpeed) < 0.2 then return Vector3.zero end
	if newSpeed <= oldSpeed then return newer end
	return (newer + older) * 0.5
end

function Ballistics.points(part, enabled, count)
	local points = { part.Position }
	if not enabled then return points end
	local half = part.Size * 0.25
	local cf = part.CFrame
	local extra = tonumber(count)
	local wanted = extra and math.clamp(math.floor(extra), 0, 10) or 5
	if wanted <= 0 then return points end
	-- Крест из старой версии идёт первым, поэтому при счётчике 4 набор не меняется.
	local cross = {
		Vector3.new(0, half.Y, 0), Vector3.new(half.X, 0, 0), Vector3.new(-half.X, 0, 0),
	}
	if part.Name ~= "Head" then cross[#cross + 1] = Vector3.new(0, -half.Y, 0) end
	for index = 1, math.min(#cross, wanted) do points[#points + 1] = cf * cross[index] end
	-- Остальное (счётчик больше креста): точки по спирали внутри хитбокса.
	local rest = wanted - #cross
	if extra and rest > 0 then
		local radius = math.min(part.Size.X, part.Size.Y, part.Size.Z) * 0.32
		if radius >= 0.05 then
			for index = 1, rest do
				local y = 1 - (2 * (index - 0.5)) / rest
				local ring = math.sqrt(math.max(1 - y * y, 0))
				local angle = index * 2.399963229728653
				points[#points + 1] = cf:PointToWorldSpace(Vector3.new(math.cos(angle) * ring, y, math.sin(angle) * ring) * radius)
			end
		end
	end
	return points
end

smokes = setmetatable({}, { __mode = "k" })
Ballistics.smokes = smokes

local smokeParams = RaycastParams.new()
smokeParams.FilterType = Enum.RaycastFilterType.Include

function Ballistics.throughSmoke(from, to)
	local parts = {}
	for model in pairs(smokes) do
		if model.Parent then
			parts[#parts + 1] = model
		else
			smokes[model] = nil
		end
	end
	for _, grenade in ipairs(collectionService:GetTagged("Smoke")) do
		parts[#parts + 1] = grenade
	end
	if #parts == 0 then return false end
	smokeParams.FilterDescendantsInstances = parts
	return workspaceService:Raycast(from, to - from, smokeParams) ~= nil
end

