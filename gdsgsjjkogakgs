	---Skybox folders on disk: a folder holding six faces named *_bk/_dn/_ft/_lf/_rt/_up.
	local function scanLocalSkies()
		if localSkies then return localSkies end
		localSkies = {}
		if not (listfiles and isfolder and getcustomasset) then return localSkies end
		for _, root in ipairs(SKY_ROOTS) do
			local okRoot, folders = pcall(function() return isfolder(root) and listfiles(root) or {} end)
			for _, folder in ipairs(okRoot and folders or {}) do
				local okFiles, files = pcall(listfiles, folder)
				local faces, count = {}, 0
				for _, file in ipairs(okFiles and files or {}) do
					local side = tostring(file):lower():match("[_%-%./\\](%a%a)%.%a+$")
					if side and SKY_SIDES[side] and not faces[SKY_SIDES[side]] then
						faces[SKY_SIDES[side]] = file
						count += 1
					end
				end
				if count == 6 then
					local name = "local: " .. tostring(folder):match("[^/\\]+$")
					localSkies[name] = localSkies[name] or faces
				end
			end
		end
		return localSkies
	end

