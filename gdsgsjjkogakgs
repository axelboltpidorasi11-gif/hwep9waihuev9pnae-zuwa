	local entry = {
		kind = "flight", t = os.clock(), life = flight + (sparkle and math.max(tailDelay, sparkleLife) + 0.1 or tailDelay + 0.15), emitters = emitters, from = from, to = finish, flight = flight, tailDelay = tailDelay,
		distance = distance, tailPart = tailPart, headPart = headPart, layers = layers, head = head, helix = helix, sparkPart = sparkPart, parts = { tailPart, headPart, helix and helix.holder, sparkPart }, base = {},
