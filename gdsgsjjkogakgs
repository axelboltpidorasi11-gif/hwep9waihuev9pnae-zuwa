-- Список стилей чамсов: только те, что реально рисуются в текущем пайплайне (см. CHAMS_STYLE).
-- Убраны Hologram (тот же ForceField, что у Wireframe), Crystal (тот же Glass, что у Water Flow)
-- и старые Chams/Flat/Glass, которых в меню давно нет.
-- Основные рабочие стили; остальные стили живут в CHAMS_STYLE и вернутся добавлением имени сюда.
local MATERIALS = { "Disabled", "Shaded", "Solid", "Glow", "Glow Outline", "Neon", "Neon Glow", "Glossy", "Iridescent", "Fresnel" }
local function withoutModes(list, ...)
	local skip, out = {}, {}
	for _, name in ipairs({ ... }) do skip[name] = true end
	for _, name in ipairs(list) do
		if not skip[name] then out[#out + 1] = name end
	end
	return out
end
-- Neon и Neon Glow живут на объектах ESP врагов (viewport / BoxHandleAdornment), на своей модели и viewmodel их нет.
local LOCAL_MATERIALS = withoutModes(MATERIALS, "Neon", "Neon Glow")
-- History рисуется через drawGhost, где Neon Glow (fill 1, outline 1) невидим.
local HISTORY_MATERIALS = withoutModes(MATERIALS, "Neon Glow")

-- Сохранённый конфиг с удалённым режимом безопасно падает на Shaded.
local function validMode(list, mode, fallback)
	if type(mode) == "string" and table.find(list, mode) then return mode end
	return fallback or "Shaded"
end

function Neverlose.normalizeChams()
	local esp = Neverlose.config.esp
	for key, entry in pairs(esp.enemyModel) do
		if type(entry) == "table" and entry.mode ~= nil then
			entry.mode = validMode(key == "history" and HISTORY_MATERIALS or MATERIALS, entry.mode)
		end
	end
	for _, entry in pairs(esp.teamModel) do
		if type(entry) == "table" and entry.mode ~= nil then entry.mode = validMode(MATERIALS, entry.mode) end
	end
	local localConfig = esp.localModel
	for _, key in ipairs({ "model", "weapon", "hands" }) do
		if localConfig[key] ~= "Default" then localConfig[key] = validMode(LOCAL_MATERIALS, localConfig[key]) end
	end
end

function Neverlose.modelRow(section, text, entry, options)
	options = options or MATERIALS
	entry.mode = validMode(options, entry.mode)
	local control = section:AddDropdownColorpicker(text, options, entry.color, function(mode) entry.mode = validMode(options, mode) end, function(color) entry.color = color end)
	if type(control) == "table" and entry.mode ~= options[1] then
		pcall(function() control:Set(entry.mode) end)
	end
	Neverlose.rb(control, entry, "color")
	return control
end

function Neverlose.colorToggle(section, text, entry)
	return section:AddColorToggle(text, entry.color, entry.on, function(color, enabled)
		if color ~= nil and typeof(color) == "Color3" then entry.color = color end
		if type(enabled) == "boolean" then entry.on = enabled end
	end)
end

function Neverlose.toggleColor(section, text, tbl, key, colorKey)
	return section:AddColorToggle(text, tbl[colorKey], tbl[key], function(color, enabled)
		if color ~= nil and typeof(color) == "Color3" then tbl[colorKey] = color end
		if type(enabled) == "boolean" then tbl[key] = enabled end
	end)
end

