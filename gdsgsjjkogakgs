do
local occParams = RaycastParams.new()
occParams.FilterType = Enum.RaycastFilterType.Exclude
local occAt = -1
local passList = {}

function blockedBetween(from, to)
	local now = os.clock()
	if now - occAt > 0.5 then
		occAt = now
		local list = { currentCamera, effectsFolder, localPlayer.Character }
		for _, entity in ipairs(Game.entities()) do
			local body = entity.Character
			if typeof(body) == "Instance" then list[#list + 1] = body end
		end
		for index = #passList, 1, -1 do
			if passList[index].Parent then list[#list + 1] = passList[index] else table.remove(passList, index) end
		end
		occParams.FilterDescendantsInstances = list
	end
	local blocked = false
	for _ = 1, 4 do
		local hit = workspaceService:Raycast(from, to - from, occParams)
		if not hit then break end
		local part = hit.Instance
		if part.Transparency < 0.9 and part.CanCollide then blocked = true break end
		occParams:AddToFilter(part)
		if #passList < 400 then passList[#passList + 1] = part end
		from = hit.Position
	end
	return blocked
end

function bodySight(from, root, head)
	local right = root.CFrame.RightVector
	local base = root.Position
	local points = { base, base + right * 1.1, base - right * 1.1, base - Vector3.new(0, 2, 0) }
	if head then points[5] = head.Position end
	local seen = 0
	for _, point in ipairs(points) do
		if not blockedBetween(from, point) then seen += 1 end
	end
	return seen / #points
end
end

end

