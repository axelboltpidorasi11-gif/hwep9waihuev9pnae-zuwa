---Run a per-frame animation for a fixed time, then clean up.
function HitEffects.animate(duration, step, finish)
	local started = os.clock()
	local connection
	connection = realRunService.RenderStepped:Connect(function()
		local age = os.clock() - started
		local alive = age < duration and pcall(step, age / duration, age)
		if not alive then
			connection:Disconnect()
			if finish then pcall(finish) end
		end
	end)
end

