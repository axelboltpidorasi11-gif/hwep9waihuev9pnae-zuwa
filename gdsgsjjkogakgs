local function recoilScale()
	local rage, legit = Neverlose.config.rage, Neverlose.config.legit
	if rage.noRecoil then return 1 - rage.recoilReduction / 100, 1 end
	if (legit.master and legit.enabled and legit.rcs) or (legit.master and legit.standaloneRcs) then
		return 1 - legit.rcsReduction / 100, 0.5 + legit.rcsRecovery / 100
	end
	return 1, 1
end

local function kickScale()
	local visual = Neverlose.config.world.visualRecoil
	local scale = visual == "None" and 0 or visual == "Reduced" and 0.5 or 1
	local rage = Neverlose.config.rage
	if rage.noRecoil then scale *= 1 - rage.recoilReduction / 100 end
	return scale
end

local function scaledSpring(spring, scale, speedScale)
	return { Value = spring.Value * scale, Damper = spring.Damper, Speed = (spring.Speed or 1) * (speedScale or 1) }
end

local cameraModule = Game.modules.camera
if cameraModule and type(cameraModule.setWeaponRecoil) == "function" then
	Patch.hook(cameraModule.setWeaponRecoil, function(original)
		return function(spring, ...)
			local scale, speed = recoilScale()
			if (scale >= 1 and speed == 1) or type(spring) ~= "table" then return original(spring, ...) end
			return original(scaledSpring(spring, scale, speed), ...)
		end
	end)
end
