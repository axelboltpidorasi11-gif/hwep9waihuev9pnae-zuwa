	local animationClass = Game.modules.animation
	if animationClass and type(animationClass.play) == "function" then
		Patch.hook(animationClass.play, function(original)
			return function(self, name, ...)
				local track = original(self, name, ...)
				local config = Neverlose.config.rage
				if config.instaReload and track and type(name) == "string" and name:find("^Reload") then
					local speed = math.max(tonumber(config.reloadSpeed) or 1, 1)
					pcall(function() track:AdjustSpeed(speed) end)
					-- Shotguns reload shell by shell and the game waits for (Length * k) instead of the track's end,
					-- so a faster track alone changes nothing: report a proportionally shorter Length for those steps.
					if name == "ReloadStart" or name == "ReloadAction" or name == "ReloadEnd" then
						local real = track
						local okProxy, proxy = pcall(setmetatable, {}, {
							__index = function(_, key)
								if key == "Length" then return real.Length / speed end
								local value = real[key]
								if type(value) == "function" then return function(_, ...) return value(real, ...) end end
								return value
							end,
							__newindex = function(_, key, value) real[key] = value end,
						})
						if okProxy then track = proxy end
					end
				end
				local features = Neverlose.config.features
				if features.fastEquip ~= false and track and name == "Equip" then
					pcall(function() track:AdjustSpeed(features.equipSkip and 100 or (features.equipSpeed or 3)) end)
				end
				return track
			end
		end)
	end
end

