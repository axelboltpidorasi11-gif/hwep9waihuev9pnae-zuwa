function Rage.refresh(weapon, config)
	local now = os.clock()

	local interval = #Rage.targets == 0 and 1 / 45 or (((Neverlose.stats or {}).scanMs or 99) < 2.5 and 1 / 60 or 1 / math.max(config.scanHz, 1))
	if now - Rage.lastScan >= interval then
		Rage.lastScan = now
		local scanStart = os.clock()
		local results = Rage.scanAll(weapon, hitboxParts(config.hitboxList, config.hitboxes), setFromSet(hitboxParts(config.multipointList, config.multipoint, true)), config.fov)
		local scanTime = (os.clock() - scanStart) * 1000
		local st = Neverlose.stats or {}
		Neverlose.stats = st
		st.scanMs = (st.scanMs or scanTime) * 0.8 + scanTime * 0.2
		st.scanMax = math.max(st.scanMax or 0, scanTime)

		if Rage.sticky then
			for _, entry in ipairs(results) do
				if entry.entity == Rage.sticky then entry.score -= 30 end
			end
			table.sort(results, function(a, b) return a.score < b.score end)
		end
		Rage.sticky = results[1] and results[1].entity or nil
		Rage.targets = results
	else
		for index = #Rage.targets, 1, -1 do
			local entry = Rage.targets[index]
			if not (entry.part and entry.part.Parent) or not Game.character(entry.entity) then table.remove(Rage.targets, index) end
		end
	end
	return Rage.targets
end

function Rage.requiredChance(weapon, target, config)
	local fixedChance = config.hitChance or 0
	if fixedChance > 0 and config.autoHitChance == false then return fixedChance end
	local properties = weapon.Properties
	local need
	if Game.isSniper(weapon) then
		need = 75
	elseif (properties.BulletsPerShot or 1) > 1 then
		need = 40
	elseif (properties.FireRate or 0.1) < 0.1 then
		need = 50
	else
		need = 65
	end
	if (target.distance or 100) < 20 then need -= 10 end
	if (target.damage or 0) >= (target.health or 100) then need -= 15 end
	local streak = Rage.missStreak and Rage.missStreak[target.entity]
	if streak and os.clock() - streak.t < 2.5 then need += math.min(streak.n * 3, 9) end
	return math.clamp(need, 20, 95)
end

local function rageStep()
	local config = Neverlose.config.rage
	Rage.target, Rage.stopping, Rage.shooting = nil, false, false
	if not config.enabled or Game.isChatting() or not Game.localCharacter() then
		Rage.stable = 0
		Rage.targets = {}
		return
	end

	local weapon = Game.weapon()
	if not (weapon and weapon.Bullet and weapon.Properties) then return end

	local targets = Rage.refresh(weapon, config)
	local target = targets[1]
	Rage.target = target
	if target then Rage.lastTargetAt = os.clock() end
	if target and not Rage.seenAt then
		Rage.seenAt = os.clock()
	elseif not target and os.clock() - (Rage.lastTargetAt or 0) > 0.3 then
		Rage.seenAt = nil
	end
	Rage.stable = target and Rage.stable + 1 or ((os.clock() - (Rage.lastTargetAt or 0) < 0.12) and Rage.stable or 0)
	if not (target and config.autoFire and Game.weaponReady(weapon)) then return end

	if config.quickStop then Rage.stopping = true end

	local sniper = Game.isSniper(weapon)
	local revolver = weapon.Properties.ShootingOptions == "Revolver"

	local direct = not revolver and (config.doubleTap or config.rapidFire)
	local need = Rage.requiredChance(weapon, target, config)

	if (target.walls or 0) > 0 then
		need = math.min(need + 8, 97)
		if Rage.stable < 4 then return end
	end
	if not direct and target.chance < need then return end
	if direct and target.chance < need * 0.65 and (target.damage or 0) < (target.health or 100) then return end
	if direct and (target.walls or 0) > 0 and target.chance < need then return end
	local delayList = type(config.delayShot) == "table" and config.delayShot or {}
	local needDamage, needChance = table.find(delayList, "Damage"), table.find(delayList, "Hit Chance")
	if needDamage or needChance then
		if Rage.stable < 3 then return end
		if Rage.delayEntity ~= target.entity then Rage.delayEntity, Rage.delaySince = target.entity, os.clock() end
		local ready = true
		if needDamage and (target.damage or 0) < math.max(config.minDamage, math.min(target.health or 100, 40)) then ready = false end
		if needChance and target.chance < math.min(need + 10, 99) then ready = false end
		if not ready and os.clock() - (Rage.delaySince or 0) < 0.3 then return end
	end

	local streak = Rage.missStreak and Rage.missStreak[target.entity]
	if streak and streak.n >= 2 and os.clock() - streak.t < 1.2 then
		if Rage.stable < 2 then return end
	end

	if sniper then
		local scoped = weapon.IsSniperScoped or (weapon.CurrentScopeIncrement or 0) > 0
		scoped = true
		if not scoped then
			if mouse2click and os.clock() - (Rage.scopeAsked or 0) > 0.5 then
				Rage.scopeAsked = os.clock()
				mouse2click()
			end
			return
		end
		if os.clock() - (Rage.scopeAsked or 0) < (config.quickScope and 0.02 or 0.12) then return end
		if config.quickStop and (Rage.selfSpeed or 0) > 4 then return end
	end

	local now = os.clock()
	local alternate = revolver and weapon.Properties.FireModes and weapon.Properties.FireModes.Secondary
	local fireRate = alternate and alternate.FireRate or weapon.Properties.FireRate or 0.1
	local semiAuto = fireRate >= 0.3 or weapon.Properties.FireMode == "Semi" or weapon.Properties.ShootingOptions == "Semi"
	local recentMiss = Rage.missStreak and Rage.missStreak[target.entity]
	local cooling = (recentMiss and recentMiss.n >= 2 and os.clock() - recentMiss.t < 1.5) or os.clock() < (Rage.rapidCoolUntil or 0)
	local rapidOk = (target.walls or 0) == 0 and target.chance >= need * 0.95 and (target.distance or 0) < 110 and Rage.stable >= 3
	local multiplier = (config.rapidFire and not semiAuto and not cooling and rapidOk) and math.max(Rage.rapidMultiplier(config, fireRate, weapon.Name), 1) or 1
	local cadence = math.max(fireRate / multiplier + 0.012, 0.055)
	if now - lastShot < cadence then return end
	if semiAuto then
		local waiting = ShotTracker.pending[target.entity]
		if waiting and now - waiting.t < math.min(fireRate + 0.12, 0.45) then return end
	end
	local retryAt = now - cadence + 0.07
	lastShot = now
	Rage.shooting = true
	local shotStats = Neverlose.stats or {}
	Neverlose.stats = shotStats
	shotStats.shots = (shotStats.shots or 0) + 1
	shotStats.reactMs = (now - (Rage.seenAt or now)) * 1000
	Rage.delayEntity = nil

	local multi = config.multiTarget and #targets > 1
	if not revolver and (direct or multi or config.doubleTap) then
		local list = {}
		for _, entry in ipairs(targets) do
			if direct or entry.chance >= Rage.requiredChance(weapon, entry, config) then list[#list + 1] = entry end
		end
		if #list == 0 then list[1] = target end

		local perTarget = (config.doubleTap and (weapon.Rounds or 0) >= 2 and (target.walls or 0) == 0) and 2 or 1
		local budget = (config.multiTarget and #list or 1) * perTarget
		local gap = perTarget == 2 and Rage.tapGap(fireRate) or 0
		Rage.lastGap = gap

		local plan = {}
		for _, entry in ipairs(list) do
			if budget <= 0 then break end
			local need = entry.damage > 0 and math.ceil(entry.health / entry.damage) or 1
			local count = math.clamp(need, 1, math.min(perTarget, budget))
			plan[#plan + 1] = { entry = entry, count = count }
			budget -= count
			if not (config.multiTarget or config.doubleTap) then break end
		end

		local fired = 0
		for _, step in ipairs(plan) do
			for tapIndex = 1, step.count do
				if config.autoReload and config.remoteReload and (weapon.Rounds or 0) <= config.reloadAt then Rage.remoteReload(weapon) end
				if (weapon.Rounds or 0) <= 0 then break end
				if tapIndex == 1 or gap <= 0 then
					if Rage.remoteFire(weapon, step.entry, tapIndex) then fired += 1 end
				else
					local entry = step.entry
					task.delay(gap, function()
						if not Game.weaponReady(weapon) then return end

						if (Neverlose.isDown and Neverlose.isDown(entry.entity)) or not Game.character(entry.entity) then return end
						local again = Rage.target
						if not (again and again.entity == entry.entity) then again = entry end
						Rage.remoteFire(weapon, again, tapIndex)
					end)
					fired += 1
				end
			end
		end

		if fired > 0 then
			lastShot = now + (fired > 1 and (gap > 0 and gap or fireRate) or 0)
			return
		end
		if Rage.lastFail and os.clock() - (Rage.failLogAt or 0) > 2 then
			Rage.failLogAt = os.clock()
			Logs.push("Combat", "direct shot refused · " .. Rage.lastFail)
		end

		if multi or Rage.lastFail == "aim point blocked or out of range" then
			lastShot = retryAt
			return
		end
	end

	if not Rage.aimBullet({ Origin = Game.origin() }, target, weapon) then
		lastShot = retryAt
		return
	end

	if revolver and mouse2click then
		mouse2click()
	elseif mouse1click then
		mouse1click()
	end
end

