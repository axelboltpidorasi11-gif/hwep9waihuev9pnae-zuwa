T_WORDS = { "anarchist", "phoenix", "elite", "leet", "separatist", "balkan", "pirate", "professional", "guerrilla", "sabre", "terror", "t", "dragomir", "maximus", "osiris", "blackwolf", "rezan", "enforcer", "slingshot", "street", "crew" }

local function sideFromText(text)
	text = tostring(text or ""):lower()
	if text == "" then return nil end
	if text:find("counter") then return "CT" end
	if text:find("terror") then return "T" end
	local tokens = {}
	for token in text:gmatch("%w+") do tokens[token] = true end
	for _, word in ipairs(CT_WORDS) do
		if (#word <= 3 and tokens[word]) or (#word > 3 and text:find(word, 1, true)) then return "CT" end
	end
	for _, word in ipairs(T_WORDS) do
		if (#word <= 3 and tokens[word]) or (#word > 3 and text:find(word, 1, true)) then return "T" end
	end
	return nil
end

Skins.assetNames = {}
