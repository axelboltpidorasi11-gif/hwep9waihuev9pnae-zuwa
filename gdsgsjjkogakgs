---Map Selection: Global plus one saved ambience preset per map.
function Neverlose.buildMapList(section)
	Neverlose.presetControls = {}
	local presets = Neverlose.config.world.mapPresets
	local items, mapName = { "Global" }, Neverlose.presetMapName()
	for name in pairs(presets) do
		if name ~= "Global" then items[#items + 1] = name end
	end
	local selected = presets[mapName] and mapName or "Global"
	Neverlose.presetSelected = selected
	local list
	local maps = { "Select", "Main Menu" }
	do
		local lighting = replicatedStorage:FindFirstChild("Assets") and replicatedStorage.Assets:FindFirstChild("Lighting")
		local found = {}
		for _, child in ipairs(lighting and lighting:GetChildren() or {}) do found[#found + 1] = child.Name end
		table.sort(found)
		for _, name in ipairs(found) do maps[#maps + 1] = Neverlose.mapLabels[name] or name end
	end
	local picker
	picker = section:AddDropdown("Add Map", maps, "Select", function(label)
		if label == "Select" or not list then return end
		local name = Neverlose.mapNames[label] or label
		local listed = list:GetItems()
		if not presets[name] then presets[name] = Neverlose.presetSnapshot() end
		if not table.find(listed, name) then table.insert(listed, name) end
		Neverlose.presetSelect(name)
		list:Set(name)
		if picker and picker.Set then picker:Set("Select", true) end
	end)
	list = section:AddList({
		items = items, selected = selected, current = mapName,
		onSelect = function(name) Neverlose.presetSelect(name) end,
		onAdd = function(name)
			presets[name] = Neverlose.presetSnapshot()
		end,
		onOptions = function(name)
			Neverlose.presetMenu(name, name ~= "Global", function(action)
				local listed = list:GetItems()
				if action == "Delete" then
					presets[name] = nil
					local at = table.find(listed, name)
					if at then table.remove(listed, at) end
					if Neverlose.presetSelected == name then
						Neverlose.presetSelected = "Global"
						if presets.Global then Neverlose.presetApply(presets.Global) end
					end
					list:Set("Global")
				elseif action == "Copy" then
					local base = name == "Global" and Neverlose.presetMapName() or name
					local copy, count = base, 1
					if presets[copy] or name ~= "Global" then copy = base .. " copy" end
					while presets[copy] do
						count += 1
						copy = base .. " copy " .. count
					end
					local source = name == Neverlose.presetSelected and Neverlose.presetSnapshot() or presets[name]
					presets[copy] = table.clone(source or Neverlose.presetSnapshot())
					table.insert(listed, copy)
					list:Set(Neverlose.presetSelected)
				end
			end)
		end,
	})
	Neverlose.presetList = list
	Neverlose.watchMapCards()

	maid:give(workspaceService:GetAttributeChangedSignal("Map"):Connect(function()
		local name = Neverlose.presetMapName()
		list:SetCurrent(name)
		local target = presets[name] and name or "Global"
		if target ~= Neverlose.presetSelected then
			Neverlose.presetSelect(target)
			if table.find(list:GetItems(), target) then list:Set(target) end
		end
	end))
end

