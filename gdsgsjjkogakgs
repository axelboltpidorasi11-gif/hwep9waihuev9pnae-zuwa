do
	local NameSpoof = { fake = nil, hooked = setmetatable({}, { __mode = "k" }) }
	Neverlose.NameSpoof = NameSpoof

	local function escape(text) return (text:gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0")) end

	local function fakeName()
		local features = Neverlose.config.features
		if not features.nameSpoof then return nil end
		if features.nameMode == "Custom" then
			local text = features.nameCustom
			if type(text) == "string" and #text > 0 then return text end
		elseif features.nameMode == "Random" then
			NameSpoof.random = NameSpoof.random or ("User" .. math.random(10000, 99999))
			return NameSpoof.random
		end
		return "Neverlose"
	end

	local function patch(label)
		local fake = NameSpoof.fake
		if not fake then return end
		local text = label.Text
		if text == "" then return end
		for _, real in ipairs({ localPlayer.DisplayName, localPlayer.Name }) do
			if real ~= "" and text:find(real, 1, true) then
				text = text:gsub(escape(real), (fake:gsub("%%", "%%%%")))
			end
		end
		if text ~= label.Text then label.Text = text end
	end

	local function watch(object)
		if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then return end
		if NameSpoof.hooked[object] then return end
		NameSpoof.hooked[object] = true
		maid:give(object:GetPropertyChangedSignal("Text"):Connect(function() patch(object) end))
		patch(object)
	end

	function NameSpoof.prompt()
		Neverlose.Ui.prompt({
			title = "Custom name",
			placeholder = "Name shown instead of yours",
			default = Neverlose.config.features.nameCustom,
			hint = "",
			confirm = "Apply",
			onSubmit = function(text, setStatus)
				text = text:gsub("^%s+", ""):gsub("%s+$", "")
				if #text == 0 or #text > 24 then
					setStatus("1 to 24 characters", Color3.fromRGB(235, 120, 120))
					return false
				end
				Neverlose.config.features.nameCustom = text
				NameSpoof.refresh()
				setStatus("Applied", Color3.fromRGB(120, 220, 150))
				return true
			end,
		})
	end

	function NameSpoof.refresh()
		NameSpoof.fake = fakeName()
		if not NameSpoof.fake then return end
		local gui = localPlayer:FindFirstChildOfClass("PlayerGui")
		if not gui then return end
		for _, object in ipairs(gui:GetDescendants()) do watch(object) end
		for object in pairs(NameSpoof.hooked) do if object.Parent then patch(object) end end
	end

	task.spawn(function()
		local gui = localPlayer:WaitForChild("PlayerGui")
		maid:give(gui.DescendantAdded:Connect(function(object)
			if NameSpoof.fake then watch(object) end
		end))
		NameSpoof.refresh()
	end)
end

