function HitEffects.tracer(origin, finish, hit, normal, surfaces)
	local misc = Neverlose.config.misc
	local now = os.clock()
	if misc.tracers then
		local view = currentCamera.CFrame
		local from = origin + view.LookVector * 2.2 + view.RightVector * 0.45 - view.UpVector * 0.35
		if (finish - from).Magnitude < 3 then from = origin end
		local style = misc.tracerStyle or "Beam"
		if style == "Default" then style = "Comet" end
		if style ~= "Lightning" and style ~= "Comet" then style = "Neon" end
		local width = math.clamp((misc.tracerThickness or 2) * 0.03, 0.03, 0.4)
		local color = misc.tracerColor
		local entry = { kind = "tracer", t = now, life = misc.tracerLife or 1.5, style = style, parts = {}, base = {}, from = from, to = finish, width = width, color = color }
		local function add(part, base)
			if part then entry.parts[#entry.parts + 1], entry.base[#entry.parts + 1] = part, base end
		end
		local direction = finish - from
		local length = direction.Magnitude
		if style == "Laser" then
			add(beam(from, finish, width * 2.4, color, 0.6), 0.6)
			add(beam(from, finish, width * 0.5, Color3.new(1, 1, 1), 0), 0)
		elseif style == "Lightning" then
			local steps = math.clamp(math.floor(length / 4), 4, 28)
			local right, up = across(direction.Unit)
			local jitter = math.min(length / steps * 0.4, 1.5)
			local points = { from }
			for index = 1, steps - 1 do
				points[#points + 1] = from + direction * (index / steps) + right * ((math.random() - 0.5) * 2 * jitter) + up * ((math.random() - 0.5) * 2 * jitter)
			end
			points[#points + 1] = finish
			for index = 1, #points - 1 do add(beam(points[index], points[index + 1], width, color, 0), 0) end
		elseif style == "Dotted" then
			local count = math.clamp(math.floor(length / 2.2), 2, 90)
			for index = 0, count do
				add(effectPart(Enum.PartType.Ball, Vector3.new(width * 2.4, width * 2.4, width * 2.4), CFrame.new(from + direction * (index / count)), color, 0), 0)
			end
		elseif style == "Comet" then
			entry.life = math.min(entry.life, 1)
			add(beam(from, finish, width * 1.4, Color3.new(1, 1, 1), 0), 0)
			add(beam(from, finish, width * 5, color, 0.8), 0.8)
			add(beam(from, finish, width * 0.4, color, 0.7), 0.7)
		elseif style == "Pulse" then
			entry.life = math.min(entry.life, 0.9)
			add(beam(from, finish, width * 3, color, 0), 0)
			add(beam(from, finish, width * 0.4, color, 0.55), 0.55)
		elseif style == "Neon" then
			add(beam(from, finish, width * 5, color, 0.86), 0.86)
			add(beam(from, finish, width * 2.2, color, 0.45), 0.45)
			add(beam(from, finish, width * 0.7, Color3.new(1, 1, 1), 0), 0)
		else
			add(beam(from, finish, width * 3.2, color, 0.82), 0.82)
			add(beam(from, finish, width * 1.3, color, 0.25), 0.25)
			add(beam(from, finish, width * 0.45, Color3.new(1, 1, 1), 0), 0)
		end
		tracers[#tracers + 1] = entry
		pcall(HitEffects.sprite, from, color, 1.3, 0.16, GLOW_TEXTURE, false)
		if style == "Comet" then pcall(HitEffects.sprite, finish, color, 1.1, 0.22, GLOW_TEXTURE, false) end
		if hit then pcall(HitEffects.sprite, finish, color, 2.2, 0.3, GLOW_TEXTURE, false) end
	end

	if misc.impacts and hit then
		local list = {}
		for _, surface in ipairs(type(surfaces) == "table" and surfaces or {}) do
			if not surface.Exit and typeof(surface.Position) == "Vector3" then list[#list + 1] = surface end
		end
		if #list > 0 then
			for index = 1, math.min(#list, 4) do spawnImpact(list[index].Position, list[index].Normal) end
		else
			spawnImpact(finish, normal)
		end
	end
end

local function removeEffect(entry)
	for _, part in ipairs(entry.parts) do pcall(function() part:Destroy() end) end
end

maid:give(runService.RenderStepped:Connect(function()
	local now = os.clock()
	for index = #tracers, 1, -1 do
		local entry = tracers[index]
		local age = now - entry.t
		if age > entry.life then
			removeEffect(entry)
			table.remove(tracers, index)
		else
			local t = age / entry.life
			local fade = t * t
			if entry.kind == "tracer" then
				if entry.style == "Pulse" or entry.style == "Comet" then
					local comet = entry.style == "Comet"
					local head = math.clamp(age / (comet and 0.1 or 0.16), 0, 1)
					local tail = math.clamp((age - 0.05) / (comet and 0.3 or 0.16), 0, 1)
					local delta = entry.to - entry.from
					local a, b = entry.from + delta * tail, entry.from + delta * head
					local length = (b - a).Magnitude
					for movingIndex = 1, comet and 2 or 1 do
						local part = entry.parts[movingIndex]
						if part and part.Parent then
							if length > 0.05 then
								local thick = comet and (movingIndex == 1 and entry.width * 1.4 or entry.width * 5) or entry.width * 3
								part.Size = Vector3.new(thick, thick, length)
								part.CFrame = CFrame.lookAt((a + b) / 2, b)
							end
							part.Transparency = tail >= 1 and 1 or ((comet and movingIndex == 2) and 0.8 or 0)
						end
					end
				end
				for partIndex, part in ipairs(entry.parts) do
					local moving = (entry.style == "Pulse" and partIndex == 1) or (entry.style == "Comet" and partIndex <= 2)
					if not moving then
						local base = entry.base[partIndex] or 0
						part.Transparency = base + (1 - base) * fade
					end
				end
			elseif entry.style == "Square" then
				local right, forward = across(entry.normal)
				local pop = 1 - (1 - math.min(age / 0.12, 1)) ^ 3
				local scale = entry.size * (0.4 + 0.6 * pop)
				local cube = CFrame.fromMatrix(entry.at, right, forward, entry.normal)
				local shell, core, cap = entry.parts[1], entry.parts[2], entry.parts[3]
				local edge = 0.34 * scale
				if shell then
					shell.Size = Vector3.new(edge, edge, edge * 0.8)
					shell.CFrame = cube * CFrame.new(0, 0, edge * 0.8 * 0.32)
					shell.Transparency = 0.55 + 0.45 * fade
				end
				if core then
					local inner = edge * 0.62
					core.Size = Vector3.new(inner, inner, inner)
					core.CFrame = cube * CFrame.new(0, 0, edge * 0.8 * 0.32 + inner * 0.05)
					core.Transparency = fade
				end
				if cap then
					cap.Size = Vector3.new(edge * 0.4, edge * 0.4, edge * 0.12)
					cap.CFrame = cube * CFrame.new(0, 0, edge * 0.8 * 0.72 + edge * 0.04)
					cap.Transparency = 0.35 + 0.65 * fade
				end
			elseif entry.shards then
				local step = math.min(now - (entry.lastStep or entry.t), 0.05)
				entry.lastStep = now
				for _, shard in ipairs(entry.shards) do
					shard.velocity += Vector3.new(0, -9, 0) * step
					shard.velocity *= 1 - math.min(step * 3.4, 0.6)
					shard.position += shard.velocity * step
					local speed = shard.velocity.Magnitude
					if speed > 0.05 then
						local length = shard.length * (1 - t * 0.7)
						shard.part.Size = Vector3.new(shard.part.Size.X, shard.part.Size.Y, length)
						shard.part.CFrame = CFrame.lookAt(shard.position, shard.position + shard.velocity)
					end
					shard.part.Transparency = t * t
				end
			elseif not entry.keep then
				for partIndex, part in ipairs(entry.parts) do
					local base = entry.base[partIndex] or 0
					part.Transparency = base + (1 - base) * fade
				end
			end
		end
	end
end))

