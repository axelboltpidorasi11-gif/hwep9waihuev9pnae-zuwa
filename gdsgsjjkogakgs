	tweenService:Create(popup, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { GroupTransparency = 0, Position = target }):Play()
	local connection
	local closing = false
	local function close()
		if closing then return end
		closing = true
		if connection then connection:Disconnect() end
		if Neverlose.presetPopup == popup then Neverlose.presetPopup = nil end
		tweenService:Create(popup, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1, Position = target + UDim2.fromOffset(0, -6) }):Play()
		task.delay(0.16, function() if popup.Parent then popup:Destroy() end end)
	end
	local function drawIcon(parent, action, color)
		local box = newInstance("Frame", { Position = UDim2.fromOffset(12, 7), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ZIndex = 52 }, parent)
		if action == "Copy" then
			newInstance("Frame", { Position = UDim2.fromOffset(4, 0), Size = UDim2.fromOffset(9, 9), BackgroundTransparency = 1, ZIndex = 52 }, box)
			newInstance("UIStroke", { Color = color, Thickness = 1.4 }, box.Frame)
			newInstance("UICorner", { CornerRadius = UDim.new(0, 2) }, box.Frame)
			local back = newInstance("Frame", { Position = UDim2.fromOffset(0, 4), Size = UDim2.fromOffset(9, 9), BackgroundColor3 = Color3.fromRGB(20, 21, 29), ZIndex = 53 }, box)
			newInstance("UIStroke", { Color = color, Thickness = 1.4 }, back)
			newInstance("UICorner", { CornerRadius = UDim.new(0, 2) }, back)
		else
			newInstance("Frame", { Position = UDim2.fromOffset(2, 4), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 52 }, box)
			newInstance("UIStroke", { Color = color, Thickness = 1.4 }, box.Frame)
			newInstance("UICorner", { CornerRadius = UDim.new(0, 2) }, box.Frame)
			newInstance("Frame", { Position = UDim2.fromOffset(0, 1), Size = UDim2.fromOffset(14, 2), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 52 }, box)
			newInstance("Frame", { Position = UDim2.fromOffset(5, -1), Size = UDim2.fromOffset(4, 2), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 52 }, box)
		end
	end
	for index, action in ipairs(canDelete and { "Copy", "Delete" } or { "Copy" }) do
		local color = action == "Delete" and Color3.fromRGB(255, 110, 120) or Color3.fromRGB(226, 228, 236)
		local button = newInstance("TextButton", {
			Position = UDim2.new(0, 5, 0, 5 + (index - 1) * 33), Size = UDim2.new(1, -10, 0, 30), BackgroundTransparency = 1,
			BackgroundColor3 = color, Text = "", AutoButtonColor = false, ZIndex = 51,
		}, popup)
		newInstance("UICorner", { CornerRadius = UDim.new(0, 7) }, button)
		drawIcon(button, action, color)
		newInstance("TextLabel", {
			Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -42, 1, 0), BackgroundTransparency = 1, Text = action, TextColor3 = color,
			TextSize = 14, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 52,
		}, button)
		button.MouseEnter:Connect(function() tweenService:Create(button, TweenInfo.new(0.12), { BackgroundTransparency = 0.88 }):Play() end)
		button.MouseLeave:Connect(function() tweenService:Create(button, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play() end)
		button.MouseButton1Click:Connect(function()
			close()
			callback(action)
		end)
	end
	task.defer(function()
		if closing or not popup.Parent then return end
		connection = userInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
			local position = userInputService:GetMouseLocation()
			local at, size = popup.AbsolutePosition, popup.AbsoluteSize
			if position.X < at.X or position.X > at.X + size.X or position.Y < at.Y or position.Y > at.Y + size.Y then close() end
		end)
		maid:give(connection)
	end)
end

