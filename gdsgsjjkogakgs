local Spectators = { list = {} }

function Spectators.compute()
	local count = math.max(0, math.floor(tonumber(localPlayer:GetAttribute("Spectators")) or 0))
	if count == 0 then return {} end

	local myTeam = localPlayer:GetAttribute("Team")
	local competitive = workspaceService:GetAttribute("ServerGamemode") == "Competitive"
	local result = {}

	for _, player in ipairs(playersService:GetPlayers()) do
		if player ~= localPlayer and player:GetAttribute("IsSpectating") == true then
			local allowed = true
			if competitive and myTeam and myTeam ~= "Spectators" then
				allowed = player:GetAttribute("Team") == myTeam
			end
			if allowed then result[#result + 1] = player end
		end
	end

	table.sort(result, function(a, b)
		local ak, bk = a:GetAttribute("LastKiller") == localPlayer.Name, b:GetAttribute("LastKiller") == localPlayer.Name
		if ak ~= bk then return ak end
		return (a.DisplayName .. a.Name):lower() < (b.DisplayName .. b.Name):lower()
	end)
	for index = #result, count + 1, -1 do result[index] = nil end
	return result
end

