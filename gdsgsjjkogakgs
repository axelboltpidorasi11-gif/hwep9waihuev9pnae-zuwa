local Patch = {}

function Patch.hook(fn, builder)
	if type(fn) ~= "function" or not hookfunction then return nil end
	if isfunctionhooked and restorefunction and isfunctionhooked(fn) then
		pcall(restorefunction, fn)
	end

	local original
	local ok = pcall(function()
		original = hookfunction(fn, newcclosure(builder(function(...)
			return original(...)
		end)))
	end)
	if not ok then return nil end

	maid:give(function()
		if restorefunction then
			pcall(restorefunction, fn)
		else
			pcall(hookfunction, fn, original)
		end
	end)
	return original
end

function Patch.field(target, key, builder)
	local original = type(target) == "table" and rawget(target, key)
	if type(original) ~= "function" then return nil end

	local replacement = builder(original)
	local frozen = isreadonly and isreadonly(target)
	if frozen and setreadonly then setreadonly(target, false) end
	local ok = pcall(rawset, target, key, replacement)
	if frozen and setreadonly then setreadonly(target, true) end
	if not ok then return nil end

	maid:give(function()
		if rawget(target, key) ~= replacement then return end
		if frozen and setreadonly then setreadonly(target, false) end
		rawset(target, key, original)
		if frozen and setreadonly then setreadonly(target, true) end
	end)
	return original
end

local function asGame(fn, ...)
	local previous = getthreadidentity and getthreadidentity()
	if setthreadidentity then pcall(setthreadidentity, 2) end
	local results = table.pack(pcall(fn, ...))
	if setthreadidentity then pcall(setthreadidentity, previous or 8) end
	return table.unpack(results, 1, results.n)
end

