	local function classifyPayload(class, name)
		class, name = tostring(class or ""), tostring(name or "")
		if class == "FloorSounds" then
			if name == "Jump" then return "Jump", "Footsteps" end
			if name:sub(1, 7) == "Landing" then return "Landing", "Footsteps" end
			return "Step", "Footsteps"
		end
