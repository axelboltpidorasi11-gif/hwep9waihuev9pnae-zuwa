local function calibrate()
	if not aim.lastLook then return end
	local viewport = currentCamera.ViewportSize
	local probe = aim.lastPosition + aim.lastLook * 1000
	local projected = currentCamera:WorldToViewportPoint(probe)
	local movedX, movedY = viewport.X / 2 - projected.X, viewport.Y / 2 - projected.Y
	if math.abs(aim.sentX) >= 3 and movedX * aim.sentX > 0 then
		aim.gainX = math.clamp(aim.gainX * 0.85 + 0.15 * (movedX / aim.sentX), 0.05, 12)
	end
	if math.abs(aim.sentY) >= 3 and movedY * aim.sentY > 0 then
		aim.gainY = math.clamp(aim.gainY * 0.85 + 0.15 * (movedY / aim.sentY), 0.05, 12)
