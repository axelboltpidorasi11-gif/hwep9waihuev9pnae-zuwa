	local function noteHeard(class, name, position)
		local esp = Neverlose.config.esp
		if not esp.heardPlayers or typeof(position) ~= "Vector3" then return end
		local isShot = name == "Shoot"
		local isStep = class == "FloorSounds"
		if not (isShot or isStep) then return end
		local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
		if localRoot and (localRoot.Position - position).Magnitude < 8 then return end
		local feet = isShot and position - Vector3.new(0, 3.2, 0) or position
		local radius = isShot and 70 or 18
		local best, bestDistance
		for _, entity in ipairs(Game.entities()) do
			if entity ~= localPlayer and Game.isEnemy(entity, true) and not Neverlose.isDown(entity) then
				local known = Neverlose.heard[entity]
				local reference
				if known and os.clock() - known.t < 3 then
					reference = known.position
				else
					local character = Game.character(entity)
					local root = character and character:FindFirstChild("HumanoidRootPart")
					reference = root and root.Position - Vector3.new(0, 3, 0)
				end
				if reference then
					local distance = (Vector3.new(reference.X, 0, reference.Z) - Vector3.new(feet.X, 0, feet.Z)).Magnitude
					if distance < radius and math.abs(reference.Y - feet.Y) < 25 and (not bestDistance or distance < bestDistance) then
						best, bestDistance = entity, distance
					end
				end
			end
		end
		if best then
			for _, mate in ipairs(Game.entities()) do
				if mate ~= localPlayer and mate ~= best and not Game.isEnemy(mate, true) and mate:GetAttribute("Dead") ~= true then
					local body = Game.character(mate)
					local mateRoot = body and body:FindFirstChild("HumanoidRootPart")
					if mateRoot then
						local away = (Vector3.new(mateRoot.Position.X, 0, mateRoot.Position.Z) - Vector3.new(feet.X, 0, feet.Z)).Magnitude
						if (away <= bestDistance * 0.8 or away < 4) and math.abs(mateRoot.Position.Y - 3 - feet.Y) < 8 then
							best = nil
							break
						end
					end
				end
			end
		end
		if best then
			local previous = Neverlose.heard[best]
			local velocity
			if previous and previous.position and not isShot then
				local delta = os.clock() - previous.t
				if delta > 0.15 and delta < 1.6 then
					local move = Vector3.new(feet.X - previous.position.X, 0, feet.Z - previous.position.Z) / delta
					if move.Magnitude > 1 and move.Magnitude <= 24 then
						velocity = previous.velocity and previous.velocity:Lerp(move, 0.5) or move
					end
				end
			end
			Neverlose.heard[best] = { position = feet, t = os.clock(), kind = isShot and "SHOT" or "STEP", velocity = velocity }

			if Game.character(best) == nil then
				local entry = Neverlose.lastKnown[best]
				if not entry then
					entry = { trail = {} }
					Neverlose.lastKnown[best] = entry
				end
				entry.position, entry.t, entry.velocity = feet + Vector3.new(0, 3, 0), os.clock(), velocity
				local trail = entry.trail
				trail[#trail + 1] = { position = feet, t = os.clock() }
				if #trail > 14 then table.remove(trail, 1) end
			end
		end
	end

