				SpreadAngle = Vector2.new(180, 180), Drag = 1.5, LockedToPart = false, LightEmission = 1, LightInfluence = 0, Color = sequence,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 2), NumberSequenceKeypoint.new(1, 0) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
			}, sparkPart),
		}
	else
		layers = {
			{ beam = ribbon(a0, a1, 0.55 * scale, c1, c2, 0.78), base = 0.55 * scale },
			{ beam = ribbon(a0, a1, 0.24 * scale, c1:Lerp(white, 0.3), c2:Lerp(white, 0.4), 0.4), base = 0.24 * scale },
			{ beam = ribbon(a0, a1, 0.08 * scale, c1:Lerp(white, 0.7), white, 0), base = 0.08 * scale },
		}
	end
	local gui = newInstance("BillboardGui", { Size = UDim2.fromScale(1.5 * scale + 0.4, 1.5 * scale + 0.4), AlwaysOnTop = false, LightInfluence = 0 }, headPart)
