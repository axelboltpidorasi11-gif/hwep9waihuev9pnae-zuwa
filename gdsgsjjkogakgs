---Cheap pre-filter: skip enemies that are out of range or far outside the aim FOV.
function Rage.inReach(character, origin, range, fovPixels)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return true end
	if (root.Position - origin).Magnitude > range + 6 then return false end
	if fovPixels ~= math.huge then
		local pixels = screenDistance(root.Position)
		if not pixels or pixels > fovPixels * 1.7 + 120 then return false end
	end
	return true
end

function Rage.scanAll(weapon, partNames, multipointSet, fovDegrees)
	local config = Neverlose.config.rage
	local properties = weapon.Properties
	local origin = Game.origin()
	local range = properties.Range or 500
	local maxWalls = Ballistics.allowedWalls(weapon, config.autowall)
	local fovPixels = fovDegrees >= 180 and math.huge or fovToPixels(fovDegrees)
	local spread = Ballistics.spread(weapon)
	local useHistory = not Game.serverHits and (HISTORY_WINDOW[config.history] or 0) > 0
	local minDamage = Rage.minDamage()
	local validOrigins, validShifts = {}, {}
	Ballistics.safe = true
	Rage.originBudget = 2
	originParams.FilterDescendantsInstances = { localPlayer.Character, currentCamera }
	local activeOrigins = validOrigins
	Rage.originRank = Rage.originRank or {}

	local function evaluate(entity, character, part, position, record)
		local offset = position - origin
		local distance = offset.Magnitude
		if distance > range then return nil end

		local pixels = screenDistance(position)
		if fovPixels ~= math.huge and (not pixels or pixels > fovPixels) then return nil end

		local usedOrigin
		local _, reached, walls = Ballistics.trace(origin, offset.Unit, distance + 2, character, maxWalls)
		if #activeOrigins > 0 and not record and (not reached or walls > 0) then
			for _, from in ipairs(activeOrigins) do
				local line = position - from
				local _, reachedFrom, wallsFrom = Ballistics.trace(from, line.Unit, line.Magnitude + 2, character, maxWalls)
				if reachedFrom and (not reached or wallsFrom < walls) then
					reached, walls, usedOrigin = true, wallsFrom, from
					if wallsFrom == 0 then break end
				end
			end
		end
		if not reached and not (record and walls <= maxWalls) then return nil end

		if reached and walls == 0 and not record then
			local inward = part.Position - position
			if inward.Magnitude > 0.25 then
				local from = usedOrigin or origin
				local inner = position + inward.Unit * 0.2
				local line = inner - from
				local _, innerReached = Ballistics.trace(from, line.Unit, line.Magnitude + 2, character, maxWalls)
				if not innerReached then return nil end
			end
		end

		if reached and walls > 0 and not record then
			local from = usedOrigin or origin
			local axis = position - from
			local side = axis.Magnitude > 0.1 and axis.Unit:Cross(Vector3.yAxis) or Vector3.xAxis
			side = (side.Magnitude > 0.05 and side.Unit or Vector3.xAxis) * math.min(part.Size.X, 0.6) * 0.3
			for _, nudged in ipairs({ position + side, position - side }) do
				local line = nudged - from
				local _, okReached, okWalls = Ballistics.trace(from, line.Unit, line.Magnitude + 2, character, maxWalls)
				if not okReached or okWalls > walls then return nil end
			end
		end

		local health = character:GetAttribute("Health") or 100
		local damage = Ballistics.damage(properties, part.Name, distance, walls, character)
		if damage < math.min(minDamage, health) then return nil end

		return {
			entity = entity, character = character, part = part, position = position, origin = usedOrigin,
			offset = record and nil or (position - part.Position),
			damage = damage, walls = walls, record = record, distance = distance, health = health, pixels = pixels,
			chance = Ballistics.hitChance(spread, distance, part.Size.Magnitude / 3),
		}
	end

	local results = {}
	for _, entity in ipairs(Game.entities()) do
		if Game.isEnemy(entity, true) then
			local character = Game.character(entity)
			if character and not Game.isImmune(character) and Rage.inReach(character, origin, range, fovPixels) then
				local bestAny, bestTorso, bestHead

				activeOrigins = validOrigins
				if config.originScan then
					local cached = Rage.originRank[entity]
					local age = cached and os.clock() - cached.at
					if cached and (age < 0.08 or (Rage.originBudget <= 0 and age < 0.4)) then
						activeOrigins = {}
						for _, shift in ipairs(cached.shifts) do
							if workspaceService:Raycast(origin, shift, originParams) == nil then activeOrigins[#activeOrigins + 1] = origin + shift end
						end
					else
						Rage.originBudget -= 1
						local root, head = character:FindFirstChild("HumanoidRootPart"), character:FindFirstChild("Head")
						local chest = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
						local picked = {}
						if root then
							local direct = root.Position - origin
							local _, directReached, directWalls = Ballistics.trace(origin, direct.Unit, direct.Magnitude + 2, character, maxWalls)
							if not directReached or directWalls > 0 then
								local ranked, clean = {}, 0
								for _, shift in ipairs(Rage.originShiftsFor(direct)) do
									if workspaceService:Raycast(origin, shift, originParams) == nil and Rage.originClear(origin + shift) then
										local from = origin + shift
										local best, seen = 50, 0
										for _, mark in ipairs({ root, head, chest }) do
											local line = mark.Position - from
											local _, reachedFrom, wallsFrom = Ballistics.trace(from, line.Unit, line.Magnitude + 2, character, maxWalls)
											if reachedFrom then
												seen += 1
												if wallsFrom < best then best = wallsFrom end
											end
										end
										if best < 50 then
											ranked[#ranked + 1] = { shift = shift, score = best * 2 + shift.Magnitude * 0.35 - seen * 0.2 }
											if best == 0 then clean += 1 end
										end
										if clean >= 3 then break end
									end
								end
								table.sort(ranked, function(a, b) return a.score < b.score end)
								for index = 1, math.min(6, #ranked) do picked[index] = ranked[index].shift end
							end
						end
						activeOrigins = {}
						for index, shift in ipairs(picked) do activeOrigins[index] = origin + shift end
						Rage.originRank[entity] = { at = os.clock(), shifts = picked }
					end
				end

				local function keep(candidate)
					if not candidate then return false end
					if not bestAny or candidate.damage > bestAny.damage then bestAny = candidate end
					if PART_GROUP[candidate.part.Name] == "Torso" and (not bestTorso or candidate.damage > bestTorso.damage) then
						bestTorso = candidate
					end
					if PART_GROUP[candidate.part.Name] == "Head" and (not bestHead or candidate.chance > bestHead.chance) then
						bestHead = candidate
					end
					return true
				end

				local missed = Rage.missStreak and Rage.missStreak[entity]
				local forceBody = false
				if forceBody then
					forceBody = false
					for _, name in ipairs(partNames) do
						if PART_GROUP[name] ~= "Head" then forceBody = true break end
					end
				end
				for _, name in ipairs(partNames) do
					local part = not (forceBody and PART_GROUP[name] == "Head") and character:FindFirstChild(name) or nil
					if part then
						for _, point in ipairs(Ballistics.points(part, multipointSet[name] == true)) do
							if keep(evaluate(entity, character, part, point, nil)) then break end
						end
					end
				end

				local records = useHistory and not bestAny and Ballistics.history[entity]
				if records then
					for index = 1, #records, 2 do
						local record = records[index]
						for _, name in ipairs(partNames) do
							local cframe = record.cframes[name]
							local part = character:FindFirstChild(name)
							if cframe and part and keep(evaluate(entity, character, part, cframe.Position, record)) then break end
						end
					end
				end

				local chosen = bestAny
				if chosen and config.preferBodyLethal and bestTorso and bestTorso.damage >= chosen.health then chosen = bestTorso end
				-- A head that can be landed is worth more than a body shot that does not kill.
				if chosen and bestHead and chosen ~= bestHead and config.preferHead ~= false and not (bestTorso and bestTorso.damage >= bestTorso.health) then
					if bestHead.damage > chosen.damage and bestHead.chance >= Rage.requiredChance(weapon, bestHead, config) * 0.85 then chosen = bestHead end
				end

				if chosen then
					local score
					if config.target == "Highest Damage" then
						score = -math.min(chosen.damage, chosen.health) * 10
					elseif config.target == "Lowest Health" then
						score = chosen.health * 10
					elseif config.target == "Crosshair" then
						score = (chosen.pixels or 1e5) * 10
					else
						score = chosen.distance
					end
					if config.priority == "Health" then
						score += chosen.health * 0.01
					else
						score += chosen.distance * 0.01
					end
					if chosen.damage >= chosen.health then score -= (config.target == "Highest Damage" or config.target == "Lowest Health") and 150 or (config.target == "Crosshair" and 400 or 25) end
					if true then score -= math.min(Rage.threatOf(entity), 8) * 60 end
					chosen.score = score
					results[#results + 1] = chosen
				end
			end
		end
	end

	Ballistics.safe = false
	table.sort(results, function(a, b) return a.score < b.score end)
	return results
end

function Rage.scan(weapon, partNames, multipointSet, fovDegrees)
	return Rage.scanAll(weapon, partNames, multipointSet, fovDegrees)[1]
end

function Rage.aimPoint(target)
	if target.record and not Game.serverHits then return target.position end
	local part = target.part
	if not (part and part.Parent) then return nil end
	return part.Position + (target.offset or Vector3.zero)
end

function Rage.aimBullet(bullet, target, weapon)
	if not Game.character(target.entity) then return false end
	local aim = Rage.aimPoint(target)
	if not aim then return false end

	local origin = typeof(bullet.Origin) == "Vector3" and bullet.Origin or Game.origin()
	if (origin - Game.origin()).Magnitude > 4 then origin = Game.origin() end
	if target.origin then origin = target.origin end
	local offset = aim - origin
	local distance = offset.Magnitude
	local range = weapon and weapon.Properties and weapon.Properties.Range or 500
	if distance < 0.05 or distance > range then return false end
	local direction = offset.Unit

	local maxWalls = Ballistics.allowedWalls(weapon, Neverlose.config.rage.autowall)
	Ballistics.safe = true
	local hits, reached, walls = Ballistics.trace(origin, direction, distance + 2, target.character, maxWalls)
	Ballistics.safe = false
	if not reached and not (target.record and walls <= maxWalls) then return false end

	if reached and walls == 0 and not target.record and target.part then
		local inward = target.part.Position - aim
		if inward.Magnitude > 0.25 then
			local inner = aim + inward.Unit * 0.2
			local line = inner - origin
			local _, innerReached = Ballistics.trace(origin, line.Unit, line.Magnitude + 2, target.character, maxWalls)
			if not innerReached then return false end
		end
	end

	if not reached then
		hits[#hits + 1] = {
			Instance = target.part, Position = aim, Normal = -direction,
			Material = target.part.Material.Name, Exit = false,
		}
	end

	bullet.Origin, bullet.Direction = origin, direction
	if Game.serverHits then
		bullet.Hits = nil
	else
		bullet.Hits = Ballistics.withDistances(origin, hits)
	end
	return true
end

local function setFromSet(list)
	local set = {}
	for _, name in ipairs(list or {}) do set[name] = true end
	return set
end

Events.addShotRewriter(function(payload)
