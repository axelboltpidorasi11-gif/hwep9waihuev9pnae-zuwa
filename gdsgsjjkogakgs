		local ok, copy = pcall(function()
			best.Archivable = true
			for _, object in ipairs(best:GetDescendants()) do object.Archivable = true end
			return best:Clone()
		end)
		if not (ok and copy) then return nil end
		for _, object in ipairs(copy:GetDescendants()) do
